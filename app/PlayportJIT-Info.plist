<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The release version (pp release VERSION checks it; decision 0036). Keep both plists equal. -->
	<key>CFBundleShortVersionString</key>
	<string>0.3.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleDisplayName</key>
	<string>Playport JIT</string>
	<!-- The JIT helper (Sources/PlayportJIT). A borrowed system extension point
	     that nothing activates (FALSEPREDICATE): only the app starts it, through
	     NSExtension (Sources/S1Probe/BuiltInJit.swift). -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.ar.viewer</string>
		<key>NSExtensionPrincipalClass</key>
		<string>PlayportJITHelper</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<string>FALSEPREDICATE</string>
		</dict>
	</dict>
</dict>
</plist>
