--- a/build/toolchain/win/toolchain.gni
+++ b/build/toolchain/win/toolchain.gni
@@ -133,11 +133,17 @@ template("msvc_toolchain") {
       env_wrapper = ""
       sys_include_flags =
           "${invoker.sys_include_flags} "  # Note trailing space.
+      if (defined(invoker.rc_sys_include_flags)) {
+        rc_sys_include_flags = "${invoker.rc_sys_include_flags} "
+      } else {
+        rc_sys_include_flags = sys_include_flags
+      }
     } else {
       # clang-cl doesn't need this env hoop, so omit it there.
       assert(!toolchain_is_clang)
       env_wrapper = "ninja -t msvc -e $env -- "  # Note trailing space.
       sys_include_flags = ""
+      rc_sys_include_flags = ""
     }
 
     if (host_os != "win" || (use_lld && defined(invoker.sys_lib_flags))) {
@@ -260,7 +266,7 @@ template("msvc_toolchain") {
       } else {
         werror = ""
       }
-      command = "\"$python_path\" $_tool_wrapper_path rc-wrapper $env rc.exe /nologo $werror$sys_include_flags{{defines}} {{include_dirs}} /fo{{output}} {{source}}"
+      command = "\"$python_path\" $_tool_wrapper_path rc-wrapper $env rc.exe /nologo $werror$rc_sys_include_flags{{defines}} {{include_dirs}} /fo{{output}} {{source}}"
       depsformat = "msvc"
       outputs = [ "$object_subdir/{{source_name_part}}.res" ]
       description = "RC {{output}}"
@@ -800,6 +806,7 @@ template("win_toolchains") {
     cl = "${_clang_bin_path}/clang-cl${_exe}"
 
     sys_include_flags = "${win_toolchain_data.include_flags_imsvc}"
+    rc_sys_include_flags = "${win_toolchain_data.include_flags_rc}"
     if (use_lld) {
       sys_lib_flags = "-libpath:$_clang_lib_dir " +
                       "${win_toolchain_data.libpath_lldlink_flags}"
@@ -820,6 +827,7 @@ template("win_toolchains") {
     cl = "${_clang_bin_path}/clang-cl${_exe}"
 
     sys_include_flags = "${rust_host_win_toolchain_data.include_flags_imsvc}"
+    rc_sys_include_flags = "${rust_host_win_toolchain_data.include_flags_rc}"
     if (use_lld) {
       sys_lib_flags = "-libpath:$_clang_lib_dir " +
                       "${rust_host_win_toolchain_data.libpath_lldlink_flags}"
@@ -840,6 +848,7 @@ template("win_toolchains") {
     cl = "${_clang_bin_path}/clang-cl${_exe}"
 
     sys_include_flags = "${win_toolchain_data.include_flags_imsvc}"
+    rc_sys_include_flags = "${win_toolchain_data.include_flags_rc}"
     if (use_lld) {
       sys_lib_flags = "-libpath:$_clang_lib_dir " +
                       "${win_toolchain_data.libpath_lldlink_flags}"
@@ -860,6 +869,7 @@ template("win_toolchains") {
     cl = "${_clang_bin_path}/clang-cl${_exe}"
 
     sys_include_flags = "${rust_host_win_toolchain_data.include_flags_imsvc}"
+    rc_sys_include_flags = "${rust_host_win_toolchain_data.include_flags_rc}"
     if (use_lld) {
       sys_lib_flags = "-libpath:$_clang_lib_dir " +
