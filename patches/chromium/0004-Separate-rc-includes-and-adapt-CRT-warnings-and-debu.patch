From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Fri, 16 Oct 2026 18:21:39 +0200
Subject: [PATCH] Separate rc includes and adapt CRT warnings and debug
 libraries

Formalize stage A-C scratch diff 005, retaining the built bytes.
Apply after the pinned CEF stock patches.

Class: linux-build
Evidence: docs/evidence/2026-10-16-cef-low-va-build.md
Offered-upstream: no
---
 build/toolchain/win/setup_toolchain.py | 10 ++++++++++
 build/toolchain/win/toolchain.gni      | 12 +++++++++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/build/toolchain/win/setup_toolchain.py b/build/toolchain/win/setup_toolchain.py
index 29a0bd2..3b0ff0d 100644
--- a/build/toolchain/win/setup_toolchain.py
+++ b/build/toolchain/win/setup_toolchain.py
@@ -304,13 +304,21 @@ def main():
       include_I = ['/I' + i for i in include]
       include_imsvc = ['-imsvc' + i for i in include]
       libpath_flags = ['-libpath:' + i for i in lib]
+      # rc.py accepts include paths but not the compiler's VFS overlay flag.
+      include_rc = list(include_imsvc)
       if sys.platform.startswith('linux'):
         overlay = os.path.join(toolchain_root, 'overlay.json')
         assert os.path.isfile(overlay), overlay
         include_imsvc.extend(['-vfsoverlay', relflag(overlay)])
+        # The xwin CRT 14.43 headers (threads.h) use UCRT macros that the
+        # SDK 10.0.26100 corecrt.h predates; define them empty.
+        include_imsvc.extend(['/D_UCRT_DISABLE_CLANG_WARNINGS=',
+                              '/D_UCRT_RESTORE_CLANG_WARNINGS='])
         # lld's VFS lookup needs absolute search paths to match overlay roots.
         libpath_flags = ['-libpath:' + os.path.abspath(i) for i in lib]
         libpath_flags.append('/vfsoverlay:' + overlay)
+        # xwin ships no CRT PDBs, so libcmt.lib's debug info cannot be found.
+        libpath_flags.append('/ignore:4099')
 
       if (environment_block_name != ''):
         env_block = _FormatAsEnvironmentBlock(env)
@@ -332,9 +340,11 @@ def main():
     flags = ['/winsysroot' + relflag(toolchain_root)]
     print(f'include_flags_imsvc = {ListToArgString(flags)}')
     print(f'include_flags_imsvc_list = {ListToArgList(flags)}')
+    print(f'include_flags_rc = {ListToArgString(flags)}')
   else:
     print(f'include_flags_imsvc = {ListToArgString(include_imsvc)}')
     print(f'include_flags_imsvc_list = {ListToArgList(include_imsvc)}')
+    print(f'include_flags_rc = {ListToArgString(include_rc)}')
   print('paths = ' + gn_helpers.ToGNString(env['PATH']))
   assert libpath_flags
   print(f'libpath_flags = {ListToArgString(libpath_flags)}')
diff --git a/build/toolchain/win/toolchain.gni b/build/toolchain/win/toolchain.gni
