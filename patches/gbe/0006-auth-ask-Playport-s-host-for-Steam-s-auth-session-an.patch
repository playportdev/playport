diff --git a/dll/playport_host.cpp b/dll/playport_host.cpp
new file mode 100644
index 0000000..9ad877a
--- /dev/null
+++ b/dll/playport_host.cpp
@@ -0,0 +1,97 @@
+/* Playport: the host app's Steam tickets (dll/playport_host.h). */
+#include "dll/playport_host.h"
+
+#include <cstring>
+#include <mutex>
+
+#if defined(_WIN32)
+#include <windows.h>
+
+extern "C" IMAGE_DOS_HEADER __ImageBase;
+
+namespace {
+
+typedef LONG (NTAPI *query_virtual_memory_fn)(HANDLE, const void *, ULONG, void *, SIZE_T, SIZE_T *);
+typedef LONG (WINAPI *wine_unix_call_fn)(UINT64, unsigned int, void *);
+
+const ULONG MemoryWineLoadUnixLib = 1000;
+
+std::once_flag once;
+wine_unix_call_fn unix_call;
+UINT64 handle;
+bool host_armed;
+
+void say_hello()
+{
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    if (!ntdll) return;
+    auto query = (query_virtual_memory_fn)GetProcAddress(ntdll, "NtQueryVirtualMemory");
+    auto call = (wine_unix_call_fn)GetProcAddress(ntdll, "__wine_unix_call");
+    if (!query || !call) return;
+    UINT64 h = 0;
+    if (query(GetCurrentProcess(), &__ImageBase, MemoryWineLoadUnixLib, &h, sizeof(h), nullptr) != 0 || !h) return;
+    pp_steam_hello hello{ PP_STEAM_MAGIC, sizeof(hello), PP_STEAM_PROTOCOL, 0 };
+    if (call(h, PP_STEAM_HELLO, &hello) != 0 || hello.version != PP_STEAM_PROTOCOL) return;
+    unix_call = call;
+    handle = h;
+    host_armed = hello.armed != 0;
+}
+
+}
+
+namespace playport_host {
+
+bool armed()
+{
+    std::call_once(once, say_hello);
+    return host_armed;
+}
+
+uint32_t create(uint32_t type, const char *identity, uint8_t *ticket, uint32_t cap, uint32_t *size)
+{
+    *size = 0;
+    if (!armed()) return 0;
+    static pp_steam_create c;   /* 2.8 KB; callers hold gbe's global mutex */
+    std::memset(&c, 0, sizeof(c));
+    c.magic = PP_STEAM_MAGIC;
+    c.size = sizeof(c);
+    c.type = type;
+    if (identity) std::strncpy(c.identity, identity, sizeof(c.identity) - 1);
+    if (unix_call(handle, PP_STEAM_CREATE, &c) != 0 || !c.handle || c.ticket_size > cap || c.ticket_size > sizeof(c.ticket)) {
+        if (c.handle) cancel(c.handle);
+        return 0;
+    }
+    std::memcpy(ticket, c.ticket, c.ticket_size);
+    *size = c.ticket_size;
+    return c.handle;
+}
+
+bool status(uint32_t h, uint32_t *state, uint32_t *eresult)
+{
+    if (!armed()) return false;
+    pp_steam_status s{ PP_STEAM_MAGIC, sizeof(s), h, PP_STEAM_FAILED, 0 };
+    if (unix_call(handle, PP_STEAM_STATUS, &s) != 0) return false;
+    *state = s.state;
+    *eresult = s.eresult;
+    return true;
+}
+
+void cancel(uint32_t h)
+{
+    if (!armed()) return;
+    pp_steam_cancel c{ PP_STEAM_MAGIC, sizeof(c), h };
+    unix_call(handle, PP_STEAM_CANCEL, &c);
+}
+
+}
+
+#else
+
+namespace playport_host {
+bool armed() { return false; }
+uint32_t create(uint32_t, const char *, uint8_t *, uint32_t, uint32_t *size) { *size = 0; return 0; }
+bool status(uint32_t, uint32_t *, uint32_t *) { return false; }
+void cancel(uint32_t) {}
+}
+
+#endif
