diff --git a/dll/dll/playport_host.h b/dll/dll/playport_host.h
new file mode 100644
index 0000000..40c6f84
--- /dev/null
+++ b/dll/dll/playport_host.h
@@ -0,0 +1,59 @@
+/* Playport: the host app's Steam tickets (Playport's decision 0062).
+ *
+ * In Playport the game runs in one process with the app that holds the
+ * player's Steam session. During a play the app keeps that session logged on
+ * and makes the game's auth session and web API tickets as Steam's client
+ * does; the emulator asks for them through a Wine unix call table the runtime
+ * gives this module (NtQueryVirtualMemory(MemoryWineLoadUnixLib) on itself).
+ * Anywhere else (Windows, another Wine) the query fails, nothing is
+ * available, and the emulator makes up its tickets as before.
+ *
+ * The protocol below is a copy of Playport's app/Sources/WineHost/include/
+ * steam_ticket_protocol.h: fixed-size blocks with no pointers, each with a
+ * magic and its size, so the host refuses a mismatch instead of misreading it.
+ */
+#ifndef PLAYPORT_HOST_H
+#define PLAYPORT_HOST_H
+
+#include <cstdint>
+
+#define PP_STEAM_MAGIC 0x54535050u /* "PPST" */
+#define PP_STEAM_PROTOCOL 1u
+#define PP_STEAM_IDENTITY_MAX 256
+#define PP_STEAM_TICKET_MAX 2560
+
+enum pp_steam_call { PP_STEAM_HELLO = 0, PP_STEAM_CREATE = 1, PP_STEAM_STATUS = 2, PP_STEAM_CANCEL = 3 };
+enum pp_steam_ticket_type { PP_STEAM_TICKET_SESSION = 2, PP_STEAM_TICKET_WEB_API = 5 };
+enum pp_steam_state { PP_STEAM_PENDING = 0, PP_STEAM_ACKED = 1, PP_STEAM_FAILED = 2 };
+#define PP_STEAM_OK 0x00000000u
+
+struct pp_steam_hello { uint32_t magic, size, version, armed; };
+struct pp_steam_create {
+    uint32_t magic, size, type;
+    char identity[PP_STEAM_IDENTITY_MAX];
+    uint32_t handle, ticket_size;
+    uint8_t ticket[PP_STEAM_TICKET_MAX];
+};
+struct pp_steam_status { uint32_t magic, size, handle, state, eresult; };
+struct pp_steam_cancel { uint32_t magic, size, handle; };
+
+namespace playport_host {
+
+/* Says hello to the host once (the host logs it on every play); true when the
+ * host has this play's tickets armed. */
+bool armed();
+
+/* A ticket of `type` from the host, bound to `identity` ("" for none): its
+ * handle, or 0 when the host has none to give (the caller makes up its own). */
+uint32_t create(uint32_t type, const char *identity, uint8_t *ticket, uint32_t cap, uint32_t *size);
+
+/* Whether Steam has taken the ticket (PP_STEAM_ACKED) or refused it
+ * (PP_STEAM_FAILED, with a server's EAuthSessionResponse); false for a handle
+ * the host does not know. */
+bool status(uint32_t handle, uint32_t *state, uint32_t *eresult);
+
+void cancel(uint32_t handle);
+
+}
+
+#endif
