-HAuthTicket Auth_Manager::getTicket( void *pTicket, int cbMaxTicket, uint32 *pcbTicket )
+void Auth_Manager::host_run_every_runcb(void *object)
 {
+    ((Auth_Manager *)object)->poll_host();
+}
+
+// Playport: a host ticket's callback once Steam has taken it (its ack), or a
+// server refused it, or 10 s passed, as Steam's client does.
+void Auth_Manager::poll_host()
+{
+    for (auto it = host_pending.begin(); it != host_pending.end();) {
+        uint32 state = PP_STEAM_PENDING, eresult = 0;
+        bool known = playport_host::status(it->handle, &state, &eresult);
+        bool late = std::chrono::steady_clock::now() - it->created > std::chrono::seconds(10);
+        if (known && state == PP_STEAM_PENDING && !late) { ++it; continue; }
+        EResult result = (!known || state == PP_STEAM_FAILED) ? k_EResultFail : k_EResultOK;
+        if (it->web_api) {
+            GetTicketForWebApiResponse_t data{};
+            data.m_hAuthTicket = it->handle;
+            data.m_eResult = result;
+            data.m_cubTicket = (int)it->bytes.size();
+            memcpy(data.m_rgubTicket, it->bytes.data(), it->bytes.size());
+            callbacks->addCBResult(data.k_iCallback, &data, sizeof(data));
+        } else {
+            GetAuthSessionTicketResponse_t data{};
+            data.m_hAuthTicket = it->handle;
+            data.m_eResult = result;
+            callbacks->addCBResult(data.k_iCallback, &data, sizeof(data));
+        }
+        it = host_pending.erase(it);
+    }
+}
+
+HAuthTicket Auth_Manager::getTicket( void *pTicket, int cbMaxTicket, uint32 *pcbTicket, const char *identity )
+{
+    // Playport: the host's ticket when it has one; otherwise the made-up one below.
+    if (run_every_runcb && playport_host::armed()) {
+        static uint8_t buf[PP_STEAM_TICKET_MAX];
+        uint32 size = 0;
+        uint32 handle = playport_host::create(PP_STEAM_TICKET_SESSION, identity ? identity : "", buf, sizeof(buf), &size);
+        if (handle) {
+            if (cbMaxTicket < 0 || (uint32)cbMaxTicket < size) {
+                playport_host::cancel(handle);
+                *pcbTicket = 0;
+                return k_HAuthTicketInvalid;
+            }
+            memcpy(pTicket, buf, size);
+            *pcbTicket = size;
+            host_pending.push_back({ handle, false, std::chrono::steady_clock::now(), {} });
+            host_live.push_back(handle);
+            return handle;
+        }
+    }
+
     if (settings->enable_new_app_ticket)
     {
         if (cbMaxTicket < STEAM_TICKET_MIN_SIZE_NEW) return k_HAuthTicketInvalid;
@@ -860,6 +915,19 @@ HAuthTicket Auth_Manager::getTicket( void *pTicket, int cbMaxTicket, uint32 *pcb
 
 HAuthTicket Auth_Manager::getWebApiTicket( const char* pchIdentity )
 {
+    // Playport: the host's ticket, bound to the identity, when it has one.
+    if (run_every_runcb && playport_host::armed()) {
+        std::vector<uint8_t> bytes(PP_STEAM_TICKET_MAX);
+        uint32 size = 0;
+        uint32 handle = playport_host::create(PP_STEAM_TICKET_WEB_API, pchIdentity ? pchIdentity : "", bytes.data(), (uint32)bytes.size(), &size);
+        if (handle) {
+            bytes.resize(size);
+            host_pending.push_back({ handle, true, std::chrono::steady_clock::now(), std::move(bytes) });
+            host_live.push_back(handle);
+            return handle;
+        }
+    }
+
     // https://docs.unity.com/ugs/en-us/manual/authentication/manual/platform-signin-steam
     GetTicketForWebApiResponse_t data{};
 
@@ -888,6 +956,16 @@ CSteamID Auth_Manager::fakeUser()
 
 void Auth_Manager::cancelTicket(uint32 number)
 {
+    // Playport: a host ticket leaves Steam's list.
+    auto live = std::find(host_live.begin(), host_live.end(), number);
+    if (live != host_live.end()) {
+        playport_host::cancel(number);
+        host_live.erase(live);
+        host_pending.erase(std::remove_if(host_pending.begin(), host_pending.end(),
+                                          [number](Host_Ticket const &t) { return t.handle == number; }), host_pending.end());
+        return;
+    }
+
     auto ticket = std::find_if(outbound.begin(), outbound.end(), [&number](Auth_Data const& item) { return item.number == number; });
     if (outbound.end() == ticket)
         return;
