From ece6ff7d4f5263d9c7780a3bab13c67e1714cd4b Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Sat, 3 Oct 2026 19:00:20 +0200
Subject: [PATCH] wow64: stop at the first i386 system call on iOS

FEX's WoW64 CPU module now runs on iOS, so Portal 2's i386 child enters
its i386 ntdll at LdrInitializeThunk. Its guest addresses live in a
window at a host base, and wow64's syscall thunks do not convert guest
pointers into it, or the host pointers they return out of it, yet. Log
the guest's first system call with its first arguments and end the
process with STATUS_NOT_SUPPORTED there.

Class: feature
Evidence: docs/evidence/2026-10-03-portal2-fex-wow64.md
Offered-upstream: no; a temporary boundary of the iOS port
---
 dlls/wow64/syscall.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/dlls/wow64/syscall.c b/dlls/wow64/syscall.c
index d6fea09cec8..be3e2de1f16 100644
--- a/dlls/wow64/syscall.c
+++ b/dlls/wow64/syscall.c
@@ -1205,6 +1205,15 @@ NTSTATUS WINAPI Wow64SystemServiceEx( UINT num, UINT *args )
     UINT id = num & 0xfff;
     const SYSTEM_SERVICE_TABLE *table = &syscall_tables[(num >> 12) & 3];
 
+    /* Playport: on iOS the guest's address space is a window at a host base
+     * (Portal 2 milestone 1), and the thunks below do not convert guest
+     * pointers into it, or host pointers they return out of it, yet. End the
+     * process at the guest's first system call, with what it asked for. */
+    ERR( "Playport: first i386 system call %04x (args %p: %08x %08x %08x %08x); "
+         "WoW64 pointer conversion is not wired, stopping\n", num, args,
+         args[0], args[1], args[2], args[3] );
+    NtTerminateProcess( GetCurrentProcess(), STATUS_NOT_SUPPORTED );
+
     if (id >= table->ServiceLimit)
     {
         ERR( "unsupported syscall %04x\n", num );
