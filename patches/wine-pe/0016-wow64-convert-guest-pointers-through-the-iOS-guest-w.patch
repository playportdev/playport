diff --git a/dlls/wow64/wow64_window.h b/dlls/wow64/wow64_window.h
new file mode 100644
index 0000000..2395491
--- /dev/null
+++ b/dlls/wow64/wow64_window.h
@@ -0,0 +1,69 @@
+/*
+ * WoW64 guest address window (iOS)
+ *
+ * iOS has no low 4 GiB, so the 32-bit address space of a WoW64 process lives
+ * in a window at a host base: guest address g is host address base + g. The
+ * unix side reserves the window and pairs the TEB32 and PEB32 in it; wow64.dll
+ * takes the base from that pair at process init. Base 0 means no window (the
+ * guest address is the host address, as in Wine elsewhere).
+ *
+ * This header uses no Wine header, so the host test compiles this exact file.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WOW64_WINDOW_H
+#define __WOW64_WINDOW_H
+
+#include <stdint.h>
+
+#define WOW64_WINDOW_SIZE  ((uint64_t)0x100000000)
+#define WOW64_WINDOW_ALIGN ((uint64_t)0x10000)
+
+/* A window base: above the first 4 GiB, 64 KiB aligned, and the whole window addressable. */
+static inline int wow64_window_valid_base( uint64_t base )
+{
+    return base >= WOW64_WINDOW_SIZE && !(base & (WOW64_WINDOW_ALIGN - 1)) &&
+           base <= UINT64_MAX - (WOW64_WINDOW_SIZE - 1);
+}
+
+/* The base named by the paired TEB32 (host address and guest self pointer)
+ * and PEB32 (host address and the guest pointer TEB32 holds). 0 when they do
+ * not name one valid window. */
+static inline uint64_t wow64_window_base_from_pair( uint64_t host_teb32, uint32_t guest_teb32,
+                                                    uint64_t host_peb32, uint32_t guest_peb32 )
+{
+    uint64_t base = host_teb32 - guest_teb32;
+
+    if (!guest_teb32 || !guest_peb32 || host_peb32 - guest_peb32 != base) return 0;
+    return wow64_window_valid_base( base ) ? base : 0;
+}
+
+/* Guest NULL stays NULL. A nonzero guest address below 64 KiB lands in the
+ * window's inaccessible guard: conversion grants no access. */
+static inline void *wow64_window_to_host( uint64_t base, uint32_t guest )
+{
+    return guest ? (void *)(uintptr_t)(base + guest) : (void *)0;
+}
+
+/* NULL, or a host pointer inside the window above its base, gives the guest
+ * address. Anything else is rejected, without truncation, leaving *guest as
+ * it was. */
+static inline int wow64_window_to_guest( uint64_t base, const void *host, uint32_t *guest )
+{
+    uint64_t addr = (uintptr_t)host;
+
+    if (!addr)
+    {
+        *guest = 0;
+        return 1;
+    }
+    if (addr <= base || addr - base >= WOW64_WINDOW_SIZE) return 0;
+    *guest = (uint32_t)(addr - base);
+    return 1;
+}
+
+#endif /* __WOW64_WINDOW_H */
