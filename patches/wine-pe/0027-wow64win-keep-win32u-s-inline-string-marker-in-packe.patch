From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Sun, 4 Oct 2026 12:00:00 +0200
Subject: [PATCH] wow64win: keep win32u's inline-string marker in packed
 CREATESTRUCTs

win32u's pack_user_message copies a WM_CREATE or WM_NCCREATE window name
and class after the CREATESTRUCT and leaves 0xffffffff in their place;
user32's unpack_message sees a non-resource value and points it at the
copy. packed_message_64to32 converted both through createstruct_64to32,
whose window check rejected the marker as an outside pointer: it logged
a refusal and handed the guest 0, so user32 took the name for an atom,
dropped it and read the class from the name's copy.

Pass the marker through unchanged for the packed message only. Every
other value converts as before, and wow64_to_guest still rejects
0xffffffff everywhere else, where a CREATESTRUCT's names are pointers.

Class: feature
Evidence: docs/evidence/2026-10-04-portal2-gameplay.md
Offered-upstream: no; the window exists only on the iOS port
---
 dlls/wow64win/user.c | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/dlls/wow64win/user.c b/dlls/wow64win/user.c
index f374186..cc84fb6 100644
--- a/dlls/wow64win/user.c
+++ b/dlls/wow64win/user.c
@@ -537,6 +537,26 @@ static void createstruct_64to32( const CREATESTRUCTW *from, CREATESTRUCT32 *to )
     memcpy( to, &cs, sizeof(cs) );
 }
 
+/* Playport (iOS): win32u's pack_user_message copies a WM_CREATE or
+ * WM_NCCREATE name and class after the structure and leaves this marker in
+ * their place, which user32's unpack_message replaces with the copies. The
+ * marker is not a pointer, so it passes unconverted; any other value converts
+ * as in createstruct_64to32. */
+#define PACKED_INLINE_STRING ((const WCHAR *)(ULONG_PTR)0xffffffff)
+
+static void packed_createstruct_64to32( const CREATESTRUCTW *from, CREATESTRUCT32 *to )
+{
+    CREATESTRUCTW cs = *from;
+    BOOL inline_name = cs.lpszName == PACKED_INLINE_STRING;
+    BOOL inline_class = cs.lpszClass == PACKED_INLINE_STRING;
+
+    if (inline_name) cs.lpszName = NULL;
+    if (inline_class) cs.lpszClass = NULL;
+    createstruct_64to32( &cs, to );
+    if (inline_name) to->lpszName = PtrToUlong( PACKED_INLINE_STRING );
+    if (inline_class) to->lpszClass = PtrToUlong( PACKED_INLINE_STRING );
+}
+
 static void winpos_32to64( WINDOWPOS *dst, const WINDOWPOS32 *src )
 {
     dst->hwnd            = LongToHandle( src->hwnd );
@@ -670,7 +690,7 @@ static size_t packed_message_64to32( UINT message, WPARAM wparam,
             CREATESTRUCT32 *cs32 = params32;
             const CREATESTRUCTW *cs64 = params64;
 
-            createstruct_64to32( cs64, cs32 );
+            packed_createstruct_64to32( cs64, cs32 );
             size -= sizeof(*cs64);
             if (size) memmove( cs32 + 1, cs64 + 1, size );
             return sizeof(*cs32) + size;
-- 
