From 97039fbb9fca556d5a6fa031105c6bd716e93642 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Sat, 3 Oct 2026 19:10:53 +0200
Subject: [PATCH 15/15] ntdll: take a WoW64 process's native DLLs from sysarm64
 on iOS

On iOS, system32 is the session's ARM64EC DLL set, and is_valid_binary
accepts any machine in a WoW64 process, so the native aarch64 loader of
an i386 title would not find wow64.dll and would load ARM64EC builds of
names such as win32u.dll. In a WoW64 process, the aarch64 build now
looks for a bare or system32 DLL name in C:\windows\sysarm64 first, a
farm of the aarch64 set that the app links. Already loaded modules are
found first, as before; other processes and builds are unchanged.

Class: feature
Evidence: docs/evidence/2026-10-03-portal2-wine-window.md
Offered-upstream: no; the farm layout is specific to the iOS port
---
 dlls/ntdll/loader.c | 57 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index 49d7a01..2d7260f 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -4007,6 +4007,52 @@ static NTSTATUS open_system_only_dll( const WCHAR *name, UNICODE_STRING *nt_name
 }
 
 
+#if defined(__aarch64__) && !defined(__arm64ec__)
+/***********************************************************************
+ *	open_wow64_native_dll
+ *
+ * Playport: system32 is the iOS session's ARM64EC set, and is_valid_binary
+ * accepts any machine in a WoW64 process, so the native loader of a WoW64
+ * process takes a bare or system32 name from C:\windows\sysarm64, the
+ * aarch64 set, first.
+ */
+static NTSTATUS open_wow64_native_dll( const WCHAR *libname, UNICODE_STRING *nt_name, WINE_MODREF **pwm,
+                                       HANDLE *mapping, SECTION_IMAGE_INFORMATION *image_info,
+                                       struct file_id *id )
+{
+    static const WCHAR sysarm64W[] = L"\\??\\C:\\windows\\sysarm64\\";
+    static const WCHAR system32W[] = L"C:\\windows\\system32\\";
+    const WCHAR *base = libname, *dir = libname, *p;
+    UNICODE_STRING str;
+    WCHAR buf[MAX_PATH];
+    NTSTATUS status;
+
+    if (!NtCurrentTeb()->WowTebOffset) return STATUS_DLL_NOT_FOUND;
+    for (p = libname; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+    if (base != libname)
+    {
+        if (!wcsncmp( dir, L"\\??\\", 4 )) dir += 4;
+        if (base - dir != wcslen( system32W ) || wcsnicmp( dir, system32W, wcslen( system32W ) ))
+            return STATUS_DLL_NOT_FOUND;
+    }
+    if (wcslen( base ) + ARRAY_SIZE( sysarm64W ) + 4 >= MAX_PATH) return STATUS_DLL_NOT_FOUND;
+    wcscpy( buf, sysarm64W );
+    wcscat( buf, base );
+    if (!wcschr( base, '.' )) wcscat( buf, L".dll" );
+    RtlInitUnicodeString( &str, buf );
+    if ((status = open_dll_file( &str, pwm, mapping, image_info, id ))) return status;
+    if (!RtlCreateUnicodeString( nt_name, buf ))
+    {
+        if (!*pwm) NtClose( *mapping );
+        *pwm = NULL;
+        return STATUS_NO_MEMORY;
+    }
+    TRACE( "%s from sysarm64\n", debugstr_w(libname) );
+    return STATUS_SUCCESS;
+}
+#endif
+
+
 /***********************************************************************
  *	find_dll_file
  *
@@ -4049,11 +4095,22 @@ static NTSTATUS find_dll_file( const WCHAR *load_path, const WCHAR *libname, UNI
                 TRACE( "Skipping file search for %s.\n", debugstr_w(libname) );
                 return STATUS_DLL_NOT_FOUND;
             }
+#if defined(__aarch64__) && !defined(__arm64ec__)
+            if (!open_wow64_native_dll( libname, nt_name, pwm, mapping, image_info, id )) return STATUS_SUCCESS;
+#endif
             if (!open_known_dll( libname, nt_name, pwm, mapping, image_info, id )) return STATUS_SUCCESS;
             if (!open_system_only_dll( libname, nt_name, pwm, mapping, image_info, id )) return STATUS_SUCCESS;
         }
     }
 
+#if defined(__aarch64__) && !defined(__arm64ec__)
+    if (contains_path( libname ) && !open_wow64_native_dll( libname, nt_name, pwm, mapping, image_info, id ))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, fullname );
+        return STATUS_SUCCESS;
+    }
+#endif
+
     /* Win 7/2008R2 and up seem to re-enable WoW64 FS redirection when loading libraries */
     RtlWow64EnableFsRedirectionEx( 0, &wow64_old_value );
 
-- 
