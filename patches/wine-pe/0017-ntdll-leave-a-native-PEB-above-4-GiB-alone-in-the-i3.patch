From 4ade3821239b02de5a47f23279e696a8f967a7f3 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Sat, 3 Oct 2026 20:42:23 +0200
Subject: [PATCH] ntdll: leave a native PEB above 4 GiB alone in the i386 guest

On iOS the native PEB of a WoW64 process stays above 4 GiB while the
guest lives in a window, so TEB64's Peb is not a guest address. The
i386 locale setup would truncate it and write the code page tables
there; skip the PEB64 copy instead.

Class: feature
Evidence: docs/evidence/2026-10-03-portal2-wow64-pointers.md
Offered-upstream: no; the window exists only on the iOS port
---
 dlls/ntdll/locale.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/dlls/ntdll/locale.c b/dlls/ntdll/locale.c
index a100a936531..f5347560643 100644
--- a/dlls/ntdll/locale.c
+++ b/dlls/ntdll/locale.c
@@ -102,6 +102,8 @@ static PEB64 *get_peb64( void )
     TEB64 *teb64 = NtCurrentTeb64();
 
     if (!teb64) return NULL;
+    /* a native PEB above 4 GiB (iOS keeps the guest in a window) is out of the guest's reach */
+    if (teb64->Peb >> 32) return NULL;
     return (PEB64 *)(UINT_PTR)teb64->Peb;
 }
 
