+                                                    (void *)thunk_list->u1.Function );
                 if (stub)
                 {
                     thunk_list->u1.Function = (ULONG_PTR)stub;
diff --git a/dlls/ntdll/ntdll_misc.h b/dlls/ntdll/ntdll_misc.h
index 58ad9ca6509..de9f7eb8508 100644
--- a/dlls/ntdll/ntdll_misc.h
+++ b/dlls/ntdll/ntdll_misc.h
@@ -217,4 +217,21 @@ extern struct ios_xp_nt ios_xp_nt;
 extern unsigned int ios_counters_on;
 extern void ios_xp_nt_init(void);
 
+#if defined(__aarch64__) || defined(__arm64ec__)
+/* Playport: RtlQueryPerformanceCounter's state (time.c). MADEIRA_X64_QPC_FASTPATH's
+ * x64 stub (loader.c) reads it at these offsets: a value is ticks(count) +
+ * offset only while seq is even and unchanged across the reads. */
+struct qpc_state
+{
+    volatile LONG seq;       /* 0x00: odd while a resync writes offset and last_sync */
+    BYTE x64_tsc_shift;      /* 0x04: the stub's own, RDTSC over the count: 0xff unknown, 0xfe unusable */
+    ULONGLONG freq;          /* 0x08: CNTFRQ, set once */
+    LONGLONG offset;         /* 0x10: ticks to add, 100 ns */
+    ULONGLONG last_sync;     /* 0x18: the count at the last resync, 0 before the first */
+};
+C_ASSERT( FIELD_OFFSET( struct qpc_state, x64_tsc_shift ) == 0x04 && FIELD_OFFSET( struct qpc_state, freq ) == 0x08 &&
+          FIELD_OFFSET( struct qpc_state, offset ) == 0x10 && FIELD_OFFSET( struct qpc_state, last_sync ) == 0x18 );
+extern struct qpc_state qpc_state;
+#endif
+
 #endif
diff --git a/dlls/ntdll/time.c b/dlls/ntdll/time.c
index 2fbda1ac54f..2c5ae32327f 100644
--- a/dlls/ntdll/time.c
+++ b/dlls/ntdll/time.c
@@ -391,9 +391,13 @@ LONGLONG WINAPI RtlGetSystemTimePrecise( void )
  * between the two is measured against the syscall and re-checked about once a
  * second of counter time. The offset only ever moves forward, and only by more
  * than 1 ms (a real sleep), so it is constant while the game runs and the
- * counter stays monotonic within and across threads. */
-static ULONGLONG qpc_freq, qpc_last_sync;
-static LONGLONG qpc_offset;
+ * counter stays monotonic within and across threads.
+ *
+ * Playport: the state is struct qpc_state (ntdll_misc.h), which
+ * MADEIRA_X64_QPC_FASTPATH's x64 stub (loader.c) reads too. A resync writes
+ * the offset and last_sync under its sequence count; a thread that finds
+ * another one writing leaves the update to it. */
+struct qpc_state qpc_state = { .x64_tsc_shift = 0xff };
 static LONG qpc_disabled;
 
 static inline ULONGLONG qpc_read_cntvct(void)
@@ -405,23 +409,39 @@ static inline ULONGLONG qpc_read_cntvct(void)
 
 static inline ULONGLONG qpc_to_ticks( ULONGLONG c )
 {
-    return (c / qpc_freq) * TICKSPERSEC + (c % qpc_freq) * TICKSPERSEC / qpc_freq;
+    return (c / qpc_state.freq) * TICKSPERSEC + (c % qpc_state.freq) * TICKSPERSEC / qpc_state.freq;
+}
+
+/* The offset to add after a resync that measured off at count c1: written
+ * with c1 as last_sync unless another thread is writing them. */
+static LONGLONG qpc_resync( LONGLONG off, ULONGLONG c1 )
+{
+    LONG seq = qpc_state.seq;
+
+    if ((seq & 1) || InterlockedCompareExchange( &qpc_state.seq, seq + 1, seq ) != seq)
+        return qpc_state.last_sync ? qpc_state.offset : off;
+    if (!qpc_state.last_sync || off > qpc_state.offset + TICKSPERSEC / 1000) qpc_state.offset = off;
+    qpc_state.last_sync = c1;
+    off = qpc_state.offset;
+    InterlockedExchange( &qpc_state.seq, seq + 2 );
+    return off;
 }
 
 BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter )
 {
     ULONGLONG c;
+    LONGLONG offset;
 
     if (qpc_disabled) goto slow;
-    if (!qpc_freq)
+    if (!qpc_state.freq)
     {
         ULONGLONG f;
         __asm__ __volatile__( "mrs %0, cntfrq_el0" : "=r"(f) );
         if (!f) { qpc_disabled = 1; goto slow; }
-        qpc_freq = f;
+        qpc_state.freq = f;
     }
     c = qpc_read_cntvct();
-    if (!qpc_last_sync || c - qpc_last_sync >= qpc_freq)
+    if (!qpc_state.last_sync || c - qpc_state.last_sync >= qpc_state.freq)
     {
         LARGE_INTEGER sys;
         ULONGLONG c0 = qpc_read_cntvct(), c1;
@@ -429,11 +449,11 @@ BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter
         NtQueryPerformanceCounter( &sys, NULL );
         c1 = qpc_read_cntvct();
         off = sys.QuadPart - (LONGLONG)qpc_to_ticks( c0 + (c1 - c0) / 2 );
-        if (!qpc_last_sync || off > qpc_offset + TICKSPERSEC / 1000) qpc_offset = off;
-        qpc_last_sync = c1;
+        offset = qpc_resync( off, c1 );
         c = c1;
     }
-    counter->QuadPart = (LONGLONG)qpc_to_ticks( c ) + qpc_offset;
+    else offset = qpc_state.offset;
+    counter->QuadPart = (LONGLONG)qpc_to_ticks( c ) + offset;
     if (ios_counters_on)
     {   /* ml1131: per-thread gap between successive reads (spin loop or not?).
          * Plain stores into the calling thread's slot; a tid-hash collision only
@@ -441,7 +461,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH RtlQueryPerformanceCounter( LARGE_INTEGER *counter
         static ULONGLONG t1, t10, t100, t1000;
         DWORD tid = GetCurrentThreadId();
         struct ios_xp_nt_qpc *q = &ios_xp_nt.qpc[(tid >> 2) & 255];
-        if (!t1) { ios_xp_nt_init(); t1 = qpc_freq / 1000000; t10 = t1 * 10; t100 = t1 * 100; t1000 = t1 * 1000; }
+        if (!t1) { ios_xp_nt_init(); t1 = qpc_state.freq / 1000000; t10 = t1 * 10; t100 = t1 * 100; t1000 = t1 * 1000; }
         if (q->tid != tid) { q->tid = tid; q->last = c; q->calls = 0; memset( q->hist, 0, sizeof(q->hist) ); }
         else
         {
