From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Sun, 27 Sep 2026 12:22:47 +0200
Subject: [PATCH] ffmpeg: narrow B first in the ARM64EC yuv2rgb NEON

The ARM64EC port of libswscale's yuv2rgb_neon.S keeps the six Y + R/G/B
sums in v10-v15, since v16-v31 are off limits there, but narrows them
in the aarch64 original's order: R1, R2, G1, G2, B1, B2. The outputs
are v4-v11, so for argb, bgra, bgr24 and gbrp an R2, G2 or R1 output
overwrites v10 (B1's sum) before B1 is narrowed, and for abgr R2 overwrites
v11 before B2. Every such conversion got a wrong blue channel in 8 of
every 16 pixels: Hollow Knight's cinematics, NV12 to BGRA through
msvproc, played with blue vertical stripes. Narrow B1 and B2 first; no
B output is v10-v15.

Class: upstream-bug
Evidence: docs/evidence/2026-09-26-hk-video.md
Offered-upstream: no
---
 libs/ffmpeg/libswscale/arm64ec/yuv2rgb_neon.S | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/libs/ffmpeg/libswscale/arm64ec/yuv2rgb_neon.S b/libs/ffmpeg/libswscale/arm64ec/yuv2rgb_neon.S
index 0792559..9b29c77 100644
--- a/libs/ffmpeg/libswscale/arm64ec/yuv2rgb_neon.S
+++ b/libs/ffmpeg/libswscale/arm64ec/yuv2rgb_neon.S
@@ -202,12 +202,14 @@
         add             v15.8h, v5.8h, v15.8h                           // Y2 + G2
         add             v10.8h, v4.8h, v10.8h                           // Y1 + B1
         add             v11.8h, v5.8h, v11.8h                           // Y2 + B2
+        // B first: the outputs include v10 and v11, which hold B1 and B2
+        // (the aarch64 original keeps these sums in v20-v25, which no output uses)
+        sqrshrun        \b1, v10.8h, #1                                 // clip_u8((Y1 + B1) >> 1)
+        sqrshrun        \b2, v11.8h, #1                                 // clip_u8((Y2 + B1) >> 1)
         sqrshrun        \r1, v12.8h, #1                                 // clip_u8((Y1 + R1) >> 1)
         sqrshrun        \r2, v13.8h, #1                                 // clip_u8((Y2 + R1) >> 1)
         sqrshrun        \g1, v14.8h, #1                                 // clip_u8((Y1 + G1) >> 1)
         sqrshrun        \g2, v15.8h, #1                                 // clip_u8((Y2 + G1) >> 1)
-        sqrshrun        \b1, v10.8h, #1                                 // clip_u8((Y1 + B1) >> 1)
-        sqrshrun        \b2, v11.8h, #1                                 // clip_u8((Y2 + B1) >> 1)
 .endm
 
 .macro declare_func ifmt ofmt
-- 
