From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Wed, 7 Oct 2026 12:00:00 +0200
Subject: [PATCH] wininet: report a LAN connection when there is no adapter
 table

InternetGetConnectedState takes the connection state from
GetAdaptersAddresses. On iOS there is no nsiproxy.sys, so \\.\Nsi does
not exist and the NDIS interface table is not served (Madeira's in-process
NSI fallback serves only the TCP connection tables). GetAdaptersAddresses
then fails with ERROR_FILE_NOT_FOUND on any network, and
InternetGetConnectedState returns FALSE, "offline".

The GOG Galaxy SDK calls InternetGetConnectedState as soon as the local
Galaxy service has returned its token, and when that returns FALSE it
gives up at once with FAILURE_REASON_CONNECTION_FAILURE, without
contacting auth.gog.com (Moonscars; Monster Train logs "Unable to
authenticate with GOG"). Under desktop Proton the same files sign in;
with the NSI device removed they fail the same way, and with this
behaviour (a shim) they sign in again with the device still removed.

When GetAdaptersAddresses fails with ERROR_FILE_NOT_FOUND or
ERROR_NOT_SUPPORTED, report a LAN connection, as the gateway case does,
with one FIXME. A real "no adapters" (ERROR_NO_DATA) and other errors
behave as before.

Class: upstream-bug
Evidence: docs/evidence/2026-10-07-gog-galaxy.md
Offered-upstream: no; upstream Wine has nsiproxy.sys, so the table exists
---
 dlls/wininet/internet.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/dlls/wininet/internet.c b/dlls/wininet/internet.c
index aacd507..8e71be6 100644
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -1565,6 +1565,7 @@ BOOL WINAPI InternetGetConnectedStateExW(LPDWORD lpdwStatus, LPWSTR lpszConnecti
     IP_ADAPTER_ADDRESSES *buf = NULL, *aa;
     ULONG size = 0;
     DWORD status;
+    BOOL no_adapter_table = FALSE;
 
     TRACE("(%p, %p, %ld, 0x%08lx)\n", lpdwStatus, lpszConnectionName, dwNameLen, dwReserved);
 
@@ -1588,7 +1589,18 @@ BOOL WINAPI InternetGetConnectedStateExW(LPDWORD lpdwStatus, LPWSTR lpszConnecti
             errcode = ERROR_NOT_ENOUGH_MEMORY;
         if (errcode != ERROR_BUFFER_OVERFLOW)
         {
-            if (errcode != ERROR_NO_DATA)
+            /* No adapter table at all is not "offline": without the \\.\Nsi device
+             * (the iOS runtime has no nsiproxy.sys) GetAdaptersAddresses fails with
+             * ERROR_FILE_NOT_FOUND whatever the network. Report a LAN connection,
+             * as a gateway does below. */
+            if (errcode == ERROR_FILE_NOT_FOUND || errcode == ERROR_NOT_SUPPORTED)
+            {
+                static LONG once;
+                if (!InterlockedExchange(&once, 1))
+                    FIXME("no adapter table (error %lu): returning a LAN connection\n", errcode);
+                no_adapter_table = TRUE;
+            }
+            else if (errcode != ERROR_NO_DATA)
             {
                 SetLastError(errcode);
                 return FALSE;
@@ -1599,6 +1611,7 @@ BOOL WINAPI InternetGetConnectedStateExW(LPDWORD lpdwStatus, LPWSTR lpszConnecti
     }
 
     status = INTERNET_RAS_INSTALLED;
+    if (no_adapter_table) status |= INTERNET_CONNECTION_LAN;
     for (aa = buf; aa; aa = aa->Next)
     {
         /* Connected, but not necessarily to internet */
