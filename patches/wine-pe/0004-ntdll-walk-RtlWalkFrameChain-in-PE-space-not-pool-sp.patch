From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Thu, 24 Sep 2026 12:00:00 +0200
Subject: [PATCH] ntdll: walk RtlWalkFrameChain in PE space, not pool space

The stack walk compared pool addresses against PE ranges and stopped early.

Class: upstream-bug
Evidence: docs/evidence/2026-09-24-bootstrap.md
Offered-upstream: no
---
 dlls/ntdll/signal_arm64ec.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 05ca354..77a1c9c 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -4699,7 +4699,10 @@ ULONG WINAPI RtlWalkFrameChain( void **buffer, ULONG count, ULONG flags )
 
     for (i = 0; i < count; i++)
     {
-        pc = context.Rip;
+        /* iOS: EC code runs from its JIT-pool copy, whose pc has no function
+         * table and is not EC code by the bitmap; walk in PE space, as
+         * virtual_unwind and unwind_one_frame do, and report PE addresses. */
+        pc = (ULONG_PTR)xlate_ios_jit_rev( (void *)context.Rip );
         if ((context.ContextFlags & CONTEXT_UNWOUND_TO_CALL) && RtlIsEcCode( pc )) pc -= 4;
         func = RtlLookupFunctionEntry( pc, &base, &table );
         if (RtlVirtualUnwind2( UNW_FLAG_NHANDLER, base, pc, func, &context, NULL,
@@ -4708,7 +4711,7 @@ ULONG WINAPI RtlWalkFrameChain( void **buffer, ULONG count, ULONG flags )
         if (!context.Rip) break;
         if (!frame || !is_valid_frame( frame )) break;
         if (context.Rsp == (ULONG_PTR)NtCurrentTeb()->Tib.StackBase) break;
-        if (i >= skip) buffer[num_entries++] = (void *)context.Rip;
+        if (i >= skip) buffer[num_entries++] = xlate_ios_jit_rev( (void *)context.Rip );
     }
     return num_entries;
 }
