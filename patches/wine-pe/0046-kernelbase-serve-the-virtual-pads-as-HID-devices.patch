diff --git a/dlls/kernelbase/hostpad.c b/dlls/kernelbase/hostpad.c
new file mode 100644
index 0000000..1cb1579
--- /dev/null
+++ b/dlls/kernelbase/hostpad.c
@@ -0,0 +1,348 @@
+/*
+ * Playport: a virtual HID gamepad for each host pad slot
+ *
+ * user32 lists one HID device per connected host slot in the raw input device
+ * list (input.c, GetRawInputDeviceList), named like the device Windows creates
+ * for an XInput pad. Unity's raw input layer opens that path, reads its
+ * attributes and HID caps, and then reads the pad through XInput or through
+ * HID input reports. There is no winebus or hidclass in this process, so the
+ * device is served here: CreateFileW opens a message pipe instead, a thread
+ * writes the slot's state into it as HID input reports, and DeviceIoControl
+ * answers the HID class IOCTLs.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "winioctl.h"
+#include "ddk/hidclass.h"
+#include "xinput.h"
+#include "ntuser.h"
+
+#include "kernelbase.h"
+#include "wine/debug.h"
+
+#include "hostpad_blob.h"
+
+#define HOSTPAD_SLOTS     4
+#define HOSTPAD_MAX_FILES 16
+
+struct hostpad_file
+{
+    HANDLE handle;   /* the reader end the caller holds */
+    UINT   slot;
+};
+
+static struct hostpad_file files[HOSTPAD_MAX_FILES];
+static LONG files_open; /* entries in use: lets every other handle skip the lock */
+static RTL_SRWLOCK files_lock = RTL_SRWLOCK_INIT;
+
+static ULONG_PTR (WINAPI *pNtUserCallTwoParam)( ULONG_PTR, ULONG_PTR, ULONG );
+
+/* The slot's XInput state from the host snapshot; FALSE when no pad is there. */
+static BOOL hostpad_state( UINT slot, XINPUT_STATE *state )
+{
+    memset( state, 0, sizeof(*state) );
+    if (!pNtUserCallTwoParam)
+    {
+        HMODULE win32u = GetModuleHandleW( L"win32u.dll" );
+        if (win32u) pNtUserCallTwoParam = (void *)GetProcAddress( win32u, "NtUserCallTwoParam" );
+        if (!pNtUserCallTwoParam) return FALSE;
+    }
+    return pNtUserCallTwoParam( slot | (NtUserGamepadOp_State << 8), (ULONG_PTR)state,
+                                NtUserCallTwoParam_GetGamepadState );
+}
+
+/* One input report (hostpad_report_desc): report ID 0; X, Y, Rx, Ry, Z as
+ * 16-bit 0..65535; buttons 1-10; a 4-bit hat switch, 0 for none. */
+static void hostpad_report( UINT slot, BYTE *report )
+{
+    static const BYTE hats[16] = { 0, 1, 5, 0, 7, 8, 6, 7, 3, 2, 4, 3, 0, 1, 5, 0 };
+    XINPUT_STATE state;
+    const XINPUT_GAMEPAD *pad = &state.Gamepad;
+    WORD x, y, rx, ry, z, buttons;
+    BYTE hat;
+
+    hostpad_state( slot, &state );
+    x = pad->sThumbLX + 32768;
+    y = 32767 - pad->sThumbLY;
+    rx = pad->sThumbRX + 32768;
+    ry = 32767 - pad->sThumbRY;
+    z = 32768 + (pad->bLeftTrigger - pad->bRightTrigger) * 128;
+    buttons = ((pad->wButtons & XINPUT_GAMEPAD_A) ? 0x001 : 0) | ((pad->wButtons & XINPUT_GAMEPAD_B) ? 0x002 : 0) |
+              ((pad->wButtons & XINPUT_GAMEPAD_X) ? 0x004 : 0) | ((pad->wButtons & XINPUT_GAMEPAD_Y) ? 0x008 : 0) |
+              ((pad->wButtons & XINPUT_GAMEPAD_LEFT_SHOULDER) ? 0x010 : 0) |
+              ((pad->wButtons & XINPUT_GAMEPAD_RIGHT_SHOULDER) ? 0x020 : 0) |
+              ((pad->wButtons & XINPUT_GAMEPAD_BACK) ? 0x040 : 0) | ((pad->wButtons & XINPUT_GAMEPAD_START) ? 0x080 : 0) |
+              ((pad->wButtons & XINPUT_GAMEPAD_LEFT_THUMB) ? 0x100 : 0) |
+              ((pad->wButtons & XINPUT_GAMEPAD_RIGHT_THUMB) ? 0x200 : 0);
+    /* hats[] is indexed by the D-pad bits: up 1, down 2, left 4, right 8 */
+    hat = hats[pad->wButtons & 0x0f];
+
+    report[0] = 0;
+    report[1] = x & 0xff;  report[2] = x >> 8;
+    report[3] = y & 0xff;  report[4] = y >> 8;
+    report[5] = rx & 0xff; report[6] = rx >> 8;
+    report[7] = ry & 0xff; report[8] = ry >> 8;
+    report[9] = z & 0xff;  report[10] = z >> 8;
+    report[11] = buttons & 0xff;
+    report[12] = ((buttons >> 8) & 0x03) | (hat << 2);
+}
+
+/* Writes the slot's reports into the pipe while its reader is open: on each
+ * change, and once a second, which also notices a closed reader. */
+struct hostpad_feed
+{
+    HANDLE writer;
+    UINT   slot;
+};
+
+static DWORD WINAPI hostpad_feed_thread( void *arg )
+{
+    struct hostpad_feed *feed = arg;
+    BYTE report[HOSTPAD_INPUT_LENGTH], last[HOSTPAD_INPUT_LENGTH];
+    DWORD written, quiet = 0;
+
+    memset( last, 0xff, sizeof(last) );
+    for (;;)
+    {
+        hostpad_report( feed->slot, report );
+        if (memcmp( report, last, sizeof(report) ) || ++quiet >= 125)
+        {
+            if (!WriteFile( feed->writer, report, sizeof(report), &written, NULL )) break;
+            memcpy( last, report, sizeof(report) );
+            quiet = 0;
+        }
+        Sleep( 8 );
+    }
+    CloseHandle( feed->writer );
+    HeapFree( GetProcessHeap(), 0, feed );
+    return 0;
+}
+
+/* \\?\HID#VID_045E&PID_02FF&IG_xx#3&5eadNNNN&0&0000#{...}: user32's name for slot NNNN. */
+static BOOL hostpad_parse_path( const WCHAR *path, UINT *slot )
+{
+    static const WCHAR prefix[] = L"\\\\?\\hid#vid_045e&pid_02ff&ig_";
+    const WCHAR *p;
+    UINT value = 0, i;
+
+    if (!path || wcsnicmp( path, prefix, ARRAY_SIZE(prefix) - 1 )) return FALSE;
+    if (!(p = wcsstr( path, L"#3&5ead" ))) return FALSE;
+    p += 7;
+    for (i = 0; i < 4; i++, p++)
+    {
+        if (*p >= '0' && *p <= '9') value = value * 16 + *p - '0';
+        else if (*p >= 'A' && *p <= 'F') value = value * 16 + *p - 'A' + 10;
+        else if (*p >= 'a' && *p <= 'f') value = value * 16 + *p - 'a' + 10;
+        else return FALSE;
+    }
+    if (value >= HOSTPAD_SLOTS) return FALSE;
+    *slot = value;
+    return TRUE;
+}
+
+static struct hostpad_file *hostpad_find( HANDLE handle )
+{
+    UINT i;
+
+    for (i = 0; i < HOSTPAD_MAX_FILES; i++)
+        if (files[i].handle && files[i].handle == handle) return &files[i];
+    return NULL;
+}
+
+/***********************************************************************
+ *           hostpad_open
+ *
+ * NULL when path is not a virtual pad; otherwise the reader end of a new pipe
+ * the pad's reports arrive on, or INVALID_HANDLE_VALUE.
+ */
+HANDLE hostpad_open( const WCHAR *path, DWORD attributes )
+{
+    static LONG serial;
+    struct hostpad_feed *feed;
+    struct hostpad_file *file;
+    XINPUT_STATE state;
+    WCHAR name[96];
+    HANDLE writer, reader, thread;
+    DWORD mode = PIPE_READMODE_MESSAGE;
+    UINT slot;
+
+    if (!hostpad_parse_path( path, &slot )) return NULL;
+    if (!hostpad_state( slot, &state ))
+    {
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return INVALID_HANDLE_VALUE;
+    }
+
+    swprintf( name, ARRAY_SIZE(name), L"\\\\.\\pipe\\playport-hostpad-%u-%lu-%ld", slot,
+              GetCurrentProcessId(), InterlockedIncrement( &serial ) );
+    writer = CreateNamedPipeW( name, PIPE_ACCESS_OUTBOUND, PIPE_TYPE_MESSAGE | PIPE_WAIT, 1,
+                               4 * HOSTPAD_INPUT_LENGTH, 4 * HOSTPAD_INPUT_LENGTH, 0, NULL );
+    if (writer == INVALID_HANDLE_VALUE)
+    {
+        return INVALID_HANDLE_VALUE;
+    }
+    reader = CreateFileW( name, GENERIC_READ | FILE_WRITE_ATTRIBUTES, 0, NULL, OPEN_EXISTING,
+                          attributes & FILE_FLAG_OVERLAPPED, NULL );
+    if (reader == INVALID_HANDLE_VALUE)
+    {
+        CloseHandle( writer );
+        return INVALID_HANDLE_VALUE;
+    }
+    SetNamedPipeHandleState( reader, &mode, NULL, NULL );
+
+    RtlAcquireSRWLockExclusive( &files_lock );
+    for (file = files; file < files + HOSTPAD_MAX_FILES && file->handle; file++);
+    if (file < files + HOSTPAD_MAX_FILES)
+    {
+        file->handle = reader;
+        file->slot = slot;
+        InterlockedIncrement( &files_open );
+    }
+    else file = NULL;
+    RtlReleaseSRWLockExclusive( &files_lock );
+
+    if (!file || !(feed = HeapAlloc( GetProcessHeap(), 0, sizeof(*feed) )))
+    {
+        if (file) hostpad_close( reader );
+        CloseHandle( reader );
+        CloseHandle( writer );
+        SetLastError( ERROR_TOO_MANY_OPEN_FILES );
+        return INVALID_HANDLE_VALUE;
+    }
+    feed->writer = writer;
+    feed->slot = slot;
+    if (!(thread = CreateThread( NULL, 0, hostpad_feed_thread, feed, 0, NULL )))
+    {
+        CloseHandle( writer );
+        HeapFree( GetProcessHeap(), 0, feed );
+    }
+    else CloseHandle( thread );
+
+    return reader;
+}
+
+/***********************************************************************
+ *           hostpad_close
+ *
+ * Forgets a handle that is closed, or that a new open reused.
+ */
+void hostpad_close( HANDLE handle )
+{
+    struct hostpad_file *file;
+
+    if (!handle || handle == INVALID_HANDLE_VALUE || !ReadNoFence( &files_open )) return;
+    RtlAcquireSRWLockExclusive( &files_lock );
+    if ((file = hostpad_find( handle )))
+    {
+        file->handle = NULL;
+        InterlockedDecrement( &files_open );
+    }
+    RtlReleaseSRWLockExclusive( &files_lock );
+}
+
+static NTSTATUS hostpad_copy( const void *data, DWORD size, void *out, DWORD out_count, DWORD *len )
+{
+    if (out_count < size) return STATUS_BUFFER_TOO_SMALL;
+    memcpy( out, data, size );
+    *len = size;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS hostpad_string( const WCHAR *str, void *out, DWORD out_count, DWORD *len )
+{
+    DWORD size = (wcslen( str ) + 1) * sizeof(WCHAR);
+
+    if (!out_count) return STATUS_INVALID_USER_BUFFER;
+    if (size > out_count) size = out_count;
+    memcpy( out, str, size );
+    *len = size;
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ *           hostpad_ioctl
+ *
+ * FALSE when handle is not a virtual pad; otherwise the IOCTL is answered and
+ * *ret holds what DeviceIoControl returns.
+ */
+BOOL hostpad_ioctl( HANDLE handle, DWORD code, void *in_buff, DWORD in_count, void *out_buff,
+                    DWORD out_count, DWORD *returned, OVERLAPPED *overlapped, BOOL *ret )
+{
+    HID_COLLECTION_INFORMATION info;
+    BYTE report[HOSTPAD_INPUT_LENGTH];
+    struct hostpad_file *file;
+    NTSTATUS status;
+    DWORD len = 0;
+    UINT slot;
+
+    if (!ReadNoFence( &files_open )) return FALSE;
+    RtlAcquireSRWLockShared( &files_lock );
+    if ((file = hostpad_find( handle ))) slot = file->slot;
+    RtlReleaseSRWLockShared( &files_lock );
+    if (!file) return FALSE;
+
+    switch (code)
+    {
+    case IOCTL_HID_GET_COLLECTION_INFORMATION:
+        memset( &info, 0, sizeof(info) );
+        info.DescriptorSize = sizeof(hostpad_preparsed);
+        info.VendorID = 0x045e;
+        info.ProductID = 0x02ff;
+        info.VersionNumber = 0x0114;
+        status = hostpad_copy( &info, sizeof(info), out_buff, out_count, &len );
+        break;
+    case IOCTL_HID_GET_COLLECTION_DESCRIPTOR:
+        status = hostpad_copy( hostpad_preparsed, sizeof(hostpad_preparsed), out_buff, out_count, &len );
+        break;
+    case IOCTL_HID_GET_PRODUCT_STRING:
+        status = hostpad_string( L"Controller (XBOX One For Windows)", out_buff, out_count, &len );
+        break;
+    case IOCTL_HID_GET_MANUFACTURER_STRING:
+        status = hostpad_string( L"Microsoft", out_buff, out_count, &len );
+        break;
+    case IOCTL_HID_GET_SERIALNUMBER_STRING:
+        status = hostpad_string( slot == 0 ? L"hostpad0" : slot == 1 ? L"hostpad1" : slot == 2 ? L"hostpad2" : L"hostpad3",
+                                 out_buff, out_count, &len );
+        break;
+    case IOCTL_HID_GET_INPUT_REPORT:
+        hostpad_report( slot, report );
+        status = hostpad_copy( report, sizeof(report), out_buff, out_count, &len );
+        break;
+    case IOCTL_GET_NUM_DEVICE_INPUT_BUFFERS:
+    {
+        ULONG count = 32;
+        status = hostpad_copy( &count, sizeof(count), out_buff, out_count, &len );
+        break;
+    }
+    case IOCTL_SET_NUM_DEVICE_INPUT_BUFFERS:
+    case IOCTL_HID_FLUSH_QUEUE:
+    case IOCTL_HID_SET_OUTPUT_REPORT:
+        status = STATUS_SUCCESS;
+        break;
+    default:
+        status = STATUS_NOT_SUPPORTED;
+        break;
+    }
+
+    if (returned) *returned = len;
+    if (overlapped)
+    {
+        overlapped->Internal = status;
+        overlapped->InternalHigh = len;
+        if (overlapped->hEvent) SetEvent( (HANDLE)((ULONG_PTR)overlapped->hEvent & ~1) );
+    }
+    *ret = !status;
+    if (status) SetLastError( RtlNtStatusToDosError( status ) );
+    return TRUE;
+}
