+/*************************************************************************
+ *	CreateFileW   (kernelbase.@)
+ *
+ * Playport: the path of a host pad user32 lists opens its virtual HID device
+ * (hostpad.c).
+ */
+HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWORD sharing,
+                                             LPSECURITY_ATTRIBUTES sa, DWORD creation,
+                                             DWORD attributes, HANDLE template )
+{
+    HANDLE ret;
+
+    if ((ret = hostpad_open( filename, attributes ))) return ret;
+    ret = create_file_w( filename, access, sharing, sa, creation, attributes, template );
+    if (ret != INVALID_HANDLE_VALUE) hostpad_close( ret ); /* a closed pad's handle value, reused */
+    return ret;
+}
