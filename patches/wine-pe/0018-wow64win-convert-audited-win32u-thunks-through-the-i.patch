diff --git a/dlls/wow64win/syscall.c b/dlls/wow64win/syscall.c
index def438b..6c9d83c 100644
--- a/dlls/wow64win/syscall.c
+++ b/dlls/wow64win/syscall.c
@@ -27,6 +27,9 @@
 #include "winternl.h"
 #include "rtlsupportapi.h"
 #include "wow64win_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wow);
 
 static void DECLSPEC_NORETURN stub_syscall( const char *name )
 {
@@ -45,9 +48,35 @@ static void DECLSPEC_NORETURN stub_syscall( const char *name )
 #define SYSCALL_STUB(name) NTSTATUS WINAPI wow64_ ## name( UINT *args ) { stub_syscall( #name ); }
 ALL_SYSCALL_STUBS
 
+ULONG64 wow64_window_base = 0;
+
+/* Playport (iOS): only the thunks audited for the guest window run in a
+ * windowed process. Any other win32u call ends it, naming the call. */
+#define WINDOW_PROBE_SECOND(a, b, ...) b
+#define WINDOW_PROBE(...) WINDOW_PROBE_SECOND(__VA_ARGS__, 0, 0)
+#define WINDOW_AUDITED(name) WINDOW_PROBE(WINDOW_AUDITED_ ## name)
+#include "window_audited.h"
+
+static NTSTATUS window_unaudited( ULONG id, UINT *args, NTSTATUS (WINAPI *thunk)(UINT *) )
+{
+    if (!wow64_window_base) return thunk( args );
+    ERR( "Playport: i386 win32u system call %04lx (args %p: %08x %08x %08x %08x); "
+         "its thunk is not audited for the guest window, stopping\n", id, args,
+         args[0], args[1], args[2], args[3] );
+    NtTerminateProcess( GetCurrentProcess(), STATUS_NOT_SUPPORTED );
+    return STATUS_NOT_SUPPORTED;
+}
+
+#define SYSCALL_ENTRY(id,name,_args) \
+    static NTSTATUS WINAPI window_unaudited_ ## name( UINT *args ) \
+    { return window_unaudited( id, args, wow64_ ## name ); }
+ALL_SYSCALLS32
+#undef SYSCALL_ENTRY
+
 static void * const win32_syscalls[] =
 {
-#define SYSCALL_ENTRY(id,name,args) wow64_ ## name,
+#define SYSCALL_ENTRY(id,name,args) \
+    WINDOW_AUDITED(name) ? (void *)wow64_ ## name : (void *)window_unaudited_ ## name,
     ALL_SYSCALLS32
 #undef SYSCALL_ENTRY
 };
@@ -67,11 +96,36 @@ const SYSTEM_SERVICE_TABLE sdwhwin32 =
     arguments
 };
 
+/**********************************************************************
+ *           wow64_guest_rejected
+ *
+ * A host pointer that should go to the guest but is not in its window.
+ */
+ULONG wow64_guest_rejected( const void *host )
+{
+    ERR( "host pointer %p (from %p) is outside the guest window at %#I64x, giving the guest 0\n",
+         host, __builtin_return_address(0), wow64_window_base );
+    return 0;
+}
+
+/* The window's base, from the paired TEB32 and PEB32 as wow64.dll takes it. */
+static void init_window_base(void)
+{
+    TEB32 *teb32 = (TEB32 *)((char *)NtCurrentTeb() + NtCurrentTeb()->WowTebOffset);
+    ULONG_PTR peb32 = 0;
+
+    NtQueryInformationProcess( GetCurrentProcess(), ProcessWow64Information, &peb32, sizeof(peb32), NULL );
+    if ((ULONG_PTR)teb32 == teb32->Tib.Self && peb32 == teb32->Peb) return;
+    wow64_window_base = wow64_window_base_from_pair( (ULONG_PTR)teb32, teb32->Tib.Self, peb32, teb32->Peb );
+    ERR( "Playport: guest window base %#I64x\n", wow64_window_base );
+}
+
 
 BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
 {
     if (reason != DLL_PROCESS_ATTACH) return TRUE;
     LdrDisableThreadCalloutsForDll( inst );
+    init_window_base();
     NtCurrentTeb()->Peb->KernelCallbackTable = user_callbacks;
     return TRUE;
 }
