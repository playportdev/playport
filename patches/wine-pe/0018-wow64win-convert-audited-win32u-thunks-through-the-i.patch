 dlls/wow64win/user.c             | 120 +++++----
 dlls/wow64win/window_audited.h   | 409 +++++++++++++++++++++++++++++++
 dlls/wow64win/wow64win_private.h |  59 ++++-
 6 files changed, 590 insertions(+), 71 deletions(-)
 create mode 100644 dlls/wow64win/window_audited.h

