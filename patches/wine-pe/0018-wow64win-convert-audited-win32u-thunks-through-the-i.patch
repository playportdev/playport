+extern ULONG64 wow64_window_base;
+extern ULONG wow64_guest_rejected( const void *host );
+
+/* A guest pointer the native side dereferences, as a host pointer in the window. */
+static inline void *wow64_to_host( ULONG guest )
+{
+    return wow64_window_to_host( wow64_window_base, guest );
+}
+
+/* A host pointer into the window, as the guest address. A pointer outside the
+ * window is logged and becomes 0, never a truncated address. */
+static inline ULONG wow64_to_guest( const void *host )
+{
+    uint32_t guest;
+
+    if (wow64_window_to_guest( wow64_window_base, host, &guest )) return guest;
+    return wow64_guest_rejected( host );
+}
+
+/* A name that is a pointer or an integer atom or resource id (IS_INTRESOURCE),
+ * or a parameter that holds a pointer or a small integer: only a pointer
+ * converts. */
+static inline void *wow64_intres_to_host( ULONG guest )
+{
+    return guest >> 16 ? wow64_to_host( guest ) : ULongToPtr( guest );
+}
+
+static inline ULONG wow64_intres_to_guest( const void *host )
+{
+    return (ULONG_PTR)host >> 16 ? wow64_to_guest( host ) : PtrToUlong( host );
+}
