 programs/winevdm/Makefile.in         | 2 +-
 programs/wuauserv/Makefile.in        | 2 +-
 10 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/programs/conhost/Makefile.in b/programs/conhost/Makefile.in
index 6d4caea..0d3157a 100644
--- a/programs/conhost/Makefile.in
+++ b/programs/conhost/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = conhost.exe
 IMPORTS   = user32 gdi32 advapi32
 DELAYIMPORTS = comctl32 winmm
-ENABLE_ARCHS = $(HOST_ARCH)
+ENABLE_ARCHS = $(HOST_ARCH) arm64ec
 
 EXTRADLLFLAGS = -mwindows -municode
 
