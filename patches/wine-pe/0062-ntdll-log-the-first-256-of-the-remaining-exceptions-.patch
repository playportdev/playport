From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Sun, 1 Nov 2026 17:50:06 +0100
Subject: [PATCH] ntdll: log the first 256 of the remaining exceptions' [rtcs]
 pre lines

prepare_exception_arm64ec printed an "[rtcs] pre" line for every
exception other than a misaligned atomic or a write to tracked code,
which were already counted: two per guest fault FEX raises (its break,
then the guest's own). World of Warcraft's x64 client takes one per
4 KB page of its code, and run 20261101T172555 looped on one, 24,927
lines per 100,000 of its log. The first 256 and every 65536th now
print, with the count; FEX's [exc-census] counts them by kind.

Linear: PLA-516
Class: diagnostics
Evidence: docs/evidence/2026-11-01-wow-x64-fex.md
Offered-upstream: no
---
 dlls/ntdll/signal_arm64ec.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index c4d6d94..027827a 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -4063,11 +4063,20 @@ static void * __attribute__((used)) prepare_exception_arm64ec( EXCEPTION_RECORD
                      pResetToConsistentState, get_arm64ec_cpu_area()->InSimulation,
                      (void *)rec->ExceptionInformation[1], n );
         }
+        /* Playport (PLA-516): every other exception printed this line too, and a guest that
+         * takes one per page of its code, or loops on one, filled the dev log. The first 256
+         * and every 65536th are logged, with the count; FEX's [exc-census] counts them by kind. */
         else
-            ERR( "[rtcs] pre: code=%08x addr=%p armPc=%p ecRip=%p rtcs=%p insim=%u\n",
-                 (unsigned int)rec->ExceptionCode, rec->ExceptionAddress,
-                 (void *)(ULONG_PTR)arm_ctx->Pc, (void *)(ULONG_PTR)context->AMD64_Context.Rip,
-                 pResetToConsistentState, get_arm64ec_cpu_area()->InSimulation );
+        {
+            static LONG other_n;
+            LONG n = InterlockedIncrement( &other_n );
+            if (n <= 256 || !(n % 65536))
+                ERR( "[rtcs] pre: code=%08x addr=%p armPc=%p ecRip=%p rtcs=%p insim=%u (#%ld; the first 256 and "
+                     "every 65536th are logged)\n",
+                     (unsigned int)rec->ExceptionCode, rec->ExceptionAddress,
+                     (void *)(ULONG_PTR)arm_ctx->Pc, (void *)(ULONG_PTR)context->AMD64_Context.Rip,
+                     pResetToConsistentState, get_arm64ec_cpu_area()->InSimulation, n );
+        }
     }
     if (pResetToConsistentState) pResetToConsistentState( rec, &context->AMD64_Context, arm_ctx );
     {
