diff --git a/build/ntdll-unix/wow64_protect.h b/build/ntdll-unix/wow64_protect.h
new file mode 100644
index 0000000..5086788
--- /dev/null
+++ b/build/ntdll-unix/wow64_protect.h
@@ -0,0 +1,96 @@
+/* Logical 4 KiB Wine page protections over native-NX 16 KiB host pages.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Included after Wine's view/page/protection helpers, before mprotect_range.
+ * virtual_mutex must be held by every caller.
+ */
+#ifndef IOS_WOW64_PROTECT_H
+#define IOS_WOW64_PROTECT_H
+
+/* x86 execute-only pages must remain readable by the decoder, not executable
+ * by ARM64. Keep Wine's logical byte unchanged. */
+static unsigned int ios_wow64_vm_native_vprot( unsigned int vprot )
+{
+    return (vprot & ~VPROT_EXEC) | ((vprot & VPROT_EXEC) ? VPROT_READ : 0);
+}
+
+/* Native protection of the host page at `host`: the union of its Wine pages'
+ * native permissions, Wine's own policy for 16 KiB hosts. Uncommitted and
+ * guard pages grant nothing; nothing grants native EXEC. A Wine page stricter
+ * than a neighbour in the same host page is enforced only logically (there is
+ * no window fault service yet). A guard page is never left unenforced: a host
+ * page holding a committed guard page is PROT_NONE, and *mixed_guard tells
+ * the caller when that would also revoke an accessible neighbour.
+ * Pages in [start, start + length) read as `replacement`, a pending change.
+ */
+static int ios_wow64_host_prot( uintptr_t host, uintptr_t start, size_t length,
+                                unsigned int replacement, BYTE set, BYTE clear,
+                                BOOL *mixed_guard )
+{
+    uintptr_t page;
+    unsigned int vprot;
+    BOOL guard = FALSE;
+    int prot = PROT_NONE;
+
+    for (page = host; page - host < host_page_size; page += page_size)
+    {
+        vprot = page - start < length ? replacement : get_page_vprot( (void *)page );
+        vprot = (vprot & ~clear) | set;
+        if ((vprot & (VPROT_COMMITTED | VPROT_GUARD)) == (VPROT_COMMITTED | VPROT_GUARD))
+            guard = TRUE;
+        prot |= get_unix_prot( ios_wow64_vm_native_vprot( vprot ) );
+    }
+    if (mixed_guard) *mixed_guard = guard && prot != PROT_NONE;
+    return guard ? PROT_NONE : prot;
+}
+
+/* Give whole Wine pages [base, base + length) of a window image or anonymous
+ * VM view the logical protection `vprot`. Nothing changes on refusal: every
+ * host page is checked first. Each host page then changes with its own
+ * mprotect, which cannot apply partially. If one fails, the pages already
+ * changed get back the protection of the unchanged page bytes (outside image
+ * setup, the protection they had), and the bytes are published only after
+ * every page succeeded. Restoring a protection that this mapping already had
+ * cannot fail short of a kernel fault; if it does, stop rather than run on
+ * with a protection that no page byte describes.
+ * Backing is never replaced. A private image page with WRITECOPY becomes
+ * writable MAP_PRIVATE file or anonymous memory: a write makes a private copy
+ * and never reaches the file. Shared image sections are refused at map time.
+ */
+static NTSTATUS ios_wow64_apply_protection( struct file_view *view, void *base,
+                                           size_t length, unsigned int vprot )
+{
+    uintptr_t start = (uintptr_t)base, first, end, host;
+    BOOL mixed;
+
+    if (!view || !(view->protect & (VPROT_WOW64_IMAGE | VPROT_WOW64_VM)) ||
+        !length || (start & page_mask) || (length & page_mask) ||
+        ((uintptr_t)view->base & host_page_mask) || (view->size & host_page_mask) ||
+        start < (uintptr_t)view->base || start - (uintptr_t)view->base >= view->size ||
+        length > view->size - (start - (uintptr_t)view->base)) return STATUS_INVALID_PARAMETER;
+    /* Image pages are private copy-on-write; anonymous VM has no file. */
+    if ((view->protect & VPROT_WOW64_IMAGE) ? (vprot & VPROT_WRITE) : (vprot & VPROT_WRITECOPY))
+        return STATUS_INVALID_PAGE_PROTECTION;
+    first = start & ~(uintptr_t)host_page_mask;
+    end = (start + length + host_page_mask) & ~(uintptr_t)host_page_mask;
+    for (host = first; host < end; host += host_page_size)
+    {
+        ios_wow64_host_prot( host, start, length, vprot, 0, 0, &mixed );
+        if (mixed) return STATUS_NOT_SUPPORTED;
+    }
+    for (host = first; host < end; host += host_page_size)
+    {
+        if (!mprotect( (void *)host, host_page_size,
+                       ios_wow64_host_prot( host, start, length, vprot, 0, 0, NULL ) )) continue;
+        while (host > first)
+        {
+            host -= host_page_size;
+            if (mprotect( (void *)host, host_page_size,
+                          ios_wow64_host_prot( host, 0, 0, 0, 0, 0, NULL ) )) abort();
+        }
+        return STATUS_ACCESS_DENIED;
+    }
+    set_page_vprot( base, length, vprot );
+    return STATUS_SUCCESS;
+}
+
+#endif
