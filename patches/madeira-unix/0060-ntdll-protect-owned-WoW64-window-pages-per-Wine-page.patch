+/* Native NtProtectVirtualMemory on whole Wine (4 KiB) pages of one window
+ * image or anonymous VM allocation, as Wine does it: every page committed,
+ * the old protection is the first page's. Images keep copy-on-write
+ * (READWRITE becomes WRITECOPY, as for Wine images); anonymous VM refuses
+ * WRITECOPY. Modifiers that page bytes cannot hold (cache, CFG) are refused,
+ * not dropped. Bootstrap TEB/PEB views, quarantined images and host-page
+ * padding past the server's image extent are not supported. Free space, the
+ * low guard and ranges leaving the allocation are invalid. Outputs change
+ * only on success; failure leaves every page byte and protection unchanged.
+ */
 static NTSTATUS ios_wow64_vm_protect( uintptr_t window, void **addr, size_t *size,
                                      ULONG protect, ULONG *old_protect )
 {
     struct file_view *view;
-    void *base;
-    char *p;
+    uintptr_t value, start, offset;
     size_t length;
     unsigned int vprot;
     ULONG old;
+    BOOL image;
+    char *p;
     NTSTATUS status;
-    if (!addr || !size || !old_protect ||
-        !ios_wow64_vm_range( window, *addr, *size, &base, &length )) return STATUS_INVALID_PARAMETER;
-    view = find_view( base, length );
-    if (!view || !(view->protect & VPROT_WOW64_VM)) return STATUS_NOT_SUPPORTED;
-    if ((status = get_vprot_flags( protect, &vprot, FALSE ))) return status;
-    if (vprot & ~(VPROT_READ | VPROT_WRITE | VPROT_EXEC)) return STATUS_NOT_SUPPORTED;
-    for (p = base; p < (char *)base + length; p += page_size)
+    if (!addr || !size) return STATUS_INVALID_PARAMETER;
+    if (!old_protect) return STATUS_ACCESS_VIOLATION;
+    value = (uintptr_t)*addr;
+    if (!ios_wow64_valid_base( window ) || value < window + IOS_WOW64_NULL_GUARD ||
+        value - window >= IOS_WOW64_WINDOW_SIZE || !*size ||
