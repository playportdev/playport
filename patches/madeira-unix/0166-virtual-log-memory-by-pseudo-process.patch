From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Mon, 19 Oct 2026 14:42:52 +0200
Subject: [PATCH] virtual: log memory by pseudo-process

Every Wine view carries the pseudo-process that made it (0154), but no
line split memory by process: the guest band and FEX's band were only
summed by address ([phys-map]) or by kind ([guest-census], [band]).
ios_process_memory_log charges each view's committed pages to its owner,
as an image's, as private memory, or as FEX's host memory when the view
is in FEX's band (also counted by shape: rpmalloc spans, call-return
stacks, L1 lookup caches), with the runtime's own views as one row. Each
owner gets its pid, live threads and image name from teb_list. The views
are walked under virtual_mutex; mincore then sorts their host pages into
resident and compressed outside it. The JIT pool, a fixed size the pool
lines report, is left out. The host calls it from its own thread; it
prints `[proc-mem]` lines only when an owner came or went or moved by
32 MiB since its last print, or when forced, with what the walk cost.
pp_proc_mem.h holds the table, its change test and its rows, so a host
test compiles it as shipped.

Linear: PLA-414
Class: diagnostics
Evidence: docs/evidence/2026-10-19-rdr2-loading-memory.md
Offered-upstream: no; pseudo-processes and FEX's band are the iOS port's
---
 build/ntdll-unix/pp_proc_mem.h | 120 +++++++++++++++++++++++++
 build/ntdll-unix/virtual_ios.c | 155 +++++++++++++++++++++++++++++++++
 2 files changed, 275 insertions(+)
 create mode 100644 build/ntdll-unix/pp_proc_mem.h

diff --git a/build/ntdll-unix/pp_proc_mem.h b/build/ntdll-unix/pp_proc_mem.h
new file mode 100644
index 0000000..b07a413
--- /dev/null
+++ b/build/ntdll-unix/pp_proc_mem.h
@@ -0,0 +1,120 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Memory by pseudo-process (Playport diagnostics, PLA-414): the table the
+ * `[proc-mem]` lines print. Every Wine view belongs to the pseudo-process
+ * whose allocation or section map made it (file_view.ios_owner_peb), or to
+ * the runtime (NULL). A view's committed pages are charged to its owner, as
+ * an image's, as private memory, or as FEX's host memory when the view lies
+ * in FEX's band; mincore adds what of them is resident and compressed. FEX's
+ * views are also counted by shape, as the band census counts them. Pure
+ * arithmetic and formatting, so a host test compiles this header as is. */
+#ifndef PP_PROC_MEM_H
+#define PP_PROC_MEM_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { PPM_IMAGE, PPM_PRIVATE, PPM_FEX, PPM_KINDS };
+enum { PPM_COMMITTED, PPM_RESIDENT, PPM_COMPRESSED, PPM_MEASURES };
+enum { PPM_FEX_SPAN, PPM_FEX_CALLRET, PPM_FEX_L1, PPM_FEX_OTHER };
+#define PPM_OWNERS 64                 /* the runtime and 63 processes; more are counted as dropped */
+#define PPM_SPAN 0x100000ull          /* rpmalloc's span: 1 MiB, 1 MiB-aligned */
+#define PPM_CALLRET 0x400000ull       /* FEX's call-return stack: 4 MiB and its guard pages */
+#define PPM_L1 0x200000ull            /* FEX's L1 lookup cache */
+
+struct ppm_owner
+{
+    const void *peb;                  /* NULL: the runtime's own views */
+    unsigned pid, threads;            /* from its live threads; 0 when none is left */
+    char name[32];                    /* its image's file name, ASCII */
+    unsigned long long bytes[PPM_KINDS][PPM_MEASURES];
+    unsigned fex_views[PPM_FEX_OTHER + 1];
+};
+
+struct ppm_table
+{
+    unsigned count, dropped_views;
+    struct ppm_owner owner[PPM_OWNERS];
+};
+
+/* The owner's row, added on first use; NULL once the table is full. */
+static inline struct ppm_owner *ppm_owner_for( struct ppm_table *t, const void *peb )
+{
+    unsigned i;
+    for (i = 0; i < t->count; i++) if (t->owner[i].peb == peb) return &t->owner[i];
+    if (t->count == PPM_OWNERS) return NULL;
+    memset( &t->owner[t->count], 0, sizeof(t->owner[0]) );
+    t->owner[t->count].peb = peb;
+    return &t->owner[t->count++];
+}
+
+/* What a FEX view is, by its shape (the band census's rules). */
+static inline int ppm_fex_shape( uintptr_t base, unsigned long long size )
+{
+    if (size == PPM_SPAN && !(base & (PPM_SPAN - 1))) return PPM_FEX_SPAN;
+    if (size > PPM_CALLRET && size <= PPM_CALLRET + 0x10000) return PPM_FEX_CALLRET;
+    if (size == PPM_L1) return PPM_FEX_L1;
+    return PPM_FEX_OTHER;
+}
+
+/* Where a view's pages go: FEX's band [fex_lo, fex_hi) first, then images. */
+static inline int ppm_kind( uintptr_t base, uintptr_t fex_lo, uintptr_t fex_hi, int image )
+{
+    if (fex_lo && base >= fex_lo && base < fex_hi) return PPM_FEX;
+    return image ? PPM_IMAGE : PPM_PRIVATE;
+}
+
+/* The file name of a UTF-16 path of `chars` characters, non-ASCII as '?'. */
+static inline void ppm_name( char *out, size_t size, const uint16_t *path, size_t chars )
+{
+    size_t start = 0, i, n = 0;
+    for (i = 0; i < chars; i++) if (path[i] == '\\' || path[i] == '/') start = i + 1;
+    for (i = start; i < chars && n + 1 < size; i++) out[n++] = path[i] < 0x80 && path[i] > 0x20 ? (char)path[i] : '?';
+    if (size) out[n] = 0;
+}
+
+static inline unsigned long long ppm_sum( const struct ppm_owner *o, int measure )
+{
+    return o->bytes[PPM_IMAGE][measure] + o->bytes[PPM_PRIVATE][measure] + o->bytes[PPM_FEX][measure];
+}
+
+/* Whether `now` is worth printing after the last printed `last` (NULL: none
+ * yet): an owner came or went, or any owner's committed, resident or
+ * compressed total moved by `by` bytes or more. */
+static inline int ppm_moved( const struct ppm_table *now, const struct ppm_table *last, unsigned long long by )
+{
+    unsigned i, j;
+    int m;
+    if (!last || now->count != last->count) return 1;
+    for (i = 0; i < now->count; i++)
+    {
+        const struct ppm_owner *a = &now->owner[i], *b = NULL;
+        for (j = 0; j < last->count; j++) if (last->owner[j].peb == a->peb) b = &last->owner[j];
+        if (!b || a->pid != b->pid) return 1;
+        for (m = 0; m < PPM_MEASURES; m++)
+        {
+            unsigned long long x = ppm_sum( a, m ), y = ppm_sum( b, m );
+            if ((x > y ? x - y : y - x) >= by) return 1;
+        }
+    }
+    return 0;
+}
+
+/* One owner's row, in MiB committed/resident/compressed:
+ * `pid=0074 RDR2.exe threads=62 image=… private=… fex=… spans=… callret=… l1=… fex_other=…` */
+static inline int ppm_row( const struct ppm_owner *o, char *buf, size_t size )
+{
+    static const char *const kind[PPM_KINDS] = { "image", "private", "fex" };
+    int n, k;
+    if (!o->peb) n = snprintf( buf, size, "runtime" );
+    else if (o->pid) n = snprintf( buf, size, "pid=%04x %s threads=%u", o->pid, o->name[0] ? o->name : "?", o->threads );
+    else n = snprintf( buf, size, "exited peb=%p", o->peb );
+    for (k = 0; k < PPM_KINDS && n >= 0 && (size_t)n < size; k++)
+        n += snprintf( buf + n, size - n, " %s=%llu/%llu/%llu", kind[k], o->bytes[k][PPM_COMMITTED] >> 20,
+                       o->bytes[k][PPM_RESIDENT] >> 20, o->bytes[k][PPM_COMPRESSED] >> 20 );
+    if (n >= 0 && (size_t)n < size)
+        n += snprintf( buf + n, size - n, " spans=%u callret=%u l1=%u", o->fex_views[PPM_FEX_SPAN],
+                       o->fex_views[PPM_FEX_CALLRET], o->fex_views[PPM_FEX_L1] );
+    return n;
+}
+#endif
diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index 4ac34fd..1d9fc19 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -17637,6 +17637,161 @@ void ios_view_owner_process_exit( void *peb )
     ios_view_owner_sweep();
 }
 
+/* Playport (diagnostics, PLA-414): memory by pseudo-process, as `[proc-mem]`
+ * lines (pp_proc_mem.h). Under virtual_mutex, each view's committed runs are
+ * charged to the view's owner (image, private or FEX's band) and copied, and
+ * each owner gets its pid, live threads and image name from teb_list; the JIT
+ * pool, a fixed size the pool lines report, is left out. After the lock,
+ * mincore sorts the runs' host pages into resident and compressed, each host
+ * page counted once. The host calls it from its own thread; it prints only
+ * when an owner came or went or moved by 32 MiB since the last print, or when
+ * forced, with what it cost. */
+#include "pp_proc_mem.h"
+
+#define IOS_PROC_MEM_RUNS 65536
+struct ios_proc_mem_run { uintptr_t base, end; unsigned short owner, kind; };
+static struct ppm_table ios_proc_mem_now, ios_proc_mem_last;
+static int ios_proc_mem_printed;
+
+/* virtual_mutex held; o's process has a live thread, so its PEB is mapped. */
+static void ios_proc_mem_name_locked( struct ppm_owner *o )
+{
+    const PEB *peb = o->peb;
+    const RTL_USER_PROCESS_PARAMETERS *params = peb->ProcessParameters;
+
+    if (!params || !params->ImagePathName.Buffer) return;
+    ppm_name( o->name, sizeof(o->name), (const uint16_t *)params->ImagePathName.Buffer,
+              params->ImagePathName.Length / sizeof(WCHAR) );
+}
+
+void ios_process_memory_log( const char *why, int force )
+{
+    static pthread_mutex_t serial = PTHREAD_MUTEX_INITIALIZER;
+    static char vec[4096];
+    struct ppm_table *t = &ios_proc_mem_now;
+    struct ios_proc_mem_run *runs;
+    struct file_view *view;
+    struct thread_data *data;
+    uintptr_t fex_lo = ios_fex_arena_base_unix, fex_hi = ios_fex_arena_end_unix;
+    uintptr_t prx = (uintptr_t)ios_jit_rx_base_global, prw = (uintptr_t)ios_jit_rw_base_global;
+    uintptr_t pps = ios_jit_pool_size_global, last_hp = 0;
+    unsigned long long unmeasured = 0, sum[PPM_MEASURES] = {0};
+    unsigned nruns = 0, views = 0, i;
+    struct timespec t0, t1, t2;
+    sigset_t sigset;
+    char row[320];
+    int m;
+
+    if (!(runs = malloc( IOS_PROC_MEM_RUNS * sizeof(*runs) ))) return;
+    pthread_mutex_lock( &serial );
+    clock_gettime( CLOCK_MONOTONIC, &t0 );
+    if (!ios_band_lock( &sigset ))
+    {
+        pthread_mutex_unlock( &serial );
+        free( runs );
+        return;
+    }
+    memset( t, 0, sizeof(*t) );
+    ppm_owner_for( t, NULL );   /* the runtime's row first */
+    WINE_RB_FOR_EACH_ENTRY( view, &views_tree, struct file_view, entry )
+    {
+        uintptr_t b = (uintptr_t)view->base, e = b + view->size;
+        char *p = view->base, *end = (char *)view->base + view->size;
+        struct ppm_owner *o;
+        int kind;
+
+        views++;
+        if ((prx && b < prx + pps && e > prx) || (prw && b < prw + pps && e > prw)) continue;
+        if (!(o = ppm_owner_for( t, view->ios_owner_peb )))
+        {
+            t->dropped_views++;
+            continue;
+        }
+        kind = ppm_kind( b, fex_lo, fex_hi, !!(view->protect & SEC_IMAGE) );
+        if (kind == PPM_FEX) o->fex_views[ppm_fex_shape( b, view->size )]++;
+        while (p < end)
+        {
+            BYTE vp = VPROT_COMMITTED;
+            SIZE_T len = (view->protect & VPROT_SYSTEM) ? (SIZE_T)(end - p)
+                                                        : get_vprot_range_size( p, end - p, VPROT_COMMITTED, &vp );
+            if (!len) break;
+            if (vp & VPROT_COMMITTED)
+            {
+                unsigned short slot = o - t->owner;
+                o->bytes[kind][PPM_COMMITTED] += len;
+                if (nruns && runs[nruns - 1].end == (uintptr_t)p && runs[nruns - 1].owner == slot &&
+                    runs[nruns - 1].kind == kind)
+                    runs[nruns - 1].end += len;
+                else if (nruns < IOS_PROC_MEM_RUNS)
+                {
+                    runs[nruns].base = (uintptr_t)p;
+                    runs[nruns].end = (uintptr_t)p + len;
+                    runs[nruns].owner = slot;
+                    runs[nruns++].kind = kind;
+                }
+                else unmeasured += len;
+            }
+            p += len;
+        }
+    }
+    LIST_FOR_EACH_ENTRY( data, &teb_list, struct thread_data, entry )
+    {
+        struct ppm_owner *o = NULL;
+
+        if (!data->teb || !data->teb->Peb || ios_view_owner_teb_exited( data->teb )) continue;
+        for (i = 1; i < t->count; i++) if (t->owner[i].peb == data->teb->Peb) o = &t->owner[i];
+        if (!o) continue;
+        o->threads++;
+        if (o->pid) continue;
+        o->pid = HandleToULong( data->teb->ClientId.UniqueProcess );
+        ios_proc_mem_name_locked( o );
+    }
+    ios_band_unlock( &sigset );
+    clock_gettime( CLOCK_MONOTONIC, &t1 );
+
+    for (i = 0; i < nruns; i++)
+    {
+        struct ppm_owner *o = &t->owner[runs[i].owner];
+        uintptr_t hp = runs[i].base & ~(uintptr_t)host_page_mask, end = runs[i].end;
+
+        if (hp < last_hp) hp = last_hp;
+        while (hp < end)
+        {
+            size_t pages = (end - hp + host_page_mask) / host_page_size, k;
+            if (pages > sizeof(vec)) pages = sizeof(vec);
+            if (mincore( (void *)hp, pages * host_page_size, vec )) memset( vec, 0, pages );
+            for (k = 0; k < pages; k++, hp += host_page_size)
+            {
+                if (vec[k] & MINCORE_INCORE) o->bytes[runs[i].kind][PPM_RESIDENT] += host_page_size;
+                else if (vec[k] & MINCORE_PAGED_OUT) o->bytes[runs[i].kind][PPM_COMPRESSED] += host_page_size;
+            }
+        }
+        if (hp > last_hp) last_hp = hp;
+    }
+    clock_gettime( CLOCK_MONOTONIC, &t2 );
+    free( runs );
+
+    if (force || ppm_moved( t, ios_proc_mem_printed ? &ios_proc_mem_last : NULL, 32ull << 20 ))
+    {
+        dprintf( 2, "[proc-mem] %s: %u owners, %u views, %u runs, took %ld ms (%ld under the lock); "
+                    "MiB committed/resident/compressed%s\n", why ? why : "host", t->count, views, nruns,
+                 (long)((t2.tv_sec - t0.tv_sec) * 1000 + (t2.tv_nsec - t0.tv_nsec) / 1000000),
+                 (long)((t1.tv_sec - t0.tv_sec) * 1000 + (t1.tv_nsec - t0.tv_nsec) / 1000000),
+                 t->dropped_views ? "; owners past the table's end not counted" : "" );
+        for (i = 0; i < t->count; i++)
+        {
+            ppm_row( &t->owner[i], row, sizeof(row) );
+            dprintf( 2, "[proc-mem]   %s\n", row );
+            for (m = 0; m < PPM_MEASURES; m++) sum[m] += ppm_sum( &t->owner[i], m );
+        }
+        dprintf( 2, "[proc-mem]   all=%llu/%llu/%llu unmeasured=%llu dropped_views=%u\n", sum[PPM_COMMITTED] >> 20,
+                 sum[PPM_RESIDENT] >> 20, sum[PPM_COMPRESSED] >> 20, unmeasured >> 20, t->dropped_views );
+        ios_proc_mem_last = *t;
+        ios_proc_mem_printed = 1;
+    }
+    pthread_mutex_unlock( &serial );
+}
+
 /***********************************************************************
  *           virtual_alloc_teb
  */
