diff --git a/build/ntdll-unix/ios_process_image.h b/build/ntdll-unix/ios_process_image.h
new file mode 100644
index 0000000..ca23929
--- /dev/null
+++ b/build/ntdll-unix/ios_process_image.h
@@ -0,0 +1,52 @@
+/* Playport: private main-image state while a pseudo-process starts.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SECTION_IMAGE_INFORMATION is supplied by the including Wine translation unit.
+ */
+#ifndef IOS_PROCESS_IMAGE_H
+#define IOS_PROCESS_IMAGE_H
+
+struct ios_startup_image
+{
+    void *owner;
+    SECTION_IMAGE_INFORMATION info;
+    void *module;
+};
+/* Stored in the already allocated Wine thread_data, not Darwin TLV storage:
+ * identity reads also run in fault handlers and must not lazily allocate TLS. */
+extern struct ios_startup_image *ios_get_startup_image(void);
+
+/* Only the starting thread can see an unpublished image. Explicit-owner
+ * lookups must not leak it to a different process, even on that thread. */
+static inline struct ios_startup_image *ios_startup_image_for_owner( void *owner )
+{
+    struct ios_startup_image *startup = ios_get_startup_image();
+    return owner && startup && owner == startup->owner ? startup : NULL;
+}
+
+static inline int ios_begin_startup_image( void *owner, const SECTION_IMAGE_INFORMATION *session )
+{
+    struct ios_startup_image *startup = ios_get_startup_image();
+    if (!owner || !startup || startup->owner) return 0;
+    startup->info = *session;
+    startup->module = NULL;
+    startup->owner = owner;
+    return 1;
+}
+
+static inline void ios_end_startup_image(void)
+{
+    struct ios_startup_image *startup = ios_get_startup_image();
+    if (!startup) return;
+    startup->owner = NULL;
+    startup->module = NULL;
+}
+
+/* Write slots: private during child startup, session globals at initial boot.
+ * Completed children read the immutable identity registry through ios_cur_image_info.
+ * No signal handler may write through these slots. */
+extern SECTION_IMAGE_INFORMATION *ios_main_image_info_slot(void);
+extern void **ios_main_module_slot(void);
+extern const SECTION_IMAGE_INFORMATION *ios_cur_image_info(void);
+extern const SECTION_IMAGE_INFORMATION *ios_image_info_for_peb( void *owner );
+
+#endif
diff --git a/build/ntdll-unix/loader_ios.c b/build/ntdll-unix/loader_ios.c
index edf564a..eef1c51 100644
--- a/build/ntdll-unix/loader_ios.c
+++ b/build/ntdll-unix/loader_ios.c
@@ -294,17 +294,37 @@ static const char *get_so_dir( WORD machine )
  * desktop session must see is_arm64ec()=TRUE (arm64ec-windows pe_dir,
  * CHPE cpu_area on its threads, EC fault dispatch) while the parent and
  * its siblings keep seeing FALSE. Worse, unix_init_startup_info()
- * OVERWRITES the main_image_info global with each child's exe info,
- * retroactively flipping the whole session's identity — parent threads
- * run concurrently, so that flip poisons their fault handling and DLL
- * resolution. wine_ios_child_main registers the child's info here and
- * restores the global (S1 registry pattern, same as fd_socket).
+ * used to OVERWRITE main_image_info during child startup. A restore after
+ * startup cannot protect concurrent session threads, and never runs after
+ * a failed image map terminates the child. Keep unpublished child image
+ * state in the starting thread_data and owner-keyed; publish after startup.
  *
  * Readers are lock-free (fault handlers call this): slots are fully
  * written before the count is published. Audit 2026-07-06: every
  * is_arm64ec/main_image_info consumer lives in forked files; unforked
  * wine unix files have zero users. */
 #include "ios_mixed.h"
+#include "ios_process_image.h"
+
+extern void *ios_jit_current_peb(void);
+
+struct ios_startup_image *ios_get_startup_image(void)
+{
+    struct thread_data *data = get_thread_data();
+    return data ? data->ios_startup_image : NULL;
+}
+
+SECTION_IMAGE_INFORMATION *ios_main_image_info_slot(void)
+{
+    struct ios_startup_image *startup = ios_startup_image_for_owner( ios_jit_current_peb() );
+    return startup ? &startup->info : &main_image_info;
+}
+
+void **ios_main_module_slot(void)
+{
+    struct ios_startup_image *startup = ios_startup_image_for_owner( ios_jit_current_peb() );
+    return startup ? &startup->module : &main_module;
+}
 
 #define IOS_MAX_PROC_IDENTS 64
 struct ios_proc_ident
@@ -323,7 +343,9 @@ extern void *ios_jit_current_peb(void);
 
 const SECTION_IMAGE_INFORMATION *ios_image_info_for_peb( void *peb_id )
 {
+    struct ios_startup_image *startup = ios_startup_image_for_owner( peb_id );
     int i, n = ios_proc_ident_count;
+    if (startup) return &startup->info;
     if (peb_id)
         for (i = 0; i < n; i++)
             if (ios_proc_idents[i].peb == peb_id) return &ios_proc_idents[i].info;
@@ -341,13 +363,13 @@ int ios_is_arm64ec_cur(void)
            ios_cur_image_info()->Machine == IMAGE_FILE_MACHINE_AMD64;
 }
 
-void ios_register_proc_ident( void *peb_id, const SECTION_IMAGE_INFORMATION *info )
+static BOOL ios_register_proc_ident( void *peb_id, const SECTION_IMAGE_INFORMATION *info )
 {
     int idx = ios_proc_ident_count;
     if (idx >= IOS_MAX_PROC_IDENTS)
     {
-        dprintf(2, "[proc-ident] registry FULL — %p keeps session identity\n", peb_id);
-        return;
+        dprintf(2, "[proc-ident] registry FULL — refusing child %p\n", peb_id);
+        return FALSE;
     }
     ios_proc_idents[idx].info = *info;
     ios_proc_idents[idx].peb = peb_id;
@@ -355,6 +377,7 @@ void ios_register_proc_ident( void *peb_id, const SECTION_IMAGE_INFORMATION *inf
     ios_proc_ident_count = idx + 1;
     dprintf(2, "[proc-ident] peb=%p Machine=0x%x (slot %d)\n",
             peb_id, info->Machine, idx);
+    return TRUE;
 }
 
 /* X3c: attach a private ntdll image + entry points to a registered ident. */
@@ -1264,8 +1287,8 @@ static NTSTATUS open_main_image_so_file( const char *name, UNICODE_STRING *nt_na
             nt_name->Length -= 3 * sizeof(WCHAR);
         }
     }
-    status = dlopen_dll( name, nt_name, &main_module, &pe_info, FALSE );
-    if (!status) virtual_fill_image_information( &pe_info, &main_image_info );
+    status = dlopen_dll( name, nt_name, ios_main_module_slot(), &pe_info, FALSE );
+    if (!status) virtual_fill_image_information( &pe_info, ios_main_image_info_slot() );
     return status;
 }
 
@@ -1857,10 +1880,10 @@ NTSTATUS load_main_exe( UNICODE_STRING *nt_name, USHORT load_machine )
     {
         status = virtual_map_main_module( mapping, load_machine );
         dprintf(2, "[main-exe] virtual_map_main_module = 0x%x Machine=0x%x chars=0x%x\n",
-                (unsigned)status, main_image_info.Machine, main_image_info.ImageCharacteristics);
-        if (status == STATUS_IMAGE_MACHINE_TYPE_MISMATCH && main_image_info.ComPlusNativeReady)
+                (unsigned)status, ios_cur_image_info()->Machine, ios_cur_image_info()->ImageCharacteristics);
+        if (status == STATUS_IMAGE_MACHINE_TYPE_MISMATCH && ios_cur_image_info()->ComPlusNativeReady)
         {
-            main_image_info.Machine = is_machine_64bit( native_machine ) ? IMAGE_FILE_MACHINE_AMD64 : native_machine;
+            ios_main_image_info_slot()->Machine = is_machine_64bit( native_machine ) ? IMAGE_FILE_MACHINE_AMD64 : native_machine;
             status = STATUS_SUCCESS;
         }
         NtClose( mapping );
@@ -1886,10 +1909,10 @@ NTSTATUS load_main_exe( UNICODE_STRING *nt_name, USHORT load_machine )
         if (loadorder != LO_NATIVE && is_prefix_bootstrap && is_system_dir)
 #endif
         {
-            status = find_builtin_dll( nt_name, NULL, &main_module, &size, &main_image_info, 0, 0,
+            status = find_builtin_dll( nt_name, NULL, ios_main_module_slot(), &size, ios_main_image_info_slot(), 0, 0,
                                        search_machine, load_machine, FALSE, 0 );
             dprintf(2, "[main-exe] builtin-path retry: find_builtin_dll(search_machine=0x%x) = 0x%x Machine=0x%x\n",
-                    search_machine, (unsigned)status, main_image_info.Machine);
+                    search_machine, (unsigned)status, ios_cur_image_info()->Machine);
         }
         break;
     }
@@ -1912,8 +1935,8 @@ NTSTATUS load_start_exe( UNICODE_STRING *nt_name )
     wcscpy( image, get_machine_wow64_dir( current_machine ));
     wcscat( image, startW );
     init_unicode_string( nt_name, image );
-    status = find_builtin_dll( nt_name, NULL, &main_module, &size,
-                               &main_image_info, 0, 0, current_machine, 0, FALSE, 0 );
+    status = find_builtin_dll( nt_name, NULL, ios_main_module_slot(), &size,
+                               ios_main_image_info_slot(), 0, 0, current_machine, 0, FALSE, 0 );
     if (!NT_SUCCESS(status))
     {
         MESSAGE( "wine: failed to load start.exe: %x\n", status );
@@ -3076,6 +3099,7 @@ extern size_t server_init_process_child( struct thread_data *data, int child_fd_
 
 DECLSPEC_EXPORT void wine_ios_child_main( int argc, char *argv[], int child_fd_socket )
 {
+    struct ios_startup_image startup_image = {0};
     struct thread_data *data;
     TEB *teb;
     PEB *child_peb;
@@ -3213,21 +3237,24 @@ DECLSPEC_EXPORT void wine_ios_child_main( int argc, char *argv[], int child_fd_s
         /* Register with wineserver using the child's socketfd */
         startup_info_size = server_init_process_child( data, child_fd_socket );
 
-        /* init_startup_info — reads startup info from wineserver, loads the
-         * child's PE. It OVERWRITES the main_image_info global with the
-         * child's exe info; snapshot the session's and restore it after
-         * registering the child's copy in the per-process identity registry
-         * (X3: an AMD64 child must not flip is_arm64ec() for the whole
-         * session — parent threads run concurrently). Everything on THIS
-         * thread reads identity owner-aware from here on. */
+        /* Never lend the child the session's image globals, even briefly.
+         * Failed startup ends this pthread before publication; its private
+         * state dies with it and the session remains unchanged. Other globals
+         * (peb, argv and startup_info_size) are still serialized separately. */
+        data->ios_startup_image = &startup_image;
+        if (!ios_begin_startup_image( child_peb, &main_image_info ))
+        {
+            NtTerminateProcess( GetCurrentProcess(), STATUS_NOT_SUPPORTED );
+            return;
+        }
+        unix_init_startup_info();
+        if (!ios_register_proc_ident( child_peb, &startup_image.info ))
         {
-            SECTION_IMAGE_INFORMATION session_image_info = main_image_info;
-            void *session_main_module = main_module;  /* wine-11.18: a global too */
-            unix_init_startup_info();
-            ios_register_proc_ident( child_peb, &main_image_info );
-            main_image_info = session_image_info;
-            main_module = session_main_module;
+            NtTerminateProcess( GetCurrentProcess(), STATUS_NO_MEMORY );
+            return;
         }
+        ios_end_startup_image();
+        data->ios_startup_image = NULL;
         dprintf(STDERR_FILENO, "[Wine child] PE loaded: Machine=0x%x TransferAddress=%p ImageBase=%p\n",
                 ios_cur_image_info()->Machine, ios_cur_image_info()->TransferAddress, peb->ImageBaseAddress);
 
