 build/ntdll-unix/server_ios.c       |  32 ++++
 build/ntdll-unix/signal_arm64_ios.c | 139 ++++++++++++++++-
 build/ntdll-unix/virtual_ios.c      | 232 ++++++++++++++++++++++++++--
 build/wineserver/mach_ios.c         |  42 +++--
 5 files changed, 605 insertions(+), 21 deletions(-)
