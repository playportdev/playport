diff --git a/build/ntdll-unix/pp_proc_end.h b/build/ntdll-unix/pp_proc_end.h
new file mode 100644
index 0000000..1770629
--- /dev/null
+++ b/build/ntdll-unix/pp_proc_end.h
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * The end of a pseudo-process another process terminated (Playport, PLA-416,
+ * decision 0127). Such a process never runs process_exit_wrapper: its threads
+ * end through abort_thread, whose count is the whole task's. So the server
+ * reports each ended process, and once every thread of it has finished or is
+ * parked, a thread of another process gives back what process_exit_wrapper
+ * would: its master socket, fd cache, JIT-pool ranges and views, and, unlike a
+ * process that exits by itself (0154), its views in FEX's band.
+ *
+ * A killed thread blocked in an x86-64 program's in-process wait
+ * (NtWaitForAlertByThreadId's futex_wait) never reaches a point the abort
+ * can divert it from. If its state shows it holds nothing, it is parked: left
+ * Mach-suspended for ever, and counted as finished. Its TEB, stacks and every
+ * view its saved registers point into stay mapped.
+ *
+ * Pure decisions and formatting, so a host test compiles this header as is. */
+#ifndef PP_PROC_END_H
+#define PP_PROC_END_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+
+#define PPE_SVC_0X80            0xd4001001u   /* svc #0x80, a Darwin system call */
+#define PPE_SYS_ULOCK_WAIT      515           /* x16 of __ulock_wait */
+#define PPE_SYS_ULOCK_WAIT2     544           /* x16 of __ulock_wait2, os_sync_wait_on_address's */
+#define PPE_UL_COMPARE_AND_WAIT 1             /* x0's operation: futex_wait's */
+#define PPE_REFS                50            /* x0-x28, fp, lr, sp, pc; the guest's 16 GPRs and rip */
+
+/* What the abort read of a killed thread it has stopped. */
+struct ppe_thread_state
+{
+    int      process_ending;      /* the server is ending its whole process */
+    int      readable;            /* every field below was read */
+    int      in_alert_wait;       /* NtWaitForAlertByThreadId runs on it */
+    int      wow64_wait;          /* an i386 program's own wait: ios_alert_wait_check ends it */
+    int      killed_in_wait;      /* already woken to end there */
+    uint32_t insn_before_pc;      /* the instruction before its pc */
+    uint64_t x0, x16;             /* the system call's operation and number */
+    uint64_t fex_stamps;          /* FEX's lock stamps in its TEB, or'ed */
+    int      in_syscall_callback; /* FEX's syscall callback (InSyscallCallback) */
+    uint32_t host_sections;       /* uninterrupted sections and tracked host mutexes it holds */
+    int      owns_loader_lock;    /* PEB->LoaderLock's OwningThread is it */
+};
+
+enum ppe_park
+{
+    PPE_PARK,                 /* park it */
+    PPE_NOT_ENDING,           /* not its whole process: the abort goes on as before */
+    PPE_NOT_ALERT_WAIT,       /* not in NtWaitForAlertByThreadId: the abort goes on as before */
+    PPE_WOW64_WAIT,           /* i386: ended in its wait instead */
+    PPE_UNREAD,               /* its state could not be read */
+    PPE_NOT_BLOCKED,          /* not blocked in the wait's futex_wait */
+    PPE_FEX_LOCK,             /* holds a FEX lock or is in a FEX syscall callback */
+    PPE_HOST_LOCK,            /* holds a host section or tracked mutex */
+    PPE_LOADER_LOCK,          /* holds its process's loader lock */
+};
+
+/* Whether a killed thread may be parked. Only one blocked in the host wait of
+ * NtWaitForAlertByThreadId, holding nothing the runtime tracks; anything not
+ * shown is a refusal, and the thread runs on as before. futex_wait is
+ * os_sync_wait_on_address (__ulock_wait2) where the OS has it, as iOS 17.4
+ * on does, and __ulock_wait before. */
+static inline enum ppe_park ppe_may_park( const struct ppe_thread_state *s )
+{
+    if (!s->process_ending) return PPE_NOT_ENDING;
+    if (!s->readable) return PPE_UNREAD;
+    if (s->wow64_wait || s->killed_in_wait) return PPE_WOW64_WAIT;
+    if (!s->in_alert_wait) return PPE_NOT_ALERT_WAIT;
+    if (s->insn_before_pc != PPE_SVC_0X80 || (s->x16 != PPE_SYS_ULOCK_WAIT && s->x16 != PPE_SYS_ULOCK_WAIT2) ||
+        (s->x0 & 0xff) != PPE_UL_COMPARE_AND_WAIT)
+        return PPE_NOT_BLOCKED;
+    if (s->fex_stamps || s->in_syscall_callback) return PPE_FEX_LOCK;
+    if (s->host_sections) return PPE_HOST_LOCK;
+    if (s->owns_loader_lock) return PPE_LOADER_LOCK;
+    return PPE_PARK;
+}
+
+/* Whether a refusal is logged: one in the wait but not provably idle. */
+static inline int ppe_refusal_logged( enum ppe_park why )
+{
+    return why >= PPE_UNREAD;
+}
+
+static inline const char *ppe_park_name( enum ppe_park why )
+{
+    static const char *const names[] = { "park", "not its whole process", "not in an alert wait",
+                                         "an i386 wait", "state unreadable", "not blocked in futex_wait",
+                                         "holds a FEX lock", "holds a host lock", "holds the loader lock" };
+    return (unsigned)why < sizeof(names) / sizeof(names[0]) ? names[why] : "?";
+}
+
+/* A process's threads, as the sweep finds them in teb_list. */
+struct ppe_census
+{
+    unsigned live, finished, parked;
+};
+
+/* Its teardown may run once none of its threads can run again. */
+static inline int ppe_all_ended( const struct ppe_census *c )
+{
+    return !c->live;
+}
+
+/* The process's views, by what they hold. */
+enum ppe_class { PPE_IMAGE, PPE_PRIVATE, PPE_SPAN, PPE_CALLRET, PPE_L1, PPE_BAND_OTHER, PPE_CLASSES };
+
+static inline int ppe_in_band( enum ppe_class c )
+{
+    return c >= PPE_SPAN;
+}
+
+/* Whether any of a parked thread's saved addresses lies in [base, base + size). */
+static inline int ppe_referenced( uint64_t base, uint64_t size, const uint64_t *refs, unsigned nrefs )
+{
+    unsigned i;
+    for (i = 0; i < nrefs; i++)
+        if (refs[i] >= base && refs[i] - base < size) return 1;
+    return 0;
+}
+
+/* Whether a view of a killed process, one the rules of 0154 would give back
+ * or one in FEX's band, goes. With no thread parked, all of its band goes too:
+ * its rpmalloc heaps, call-return stacks and L1 caches belong to its own FEX
+ * instance, which nothing runs any more. With a thread parked only its L1
+ * caches do, as the FEX state that names them stays; and no view one of its
+ * saved registers points into goes. */
+static inline int ppe_release_view( enum ppe_class c, unsigned parked, uint64_t base, uint64_t size,
+                                    const uint64_t *refs, unsigned nrefs )
+{
+    if (parked && ppe_referenced( base, size, refs, nrefs )) return 0;
+    if (!ppe_in_band( c )) return 1;
+    return !parked || c == PPE_L1;
+}
+
+/* The `[proc-end]` line: MB freed by class, MB kept, the threads it waited for. */
+static inline int ppe_row( char *buf, size_t size, const void *peb, unsigned pid,
+                           const unsigned long long freed[PPE_CLASSES], unsigned long long pool,
+                           unsigned long long kept, const struct ppe_census *c )
+{
+    return snprintf( buf, size, "peb=%p pid=%04x killed: freed image=%llu private=%llu spans=%llu "
+                     "callret=%llu l1=%llu band_other=%llu pool=%llu MB, kept %llu MB; "
+                     "%u finished, %u parked thread(s)",
+                     peb, pid, freed[PPE_IMAGE] >> 20, freed[PPE_PRIVATE] >> 20, freed[PPE_SPAN] >> 20,
+                     freed[PPE_CALLRET] >> 20, freed[PPE_L1] >> 20, freed[PPE_BAND_OTHER] >> 20,
+                     pool >> 20, kept >> 20, c->finished, c->parked );
+}
+
+/* The ended processes the server reported, until each is torn down or found
+ * to have exited by itself. Added from the server's thread, taken on others:
+ * a slot is claimed by its peb, and taking it clears it once. */
+#define PPE_GONE_MAX 64
+struct ppe_gone
+{
+    void *peb;
+    unsigned pid;
+};
+
+/* Report peb; a second report keeps one entry. -1 when the table is full. */
+static inline int ppe_gone_add( struct ppe_gone *t, void *peb, unsigned pid )
+{
+    int i;
+    for (i = 0; i < PPE_GONE_MAX; i++)
+        if (__atomic_load_n( &t[i].peb, __ATOMIC_ACQUIRE ) == peb) return i;
+    for (i = 0; i < PPE_GONE_MAX; i++)
+    {
+        void *expected = NULL;
+        if (__atomic_compare_exchange_n( &t[i].peb, &expected, peb, 0, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+        {
+            __atomic_store_n( &t[i].pid, pid, __ATOMIC_RELEASE );
+            return i;
+        }
+    }
+    return -1;
+}
+
+/* Take slot i's peb for its teardown: 1 for the one caller that does. */
+static inline int ppe_gone_take( struct ppe_gone *t, int i, void *peb )
+{
+    return __atomic_compare_exchange_n( &t[i].peb, &peb, NULL, 0, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED );
+}
+#endif
diff --git a/build/ntdll-unix/server_ios.c b/build/ntdll-unix/server_ios.c
index 4932ac5..2c3ef28 100644
--- a/build/ntdll-unix/server_ios.c
+++ b/build/ntdll-unix/server_ios.c
@@ -2239,6 +2239,7 @@ NTSTATUS unixcall_wine_server_call( void *args )
 #define IOS_SECTION_MAX 16
 static __thread pthread_mutex_t *ios_sections[IOS_SECTION_MAX];
 static __thread unsigned int ios_section_depth;
+extern void ios_note_host_sections( unsigned int depth );   /* signal_arm64_ios.c, PLA-416 */
 
 void ios_leave_sections_at_exit( const char *why )
 {
@@ -2254,6 +2255,7 @@ void ios_leave_sections_at_exit( const char *why )
                  mutex == &fd_cache_mutex ? " (fd_cache_mutex)" : "" );
         mutex_unlock( mutex );
     }
+    ios_note_host_sections( 0 );   /* PLA-416 */
 }
 
 /* Playport (PLA-120): record a host mutex the caller has just locked outside a
@@ -2266,6 +2268,7 @@ void ios_section_track_enter( pthread_mutex_t *mutex )
 {
     if (ios_section_depth < IOS_SECTION_MAX) ios_sections[ios_section_depth] = mutex;
     ios_section_depth++;
+    ios_note_host_sections( ios_section_depth );   /* PLA-416 */
 }
 
 /* ...and forget it just before the caller unlocks it. */
@@ -2283,6 +2286,7 @@ void ios_section_track_leave( pthread_mutex_t *mutex )
             if (j < i) ios_sections[j] = ios_sections[i];
         }
         if (i < IOS_SECTION_MAX) ios_sections[i] = NULL;
+        ios_note_host_sections( ios_section_depth );   /* PLA-416 */
     }
 }
 #endif
@@ -3997,6 +4001,34 @@ int ios_peb_is_dead_child( void *peb )
     for (i = 0; peb && i < n; i++) if (ios_dead_pebs[i] == peb) return 1;
     return 0;
 }
+
+/* Playport (PLA-416): a child another process terminated never runs
+ * process_exit_wrapper. Its teardown (virtual_ios.c ios_proc_end_sweep), on a
+ * thread of another process, starts here: close its master socket, as the
+ * exit would, and record it as a dead child. The slot is taken atomically, so
+ * only one caller gets 1; 0 when it has none any more (it exited by itself,
+ * or was torn down already). */
+int ios_proc_end_take_socket( void *peb )
+{
+    int i, n = ios_proc_socket_count;
+
+    if (n > IOS_MAX_PROC_SOCKETS) n = IOS_MAX_PROC_SOCKETS;
+    for (i = 0; peb && i < n; i++)
+    {
+        void *expected = peb;
+        unsigned int d;
+
+        if (!__atomic_compare_exchange_n( &ios_proc_sockets[i].peb, &expected, NULL, 0,
+                                          __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
+            continue;
+        ios_fdt_note_close( ios_proc_sockets[i].fd, "killed-master", peb );
+        close( ios_proc_sockets[i].fd );
+        d = __sync_fetch_and_add( &ios_dead_peb_count, 1 );
+        if (d < IOS_DEAD_PEB_MAX) ios_dead_pebs[d] = peb;
+        return 1;
+    }
+    return 0;
+}
 #endif
 
 void process_exit_wrapper( int status )
diff --git a/build/ntdll-unix/signal_arm64_ios.c b/build/ntdll-unix/signal_arm64_ios.c
index 886da22..0ce9aae 100644
--- a/build/ntdll-unix/signal_arm64_ios.c
+++ b/build/ntdll-unix/signal_arm64_ios.c
@@ -145,6 +145,9 @@ struct arm64_thread_data
      * when it returns STATUS_THREAD_IS_TERMINATING (ios_alert_wait_check) */
     BOOL in_alert_wait;
     LONG killed_in_wait;
+    /* Playport (PLA-416): the uninterrupted sections and tracked host mutexes
+     * it holds (server_ios.c ios_section_track_enter), for the abort to read */
+    LONG host_sections;
 };
 
 #define IOS_KILLED_IN_WAIT      1
@@ -157,6 +160,22 @@ static inline struct arm64_thread_data *arm64_thread_data( struct thread_data *d
     return (struct arm64_thread_data *)get_teb_data(data)->cpu_data;
 }
 
+/* Playport (PLA-416): the calling thread now holds `depth` uninterrupted
+ * sections and tracked host mutexes (server_ios.c), which the abort reads
+ * before it parks a killed thread. Sections are taken before thread_data_key
+ * exists, when pthread_getspecific( 0 ) is Darwin's pthread_self slot, and on
+ * threads with no TEB: neither has a TEB to note it in. */
+void ios_note_host_sections( unsigned int depth )
+{
+    extern pthread_key_t thread_data_key;
+    struct thread_data *data = thread_data_key ? pthread_getspecific( thread_data_key ) : NULL;
+    struct teb_data *teb_data = data ? get_teb_data( data ) : NULL;
+
+    if (teb_data)
+        __atomic_store_n( &((struct arm64_thread_data *)teb_data->cpu_data)->host_sections, (LONG)depth,
+                          __ATOMIC_RELEASE );
+}
+
 /***********************************************************************
  * signal context platform-specific definitions
  */
@@ -8435,10 +8454,84 @@ void ios_alert_wait_end( void )
  * is woken to end there instead (ios_alert_wait_check), and is left alone from
  * then on; one in any other in-process wait is left to wake as it would.
  *
- * Returns 1 when the thread was diverted, 0 when it is not at such a point now,
- * -1 when it is gone (or has no TEB or syscall frame to end it with).
+ * PLA-416: a thread of a process the server is ending (process_ending) that
+ * is blocked in an x86-64 program's NtWaitForAlertByThreadId, holding nothing
+ * the runtime tracks (ios_abort_park_state, pp_proc_end.h), is parked: left
+ * suspended for ever and counted as finished (ios_proc_end_note_parked). One
+ * that is in the wait but not provably idle is logged once (*refusal_logged)
+ * and runs on as before.
+ *
+ * Returns 2 when the thread was parked, 1 when it was diverted, 0 when it is
+ * not at such a point now, -1 when it is gone (or has no TEB or syscall frame
+ * to end it with).
  */
-int ios_abort_thread_in_guest_code( mach_port_t port, TEB *teb )
+#include "pp_proc_end.h"
+
+/* PLA-416: what parking needs to know of a stopped thread, and the addresses
+ * its saved state names (refs, PPE_REFS of them), all through abort_read. */
+static void ios_abort_park_state( TEB *teb, struct arm64_thread_data *arm64_data,
+                                  arm_thread_state64_t *state, int process_ending,
+                                  struct ppe_thread_state *s, uint64_t *refs, unsigned *nrefs )
+{
+    struct syscall_frame *frame = NULL;
+    CHPE_V2_CPU_AREA_INFO *cpu_area = NULL;
+    ARM64EC_NT_CONTEXT *context = NULL;
+    RTL_CRITICAL_SECTION *loader_lock = NULL;
+    PEB *peb = NULL;
+    HANDLE owner = 0, tid = 0;
+    ULONG wpm_depth = 0, wpm_write_depth = 0;
+    ULONG64 cbw_stamp = 0, cim_stamp = 0, guest[17];
+    UCHAR rwx_read = 0;
+    BOOLEAN in_callback = 0;
+    BOOL in_alert_wait = FALSE;
+    LONG killed_in_wait = 0, sections = 0;
+    uintptr_t pc = (uintptr_t)__darwin_arm_thread_state64_get_pc( *state );
+    unsigned i, n = 0;
+
+    memset( s, 0, sizeof(*s) );
+    s->process_ending = process_ending;
+    /* FEX's TEB stamps: Instrumentation[7] its WritePriorityMutex shared-hold
+     * depth, [2] its write-hold depth, [6] its CodeBufferWriteMutex stamp, [8]
+     * its CodeInvalidationMutex read-hold stamp and +0x1700 its RWX read hold
+     * (thread_ios.c pthread_exit_wrapper) */
+    s->readable = abort_read( &arm64_data->in_alert_wait, &in_alert_wait, sizeof(in_alert_wait) ) &&
+                  abort_read( &arm64_data->killed_in_wait, &killed_in_wait, sizeof(killed_in_wait) ) &&
+                  abort_read( &arm64_data->host_sections, &sections, sizeof(sections) ) &&
+                  abort_read( (const void *)(pc - 4), &s->insn_before_pc, sizeof(s->insn_before_pc) ) &&
+                  abort_read( (char *)teb + 0x16f0, &wpm_depth, sizeof(wpm_depth) ) &&
+                  abort_read( (char *)teb + 0x16c8, &wpm_write_depth, sizeof(wpm_write_depth) ) &&
+                  abort_read( (char *)teb + 0x16e8, &cbw_stamp, sizeof(cbw_stamp) ) &&
+                  abort_read( (char *)teb + 0x16f8, &cim_stamp, sizeof(cim_stamp) ) &&
+                  abort_read( (char *)teb + 0x1700, &rwx_read, sizeof(rwx_read) ) &&
+                  abort_read( &teb->ChpeV2CpuAreaInfo, &cpu_area, sizeof(cpu_area) ) && cpu_area &&
+                  abort_read( &cpu_area->InSyscallCallback, &in_callback, sizeof(in_callback) ) &&
+                  abort_read( &cpu_area->ContextAmd64, &context, sizeof(context) ) && context &&
+                  abort_read( (char *)context + 0x78, guest, sizeof(guest) ) &&   /* Rax..R15, Rip */
+                  abort_read( &teb->ClientId.UniqueThread, &tid, sizeof(tid) ) &&
+                  abort_read( &teb->Peb, &peb, sizeof(peb) ) && peb &&
+                  abort_read( &peb->LoaderLock, &loader_lock, sizeof(loader_lock) ) &&
+                  (!loader_lock || abort_read( &loader_lock->OwningThread, &owner, sizeof(owner) )) &&
+                  abort_read( &((struct teb_data *)&teb->GdiTebBatch)->syscall_frame, &frame, sizeof(frame) );
+    s->in_alert_wait = in_alert_wait;
+    s->killed_in_wait = killed_in_wait;
+    s->wow64_wait = in_alert_wait && ios_alert_wait_from_wow64( teb, frame );
+    s->x0 = state->__x[0];
+    s->x16 = state->__x[16];
+    s->fex_stamps = wpm_depth | wpm_write_depth | cbw_stamp | cim_stamp | rwx_read;
+    s->in_syscall_callback = in_callback;
+    s->host_sections = (uint32_t)sections;
+    s->owns_loader_lock = owner && owner == tid;
+
+    for (i = 0; i < 29; i++) refs[n++] = state->__x[i];
+    refs[n++] = (uint64_t)__darwin_arm_thread_state64_get_fp( *state );
+    refs[n++] = (uint64_t)__darwin_arm_thread_state64_get_lr( *state );
