index b6959b8..338779b 100644
--- a/build/ntdll-unix/thread_ios.c
+++ b/build/ntdll-unix/thread_ios.c
@@ -1279,6 +1279,12 @@ static DECLSPEC_NORETURN void pthread_exit_wrapper( int status )
         extern void ios_view_owner_thread_exit( struct thread_data *data );
         ios_view_owner_thread_exit( get_thread_data() );
     }
+    {
+        /* Playport (PLA-364, decision 0134): give back its exception registry
+         * entry and TEB-restore trampoline slot for a later thread. */
