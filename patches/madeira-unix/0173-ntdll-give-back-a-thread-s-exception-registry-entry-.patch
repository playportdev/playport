diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index c5f15d9..3bca630 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -3278,21 +3278,25 @@ int ios_fast_footprint = 0;                    /* ml670: set when d3d11 loads */
  *
  * Each Wine "process" thread gets its own slot with its own TEB address.
  * Slot 0 is the default (backward compatible with ios_jit_teb_trampoline).
- * Max 256 slots in one 16KB page (256 * 16 = 4096, well within 0x4000).
+ * Max 1024 slots in one 16KB page (1024 * 16 = 0x4000).
  *
  * Usage: SEGV/Mach handler sets x17 = target_PC, PC = thread's trampoline.
  * Trampoline runs: loads x18 = thread's TEB, jumps to x17 = target PC.
  */
 void *ios_jit_teb_trampoline = NULL;  /* RX address of slot 0 trampoline (offset 8) */
 #define IOS_JIT_TRAMPOLINE_SIZE 16    /* Bytes per trampoline slot */
-#define IOS_JIT_MAX_SLOTS 256         /* Max threads with trampolines */
-static volatile int32_t ios_jit_next_slot = 0;  /* Next slot to allocate */
+/* Playport (PLA-364, decision 0134): the reserved first page (0x4000) holds
+ * 1024 slots, and a slot is given back when its thread ends or is parked
+ * (pp_thread_slots.h); slot 0, the first thread's and every overflow's, never is. */
+#define IOS_JIT_MAX_SLOTS 1024        /* Max threads with trampolines: 0x4000 / 16 */
+#include "pp_thread_slots.h"
+static volatile uint8_t ios_jit_slot_used[IOS_JIT_MAX_SLOTS];
 
 /* Allocate a per-thread trampoline slot. Returns slot index (0-based). */
 int ios_jit_alloc_trampoline_slot(void)
 {
-    int slot = __sync_fetch_and_add(&ios_jit_next_slot, 1);
-    if (slot >= IOS_JIT_MAX_SLOTS) return 0;  /* fallback to slot 0 */
+    int slot = ppts_trampoline_claim( ios_jit_slot_used, IOS_JIT_MAX_SLOTS );
+    if (slot < 0) return 0;  /* fallback to slot 0 */
 
     /* Write trampoline code to this slot's RW view */
     if (ios_jit_rw_base_global)
@@ -3307,6 +3311,16 @@ int ios_jit_alloc_trampoline_slot(void)
     return slot;
 }
 
+/* Give back the slot whose trampoline is at RX address trampoline; 1 when given back. */
+int ios_jit_free_trampoline( void *trampoline )
+{
+    uintptr_t rx = (uintptr_t)ios_jit_rx_base_global, t = (uintptr_t)trampoline;
+
+    if (!rx || t < rx + 8 || (t - rx - 8) % IOS_JIT_TRAMPOLINE_SIZE) return 0;
+    return ppts_trampoline_release( ios_jit_slot_used, IOS_JIT_MAX_SLOTS,
+                                    (int)((t - rx - 8) / IOS_JIT_TRAMPOLINE_SIZE) );
+}
+
 /* Write TEB address to a specific trampoline slot */
 void ios_jit_set_teb_slot(int slot, uintptr_t teb)
 {
