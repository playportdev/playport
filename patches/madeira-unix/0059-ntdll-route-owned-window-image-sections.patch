+/* Server registration describes host storage, never guest ImageBase. */
+static NTSTATUS ios_wow64_server_map( struct file_view *view )
+{
+    NTSTATUS status;
+    SERVER_START_REQ( map_image_view )
+    {
+        req->mapping = wine_server_obj_handle( view->wow64_mapping );
+        req->base = wine_server_client_ptr( view->base );
+        req->size = view->wow64_size;
+        req->entry = view->wow64_entry;
+        req->machine = view->wow64_machine;
+        req->offset = 0;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    return ios_wow64_mapped_image_status( view, status );
+}
+
+static NTSTATUS ios_wow64_server_unmap( struct file_view *view )
+{
+    NTSTATUS status;
+    SERVER_START_REQ( unmap_view )
+    {
+        req->base = wine_server_client_ptr( view->base );
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    return status;
+}
