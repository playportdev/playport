+/* Intercept before native bounds, alias steering and remote APCs. */
+static BOOL ios_wow64_route_section( HANDLE mapping, HANDLE process, void **addr, SIZE_T *size,
+                                     ULONG_PTR zero_bits, SIZE_T commit, const LARGE_INTEGER *offset,
+                                     SECTION_INHERIT inherit, ULONG type, ULONG protect, BOOL ex,
+                                     NTSTATUS *status )
+{
+    unsigned int i;
+    BOOL routed = FALSE;
+    void *owner = ios_jit_current_peb();
+    uintptr_t value;
+    if (!addr || !size) return FALSE;
+    value = (uintptr_t)*addr;
+    if (!value && (!zero_bits || zero_bits > UINT32_MAX)) return FALSE;
+    /* A guest-constrained remote NULL must not reach an APC that appears
+     * local in the target and silently acquires its window. */
+    if (!value && process != NtCurrentProcess())
+    {
+        *status = STATUS_ACCESS_DENIED;
+        return TRUE;
+    }
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+    {
+        uintptr_t base = ios_wow64_windows[i].base;
+        struct pe_mapping_info *info = NULL;
+        mem_size_t full_size;
+        unsigned int sec_flags, access;
+        uint64_t low, high, end;
+        if (!ios_wow64_windows[i].owner) continue;
+        if (value ? (value < base || value - base >= IOS_WOW64_WINDOW_SIZE) :
+                    (owner != ios_wow64_windows[i].owner)) continue;
+        routed = TRUE;
+        if (process != NtCurrentProcess() || owner != ios_wow64_windows[i].owner)
+            *status = STATUS_ACCESS_DENIED;
+        else if (ex || commit || (offset && offset->QuadPart) || inherit != ViewUnmap ||
+                 (type & ~MEM_TOP_DOWN)) *status = STATUS_NOT_SUPPORTED;
+        else
+        {
+            switch (protect)
+            {
+            case PAGE_NOACCESS: case PAGE_READONLY: case PAGE_WRITECOPY: access = SECTION_MAP_READ; break;
+            case PAGE_READWRITE: access = SECTION_MAP_WRITE; break;
+            case PAGE_EXECUTE: case PAGE_EXECUTE_READ: case PAGE_EXECUTE_WRITECOPY:
+                access = SECTION_MAP_READ | SECTION_MAP_EXECUTE; break;
+            case PAGE_EXECUTE_READWRITE: access = SECTION_MAP_WRITE | SECTION_MAP_EXECUTE; break;
+            default: *status = STATUS_INVALID_PAGE_PROTECTION; goto done;
+            }
+            *status = get_mapping_info( mapping, access, &sec_flags, &full_size, &info );
+            if (*status) goto done;
+            if (!info || sec_flags != (SEC_IMAGE | SEC_FILE))
+                *status = STATUS_NOT_SUPPORTED;
+            else
+            {
+                end = (ios_cur_image_info()->ImageCharacteristics & IMAGE_FILE_LARGE_ADDRESS_AWARE) ?
+                      IOS_WOW64_WINDOW_SIZE : UINT64_C(0x80000000);
+                *status = ios_wow64_section_bounds( base, *addr, *size, zero_bits, end,
+                                                    &info->image, &low, &high );
+                if (!*status)
+                {
+                    *status = virtual_map_image( mapping, addr, size, low, high, type,
+                                                 info, IMAGE_FILE_MACHINE_I386, FALSE, 0, base );
+                    if (NT_SUCCESS(*status))
+                        dprintf(2, "[wow64-section] owner=%p host=%p guest=%#lx bytes=%#lx image=1 "
+                                   "null=%u top_down=%u native_exec=0 server=1\n",
+                                owner, *addr, (unsigned long)((uintptr_t)*addr - base),
+                                (unsigned long)*size, !value, !!(type & MEM_TOP_DOWN));
+                }
+            }
+            if (info) free_pe_mapping_info( info );
+        }
+        break;
+    }
+done:
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    return routed;
+}
+
+static BOOL ios_wow64_route_unmap( HANDLE process, const void *addr, ULONG flags, NTSTATUS *status )
+{
+    unsigned int i;
+    BOOL routed = FALSE;
+    void *owner = ios_jit_current_peb();
+    uintptr_t value = (uintptr_t)addr;
+    sigset_t sigset;
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+    {
+        uintptr_t base = ios_wow64_windows[i].base;
+        if (!ios_wow64_windows[i].owner || value < base || value - base >= IOS_WOW64_WINDOW_SIZE) continue;
+        routed = TRUE;
+        if (process != NtCurrentProcess() || owner != ios_wow64_windows[i].owner)
+            *status = STATUS_ACCESS_DENIED;
+        else if (flags) *status = STATUS_NOT_SUPPORTED;
+        else
+        {
+            server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+            *status = ios_wow64_unmap_image( base, find_view( addr, 1 ) );
+            server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+        }
+        break;
+    }
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    return routed;
+}
