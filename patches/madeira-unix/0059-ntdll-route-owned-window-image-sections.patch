     if (status == STATUS_IMAGE_ALREADY_LOADED)
     {
         status = virtual_map_image( mapping, ios_main_module_slot(), &size, 0, limit_high, 0,
-                                    pe_mapping, machine, FALSE, 0 );
+                                    pe_mapping, machine, FALSE, 0, 0 );
         virtual_fill_image_information( &pe_mapping->image, ios_main_image_info_slot() );
     }
     if (NT_SUCCESS(status) && pe_mapping->image.machine == IMAGE_FILE_MACHINE_I386)
@@ -21697,7 +21705,11 @@ NTSTATUS WINAPI NtMapViewOfSection( HANDLE handle, HANDLE process, PVOID *addr_p
     unsigned int res;
