diff --git a/build/ntdll-unix/wow64_query.h b/build/ntdll-unix/wow64_query.h
index d2b90ac..ffb4259 100644
--- a/build/ntdll-unix/wow64_query.h
+++ b/build/ntdll-unix/wow64_query.h
@@ -83,4 +83,25 @@ static NTSTATUS ios_wow64_query_basic( uintptr_t window, const void *addr,
     *info = result; /* no partial output on a failed query */
     return STATUS_SUCCESS;
 }
+/* Native image queries return host storage too. Do not fabricate a signing
+ * level: this runtime has no Windows image-signature validation. Other query
+ * classes remain explicitly unsupported rather than consulting global views. */
+static NTSTATUS ios_wow64_query_image( uintptr_t window, const void *addr,
+                                     MEMORY_IMAGE_INFORMATION *info )
+{
+    MEMORY_IMAGE_INFORMATION result = {0};
+    struct file_view *view;
+    uintptr_t value = (uintptr_t)addr;
+    if (!info) return STATUS_ACCESS_VIOLATION;
+    if (!ios_wow64_valid_base( window ) || value < window ||
+        value - window >= IOS_WOW64_WINDOW_SIZE) return STATUS_INVALID_PARAMETER;
+    if (!(view = ios_wow64_query_view( window, value ))) return STATUS_INVALID_ADDRESS;
+    if (!(view->protect & VPROT_WOW64_IMAGE) || !view->wow64_registered ||
+        !view->wow64_size || view->wow64_size > view->size ||
+        value - (uintptr_t)view->base >= view->wow64_size) return STATUS_INVALID_ADDRESS;
+    result.ImageBase = view->base;
+    result.SizeOfImage = view->wow64_size;
+    *info = result;
+    return STATUS_SUCCESS;
+}
 #endif
diff --git a/build/ntdll-unix/wow64_section.h b/build/ntdll-unix/wow64_section.h
new file mode 100644
index 0000000..124fe85
--- /dev/null
+++ b/build/ntdll-unix/wow64_section.h
@@ -0,0 +1,70 @@
+/* Narrow native SEC_IMAGE routing: host storage, guest placement.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Registry is held by the caller; bounds selection does not touch views.
+ * No ordinary file/anonymous sections, inheritance, Ex or partial images yet.
+ */
+#ifndef IOS_WOW64_SECTION_H
+#define IOS_WOW64_SECTION_H
+
+static NTSTATUS ios_wow64_section_bounds( uintptr_t window, const void *addr, SIZE_T requested_size,
+                                         uintptr_t zero_bits, uint64_t owner_end,
+                                         const struct pe_image_info *image,
+                                         uint64_t *low, uint64_t *high )
+{
+    uint64_t end = owner_end, start = IOS_WOW64_NULL_GUARD;
+    size_t length;
+    NTSTATUS status;
+    if (!image || !low || !high || !ios_wow64_valid_base( window ) ||
+        image->machine != IMAGE_FILE_MACHINE_I386 || image->is_hybrid ||
+        (image->image_flags & ~(IMAGE_FLAGS_ImageMappedFlat | IMAGE_FLAGS_ImageDynamicallyRelocated)) ||
+        !image->map_size ||
+        image->map_size > SIZE_MAX - host_page_mask) return STATUS_NOT_SUPPORTED;
+    /* Wine's image mapper maps the complete image; do not imply partial views. */
+    if (requested_size && requested_size != image->map_size) return STATUS_NOT_SUPPORTED;
+    length = (image->map_size + host_page_mask) & ~host_page_mask;
+    if ((status = ios_wow64_vm_limit( zero_bits, &end ))) return STATUS_INVALID_PARAMETER_4;
+    if (addr)
+    {
+        uintptr_t value = (uintptr_t)addr;
+        if (value < window || value - window >= IOS_WOW64_WINDOW_SIZE ||
+            ((value - window) & granularity_mask)) return STATUS_INVALID_PARAMETER;
+        start = value - window;
+        if (start < IOS_WOW64_NULL_GUARD || start >= end || length > end - start)
+            return STATUS_CONFLICTING_ADDRESSES;
+        /* A bounded extent forces placement at this guest address. Wine's
+         * existing placement/relocation rejects fixed images at other bases. */
+        end = start + length;
+    }
+    if (start >= end || length > end - start) return STATUS_CONFLICTING_ADDRESSES;
+    *low = start;
+    *high = end - 1;
+    return STATUS_SUCCESS;
+}
+
+/* Unmap is a two-resource transaction. Retain a private section handle so an
+ * atomic replacement failure can restore the exact server image view without
+ * changing bytes/protection. Both locks are held; never delete_view a window.
+ * If even re-registration fails, quarantine the descriptor for owner exit.
+ */
+static NTSTATUS ios_wow64_unmap_image( uintptr_t window, struct file_view *view )
+{
+    NTSTATUS status, rollback;
+    if (!view || !(view->protect & VPROT_WOW64_IMAGE) || !view->wow64_mapping ||
+        !view->wow64_registered) return STATUS_NOT_MAPPED_VIEW;
+    status = ios_wow64_server_unmap( view );
+    if (status) return status;
+    view->wow64_registered = FALSE;
+    status = ios_wow64_rollback_image( view );
+    if (status)
+    {
+        rollback = ios_wow64_server_map( view );
+        if (NT_SUCCESS(rollback)) view->wow64_registered = TRUE;
+        else dprintf(2, "[wow64-section] server rollback failed=%#x; view quarantined until exit\n", rollback);
+        return status;
+    }
+    NtClose( view->wow64_mapping );
+    view->wow64_mapping = 0;
+    ios_wow64_vm_coalesce( window, view );
+    return STATUS_SUCCESS;
+}
+#endif
