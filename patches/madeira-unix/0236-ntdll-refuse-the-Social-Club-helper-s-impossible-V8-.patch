 {
     static const char name[] = "socialclubhelper.exe";
@@ -32,6 +77,8 @@ static void ppsc_note_kept_view_locked(int k, void *peb, struct file_view *v); /
 static int ppsc_owner_view_freed_locked(void *peb, struct file_view *view); /* pp_sc_vm.h */
 static void ppsc_owner_died_locked(void *peb)
 {
+    char probes[48];
+    unsigned n;
     int k;
     if (!peb || !ppsc_ready) return;
     for (k = PPSC_ELF; k <= PPSC_LAST_SLOT; k++) {
@@ -45,9 +92,12 @@ static void ppsc_owner_died_locked(void *peb)
         }
         ppsc_owner[k] = NULL;
         if (ppsc_native_hold(r.base, r.size)) ppsc_held |= PPSC_BIT(k);
-        dprintf(2, "[sc-layout] owner %p exited; kind=%d slot %s\n", peb, k,
-                (ppsc_held & PPSC_BIT(k)) ? "held again" : "NOT held again (something mapped it)");
+        dprintf(2, "[sc-layout] owner %p exited; kind=%d slot %s%s\n", peb, k,
+                (ppsc_held & PPSC_BIT(k)) ? "held again" : "NOT held again (something mapped it)",
+                ppsc_probe_suffix_locked(k, peb, probes, sizeof(probes)));
     }
+    if ((n = ppsc_probe_take_locked(peb)))   /* a helper that never owned the cage, or released it */
+        dprintf(2, "[sc-layout] owner %p exited without kind=6; %u impossible probes refused\n", peb, n);
 }
 
