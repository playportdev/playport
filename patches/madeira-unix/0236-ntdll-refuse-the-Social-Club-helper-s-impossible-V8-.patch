From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: playportdev <dev@playport.dev>
Date: Fri, 30 Oct 2026 21:00:00 +0100
Subject: [PATCH] ntdll: refuse the Social Club helper's impossible V8 probes
 before the map walk

Each SocialClubHelper.exe in an RDR2 layout play logged 26 `ml1027 NO
GAP FITS` lines (l10-l12): V8's partially-reserved sandbox ladder (512 to
16 GiB) and gin's ArrayBuffer pool tries (16 GiB, then 8 GiB after the
sandbox is placed), every one an unhinted NtAllocateVirtualMemoryEx
reserve that cannot fit under the 512 GiB task ceiling. Each one walked
130-153k regions under virtual_mutex: 6.8 s of the launcher's helper and
13.1 s of the game's in l12, while every pseudo-process's VM call waited.

ppsc_route, for both entry points and with its guards unchanged (layout
ready, the verified helper, MEM_RESERVE, no limit, alignment or
attributes), now refuses an unhinted reserve with STATUS_NO_MEMORY before
allocate_virtual_memory when pp_sc_layout.h's ppsc_impossible names it:
larger than PPSC_CEILING - PPSC_FLOOR, the largest gap the layout leaves,
or 8 GiB or more once this helper owns the cage (kind 6), V8's sandbox
subspace tries whose result it keeps only above the ceiling. V8 gets the
status the walk ended in; hinted asks and the cage's own 8 GiB ask are
unchanged. The first two refusals of a PEB are logged; its kind-6
owner-exit line counts them all.

Linear: PLA-476
Class: feature
Evidence: docs/evidence/2026-10-29-sc-stock-cef-probe.md
Offered-upstream: no
---
 build/ntdll-unix/pp_sc_layout.h | 19 ++++++++++++
 build/ntdll-unix/pp_sc_owner.h  | 54 +++++++++++++++++++++++++++++++--
 build/ntdll-unix/pp_sc_vm.h     | 36 +++++++++++++++++++---
 3 files changed, 102 insertions(+), 7 deletions(-)

diff --git a/build/ntdll-unix/pp_sc_layout.h b/build/ntdll-unix/pp_sc_layout.h
index b0c3249..f3fd88b 100644
--- a/build/ntdll-unix/pp_sc_layout.h
+++ b/build/ntdll-unix/pp_sc_layout.h
@@ -78,4 +78,23 @@ static inline enum ppsc_slot ppsc_classify(uint64_t size, uint64_t hint,
     }
     return PPSC_NONE;
 }
+
+/* An unhinted reserve from the verified helper that cannot be placed, so the
+ * router refuses it with STATUS_NO_MEMORY before any map walk (PLA-476):
+ * - PPSC_PROBE_NO_GAP: larger than [PPSC_FLOOR, PPSC_CEILING), the largest gap
+ *   the layout leaves (V8's sandbox ladder from 512 GiB down to 16 GiB, gin's
+ *   16 GiB ArrayBuffer pool tries);
+ * - PPSC_PROBE_SANDBOX: 8 GiB or more once this helper owns the cage, V8's
+ *   emulated sandbox subspace tries, whose result it keeps only inside its
+ *   unbacked 1 TiB range above the task's ceiling.
+ * A hinted ask already fails without a walk and is left alone; the cage's own
+ * 8 GiB ask is routed before this is asked. */
+enum ppsc_probe { PPSC_PROBE_NONE, PPSC_PROBE_NO_GAP, PPSC_PROBE_SANDBOX };
+static inline enum ppsc_probe ppsc_impossible(uint64_t size, uint64_t hint, unsigned mine)
+{
+    if (hint) return PPSC_PROBE_NONE;
+    if (size > PPSC_CEILING - PPSC_FLOOR) return PPSC_PROBE_NO_GAP;
+    if (size >= 0x200000000ULL && (mine & PPSC_BIT(PPSC_CAGE))) return PPSC_PROBE_SANDBOX;
+    return PPSC_PROBE_NONE;
+}
 #endif
diff --git a/build/ntdll-unix/pp_sc_owner.h b/build/ntdll-unix/pp_sc_owner.h
index 5c8a7f5..dd4ed7b 100644
--- a/build/ntdll-unix/pp_sc_owner.h
+++ b/build/ntdll-unix/pp_sc_owner.h
@@ -2,6 +2,51 @@
 /* Shared by the layout router and the existing safe process teardown. */
 static void *ppsc_owner[PPSC_LAST_SLOT + 1]; /* virtual_mutex protects grants and holds */
 
+/* The router's ppsc_impossible refusals per helper PEB, for its owner-exit
+ * line (virtual_mutex protects them). A ninth PEB at once is refused uncounted. */
+#define PPSC_PROBE_PEBS 8
+static void *ppsc_probe_peb[PPSC_PROBE_PEBS];
+static unsigned ppsc_probe_count[PPSC_PROBE_PEBS];
+
+/* virtual_mutex held: counts one refusal for peb; its number, 0 when not counted. */
+static inline unsigned ppsc_probe_counted_locked(void *peb)
+{
+    int i, free_slot = -1;
+    if (!peb) return 0;
+    for (i = 0; i < PPSC_PROBE_PEBS; i++) {
+        if (ppsc_probe_peb[i] == peb) return ++ppsc_probe_count[i];
+        if (!ppsc_probe_peb[i] && free_slot < 0) free_slot = i;
+    }
+    if (free_slot < 0) return 0;
+    ppsc_probe_peb[free_slot] = peb;
+    return ppsc_probe_count[free_slot] = 1;
+}
+
+/* virtual_mutex held, at peb's exit: its refusals; its entry is freed. */
+static inline unsigned ppsc_probe_take_locked(void *peb)
+{
+    int i;
+    unsigned n;
+    if (!peb) return 0;
+    for (i = 0; i < PPSC_PROBE_PEBS; i++) {
+        if (ppsc_probe_peb[i] != peb) continue;
+        n = ppsc_probe_count[i];
+        ppsc_probe_peb[i] = NULL;
+        ppsc_probe_count[i] = 0;
+        return n;
+    }
+    return 0;
+}
+
+/* The owner-exit line's suffix for kind k: the cage's carries peb's refusals. */
+static inline const char *ppsc_probe_suffix_locked(int k, void *peb, char *buf, size_t size)
+{
+    buf[0] = 0;
+    if (k == PPSC_CAGE)
+        snprintf(buf, size, "; %u impossible probes refused", ppsc_probe_take_locked(peb));
+    return buf;
+}
+
