+/* virtual_mutex held: refuses an unhinted reserve ppsc_impossible names, before
+ * allocate_virtual_memory and so before Wine's map walk (PLA-476). V8 gets the
+ * STATUS_NO_MEMORY the walk would have ended in. The first two of a PEB are
+ * logged; its owner-exit line counts them all. */
+static int ppsc_refuse_probe_locked(void **ret, SIZE_T size, NTSTATUS *status)
+{
+    void *peb = ios_jit_current_peb();
+    enum ppsc_probe why = ppsc_impossible(size, (uintptr_t)*ret, ppsc_mine(peb));
+    unsigned n;
+    if (why == PPSC_PROBE_NONE) return 0;
+    if ((n = ppsc_probe_counted_locked(peb)) && n <= 2)
+        dprintf(2, "[sc-layout] probe refused owner=%p size=0x%llx: %s (%u; later ones are counted at its exit)\n",
+                peb, (unsigned long long)size,
+                why == PPSC_PROBE_NO_GAP ? "larger than any gap the layout leaves" : "a sandbox probe after its kind=6",
+                n);
+    *status = STATUS_NO_MEMORY;
+    return 1;
+}
+
 static int ppsc_route(void **ret, SIZE_T *size, ULONG type, ULONG protect, ULONG_PTR limit,
                       int extended, NTSTATUS *status)
 {
@@ -150,10 +172,14 @@ static int ppsc_route(void **ret, SIZE_T *size, ULONG type, ULONG protect, ULONG
          * cage (every logged play asks for it after both). */
         if (*size != 0x200000000ULL || protect != PAGE_NOACCESS ||
             !(ppsc_held & PPSC_BIT(PPSC_CAGE)) || (ppsc_mine(ios_jit_current_peb()) & both) != both) {
+            int refused = ppsc_refuse_probe_locked(ret, *size, status);
             server_leave_uninterrupted_section(&virtual_mutex, &sigset);
-            return 0;
+            return refused;
         }
         k = PPSC_CAGE;
+    } else if (ppsc_refuse_probe_locked(ret, *size, status)) {
+        server_leave_uninterrupted_section(&virtual_mutex, &sigset);
+        return 1;
     } else {
         k = ppsc_classify(*size, (uintptr_t)*ret, ppsc_held, ppsc_mine(ios_jit_current_peb()),
                           ppsc_others(ios_jit_current_peb()));
