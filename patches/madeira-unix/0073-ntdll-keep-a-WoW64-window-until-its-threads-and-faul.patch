 {
     int count = __sync_fetch_and_add(&ios_thread_count, 0);
@@ -1926,13 +1937,15 @@ static void *ios_mach_exception_thread( void *arg )
                  * this file; same value (0x100000000). */
                 /* Playport: a WoW64 process's low 4 GB is its window at
                  * base + guest (virtual_ios.c). The faulting thread's TEB names
-                 * the owner; a fixed sub-floor image (KUSER_SHARED_DATA) still
-                 * resolves first. */
+                 * the owner (its window keeps the TEB mapped until the thread is
+                 * joined); a fixed sub-floor image (KUSER_SHARED_DATA) still
+                 * resolves first. The base stays mapped until fault_leave. */
+                extern void ios_wow64_fault_leave( void );
                 uintptr_t sf_window = 0;
                 if (!sf_real && (uint64_t)fault_addr < 0x100000000ull && thread_teb)
                 {
-                    extern uintptr_t ios_wow64_fault_base_for_peb( void *owner );
-                    sf_window = ios_wow64_fault_base_for_peb( ((TEB *)thread_teb)->Peb );
+                    extern uintptr_t ios_wow64_fault_enter( void *owner );
+                    sf_window = ios_wow64_fault_enter( ((TEB *)thread_teb)->Peb );
                 }
                 if (!sf_real && !sf_window && (uint64_t)fault_addr < 0x100000000ull)
                 {
@@ -1989,6 +2002,7 @@ static void *ios_mach_exception_thread( void *arg )
                         handled = 1;
                     }
                 }
+                if (sf_window) ios_wow64_fault_leave();
             }
 #endif
 
