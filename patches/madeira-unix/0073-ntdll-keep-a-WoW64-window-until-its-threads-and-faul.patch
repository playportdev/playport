+++ b/build/ntdll-unix/signal_arm64_ios.c
@@ -595,6 +595,17 @@ thread_t ios_thread_registry_mach(int i)
     return ios_thread_registry[i].mach_thread;
 }
 
+/* Playport: a torn-down WoW64 window's range. Its threads are dead; their
+ * entries keep the port and lose the TEB, so no reader dereferences it. */
+void ios_thread_registry_forget( uintptr_t start, uintptr_t end )
+{
+    int count = __sync_fetch_and_add(&ios_thread_count, 0);
+    if (count > IOS_MAX_WINE_THREADS) count = IOS_MAX_WINE_THREADS;
+    for (int i = 0; i < count; i++)
+        if (ios_thread_registry[i].teb >= start && ios_thread_registry[i].teb < end)
+            __atomic_store_n( &ios_thread_registry[i].teb, 0, __ATOMIC_RELEASE );
+}
