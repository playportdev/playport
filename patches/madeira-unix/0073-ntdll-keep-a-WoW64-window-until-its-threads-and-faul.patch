diff --git a/build/ntdll-unix/wow64_threads.h b/build/ntdll-unix/wow64_threads.h
new file mode 100644
index 0000000..7b6ccd7
--- /dev/null
+++ b/build/ntdll-unix/wow64_threads.h
@@ -0,0 +1,208 @@
+/* Playport: how long a WoW64 window outlives its threads and fault lookups.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Included after ios_wow64_windows (owner, base, retiring, threads),
+ * IOS_WOW64_WINDOWS_MAX and ios_wow64_windows_lock; the includer provides
+ * virtual_free_thread_data. The windows lock guards the thread records and
+ * the window fields here; the Mach handler's lookups take no lock.
+ *
+ * A windowed owner's secondary threads have their TEB pairs and 32-bit stacks
+ * in its window. The owner's release (its initial thread's exit) only retires
+ * the window while any of them is left: the window is torn down when its last
+ * thread is reclaimed, and teardown waits out the Mach handler's lookups.
+ * A thread is reclaimed only after it is joined: pthread_exit_wrapper marks it
+ * exited, and a later exiting thread, a thread creation or a release joins it.
+ * Its TEB pair stays in the window as a spare for the next thread (a stale
+ * TEB pointer still reads mapped memory, as with Wine's TEB free list).
+ */
+#ifndef IOS_WOW64_THREADS_H
+#define IOS_WOW64_THREADS_H
+
+#define IOS_WOW64_THREADS_MAX 512
+#define IOS_WOW64_THREAD_LIVE    1  /* created; running or not yet started */
+#define IOS_WOW64_THREAD_EXITED  2  /* left pthread_exit_wrapper, not yet joined */
+#define IOS_WOW64_THREAD_JOINING 3  /* claimed by one joiner */
+#define IOS_WOW64_THREAD_SPARE   4  /* no thread: a reclaimed TEB pair to reuse */
+#define IOS_WOW64_JOIN_MAX 16
+
+struct ios_wow64_thread
+{
+    struct thread_data *data;
+    uintptr_t window;
+    uint32_t pair;          /* guest address of its TEB pair */
+    unsigned int state;
+    pthread_t pthread;
+};
+static struct ios_wow64_thread ios_wow64_threads[IOS_WOW64_THREADS_MAX];
+static unsigned long ios_wow64_threads_created, ios_wow64_threads_reclaimed;
+/* Mach handler lookups in progress, between ios_wow64_fault_enter and _leave */
+static unsigned int ios_wow64_fault_readers;
+
+/* The Mach handler's window base for a faulting thread's owner, pinned until
+ * ios_wow64_fault_leave; 0 (nothing to leave) when the owner has none. It must
+ * not take the windows lock (the faulting thread may hold it). The reader is
+ * counted before it reads the owner, and teardown clears the owner before it
+ * waits for the count to drain, so a base read here stays mapped and its slot
+ * unused until the reader leaves. Reservation stores the base before the owner. */
+uintptr_t ios_wow64_fault_enter( void *owner )
+{
+    unsigned int i;
+    if (!owner) return 0;
+    __atomic_add_fetch( &ios_wow64_fault_readers, 1, __ATOMIC_SEQ_CST );
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+        if (__atomic_load_n( &ios_wow64_windows[i].owner, __ATOMIC_SEQ_CST ) == owner)
+            return __atomic_load_n( &ios_wow64_windows[i].base, __ATOMIC_RELAXED );
+    __atomic_sub_fetch( &ios_wow64_fault_readers, 1, __ATOMIC_SEQ_CST );
+    return 0;
+}
+
+void ios_wow64_fault_leave(void)
+{
+    __atomic_sub_fetch( &ios_wow64_fault_readers, 1, __ATOMIC_SEQ_CST );
+}
+
+/* Windows lock held (never virtual_mutex: the handler's lookups are short and
+ * take neither). Unpublish a retiring window that has no thread left: clear
+ * its owner, wait until no lookup can hold its base, drop its spare pairs.
+ * Returns the base; the caller deletes the views, then frees the slot. */
+static uintptr_t ios_wow64_window_unpublish( unsigned int slot )
+{
+    uintptr_t base = ios_wow64_windows[slot].base;
+    unsigned int i;
+
+    __atomic_store_n( &ios_wow64_windows[slot].owner, NULL, __ATOMIC_SEQ_CST );
+    while (__atomic_load_n( &ios_wow64_fault_readers, __ATOMIC_SEQ_CST )) sched_yield();
+    for (i = 0; i < IOS_WOW64_THREADS_MAX; i++)
+        if (ios_wow64_threads[i].window == base)
+            memset( &ios_wow64_threads[i], 0, sizeof(ios_wow64_threads[i]) );
+    return base;
+}
+
+/* The owner's release: TRUE when no secondary thread is left and the caller
+ * tears the window down now; otherwise the last thread's reclamation does. */
+static BOOL ios_wow64_window_retire( unsigned int slot )
+{
+    ios_wow64_windows[slot].retiring = TRUE;
+    return !ios_wow64_windows[slot].threads;
+}
+
+/* A record for a new thread of the window in slot: a spare pair of that window
+ * (*pair its guest address) or an empty record (*pair 0: the caller claims a
+ * pair). -1 when the window is retiring or the table is full. No change. */
+static int ios_wow64_thread_entry( unsigned int slot, uint32_t *pair )
+{
+    int i, empty = -1;
+
+    *pair = 0;
+    if (ios_wow64_windows[slot].retiring) return -1;
+    for (i = 0; i < IOS_WOW64_THREADS_MAX; i++)
+    {
+        if (ios_wow64_threads[i].state == IOS_WOW64_THREAD_SPARE &&
+            ios_wow64_threads[i].window == ios_wow64_windows[slot].base)
+        {
+            *pair = ios_wow64_threads[i].pair;
+            return i;
+        }
+        if (!ios_wow64_threads[i].state && empty < 0) empty = i;
+    }
+    return empty;
+}
+
+static void ios_wow64_thread_commit( unsigned int slot, int entry, struct thread_data *data, uint32_t pair )
+{
+    ios_wow64_threads[entry].data = data;
+    ios_wow64_threads[entry].window = ios_wow64_windows[slot].base;
+    ios_wow64_threads[entry].pair = pair;
+    ios_wow64_threads[entry].state = IOS_WOW64_THREAD_LIVE;
+    ios_wow64_windows[slot].threads++;
+    ios_wow64_threads_created++;
+}
+
+static int ios_wow64_thread_find( const struct thread_data *data )
+{
+    int i;
+    for (i = 0; data && i < IOS_WOW64_THREADS_MAX; i++)
+        if (ios_wow64_threads[i].data == data) return i;
+    return -1;
+}
+
+/* A joined (or never started) thread's record becomes its pair's spare record.
+ * Returns the window's slot when it was a retiring window's last thread (the
+ * caller tears it down), else -1. */
+static int ios_wow64_thread_reclaimed( int entry )
+{
+    uintptr_t window = ios_wow64_threads[entry].window;
+    unsigned int i;
+
+    ios_wow64_threads[entry].data = NULL;
+    ios_wow64_threads[entry].state = IOS_WOW64_THREAD_SPARE;
+    ios_wow64_threads_reclaimed++;
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+    {
+        if (!ios_wow64_windows[i].owner || ios_wow64_windows[i].base != window) continue;
+        if (ios_wow64_windows[i].threads) ios_wow64_windows[i].threads--;
+        return ios_wow64_windows[i].retiring && !ios_wow64_windows[i].threads ? (int)i : -1;
+    }
+    return -1;
+}
+
+/* Claim up to IOS_WOW64_JOIN_MAX exited threads to join, then mark self (the
+ * thread in pthread_exit_wrapper, or NULL) exited. One critical section: a
+ * thread joins only threads that exited before it, so joins form no cycle. */
+static unsigned int ios_wow64_thread_collect( const struct thread_data *self, pthread_t self_id,
+                                              struct ios_wow64_thread *joins )
+{
+    unsigned int i, count = 0;
+    int entry;
+
+    for (i = 0; i < IOS_WOW64_THREADS_MAX && count < IOS_WOW64_JOIN_MAX; i++)
+    {
+        if (ios_wow64_threads[i].state != IOS_WOW64_THREAD_EXITED) continue;
+        ios_wow64_threads[i].state = IOS_WOW64_THREAD_JOINING;
+        joins[count++] = ios_wow64_threads[i];
+    }
+    if ((entry = ios_wow64_thread_find( self )) >= 0 &&
+        ios_wow64_threads[entry].state == IOS_WOW64_THREAD_LIVE)
+    {
+        ios_wow64_threads[entry].state = IOS_WOW64_THREAD_EXITED;
+        ios_wow64_threads[entry].pthread = self_id;
+    }
+    return count;
+}
+
+/* Join exited threads (self: the exiting thread, or NULL) and free them:
+ * virtual_free_thread_data reclaims each through its window. No lock held
+ * while joining; a joined thread has left pthread_exit_wrapper already. */
+static void ios_wow64_reap_threads( struct thread_data *self )
+{
+    struct ios_wow64_thread joins[IOS_WOW64_JOIN_MAX];
+    unsigned int i, count;
+
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    count = ios_wow64_thread_collect( self, pthread_self(), joins );
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    for (i = 0; i < count; i++)
+    {
+        pthread_join( joins[i].pthread, NULL );
+        virtual_free_thread_data( joins[i].data );
+    }
+}
+
+/* exit_thread: a window thread is joined by ios_wow64_reap_threads, never by
+ * exit_thread's previous-thread join (that could free it before its window's
+ * records do). */
+BOOL ios_wow64_is_window_thread( const struct thread_data *data )
+{
+    BOOL found;
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    found = ios_wow64_thread_find( data ) >= 0;
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    return found;
+}
+
+/* pthread_exit_wrapper, last thing before pthread_exit, for every thread. */
+void ios_wow64_thread_exit( struct thread_data *data )
+{
+    ios_wow64_reap_threads( data );
+}
+
+#endif
