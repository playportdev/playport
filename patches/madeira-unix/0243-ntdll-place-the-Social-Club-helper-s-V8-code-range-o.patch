From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: playportdev <dev@playport.dev>
Date: Fri, 30 Oct 2026 23:00:00 +0100
Subject: [PATCH] ntdll: place the Social Club helper's V8 code range on a 4
 GiB-aligned base

V8's 1 GiB code range is a hinted reserve with a 4 GiB-aligned random
hint, and V8 releases a reservation anywhere but a 4 GiB-aligned base;
after its hinted tries it asks for 1 GiB + 4 GiB - 64 KiB padded, which
needs a 5 GiB hole the layout never leaves. Wine's hinted >= 1 GiB retry
tries slot + (hint & (16 GiB - 1)) - 16 GiB for a guard-style offset and
only 16 GiB-aligned slots for offset 0. Under the Social Club layout every
16 GiB-aligned slot is taken (kinds 2, 3, 1 and Oilpan), so an offset-0
hint (about a quarter of them) can only fall to the kernel's pick, the
bottom of the largest hole, which is not aligned. l16's game helper took
that path twice, then four padded NO GAP FITS and Chromium's out-of-memory
exit, with [0x7300000000, +1 GiB) free inside its largest hole
[0x72b0364000, 0x73b6ef4000).

For the verified helper (ppsc_ready and ppsc_helper()) whose hint is
4 GiB-aligned, the retry now tries each 4 GiB-aligned base b with
[b, b + size) inside [PPSC_FLOOR, PPSC_CEILING) (0x7100000000,
0x7200000000, 0x7300000000) before the kernel's pick, each logged as
"[jumbo] cand sc-aligned". pp_sc_layout.h's pure ppsc_code_range_next
names the candidates. Off-layout plays and every other process keep the
retry as it was. It reserves nothing new: it moves a reservation that
succeeds anyway onto a base V8 keeps.

Linear: PLA-476
Class: feature
Evidence: docs/evidence/2026-10-29-sc-stock-cef-probe.md
Offered-upstream: no
---
 build/ntdll-unix/pp_sc_layout.h | 17 +++++++++++++++++
 build/ntdll-unix/virtual_ios.c  | 18 ++++++++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/build/ntdll-unix/pp_sc_layout.h b/build/ntdll-unix/pp_sc_layout.h
index f3fd88b..91d6ec0 100644
--- a/build/ntdll-unix/pp_sc_layout.h
+++ b/build/ntdll-unix/pp_sc_layout.h
@@ -97,4 +97,21 @@ static inline enum ppsc_probe ppsc_impossible(uint64_t size, uint64_t hint, unsi
     if (size >= 0x200000000ULL && (mine & PPSC_BIT(PPSC_CAGE))) return PPSC_PROBE_SANDBOX;
     return PPSC_PROBE_NONE;
 }
+
+/* V8's 1 GiB code range in the verified helper (PLA-476, decision 0169): V8
+ * hints a 4 GiB-aligned base and releases a reservation anywhere else. The
+ * hinted retry tries these before the kernel's pick: each 4 GiB-aligned base b
+ * with [b, b + size) inside [PPSC_FLOOR, PPSC_CEILING), lowest first. Returns
+ * the base after prev (0 for the first), or 0 when none is left or the hint is
+ * not 4 GiB-aligned. */
+#define PPSC_CODE_RANGE_ALIGN UINT64_C(0x100000000)
+static inline uint64_t ppsc_code_range_next(uint64_t size, uint64_t hint, uint64_t prev)
+{
+    uint64_t b;
+    if (!size || !hint || (hint & (PPSC_CODE_RANGE_ALIGN - 1)) || prev >= PPSC_CEILING) return 0;
+    b = prev ? (prev & ~(PPSC_CODE_RANGE_ALIGN - 1)) + PPSC_CODE_RANGE_ALIGN
+             : (PPSC_FLOOR + PPSC_CODE_RANGE_ALIGN - 1) & ~(PPSC_CODE_RANGE_ALIGN - 1);
+    if (b < PPSC_FLOOR || b >= PPSC_CEILING || size > PPSC_CEILING - b) return 0;
+    return b;
+}
 #endif
diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index 1fc12e6..73a0e2b 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -22080,6 +22080,24 @@ NTSTATUS WINAPI NtAllocateVirtualMemory( HANDLE process, PVOID *ret, ULONG_PTR z
                             pick, (unsigned long long)IOS_CAGE_REAL_SIZE,
                             (unsigned long)(st2 ? 0 : sz), (unsigned)st2);
                 }
+                /* PLA-476 (decision 0169): the verified Social Club helper's V8
+                 * code range needs a 4 GiB-aligned base and releases any other.
+                 * The walks above try at most one aligned GiB of the layout's
+                 * window (none for off == 0), so try each before the kernel's
+                 * unaligned pick (l16's game helper died on that pick). */
+                if (st2 && ppsc_ready && ppsc_helper())
+                {
+                    uint64_t base = 0;
+                    while (st2 && (base = ppsc_code_range_next( *size_ptr, (ULONG_PTR)hint, base )))
+                    {
+                        SIZE_T csz = *size_ptr;
+                        pick = (void *)(uintptr_t)base;
+                        st2 = allocate_virtual_memory( &pick, &csz, type, protect, 0, 0, 0, 0 );
+                        dprintf(2, "[jumbo] cand sc-aligned base=0x%llx size=0x%lx st=0x%x\n",
+                                (unsigned long long)base, (unsigned long)csz, (unsigned)st2);
+                        if (!st2) sz = csz;
+                    }
+                }
                 if (st2)
                 {
                     pick = NULL;
