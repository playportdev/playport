+    if ((top8 & 0x3F) == 0x39 || (top8 & 0x3F) == 0x3D)
     {
-        if (rn == 18) return X18_ROLE_RN;
+        if (rn == 18) role |= X18_ROLE_RN;
+        if (rt == 18 && !(insn & 0x04c00000) && rn != 31) role |= X18_ROLE_RT;   /* STR x18 */
