+    /* CBZ/CBNZ, TBZ/TBNZ on x18 (as a W register too) */
+    if (((insn & 0x7e000000) == 0x34000000 || (insn & 0x7e000000) == 0x36000000) && rt == 18)
+        return X18_ROLE_BRANCH;
 
