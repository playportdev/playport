-        if (tramp >= rx && tramp + 28 <= rx + ios_jit_pool_size_global)
+        /* Playport: a branch's trampoline (0263) is 9 words */
+        if (tramp >= rx && tramp + 36 <= rx + ios_jit_pool_size_global)
         {
             unsigned reg;
             uint32_t op;
-            switch (ppss_x18_tramp( (const uint32_t *)tramp, tramp, step.Pc, &reg, &op ))
+            uint64_t target;
+            switch (ppss_x18_tramp( (const uint32_t *)tramp, tramp, step.Pc, &reg, &op, &target ))
             {
             case PPSS_TRAMP_MOV:   /* mov xN, x18: done here, below */
                 insn = 0xaa1203e0 | reg;
@@ -6654,6 +6656,10 @@ static NTSTATUS ios_ss_continue( struct thread_data *data, const CONTEXT *contex
                 tramp_reg = reg + 1;
                 insn = op;
                 break;
+            case PPSS_TRAMP_BRANCH:   /* CBZ/CBNZ/TBZ/TBNZ on x18: to its target or on, by the TEB */
+                step.Pc = ppss_x18_branch_next( (uint64_t)(ULONG_PTR)data->teb, op, step.Pc, target );
+                branched = 1;
+                break;
             }
         }
     }
@@ -6663,7 +6669,8 @@ static NTSTATUS ios_ss_continue( struct thread_data *data, const CONTEXT *contex
     if ((insn & 0xfffffc1f) == 0xd63f0000 && ((insn >> 5) & 31) != 31 &&
         (step.X[(insn >> 5) & 31] < rx || step.X[(insn >> 5) & 31] >= rx + ios_jit_pool_size_global))
         call_out = 1;
-    else if ((insn & 0xffffffe0) == 0xaa1203e0 || ppss_step_in_place( (uint64_t *)step.X, (uint64_t *)&step.Pc, step.Cpsr, (unsigned char (*)[16])step.V, insn ))
+    else if (branched || (insn & 0xffffffe0) == 0xaa1203e0 ||
+             ppss_step_in_place( (uint64_t *)step.X, (uint64_t *)&step.Pc, step.Cpsr, (unsigned char (*)[16])step.V, insn ))
     {
         EXCEPTION_RECORD rec = { .ExceptionCode = EXCEPTION_SINGLE_STEP };
         ULONG64 pe;
