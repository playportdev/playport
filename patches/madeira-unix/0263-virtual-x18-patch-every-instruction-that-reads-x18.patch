From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Sun, 1 Nov 2026 02:00:00 +0100
Subject: [PATCH] virtual: x18-patch every instruction that reads x18

The patcher sent loads, stores, ADD/SUB and MOV off x18 to a TEB
trampoline. Every other instruction that reads x18 kept reading the 0 iOS
leaves there: World of Warcraft's ARM64 client mixes x18 into opaque
predicates and computed values in any data-processing form (TST, EOR,
CCMP, CSEL, MADD, CBZ ...), and with 0 for the TEB those went their other
way.

ios_insn_x18_role now returns the fields holding x18 as a source for the
logical (register and immediate), ADD/SUB, ADC/SBC, CCMP/CCMN, CSEL,
1- and 2-source, 3-source, bitfield and EXTR classes, and a store of
x18 (STR, or either register of an STP of X or W registers); each of those
fields gets the scratch register. A load into x18 writes it, and in an
LDP or STP of SIMD and FP registers (`ldp q19, q18, [x8], #0x20`, `stp
s19, s18, [x10, #0x50]`) field 18 is q18 or s18: those keep their word.
Rewritten, such a pair loaded or stored q17 or s17 in place of q18 or
s18; World of Warcraft's Classic client has 2,003 of them in its code,
221 of which run before its login screen on Linux.

The scratch register is the first of x17, x16, x15 ... the instruction
does not name, where an instruction naming both x16 and x17 (47 in the
Classic client's code, as `subs x17, x18, x16, lsr #28`) was left to
read 0. The single step (0259) reads it back from the trampoline's
first word.

CBZ/CBNZ/TBZ/TBNZ on x18 get a trampoline that branches on the TEB and
ends in a B to the original target or back; their scratch register is
x17, as their other fields are the offset, not registers. Forms where
register 31 is SP (a destination without S, a load or store relative to
SP with x18 as its data or its offset) are left alone, as the trampoline
moves SP. A word read by a literal load stays code whenever it reads x18
with Rd = 31, as 0260 did for CMP: such a word is odd, so no aligned
pointer.

A single step at such a branch (0259) is the branch on the TEB, to its
target or on: the first seven words of its trampoline read as another
site's, whose instruction would be `cbz x17, #12`, and the step tested
the guest's x17 and went on to the site + 12.

Linear: PLA-514
Class: ios-port
Evidence: docs/evidence/2026-10-31-wow-arm64-start.md, tools/tests/test_x18_compare.py, tools/tests/test_single_step.py
Offered-upstream: no
---
 build/ntdll-unix/pp_single_step.h   |  43 ++++-
 build/ntdll-unix/signal_arm64_ios.c |  15 +-
 build/ntdll-unix/virtual_ios.c      | 250 ++++++++++++++++++----------
 3 files changed, 213 insertions(+), 95 deletions(-)

diff --git a/build/ntdll-unix/pp_single_step.h b/build/ntdll-unix/pp_single_step.h
index db7e322..e1a978a 100644
--- a/build/ntdll-unix/pp_single_step.h
+++ b/build/ntdll-unix/pp_single_step.h
@@ -140,28 +140,46 @@ static inline int ppss_step_in_place( uint64_t x[31], uint64_t *pc, uint32_t cps
  * - PPSS_TRAMP_OP: *op is the instruction with *reg in place of x18, to run
  *   out of line with the TEB in *reg (its value put back after);
  * - PPSS_TRAMP_MOV: the instruction was MOV x*reg, x18;
- * - PPSS_TRAMP_NONE: no trampoline of the patcher's (a branch like another). */
-#define PPSS_TRAMP_NONE 0
-#define PPSS_TRAMP_OP   1
-#define PPSS_TRAMP_MOV  2
+ * - PPSS_TRAMP_BRANCH: a CBZ/CBNZ/TBZ/TBNZ on x18 (0263), whose trampoline
+ *   branches on the TEB in *reg with *op (offset 12) to a restore before a B
+ *   to *target, or on to the way back; ppss_x18_branch_next does its step;
+ * - PPSS_TRAMP_NONE: no trampoline of the patcher's (a branch like another).
+ * A branch's trampoline is 9 words, any other 7 at most. */
+#define PPSS_TRAMP_NONE   0
+#define PPSS_TRAMP_OP     1
+#define PPSS_TRAMP_MOV    2
+#define PPSS_TRAMP_BRANCH 3
 
 static inline int ppss_branch_to( uint32_t insn, uint64_t at, uint64_t to )
 {
     return (insn & 0xfc000000) == 0x14000000 && at + ppss_sext( (insn & 0x3ffffff) << 2, 28 ) == to;
 }
 
-static inline int ppss_x18_tramp( const uint32_t *t, uint64_t tramp, uint64_t pc, unsigned *reg, uint32_t *op )
+/* CBZ/CBNZ/TBZ/TBNZ */
+static inline int ppss_cb_tb( uint32_t op )
+{
+    return (op & 0x7e000000) == 0x34000000 || (op & 0x7e000000) == 0x36000000;
+}
+
+static inline int ppss_x18_tramp( const uint32_t *t, uint64_t tramp, uint64_t pc, unsigned *reg, uint32_t *op,
+                                  uint64_t *target )
 {
     unsigned r = t[0] & 31;
     uint32_t teb_load = 0x927df000u | (r << 5) | r;
 
-    if ((t[0] == 0xf81f0ff1u || t[0] == 0xf81f0ff0u) && t[1] == (0xd53bd060u | r) && t[2] == teb_load &&
+    if ((t[0] & 0xffffffe0u) == 0xf81f0fe0u && r < 18 && t[1] == (0xd53bd060u | r) && t[2] == teb_load &&
         (t[3] & 0xffc003ffu) == (0xf9400000u | (r << 5) | r) && t[5] == (0xf84107e0u | r) &&
         ppss_branch_to( t[6], tramp + 24, pc + 4 ))
     {
         *reg = r;
         *op = t[4];
-        return PPSS_TRAMP_OP;
+        if (!ppss_cb_tb( t[4] )) return PPSS_TRAMP_OP;
+        /* a branch's: on the TEB to offset 12, the restore again and a B to the target */
+        if ((t[4] & 31) != r || ((t[4] >> 5) & ((t[4] & 0x02000000) ? 0x3fff : 0x7ffff)) != 3 ||
+            t[7] != t[5] || (t[8] & 0xfc000000) != 0x14000000)
+            return PPSS_TRAMP_NONE;
+        *target = tramp + 32 + ppss_sext( (t[8] & 0x3ffffff) << 2, 28 );
+        return PPSS_TRAMP_BRANCH;
     }
     if ((t[0] & 0xffffffe0u) == 0xd53bd060u && t[1] == teb_load &&
         (t[2] & 0xffc003ffu) == (0xf9400000u | (r << 5) | r) && ppss_branch_to( t[3], tramp + 12, pc + 4 ))
@@ -172,4 +190,15 @@ static inline int ppss_x18_tramp( const uint32_t *t, uint64_t tramp, uint64_t pc
     return PPSS_TRAMP_NONE;
 }
 
+/* The pc after a step at a CBZ/CBNZ/TBZ/TBNZ on x18 (PPSS_TRAMP_BRANCH) at pc:
+ * op tests the TEB, and taken it goes to target. */
+static inline uint64_t ppss_x18_branch_next( uint64_t teb, uint32_t op, uint64_t pc, uint64_t target )
+{
+    int nonzero = !!(op & 0x01000000);
+
+    if ((op & 0x7e000000) == 0x34000000)   /* CBZ/CBNZ, W or X */
+        return ((op & 0x80000000) ? teb : (uint32_t)teb) ? (nonzero ? target : pc + 4) : (nonzero ? pc + 4 : target);
+    return ((teb >> (((op >> 26) & 32) | ((op >> 19) & 31))) & 1) == (uint64_t)nonzero ? target : pc + 4;
+}
+
 #endif /* PP_SINGLE_STEP_H */
