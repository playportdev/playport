+/* Check if an ARM64 instruction reads x18 as a register operand.
+ * Returns the fields that hold it as a mask of X18_ROLE_* bits, or 0.
+ * Playport (PLA-514): every instruction that reads x18 as a source, not
+ * only loads, stores and ADD/SUB/MOV off it. iOS zeroes x18, and World of
+ * Warcraft's ARM64 client builds its opaque predicates and computed values
+ * from x18 in any data-processing form (TST, CCMP, CSEL, EOR, MADD ...):
+ * with 0 for the TEB those took other paths. CBZ/CBNZ/TBZ/TBNZ on x18 get a
+ * branch trampoline (X18_ROLE_BRANCH). A store of x18 relative to SP, and the
+ * forms where register 31 is SP as a destination, are left alone: the
+ * trampoline runs with SP 16 bytes down. */
+#define X18_ROLE_NONE   0
+#define X18_ROLE_RN     1   /* bits[9:5] */
+#define X18_ROLE_RM     2   /* bits[20:16] */
+#define X18_ROLE_RT2    4   /* bits[14:10]: LDP/STP's second register, 3-source's Ra */
+#define X18_ROLE_RT     8   /* bits[4:0] as a source: a store's Rt */
+#define X18_ROLE_BRANCH 16  /* CBZ/CBNZ/TBZ/TBNZ on x18 */
 
