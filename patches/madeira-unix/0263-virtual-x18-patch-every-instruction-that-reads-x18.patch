+    /* LDR/STR (unscaled, pre/post-indexed) — [29:27]=111, [25:24]=00, [21]=0 */
+    if ((top11 & 0x1F9) == 0x1C0)
     {
-        if (rn == 18) return X18_ROLE_RN;
+        if (rn == 18) role |= X18_ROLE_RN;
+        if (rt == 18 && !(insn & 0x04c00000) && rn != 31) role |= X18_ROLE_RT;
