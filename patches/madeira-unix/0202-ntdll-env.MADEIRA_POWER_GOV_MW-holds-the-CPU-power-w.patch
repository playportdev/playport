From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Tue, 20 Oct 2026 17:04:31 +0200
Subject: [PATCH] ntdll: env.MADEIRA_POWER_GOV_MW holds the CPU power with ECO
 while a game presents

The SoC clamps the CPU once a budget of energy spent above ~2.3 W is
used up (Madeira's ml1133 measured ~250 J), and Madeira's GTA V Enhanced
was clamped at the start of play after loading screens at 3-5 W.
Bursting and then running clamped wastes the budget; RDR2 here spends
minutes in its launcher and loading before play.

As Madeira's 3930d18: with env.MADEIRA_POWER_GOV_MW = target (mW), while
a game presents, a running balance of (power - target) x time, from
[xp]'s ri_energy_nj, turns ECO on (madeira_set_eco: guest threads at the
eco QoS) when it exceeds +MADEIRA_POWER_GOV_BAND_MJ (default 1000) and
off below -BAND, at most one switch per 500 ms; the balance is clamped
to three bands. When no game presents for 2 s, ECO goes back to what it
was before. [power-gov] logs when it starts governing and summarises
every 10 s (average W, target, ECO share, switches).

Madeira's signal that a game presents was its [bg-qos] game note
(4e20535, not ported); here it is the [xp] sampler seeing a role-P
thread run for 1 ms in a sample: DXMT's present thread, or a thread
that called vkQueuePresentKHR (wine-unix 0200). The governor runs in
the [xp] sampler, so a release build (MADEIRA_NO_DIAGNOSTICS) never
governs. Off by default, as in Madeira. Madeira's records note that ECO
crashed GTA V while loading (bcd 449); this switches ECO only while a
game presents.

Madeira-commit: 3930d18558f3b716cb6212a74b6af46f02c49cbe
Linear: PLA-364
Class: feature
Evidence: docs/evidence/2026-10-20-rdr2-perf-ports.md
Offered-upstream: no
---
 build/ntdll-unix/server_ios.c | 93 +++++++++++++++++++++++++++++++++++
 1 file changed, 93 insertions(+)

diff --git a/build/ntdll-unix/server_ios.c b/build/ntdll-unix/server_ios.c
index b192f59..ae7655e 100644
--- a/build/ntdll-unix/server_ios.c
+++ b/build/ntdll-unix/server_ios.c
@@ -1716,6 +1716,97 @@ static void ios_xp_name_native( pthread_t pt, uint64_t tid )
     wine_log_write( "[xp-names] m%llu \"%s\"", (unsigned long long)tid, name[0] ? name : "(unnamed)" );
 }
 
+/* CPU power governor (opt-in: env.MADEIRA_POWER_GOV_MW = target in mW), from
+ * Madeira's 3930d18. The SoC clamps the CPU once a budget of energy spent above
+ * ~2.3 W is used up (ml1133 measured ~250 J), and Madeira's GTA V Enhanced was
+ * clamped at the start of play after loading screens at 3-5 W: bursting and
+ * then running clamped wastes the budget. So while a game presents this holds
+ * the process's CPU power ([xp]'s ri_energy_nj) at the target on average: a
+ * running balance of (power - target) x time turns ECO on (madeira_set_eco:
+ * guest threads at the eco QoS, efficiency cores, lower clocks) when it exceeds
+ * +MADEIRA_POWER_GOV_BAND_MJ (default 1000) and off when it falls below -BAND,
+ * at most one switch per 500 ms. A game presents while the [xp] sampler sees a
+ * presenting thread (role P: DXMT's present thread, or a thread that called
+ * vkQueuePresentKHR) run for 1 ms in a sample; 2 s without one and ECO goes
+ * back to what it was. [power-gov] summarises every 10 s. Needs the [xp]
+ * sampler, so a release build (MADEIRA_NO_DIAGNOSTICS) never governs. */
+extern void madeira_set_eco( int on );
+extern int madeira_get_eco( void );
+#define IOS_POWER_GOV_HOLD_NS (2000ull * 1000 * 1000)
+static uint64_t ios_power_gov_seen_ns;   /* 0: no presenting thread has run yet */
+
+static uint64_t ios_power_gov_now_ns( void )
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static void ios_power_gov_step( uint64_t now, double dt_ms, double mj )
+{
+    static int target_mw = -1, band_mj, base, active;
+    static double balance, sum_mj, sum_ms, eco_ms;
+    static unsigned switches;
+    static uint64_t last_switch, last_report;
+    uint64_t seen;
+    int eco;
+
+    if (target_mw < 0)
+    {
+        const char *e = getenv( "MADEIRA_POWER_GOV_MW" );   /* process CPU power target (mW) while a game presents; unset/0 = off */
+        const char *b = getenv( "MADEIRA_POWER_GOV_BAND_MJ" );   /* energy (mJ) the running balance may drift before ECO switches (1000) */
+        target_mw = e ? atoi( e ) : 0;
+        if (target_mw < 0 || target_mw > 20000) target_mw = 0;
+        band_mj = b ? atoi( b ) : 1000;
+        if (band_mj < 50 || band_mj > 100000) band_mj = 1000;
+        if (target_mw)
+            wine_log_write( "[power-gov] on: process CPU power held at %d mW while a game presents (band %d mJ; "
+                            "MADEIRA_POWER_GOV_MW, MADEIRA_POWER_GOV_BAND_MJ)", target_mw, band_mj );
+    }
+    if (!target_mw || dt_ms <= 0) return;
+    seen = ios_power_gov_seen_ns;
+    if (!seen || now - seen >= IOS_POWER_GOV_HOLD_NS)
+    {
+        if (active)   /* the game stopped presenting: ECO back to what it was */
+        {
+            active = 0;
+            if (madeira_get_eco() != base) madeira_set_eco( base );
+            wine_log_write( "[power-gov] the game stopped presenting: ECO back %s", base ? "on" : "off" );
+        }
+        return;
+    }
+    eco = madeira_get_eco();   /* re-read: something else may have moved it */
+    if (!active)
+    {
+        active = 1;
+        base = eco;
+        balance = sum_mj = sum_ms = eco_ms = 0;
+        switches = 0;
+        last_switch = last_report = now;
+        wine_log_write( "[power-gov] a game presents: governing from ECO %s", eco ? "on" : "off" );
+    }
+    balance += mj - target_mw * dt_ms / 1000.0;
+    if (balance > 3.0 * band_mj) balance = 3.0 * band_mj;     /* a long burst buys no long ECO stretch */
+    if (balance < -3.0 * band_mj) balance = -3.0 * band_mj;   /* nor a long idle stretch a long burst */
+    sum_mj += mj;
+    sum_ms += dt_ms;
+    if (eco) eco_ms += dt_ms;
+    if (now - last_switch >= 500000000ull && ((!eco && balance > band_mj) || (eco && balance < -band_mj)))
+    {
+        madeira_set_eco( !eco );
+        last_switch = now;
+        switches++;
+    }
+    if (now - last_report >= 10000000000ull && sum_ms > 0)
+    {
+        wine_log_write( "[power-gov] last %.0f s: %.2f W average (target %.2f W), ECO on %.0f%% of the time, %u switches",
+                        sum_ms / 1000.0, sum_mj / sum_ms, target_mw / 1000.0, 100.0 * eco_ms / sum_ms, switches );
+        last_report = now;
+        sum_mj = sum_ms = eco_ms = 0;
+        switches = 0;
+    }
+}
+
 static void ios_xprobe_main( void )
 {
     static struct ios_xp_row rows[1024];
@@ -1785,6 +1876,7 @@ static void ios_xprobe_main( void )
                                 r->role = NULL;
                                 for (i = 0; i < ios_xp_nroles; i++) if (ios_xp_roles[i].tid == idi.thread_id) { r->role = ios_xp_roles[i].role; break; }
                                 if (r->role && teb && (strchr( r->role, 'P' ) || strchr( r->role, 'E' ))) ios_xp_game_teb = teb;   /* ml1131 */
+                                if (r->role && strchr( r->role, 'P' ) && pt + et >= 1.0) ios_power_gov_seen_ns = ios_power_gov_now_ns();
                                 sum_thr_ms += pt + et; nrows++;
                             }
                         }
@@ -1810,6 +1902,7 @@ static void ios_xprobe_main( void )
             double pcy = (double)(ru.ri_pcycles - pru.ri_pcycles), cy = (double)(ru.ri_cycles - pru.ri_cycles);
             double ins = (double)(ru.ri_instructions - pru.ri_instructions);
             double qf = (have_pe && pe.magic == 0x3130305058444d4dLL && pe.qpf) ? 1000.0 / (double)pe.qpf : 0;
+            ios_power_gov_step( ios_power_gov_now_ns(), dt_ms, (double)(ru.ri_energy_nj - pru.ri_energy_nj) / 1e6 );
             gettimeofday( &tv, NULL ); localtime_r( &tv.tv_sec, &tmv );
             snprintf( wall, sizeof(wall), "%02d:%02d:%02d.%03d", tmv.tm_hour, tmv.tm_min, tmv.tm_sec, (int)(tv.tv_usec / 1000) );
             n = snprintf( line, sizeof(line),
