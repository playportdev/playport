From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Mon, 19 Oct 2026 12:59:37 +0200
Subject: [PATCH] virtual: leave a builtin's .rsrc and .reloc out of its
 JIT-pool copy
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Every pseudo-process gets its own pool copy of each image it loads
(decision 0019), and the copy took the whole SizeOfImage. In the RDR2
play that ran the pool's head out (PLA-377), 155.6 MiB of its 535 MiB
were the builtins' trailing .rsrc and .reloc, which no code reaches:
shell32's copy was 9.9 MiB for 0.56 MiB of code.

A copy now ends after the last section code may reach
(ios_copy_extent.h, shared with build/wow64/copy_extent_test.c): the
trailing sections that are neither executable nor writable and hold the
resource directory, or are discardable, and hold no other data
directory are left out. ntdll keeps its whole image: its child copies
relocate from their own bytes.

- A mapping keeps two sizes: size is the copy's bytes, which
  translation, the FEX alias push, the IAT sync and the scans of the copy
  use, so an address past it keeps its PE address and reads the PE view;
  image_size is SizeOfImage, which the already-copied containment test,
  ml352's stale check, the stale purge on add and the module name use.
- The copy path and the IAT sync read the relocations from the PE view,
  skip a fixup the copy does not hold, and point a pointer into the part
  left out at the PE view.
- The `[jit-pool] image` line carries `copy=0x… of 0x…`, and
  ios_jit_pool_stats a 17th field, head_trimmed: the bytes copies left
  out.

ntdll's resource functions find resources through the PE view when given
a copy's base (patches/wine-pe, "find a builtin's resources through its
PE view").

Linear: PLA-377
Class: feature
Evidence: docs/evidence/2026-10-19-smaller-image-copies.md
Offered-upstream: no; the JIT pool is the iOS port's
---
 build/ntdll-unix/ios_copy_extent.h | 115 ++++++++++++++++++++
 build/ntdll-unix/virtual_ios.c     | 166 +++++++++++++++++++----------
 2 files changed, 227 insertions(+), 54 deletions(-)
 create mode 100644 build/ntdll-unix/ios_copy_extent.h

diff --git a/build/ntdll-unix/ios_copy_extent.h b/build/ntdll-unix/ios_copy_extent.h
new file mode 100644
index 0000000..3634bbd
--- /dev/null
+++ b/build/ntdll-unix/ios_copy_extent.h
@@ -0,0 +1,115 @@
+/* What of a PE image its JIT-pool copy needs, shared with the copy-extent test.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef IOS_COPY_EXTENT_H
+#define IOS_COPY_EXTENT_H
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#define IOS_SCN_MEM_DISCARDABLE 0x02000000u
+#define IOS_SCN_MEM_EXECUTE     0x20000000u
+#define IOS_SCN_MEM_WRITE       0x80000000u
+#define IOS_DIR_RESOURCE  2
+#define IOS_DIR_SECURITY  4   /* a file offset, not an RVA */
+#define IOS_DIR_BASERELOC 5
+
+static inline uint32_t ios_copy_extent_u32( const unsigned char *p )
+{
+    uint32_t v;
+    memcpy( &v, p, sizeof(v) );
+    return v;
+}
+
+static inline uint16_t ios_copy_extent_u16( const unsigned char *p )
+{
+    uint16_t v;
+    memcpy( &v, p, sizeof(v) );
+    return v;
+}
+
+/* Whether no code reaches section `sec` through a pool copy: it is neither
+ * executable nor writable, holds the resource directory (ntdll's resource
+ * functions read it through the PE view) or is discardable (the base
+ * relocations, which the copy path reads from the PE view, and debug info),
+ * and holds no other data directory. */
+static inline int ios_copy_extent_unreached( const unsigned char *sec, const unsigned char *dirs,
+                                             unsigned int ndirs )
+{
+    uint32_t start = ios_copy_extent_u32( sec + 12 );
+    uint32_t vsize = ios_copy_extent_u32( sec + 8 );
+    uint32_t end = start + (vsize ? vsize : ios_copy_extent_u32( sec + 16 ));
+    uint32_t chars = ios_copy_extent_u32( sec + 36 );
+    int resources = 0;
+    unsigned int d;
+
+    if (chars & (IOS_SCN_MEM_EXECUTE | IOS_SCN_MEM_WRITE)) return 0;
+    for (d = 0; d < ndirs; d++)
+    {
+        uint32_t rva = ios_copy_extent_u32( dirs + d * 8 );
+        if (d == IOS_DIR_SECURITY || !rva || rva < start || rva >= end) continue;
+        if (d == IOS_DIR_RESOURCE) resources = 1;
+        else if (d != IOS_DIR_BASERELOC) return 0;
+    }
+    return resources || (chars & IOS_SCN_MEM_DISCARDABLE);
+}
+
+/* The bytes of the image at `image` (mapped, RVA == offset; image_size its
+ * SizeOfImage) a pool copy needs: the end of its last section that code may
+ * reach, rounded up to `page` and at most image_size. The sections left out
+ * are the trailing ones no code reaches (ios_copy_extent_unreached), with
+ * nothing after them but each other: a builtin's .rsrc and .reloc. Returns
+ * image_size when none is left out or the headers cannot be read (only PE32+
+ * images are trimmed). */
+static inline size_t ios_copy_extent( const unsigned char *image, size_t image_size, size_t page )
+{
+    uint32_t lfanew, ndirs, cut, kept_end;
+    uint16_t nsec, optsz;
+    const unsigned char *opt, *dirs, *secs;
+    unsigned int i;
+    size_t extent;
+
+    if (!image || image_size < 0x40 || image[0] != 'M' || image[1] != 'Z') return image_size;
+    lfanew = ios_copy_extent_u32( image + 0x3c );
+    if ((size_t)lfanew + 24 + 112 > image_size) return image_size;
+    if (memcmp( image + lfanew, "PE\0\0", 4 )) return image_size;
+    nsec = ios_copy_extent_u16( image + lfanew + 6 );
+    optsz = ios_copy_extent_u16( image + lfanew + 20 );
+    opt = image + lfanew + 24;
+    if (ios_copy_extent_u16( opt ) != 0x20b || optsz < 112) return image_size;
+    if ((size_t)lfanew + 24 + optsz + (size_t)nsec * 40 > image_size) return image_size;
+    ndirs = ios_copy_extent_u32( opt + 108 );
+    if (ndirs > 16) ndirs = 16;
+    if (112 + ndirs * 8 > optsz) ndirs = (optsz - 112) / 8;
+    dirs = opt + 112;
+    secs = opt + optsz;
+
+    /* walk back from the highest section while each one is unreached */
+    cut = (uint32_t)image_size;
+    for (;;)
+    {
+        const unsigned char *last = NULL;
+        for (i = 0; i < nsec; i++)
+        {
+            uint32_t start = ios_copy_extent_u32( secs + i * 40 + 12 );
+            if (start < cut && (!last || start > ios_copy_extent_u32( last + 12 ))) last = secs + i * 40;
+        }
+        if (!last || !ios_copy_extent_unreached( last, dirs, ndirs )) break;
+        cut = ios_copy_extent_u32( last + 12 );
+    }
+    if (cut >= image_size) return image_size;
+
+    kept_end = ios_copy_extent_u32( opt + 60 );   /* SizeOfHeaders */
+    for (i = 0; i < nsec; i++)
+    {
+        const unsigned char *sec = secs + i * 40;
+        uint32_t start = ios_copy_extent_u32( sec + 12 );
+        uint32_t vsize = ios_copy_extent_u32( sec + 8 );
+        uint32_t end = start + (vsize ? vsize : ios_copy_extent_u32( sec + 16 ));
+        if (start < cut && end > kept_end) kept_end = end;
+    }
+    if (kept_end > cut) return image_size;   /* a kept section overlaps a left-out one */
+    extent = ((size_t)kept_end + page - 1) & ~(page - 1);
+    return extent < image_size ? extent : image_size;
+}
+#endif
