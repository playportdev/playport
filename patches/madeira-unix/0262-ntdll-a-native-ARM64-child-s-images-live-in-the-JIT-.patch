 /* Reverse-translate a JIT pool address back to the original PE address.
  * Used when PE code passes ADRP-computed addresses to syscalls. */
+/* Playport (PLA-514, decision 0176): in a native ARM64 child the JIT-pool copy
+ * of an image IS the image. virtual_map_image hands out the copy's address as
+ * the module's base, so the PEB, the loader's module list, the unwinder and
+ * every RVA the program computes from its own code agree; the PE view stays as
+ * Wine's view and the server's, a backing store the guest is never told of.
+ * An address of a presented copy is turned into the view's for the virtual
+ * memory calls (ios_jit_reverse_translate_addr) and back for what they return. */
+void *ios_jit_present_image( void *pe_base )
+{
+    int i;
+    for (i = 0; i < ios_jit_mapping_count; i++)
+    {
+        struct ios_jit_mapping *m = &ios_jit_mappings[i];
+        IMAGE_DOS_HEADER *dos;
+        IMAGE_NT_HEADERS64 *nt;
+
+        if (m->pe_base != pe_base || !m->size) continue;
+        /* ntdll stays on its view: the unix side writes its dispatcher slots
+         * there and syncs them into the copy (ios_jit_sync_write). */
+        if (!strcmp( ios_pe_module_name( m->pe_base, m->image_size ), "ntdll.dll" )) return NULL;
+        if (m->size < m->image_size) return NULL;   /* a partial copy cannot be the image */
+        dos = (IMAGE_DOS_HEADER *)((char *)ios_jit_rw_base_global + ((char *)m->jit_base - (char *)ios_jit_rx_base_global));
+        if (dos->e_magic != IMAGE_DOS_SIGNATURE) return NULL;
+        nt = (IMAGE_NT_HEADERS64 *)((char *)dos + dos->e_lfanew);
+        if (nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+            nt->OptionalHeader.ImageBase = (ULONG_PTR)m->jit_base;   /* as Windows rebases it */
+        m->presented = 1;
+        dprintf( 2, "[native-image] %s: view %p, the image is its pool copy %p+0x%lx\n",
+                 ios_pe_module_name( m->pe_base, m->image_size ), m->pe_base, m->jit_base,
+                 (unsigned long)m->image_size );
+        return m->jit_base;
+    }
+    return NULL;
+}
+
+/* The presented copy holding addr, or NULL; *pe gets addr's place in the view. */
+static struct ios_jit_mapping *ios_jit_presented_at( const void *addr, uintptr_t *pe )
+{
+    int i;
+    for (i = 0; i < ios_jit_mapping_count; i++)
+    {
+        uintptr_t a = (uintptr_t)addr, jb = (uintptr_t)ios_jit_mappings[i].jit_base;
+        if (!ios_jit_mappings[i].presented || a < jb || a >= jb + ios_jit_mappings[i].size) continue;
+        if (pe) *pe = (uintptr_t)ios_jit_mappings[i].pe_base + (a - jb);
+        return &ios_jit_mappings[i];
+    }
+    return NULL;
+}
+
+/* A view address of a presented image as the guest knows it (its copy's). */
+static void *ios_jit_presented_addr( const struct ios_jit_mapping *m, const void *view_addr )
+{
+    uintptr_t a = (uintptr_t)view_addr, pb = (uintptr_t)m->pe_base;
+    if (a < pb || a > pb + m->image_size) return (void *)view_addr;
+    return (char *)m->jit_base + (a - pb);
+}
+
+/* 1 when pc is in a presented copy: its own address is the guest's. */
+int ios_jit_is_presented( const void *pc )
+{
+    return ios_jit_presented_at( pc, NULL ) != NULL;
+}
+
+/* The PE-side ntdll's xlate_ios_jit_rev: the unwinder and the resource
+ * lookup turn a copy's address into its image's. A presented copy is its
+ * image (decision 0176), so its addresses stay. */
+void *ios_jit_guest_reverse_translate_addr(const void *addr)
+{
+    extern void *ios_jit_reverse_translate_addr(const void *addr);
+    if (ios_jit_presented_at( addr, NULL )) return (void *)addr;
+    return ios_jit_reverse_translate_addr( addr );
+}
