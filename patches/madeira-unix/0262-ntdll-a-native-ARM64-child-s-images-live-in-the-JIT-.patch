+                status = get_basic_memory_info( process, addr, buffer, len, res_len );
+                if (!status && len >= sizeof(MEMORY_BASIC_INFORMATION))
+                {
+                    MEMORY_BASIC_INFORMATION *mbi = buffer;
+                    mbi->BaseAddress = ios_jit_presented_addr( ios_query_pm, mbi->BaseAddress );
+                    mbi->AllocationBase = ios_jit_presented_addr( ios_query_pm, mbi->AllocationBase );
+                }
+                return status;
+            }
+#endif
             return get_basic_memory_info( process, addr, buffer, len, res_len );
 
         case MemoryWorkingSetExInformation:
@@ -24861,6 +24965,18 @@ NTSTATUS WINAPI NtQueryVirtualMemory( HANDLE process, LPCVOID addr,
             return get_memory_region_info( process, addr, buffer, len, res_len );
 
         case MemoryImageInformation:
+#ifdef WINE_IOS
+            if (ios_query_pm)
+            {
+                status = get_memory_image_info( process, addr, buffer, len, res_len );
+                if (!status && len >= sizeof(MEMORY_IMAGE_INFORMATION))
+                {
+                    MEMORY_IMAGE_INFORMATION *mii = buffer;
+                    mii->ImageBase = ios_jit_presented_addr( ios_query_pm, mii->ImageBase );
+                }
+                return status;
+            }
+#endif
             return get_memory_image_info( process, addr, buffer, len, res_len );
 
         case MemoryWineLoadUnixLib:
@@ -25214,6 +25330,10 @@ static NTSTATUS unmap_view_of_section( HANDLE process, PVOID addr, ULONG flags )
     NTSTATUS window_status;
 
     if (ios_wow64_route_unmap( process, addr, flags, &window_status )) return window_status;
+    {   /* Playport (PLA-514, decision 0176): a presented image is unmapped by its copy's address */
+        uintptr_t pe;
+        if (process == NtCurrentProcess() && ios_jit_presented_at( addr, &pe )) addr = (void *)pe;
+    }
     if (process != NtCurrentProcess())
     {
         union apc_call call;
