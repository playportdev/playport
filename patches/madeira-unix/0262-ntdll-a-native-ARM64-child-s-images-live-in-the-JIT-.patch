+            if (pm) *addr_ptr = ios_jit_presented_addr( pm, base );
+        }
+#endif
 
 #ifdef WINE_IOS
         /* (Previously: also called mprotect_exec on the JIT-pool RX side
@@ -23977,6 +24064,9 @@ NTSTATUS WINAPI NtProtectVirtualMemory( HANDLE process, PVOID *addr_ptr, SIZE_T
 
                 if (rgn_start >= pe_start && rgn_end <= pe_end)
