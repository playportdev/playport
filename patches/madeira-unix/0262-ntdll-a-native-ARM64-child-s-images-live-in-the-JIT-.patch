-                *p_xlate_rev = (void *)ios_jit_reverse_translate_addr;
+                *p_xlate_rev = (void *)ios_jit_guest_reverse_translate_addr;
                 ios_jit_sync_write( p_xlate_rev, sizeof(void*) );
                 dprintf( 2, "[ec-child-ntdll] XLATE-REV installed at %p = %p\n",
                          p_xlate_rev, (void *)ios_jit_reverse_translate_addr );
