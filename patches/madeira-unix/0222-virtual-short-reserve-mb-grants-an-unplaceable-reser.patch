From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Tue, 27 Oct 2026 18:00:06 +0100
Subject: [PATCH] virtual: short-reserve-mb grants an unplaceable reservation a
 real prefix

The Witcher 3's 4.x build reserves 16, 64 and 32 GiB of address space at
start (red::memory's pools, MEM_RESERVE only, PAGE_READONLY, unhinted)
and bumps a commit cursor up from each base. The usable window of this
task's 512 GiB is 64 GiB, so the 64 and 32 GiB asks found no gap
(`[mmap-place] ml1027 NO GAP FITS`), the game's pools kept an empty
range, and its first allocation from one ended in its own
PoolOOMHandlerBreak 1.48 s in.

With madeira.cfg short-reserve-mb = N, an unhinted reserve-only ask
larger than N MiB that the kernel pick, the cage and the jumbo hold
could not place gets a view of N MiB plus a 256 MiB guard, and the
caller is told it got its full size (pp_short_reserve.h). The view goes
top-down above the guest window and below FEX's band when it fits there:
the game's free finds a pointer's pool by address range, the earlier
pool first, so each later grant must sit below the earlier ones, whose
claims then never cover it. Placed bottom-up, the 32 GiB grant sat
inside the 64 GiB grant's claim and a block of it was freed into the
64 GiB pool's free lists, a NULL unlink 6 s in.

The first short grant releases an untaken jumbo hold: the hold serves one
ask of its own size, which a title needing short grants has not made
(everyGame's 8,960 MB hold is RDR2's), and the grants then go top-down
from the same ceiling. A title whose hold serves its asks, as The Witcher
3's classic 1.32 branch's 32 GB hold does, never reaches a short grant
and keeps it.

A commit is matched to the grant whose own view holds it first, then to
a claim that covers it. Within the real part it is served; in the guard,
or in a claim where no view is, it returns STATUS_NO_MEMORY, a full
pool's failure; another view's commit inside a claim is that view's and
is counted. `[short-reserve]` logs every grant and the first commits,
refusals and foreign commits. Without the key nothing changes.

Linear: PLA-452
Class: feature
Evidence: docs/evidence/2026-10-27-witcher3-short-reserve.md
Offered-upstream: no; the address-space layout is the iOS port's
---
 build/ntdll-unix/pp_short_reserve.h |  50 +++++++++++
 build/ntdll-unix/virtual_ios.c      | 130 ++++++++++++++++++++++++++++
 2 files changed, 180 insertions(+)
 create mode 100644 build/ntdll-unix/pp_short_reserve.h

diff --git a/build/ntdll-unix/pp_short_reserve.h b/build/ntdll-unix/pp_short_reserve.h
new file mode 100644
index 0000000..ad8c7be
--- /dev/null
+++ b/build/ntdll-unix/pp_short_reserve.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Short reservations (Playport, PLA-452).
+ *
+ * The Witcher 3's 4.x build reserves 16, 64 and 32 GiB of address space at
+ * start (red::memory's pools, MEM_RESERVE only) and bumps a commit cursor up
+ * from each base. This task's VA is 512 GiB, of which the usable window is
+ * 64 GiB, so the 64 and 32 GiB asks cannot be placed and the game dies in its
+ * own out-of-memory handler at its first allocation from them.
+ *
+ * With madeira.cfg short-reserve-mb = N, an unhinted reserve-only ask larger
+ * than N MiB that nothing else can place is granted N MiB of real view plus a
+ * guard, and the caller is told it got its full size. A commit that reaches
+ * past the real part, into the guard or the claimed tail, is refused with
+ * STATUS_NO_MEMORY: a bump cursor's first overrun lands in the guard, so the
+ * game fails the way a full pool fails on Windows, never in another view.
+ *
+ * Pure, so a host test compiles this header as is. */
+#ifndef PP_SHORT_RESERVE_H
+#define PP_SHORT_RESERVE_H
+#include <stdint.h>
+
+/* The guard above the real part: no commit there is served. */
+#define PPSR_GUARD (256ull << 20)
+
+/* The real size for an ask of `ask` bytes under short-reserve-mb = cfg_mb:
+ * 0 (no short grant) when the key is off or the ask fits in it, else the cap
+ * rounded down to the 64 KiB allocation granularity. */
+static inline uint64_t ppsr_real_size( uint64_t ask, long long cfg_mb )
+{
+    uint64_t cap;
+
+    if (cfg_mb <= 0) return 0;
+    cap = ((uint64_t)cfg_mb << 20) & ~0xffffull;
+    if (!cap || ask <= cap + PPSR_GUARD) return 0;
+    return cap;
+}
+
+/* Whether a commit of [addr, addr + size) reaches past the real part of a
+ * short grant at base (real bytes backed, claimed bytes promised). */
+static inline int ppsr_commit_overruns( uint64_t base, uint64_t real, uint64_t claimed,
+                                        uint64_t addr, uint64_t size )
+{
+    uint64_t end = addr + (size ? size : 1);
+
+    if (end < addr) return 1;                         /* wraps: never ours to serve */
+    if (addr >= base + claimed || end <= base) return 0;   /* outside the claim */
+    return end > base + real;
+}
+
+#endif
diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index e72b45d..aaa1b19 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -1470,6 +1470,13 @@ static void ios_pool_owner_search( const uint64_t *wanted, unsigned nwanted )
 static struct { uint64_t base, size, committed; unsigned commits, collisions; unsigned cage; } ios_soft[IOS_SOFT_MAX];
 static unsigned ios_soft_n;
 
+/* Playport (PLA-452): short grants, see pp_short_reserve.h. The view is
+ * real + PPSR_GUARD bytes at base; the caller was promised claimed bytes. */
+#include "pp_short_reserve.h"
+#define IOS_SHORT_MAX 8
+static struct { uint64_t base, real, claimed, committed, high; unsigned commits, refused, foreign; } ios_short[IOS_SHORT_MAX];
+static unsigned ios_short_n;
+
 /* ml433 (#72): the V8/cppgc cage holdback.
  *
  * Single-process CEF means exactly ONE process-wide cppgc/V8 cage: an 8GB
@@ -20734,6 +20741,71 @@ NTSTATUS WINAPI NtAllocateVirtualMemory( HANDLE process, PVOID *ret, ULONG_PTR z
          * would have been wasted work. */
         if ((type & MEM_COMMIT) && ios_bigres_cnt && *ret)
             ios_bigres_commit( *ret, *size_ptr );
+        /* Playport (PLA-452): a commit inside a short grant's claim. Claims
+         * overlap other views (each later grant sits below the earlier ones,
+         * see the grant), so the grant whose own view holds the address
+         * answers first. Within its real part a commit is served as usual; in
+         * its guard, or in a claim where no view is, it is refused as a full
+         * pool's would be. Another view's commit inside a claim is that
+         * view's: counted and served. */
+        if ((type & MEM_COMMIT) && ios_short_n && *ret)
+        {
+            uint64_t a = (uint64_t)(uintptr_t)*ret;
+            struct file_view *v = find_view( *ret, 0 );
+            unsigned i, pick = ios_short_n;
+
+            for (i = 0; i < ios_short_n && v; i++)
+                if ((uint64_t)(uintptr_t)v->base == ios_short[i].base) pick = i;
+            for (i = 0; i < ios_short_n && pick == ios_short_n; i++)
+            {
+                struct file_view *own = find_view( (void *)(uintptr_t)ios_short[i].base, 0 );
+                if (own && (uint64_t)(uintptr_t)own->base == ios_short[i].base
+                    && a >= ios_short[i].base && a < ios_short[i].base + ios_short[i].claimed)
+                    pick = i;
+            }
+            if (pick < ios_short_n)
+            {
+                uint64_t off = a - ios_short[pick].base;
+
+                i = pick;
+                if (v && (uint64_t)(uintptr_t)v->base != ios_short[i].base)
+                {
+                    if (ios_short[i].foreign++ < 8)
+                        dprintf( 2, "[short-reserve] commit 0x%llx+0x%lx in grant 0x%llx's claim at +%llu MB "
+                                    "belongs to view %p: served as that view's\n",
+                                 (unsigned long long)a, (unsigned long)*size_ptr,
+                                 (unsigned long long)ios_short[i].base,
+                                 (unsigned long long)(off >> 20), v->base );
+                }
+                else if (ppsr_commit_overruns( ios_short[i].base, ios_short[i].real, ios_short[i].claimed,
+                                               a, *size_ptr ))
+                {
+                    if (ios_short[i].refused++ < 16)
+                        dprintf( 2, "[short-reserve] REFUSED commit 0x%llx+0x%lx at +%llu MB of grant 0x%llx: "
+                                    "past its %llu MB real part (committed %llu MB in %u calls, high +%llu MB)\n",
+                                 (unsigned long long)a, (unsigned long)*size_ptr, (unsigned long long)(off >> 20),
+                                 (unsigned long long)ios_short[i].base,
+                                 (unsigned long long)(ios_short[i].real >> 20),
+                                 (unsigned long long)(ios_short[i].committed >> 20), ios_short[i].commits,
+                                 (unsigned long long)(ios_short[i].high >> 20) );
+                    return STATUS_NO_MEMORY;
+                }
+                else
+                {
+                    ios_short[i].commits++;
+                    ios_short[i].committed += *size_ptr;
+                    if (off + *size_ptr > ios_short[i].high) ios_short[i].high = off + *size_ptr;
+                    if (ios_short[i].commits <= 12 || !(ios_short[i].commits & 255))
+                        dprintf( 2, "[short-reserve] commit #%u 0x%llx+0x%lx at +%llu MB of grant 0x%llx "
+                                    "(committed %llu MB, high +%llu MB of %llu MB real)\n",
+                                 ios_short[i].commits, (unsigned long long)a, (unsigned long)*size_ptr,
+                                 (unsigned long long)(off >> 20), (unsigned long long)ios_short[i].base,
+                                 (unsigned long long)(ios_short[i].committed >> 20),
+                                 (unsigned long long)(ios_short[i].high >> 20),
+                                 (unsigned long long)(ios_short[i].real >> 20) );
+                }
+            }
+        }
         /* ml151: a commit landing in a SOFT pool range — see ios_soft. The range
          * was never backed, so materialise exactly this sub-range now. Check the
          * kernel map first: if something already owns the VA (furniture, most
@@ -21061,6 +21133,64 @@ NTSTATUS WINAPI NtAllocateVirtualMemory( HANDLE process, PVOID *ret, ULONG_PTR z
                     ios_bigres_report( "jumbo reserve failed" );
                     ios_soft_report( "jumbo reserve failed" );
                 }
+                /* Playport (PLA-452): madeira.cfg short-reserve-mb = N grants
+                 * N MiB of real view plus a guard and reports the full size;
+                 * commits past the real part are refused above. Above the
+                 * guest window first, below FEX's band, then anywhere, and
+                 * top-down: The Witcher 3's free finds a pointer's pool by
+                 * address range, the earlier pool first, so each later grant
+                 * goes below the earlier ones, whose claims then never cover
+                 * it. Placed bottom-up, its 32 GiB grant sat inside the 64 GiB
+                 * one's claim and its blocks were freed into the wrong pool. */
+                if (!(type & MEM_COMMIT) && ios_short_n < IOS_SHORT_MAX)
+                {
+                    uint64_t real = ppsr_real_size( *size_ptr, madeira_cfg_int( "short-reserve-mb", 0 ) );
+
+                    if (real && ios_jumbo_hold_size)
+                    {
+                        /* The jumbo hold serves one ask of its size, which this
+                         * title has not made: a title that needs short grants
+                         * gets nothing from it (everyGame's 8,960 MB hold is
+                         * RDR2's size). Release it before the first grant, so
+                         * the grants go top-down from the same ceiling and each
+                         * later one still lands below the earlier ones. */
+                        dprintf( 2, "[short-reserve] releasing the untaken jumbo hold 0x%llx +%llu MB "
+                                    "before the first short grant\n",
+                                 (unsigned long long)ios_jumbo_hold_base,
+                                 (unsigned long long)ios_jumbo_hold_size >> 20 );
+                        munmap( (void *)ios_jumbo_hold_base, ios_jumbo_hold_size );
+                        ios_jumbo_hold_base = 0;
+                        ios_jumbo_hold_size = 0;
+                    }
+                    if (real)
+                    {
+                        void *p = NULL;
+                        SIZE_T psz = real + PPSR_GUARD;
+                        unsigned int st3 = allocate_virtual_memory( &p, &psz, type | MEM_TOP_DOWN, protect,
+                                                                    0x7400000000ULL, 0x7c00000000ULL, 0, 0 );
+                        if (st3)
+                        {
+                            p = NULL;
+                            psz = real + PPSR_GUARD;
+                            st3 = allocate_virtual_memory( &p, &psz, type | MEM_TOP_DOWN, protect, 0, 0, 0, 0 );
+                        }
+                        dprintf( 2, "[short-reserve] ask 0x%lx (%lu MB): real %llu MB + %llu MB guard -> %p "
+                                    "st=0x%x; the caller is told it got the full size\n",
+                                 (unsigned long)*size_ptr, (unsigned long)(*size_ptr >> 20),
+                                 (unsigned long long)(real >> 20), (unsigned long long)(PPSR_GUARD >> 20),
+                                 p, st3 );
+                        if (!st3)
+                        {
+                            ios_short[ios_short_n].base = (uint64_t)(uintptr_t)p;
+                            ios_short[ios_short_n].real = real;
+                            ios_short[ios_short_n].claimed = *size_ptr;
+                            ios_short_n++;
+                            *ret = p;
+                            ios_jumbo_census( jumbo_hint, jumbo_size, p, 0 );
+                            return STATUS_SUCCESS;
+                        }
+                    }
+                }
             }
         }
         else
