@@ -4176,6 +4177,7 @@ int ios_jit_anon_alias_add(void *user_va, size_t size, void *jit_rw_alias)
     ios_jit_anon_aliases[idx].user_va_end = (uintptr_t)user_va + size;
     ios_jit_anon_aliases[idx].jit_rw_alias = (uintptr_t)jit_rw_alias;
     ios_jit_anon_aliases[idx].jit_rx_alias = 0;  /* set via _set_rx */
+    ios_jit_anon_aliases[idx].peb = ios_jit_current_peb();
     __sync_synchronize();
     /* ml648: retire the slot's previous occupant before it is overwritten, or a
      * stale guest_rx would keep resolving to an RW alias that no longer backs it. */
@@ -4345,15 +4347,20 @@ static int ios_jit_anon_alias_free_slot_locked( int skip1, int skip2 )
  * the pages outside it as new entries, written before the old entry is retired,
  * so a lock-free reader always finds an entry that maps an address to the same
  * pool byte. With no slot for a remainder the entry is kept whole, as before.
- * The pool range is not returned. A MEM_DECOMMIT keeps its alias: the mapping
- * stays, and decommit_pages zeroes through it. virtual_mutex is held. */
+ * The pool range is not returned, but in a native ARM64 child (PLA-514): there
+ * an entry retired whole gives its range back (ios_pool_return_anon_locked).
+ * A MEM_DECOMMIT keeps its alias: the mapping stays, and decommit_pages zeroes
+ * through it. virtual_mutex is held. */
+static void ios_pool_return_anon_locked( uintptr_t jit_rw_alias, size_t size, void *peb );
 static void ios_jit_anon_alias_release( const void *base, size_t size )
 {
+    extern int ios_is_native_arm64_cur(void);
     static unsigned int release_n;
     uintptr_t lo = (uintptr_t)base, hi = lo + size;
-    int i, n;
+    int i, n, native;
 
     if (!size) return;
+    native = ios_is_native_arm64_cur();
     pthread_mutex_lock( &ios_pool_lock );
     n = ios_jit_anon_alias_count;
     for (i = 0; i < n; i++)
@@ -4382,6 +4389,7 @@ static void ios_jit_anon_alias_release( const void *base, size_t size )
             e->user_va_end = keep_hi[p];
