             e->jit_rx_alias = old.jit_rx_alias ? old.jit_rx_alias + delta : 0;
+            e->peb = old.peb;
             __sync_synchronize();
             e->user_va = keep_lo[p];
             ios_mono_alias_publish( keep_lo[p], e->jit_rw_alias, keep_hi[p] - keep_lo[p] );
@@ -4395,10 +4403,25 @@ static void ios_jit_anon_alias_release( const void *base, size_t size )
             dprintf( 2, "[jit-alias] PLA-205 release #%u %p+0x%lx: entry %d %p..%p rw=%p retired, "
                         "%d remainder(s) kept\n", release_n, base, (unsigned long)size, i,
                      (void *)old.user_va, (void *)old.user_va_end, (void *)old.jit_rw_alias, pieces );
+        if (native && !pieces) ios_pool_return_anon_locked( old.jit_rw_alias, old.user_va_end - old.user_va, old.peb );
     }
     pthread_mutex_unlock( &ios_pool_lock );
 }
 
+/* Playport (PLA-514): the bytes of the live anonymous JIT aliases peb allocated. */
+static size_t ios_jit_anon_bytes_of( void *peb )
+{
+    size_t held = 0;
+    int i;
+
+    pthread_mutex_lock( &ios_pool_lock );
+    for (i = 0; i < ios_jit_anon_alias_count; i++)
+        if (ios_jit_anon_aliases[i].user_va && ios_jit_anon_aliases[i].peb == peb)
+            held += ios_jit_anon_aliases[i].user_va_end - ios_jit_anon_aliases[i].user_va;
+    pthread_mutex_unlock( &ios_pool_lock );
+    return held;
+}
