-        else dprintf(2, "[jit-pool] freelist FULL — leaking range off=0x%lx size=0x%lx\n",
-                     (unsigned long)off, (unsigned long)size);
 
         /* Remove ledger entry (swap-with-last). */
         ios_pool_ledger[i] = ios_pool_ledger[--ios_pool_ledger_count];
@@ -11541,6 +11603,28 @@ static inline int mprotect_exec( void *base, size_t size, int unix_prot )
                     }
                 }
 
+                /* Playport (PLA-514): a native ARM64 child's anonymous executable
+                 * memory is held to a quarter of the pool. Past it the child's
