 uintptr_t ios_jit_anon_alias_lookup(uintptr_t fault_addr)
 {
     int n = ios_jit_anon_alias_count;
@@ -9286,6 +9309,71 @@ int ios_jit_mark_ec_range( const void *addr, size_t size )
  * would make arm64x_check_call BL into x86-64 bytes as if ARM64). */
 static void clear_arm64ec_range( const void *addr, size_t size );
 
+/* Put pool range [off, off + size) on the free list, reusable after
+ * IOS_POOL_REUSE_GRACE_SEC. Returns 0 when the list is full and the range is
+ * leaked. ios_pool_lock is held. */
+static int ios_pool_freelist_add_locked( size_t off, size_t size, int poisoned )
+{
+    /* PLA-213: a full list gives up a poisoned range, which an image may
+     * never fit, rather than this one (a poisoned range was dropped before) */
+    if (ios_pool_free_count == IOS_POOL_FREE_MAX)
+    {
+        int k;
+        for (k = 0; k < ios_pool_free_count; k++)
+            if (ios_pool_freelist[k].poisoned)
+            {
+                dprintf(2, "[jit-pool] freelist FULL — dropped poisoned range off=0x%lx size=0x%lx for a new one\n",
+                        (unsigned long)ios_pool_freelist[k].off, (unsigned long)ios_pool_freelist[k].size);
+                ios_pool_freelist[k] = ios_pool_freelist[--ios_pool_free_count];
+                break;
+            }
+    }
+    if (ios_pool_free_count == IOS_POOL_FREE_MAX)
+    {
+        dprintf(2, "[jit-pool] freelist FULL — leaking range off=0x%lx size=0x%lx\n",
+                (unsigned long)off, (unsigned long)size);
+        return 0;
+    }
+    ios_pool_freelist[ios_pool_free_count].poisoned = poisoned;
+    ios_pool_freelist[ios_pool_free_count].off = off;
+    ios_pool_freelist[ios_pool_free_count].size = size;
+    ios_pool_freelist[ios_pool_free_count].freed_at = time( NULL );
+    /* Physical pages returned post-grace by the allocator's MADV_FREE sweep
+     * (not here — laggard exit threads may still execute this range during
+     * the grace window, and a purged page reads zero). */
+    ios_pool_freelist[ios_pool_free_count].advised = 0;
+    ios_pool_free_count++;
+    return 1;
+}
+
+/* Playport (PLA-514): a native ARM64 child's anonymous executable memory gives
+ * its pool range back when it is freed (ios_jit_anon_alias_release), as an
+ * exiting process does (ios_jit_reclaim_process_bytes). World of Warcraft's
+ * client allocated 1.3 MB of PAGE_EXECUTE_READWRITE memory 525 times, each a
+ * new range, until the pool was exhausted. Only a range still recorded whole
+ * for the pseudo-process that allocated it is listed; one of an alias split
+ * by a partial free stays with its process until it exits.
+ * ios_pool_lock is held. */
+static void ios_pool_return_anon_locked( uintptr_t jit_rw_alias, size_t size, void *peb )
+{
+    static unsigned int returned_n;
+    size_t off = jit_rw_alias - (uintptr_t)ios_jit_rw_base_global;
+    unsigned int cur = 0, max = 0;
+    int i, poisoned;
+
+    for (i = 0; i < ios_pool_ledger_count; i++)
+        if (ios_pool_ledger[i].off == off && ios_pool_ledger[i].size == size && ios_pool_ledger[i].peb == peb) break;
+    if (i == ios_pool_ledger_count) return;
+    if (arm64ec_view) clear_arm64ec_range( (char *)ios_jit_rx_base_global + off, size );
+    poisoned = !ios_pool_range_execable( off, size, &cur, &max );
+    if (!ios_pool_freelist_add_locked( off, size, poisoned )) return;
+    ios_pool_ledger[i] = ios_pool_ledger[--ios_pool_ledger_count];
+    if (++returned_n <= 16 || !(returned_n % 256))
+        dprintf( 2, "[jit-pool] anon RWX freed: #%u off=0x%lx size=0x%lx back on the freelist (%d listed%s)\n",
+                 returned_n, (unsigned long)off, (unsigned long)size, ios_pool_free_count,
+                 poisoned ? ", poisoned" : "" );
+}
