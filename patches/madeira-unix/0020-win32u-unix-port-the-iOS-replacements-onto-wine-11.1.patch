+static UINT gcd( UINT a, UINT b )
+{
+    UINT r;
+
+    for (;;)
+    {
+        if (!a) return b;
+        if (!b) return a;
+        r = a % b;
+        a = b;
+        b = r;
+    }
+}
+
+static struct ratio make_ratio( UINT num, UINT den )
+{
+    UINT d = gcd( num, den );
+    struct ratio r = { num / d, den / d };
+    assert( num / d < 65536 );
+    assert( den / d < 65536 );
+    return r;
+}
+
+static struct ratio min_ratio( struct ratio x, struct ratio y )
+{
+    return x.num * y.den <= y.num * x.den ? x : y;
+}
