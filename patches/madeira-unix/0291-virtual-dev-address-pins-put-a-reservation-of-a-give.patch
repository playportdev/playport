     ios_jumbo_hold_keep = (size_t)(madeira_cfg_int( "jumbo-keep-mb", 0 ) * 1024ll * 1024ll);
@@ -17647,11 +17700,17 @@ void virtual_init(void)
      * guest window for nothing: Death's Door filled the other 8 GB 14 s in
