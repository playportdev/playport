From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Sun, 18 Oct 2026 08:36:46 +0200
Subject: [PATCH] ntdll-unix: ignore attempts to set reserved CPSR bits (WineHQ
 7fb24b7)

A hand port of WineHQ 7fb24b7 "ntdll: Ignore attempts to set reserved
CPSR bits" (Jacek Caban, in wine-11.20; Valve f9a7e33) into the iOS
replacements of signal_arm64.c and thread.c. Windows code that sets a
context can no longer write the CPSR bits Windows reserves, and a signal
handler that returns to a context keeps the host's own bits (and its
SSBS bit) from the interrupted state:
- signal_arm64_ios.c: cpsr_host_mask; save_context reports only the
  user bits; restore_context and usr2_handler keep the host bits of the
  signal state; NtSetContextThread and set_thread_wow64_context (the ARM
  WoW64 frame) store only the user bits.
- thread_ios.c: context_to_server sends only the user bits, ARM and
  ARM64.
cpsr_user_mask (0xf620fc30) comes from wine-11.20's unix_private.h,
which the replacements include. The bits FEX's ARM64EC and WoW64 modules
read and write (NZCV, and bit 21 for the x86 trap flag) are user bits.
Not ported: save_syscall_entry_frame, which signal_arm64_ios.c does not
have (its usr1_handler does not build a syscall frame from the signal
state), and the ntdll exception test. wineserver's Mach capture
(mach_ios.c ios_fill_thread_context) still reports the thread's whole
CPSR, as before; upstream's equivalent there is save_context in the
suspended thread.

Class: madeira-port
Evidence: docs/evidence/2026-10-18-cpsr-reserved-bits.md
Offered-upstream: no
---
 build/ntdll-unix/signal_arm64_ios.c | 15 ++++++++++-----
 build/ntdll-unix/thread_ios.c       |  4 ++--
 2 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/build/ntdll-unix/signal_arm64_ios.c b/build/ntdll-unix/signal_arm64_ios.c
index 9546afb..c31db96 100644
--- a/build/ntdll-unix/signal_arm64_ios.c
+++ b/build/ntdll-unix/signal_arm64_ios.c
@@ -6284,6 +6284,11 @@ static void ios_setup_mach_exception_handler( thread_t pe_thread, uintptr_t teb,
 #define ESR_ELx_ISS_DFSC(esr)           ((esr) & 0x3f)
 #define ESR_ELx_ISS_DFSC_ALIGN_FAULT    0x21
 
+/* Preserve all CPSR bits not covered by user context in signal handlers.
+ * Additionally, preserve the host SSBS bit, which is allowed to be set on
+ * Windows, but is volatile and restored on kernel transition anyway. */
+static const ULONG cpsr_host_mask = ~cpsr_user_mask | 0x1000;
+
 /***********************************************************************
  *           context_init_empty_xstate
  *
@@ -6385,7 +6390,7 @@ static void save_context( CONTEXT *context, const ucontext_t *sigcontext )
     context->Lr   = LR_sig(sigcontext);     /* Link register */
     context->Sp   = SP_sig(sigcontext);     /* Stack pointer */
     context->Pc   = PC_sig(sigcontext);     /* Program Counter */
-    context->Cpsr = PSTATE_sig(sigcontext); /* Current State Register */
+    context->Cpsr = PSTATE_sig(sigcontext) & cpsr_user_mask; /* Current State Register */
     for (i = 0; i <= 28; i++) context->X[i] = REGn_sig( i, sigcontext );
     if (save_fpu( context->V, &context->Fpcr, &context->Fpsr, sigcontext ))
         context->ContextFlags |= CONTEXT_FLOATING_POINT;
@@ -6419,7 +6424,7 @@ static void restore_context( struct thread_data *data, const CONTEXT *context, u
 
     FP_sig(sigcontext)     = context->Fp;   /* Frame pointer */
     LR_sig(sigcontext)     = context->Lr;   /* Link register */
-    PSTATE_sig(sigcontext) = context->Cpsr; /* Current State Register */
+    PSTATE_sig(sigcontext) = (PSTATE_sig(sigcontext) & cpsr_host_mask) | (context->Cpsr & ~cpsr_host_mask);
     for (i = 0; i <= 28; i++) REGn_sig( i, sigcontext ) = context->X[i];
     restore_fpu( context, sigcontext );
 }
@@ -6801,7 +6806,7 @@ NTSTATUS WINAPI NtSetContextThread( HANDLE handle, const CONTEXT *context )
         frame->lr    = context->Lr;
         frame->sp    = context->Sp;
         frame->pc    = context->Pc;
-        frame->cpsr  = context->Cpsr;
+        frame->cpsr  = context->Cpsr & cpsr_user_mask;
         if (is_emulated_code( frame->pc )) flags |= RESTORE_FLAGS_EMULATION;
         else frame->restore_flags &= ~RESTORE_FLAGS_EMULATION;
     }
@@ -6982,7 +6987,7 @@ NTSTATUS set_thread_wow64_context( HANDLE handle, const void *ctx, ULONG size )
             wow_frame->Sp = context->Sp;
             wow_frame->Lr = context->Lr;
             wow_frame->Pc = context->Pc & ~1;
-            wow_frame->Cpsr = context->Cpsr;
+            wow_frame->Cpsr = context->Cpsr & cpsr_user_mask;
             if (context->Cpsr & 0x20) wow_frame->Pc |= 1; /* thumb */
         }
         if (flags & CONTEXT_FLOATING_POINT)
@@ -13719,7 +13724,7 @@ static void usr2_handler( int signal, siginfo_t *siginfo, void *sigcontext )
     }
     FP_sig(context)     = frame->fp;
     LR_sig(context)     = frame->lr;
-    PSTATE_sig(context) = frame->cpsr;
+    PSTATE_sig(context) = (PSTATE_sig(context) & cpsr_host_mask) | frame->cpsr;
     for (i = 0; i <= 28; i++) REGn_sig( i, context ) = frame->x[i];
 
 #ifdef linux
diff --git a/build/ntdll-unix/thread_ios.c b/build/ntdll-unix/thread_ios.c
index 2b9a7b6..4dc9f49 100644
--- a/build/ntdll-unix/thread_ios.c
+++ b/build/ntdll-unix/thread_ios.c
@@ -549,7 +549,7 @@ static NTSTATUS context_to_server( struct context_data *to, USHORT to_machine, c
             to->ctl.arm_regs.sp   = from->Sp;
             to->ctl.arm_regs.lr   = from->Lr;
             to->ctl.arm_regs.pc   = from->Pc;
-            to->ctl.arm_regs.cpsr = from->Cpsr;
+            to->ctl.arm_regs.cpsr = from->Cpsr & cpsr_user_mask;
         }
         if (flags & CONTEXT_ARM_INTEGER)
         {
@@ -598,7 +598,7 @@ static NTSTATUS context_to_server( struct context_data *to, USHORT to_machine, c
             to->integer.arm64_regs.x19[11] = from->Lr;
             to->ctl.arm64_regs.sp     = from->Sp;
             to->ctl.arm64_regs.pc     = from->Pc;
-            to->ctl.arm64_regs.pstate = from->Cpsr;
+            to->ctl.arm64_regs.pstate = from->Cpsr & cpsr_user_mask;
         }
         if (flags & CONTEXT_ARM64_INTEGER)
         {
