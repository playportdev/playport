diff --git a/build/ntdll-unix/audio_wow64_buffer.h b/build/ntdll-unix/audio_wow64_buffer.h
new file mode 100644
index 0000000..0aacb4b
--- /dev/null
+++ b/build/ntdll-unix/audio_wow64_buffer.h
@@ -0,0 +1,52 @@
+/* Window-backed render scratch; included after struct ios_stream.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef IOS_AUDIO_WOW64_BUFFER_H
+#define IOS_AUDIO_WOW64_BUFFER_H
+extern uintptr_t ios_wow64_current_base(void);
+extern void *ios_jit_current_peb(void);
+extern NTSTATUS ios_wow64_audio_alloc(void *owner, uintptr_t window, size_t size, void **host);
+extern NTSTATUS ios_wow64_audio_free(void *owner, uintptr_t window, void *host);
+
+static int ios_audio_scratch_resize(struct ios_stream *s, UINT32 frames)
+{
+    size_t bytes;
+    BYTE *next;
+    if (!frames || !s->frame_bytes || frames > SIZE_MAX / s->frame_bytes) return 0;
+    bytes = (size_t)frames * s->frame_bytes;
+    if (!s->wow64_window)
+    {
+        next = realloc(s->render_scratch, bytes);
+        if (!next) return 0;
+    }
+    else
+    {
+        void *host = NULL;
+        if (ios_wow64_audio_alloc(s->wow64_owner, s->wow64_window, bytes, &host)) return 0;
+        next = host;
+        if (s->render_scratch)
+        {
+            size_t old = (size_t)s->scratch_frames * s->frame_bytes;
+            memcpy(next, s->render_scratch, old < bytes ? old : bytes);
+            if (ios_wow64_audio_free(s->wow64_owner, s->wow64_window, s->render_scratch))
+            {
+                ios_wow64_audio_free(s->wow64_owner, s->wow64_window, next);
+                return 0;
+            }
+        }
+    }
+    s->render_scratch = next;
+    s->scratch_frames = frames;
+    return 1;
+}
+
+static void ios_audio_scratch_free(struct ios_stream *s)
+{
+    if (!s->render_scratch) return;
+    if (s->wow64_window)
+        ios_wow64_audio_free(s->wow64_owner, s->wow64_window, s->render_scratch);
+    else free(s->render_scratch);
+    s->render_scratch = NULL;
+    s->scratch_frames = 0;
+}
+#endif
diff --git a/build/ntdll-unix/audio_wow64_ios.h b/build/ntdll-unix/audio_wow64_ios.h
new file mode 100644
index 0000000..4487d79
--- /dev/null
+++ b/build/ntdll-unix/audio_wow64_ios.h
@@ -0,0 +1,659 @@
+/* PE32 mmdevapi ABI for the static iOS driver.
+ * Layouts mirror mmdevapi/unixlib.h and winecoreaudio's WoW64 wrappers.
+ * stream_handle is an opaque UINT64; event is a HANDLE, not a pointer.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef IOS_AUDIO_WOW64_H
+#define IOS_AUDIO_WOW64_H
+#include <stddef.h>
+#define IOS_AUDIO_E_INVALIDARG ((HRESULT)0x80070057u)
+#define IOS_AUDIO_E_NOTIMPL ((HRESULT)0x80004001u)
+#define IOS_AUDIO_STATUS_INVALID_PARAMETER ((NTSTATUS)0xc000000du)
+
+static int ios_audio_guest_range(uintptr_t base, uint32_t guest, size_t bytes)
+{
+    return base > UINT32_MAX && base <= UINTPTR_MAX - UINT64_C(0x100000000) &&
+           guest >= 0x10000 && bytes <= UINT64_C(0x100000000) - guest;
+}
+
+static void *ios_audio_to_host(uintptr_t base, uint32_t guest)
+{
+    return guest ? (void *)(base + guest) : NULL;
+}
+
+static int ios_audio_to_guest(uintptr_t base, const void *host, size_t bytes, uint32_t *guest)
+{
+    uintptr_t value = (uintptr_t)host;
+    if (!host) { *guest = 0; return 1; }
+    if (value < base || value - base > UINT32_MAX ||
+        !ios_audio_guest_range(base, (uint32_t)(value - base), bytes)) return 0;
+    *guest = value - base;
+    return 1;
+}
+
+static int ios_audio_stream_owned(stream_handle handle)
+{
+    struct ios_stream *s = stream_from_handle(handle);
+    return s && s->wow64_window && s->wow64_window == ios_wow64_current_base() &&
+           s->wow64_owner == ios_jit_current_peb();
+}
+
+/* Existing native detach cannot join a dying owner's timer thread. Retain
+ * host stream/ring state as it does, but unpublish from RemoteIO before the
+ * window view is released. The timer never reads render_scratch. On final
+ * window retirement this runs under the windows lock: do NOT call VM helpers.
+ * All Wine secondary threads have been reclaimed by that point. */
+static void ios_audio_wow64_detach(uintptr_t window, int deleting_views)
+{
+    int i;
+    if (!window) return;
+    for (i = 0; i < IOS_MAX_STREAMS; i++)
+    {
+        struct ios_stream *s;
+        pthread_mutex_lock(&g_streams_lock);
+        s = g_streams[i];
+        if (!s || s->wow64_window != window) s = NULL;
+        else g_streams[i] = NULL;
+        pthread_mutex_unlock(&g_streams_lock);
+        if (!s) continue;
+        s->valid = 0;
+        s->started = 0;
+        ios_dev_detach(s); /* unpublish; RT reads ring, never window scratch */
+        if (!deleting_views) ios_audio_scratch_free(s);
+        else { s->render_scratch = NULL; s->scratch_frames = 0; }
+    }
+    ios_dev_stop_if_idle();
+}
+
+void audio_null_ios_wow64_retire(uintptr_t window)
+{
+    ios_audio_wow64_detach(window, 1);
+}
+
+static NTSTATUS ios_wow64_process_detach(void *args)
+{
+    (void)args;
+    ios_audio_wow64_detach(ios_wow64_current_base(), 0);
+    return STATUS_SUCCESS;
+}
+
+#define IOS_AUDIO_PTR(field, bytes) do { \
+    if (p->field && !ios_audio_guest_range(base, p->field, bytes)) { \
+        p->result = IOS_AUDIO_E_INVALIDARG; return STATUS_SUCCESS; \
+    } \
+} while (0)
+#define IOS_AUDIO_OWNER() do { \
+    if (!ios_audio_stream_owned(p->stream)) { \
+        p->result = AUDCLNT_E_NOT_INITIALIZED; return STATUS_SUCCESS; \
+    } \
+} while (0)
+
+struct ios_audio_create_stream32 {
+    uint32_t name, device;
+    EDataFlow flow;
+    int share;
+    DWORD flags;
+    REFERENCE_TIME duration, period;
+    uint32_t fmt;
+    HRESULT result;
+    uint32_t channel_count, stream;
+};
+_Static_assert(offsetof(struct ios_audio_create_stream32, duration) == 24, "PE32 duration");
+_Static_assert(offsetof(struct ios_audio_create_stream32, fmt) == 40, "PE32 format");
+_Static_assert(sizeof(struct ios_audio_create_stream32) == 56, "PE32 create_stream");
+
+static NTSTATUS ios_wow64_create_stream(void *args)
+{
+    struct ios_audio_create_stream32 *p = args;
+    uintptr_t base = ios_wow64_current_base();
+    void *owner = ios_jit_current_peb();
+    stream_handle handle = 0;
+    UINT32 channels = 0;
+    struct create_stream_params n = {0};
+    struct ios_stream *s;
+    BYTE *old;
+    IOS_AUDIO_PTR(name, 128); /* native logging reads at most 64 WCHARs */
+    IOS_AUDIO_PTR(device, 1);
+    IOS_AUDIO_PTR(fmt, 18);
+    IOS_AUDIO_PTR(channel_count, sizeof(UINT32));
+    IOS_AUDIO_PTR(stream, sizeof(stream_handle));
+    if (!owner || !base || !p->fmt || !p->channel_count || !p->stream)
+    { p->result = IOS_AUDIO_E_INVALIDARG; return STATUS_SUCCESS; }
+    n.fmt = ios_audio_to_host(base, p->fmt);
+    if (!ios_audio_guest_range(base, p->fmt, 18u + n.fmt->cbSize))
+    { p->result = IOS_AUDIO_E_INVALIDARG; return STATUS_SUCCESS; }
+    n.name = ios_audio_to_host(base, p->name);
+    n.device = ios_audio_to_host(base, p->device);
+    n.flow = p->flow; n.share = p->share; n.flags = p->flags;
+    n.duration = p->duration; n.period = p->period;
+    n.channel_count = &channels; n.stream = &handle;
+    ios_create_stream(&n);
+    if (n.result == S_OK && (s = stream_from_handle(handle)))
+    {
+        old = s->render_scratch;
+        s->render_scratch = NULL;
+        s->wow64_owner = owner; s->wow64_window = base;
+        if (!s->ring || !ios_audio_scratch_resize(s, s->scratch_frames))
+        {
+            struct release_stream_params release = { .stream = handle };
+            ios_release_stream(&release);
+            handle = 0;
+            n.result = E_OUTOFMEMORY;
+        }
+        free(old);
+    }
+    else if (n.result == S_OK) { handle = 0; n.result = E_FAIL; }
+    *(UINT32 *)ios_audio_to_host(base, p->channel_count) = channels;
+    /* PE32 stream_handle outputs are still eight bytes. */
+    memcpy(ios_audio_to_host(base, p->stream), &handle, sizeof(handle));
+    p->result = n.result;
+    return STATUS_SUCCESS;
+}
+
+struct ios_audio_get_render_buffer32 {
+    stream_handle stream;
+    UINT32 frames;
+    HRESULT result;
+    uint32_t data;
+};
+_Static_assert(offsetof(struct ios_audio_get_render_buffer32, data) == 16, "PE32 render data");
+
+static NTSTATUS ios_wow64_get_render_buffer(void *args)
+{
+    struct ios_audio_get_render_buffer32 *p = args;
+    uintptr_t base = ios_wow64_current_base();
+    BYTE *data = NULL;
+    uint32_t guest = 0;
+    struct get_render_buffer_params n = { .stream = p->stream, .frames = p->frames, .data = &data };
+    IOS_AUDIO_PTR(data, sizeof(uint32_t));
+    if (!p->data) { p->result = IOS_AUDIO_E_INVALIDARG; return STATUS_SUCCESS; }
+    *(uint32_t *)ios_audio_to_host(base, p->data) = 0;
+    IOS_AUDIO_OWNER();
+    ios_get_render_buffer(&n);
+    if (n.result == S_OK)
+    {
+        struct ios_stream *s = stream_from_handle(p->stream);
+        size_t bytes = (size_t)p->frames * s->frame_bytes;
+        if (!ios_audio_to_guest(base, data, bytes, &guest) || (bytes && !data))
+        { s->pending_frames = 0; n.result = E_FAIL; }
+    }
+    *(uint32_t *)ios_audio_to_host(base, p->data) = guest;
+    p->result = n.result;
+    return STATUS_SUCCESS;
+}
+
+struct ios_audio_get_capture_buffer32 {
+    stream_handle stream;
+    HRESULT result;
+    uint32_t data, frames, flags, devpos, qpcpos;
+};
+_Static_assert(offsetof(struct ios_audio_get_capture_buffer32, data) == 12, "PE32 capture data");
+_Static_assert(sizeof(struct ios_audio_get_capture_buffer32) == 32, "PE32 capture");
+
+static NTSTATUS ios_wow64_get_capture_buffer(void *args)
+{
+    struct ios_audio_get_capture_buffer32 *p = args;
+    uintptr_t base = ios_wow64_current_base();
+    BYTE *data = NULL;
+    uint32_t guest = 0;
+    struct get_capture_buffer_params n = { .stream = p->stream, .data = &data };
+    IOS_AUDIO_PTR(data, 4); IOS_AUDIO_PTR(frames, 4); IOS_AUDIO_PTR(flags, 4);
+    IOS_AUDIO_PTR(devpos, 8); IOS_AUDIO_PTR(qpcpos, 8);
+    IOS_AUDIO_OWNER();
+    n.frames = ios_audio_to_host(base, p->frames);
+    n.flags = ios_audio_to_host(base, p->flags);
+    n.devpos = ios_audio_to_host(base, p->devpos);
+    n.qpcpos = ios_audio_to_host(base, p->qpcpos);
+    /* The iOS backend has no capture endpoint: zero all optional outputs. */
+    if (n.devpos) *n.devpos = 0;
+    if (n.qpcpos) *n.qpcpos = 0;
+    ios_get_capture_buffer(&n);
+    if (n.result == S_OK && !ios_audio_to_guest(base, data, 0, &guest)) n.result = E_FAIL;
+    if (p->data) *(uint32_t *)ios_audio_to_host(base, p->data) = guest;
+    p->result = n.result;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS ios_wow64_release_stream(void *args)
+{
+    struct release_stream_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_release_stream(args);
+}
+
+static NTSTATUS ios_wow64_start(void *args)
+{
+    struct stream_handle_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_start(args);
+}
+
+static NTSTATUS ios_wow64_stop(void *args)
+{
+    struct stream_handle_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_stop(args);
+}
+
+static NTSTATUS ios_wow64_reset(void *args)
+{
+    struct stream_handle_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_reset(args);
+}
+
+static NTSTATUS ios_wow64_release_render_buffer(void *args)
+{
+    struct release_render_buffer_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_release_render_buffer(args);
+}
+
+static NTSTATUS ios_wow64_release_capture_buffer(void *args)
+{
+    struct release_capture_buffer_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_release_capture_buffer(args);
+}
+
+static NTSTATUS ios_wow64_set_sample_rate(void *args)
+{
+    struct set_sample_rate_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_set_sample_rate(args);
+}
+
+static NTSTATUS ios_wow64_is_started(void *args)
+{
+    struct is_started_params *p = args;
+    IOS_AUDIO_OWNER();
+    return ios_is_started(args);
+}
+
+struct ios_audio_get_endpoint_ids32 {
+    EDataFlow flow;
+    uint32_t endpoints;
+    unsigned int size;
+    HRESULT result;
+    unsigned int num;
+    unsigned int default_idx;
+};
+
+static NTSTATUS ios_wow64_get_endpoint_ids(void *args)
+{
+    struct ios_audio_get_endpoint_ids32 *p = args;
+    uintptr_t base = ios_wow64_current_base();
+    struct get_endpoint_ids_params n = {0};
+    if (p->size && !p->endpoints)
+    { p->result = IOS_AUDIO_E_INVALIDARG; return STATUS_SUCCESS; }
+    IOS_AUDIO_PTR(endpoints, p->size);
+    n.endpoints = ios_audio_to_host(base, p->endpoints);
+    n.flow = p->flow;
+    n.size = p->size;
+    ios_get_endpoint_ids(&n);
+    p->result = n.result;
+    p->size = n.size;
+    p->num = n.num;
+    p->default_idx = n.default_idx;
+    return STATUS_SUCCESS;
+}
+
+struct ios_audio_is_format_supported32 {
+    uint32_t device;
+    EDataFlow flow;
+    int share;
+    uint32_t fmt_in;
+    HRESULT result;
+};
+
+static NTSTATUS ios_wow64_is_format_supported(void *args)
+{
+    struct ios_audio_is_format_supported32 *p = args;
+    uintptr_t base = ios_wow64_current_base();
+    struct is_format_supported_params n = {0};
+    IOS_AUDIO_PTR(device, 1);
+    n.device = ios_audio_to_host(base, p->device);
+    IOS_AUDIO_PTR(fmt_in, 18);
+    n.fmt_in = ios_audio_to_host(base, p->fmt_in);
+    n.flow = p->flow;
+    n.share = p->share;
+    ios_is_format_supported(&n);
+    p->result = n.result;
+    return STATUS_SUCCESS;
+}
+
+struct ios_audio_get_mix_format32 {
+    uint32_t device;
+    EDataFlow flow;
+    uint32_t fmt;
+    HRESULT result;
+};
+
+static NTSTATUS ios_wow64_get_mix_format(void *args)
+{
+    struct ios_audio_get_mix_format32 *p = args;
+    uintptr_t base = ios_wow64_current_base();
+    struct get_mix_format_params n = {0};
+    IOS_AUDIO_PTR(device, 1);
+    n.device = ios_audio_to_host(base, p->device);
+    IOS_AUDIO_PTR(fmt, 40);
+    n.fmt = ios_audio_to_host(base, p->fmt);
+    n.flow = p->flow;
+    ios_get_mix_format(&n);
+    p->result = n.result;
+    return STATUS_SUCCESS;
+}
+
+struct ios_audio_get_device_period32 {
+    uint32_t device;
+    EDataFlow flow;
