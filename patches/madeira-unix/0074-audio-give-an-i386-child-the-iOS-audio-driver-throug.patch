+/* Audio scratch is a real owner-local RW view, not a host malloc pointer.
+ * Explicit owner + window prevents a later child at a recycled slot from
+ * freeing this child's allocation. Allocation is only on the owning thread;
+ * release may be from detach and uses the recorded owner, not current TLS. */
+NTSTATUS ios_wow64_audio_alloc( void *owner, uintptr_t window, size_t length, void **host )
+{
+    NTSTATUS status = STATUS_NOT_SUPPORTED;
+    unsigned int i;
+    sigset_t sigset;
+    void *addr = NULL;
+    size_t size = length;
+
+    if (!owner || owner != ios_jit_current_peb() || !host || !length)
+        return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+        if (ios_wow64_windows[i].owner == owner && ios_wow64_windows[i].base == window &&
+            !ios_wow64_windows[i].retiring)
+        {
+            server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+            status = ios_wow64_vm_allocate_limited( window, &addr, &size, MEM_RESERVE | MEM_COMMIT,
+                                                    PAGE_READWRITE, 0, UINT64_C(0x80000000) );
+            server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+            if (!status) { memset( addr, 0, length ); *host = addr; }
+            break;
+        }
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    return status;
+}
+
+NTSTATUS ios_wow64_audio_free( void *owner, uintptr_t window, void *host )
+{
+    NTSTATUS status = STATUS_NOT_SUPPORTED;
+    unsigned int i;
+    sigset_t sigset;
+    void *addr = host;
+    size_t size = 0;
+
+    if (!owner || !host || !window) return STATUS_INVALID_PARAMETER;
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+        if (ios_wow64_windows[i].owner == owner && ios_wow64_windows[i].base == window)
+        {
+            server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+            status = ios_wow64_vm_free( window, &addr, &size, MEM_RELEASE );
+            server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+            break;
+        }
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    return status;
+}
