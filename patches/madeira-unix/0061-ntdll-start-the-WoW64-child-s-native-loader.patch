 };
 
 /* Current thread's pseudo-process ntdll funcs; NULL = session ntdll. */
diff --git a/build/ntdll-unix/loader_ios.c b/build/ntdll-unix/loader_ios.c
index 6da2da5..0ef8e57 100644
--- a/build/ntdll-unix/loader_ios.c
+++ b/build/ntdll-unix/loader_ios.c
@@ -2341,14 +2341,21 @@ static void redirect_ntdll_functions( HMODULE module )
  * session image (including the Round-7 EC unix-call swap), with every
  * PE-.data write synced into the pool copy.
  */
-static int ios_load_child_ec_ntdll( PEB *child_peb )
+static int ios_load_child_i386_ntdll( SYSTEM_DLL_INIT_BLOCK *block );
+
+/* X3c: an AMD64 child of an aarch64 session runs the ARM64EC ntdll build.
+ * Playport: a WoW64 (i386) child runs the native aarch64 build, whatever the
+ * session is, with the i386 ntdll mapped in its own window. */
+static int ios_load_child_ec_ntdll( PEB *child_peb, BOOL wow64 )
 {
     static WCHAR path[] = {'\\','?','?','\\','C',':','\\','w','i','n','d','o','w','s','\\',
                            's','y','s','t','e','m','3','2','\\','n','t','d','l','l','.','d','l','l',0};
     extern void ios_jit_sync_write(void *addr, size_t size);
     extern void *ios_jit_translate_addr(void *addr);
     extern void *ios_arm64ec_bitmap_base(void);
-    const char *pe_dir = get_pe_dir( IMAGE_FILE_MACHINE_AMD64 );  /* owner-aware → /arm64ec-windows */
+    /* owner-aware: /arm64ec-windows for an AMD64 child, /aarch64-windows for i386 */
+    const WORD machine = wow64 ? IMAGE_FILE_MACHINE_ARM64 : IMAGE_FILE_MACHINE_AMD64;
+    const char *pe_dir = get_pe_dir( machine );
     unsigned int status;
     SECTION_IMAGE_INFORMATION info;
     OBJECT_ATTRIBUTES attr;
@@ -2367,7 +2374,7 @@ static int ios_load_child_ec_ntdll( PEB *child_peb )
 
     dprintf(2, "[ec-child-ntdll] loading %s for peb=%p\n", name, (void *)child_peb);
     status = open_builtin_pe_file( name, &attr, &module, &size, &info, 0, 0,
-                                   IMAGE_FILE_MACHINE_AMD64, FALSE, 0 );
+                                   machine, FALSE, 0 );
     if (status == STATUS_IMAGE_NOT_AT_BASE) status = virtual_relocate_module( module );
     if (status)
     {
@@ -2409,9 +2416,12 @@ static int ios_load_child_ec_ntdll( PEB *child_peb )
         EC_GET( p__wine_unix_call_dispatcher,          "__wine_unix_call_dispatcher" );
         EC_GET( p__wine_unix_call_dispatcher_arm64ec,  "__wine_unix_call_dispatcher_arm64ec" );
         EC_GET( p__wine_unixlib_handle,                "__wine_unixlib_handle" );
+        if (wow64) EC_GET( funcs.LdrSystemDllInitBlock, "LdrSystemDllInitBlock" );
 #undef EC_GET
         if (!funcs.LdrInitializeThunk || !p__wine_syscall_dispatcher || !p__wine_unixlib_handle)
             return -1;
+        if (wow64 && (!funcs.LdrSystemDllInitBlock || ios_load_child_i386_ntdll( funcs.LdrSystemDllInitBlock )))
+            return -1;
 
         /* Same slot recipe as load_ntdll_functions for the session image. */
         *p__wine_syscall_dispatcher = __wine_syscall_dispatcher;
@@ -2523,7 +2533,7 @@ static int ios_load_child_ec_ntdll( PEB *child_peb )
     /* The EC code bitmap is lazily created by the first hybrid AMD64 map;
      * only the creating PEB gets EcCodeBitMap set. Every EC child needs it
      * (arm64x_check_call reads TEB->Peb->EcCodeBitMap). */
-    if (!child_peb->EcCodeBitMap) child_peb->EcCodeBitMap = ios_arm64ec_bitmap_base();
+    if (!wow64 && !child_peb->EcCodeBitMap) child_peb->EcCodeBitMap = ios_arm64ec_bitmap_base();
     dprintf(2, "[ec-child-ntdll] EcCodeBitMap=%p LdrInitializeThunk=%p (pool %p)\n",
             child_peb->EcCodeBitMap, funcs.LdrInitializeThunk,
             ios_jit_translate_addr( funcs.LdrInitializeThunk ));
@@ -2531,6 +2541,98 @@ static int ios_load_child_ec_ntdll( PEB *child_peb )
     ios_set_proc_ntdll( child_peb, module, &funcs );
     return 0;
 }
+
+#include "wow64_window.h"
+
+/* Playport: the WoW64 child's equivalent of load_wow64_ntdll and
+ * load_ntdll_wow64_functions. The i386 ntdll maps through the owner's
+ * window (native NtMapViewOfSection with a guest constraint), never into
+ * the session globals (pLdrSystemDllInitBlock, p__wine_ctrl_routine).
+ * The native block keeps a host ntdll_handle, which wow64.dll dereferences;
+ * its entry points, and the whole i386 copy, are guest addresses. */
+static int ios_load_child_i386_ntdll( SYSTEM_DLL_INIT_BLOCK *block )
+{
+    static WCHAR path[] = {'\\','?','?','\\','C',':','\\','w','i','n','d','o','w','s','\\',
+                           's','y','s','w','o','w','6','4','\\','n','t','d','l','l','.','d','l','l',0};
+    extern void ios_jit_sync_write(void *addr, size_t size);
+    uintptr_t window = ios_wow64_current_base();
+    const IMAGE_EXPORT_DIRECTORY *exports;
+    SYSTEM_DLL_INIT_BLOCK *block32;
+    unixlib_handle_t *unixlib;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    HANDLE mapping;
+    void *module = NULL;
+    SIZE_T size = 0;
+    uint32_t guest = 0, block32_guest = 0;
+    char *name = NULL;
+    NTSTATUS status;
+
+    if (!window) return -1;
+    init_unicode_string( &str, path );
+    InitializeObjectAttributes( &attr, &str, 0, 0, NULL );
+    if (asprintf( &name, "%s%s/ntdll.dll", dll_dir, get_pe_dir( IMAGE_FILE_MACHINE_I386 ) ) < 0)
+        return -1;
+    status = open_dll_file( name, &attr, &mapping );
+    if (!status)
+    {
+        status = NtMapViewOfSection( mapping, NtCurrentProcess(), &module, UINT32_MAX, 0, NULL,
+                                     &size, ViewUnmap, 0, PAGE_READONLY );
+        NtClose( mapping );
+    }
+    if (!NT_SUCCESS(status) || !ios_wow64_guest_addr( window, (uintptr_t)module, &guest ))
+    {
+        dprintf( 2, "[wow64-loader] i386 ntdll %s: map FAILED status=%x host=%p\n",
+                 name, (unsigned int)status, module );
+        free( name );
+        return -1;
+    }
+    free( name );
+    if (!(exports = get_module_data_dir( module, IMAGE_DIRECTORY_ENTRY_EXPORT, NULL ))) return -1;
+
+#define GUEST_EXPORT(field, sym) do { \
+        uint32_t g_ = 0; \
+        ULONG_PTR h_ = find_named_export( module, exports, sym ); \
+        if (!h_ || !ios_wow64_guest_addr( window, h_, &g_ )) \
+        { \
+            dprintf( 2, "[wow64-loader] i386 ntdll export %s NOT FOUND\n", sym ); \
+            return -1; \
+        } \
+        block->field = g_; \
+    } while (0)
+    block->ntdll_handle = (ULONG_PTR)module;
+    GUEST_EXPORT( pKiUserApcDispatcher, "KiUserApcDispatcher" );
+    GUEST_EXPORT( pKiUserCallbackDispatcher, "KiUserCallbackDispatcher" );
+    GUEST_EXPORT( pKiUserExceptionDispatcher, "KiUserExceptionDispatcher" );
+    GUEST_EXPORT( pLdrInitializeThunk, "LdrInitializeThunk" );
+    GUEST_EXPORT( pLdrSystemDllInitBlock, "LdrSystemDllInitBlock" );
+    GUEST_EXPORT( pRtlUserThreadStart, "RtlUserThreadStart" );
+#undef GUEST_EXPORT
+    /* Optional in Wine too: zero when absent. */
+    {
+        ULONG_PTR h;
+        uint32_t g = 0;
+        h = find_named_export( module, exports, "RtlpFreezeTimeBias" );
+        block->pRtlpFreezeTimeBias = h && ios_wow64_guest_addr( window, h, &g ) ? g : 0;
+        g = 0;
+        h = find_named_export( module, exports, "RtlpQueryProcessDebugInformationRemote" );
+        block->pRtlpQueryProcessDebugInformationRemote = h && ios_wow64_guest_addr( window, h, &g ) ? g : 0;
+    }
+    if ((unixlib = (unixlib_handle_t *)find_named_export( module, exports, "__wine_unixlib_handle" )))
+        *unixlib = (UINT_PTR)unix_call_wow64_funcs;
+
+    block32_guest = block->pLdrSystemDllInitBlock;
+    block32 = (SYSTEM_DLL_INIT_BLOCK *)ios_wow64_host_addr( window, block32_guest );
+    memcpy( block32, block, sizeof(*block) );
+    block32->ntdll_handle = guest;
+    /* The native ntdll's PE code reads its block from the pool copy. */
+    ios_jit_sync_write( block, sizeof(*block) );
+    dprintf( 2, "[wow64-loader] i386 ntdll host=%p guest=%#x size=%#lx LdrInitializeThunk=%#x "
+             "RtlUserThreadStart=%#x block32=%#x unixlib=%d native_block=%p\n",
+             module, guest, (unsigned long)size, (unsigned int)block->pLdrInitializeThunk,
+             (unsigned int)block->pRtlUserThreadStart, block32_guest, !!unixlib, (void *)block );
+    return 0;
+}
 #endif
 
 
@@ -3266,8 +3368,22 @@ DECLSPEC_EXPORT void wine_ios_child_main( int argc, char *argv[], int child_fd_s
         set_load_order_app_name( main_wargv[0] );
 
         /* Set up thread stack */
-        init_thread_stack( teb, 0, 0, 0 );
+        status = init_thread_stack( teb, 0, 0, 0 );
 
+        /* Playport: a WoW64 child needs a native, non-EC ntdll whose loader
+         * runs wow64.dll; the session's ARM64EC copy cannot be that. Its
+         * 32-bit stack is in the owner's window (init_thread_stack). */
+        if (ios_cur_image_info()->Machine == IMAGE_FILE_MACHINE_I386)
+        {
+            if (status || ios_load_child_ec_ntdll( child_peb, TRUE ) != 0)
+            {
+                dprintf(STDERR_FILENO, "[wow64-loader] native ntdll, i386 ntdll or stack FAILED "
+                        "(stack status %x) -- the WoW64 child cannot start\n", (unsigned int)status);
+                NtTerminateProcess( GetCurrentProcess(), status ? status : STATUS_DLL_INIT_FAILED );
+                return;
+            }
+        }
+        else
         /* X3c: a cross-arch child (AMD64 exe, non-EC session) cannot run on
          * the session's aarch64 ntdll at all — load the ARM64EC build as a
          * private second image instead of copying the session image. The
@@ -3275,7 +3391,7 @@ DECLSPEC_EXPORT void wine_ios_child_main( int argc, char *argv[], int child_fd_s
          * the standard map pipeline gave it pool/EC/x18 treatment. */
         if (ios_cur_image_info()->Machine == IMAGE_FILE_MACHINE_AMD64 && !is_arm64ec())
         {
-            if (ios_load_child_ec_ntdll( child_peb ) != 0)
+            if (ios_load_child_ec_ntdll( child_peb, FALSE ) != 0)
             {
                 dprintf(STDERR_FILENO, "[Wine child] EC ntdll load FAILED — cross-arch child cannot start\n");
                 return;
