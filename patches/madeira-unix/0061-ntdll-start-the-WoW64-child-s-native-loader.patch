+++ b/build/ntdll-unix/env_ios.c
@@ -2450,22 +2450,6 @@ void unix_init_startup_info(void)
     free( env );
     free( info );
 
-#ifdef WINE_IOS
-    if (ios_cur_image_info()->Machine == IMAGE_FILE_MACHINE_I386)
-    {
-        init_peb( params, debugged, module );
-        /* Parameters are now window-backed, but the session ARM64EC PE
-         * loader cannot initialize the native WoW64 loader/heap/stack yet.
-         * Keep this temporary boundary until those paths are wired. */
-        dprintf(2, "[wow64-startup] image and parameters mapped; native WoW64 loader "
-                   "not implemented -> STATUS_NOT_SUPPORTED (no i386 execution)\n");
-        NtCurrentTeb()->Peb->ProcessParameters = NULL;
-        size = 0;
-        NtFreeVirtualMemory( NtCurrentProcess(), (void **)&params, &size, MEM_RELEASE );
-        NtTerminateProcess( GetCurrentProcess(), STATUS_NOT_SUPPORTED );
-        return;
-    }
-#endif
     rebuild_argv();
     main_wargv = build_wargv( params->ImagePathName.Buffer );
     init_peb( params, debugged, module );
diff --git a/build/ntdll-unix/ios_mixed.h b/build/ntdll-unix/ios_mixed.h
