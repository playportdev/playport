+                                                &wow_teb->Tib.StackLimit, &wow_teb->DeallocationStack );
+        }
+#endif
         if (!limit || limit > user_space_wow_limit) limit = user_space_wow_limit;
         if ((status = virtual_alloc_thread_stack( &stack, 0, limit, reserve_size, commit_size, TRUE )))
             return status;
diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index 698a135..b1bbc8a 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -14973,6 +14973,90 @@ NTSTATUS ios_wow64_allocate_for_peb( void *owner, uint32_t guest, size_t size,
     return status;
 }
 
+/* Native callers of ProcessWow64Information: the owner's PEB32 (host). */
+void *ios_wow64_peb32_for_peb( void *owner )
+{
+    void *peb32 = NULL;
+    unsigned int i;
+    if (!owner) return NULL;
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+        if (ios_wow64_windows[i].owner == owner)
+        {
+            peb32 = ios_wow64_windows[i].peb32;
+            break;
+        }
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    return peb32;
+}
+
+/* A windowed owner's 32-bit thread stack, with virtual_alloc_thread_stack's
+ * sizes and layout (no-access host page, guard host page, committed RW) and
+ * guest results. The owner's own thread only; outputs change on success. */
+NTSTATUS ios_wow64_alloc_stack32( void *owner, SIZE_T reserve_size, SIZE_T commit_size,
+                                  ULONG *base, ULONG *limit, ULONG *dealloc )
+{
+    const SECTION_IMAGE_INFORMATION *info = ios_cur_image_info();
+    NTSTATUS status = STATUS_NOT_SUPPORTED;
+    void *addr = NULL, *page;
+    size_t size, page_size_host = host_page_mask + 1, length;
+    uint64_t end;
+    unsigned int i;
+    sigset_t sigset;
+    ULONG old;
+
+    if (!owner || owner != ios_jit_current_peb()) return STATUS_ACCESS_DENIED;
+    if (!reserve_size) reserve_size = info->MaximumStackSize;
+    if (!commit_size) commit_size = info->CommittedStackSize;
+    size = max( reserve_size, commit_size );
+    if (size < 8 * 1024 * 1024) size = 8 * 1024 * 1024;  /* virtual_alloc_thread_stack's guard floor */
+    size = (size + granularity_mask) & ~granularity_mask;
+    end = (info->ImageCharacteristics & IMAGE_FILE_LARGE_ADDRESS_AWARE) ?
+          IOS_WOW64_WINDOW_SIZE : UINT64_C(0x80000000);
+
+    pthread_mutex_lock( &ios_wow64_windows_lock );
+    for (i = 0; i < IOS_WOW64_WINDOWS_MAX; i++)
+    {
+        uintptr_t window = ios_wow64_windows[i].base;
+        if (ios_wow64_windows[i].owner != owner) continue;
+        server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+        status = ios_wow64_vm_allocate_limited( window, &addr, &size, MEM_RESERVE | MEM_COMMIT,
+                                                PAGE_READWRITE, 0, end );
+        if (!status)
+        {
+            page = addr;
+            length = page_size_host;
+            status = ios_wow64_vm_protect( window, &page, &length, PAGE_NOACCESS, &old );
+        }
+        if (!status)
+        {
+            page = (char *)addr + page_size_host;
+            length = page_size_host;
+            status = ios_wow64_vm_protect( window, &page, &length, PAGE_READWRITE | PAGE_GUARD, &old );
+        }
+        if (status && addr)
+        {
+            void *release = addr;
+            size_t release_size = 0;
+            ios_wow64_vm_free( window, &release, &release_size, MEM_RELEASE );
+        }
+        server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+        if (!status)
+        {
+            *dealloc = (uintptr_t)addr - window;
+            *limit = (uintptr_t)addr - window + 2 * page_size_host;
+            *base = (uintptr_t)addr - window + size;
+            dprintf( 2, "[wow64-stack] owner=%p host=%p guest=%#x base=%#x limit=%#x bytes=%#lx guard=1\n",
+                     owner, addr, (unsigned int)*dealloc, (unsigned int)*base, (unsigned int)*limit,
+                     (unsigned long)size );
+        }
+        break;
+    }
+    pthread_mutex_unlock( &ios_wow64_windows_lock );
+    if (status) dprintf( 2, "[wow64-stack] owner=%p FAILED status=%#x\n", owner, (unsigned int)status );
+    return status;
+}
+
 /* Server registration describes host storage, never guest ImageBase. */
 static NTSTATUS ios_wow64_server_map( struct file_view *view )
