diff --git a/build/ntdll-unix/thread_ios.c b/build/ntdll-unix/thread_ios.c
index 2e5073c..393f350 100644
--- a/build/ntdll-unix/thread_ios.c
+++ b/build/ntdll-unix/thread_ios.c
@@ -1346,6 +1346,18 @@ NTSTATUS init_thread_stack( TEB *teb, ULONG_PTR limit, SIZE_T reserve_size, SIZE
         teb->DeallocationStack = stack.DeallocationStack;
 
         /* 32-bit stack */
+#ifdef WINE_IOS
+        /* Playport: a windowed WoW64 owner's 32-bit stack is in its window,
+         * and the TEB32 holds guest addresses, never truncated host ones. */
+        {
+            extern NTSTATUS ios_wow64_alloc_stack32( void *owner, SIZE_T reserve_size, SIZE_T commit_size,
+                                                    ULONG *base, ULONG *limit, ULONG *dealloc );
+            extern uintptr_t ios_wow64_base_for_peb( void *owner );
+            if (ios_wow64_base_for_peb( teb->Peb ))
