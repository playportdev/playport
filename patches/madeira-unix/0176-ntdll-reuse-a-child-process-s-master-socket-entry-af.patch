-    BOOL exiting;   /* per-process process_exiting flag */
-} ios_proc_sockets[IOS_MAX_PROC_SOCKETS];
-static int ios_proc_socket_count = 0;
+static struct ios_proc_socket ios_proc_sockets[IOS_MAX_PROC_SOCKETS];
+static int ios_proc_socket_count = 0;   /* high-water mark (pp_proc_sockets.h) */
 
 extern void *ios_jit_current_peb(void);
 
 static int ios_proc_socket_index(void)
 {
     void *cur = ios_jit_current_peb();
-    int i, n = ios_proc_socket_count;
+    int i, n = ppps_scan_count( &ios_proc_socket_count, IOS_MAX_PROC_SOCKETS );
     if (cur)
         for (i = 0; i < n; i++)
             if (ios_proc_sockets[i].peb == cur) return i;
@@ -310,17 +306,14 @@ static void ios_fdt_autopsy( const char *what, int fd, int ret, int err )
 
 static void ios_register_proc_socket(void *peb_id, int fd)
 {
-    int idx = __sync_fetch_and_add(&ios_proc_socket_count, 1);
-    if (idx >= IOS_MAX_PROC_SOCKETS)
+    int idx = ppps_claim( ios_proc_sockets, &ios_proc_socket_count, IOS_MAX_PROC_SOCKETS );
+    if (idx < 0)
     {
-        wine_log_write("[Wine child] proc-socket table FULL (%d)!", idx);
+        wine_log_write("[Wine child] proc-socket table FULL (%d live)!", IOS_MAX_PROC_SOCKETS);
         return;
     }
     ios_fdt_reg( fd, FDT_MASTER, peb_id );
-    ios_proc_sockets[idx].fd = fd;
-    ios_proc_sockets[idx].exiting = FALSE;
-    __sync_synchronize();
-    ios_proc_sockets[idx].peb = peb_id;
+    ppps_publish( ios_proc_sockets, idx, peb_id, fd );
 }
 #endif
 static _Thread_local int initial_cwd = -1;
@@ -4031,19 +4024,16 @@ int ios_peb_is_dead_child( void *peb )
  * or was torn down already). */
 int ios_proc_end_take_socket( void *peb )
 {
-    int i, n = ios_proc_socket_count;
+    int i, n = ppps_scan_count( &ios_proc_socket_count, IOS_MAX_PROC_SOCKETS );
 
-    if (n > IOS_MAX_PROC_SOCKETS) n = IOS_MAX_PROC_SOCKETS;
     for (i = 0; peb && i < n; i++)
     {
-        void *expected = peb;
         unsigned int d;
+        int fd;
 
-        if (!__atomic_compare_exchange_n( &ios_proc_sockets[i].peb, &expected, NULL, 0,
-                                          __ATOMIC_ACQ_REL, __ATOMIC_RELAXED ))
-            continue;
-        ios_fdt_note_close( ios_proc_sockets[i].fd, "killed-master", peb );
-        close( ios_proc_sockets[i].fd );
+        if (!ppps_release( ios_proc_sockets, i, peb, &fd )) continue;
+        ios_fdt_note_close( fd, "killed-master", peb );
+        close( fd );
         d = __sync_fetch_and_add( &ios_dead_peb_count, 1 );
         if (d < IOS_DEAD_PEB_MAX) ios_dead_pebs[d] = peb;
         return 1;
@@ -4077,12 +4067,17 @@ void process_exit_wrapper( int status )
             extern void ios_wow64_release_window_at_exit( void *owner );
             ios_wow64_release_window_at_exit( dead_peb );
         }
-        ios_fdt_note_close( ios_proc_sockets[i].fd, "exit-master", dead_peb );
-        close( ios_proc_sockets[i].fd );
-        ios_proc_sockets[i].peb = NULL;
         {
-            unsigned int d = __sync_fetch_and_add( &ios_dead_peb_count, 1 );
-            if (d < IOS_DEAD_PEB_MAX) ios_dead_pebs[d] = dead_peb;
+            int fd;
+            /* the entry is free for the next child once its socket is read */
+            if (ppps_release( ios_proc_sockets, i, dead_peb, &fd ))
+            {
+                unsigned int d;
+                ios_fdt_note_close( fd, "exit-master", dead_peb );
+                close( fd );
+                d = __sync_fetch_and_add( &ios_dead_peb_count, 1 );
+                if (d < IOS_DEAD_PEB_MAX) ios_dead_pebs[d] = dead_peb;
+            }
         }
         /* ml571: drop this pseudo-process's fd cache and close what it held.
          * Must happen on the SAME identity used to key it, and before the JIT
