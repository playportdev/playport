index 927a715..29e3854 100644
--- a/build/ntdll-unix/server_ios.c
+++ b/build/ntdll-unix/server_ios.c
@@ -177,21 +177,17 @@ sigset_t server_block_set;  /* signals to block during server calls */
 static int fd_socket = -1;
 
 #ifdef WINE_IOS
+#include "pp_proc_sockets.h"
 #define IOS_MAX_PROC_SOCKETS 64
-static struct ios_proc_socket
-{
-    void *peb;      /* NULL = free slot */
