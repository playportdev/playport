diff --git a/build/ntdll-unix/pp_sc_access.h b/build/ntdll-unix/pp_sc_access.h
new file mode 100644
index 0000000..13d9e5d
--- /dev/null
+++ b/build/ntdll-unix/pp_sc_access.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Reported extents are not ownership. Call before commits/decommits/protects
+ * and non-grant frees, including extended-API commits. */
+enum ppsc_op { PPSC_OP_COMMIT, PPSC_OP_FREE, PPSC_OP_PROTECT };
+
+/* The slot whose real range [a, a + n) overlaps, or PPSC_NONE. */
+static enum ppsc_slot ppsc_real_slot(uint64_t a, uint64_t n)
+{
+    int k;
+    for (k = PPSC_ELF; k <= PPSC_CAGE; k++) {
+        struct ppsc_range r = ppsc_range(k);
+        if (a < r.base + r.size && a + n > r.base) return k;
+    }
+    return PPSC_NONE;
+}
+
+/* virtual_mutex held. PLA-482, diagnostic only: no operation is refused here.
+ * For each grant k this helper owns whose reported extent covers [a, a + n)
+ * outside k's real range, say what is underneath: another slot it also owns
+ * (the reported extents alias real slots), a commit in a reported tail, an
+ * Oilpan commit in the lower half of its report (chrome_elf's), or a view of
+ * another owner. Each message has its own per-kind limit. */
+static void ppsc_note_reported_locked(void *owner, const void *address, uint64_t a, uint64_t n,
+                                      enum ppsc_op op)
+{
+    static unsigned said_view[PPSC_CAGE + 1], said_alias[PPSC_CAGE + 1], said_tail[PPSC_CAGE + 1];
+    static unsigned said_oilpan_low;
+    enum ppsc_slot j = ppsc_real_slot(a, n);
+    int k;
+    for (k = PPSC_ELF; k <= PPSC_CAGE; k++) {
+        struct ppsc_range r = ppsc_range(k);
+        struct file_view *v;
+        uint64_t off;
+        if (ppsc_owner[k] != owner || a >= r.report + r.asked || a + n <= r.report) continue;
+        if (ppsc_contains(r, a, n)) continue;
+        off = a > r.report ? a - r.report : 0;
+        if (k == PPSC_OILPAN && op == PPSC_OP_COMMIT && off < 0x400000000ULL) {
+            if (said_oilpan_low++ < 16)
+                dprintf(2, "[sc-layout] helper %p commit %p+0x%llx in Oilpan's reported lower half off=0x%llx (real slot kind=%d)\n",
+                        owner, address, (unsigned long long)n, (unsigned long long)off, j);
+            continue;
+        }
+        if (j && ppsc_owner[j] == owner) {
+            if (said_alias[k]++ < 16)
+                dprintf(2, "[sc-layout] helper %p op=%d %p+0x%llx in reported extent of kind=%d off=0x%llx lands in its own kind=%d real range\n",
+                        owner, op, address, (unsigned long long)n, k, (unsigned long long)off, j);
+            continue;
+        }
+        /* No real slot is underneath: ppsc_access refuses (and logs) an
+         * operation on one this helper does not own. */
+        v = find_view(address, n);
+        if (op == PPSC_OP_COMMIT && said_tail[k]++ < 16)
+            dprintf(2, "[sc-layout] helper %p commit %p+0x%llx in reported tail of kind=%d off=0x%llx: view owner=%p\n",
+                    owner, address, (unsigned long long)n, k, (unsigned long long)off,
+                    v ? v->ios_owner_peb : NULL);
+        /* FEX and thread views here may be tagged with another owner
+         * legitimately; that is not yet proven safe to refuse. */
+        if (v && v->ios_owner_peb != owner && said_view[k]++ < 16)
+            dprintf(2, "[sc-layout] helper %p operation %p+0x%llx in reported tail of kind=%d lands on view owned by %p\n",
+                    owner, address, (unsigned long long)n, k, v->ios_owner_peb);
+    }
+}
+
+static int ppsc_access(const void *address, SIZE_T size, enum ppsc_op op)
+{
+    uint64_t a = (uintptr_t)address, n = size ? size : 1;
+    void *owner;
+    sigset_t sigset;
+    enum ppsc_slot k;
+    int ok = 1;
+    if (!ppsc_ready) return 1;
+    if (n > UINT64_MAX - a) return 0;
+    owner = ios_jit_current_peb();
+    server_enter_uninterrupted_section(&virtual_mutex, &sigset);
+    if ((k = ppsc_real_slot(a, n))) ok = owner && ppsc_owner[k] == owner && ppsc_contains(ppsc_range(k), a, n);
+    if (!ok) dprintf(2, "[sc-layout] refused memory operation owner=%p addr=%p size=0x%llx: outside owned real range\n",
+                     owner, address, (unsigned long long)size);
+    else if (owner && ppsc_helper()) ppsc_note_reported_locked(owner, address, a, n, op);
+    server_leave_uninterrupted_section(&virtual_mutex, &sigset);
+    return ok;
+}
diff --git a/build/ntdll-unix/pp_sc_owner.h b/build/ntdll-unix/pp_sc_owner.h
new file mode 100644
index 0000000..99c103b
--- /dev/null
+++ b/build/ntdll-unix/pp_sc_owner.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Shared by the layout router and the existing safe process teardown. */
+static void *ppsc_owner[PPSC_CAGE + 1]; /* virtual_mutex protects grants and holds */
+
+static int ppsc_helper(void)
+{
+    static const char name[] = "socialclubhelper.exe";
+    PEB *peb = ios_jit_current_peb();
+    RTL_USER_PROCESS_PARAMETERS *p = peb ? peb->ProcessParameters : NULL;
+    const WCHAR *s;
+    size_t n, base = 0, i;
+    if (!p || !(s = p->ImagePathName.Buffer)) return 0;
+    n = p->ImagePathName.Length / sizeof(*s);
+    for (i = 0; i < n; i++) if (s[i] == '\\' || s[i] == '/') base = i + 1;
+    if (n - base != sizeof(name) - 1) return 0;
+    for (i = 0; i < sizeof(name) - 1; i++) {
+        WCHAR c = s[base + i];
+        if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (c != name[i]) return 0;
+    }
+    return 1;
+}
+
+/* virtual_mutex held, from the existing process teardown after the dead
+ * process's views were released. A grant whose real view is still present
+ * (kept for a parked register) stays owned; nothing else may take it. */
+struct file_view;
+static struct file_view *find_view( const void *addr, size_t size );
+static void ppsc_note_kept_view_locked(int k, void *peb, struct file_view *v); /* pp_sc_vm.h */
+static void ppsc_owner_died_locked(void *peb)
+{
+    int k;
+    if (!peb || !ppsc_ready) return;
+    for (k = PPSC_ELF; k <= PPSC_CAGE; k++) {
+        struct ppsc_range r;
+        struct file_view *v;
+        if (ppsc_owner[k] != peb) continue;
+        r = ppsc_range(k);
+        if ((v = find_view((void *)(uintptr_t)r.base, 0))) {
+            ppsc_note_kept_view_locked(k, peb, v);
+            continue;
+        }
+        ppsc_owner[k] = NULL;
+        if (ppsc_native_hold(r.base, r.size)) ppsc_held |= PPSC_BIT(k);
+        dprintf(2, "[sc-layout] owner %p exited; kind=%d slot %s\n", peb, k,
+                (ppsc_held & PPSC_BIT(k)) ? "held again" : "NOT held again (something mapped it)");
+    }
+}
+
+/* A view inside a layout slot is a Social Club grant, never FEX's band, even
+ * where the slot lies above 0x7c00000000 (Oilpan). */
+static int ppsc_in_slot(uintptr_t base, size_t size)
+{
+    int k;
+    if (!ppsc_ready) return 0;
+    for (k = PPSC_ELF; k <= PPSC_CAGE; k++) {
+        struct ppsc_range r = ppsc_range(k);
+        if (base < r.base + r.size && base + size > r.base) return 1;
+    }
+    return 0;
+}
diff --git a/build/ntdll-unix/pp_sc_vm.h b/build/ntdll-unix/pp_sc_vm.h
new file mode 100644
index 0000000..eb9ef2f
--- /dev/null
+++ b/build/ntdll-unix/pp_sc_vm.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Included after allocate_virtual_memory: the runtime router for layout 2.
+ * Lock order is virtual_mutex only (recursive, with signals blocked). */
+static unsigned ppsc_mine(void *peb)
+{
+    unsigned bits = 0;
+    int k;
+    for (k = PPSC_ELF; k <= PPSC_CAGE; k++) if (ppsc_owner[k] == peb) bits |= PPSC_BIT(k);
+    return bits;
+}
+
+/* virtual_mutex held, from the existing process teardown: what kept a dead
+ * owner's slot view (PLA-476 retained-extent diagnostic, no policy). */
+static void ppsc_note_kept_view_locked(int k, void *peb, struct file_view *v)
+{
+    char *p = v->base, *end = (char *)v->base + v->size;
+    unsigned long long bytes = 0, high = 0;
+    unsigned runs = 0;
+    dprintf(2, "[sc-layout] owner %p exited; kind=%d view kept (view %p+0x%llx owner=%p), slot stays owned\n",
+            peb, k, v->base, (unsigned long long)v->size, v->ios_owner_peb);
+    while (p < end) {
+        BYTE vprot;
+        SIZE_T len = get_vprot_range_size(p, end - p, VPROT_COMMITTED, &vprot);
+        if (!len) break;
+        if (vprot & VPROT_COMMITTED) {
+            runs++;
+            bytes += len;
+            high = (unsigned long long)(p + len - (char *)v->base);
+        }
+        p += len;
+    }
+    dprintf(2, "[sc-layout] kind=%d committed runs=%u bytes=0x%llx highest_end_off=0x%llx\n", k, runs, bytes, high);
+}
+
+/* Whether any of Wine's reserved areas overlaps slot r. */
+static int ppsc_in_reserved_area_locked(struct ppsc_range r)
+{
+    struct reserved_area *area;
+    LIST_FOR_EACH_ENTRY(area, &reserved_areas, struct reserved_area, entry)
+        if ((uintptr_t)area->base < r.base + r.size && (uintptr_t)area->base + area->size > r.base) return 1;
+    return 0;
+}
+
+/* A real view is never made for the overlapping reported tail.
+ *
+ * Between giving back our native hold and placing the view, a native
+ * allocation from outside Wine (virtual_mutex is held, so not Wine's own) can
+ * take part of the slot. The view is then placed by map_fixed_area, which
+ * replaces mappings (anon_mmap_fixed) only inside a Wine reserved area and
+ * elsewhere maps with mach_vm_map VM_FLAGS_FIXED, which fails on any overlap
+ * and replaces nothing. No slot lies in a reserved area (iOS reserves only
+ * below 0x68000000, 0x7f000000..0x7fff0000, from 0x7ffffe000000 and above the
+ * user limit; FEX's arena starts at PPSC_FEX_BASE), and this is checked, not
+ * assumed: a slot in one is refused rather than mapped over. So an intruder
+ * makes the grant fail with STATUS_NO_MEMORY and keeps its memory. */
+static NTSTATUS ppsc_grant(enum ppsc_slot k, SIZE_T asked, void **ret, SIZE_T *size_ptr, ULONG protect)
+{
+    struct ppsc_range r = ppsc_range(k);
+    void *p = (void *)(uintptr_t)r.base;
+    SIZE_T n = r.size;
+    NTSTATUS st;
+    if (!(ppsc_held & PPSC_BIT(k)) || ppsc_owner[k]) return STATUS_NO_MEMORY;
+    if (ppsc_in_reserved_area_locked(r)) {
+        dprintf(2, "[sc-layout] kind=%d slot overlaps a reserved area; not granted, hold kept\n", k);
+        return STATUS_NO_MEMORY;
+    }
+    if (mach_vm_deallocate(mach_task_self(), r.base, r.size) != KERN_SUCCESS) return STATUS_NO_MEMORY;
+    ppsc_held &= ~PPSC_BIT(k);
+    st = allocate_virtual_memory(&p, &n, MEM_RESERVE, protect, 0, 0, 0, 0);
+    if (st) {
+        if (ppsc_native_hold(r.base, r.size)) ppsc_held |= PPSC_BIT(k);
+        dprintf(2, "[sc-layout] kind=%d view not placed (status=%x): something mapped the slot; it was left alone, slot %s\n",
+                k, (unsigned)st, (ppsc_held & PPSC_BIT(k)) ? "held again" : "NOT held again");
+        return STATUS_NO_MEMORY;
+    }
+    /* Fixed allocate_virtual_memory does not relocate. Do not silently accept
+     * a different shape if its contract changes. */
+    if ((uintptr_t)p != r.base || n != r.size) {
+        struct file_view *v = find_view(p, 0);
+        if (v && v->base == p && v->ios_owner_peb == ios_jit_current_peb())
+            free_pages(v, p, n);
+        if (ppsc_native_hold(r.base, r.size)) ppsc_held |= PPSC_BIT(k);
+        return STATUS_NO_MEMORY;
+    }
+    ppsc_owner[k] = ios_jit_current_peb();
+    *ret = (void *)(uintptr_t)r.report;
+    *size_ptr = asked;
+    dprintf(2, "[sc-layout] grant kind=%d owner=%p report=0x%llx+0x%llx real=0x%llx+0x%llx\n", k,
+            ppsc_owner[k], (unsigned long long)r.report, (unsigned long long)asked,
+            (unsigned long long)r.base, (unsigned long long)r.size);
+    return STATUS_SUCCESS;
+}
+
+static int ppsc_route(void **ret, SIZE_T *size, ULONG type, ULONG protect, ULONG_PTR limit,
+                      int extended, NTSTATUS *status)
+{
+    enum ppsc_slot k;
+    sigset_t sigset;
+    unsigned both = PPSC_BIT(PPSC_ELF) | PPSC_BIT(PPSC_CEF);
+    /* ppsc_ready first: off-layout plays never reach the helper's name check. */
+    if (!ppsc_ready || type != MEM_RESERVE || limit || !ppsc_helper()) return 0;
+    server_enter_uninterrupted_section(&virtual_mutex, &sigset);
+    if (extended) {
+        /* As Oilpan's: only the helper that holds both core pools takes the
+         * cage (every logged play asks for it after both). */
+        if (*size != 0x200000000ULL || protect != PAGE_NOACCESS ||
+            !(ppsc_held & PPSC_BIT(PPSC_CAGE)) || (ppsc_mine(ios_jit_current_peb()) & both) != both) {
+            server_leave_uninterrupted_section(&virtual_mutex, &sigset);
+            return 0;
+        }
+        k = PPSC_CAGE;
+    } else {
+        k = ppsc_classify(*size, (uintptr_t)*ret, ppsc_held, ppsc_mine(ios_jit_current_peb()));
+        if (k == PPSC_NONE) {
+            /* Unsupported giant asks must fail, not reach soft-pool granting.
+             * Ordinary small requests keep Wine's normal path. */
+            if (*size < 0x400000000ULL) {
+                server_leave_uninterrupted_section(&virtual_mutex, &sigset);
+                return 0;
+            }
+            k = PPSC_REFUSE;
+        }
+    }
+    *status = k == PPSC_REFUSE ? STATUS_NO_MEMORY : ppsc_grant(k, *size, ret, size, protect);
+    if (*status) dprintf(2, "[sc-layout] refused reserve owner=%p size=0x%llx kind=%d status=%x\n",
+                        ios_jit_current_peb(), (unsigned long long)*size, k, (unsigned)*status);
+    server_leave_uninterrupted_section(&virtual_mutex, &sigset);
+    return 1;
+}
+
+/* Release the real view only. Oilpan shares chrome_elf's reported base; as in
+ * upstream, its later grant is retired first when that reported base is freed.
+ * Refuse partial release of a layout grant, rather than losing its ledger. */
+static int ppsc_free(void **addr, SIZE_T *size, ULONG type, NTSTATUS *status)
+{
+    sigset_t sigset;
+    void *owner;
+    int k, chosen = 0;
+    if (!ppsc_ready || type != MEM_RELEASE) return 0;
+    owner = ios_jit_current_peb();
+    server_enter_uninterrupted_section(&virtual_mutex, &sigset);
+    for (k = PPSC_CAGE; k >= PPSC_ELF; k--) {
+        struct ppsc_range r = ppsc_range(k);
+        if (owner && r.report == (uintptr_t)*addr && ppsc_owner[k] == owner) { chosen = k; break; }
+    }
+    if (chosen) {
+        struct ppsc_range r = ppsc_range(chosen);
+        struct file_view *v = find_view((void *)(uintptr_t)r.base, 0);
+        *status = STATUS_UNABLE_TO_FREE_VM;
+        if (!*size && v && (uintptr_t)v->base == r.base && v->size == r.size && v->ios_owner_peb == owner) {
+            *status = free_pages(v, v->base, v->size);
+            if (!*status) {
+                ppsc_owner[chosen] = NULL;
+                if (ppsc_native_hold(r.base, r.size)) ppsc_held |= PPSC_BIT(chosen);
+                *size = r.asked;
+                dprintf(2, "[sc-layout] released kind=%d owner=%p; real range only\n", chosen, owner);
+            }
+        }
+    }
+    server_leave_uninterrupted_section(&virtual_mutex, &sigset);
+    return chosen != 0;
+}
