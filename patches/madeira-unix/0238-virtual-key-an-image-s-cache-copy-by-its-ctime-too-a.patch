         return FALSE;
-    ppic_name( name, sizeof(name), (uint64_t)st->st_dev, (uint64_t)st->st_ino, (uint64_t)st->st_size,
-               (int64_t)st->st_mtimespec.tv_sec, st->st_mtimespec.tv_nsec, view->size );
