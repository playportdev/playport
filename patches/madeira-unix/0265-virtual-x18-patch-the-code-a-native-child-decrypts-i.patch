+/* Playport (PLA-514): what a cipher 2 run (ios_x18_reachable_map) also knows to be code.
+ * World of Warcraft's ARM64 client decrypts all of its .text in place at once, without a
+ * flush on the way, and then flushes its whole image: reachable from the range's first
+ * word is then almost none of it. Its .pdata lists every function it decrypted, so the
+ * function starts there and what their BL calls reach are code too, inside the 1 KB
+ * windows of .text (from window_rva) the program rewrote since the copy took its bytes.
+ * A window it has not rewritten is left: it is still encrypted, or was patched before.
+ * ios_jit_repatch_x18 sets it for one run under ios_section_view_lock. */
+struct ios_x18_code_hint
+{
+    const uint32_t      *pdata;        /* RUNTIME_FUNCTION entries: BeginAddress, UnwindData */
+    size_t               pdata_count;
+    const unsigned char *rewritten;    /* a bit a window */
+    size_t               window_rva;
+    size_t               windows;
+};
+static const struct ios_x18_code_hint *ios_x18_code_hint;
+
+/* Queue word w of a reachable walk unless it was queued before. 0: out of memory. */
+static int ios_x18_walk_push( uint32_t **stack, size_t *top, size_t *cap, unsigned char *queued, size_t w )
+{
+    if (queued[w >> 3] & (1 << (w & 7))) return 1;
+    if (*top == *cap)
+    {
+        uint32_t *more = realloc( *stack, *cap * 2 * sizeof(**stack) );
+        if (!more) return 0;
+        *stack = more;
+        *cap *= 2;
+    }
+    queued[w >> 3] |= 1 << (w & 7);
+    (*stack)[(*top)++] = (uint32_t)w;
+    return 1;
+}
