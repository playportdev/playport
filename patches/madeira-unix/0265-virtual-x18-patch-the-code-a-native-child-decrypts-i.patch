+/* The code hint of a cipher 2 run over [start, end) of presented copy m (ios_x18_code_hint):
+ * its image's .pdata, and the 1 KB windows of .text there in which a quarter of the words
+ * differ from the backing store of the remap the copy took them from. NULL, with nothing
+ * to free, for an image without a remap or a .pdata. ios_section_view_lock is held. */
+static unsigned char *ios_remap_code_hint( const struct ios_jit_mapping *m, const char *image_rw, size_t start,
+                                           size_t end, struct ios_x18_code_hint *hint, size_t *count )
+{
+    const char *image = (const char *)m->jit_base;
+    const char *opt;
+    unsigned int pe_off, pdata_rva, pdata_size, i;
+    unsigned char *rewritten;
+    size_t w;
+    void *peb = ios_jit_current_peb();
+
+    *count = 0;
+    if (m->size < 0x40) return NULL;
+    pe_off = *(const unsigned int *)(image + 0x3c);
+    if ((size_t)pe_off + 0x18 + 0x70 + 4 * 8 > m->size || memcmp( image + pe_off, "PE\0\0", 4 )) return NULL;
+    opt = image + pe_off + 0x18;
+    if (*(const unsigned short *)opt != 0x20b || *(const unsigned int *)(opt + 0x6c) < 4) return NULL;
+    pdata_rva = *(const unsigned int *)(opt + 0x70 + 3 * 8);                /* the exception directory */
+    pdata_size = *(const unsigned int *)(opt + 0x70 + 3 * 8 + 4);
+    if (!pdata_rva || pdata_size < 8 || (size_t)pdata_rva + pdata_size > m->size) return NULL;
+    hint->pdata = (const uint32_t *)(image + pdata_rva);
+    hint->pdata_count = pdata_size / 8;
+    hint->window_rva = m->text_offset + ((start - m->text_offset) & ~(size_t)1023);
+    hint->windows = (end - hint->window_rva + 1023) / 1024;
+    if (!(rewritten = calloc( 1, hint->windows / 8 + 1 ))) return NULL;
+    hint->rewritten = rewritten;
+    for (w = 0; w < hint->windows; w++)
+    {
+        size_t rva = hint->window_rva + w * 1024, words = (end - rva < 1024 ? end - rva : 1024) / 4, k, differ = 0;
+        const uint32_t *now = (const uint32_t *)(image_rw + rva), *was = NULL;
+
+        for (i = 0; i < ios_section_view_count && !was; i++)
+        {
+            const struct ios_section_view *r = &ios_section_views[i];
+            if (r->peb == peb && r->copy && image + rva >= r->copy && image + rva + words * 4 <= r->copy + r->size)
+                was = (const uint32_t *)(r->base + (image + rva - r->copy));
+        }
+        if (!was) continue;
+        for (k = 0; k < words; k++) differ += now[k] != was[k];
+        if (words && differ * 4 >= words)
+        {
+            rewritten[w / 8] |= 1 << (w % 8);
+            ++*count;
+        }
+    }
+    if (*count) return rewritten;
+    free( rewritten );
+    return NULL;
+}
+
 /* x18-patch size bytes of a presented copy from image offset off, with the rest
  * of the image's trampoline reservation, and flush them. cipher as for
- * ios_jit_patch_x18. ios_section_view_lock is held. */
+ * ios_jit_patch_x18; a cipher 2 run gets the copy's code hint (ios_remap_code_hint).
+ * ios_section_view_lock is held. */
 static void ios_jit_repatch_x18( struct ios_jit_mapping *m, size_t off, size_t size, int cipher )
 {
+    static unsigned long hinted;
     char *image_rw = (char *)ios_jit_rw_base_global + ((char *)m->jit_base - (char *)ios_jit_rx_base_global);
     size_t start = off > m->text_offset ? off : m->text_offset;
     size_t end = off + size < m->text_offset + m->text_size ? off + size : m->text_offset + m->text_size;
-    size_t used = 0;
+    size_t used = 0, rewritten = 0;
 
     if (m->x18_tramp_size && start < end)
     {
+        struct ios_x18_code_hint hint;
+        unsigned char *windows = NULL;
+
         /* the windows of the load's scan, from the start of .text */
         if (cipher == 1) start = m->text_offset + ((start - m->text_offset) & ~(size_t)1023);
         start &= ~(size_t)3;
+        if (cipher == 2 && (windows = ios_remap_code_hint( m, image_rw, start, end, &hint, &rewritten )))
+            ios_x18_code_hint = &hint;
         ios_jit_patch_x18( image_rw + start, (char *)m->jit_base + start, end - start, start,
                            image_rw + m->x18_tramp_off + m->x18_tramp_used,
                            (char *)m->jit_base + m->x18_tramp_off + m->x18_tramp_used,
                            m->x18_tramp_size - m->x18_tramp_used, cipher, &used );
+        ios_x18_code_hint = NULL;
+        free( windows );
         if (used) sys_icache_invalidate( (char *)m->jit_base + m->x18_tramp_off + m->x18_tramp_used, used );
         m->x18_tramp_used += used;
+        if (rewritten && (!(hinted++ & 0xff) || hinted <= 8))
+            dprintf( 2, "[remap] %s: %lu KB of .text at %p+%#lx rewritten since the remap; the functions its .pdata "
+                     "lists there x18-patched (x18 trampolines %#lx of %#lx used)\n",
+                     ios_pe_module_name( m->pe_base, m->image_size ), (unsigned long)rewritten,
+                     (char *)m->jit_base + start, (unsigned long)(end - start), (unsigned long)m->x18_tramp_used,
+                     (unsigned long)m->x18_tramp_size );
     }
     __asm__ __volatile__( "dsb sy" ::: "memory" );
     sys_icache_invalidate( (char *)m->jit_base + off, size );
