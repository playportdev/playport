+/* IP's interface provider shares these scope helpers with upstream TCP.
+ * TCP itself remains served by the in-process wineserver above. */
+struct ipv6_addr_scope *get_ipv6_addr_scope_table( unsigned int *size )
+{
+    struct ifaddrs *addrs, *cur;
+    struct ipv6_addr_scope *table;
+    unsigned int count = 0;
+    *size = 0;
+    if (getifaddrs( &addrs )) return NULL;
+    for (cur = addrs; cur; cur = cur->ifa_next)
+        if (cur->ifa_addr && cur->ifa_addr->sa_family == AF_INET6) ++count;
+    table = calloc( count ? count : 1, sizeof(*table) );
+    if (table)
+        for (cur = addrs; cur; cur = cur->ifa_next)
+        {
+            const struct sockaddr_in6 *addr;
+            if (!cur->ifa_addr || cur->ifa_addr->sa_family != AF_INET6) continue;
+            addr = (const struct sockaddr_in6 *)cur->ifa_addr;
+            memcpy( &table[*size].addr, &addr->sin6_addr, 16 );
+            table[(*size)++].scope = addr->sin6_scope_id;
+        }
+    freeifaddrs( addrs );
+    return table;
+}
+
+UINT find_ipv6_addr_scope( const IN6_ADDR *addr, const struct ipv6_addr_scope *table, unsigned int size )
+{
+    unsigned int i;
+    if (WS_IN6_IS_ADDR_UNSPECIFIED( addr )) return 0;
+    if (WS_IN6_IS_ADDR_MULTICAST( addr )) return htons( addr->u.Byte[1] & 0x0f );
+    for (i = 0; i < size; ++i)
+        if (!memcmp( addr, &table[i].addr, sizeof(*addr) )) return table[i].scope;
+    return ~0u;
+}
+
+/* Use Wine's own NDIS/IP providers: getifaddrs, interface ioctls and the
+ * BSD routing sysctl. The TCP provider above retains wineserver ownership. */
+static const struct module_table *ios_get_table( const NPI_MODULEID *id, UINT_PTR table )
+{
+    const struct module *modules[] = { &ndis_module, &ipv4_module, &ipv6_module };
+    const struct module_table *entry;
+    unsigned int i;
+
+    if (!id || table > ~0u) return NULL;
+    for (i = 0; i < ARRAY_SIZE(modules); ++i)
+        if (NmrIsEqualNpiModuleId( modules[i]->module, id ))
+            for (entry = modules[i]->tables; entry->table != ~0u; ++entry)
+                if (entry->table == table) return entry;
+    return NULL;
+}
+
+NTSTATUS nsi_enumerate_all_ex( struct nsi_enumerate_all_ex *p )
+{
+    const struct module_table *entry = p ? ios_get_table( p->module, p->table ) : NULL;
+    UINT sizes[4];
+    void *data[4];
+    unsigned int i;
+    NTSTATUS status;
+    static unsigned int logged;
+
+    if (!entry || !entry->enumerate_all) return STATUS_NOT_SUPPORTED;
+    sizes[0] = p->key_size; sizes[1] = p->rw_size;
+    sizes[2] = p->dynamic_size; sizes[3] = p->static_size;
+    data[0] = p->key_data; data[1] = p->rw_data;
+    data[2] = p->dynamic_data; data[3] = p->static_data;
+    for (i = 0; i < 4; ++i)
+    {
+        if (!sizes[i]) data[i] = NULL;
+        else if (sizes[i] != entry->sizes[i] || (!data[i] && p->count)) return STATUS_INVALID_PARAMETER;
+    }
+    status = entry->enumerate_all( data[0], sizes[0], data[1], sizes[1],
+                                  data[2], sizes[2], data[3], sizes[3], &p->count );
+    /* Counts/status only: no interface addresses or hardware identifiers. */
+    if (__atomic_fetch_add( &logged, 1, __ATOMIC_RELAXED ) < 24)
+        dprintf( 2, "[nsi-ios] module=%08x table=%u status=%08x count=%lu\n",
+                 (UINT)p->module->Guid.Data1, (UINT)p->table, (UINT)status, (unsigned long)p->count );
+    return status;
+}
+
+NTSTATUS nsi_get_all_parameters_ex( struct nsi_get_all_parameters_ex *p )
+{
+    const struct module_table *entry = p ? ios_get_table( p->module, p->table ) : NULL;
+    if (!entry || !entry->get_all_parameters) return STATUS_NOT_SUPPORTED;
+    if (p->key_size != entry->sizes[0] || (p->key_size && !p->key) ||
+        (p->rw_size && (p->rw_size != entry->sizes[1] || !p->rw_data)) ||
+        (p->dynamic_size && (p->dynamic_size != entry->sizes[2] || !p->dynamic_data)) ||
+        (p->static_size && (p->static_size != entry->sizes[3] || !p->static_data)))
+        return STATUS_INVALID_PARAMETER;
+    return entry->get_all_parameters( p->key, p->key_size,
+                                     p->rw_size ? p->rw_data : NULL, p->rw_size,
+                                     p->dynamic_size ? p->dynamic_data : NULL, p->dynamic_size,
+                                     p->static_size ? p->static_data : NULL, p->static_size );
+}
+
+NTSTATUS nsi_get_parameter_ex( struct nsi_get_parameter_ex *p )
+{
+    const struct module_table *entry = p ? ios_get_table( p->module, p->table ) : NULL;
+    UINT size;
+    if (!entry || !entry->get_parameter) return STATUS_NOT_SUPPORTED;
+    if (p->param_type > NSI_PARAM_TYPE_STATIC || p->key_size != entry->sizes[0] ||
+        (p->key_size && !p->key) || (p->data_size && !p->data)) return STATUS_INVALID_PARAMETER;
+    size = entry->sizes[p->param_type + 1];
+    if (p->data_offset > size || p->data_size > size - p->data_offset) return STATUS_INVALID_PARAMETER;
+    return entry->get_parameter( p->key, p->key_size, p->param_type, p->data, p->data_size, p->data_offset );
+}
+
+/* PE i386 calls carry 32-bit pointers in their owner's guest window. */
+struct ios_nsi_enum32
+{
+    UINT unknown[2], module, table, first_arg, second_arg;
+    UINT key_data, key_size, rw_data, rw_size, dynamic_data, dynamic_size, static_data, static_size, count;
+};
+struct ios_nsi_all32
+{
+    UINT unknown[2], module, table, first_arg, unknown2;
+    UINT key, key_size, rw_data, rw_size, dynamic_data, dynamic_size, static_data, static_size;
+};
+struct ios_nsi_param32
+{
+    UINT unknown[2], module, table, first_arg, unknown2;
+    UINT key, key_size, param_type, data, data_size, data_offset;
+};
+
+static void *ios_nsi_ptr32( UINT ptr, size_t size )
+{
+    uintptr_t base = ios_wow64_current_base();
+    void *host = ios_wow64_to_host( base, ptr );
+    return ios_wow64_host_span( base, host, size ) ? host : NULL;
+}
+
+static NTSTATUS ios_nsi_enum_wow64( void *args )
+{
+    struct ios_nsi_enum32 *p = args;
+    struct nsi_enumerate_all_ex n = {0};
+    NTSTATUS status;
+    n.module = ios_nsi_ptr32( p->module, sizeof(*n.module) );
+    n.table = p->table; n.first_arg = p->first_arg; n.second_arg = p->second_arg;
+    n.key_size = p->key_size; n.rw_size = p->rw_size;
+    n.dynamic_size = p->dynamic_size; n.static_size = p->static_size; n.count = p->count;
+    n.key_data = ios_nsi_ptr32( p->key_data, (size_t)p->key_size * p->count );
+    n.rw_data = ios_nsi_ptr32( p->rw_data, (size_t)p->rw_size * p->count );
+    n.dynamic_data = ios_nsi_ptr32( p->dynamic_data, (size_t)p->dynamic_size * p->count );
+    n.static_data = ios_nsi_ptr32( p->static_data, (size_t)p->static_size * p->count );
+    status = ios_nsi_enumerate_all_ex( &n );
+    p->count = n.count;
+    return status;
+}
+
+static NTSTATUS ios_nsi_all_wow64( void *args )
+{
+    struct ios_nsi_all32 *p = args;
+    struct nsi_get_all_parameters_ex n = {0};
+    n.module = ios_nsi_ptr32( p->module, sizeof(*n.module) );
+    n.table = p->table; n.first_arg = p->first_arg;
+    n.key_size = p->key_size; n.key = ios_nsi_ptr32( p->key, p->key_size );
+    n.rw_size = p->rw_size; n.rw_data = ios_nsi_ptr32( p->rw_data, p->rw_size );
+    n.dynamic_size = p->dynamic_size; n.dynamic_data = ios_nsi_ptr32( p->dynamic_data, p->dynamic_size );
+    n.static_size = p->static_size; n.static_data = ios_nsi_ptr32( p->static_data, p->static_size );
+    return nsi_get_all_parameters_ex( &n );
+}
+
+static NTSTATUS ios_nsi_param_wow64( void *args )
+{
+    struct ios_nsi_param32 *p = args;
+    struct nsi_get_parameter_ex n = {0};
+    n.module = ios_nsi_ptr32( p->module, sizeof(*n.module) );
+    n.table = p->table; n.first_arg = p->first_arg;
+    n.key_size = p->key_size; n.key = ios_nsi_ptr32( p->key, p->key_size );
+    n.param_type = p->param_type; n.data = ios_nsi_ptr32( p->data, p->data_size );
+    n.data_size = p->data_size; n.data_offset = p->data_offset;
+    return nsi_get_parameter_ex( &n );
+}
+
+const void *nsi_unix_call_wow64_funcs[] =
+{
+    (const void *)ios_nsi_enum_wow64,
+    (const void *)ios_nsi_all_wow64,
+    (const void *)ios_nsi_param_wow64,
+};
+
 const void *nsi_unix_call_funcs[] =
 {
     (const void *)ios_nsi_enumerate_all_ex,
+    (const void *)nsi_get_all_parameters_ex,
+    (const void *)nsi_get_parameter_ex,
 };
