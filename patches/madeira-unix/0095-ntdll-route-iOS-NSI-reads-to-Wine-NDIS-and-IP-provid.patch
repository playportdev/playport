 /* iOS-Madeira ml494 (#61 text wall): dwrite's unix side (freetype glyph
  * rasterisation). Without it every __wine_unix_call from dwrite.dll failed,
@@ -7591,6 +7592,7 @@ static NTSTATUS load_builtin_unixlib( void *module, BOOL wow, const void **funcs
             else if (*funcs == (const void *)crypt32_unix_call_funcs) wow_funcs = crypt32_unix_call_wow64_funcs;
