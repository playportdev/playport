             jit_pool_offset += alloc_size;
             ios_pool_last_alloc_reused = 0;
             /* ml89 CONTROL for the POISONED check above: report the same
@@ -3512,6 +3615,7 @@ void *ios_jit_stub_region( unsigned long long near, size_t size, unsigned long l
     dprintf( 2, "[split-stub] stub region rx=%#llx size=%#lx (tail now %#lx)\n", rx, (unsigned long)size,
              (unsigned long)(tail + size) );
     if (near < rx || near - rx > max_dist) return NULL;   /* raced past reach: left unused */
+    ios_pool_room_claim( off, size );
     *rw = (char *)ios_jit_rw_base_global + off;
     return (void *)(uintptr_t)rx;
 }
@@ -11981,6 +12085,7 @@ static inline int mprotect_exec( void *base, size_t size, int unix_prot )
 
                 ERR("iOS JIT pool: RX=%p RW=%p size=0x%lx\n",
                     jit_rx_base, jit_rw_base, (unsigned long)jit_pool_size);
+                ios_pool_room_init( jit_pool_size, jit_pool_offset );
             }
             jit_pool_init_done = 1;
         }
@@ -25064,6 +25169,7 @@ NTSTATUS WINAPI NtAllocateVirtualMemoryEx( HANDLE process, PVOID *ret, SIZE_T *s
         {
             void *jit_rx = (char *)ios_jit_rx_base_global + pool_tail_off;
             void *jit_rw = (char *)ios_jit_rw_base_global + pool_tail_off;
+            ios_pool_room_claim( pool_tail_off, alloc_size );   /* PLA-846: before the NOP prefill */
             *ret = jit_rx;
