diff --git a/build/ntdll-unix/pp_guest_pages.h b/build/ntdll-unix/pp_guest_pages.h
new file mode 100644
index 0000000..59388e4
--- /dev/null
+++ b/build/ntdll-unix/pp_guest_pages.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Host-backed guest pages, serialized by Wine's virtual_mutex: one bit per
+ * PP_GUEST_PAGE page of the window [PP_GUEST_LO, PP_GUEST_HI) that the host
+ * backs now. Wine backs nothing when the host page is under PP_GUEST_PAGE, so
+ * every backed range is a whole number of these pages. Finding, marking and
+ * clearing cost the pages of the range asked about, not the number of backed
+ * ranges, so backing every fresh commit of a host page or more stays cheap.
+ * The bitmap is zero-fill BSS (384 KiB): only the words in use need physical
+ * pages. */
+#ifndef PP_GUEST_PAGES_H
+#define PP_GUEST_PAGES_H
+#include <stdint.h>
+#include <stddef.h>
+#define PP_GUEST_LO 0x7000000000ull
+#define PP_GUEST_HI 0x7c00000000ull
+#define PP_GUEST_PAGE 16384u
+#define PP_GUEST_PAGES ((size_t)((PP_GUEST_HI - PP_GUEST_LO) / PP_GUEST_PAGE))
+#define PP_GUEST_WORDS (PP_GUEST_PAGES / 64)
+
+/* [*lo, *hi) clipped to the window and rounded outward to whole pages; 0 if
+ * nothing of it is in the window. */
+static int pp_guest_clip( uintptr_t *lo, uintptr_t *hi )
+{
+    uintptr_t a = *lo, b = *hi;
+    if (a < PP_GUEST_LO) a = PP_GUEST_LO;
+    if (b > PP_GUEST_HI) b = PP_GUEST_HI;
+    if (a >= b) return 0;
+    *lo = a & ~(uintptr_t)(PP_GUEST_PAGE - 1);
+    *hi = (b + PP_GUEST_PAGE - 1) & ~(uintptr_t)(PP_GUEST_PAGE - 1);
+    return 1;
+}
+/* Sets (set) or clears the pages of [lo, hi): page aligned, inside the window. */
+static void pp_guest_mark( uint64_t *bits, uintptr_t lo, uintptr_t hi, int set )
+{
+    size_t i = (lo - PP_GUEST_LO) / PP_GUEST_PAGE, end = (hi - PP_GUEST_LO) / PP_GUEST_PAGE;
+    for (; i < end; i++)
+    {
+        if (set) bits[i / 64] |= 1ull << (i % 64);
+        else bits[i / 64] &= ~(1ull << (i % 64));
+    }
+}
+/* The first page in [from, end) whose bit equals set, or end (page indices). */
+static size_t pp_guest_next_bit( const uint64_t *bits, size_t from, size_t end, int set )
+{
+    while (from < end)
+    {
+        uint64_t w = set ? bits[from / 64] : ~bits[from / 64];
+        w &= ~0ull << (from % 64);
+        if (w)
+        {
+            size_t at = (from & ~(size_t)63) + (size_t)__builtin_ctzll( w );
+            return at < end ? at : end;
+        }
+        from = (from & ~(size_t)63) + 64;
+    }
+    return end;
+}
+/* The first run of backed pages in [*lo, hi) (page aligned, inside the window):
+ * returns 1 with the run in [*lo, *run_end), or 0 when there is none. */
+static int pp_guest_next_run( const uint64_t *bits, uintptr_t *lo, uintptr_t hi, uintptr_t *run_end )
+{
+    size_t from = (*lo - PP_GUEST_LO) / PP_GUEST_PAGE, end = (hi - PP_GUEST_LO) / PP_GUEST_PAGE;
+    size_t a = pp_guest_next_bit( bits, from, end, 1 ), b;
+    if (a >= end) return 0;
+    b = pp_guest_next_bit( bits, a, end, 0 );
+    *lo = PP_GUEST_LO + a * PP_GUEST_PAGE;
+    *run_end = PP_GUEST_LO + b * PP_GUEST_PAGE;
+    return 1;
+}
+static int pp_guest_backed( const uint64_t *bits, uintptr_t va )
+{
+    size_t i;
+    if (va < PP_GUEST_LO || va >= PP_GUEST_HI) return 0;
+    i = (va - PP_GUEST_LO) / PP_GUEST_PAGE;
+    return (int)(bits[i / 64] >> (i % 64)) & 1;
+}
+#endif
