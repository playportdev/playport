+        int prio = 0, base = 0, slot = -1, si;
+        s->getbuf_logged = 1;
+        ios_current_win_thread(&pid, &wtid, &prio, &base);
+        for (si = 0; si < IOS_MAX_STREAMS; si++)
+            if (atomic_load_explicit(&g_mix[si], memory_order_relaxed) == s) { slot = si; break; }
+        fprintf(stderr, "[ios_audio] getbuf-thread stream=%p slot=%d pid=%04x win_tid=%04x thread=%llu port=%#x "
+                "priority=%d base=%d qos=%#x frames=%u rate=%u ch=%u\n",
+                (void *)s, slot, pid, wtid, ios_current_tid(), (unsigned)pthread_mach_thread_np(pthread_self()),
+                prio, base, (unsigned)qos_class_self(), p->frames, s->sample_rate, s->channels);
+    }
     if (ios_stream_is_live(s)) {
         uint64_t padding = atomic_load(&s->write_pos) - atomic_load(&s->play_pos);
         if (p->frames + padding > s->buffer_frames) {
@@ -1106,10 +1144,24 @@ static NTSTATUS ios_release_render_buffer(void *args) {
          * the source data (mean level high and flat, peaks saturating) or made
          * later (clean source, noisy output). One line per stream per ~10 s. */
         {
-            static struct { uint64_t frames, clip; double sum_abs; float peak; time_t last; } st[IOS_MAX_STREAMS];
+            static struct { uint64_t frames, clip; double sum_abs; float peak; time_t last;
+                            /* Playport (PLA-364): this window's frames written, its start, its longest
+                             * gap between two ReleaseBuffers, and the underrun counts at its start */
+                            const void *owner; uint64_t written, start_mach, max_gap_mach, cbs, shorts, under; } st[IOS_MAX_STREAMS];
             int slot = -1, si;
+            uint64_t now_mach = mach_absolute_time();
             for (si = 0; si < IOS_MAX_STREAMS; si++) if (atomic_load_explicit(&g_mix[si], memory_order_relaxed) == s) { slot = si; break; }
             if (slot >= 0 && slot < IOS_MAX_STREAMS && s->channels) {
+                if (st[slot].owner != s) {   /* a new stream in this slot: its own baseline */
+                    st[slot].owner = s; st[slot].written = 0; st[slot].start_mach = now_mach; st[slot].max_gap_mach = 0;
+                    st[slot].cbs = atomic_load_explicit(&s->mix_callbacks, memory_order_relaxed);
+                    st[slot].shorts = atomic_load_explicit(&s->short_callbacks, memory_order_relaxed);
+                    st[slot].under = atomic_load_explicit(&s->underrun_frames, memory_order_relaxed);
+                }
+                if (s->last_release_mach && now_mach - s->last_release_mach > st[slot].max_gap_mach)
+                    st[slot].max_gap_mach = now_mach - s->last_release_mach;
+                s->last_release_mach = now_mach;
+                st[slot].written += n;
                 UINT32 f2, c2, step = n > 4096 ? n / 4096 : 1;
                 for (f2 = 0; f2 < n; f2 += step) {
                     const BYTE *fr = s->render_scratch + (size_t)f2 * fb;
@@ -1129,10 +1181,28 @@ static NTSTATUS ios_release_render_buffer(void *args) {
                             w[0], w[1], w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11]);
                 }
                 if (time(NULL) - st[slot].last >= 10 && st[slot].frames) {
-                    fprintf(stderr, "[ios_audio] ml1065 slot=%d source: %llu samples, mean|x|=%.4f peak=%.3f clipped=%llu (rate %u ch %u float=%d bits=%d)\n",
+                    /* Playport (PLA-364): with diagnostics, the window's length, the frames
+                     * written against real time, the RT callbacks and those short of frames,
+                     * the stream frames they lacked, and the longest ReleaseBuffer gap */
+                    char under[256] = "";
+                    uint64_t cbs = atomic_load_explicit(&s->mix_callbacks, memory_order_relaxed);
+                    uint64_t shorts = atomic_load_explicit(&s->short_callbacks, memory_order_relaxed);
+                    uint64_t missing = atomic_load_explicit(&s->underrun_frames, memory_order_relaxed);
+                    if (ios_audio_diagnostics()) {
+                        double window_s = mach_to_ns(now_mach - st[slot].start_mach) / 1e9;
+                        snprintf(under, sizeof(under), " | stream=%p window=%.1fs written=%llu delivery=%.0f%% callbacks=%llu "
+                                 "short_callbacks=%llu underrun_frames=%llu max_release_gap_ms=%.0f",
+                                 (void *)s, window_s, (unsigned long long)st[slot].written,
+                                 window_s >= 1.0 && s->sample_rate ? 100.0 * st[slot].written / (window_s * s->sample_rate) : 0.0,
+                                 (unsigned long long)(cbs - st[slot].cbs), (unsigned long long)(shorts - st[slot].shorts),
+                                 (unsigned long long)(missing - st[slot].under), mach_to_ns(st[slot].max_gap_mach) / 1e6);
+                    }
+                    fprintf(stderr, "[ios_audio] ml1065 slot=%d source: %llu samples, mean|x|=%.4f peak=%.3f clipped=%llu (rate %u ch %u float=%d bits=%d)%s\n",
                             slot, (unsigned long long)st[slot].frames, st[slot].sum_abs / (double)st[slot].frames, st[slot].peak,
-                            (unsigned long long)st[slot].clip, s->sample_rate, s->channels, s->is_float, s->sample_bits);
+                            (unsigned long long)st[slot].clip, s->sample_rate, s->channels, s->is_float, s->sample_bits, under);
                     st[slot].frames = 0; st[slot].sum_abs = 0; st[slot].peak = 0; st[slot].clip = 0; st[slot].last = time(NULL);
+                    st[slot].written = 0; st[slot].start_mach = now_mach; st[slot].max_gap_mach = 0;
