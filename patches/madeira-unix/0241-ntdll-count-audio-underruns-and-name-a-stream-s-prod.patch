--- a/build/ntdll-unix/audio_null_ios.c
+++ b/build/ntdll-unix/audio_null_ios.c
@@ -33,6 +33,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include <pthread.h>
+#include <pthread/qos.h>
 #include <mach/mach_time.h>
 #include <unistd.h>
 #include <time.h>
@@ -305,6 +306,12 @@ struct ios_stream {
     BYTE *ring;
     _Atomic uint64_t write_pos;  /* frames produced by the game (monotonic) */
     _Atomic uint64_t play_pos;   /* frames consumed by the RT callback */
+    /* Playport (PLA-364): what the RT callback lacked while the stream was
+     * started: callbacks, those that found fewer frames than they needed,
+     * and the stream frames missing. Reported on the ml1065 line. */
+    _Atomic uint64_t mix_callbacks, short_callbacks, underrun_frames;
+    int getbuf_logged;           /* the first GetBuffer caller is logged */
+    uint64_t last_release_mach;  /* the previous ReleaseBuffer with frames */
 };
 
 #include "audio_wow64_buffer.h"
@@ -502,7 +509,12 @@ static void ios_mix_stream(struct ios_stream *s, float *out, UInt32 nframes,
     /* frames of THIS stream that cover nframes of device time */
     if (s->sample_rate == dev_rate) need = nframes;
     else need = ((uint64_t)nframes * s->sample_rate + dev_rate - 1) / dev_rate;
-    if (avail < need) need = avail;
+    atomic_fetch_add_explicit(&s->mix_callbacks, 1, memory_order_relaxed);
+    if (avail < need) {
+        atomic_fetch_add_explicit(&s->short_callbacks, 1, memory_order_relaxed);
+        atomic_fetch_add_explicit(&s->underrun_frames, need - avail, memory_order_relaxed);
+        need = avail;
+    }
 
     for (f = 0; f < nframes; f++)
     {
@@ -797,6 +809,18 @@ static int ios_stream_is_live(const struct ios_stream *s)
     return s->mixable && g_dev.au != NULL;
 }
 
+/* Playport (PLA-364): the measurement lines below are off when
+ * MADEIRA_NO_DIAGNOSTICS is set (the host app's release build). */
+static int ios_audio_diagnostics(void)
+{
+    static int state = -1;
+    if (state < 0) state = getenv("MADEIRA_NO_DIAGNOSTICS") == NULL;
+    return state;
+}
+
+/* thread_ios.c: the calling thread's Windows ids and priorities */
+extern void ios_current_win_thread(unsigned int *pid, unsigned int *tid, int *priority, int *base_priority);
+
 /* ---------------------------------------------------------------- */
 
