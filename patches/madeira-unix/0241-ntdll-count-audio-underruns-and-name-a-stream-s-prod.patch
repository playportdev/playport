diff --git a/build/ntdll-unix/thread_ios.c b/build/ntdll-unix/thread_ios.c
index 556acdd..30968c5 100644
--- a/build/ntdll-unix/thread_ios.c
+++ b/build/ntdll-unix/thread_ios.c
@@ -3062,6 +3062,23 @@ NTSTATUS WINAPI NtQueryInformationThread( HANDLE handle, THREADINFOCLASS class,
  * applies none on iOS; log the first 200 requests (the caller's TID, the
  * target's, the class and value) so a title's priorities can be read beside
  * the [xp-qos] census. Measurement only. */
+/* Playport (PLA-364): the calling thread's Windows process and thread ids
+ * and its current and base priority, for audio_null_ios.c's getbuf-thread
+ * line, which includes no Wine header */
+void ios_current_win_thread( unsigned int *pid, unsigned int *tid, int *priority, int *base_priority );
+void ios_current_win_thread( unsigned int *pid, unsigned int *tid, int *priority, int *base_priority )
+{
+    THREAD_BASIC_INFORMATION tbi;
+    *pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    *tid = HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+    *priority = *base_priority = 0;
+    if (!NtQueryInformationThread( GetCurrentThread(), ThreadBasicInformation, &tbi, sizeof(tbi), NULL ))
+    {
+        *priority = tbi.Priority;
+        *base_priority = tbi.BasePriority;
+    }
+}
+
