From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Sat, 3 Oct 2026 23:44:10 +0200
Subject: [PATCH] signal: emulate LD1 and ST1 lanes in the low-fault emulator

FEX reaches an i386 guest's x87 and SSE stack slots with LD1/ST1 single
structure lane accesses; where FEX does not translate the address (the
stack, for now), the access faults low and the window's emulator did
not know the encoding, so Portal 2's engine.dll faulted in its
initialization ("ld1 {v16.d}[0], [x20]"). Emulate one B/H/S/D lane of
Vt, the other lanes kept on a load, and classify it like the other
SIMD accesses; the post-index, multi-register and replicate forms stay
unhandled.

Class: feature
Evidence: docs/evidence/2026-10-03-portal2-wow64-pointers.md
Offered-upstream: no; the WoW64 window exists only on the iOS port
---
 build/ntdll-unix/signal_arm64_ios.c | 56 +++++++++++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/build/ntdll-unix/signal_arm64_ios.c b/build/ntdll-unix/signal_arm64_ios.c
index f6f8f96..041b7c0 100644
--- a/build/ntdll-unix/signal_arm64_ios.c
+++ b/build/ntdll-unix/signal_arm64_ios.c
@@ -10329,10 +10329,44 @@ static inline uint64_t ios_get_reg(ucontext_t *ctx, int r)
     return REGn_sig(r, ctx);
 }
 
+/* Playport: LD1/ST1 (single structure, no offset), one B/H/S/D lane of Vt,
+ * which FEX uses for i386 x87 and SSE accesses. Returns the lane's width and
+ * byte offset in Vt, or 0 for any other encoding (LD3/ST3, replicate, the
+ * post-index forms). */
+static int ios_simd_lane( uint32_t insn, int *offset )
+{
+    const int opcode = (insn >> 13) & 7, s = (insn >> 12) & 1, size = (insn >> 10) & 3;
+    const int q = (insn >> 30) & 1;
+
+    if ((insn & 0xBFBF0000) != 0x0D000000) return 0;
+    switch (opcode)
+    {
+    case 0: *offset = (q << 3) | (s << 2) | size; return 1;
+    case 2:
+        if (size & 1) return 0;
+        *offset = 2 * ((q << 2) | (s << 1) | (size >> 1));
+        return 2;
+    case 4:
+        if (size == 0) { *offset = 4 * ((q << 1) | s); return 4; }
+        if (size == 1 && !s) { *offset = 8 * q; return 8; }
+        return 0;
+    }
+    return 0;
+}
+
 static int ios_emulate_store(ucontext_t *ctx, uint32_t insn, uintptr_t rw_addr)
 {
     int rt = insn & 0x1F;
     uint64_t rt_val = ios_get_reg(ctx, rt);
+    int lane, lane_bytes;
+
+    /* ST1 (single structure): one lane of Vt */
+    if ((lane_bytes = ios_simd_lane( insn, &lane )) && !(insn & (1u << 22)))
+    {
+        if (!ios_neon_valid) return 0;
+        memcpy( (void *)rw_addr, (const unsigned char *)&ctx->uc_mcontext->__ns.__v[rt] + lane, lane_bytes );
+        return 1;
+    }
 
     /* STR/STRB/STRH (unsigned offset):
      * size[31:30] 111 0 01 00 imm12 Rn Rt
@@ -10918,6 +10952,17 @@ static int ios_emulate_load( ucontext_t *ctx, uint32_t insn, uintptr_t rd_addr )
         return 1;
     }
 
+    /* LD1 (single structure): one lane of Vt, the others kept */
+    {
+        int lane, lane_bytes;
+        if ((lane_bytes = ios_simd_lane( insn, &lane )) && (insn & (1u << 22)))
+        {
+            if (!ios_neon_valid) return 0;
+            memcpy( (unsigned char *)&ctx->uc_mcontext->__ns.__v[rt] + lane, (const void *)rd_addr, lane_bytes );
+            return 1;
+        }
+    }
+
     return 0;
 }
 
@@ -11141,6 +11186,17 @@ static int ios_subfloor_classify( uint32_t insn, unsigned *bytes, int *is_write
         return 1;
     }
 
+    {
+        int lane;
+        unsigned lane_bytes = ios_simd_lane( insn, &lane );                /* LD1/ST1 lane */
+        if (lane_bytes)
+        {
+            *bytes    = lane_bytes;
+            *is_write = !(insn & (1u << 22));
+            return 1;
+        }
+    }
+
     /* ---- ios_emulate_store_rel: release / exclusive / LSE ---- */
     if ((insn & 0x3FFFFC00) == 0x089FFC00 ||                        /* STLR*   */
         (insn & 0x3FFFFC00) == 0x089F7C00 ||                        /* STLLR*  */
