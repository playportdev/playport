@@ -1203,6 +1209,56 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
         }
         goto done;
     }
+#ifdef WINE_IOS
+    /* Decision 0150: host capability is compiled out of release. Do not select
