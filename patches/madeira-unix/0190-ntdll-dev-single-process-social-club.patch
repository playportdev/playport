+int pp_sc_single_preflight( int fd )
+{
+    IMAGE_DOS_HEADER dos;
+    IMAGE_NT_HEADERS nt;
+    IMAGE_SECTION_HEADER sec[96];
+    struct stat st;
+    char *image = NULL;
+    const char *why = "malformed or truncated PE file";
+    ULONG64 vtbase;
+    unsigned int i, j;
+    size_t section_offset;
