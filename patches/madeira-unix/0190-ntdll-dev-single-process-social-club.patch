+        dos.e_magic != IMAGE_DOS_SIGNATURE || dos.e_lfanew < sizeof(dos) ||
+        (unsigned long long)dos.e_lfanew + sizeof(nt) > (unsigned long long)st.st_size ||
+        pread( fd, &nt, sizeof(nt), dos.e_lfanew ) != sizeof(nt) || nt.Signature != IMAGE_NT_SIGNATURE)
+        goto done;
+    if (nt.FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 ||
+        nt.OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
+        nt.FileHeader.TimeDateStamp != IOS_SCH_STAMP || nt.OptionalHeader.SizeOfImage != IOS_SCH_SIZE)
+    {
+        why = "another build (TimeDateStamp / SizeOfImage / machine)";
+        goto done;
+    }
+    section_offset = dos.e_lfanew + offsetof(IMAGE_NT_HEADERS, OptionalHeader) + nt.FileHeader.SizeOfOptionalHeader;
+    if (nt.FileHeader.SizeOfOptionalHeader != sizeof(nt.OptionalHeader) ||
+        !nt.FileHeader.NumberOfSections || nt.FileHeader.NumberOfSections > ARRAY_SIZE(sec) ||
+        section_offset + nt.FileHeader.NumberOfSections * sizeof(sec[0]) > (size_t)st.st_size ||
+        nt.OptionalHeader.SizeOfHeaders > IOS_SCH_SIZE ||
+        nt.OptionalHeader.SizeOfHeaders < section_offset + nt.FileHeader.NumberOfSections * sizeof(sec[0]) ||
+        nt.OptionalHeader.SectionAlignment != 0x1000 || nt.OptionalHeader.FileAlignment != 0x200 ||
+        pread( fd, sec, nt.FileHeader.NumberOfSections * sizeof(sec[0]), section_offset ) !=
+            nt.FileHeader.NumberOfSections * sizeof(sec[0])) goto done;
+    if (!(image = calloc( 1, IOS_SCH_SIZE ))) { why = "no memory for preflight"; goto done; }
+    if (pread( fd, image, nt.OptionalHeader.SizeOfHeaders, 0 ) != nt.OptionalHeader.SizeOfHeaders) goto done;
