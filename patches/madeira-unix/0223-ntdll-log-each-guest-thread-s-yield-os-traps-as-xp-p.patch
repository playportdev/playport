From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Thu, 29 Oct 2026 07:45:28 +0100
Subject: [PATCH] ntdll: log each guest thread's yield-os traps as [xp-pause]

Under MADEIRA_FEX_PAUSE=yield-os FEX now counts, in each guest thread's
CpuStateFrame, its swtch_pri traps, those under 2 us and the timer
ticks spent in them (patches/fex 0085). Whether the traps took The
Witcher 3's RenderThread off its core was the open question of PLA-462.

Under that mode only, the [xp] sampler reads the three counters every
250 ms tick through TEB+0x1788 (ChpeV2CpuAreaInfo) and +0x30 (the
frame) with ios_ts_read, and logs [xp-pause]: each thread with traps
this tick, by Windows TID as in [xp-t], with traps / short traps / ms
inside them. Nothing a thread does changes; without the mode nothing
is read or logged.

Linear: PLA-462
Class: diagnostics
Evidence: tools/tests/test_perf.py (test_yield_os_traps), tools/tests/test_fex_pause_yield_os.py
Offered-upstream: no
---
 build/ntdll-unix/server_ios.c | 61 ++++++++++++++++++++++++++++++++---
 1 file changed, 56 insertions(+), 5 deletions(-)

diff --git a/build/ntdll-unix/server_ios.c b/build/ntdll-unix/server_ios.c
index ff601c9..d821631 100644
--- a/build/ntdll-unix/server_ios.c
+++ b/build/ntdll-unix/server_ios.c
@@ -1073,10 +1073,32 @@ struct ios_xp_pe { int64_t magic, qpf, pres_enq, pres_done, t_thr, n_ecl, t_ecl,
                    t_flush, n_lat, t_lat, t_draw, t_cmt, t_pool, ecl_calls, t_ecl_caller; };
 struct ios_xp_tcd { uint64_t instr, cyc, ut, st, nj; };
 struct ios_xp_tc { uint16_t len, r0; uint32_t r1; struct ios_xp_tcd c[4]; };
-struct ios_xp_prev { uint64_t tid; uint32_t gen; struct ios_xp_tcd c[2]; };
-struct ios_xp_row { uint64_t tid; uint32_t wtid; double p_ms, e_ms, p_ghz, e_ghz, minst; const char *role; };
+struct ios_xp_prev { uint64_t tid; uint32_t gen; struct ios_xp_tcd c[2]; uint64_t pause[3]; };
+struct ios_xp_row { uint64_t tid; uint32_t wtid; double p_ms, e_ms, p_ghz, e_ghz, minst; const char *role;
+                    uint64_t pause_traps, pause_short; double pause_ms; };
 static struct ios_xp_prev ios_xp_tab[2048];
 
+/* Playport (PLA-462): under MADEIRA_FEX_PAUSE=yield-os FEX counts, in each guest thread's CpuStateFrame,
+ * its swtch_pri traps, those under 2 us, and the generic-timer ticks (mach_absolute_time's) spent in
+ * them (patches/fex 0085, IosPauseYieldOs.h). The frame is TEB+0x1788 (ChpeV2CpuAreaInfo) -> +0x30
+ * (EmulatorData[0]); the counters' offsets are pinned by static_asserts in FEX's ARM64EC Module.cpp.
+ * Read only under that mode, every [xp] tick, and logged as [xp-pause]. */
+#define IOS_XP_PAUSE_TRAPS 3888   /* IosPauseTraps, IosPauseShort, IosPauseTicks follow */
+static int ios_xp_pause_on = -1;
+static int ios_xp_pause_read( uint64_t teb, uint64_t out[3] )
+{
+    uint64_t area = 0, frame = 0;
+    if (ios_xp_pause_on < 0)
+    {
+        const char *v = getenv( "MADEIRA_FEX_PAUSE" );
+        ios_xp_pause_on = v && !strncmp( v, "yield-os", 8 );
+    }
+    if (!ios_xp_pause_on || !teb) return 0;
+    if (!ios_ts_read( teb + 0x1788, &area, 8 ) || !area) return 0;
+    if (!ios_ts_read( area + 0x30, &frame, 8 ) || !frame) return 0;
+    return ios_ts_read( frame + IOS_XP_PAUSE_TRAPS, out, 24 );
+}
+
 /* ml1131: [xp-api] REPORTER (measurement only). Once a second, from the xprobe
  * thread: FEX's x64->EC transition counters and sampled call targets (exported
  * IosXpFex in xtajit64.dll), the PE ntdll's contended-lock / wait-on-address /
@@ -1847,6 +1869,7 @@ static void ios_xprobe_main( void )
                 thread_identifier_info_data_t idi; mach_msg_type_number_t cnt = THREAD_IDENTIFIER_INFO_COUNT;
                 struct ios_xp_tc tc; int got, h, lv;
                 struct ios_xp_prev *pv = NULL;
+                uint64_t pz[3] = { 0, 0, 0 };
                 if (thread_info( th[k], THREAD_IDENTIFIER_INFO, (thread_info_t)&idi, &cnt ) == KERN_SUCCESS)
                 {
                     memset( &tc, 0, sizeof(tc) );
@@ -1854,6 +1877,9 @@ static void ios_xprobe_main( void )
                     if (got > 0 && tc.len >= 1)
                     {
                         struct ios_xp_tcd cur[2]; int nl = tc.len > 2 ? 2 : tc.len;
+                        pthread_t pt_ = pthread_from_mach_thread_np( th[k] );
+                        uint64_t teb = pt_ ? ios_ts_teb( pt_ ) : 0;
+                        int got_pz = ios_xp_pause_read( teb, pz );
                         memset( cur, 0, sizeof(cur) );
                         for (lv = 0; lv < nl; lv++) cur[lv] = tc.c[lv];
                         for (h = (int)(idi.thread_id * 2654435761u) & 2047, j = 0; j < 2048; j++, h = (h + 1) & 2047)
@@ -1866,9 +1892,14 @@ static void ios_xprobe_main( void )
                             double pcy = (double)(cur[0].cyc - pv->c[0].cyc), ecy = (double)(cur[1].cyc - pv->c[1].cyc);
                             if (pt + et > 0.05)
                             {
-                                pthread_t pt_ = pthread_from_mach_thread_np( th[k] );
-                                uint64_t teb = pt_ ? ios_ts_teb( pt_ ) : 0; uint32_t w = 0;
+                                uint32_t w = 0;
                                 if (teb) ios_ts_read( teb + 0x48, &w, 4 );
+                                r->pause_traps = r->pause_short = 0; r->pause_ms = 0;
+                                if (got_pz && pz[0] >= pv->pause[0] && pz[1] >= pv->pause[1] && pz[2] >= pv->pause[2])
+                                {
+                                    r->pause_traps = pz[0] - pv->pause[0]; r->pause_short = pz[1] - pv->pause[1];
+                                    r->pause_ms = XP_MS( pz[2] - pv->pause[2] );
+                                }
                                 r->tid = idi.thread_id; r->wtid = w; r->p_ms = pt; r->e_ms = et;
                                 if (!w && pt_ && pt + et >= 2.0) ios_xp_name_native( pt_, idi.thread_id );
                                 r->p_ghz = pt > 0 ? pcy / (pt * 1e6) : 0; r->e_ghz = et > 0 ? ecy / (et * 1e6) : 0;
@@ -1880,7 +1911,8 @@ static void ios_xprobe_main( void )
                                 sum_thr_ms += pt + et; nrows++;
                             }
                         }
-                        if (pv) { if (!pv->tid) used++; pv->tid = idi.thread_id; pv->gen = gen; pv->c[0] = cur[0]; pv->c[1] = cur[1]; }
+                        if (pv) { if (!pv->tid) used++; pv->tid = idi.thread_id; pv->gen = gen; pv->c[0] = cur[0]; pv->c[1] = cur[1];
+                                  memcpy( pv->pause, pz, sizeof(pz) ); }
                     }
                 }
                 mach_port_deallocate( mach_task_self(), th[k] );
@@ -1947,6 +1979,25 @@ static void ios_xprobe_main( void )
                 }
                 wine_log_write( "%s", line );
             }
+            /* Playport (PLA-462): the yield-os traps of each guest thread this tick, most first; Windows TID :
+             * traps / under 2 us / ms inside them */
+            if (ios_xp_pause_on > 0)
+            {
+                int printed[1024] = {0}, shown = 0;
+                n = snprintf( line, sizeof(line), "[xp-pause] %s", wall );
+                while (shown < 16 && n < (int)sizeof(line) - 48)
+                {
+                    int best = -1;
+                    for (i = 0; i < nrows; i++)
+                        if (!printed[i] && rows[i].pause_traps && (best < 0 || rows[i].pause_traps > rows[best].pause_traps)) best = i;
+                    if (best < 0) break;
+                    printed[best] = 1; shown++;
+                    n += snprintf( line + n, sizeof(line) - n, " -%04x:%llu/%llu/%.2f", rows[best].wtid,
+                                   (unsigned long long)rows[best].pause_traps, (unsigned long long)rows[best].pause_short,
+                                   rows[best].pause_ms );
+                }
+                if (shown) wine_log_write( "%s", line );
+            }
             if (!(gen & 3)) ios_xp_api_report( wall, XP_MS( now - t_start ) / 1000.0 );   /* ml1131: ~1 s */
             if (!(gen & 3)) ios_srv_report( wall, XP_MS( now - t_start ) / 1000.0 );      /* Playport: ~1 s */
             if (gen % 80 == 8) ios_xp_qos_census( wall );                                 /* Playport: ~20 s */
