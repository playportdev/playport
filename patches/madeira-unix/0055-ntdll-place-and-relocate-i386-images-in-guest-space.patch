diff --git a/build/ntdll-unix/wow64_placement.h b/build/ntdll-unix/wow64_placement.h
new file mode 100644
index 0000000..e91edad
--- /dev/null
+++ b/build/ntdll-unix/wow64_placement.h
@@ -0,0 +1,166 @@
+/* Guest-space PE placement and relocation validation, not a second loader.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Wine types, wow64_window/views/image.h and relocation helpers precede this.
+ * virtual_mutex must be held; no registry queries or signal-handler callers.
+ */
+#ifndef IOS_WOW64_PLACEMENT_H
+#define IOS_WOW64_PLACEMENT_H
+
+static BOOL ios_wow64_image_fits( uint64_t guest, size_t size, uint64_t low, uint64_t end )
+{
+    return guest >= low && guest < end && !(guest & granularity_mask) && size <= end - guest;
+}
+
+/* Walk the reservation by containing views, not Wine's host free ranges.
+ * Those ranges correctly see the entire window as unavailable. */
+static NTSTATUS ios_wow64_image_gap( uintptr_t window, size_t size, uint64_t low,
+                                    uint64_t end, BOOL top_down, uint32_t *guest )
+{
+    uint64_t pos = top_down ? end : low;
+    while (top_down ? pos > low : pos < end)
+    {
+        struct file_view *view = find_view( (void *)(window + (top_down ? pos - 1 : pos)), 1 );
+        uint64_t start, stop, candidate;
+        if (!view || (uintptr_t)view->base < window) return STATUS_CONFLICTING_ADDRESSES;
+        start = (uintptr_t)view->base - window;
+        if (start >= IOS_WOW64_WINDOW_SIZE || view->size > IOS_WOW64_WINDOW_SIZE - start)
+            return STATUS_CONFLICTING_ADDRESSES;
+        stop = start + view->size;
+        if (view->protect == VPROT_WOW64_HOLE)
+        {
+            start = max( start, low );
+            stop = min( stop, end );
+            if (size <= stop - start)
+            {
+                candidate = top_down ? (stop - size) & ~(uint64_t)granularity_mask :
+                                       (start + granularity_mask) & ~(uint64_t)granularity_mask;
+                if (ios_wow64_image_fits( candidate, size, start, stop ))
+                {
+                    *guest = candidate;
+                    return STATUS_SUCCESS;
+                }
+            }
+        }
+        pos = top_down ? (uintptr_t)view->base - window : stop;
+    }
+    return STATUS_CONFLICTING_ADDRESSES;
+}
+
+static NTSTATUS ios_wow64_place_image( uintptr_t window, struct pe_image_info *image, size_t size,
+                                      uint64_t low, uint64_t high, struct file_view **result )
+{
+    struct pe_image_info placement;
+    NTSTATUS status;
+    uint64_t end, suggested;
+    uint32_t guest;
+    BOOL movable, top_down;
+
+    if (!image || !result || !ios_wow64_valid_base( window ) ||
+        !size || size > SIZE_MAX - host_page_mask) return STATUS_INVALID_PARAMETER;
+    size = (size + host_page_mask) & ~host_page_mask;
+    end = (image->image_charact & IMAGE_FILE_LARGE_ADDRESS_AWARE) ?
+          IOS_WOW64_WINDOW_SIZE : UINT64_C(0x80000000);
+    /* Preserve fixed-placement validation: malformed preferred addresses are
+     * not silently repaired by choosing another guest address. */
+    if (image->machine != IMAGE_FILE_MACHINE_I386 ||
+        !ios_wow64_image_fits( image->base, size, IOS_WOW64_NULL_GUARD, end ))
+        return STATUS_INVALID_PARAMETER;
+    if (high) end = min( end, high == UINT64_MAX ? high : high + 1 );
+    low = max( low, IOS_WOW64_NULL_GUARD );
+    if (low >= end || size > end - low) return STATUS_CONFLICTING_ADDRESSES;
+    movable = !(image->image_charact & IMAGE_FILE_RELOCS_STRIPPED) &&
+              !(image->image_flags & IMAGE_FLAGS_ImageMappedFlat);
+    top_down = (image->image_charact & IMAGE_FILE_DLL) &&
+               (image->image_flags & IMAGE_FLAGS_ImageDynamicallyRelocated);
+    suggested = image->map_addr;
+    placement = *image;
+    if (movable && (image->image_flags & IMAGE_FLAGS_ImageDynamicallyRelocated) &&
+        suggested != image->base && ios_wow64_image_fits( suggested, size, low, end ))
+    {
+        placement.base = suggested;
+        status = ios_wow64_claim_image( window, &placement, size, result );
+        if (!status) { image->map_addr = suggested; return status; }
+        if (status != STATUS_CONFLICTING_ADDRESSES) return status;
+    }
+    if (ios_wow64_image_fits( image->base, size, low, end ))
+    {
+        placement.base = image->base;
+        status = ios_wow64_claim_image( window, &placement, size, result );
+        if (!status) { image->map_addr = image->base; return status; }
+        if (status != STATUS_CONFLICTING_ADDRESSES) return status;
+    }
+    if (!movable) return STATUS_CONFLICTING_ADDRESSES;
+    status = ios_wow64_image_gap( window, size, low, end, top_down, &guest );
+    if (status) return status;
+    placement.base = guest;
+    status = ios_wow64_claim_image( window, &placement, size, result );
+    if (!status) image->map_addr = guest;
+    return status;
+}
+
+/* Validate the whole i386 directory before Wine mutates any target. Storage
+ * uses host addresses, but HIGH/LOW/HIGHLOW receive ONLY the guest delta.
+ * Unknown types, missing fixups and malformed blocks fail closed. */
+static NTSTATUS ios_wow64_relocate_image( char *ptr, size_t size, IMAGE_DATA_DIRECTORY *dir,
+                                         uint32_t preferred, uint32_t guest )
+{
+    size_t offset, end;
+    if (guest == preferred) return STATUS_SUCCESS;
+    if (!dir || !dir->Size) return STATUS_CONFLICTING_ADDRESSES;
+    if (dir->VirtualAddress >= size || dir->Size > size - dir->VirtualAddress)
+        return STATUS_INVALID_IMAGE_FORMAT;
+    offset = dir->VirtualAddress;
+    end = offset + dir->Size;
+    while (offset < end)
+    {
+        IMAGE_BASE_RELOCATION *rel = (void *)(ptr + offset);
+        USHORT *entries = (void *)(rel + 1);
+        size_t i, count;
+        if (offset & (sizeof(DWORD) - 1) || end - offset < sizeof(*rel))
+            return STATUS_INVALID_IMAGE_FORMAT;
+        if (rel->SizeOfBlock < sizeof(*rel) || rel->SizeOfBlock > end - offset ||
+            rel->SizeOfBlock & (sizeof(DWORD) - 1)) return STATUS_INVALID_IMAGE_FORMAT;
+        if (rel->VirtualAddress >= size) return STATUS_INVALID_IMAGE_FORMAT;
+        count = (rel->SizeOfBlock - sizeof(*rel)) / sizeof(*entries);
+        for (i = 0; i < count; i++)
+        {
+            size_t width, rva;
+            switch (entries[i] >> 12)
+            {
+            case IMAGE_REL_BASED_ABSOLUTE: continue;
+            case IMAGE_REL_BASED_HIGH: case IMAGE_REL_BASED_LOW: width = sizeof(WORD); break;
+            case IMAGE_REL_BASED_HIGHLOW: width = sizeof(DWORD); break;
+            default: return STATUS_INVALID_IMAGE_FORMAT;
+            }
+            rva = (size_t)rel->VirtualAddress + (entries[i] & 0xfff);
+            if (rva >= size || width > size - rva ||
+                (rva < end && rva + width > dir->VirtualAddress))
+                return STATUS_INVALID_IMAGE_FORMAT; /* never mutate the directory itself */
+        }
+        offset += rel->SizeOfBlock;
+    }
+    /* Wine's existing kernel uses memcpy/unsigned adds for unaligned i386
+     * targets and modulo-2^16/32 arithmetic; all addresses here are host storage. */
+    offset = dir->VirtualAddress;
+    while (offset < end)
+    {
+        IMAGE_BASE_RELOCATION *rel = (void *)(ptr + offset);
+        size_t next = offset + rel->SizeOfBlock;
+        if (!process_relocation_block( ptr + rel->VirtualAddress, rel, (INT_PTR)guest - preferred ))
+            return STATUS_INVALID_IMAGE_FORMAT;
+        offset = next;
+    }
+    return STATUS_SUCCESS;
+}
+
+/* The server compares its host VM view with the guest ImageBase and reports
+ * NOT_AT_BASE even at the preferred guest base. Relocations above are already
+ * complete: do not let the native loader add B a second time. */
+static NTSTATUS ios_wow64_mapped_image_status( const struct file_view *view, NTSTATUS status )
+{
+    if ((view->protect & VPROT_WOW64_IMAGE) && status == STATUS_IMAGE_NOT_AT_BASE)
+        return STATUS_SUCCESS;
+    return status;
+}
+
+#endif
