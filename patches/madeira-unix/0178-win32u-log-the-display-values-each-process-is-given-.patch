+/* Playport (PLA-364): GetMonitorInfo's answer for the display query log. */
+static void display_query_log_monitor_info( HMONITOR handle, const MONITORINFO *info, BOOL got )
+{
+    if (!display_query_log_on()) return;
+    if (!got || !info)
+    {
+        display_query_log( "GetMonitorInfo %p -> FALSE", handle );
+        return;
+    }
+    display_query_log( "GetMonitorInfo %p cb=%u -> monitor %s work %s flags %#x device %s", handle,
+                       (UINT)info->cbSize, wine_dbgstr_rect( &info->rcMonitor ), wine_dbgstr_rect( &info->rcWork ),
+                       (UINT)info->dwFlags, info->cbSize >= sizeof(MONITORINFOEXW)
+                       ? debugstr_w( ((const MONITORINFOEXW *)info)->szDevice ) : "-" );
+}
 
