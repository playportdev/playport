 {
     int bpp;
 
@@ -806,6 +807,15 @@ static INT nulldrv_GetDeviceCaps( PHYSDEV dev, INT cap )
     }
 }
 
+/* Playport (PLA-364): GetDeviceCaps' answers in the display query log
+ * (display_query_log.h), once per process, capability and value. */
+static INT nulldrv_GetDeviceCaps( PHYSDEV dev, INT cap )
+{
+    INT value = nulldrv_GetDeviceCaps_unlogged( dev, cap );
+    display_query_log( "GetDeviceCaps %d -> %d", cap, value );
+    return value;
+}
