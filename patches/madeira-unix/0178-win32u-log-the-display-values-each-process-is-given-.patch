From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Tue, 20 Oct 2026 14:14:26 +0200
Subject: [PATCH] win32u: log the display values each process is given (dev)

Red Dead Redemption 2 draws its 3D world stretched about 3.5 times
horizontally on the phone (PLA-364): its camera projects with an aspect
of about 0.507 where the desktop's is 1.778, while the HUD, the window
and the swap chain are 16:9. Nothing showed which display values the
game reads.

With MADEIRA_DISPLAY_QUERY_LOG=1 in the environment, win32u logs, as
"[disp-q] pid=XXXX" lines, each distinct answer a process gets from
GetSystemMetrics(ForDpi), GetMonitorInfo, the primary monitor and
virtual screen rectangles, EnumDisplaySettings, EnumDisplayDevices,
GetDisplayConfigBufferSizes, QueryDisplayConfig (its paths and modes),
DisplayConfigGetDeviceInfo and the display DC's GetDeviceCaps. A line
repeated with the same answer is not written again; at most 2048 lines
in all (display_query_log.h). Without the variable it costs one getenv.

Class: diagnostics
Evidence: docs/evidence/2026-10-20-rdr2-aspect.md
Offered-upstream: no
---
 build/win32u-unix/display_query_log.h |  65 +++++++++++
 build/win32u-unix/driver_ios.c        |  12 +-
 build/win32u-unix/sysparams_ios.c     | 156 ++++++++++++++++++++++++--
 3 files changed, 220 insertions(+), 13 deletions(-)
 create mode 100644 build/win32u-unix/display_query_log.h

diff --git a/build/win32u-unix/display_query_log.h b/build/win32u-unix/display_query_log.h
new file mode 100644
index 0000000..59e5f3d
--- /dev/null
+++ b/build/win32u-unix/display_query_log.h
@@ -0,0 +1,65 @@
+/* Playport (PLA-364): a dev log of the display values each process is given.
+ *
+ * With MADEIRA_DISPLAY_QUERY_LOG=1 in the environment, each distinct line,
+ * process id and answer included, is written once to stderr as
+ * "[disp-q] pid=XXXX ...": a game that asks for the same metric every frame
+ * logs it once, and again only when the answer changes. At most 2048 distinct
+ * lines are written in all. Off (one getenv) when the variable is unset. */
+#ifndef PLAYPORT_DISPLAY_QUERY_LOG_H
+#define PLAYPORT_DISPLAY_QUERY_LOG_H
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define DISPLAY_QUERY_LOG_LINES 2048
+
+static int display_query_log_on(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "MADEIRA_DISPLAY_QUERY_LOG" );
+        on = e && *e && *e != '0';
+    }
+    return on;
+}
+
+static void __attribute__((format(printf, 1, 2))) display_query_log( const char *fmt, ... )
+{
+    static unsigned long long seen[DISPLAY_QUERY_LOG_LINES * 2];
+    char line[512];
+    unsigned long long hash = 1469598103934665603ull;
+    unsigned int pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ), i, slot;
+    int n;
+    va_list args;
+
+    if (!display_query_log_on()) return;
+    n = snprintf( line, sizeof(line), "[disp-q] pid=%04x ", pid );
+    va_start( args, fmt );
+    vsnprintf( line + n, sizeof(line) - n, fmt, args );
+    va_end( args );
+    for (i = 0; line[i]; i++) hash = (hash ^ (unsigned char)line[i]) * 1099511628211ull;
+    if (!hash) hash = 1;
+    slot = (unsigned int)(hash % (DISPLAY_QUERY_LOG_LINES * 2));
+    for (i = 0; i < DISPLAY_QUERY_LOG_LINES * 2; i++, slot = (slot + 1) % (DISPLAY_QUERY_LOG_LINES * 2))
+    {
+        unsigned long long cur = __atomic_load_n( &seen[slot], __ATOMIC_RELAXED );
+        if (cur == hash) return;
+        if (cur) continue;
+        if (__atomic_compare_exchange_n( &seen[slot], &cur, hash, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED )) break;
+        if (cur == hash) return;
+    }
+    if (i == DISPLAY_QUERY_LOG_LINES * 2) return;
+    {
+        static int written;
+        if (__atomic_add_fetch( &written, 1, __ATOMIC_RELAXED ) > DISPLAY_QUERY_LOG_LINES) return;
+    }
+    n = strlen( line );
+    if (n && line[n - 1] != '\n' && n < (int)sizeof(line) - 1) { line[n++] = '\n'; line[n] = 0; }
+    write( 2, line, n );
+}
+
+#endif
