+
+/* Playport (PLA-364): the display queries, each answer logged once per
+ * process when MADEIRA_DISPLAY_QUERY_LOG is set (display_query_log.h). */
+LONG WINAPI NtUserGetDisplayConfigBufferSizes( UINT32 flags, UINT32 *num_path_info,
+                                               UINT32 *num_mode_info )
+{
+    LONG ret = get_display_config_buffer_sizes_unlogged( flags, num_path_info, num_mode_info );
+    display_query_log( "GetDisplayConfigBufferSizes flags=%#x -> %d paths=%d modes=%d", flags, (int)ret,
+                       num_path_info && !ret ? (int)*num_path_info : -1,
+                       num_mode_info && !ret ? (int)*num_mode_info : -1 );
+    return ret;
+}
+
+LONG WINAPI NtUserQueryDisplayConfig( UINT32 flags, UINT32 *paths_count, DISPLAYCONFIG_PATH_INFO *paths,
+                                      UINT32 *modes_count, DISPLAYCONFIG_MODE_INFO *modes,
+                                      DISPLAYCONFIG_TOPOLOGY_ID *topology_id )
+{
+    int paths_in = paths_count ? (int)*paths_count : -1, modes_in = modes_count ? (int)*modes_count : -1;
+    LONG ret = query_display_config_unlogged( flags, paths_count, paths, modes_count, modes, topology_id );
+    UINT32 i;
+
+    if (!display_query_log_on()) return ret;
+    display_query_log( "QueryDisplayConfig flags=%#x in paths=%d modes=%d -> %d paths=%d modes=%d", flags,
+                       paths_in, modes_in, (int)ret, paths_count ? (int)*paths_count : -1,
+                       modes_count ? (int)*modes_count : -1 );
+    if (ret) return ret;
+    for (i = 0; paths && i < *paths_count; i++)
+        display_query_log( "QueryDisplayConfig path %u flags=%#x source id=%u mode=%u target id=%u mode=%u "
+                           "rotation=%u scaling=%u active=%d", i, (UINT)paths[i].flags,
+                           paths[i].sourceInfo.id, paths[i].sourceInfo.modeInfoIdx, paths[i].targetInfo.id,
+                           paths[i].targetInfo.modeInfoIdx, (UINT)paths[i].targetInfo.rotation,
+                           (UINT)paths[i].targetInfo.scaling, (int)paths[i].targetInfo.targetAvailable );
+    for (i = 0; modes && i < *modes_count; i++)
+    {
+        const DISPLAYCONFIG_MODE_INFO *m = &modes[i];
+        if (m->infoType == DISPLAYCONFIG_MODE_INFO_TYPE_SOURCE)
+            display_query_log( "QueryDisplayConfig mode %u source id=%u %ux%u at %d,%d", i, m->id,
+                               m->sourceMode.width, m->sourceMode.height, (int)m->sourceMode.position.x,
+                               (int)m->sourceMode.position.y );
+        else if (m->infoType == DISPLAYCONFIG_MODE_INFO_TYPE_TARGET)
+            display_query_log( "QueryDisplayConfig mode %u target id=%u active %ux%u total %ux%u", i, m->id,
+                               m->targetMode.targetVideoSignalInfo.activeSize.cx,
+                               m->targetMode.targetVideoSignalInfo.activeSize.cy,
+                               m->targetMode.targetVideoSignalInfo.totalSize.cx,
+                               m->targetMode.targetVideoSignalInfo.totalSize.cy );
+        else
+            display_query_log( "QueryDisplayConfig mode %u type=%u id=%u", i, (UINT)m->infoType, m->id );
+    }
+    return ret;
+}
+
+NTSTATUS WINAPI NtUserDisplayConfigGetDeviceInfo( DISPLAYCONFIG_DEVICE_INFO_HEADER *packet )
+{
+    NTSTATUS ret = display_config_get_device_info_unlogged( packet );
+
+    if (!display_query_log_on() || !packet) return ret;
+    if (!ret && packet->type == DISPLAYCONFIG_DEVICE_INFO_GET_TARGET_PREFERRED_MODE)
+    {
+        const DISPLAYCONFIG_TARGET_PREFERRED_MODE *mode = (const DISPLAYCONFIG_TARGET_PREFERRED_MODE *)packet;
+        display_query_log( "DisplayConfigGetDeviceInfo type=%d id=%u -> %#x preferred %ux%u active %ux%u",
+                           (int)packet->type, packet->id, (UINT)ret, mode->width, mode->height,
+                           mode->targetMode.targetVideoSignalInfo.activeSize.cx,
+                           mode->targetMode.targetVideoSignalInfo.activeSize.cy );
+    }
+    else
+        display_query_log( "DisplayConfigGetDeviceInfo type=%d size=%u id=%u -> %#x", (int)packet->type,
+                           packet->size, packet->id, (UINT)ret );
+    return ret;
+}
+
+NTSTATUS WINAPI NtUserEnumDisplayDevices( UNICODE_STRING *device, DWORD index,
+                                          DISPLAY_DEVICEW *info, DWORD flags )
+{
+    NTSTATUS ret = enum_display_devices_unlogged( device, index, info, flags );
+
+    if (!display_query_log_on()) return ret;
+    if (ret || !info)
+        display_query_log( "EnumDisplayDevices dev=%s idx=%u flags=%#x -> %#x", debugstr_us( device ),
+                           (UINT)index, (UINT)flags, (UINT)ret );
+    else
+        display_query_log( "EnumDisplayDevices dev=%s idx=%u flags=%#x -> name %s string %s state %#x",
+                           debugstr_us( device ), (UINT)index, (UINT)flags, debugstr_w( info->DeviceName ),
+                           debugstr_w( info->DeviceString ), (UINT)info->StateFlags );
+    return ret;
+}
+
+BOOL WINAPI NtUserEnumDisplaySettings( UNICODE_STRING *device, DWORD index, DEVMODEW *devmode, DWORD flags )
+{
+    BOOL ret = enum_display_settings_unlogged( device, index, devmode, flags );
+
+    if (!display_query_log_on()) return ret;
+    if (!ret || !devmode)
+        display_query_log( "EnumDisplaySettings dev=%s idx=%d flags=%#x -> FALSE", debugstr_us( device ),
+                           (int)index, (UINT)flags );
+    else
+        display_query_log( "EnumDisplaySettings dev=%s idx=%d flags=%#x -> %ux%u bpp=%u hz=%u orientation=%u "
+                           "at %d,%d fields=%#x", debugstr_us( device ), (int)index, (UINT)flags,
+                           (UINT)devmode->dmPelsWidth, (UINT)devmode->dmPelsHeight, (UINT)devmode->dmBitsPerPel,
+                           (UINT)devmode->dmDisplayFrequency, (UINT)devmode->dmDisplayOrientation,
+                           (int)devmode->dmPosition.x, (int)devmode->dmPosition.y, (UINT)devmode->dmFields );
+    return ret;
+}
