diff --git a/build/wineserver/pp_srv_pending.h b/build/wineserver/pp_srv_pending.h
new file mode 100644
index 0000000..5dfbc33
--- /dev/null
+++ b/build/wineserver/pp_srv_pending.h
@@ -0,0 +1,120 @@
+/* Playport (PLA-364, madeira-unix 0175): the wineserver's set of threads with a
+ * request to read.
+ *
+ * The iOS server loop cannot poll its client pipes, so it used to try a
+ * non-blocking read() on every client fd on every pass: with RDR2's 220-280
+ * threads that was most of a core in failed reads (read_request <-
+ * thread_poll_event). Server and clients are one process, so a client now
+ * marks its thread id here after it writes a request (or closes its request
+ * fd), and the server reads only the marked threads' request fds; a full
+ * sweep at a low rate remains as the net for a missed mark.
+ *
+ * Thread ids are multiples of 4 (wineserver ptids); an id the set cannot
+ * hold (0 before init_first_thread's reply, or above PPSP_MAX_TID) asks for
+ * one full sweep instead.
+ *
+ * Wake coalescing: a client signals the server's wake semaphore only when it
+ * is the first to mark since the server last re-armed (ppsp_rearm, once per
+ * pass, before it sleeps). Rearm stores `armed = 0` and then looks for marks;
+ * a client sets its bits and then exchanges `armed`. In the single order of
+ * these sequentially consistent operations either the server sees the mark
+ * (and does not sleep) or the client sees `armed == 0` (and signals): a mark
+ * is never left waiting for the 1 ms tick, and the semaphore's count no
+ * longer grows with the request rate. */
+#ifndef PP_SRV_PENDING_H
+#define PP_SRV_PENDING_H
+
+#include <stdint.h>
+
+#define PPSP_MAX_TID   0xfffcu                 /* the highest id with a bit of its own */
+#define PPSP_SLOTS     ((PPSP_MAX_TID >> 2) + 1)  /* 16,384 */
+#define PPSP_WORDS     (PPSP_SLOTS / 64)       /* 256 */
+#define PPSP_SUMMARY   (PPSP_WORDS / 64)       /* 4: a bit per non-empty word */
+
+struct ppsp_set
+{
+    uint64_t word[PPSP_WORDS];      /* bit (tid >> 2): that thread has something to read */
+    uint64_t summary[PPSP_SUMMARY]; /* bit w: word[w] may be non-zero */
+    uint32_t sweep;                 /* a mark the set cannot hold: sweep every request fd */
+    uint32_t armed;                 /* a client has signalled since the last ppsp_rearm */
+};
+
+/* Mark tid without the wake: the server re-marking a thread whose request is
+ * still arriving, or deferring one. */
+static inline void ppsp_mark_quiet( struct ppsp_set *s, uint32_t tid )
+{
+    uint32_t slot = tid >> 2;
+
+    if (!tid || (tid & 3) || tid > PPSP_MAX_TID)
+    {
+        __atomic_store_n( &s->sweep, 1, __ATOMIC_SEQ_CST );
+        return;
+    }
+    __atomic_fetch_or( &s->word[slot >> 6], 1ull << (slot & 63), __ATOMIC_SEQ_CST );
+    __atomic_fetch_or( &s->summary[slot >> 12], 1ull << ((slot >> 6) & 63), __ATOMIC_SEQ_CST );
+}
+
+/* Client, after its write: returns nonzero when the caller must signal the
+ * server's wake semaphore. */
+static inline int ppsp_mark( struct ppsp_set *s, uint32_t tid )
+{
+    ppsp_mark_quiet( s, tid );
+    return !__atomic_exchange_n( &s->armed, 1, __ATOMIC_SEQ_CST );
+}
+
+/* Is any mark waiting? */
+static inline int ppsp_pending( struct ppsp_set *s )
+{
+    unsigned int i;
+
+    if (__atomic_load_n( &s->sweep, __ATOMIC_SEQ_CST )) return 1;
+    for (i = 0; i < PPSP_SUMMARY; i++)
+        if (__atomic_load_n( &s->summary[i], __ATOMIC_SEQ_CST )) return 1;
+    return 0;
+}
+
+/* Server, once per pass before it sleeps: lets the next mark signal again.
+ * Returns nonzero when marks are already waiting (do not sleep). */
+static inline int ppsp_rearm( struct ppsp_set *s )
+{
+    __atomic_store_n( &s->armed, 0, __ATOMIC_SEQ_CST );
+    return ppsp_pending( s );
+}
+
+/* Server: takes every mark, calling fn for each marked thread id (in id
+ * order); fn may mark again, for the next drain. Returns nonzero when a
+ * full sweep was asked for. */
+static inline int ppsp_drain( struct ppsp_set *s, void (*fn)( uint32_t tid, void *ctx ), void *ctx )
+{
+    unsigned int i;
+    int sweep = 0;
+
+    if (__atomic_load_n( &s->sweep, __ATOMIC_RELAXED ))
+        sweep = __atomic_exchange_n( &s->sweep, 0, __ATOMIC_SEQ_CST ) != 0;
+    for (i = 0; i < PPSP_SUMMARY; i++)
+    {
+        uint64_t sum;
+
+        if (!__atomic_load_n( &s->summary[i], __ATOMIC_RELAXED )) continue;
+        /* the summary first: a bit a client sets after this exchange sets
+         * its summary bit again, so the next drain finds it */
+        sum = __atomic_exchange_n( &s->summary[i], 0, __ATOMIC_SEQ_CST );
+        while (sum)
+        {
+            unsigned int w = i * 64 + (unsigned int)__builtin_ctzll( sum );
+            uint64_t bits = __atomic_exchange_n( &s->word[w], 0, __ATOMIC_SEQ_CST );
+
+            sum &= sum - 1;
+            while (bits)
+            {
+                uint32_t slot = w * 64 + (uint32_t)__builtin_ctzll( bits );
+
+                bits &= bits - 1;
+                fn( slot << 2, ctx );
+            }
+        }
+    }
+    return sweep;
+}
+
+#endif /* PP_SRV_PENDING_H */
