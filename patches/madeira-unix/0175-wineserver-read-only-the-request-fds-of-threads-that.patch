+/* Playport (PLA-364): the pending set's side of main_loop. */
+#define IOS_SRV_FULL_SWEEP_NS 50000000ull   /* the net for a missed mark: 50 ms */
+static struct ppsp_set ios_srv_deferred;    /* marked while its request fd waits for a reply's
+                                             * POLLOUT: retried every pass, never keeps us awake */
+static unsigned long long ios_pend_marked, ios_pend_stale, ios_pend_partial, ios_pend_deferred;
+static unsigned long long ios_pend_full, ios_pend_forced, ios_pend_found;
+
+/* Is poll user `user` (in use) a thread's request fd? */
+static int ios_fd_is_thread_request( int user )
+{
+    struct fd *fd = poll_users[user];
+    struct object *obj = fd->user;
+
+    return obj && obj->ops->type == &thread_type && ((struct thread *)obj)->request_fd == fd;
+}
+
+/* Read thread tid's request fd, as the sweep's synthetic POLLIN did. */
+static void ios_pending_dispatch( uint32_t tid, void *ctx )
+{
+    struct thread *thread;
+    struct fd *fd;
+    int user;
+
+    (void)ctx;
+    if (!(thread = get_thread_from_id( tid )))
+    {
+        ios_pend_stale++;   /* ended, or its id now names a process */
+        return;
+    }
+    ios_pend_marked++;
+    fd = thread->request_fd;
+    if (fd && (user = fd->poll_index) >= 0 && user < nb_users && poll_users[user] == fd && pollfd[user].fd >= 0)
+    {
+        if (pollfd[user].events & POLLIN)
+        {
+            fd_poll_event( fd, POLLIN );
+            /* the rest of a large request is still coming: read again next pass */
+            if (thread->request_fd == fd && thread->req_toread)
+            {
+                ios_pend_partial++;
+                ppsp_mark_quiet( &ios_srv_pending, tid );
+            }
+        }
+        else
+        {
+            ios_pend_deferred++;
+            ppsp_mark_quiet( &ios_srv_deferred, tid );
+        }
+    }
+    release_object( thread );
+}
