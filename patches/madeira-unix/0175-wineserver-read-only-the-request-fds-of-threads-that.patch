+/* Playport (PLA-364): the threads with something on their request fd, a
+ * request or its end (pp_srv_pending.h). main_loop reads only theirs, and
+ * every client fd at most every IOS_SRV_FULL_SWEEP_NS. On unless
+ * MADEIRA_SRV_PENDING=0; main_loop decides once, before any client runs. */
+#include "pp_srv_pending.h"
+static struct ppsp_set ios_srv_pending;
+static int ios_srv_pending_on;
+
+/* ntdll, after thread tid writes a request or closes its request fd */
+void ios_wineserver_kick_thread( unsigned int tid )
+{
+    if (!__atomic_load_n( &ios_srv_pending_on, __ATOMIC_ACQUIRE ))
+        ios_wineserver_wake();
+    else if (ppsp_mark( &ios_srv_pending, tid ))
+        ios_wineserver_wake();
+}
