From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Sat, 17 Oct 2026 19:31:15 +0200
Subject: [PATCH] virtual: count a 4 MiB call-return stack as one in the FEX
 band census

FEX's call-return stack is 4 MiB and two guard pages from patches/fex
0047, not 16 MiB. The band census (0038) knew a stack by its 16 MiB
shape, and the app reads its count as the band's emulator threads
(`band: threads=`), so it would have counted none and put their bytes
under `other`. The census now knows the 4 MiB shape.

Linear: PLA-383
Class: diagnostics
Evidence: docs/evidence/2026-10-17-callret-stack.md
Offered-upstream: no; the FEX host band is the iOS port's
---
 build/ntdll-unix/virtual_ios.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index a23248f..8fe22c5 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -5482,6 +5482,7 @@ struct ios_band_census
 };
 
 #define IOS_BAND_SPAN 0x1000000ULL   /* rpmalloc's span: 16 MiB, 16 MiB-aligned */
+#define IOS_BAND_CALLRET 0x400000ULL /* FEX's CALLRET_STACK_SIZE: 4 MiB (patches/fex 0047) */
 
 static void ios_band_gap( struct ios_band_census *c, ULONG_PTR b, ULONG_PTR e )
 {
@@ -5513,7 +5514,7 @@ static struct wine_rb_entry *ios_band_first_locked( ULONG_PTR lo )
 }
 
 /* What each view is, by its shape: an rpmalloc span is exactly 16 MiB on a
- * 16 MiB boundary, a call-return stack is 16 MiB plus its two guard pages, an
+ * 16 MiB boundary, a call-return stack is 4 MiB plus its two guard pages, an
  * L1 lookup cache is 2 MiB; the rest (rpmalloc heap metadata and large blocks,
  * FEX's pooled buffers) is counted in bytes. virtual_mutex must be held. */
 static void ios_band_census_locked( struct ios_band_census *c )
@@ -5535,7 +5536,7 @@ static void ios_band_census_locked( struct ios_band_census *c )
         c->used += e - b;
         c->views++;
         if (view->size == IOS_BAND_SPAN && !(b & (IOS_BAND_SPAN - 1))) c->spans++;
-        else if (view->size > IOS_BAND_SPAN && view->size <= IOS_BAND_SPAN + 0x10000) c->callret++;
+        else if (view->size > IOS_BAND_CALLRET && view->size <= IOS_BAND_CALLRET + 0x10000) c->callret++;
         else if (view->size == 0x200000) c->l1++;
         else c->other_bytes += e - b;
         if (e > cursor) cursor = e;
