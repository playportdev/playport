From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Wed, 21 Oct 2026 05:05:29 +0200
Subject: [PATCH] virtual: the x18 patcher leaves an ARM64EC image's x64 code
 alone

An ARM64EC image's .text also holds x64 code (in ntdll, after the
ARM64EC code: winebuild's relay entry points and the x64
KiUserExceptionDispatcher). The x18 patcher read it as ARM64. Some of
its words decode as x18 instructions and were overwritten with branches
to trampolines: 125 words of x64 code in 49 of the Wine ARM64EC DLLs,
two in ntdll, one of them inside the x64 KiUserExceptionDispatcher.
Others decode as LDR (literal), and the literal-pool guard then took
their target for data: a relay entry point's `lea rcx, [rip+disp]` (48
8d 0d ...) is the word 0x18xxxx8d, an LDR whose target moves with every
change to the ARM64EC code before it. With the InitOnceExecuteOnce stub
in ntdll's loader.c (dropped from wine-pe), the word at ntdll .text
+0x8270c targeted RtlProcessFlsData's `mov x8, x18` at RVA 0x628bc,
which stayed unpatched ([x18-lit] 1): a new RockstarLauncher thread with
x18 = 0 read the TEB's PEB field at 0x60 there ([x18-decline] declines a
base other than x18) and the launcher ended 0xc0000005, in all four RDR2
runs on those builds. Without the stub the same word targets a word of
no x18 instruction, so which ntdll change broke what was a lottery. In
the current build opengl32 has one such unpatched `mov x10, x18` at RVA
0x2274c.

The data map now marks the image's x64 code ranges (the CHPE code map,
type AMD64, read through the header in the view): no word there is an
LDR (literal) source or a patch site. The metadata pointer is resolved
against the header's ImageBase or the copy's RX base (a child copy is
rebased), so the source pre-scan, the parent copy's budget and the
patcher agree; an image with no code map is scanned as before. The
[x18-patch] line gives x64_skipped=N (-1: no code map).

Checked on the host by the same functions compiled against the PE files:
the stub's ntdll now patches the RtlProcessFlsData site and leaves only
its two x64 words; across the 592 staged ARM64EC DLLs no x18 instruction
outside x64 code is left unpatched (before: ntdll with the stub,
opengl32).

Linear: PLA-364
Class: upstream-bug
Evidence: docs/evidence/2026-10-21-x18-patcher-x64-code.md
Offered-upstream: no
---
 build/ntdll-unix/virtual_ios.c | 123 ++++++++++++++++++++++++++++-----
 1 file changed, 106 insertions(+), 17 deletions(-)

diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index 235261d..e72b45d 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -5074,14 +5074,96 @@ static uint32_t ios_insn_replace_x18(uint32_t insn, int role, int scratch)
  * tramp_rw/tramp_rx: RW and RX views of the trampoline area
  * tramp_size: available space for trampolines
  * Returns number of instructions patched. */
+/* Playport: an ARM64EC image's .text also holds x64 code: in ntdll, after the
+ * ARM64EC code, winebuild's relay entry points and the x64
+ * KiUserExceptionDispatcher. Read as ARM64 its bytes are noise. Some decode
+ * as x18 instructions, which the patcher then overwrote with branches (two
+ * words of ntdll's x64 code, one inside KiUserExceptionDispatcher), and some
+ * as LDR (literal), whose target the literal guard below then took for data:
+ * a relay entry point's `lea rcx, [rip+disp]` (48 8d 0d ...) gives the word
+ * 0x18xxxx8d, an LDR whose target moves with every change to the ARM64EC
+ * code before it. With the InitOnceExecuteOnce stub's code in ntdll it
+ * landed on RtlProcessFlsData's `mov x8, x18`, which stayed unpatched: a new
+ * RockstarLauncher thread with x18 = 0 read the TEB's PEB field at 0x60 and
+ * died, in every RDR2 run on those builds.
+ *
+ * So the words in the image's x64 code ranges (the CHPE code map, type 2)
+ * are marked here: they are never an LDR (literal) source and never patched.
+ * The image is .text's view less text_rva, header included (the source
+ * mapping or a pool copy of it). The metadata pointer is a VA rebased to the
+ * header's ImageBase, or for a child copy to the copy (image_rx). Returns the
+ * x18-matching words skipped, or -1 when the image has no code map to read
+ * (not ARM64EC, no header in this view): nothing is marked then. */
+static int ios_x18_mark_x64_ranges( const char *text, size_t text_size, size_t text_rva,
+                                    const char *image_rx, unsigned char *map )
+{
+    const char *image = text - text_rva;
+    const char *opt;
+    unsigned int pe_off, size_of_image, lc_rva, lc_size, code_map, code_map_count, k;
+    uint64_t meta_va, meta_rva = (uint64_t)-1;
+    uint64_t bases[3];
+    int b, sites = 0;
+
+    if (text_rva < 0x200 || image[0] != 'M' || image[1] != 'Z') return -1;
+    pe_off = *(const unsigned int *)(image + 0x3C);
+    if (pe_off > text_rva - 0x18 - 0xF0 || memcmp( image + pe_off, "PE\0\0", 4 )) return -1;
+    opt = image + pe_off + 0x18;
+    if (*(const unsigned short *)opt != 0x20b) return -1;              /* PE32+ */
+    size_of_image = *(const unsigned int *)(opt + 0x38);
+    lc_rva = *(const unsigned int *)(opt + 0x70 + 10 * 8);              /* load config */
+    lc_size = *(const unsigned int *)(opt + 0x70 + 10 * 8 + 4);
+    if (!lc_rva || lc_size < 0xD0 || (uint64_t)lc_rva + 0xD0 > size_of_image) return -1;
+    meta_va = *(const uint64_t *)(image + lc_rva + 0xC8);              /* CHPEMetadataPointer */
+    if (!meta_va) return -1;
+    bases[0] = *(const uint64_t *)(opt + 0x18);                         /* ImageBase */
+    bases[1] = (uint64_t)(uintptr_t)image_rx;
+    bases[2] = (uint64_t)(uintptr_t)image;
+    for (b = 0; b < 3 && meta_rva == (uint64_t)-1; b++)
+        if (bases[b] && meta_va >= bases[b] && meta_va - bases[b] + 12 <= size_of_image)
+            meta_rva = meta_va - bases[b];
+    if (meta_rva == (uint64_t)-1) return -1;
+    code_map = *(const unsigned int *)(image + meta_rva + 4);
+    code_map_count = *(const unsigned int *)(image + meta_rva + 8);
+    if (!code_map || (uint64_t)code_map + (uint64_t)code_map_count * 8 > size_of_image) return -1;
+    for (k = 0; k < code_map_count; k++)
+    {
+        unsigned int start = *(const unsigned int *)(image + code_map + k * 8);
+        unsigned int len = *(const unsigned int *)(image + code_map + k * 8 + 4);
+        uint64_t from, to;
+        if ((start & 3) != 2) continue;                                  /* AMD64 */
+        start &= ~3u;
+        from = start > text_rva ? start - text_rva : 0;
+        to = (uint64_t)start + len > text_rva ? (uint64_t)start + len - text_rva : 0;
+        if (to > text_size) to = text_size;
+        for (uint64_t i = from & ~(uint64_t)3; i + 4 <= to; i += 4)
+        {
+            map[(i / 4) >> 3] |= 1 << ((i / 4) & 7);
+            if (ios_insn_x18_role( *(const uint32_t *)(text + i) ) != X18_ROLE_NONE) sites++;
+        }
+    }
+    return sites;
+}
+
 /* Literal-pool data map builder — see the guard comment in
  * ios_jit_patch_x18. Shared by the patcher and the trampoline-need
  * counter. Caller frees. NULL on alloc failure (callers degrade to the
  * unguarded pre-2026-07-07 behavior). */
-static unsigned char *ios_x18_build_data_map( const char *text, size_t text_size )
+/* Playport: x64_sites (may be NULL) gets ios_x18_mark_x64_ranges's result;
+ * the map returned covers those ranges too. */
+static unsigned char *ios_x18_build_data_map( const char *text, size_t text_size, size_t text_rva,
+                                              const char *image_rx, int *x64_sites )
 {
     unsigned char *data_map = calloc( 1, text_size / 32 + 1 );
-    if (!data_map) return NULL;
+    unsigned char *x64_map = calloc( 1, text_size / 32 + 1 );
+    int x64 = -1;
+    if (x64_sites) *x64_sites = -1;
+    if (!data_map || !x64_map)
+    {
+        free( x64_map );
+        return data_map;   /* NULL, or with no x64 marks: the callers' fallback */
+    }
+    x64 = ios_x18_mark_x64_ranges( text, text_size, text_rva, image_rx, x64_map );
+    if (x64_sites) *x64_sites = x64;
     for (size_t i = 0; i < text_size; i += 4)
     {
         uint32_t insn = *(const uint32_t *)(text + i);
@@ -5089,6 +5171,7 @@ static unsigned char *ios_x18_build_data_map( const char *text, size_t text_size
         size_t lit_bytes;
         int64_t imm19;
         size_t tgt;
+        if (x64_map[(i / 4) >> 3] & (1 << ((i / 4) & 7))) continue;   /* x64 code, no LDR */
         switch (top8)
         {
         case 0x18: case 0x1C: case 0x98: lit_bytes = 4;  break;  /* LDR Wt/St, LDRSW */
@@ -5102,6 +5185,8 @@ static unsigned char *ios_x18_build_data_map( const char *text, size_t text_size
         for (size_t b = tgt; b < tgt + lit_bytes && b < text_size; b += 4)
             data_map[(b / 4) >> 3] |= 1 << ((b / 4) & 7);
     }
+    for (size_t k = 0; k < text_size / 32 + 1; k++) data_map[k] |= x64_map[k];
+    free( x64_map );
     return data_map;
 }
 
@@ -5110,9 +5195,9 @@ static unsigned char *ios_x18_build_data_map( const char *text, size_t text_size
  * 2.2MB reservation for ntdll) — with per-child copies of every DLL that
  * waste was ~HALF the pool (4 apps hit 368/384MB). Count the actual
  * patch sites and size the reservation to fit. */
-size_t ios_jit_x18_tramp_need( const char *text, size_t text_size )
+size_t ios_jit_x18_tramp_need( const char *text, size_t text_size, size_t text_rva, const char *image_rx )
 {
-    unsigned char *data_map = ios_x18_build_data_map( text, text_size );
+    unsigned char *data_map = ios_x18_build_data_map( text, text_size, text_rva, image_rx, NULL );
     size_t need = 0;
     for (size_t i = 0; i < text_size; i += 4)
     {
@@ -5127,7 +5212,7 @@ size_t ios_jit_x18_tramp_need( const char *text, size_t text_size )
     return need + 0x1000;
 }
 
-int ios_jit_patch_x18(char *text_rw, char *text_rx, size_t text_size,
+int ios_jit_patch_x18(char *text_rw, char *text_rx, size_t text_size, size_t text_rva,
                        char *tramp_rw, char *tramp_rx, size_t tramp_size)
 {
     size_t tramp_off = 0;
@@ -5141,6 +5226,8 @@ int ios_jit_patch_x18(char *text_rw, char *text_rx, size_t text_size,
      * out, if it did. */
     int unpatched = 0;
     size_t out_of_space = (size_t)-1;
+    /* Playport: x18-matching words in x64 code, left alone (-1: no code map). */
+    int x64_sites = -1;
 
     /* B/BL reach guard (Steam S3 run 11 root cause): imm26 spans ±128MB.
      * The patcher used to encode out-of-range tramp offsets silently
@@ -5156,7 +5243,7 @@ int ios_jit_patch_x18(char *text_rw, char *text_rx, size_t text_size,
         {
             /* Playport: count the image and the sites it leaves to fault (the
              * budget is 32 bytes a site plus one page of slack). */
-            size_t sites = (ios_jit_x18_tramp_need( text_rw, text_size ) - 0x1000) / 32;
+            size_t sites = (ios_jit_x18_tramp_need( text_rw, text_size, text_rva, text_rx - text_rva ) - 0x1000) / 32;
             __sync_fetch_and_add( &ios_limit_x18_images, 1 );
             __sync_fetch_and_add( &ios_limit_x18_sites, sites );
             dprintf(2, "[x18-tramp] REFUSED: tramp %p+0x%lx out of B/BL reach of text %p+0x%lx "
@@ -5181,7 +5268,7 @@ int ios_jit_patch_x18(char *text_rw, char *text_rx, size_t text_size,
      * (data that happens to look like one) only mark extra words as data
      * — an unpatched real instruction degrades to a recoverable runtime
      * fault, while a patched literal is fatal. Asymmetry favors skipping. */
-    data_map = ios_x18_build_data_map( text_rw, text_size );
+    data_map = ios_x18_build_data_map( text_rw, text_size, text_rva, text_rx - text_rva, &x64_sites );
 
     /* Pass 0: retarget hand-written TEB-from-TSD reads.
      *
@@ -5410,9 +5497,10 @@ int ios_jit_patch_x18(char *text_rw, char *text_rx, size_t text_size,
     }
     if (count > 0 || skipped > 0 || text_size)
         dprintf(2, "[x18-patch] ml1005 text=%p+%#lx (rw=%p) patched=%d skipped=%d unpatched=%d "
-                "tramp=%p+%#lx used=%lu\n",
+                "tramp=%p+%#lx used=%lu x64_skipped=%d\n",
                 text_rx, (unsigned long)text_size, text_rw, count, skipped, unpatched,
-                tramp_rx, (unsigned long)tramp_size, (unsigned long)tramp_off);
+                tramp_rx, (unsigned long)tramp_size, (unsigned long)tramp_off, x64_sites);
+    if (x64_sites > 0) lit_skipped -= x64_sites;
     /* dprintf, not ERR (err-virtual muted): literal words the x18 matcher
      * WOULD have clobbered — nonzero = a dodged conhost-class boot death. */
     if (lit_skipped)
@@ -9858,7 +9946,7 @@ const char *ios_pe_module_name( const void *image_base, size_t image_size )
  * the patch stage; scanning x64 bytes would count garbage matches). */
 static size_t ios_x18_tramp_prealloc_scan( const char *image, size_t image_size )
 {
-    extern size_t ios_jit_x18_tramp_need( const char *text, size_t text_size );
+    extern size_t ios_jit_x18_tramp_need( const char *text, size_t text_size, size_t text_rva, const char *image_rx );
     const size_t pg = 0x4000;
     unsigned int pe_off;
     unsigned short machine, num_sec, opt_sz;
@@ -9887,7 +9975,7 @@ static size_t ios_x18_tramp_prealloc_scan( const char *image, size_t image_size
     }
     if (machine != IMAGE_FILE_MACHINE_ARM64 && !is_arm64ec) return 0;
     if (!text_sz || text_off + text_sz > image_size) return 0;
-    return (ios_jit_x18_tramp_need(image + text_off, text_sz) + pg - 1) & ~(pg - 1);
+    return (ios_jit_x18_tramp_need(image + text_off, text_sz, text_off, NULL) + pg - 1) & ~(pg - 1);
 }
 
 
@@ -11674,8 +11762,9 @@ static inline int mprotect_exec( void *base, size_t size, int unix_prot )
                     if (text_sz > 0)
                     {
                         /* Task #25: exact budget (was 100% of .text, ~99% wasted). */
-                        extern size_t ios_jit_x18_tramp_need( const char *text, size_t text_size );
-                        size_t tramp_budget = ios_jit_x18_tramp_need((char *)jit_rw_base + offset + text_off, text_sz);
+                        extern size_t ios_jit_x18_tramp_need( const char *text, size_t text_size, size_t text_rva, const char *image_rx );
+                        size_t tramp_budget = ios_jit_x18_tramp_need((char *)jit_rw_base + offset + text_off, text_sz, text_off,
+                                                                    (char *)jit_rx_base + offset);
                         size_t tramp_alloc = (tramp_budget + page_size - 1) & ~(page_size - 1);
