From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: playportdev <dev@playport.dev>
Date: Wed, 7 Oct 2026 12:01:44 +0200
Subject: [PATCH] ntdll: keep a store sign-in out of the process command-line
 log lines

NtCreateUserProcess and spawn_process print every new process's command
line at ERR, and the +process trace prints it too. An Epic game now starts
with Epic's exchange code, the account ID and the display name on its
command line (-AUTH_PASSWORD=, -epicuserid=, -epicusername=; Playport's
decision 0059), and the app log is not a place for them. The three lines
now print the command line with those values masked; the rest of it is
unchanged.

Class: host-app
Evidence: docs/evidence/2026-10-07-epic-game-auth.md
Offered-upstream: no
---
 build/ntdll-unix/process_ios.c | 40 +++++++++++++++++++++++++++++++---
 1 file changed, 37 insertions(+), 3 deletions(-)

diff --git a/build/ntdll-unix/process_ios.c b/build/ntdll-unix/process_ios.c
index 2d60539..ab9c0e6 100644
--- a/build/ntdll-unix/process_ios.c
+++ b/build/ntdll-unix/process_ios.c
@@ -77,6 +77,40 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(process);
 
+/* Playport: a command line for the log, with the values of the arguments that
+ * carry a store sign-in masked (an Epic game's -AUTH_PASSWORD=, -epicuserid= and
+ * -epicusername=; Playport's decision 0059). A value runs to the closing quote
+ * when its argument is quoted, else to the next space. */
+static const char *debugstr_cmdline( const UNICODE_STRING *us )
+{
+    static const char *const secret[] = { "-auth_password=", "-epicuserid=", "-epicusername=" };
+    size_t len = us->Buffer ? us->Length / sizeof(WCHAR) : 0, i, j, k, n;
+    WCHAR *copy;
+    const char *ret;
+
+    if (!len) return debugstr_us( us );
+    if (!(copy = malloc( len * sizeof(WCHAR) ))) return "(command line)";
+    memcpy( copy, us->Buffer, len * sizeof(WCHAR) );
+    for (i = 0; i < len; i++)
+        for (k = 0; k < ARRAY_SIZE(secret); k++)
+        {
+            int quoted = i > 0 && copy[i - 1] == '"';
+            n = strlen( secret[k] );
+            if (len - i < n) continue;
+            for (j = 0; j < n; j++)
+            {
+                WCHAR c = copy[i + j];
+                if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+                if (c != (WCHAR)secret[k][j]) break;
+            }
+            if (j < n) continue;
+            for (j = i + n; j < len && copy[j] != '"' && (quoted || copy[j] != ' '); j++) copy[j] = '*';
+        }
+    ret = debugstr_wn( copy, len );
+    free( copy );
+    return ret;
+}
+
 
 static ULONG execute_flags = MEM_EXECUTE_OPTION_DISABLE;
 
@@ -500,7 +534,7 @@ static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int so
     if (winedebug) putenv( winedebug );
 
     ERR("spawn_process: creating child thread for %s (fd=%d, unixdir=%d, dup_unixdir=%d)\n",
-        debugstr_us(&params->CommandLine), socketfd, unixdir, args->unixdir);
+        debugstr_cmdline(&params->CommandLine), socketfd, unixdir, args->unixdir);
 
     ret = pthread_create( &child_thread, NULL, ios_child_thread_entry, args );
     if (ret) {
@@ -876,10 +910,10 @@ NTSTATUS WINAPI NtCreateUserProcess( HANDLE *process_handle_ptr, HANDLE *thread_
     if (!process_attr) process_attr = &empty_attr;
 
     TRACE( "%s image %s cmdline %s parent %p machine %x\n", debugstr_us( &path ),
-           debugstr_us( &params->ImagePathName ), debugstr_us( &params->CommandLine ), parent, machine );
+           debugstr_us( &params->ImagePathName ), debugstr_cmdline( &params->CommandLine ), parent, machine );
 #ifdef WINE_IOS
     ERR("NtCreateUserProcess: image=%s cmdline=%s\n",
-        debugstr_us( &params->ImagePathName ), debugstr_us( &params->CommandLine ));
+        debugstr_us( &params->ImagePathName ), debugstr_cmdline( &params->CommandLine ));
 
     /* TEMP HACK (Steam S3 2026-07-10, task #29): refuse to spawn Steam's
      * minidump reporter. The reporter child hits the deep guest-exception-
