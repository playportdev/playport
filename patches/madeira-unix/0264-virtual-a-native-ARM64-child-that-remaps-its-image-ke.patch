+/* Playport (PLA-514): b is a B to the address to. */
+static int ios_x18_b_to( const uint32_t *b, uintptr_t to )
+{
+    return (*b & 0xfc000000) == 0x14000000 && (uintptr_t)b + (intptr_t)((int32_t)(*b << 6) >> 6) * 4 == to;
+}
+
+/* Playport (PLA-514): the word now at now_rx is the one ios_jit_patch_x18 put in place of
+ * the instruction orig: a B to a trampoline within tramp_rx + tramp_size that does orig
+ * with the TEB and comes back (or goes to orig's target), or the NOP for MOV xzr, x18.
+ * A flush of code decrypted through a view the copy is not one with (ios_remap_flush)
+ * keeps these words: copied back, orig would be live until patched again, each time
+ * with new trampoline space. */
+static int ios_x18_patched_site( uint32_t now, uint32_t orig, const char *now_rx, const char *tramp_rx,
+                                 size_t tramp_size )
+{
+    int role = ios_insn_x18_role( orig ), scratch;
+    int mov = role == X18_ROLE_RM && (orig & 0xffe0ffe0) == 0xaa0003e0;
+    const uint32_t *t;
+    uintptr_t back = (uintptr_t)now_rx + 4;
+
+    if (role == X18_ROLE_NONE) return 0;
+    if (mov && (orig & 31) == 31) return now == 0xd503201f;
+    if ((now & 0xfc000000) != 0x14000000) return 0;
+    t = (const uint32_t *)((uintptr_t)now_rx + (intptr_t)((int32_t)(now << 6) >> 6) * 4);
+    if ((const char *)t < tramp_rx || (size_t)((const char *)t - tramp_rx) +
+        (mov ? 16 : (role & X18_ROLE_BRANCH) ? 36 : 28) > tramp_size) return 0;
+    if (mov) return t[0] == (0xd53bd060 | (orig & 31)) && ios_x18_b_to( &t[3], back );
+    scratch = t[0] & 31;                                    /* str xSCRATCH, [sp, #-16]! */
+    if ((t[0] & 0xffffffe0) != 0xf81f0fe0 || scratch > 17) return 0;
+    if (role & X18_ROLE_BRANCH)
+    {
+        int tb = (orig & 0x7e000000) == 0x36000000;
+        int64_t off = tb ? (int64_t)((int32_t)(orig << 13) >> 18) * 4 : (int64_t)((int32_t)(orig << 8) >> 13) * 4;
+        return t[4] == ((orig & (tb ? 0xfff80000 : 0xff000000)) | (3 << 5) | scratch) &&
+               ios_x18_b_to( &t[6], back ) && ios_x18_b_to( &t[8], (uintptr_t)now_rx + off );
+    }
+    return t[4] == ios_insn_replace_x18( orig, role, scratch ) && ios_x18_b_to( &t[6], back );
+}
+
