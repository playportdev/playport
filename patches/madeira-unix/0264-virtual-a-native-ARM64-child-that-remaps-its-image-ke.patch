+/***********************************************************************
+ *           Remapping a presented image                    (PLA-514)
+ *
+ * Decision 0176. World of Warcraft's ARM64 client replaces its own image with
+ * a section: it creates a SEC_NO_CHANGE section of SizeOfImage, maps it
+ * read-write, copies its image there, unmaps the image and maps the section at
+ * the image's base (its code read-execute, .data read-write, the rest
+ * read-only). From then on it decrypts its code a function at a time through
+ * the read-write view, calls FlushInstructionCache on each, and runs it at the
+ * base. In a native ARM64 child the base is the image's pool copy, whose pages
+ * take code only through the pool's RW alias, so no section view can sit
+ * there. Instead:
+ *  - a view of a plain section mapped at a presented copy's address is mapped
+ *    where the image's PE view was (the hidden backing store again); its bytes
+ *    are copied into the copy through the RW alias, x18-patched and flushed,
+ *    and the caller gets the copy's address;
+ *  - every view a native child maps of a plain section is recorded with the
+ *    section's file and offset. The other views of a section mapped at a copy
+ *    are remapped onto the copy's RW alias, so they and the copy are one
+ *    memory, as they are on Windows;
+ *  - a FlushInstructionCache on such a view, or on a presented copy,
+ *    x18-patches the code it reaches from the flushed address, and flushes.
+ * The backing stores keep the section's bytes as they were at the remap.
+ */
+struct ios_section_view
+{
+    void     *peb;      /* the pseudo-process that mapped it; NULL: a free slot */
+    char     *base;     /* the view (for a remap, its backing store) */
+    size_t    size;
+    dev_t     dev;      /* the section's file */
+    ino_t     ino;
+    ULONGLONG offset;   /* the view's offset in the section */
+    char     *copy;     /* a remap: the presented copy's address it is mapped at */
+};
+/* the records, grown as needed: a record dropped for a new one would leave its view's
+ * flushes out of the copy, or a later view not one with it */
+static struct ios_section_view *ios_section_views;
+static unsigned int ios_section_view_count;
+static pthread_mutex_t ios_section_view_lock = PTHREAD_MUTEX_INITIALIZER;
+static unsigned long ios_remap_flushes, ios_remap_flush_bytes;
+
+/* A free record, the table doubled when every one is live. NULL (logged) when it cannot
+ * grow. ios_section_view_lock is held. */
+static struct ios_section_view *ios_section_view_slot( void )
+{
+    struct ios_section_view *grown;
+    unsigned int i, count = ios_section_view_count ? 2 * ios_section_view_count : 64;
+
+    for (i = 0; i < ios_section_view_count; i++) if (!ios_section_views[i].peb) return &ios_section_views[i];
+    if (!(grown = realloc( ios_section_views, count * sizeof(*grown) )))
+    {
+        dprintf( 2, "[remap] no memory for more than %u section view records: a view is not recorded\n",
+                 ios_section_view_count );
+        return NULL;
+    }
+    memset( grown + ios_section_view_count, 0, (count - ios_section_view_count) * sizeof(*grown) );
+    ios_section_views = grown;
+    ios_section_view_count = count;
+    return &ios_section_views[i];
+}
+
+/* Make the part of view s that remap r covers the same memory as r's copy: remap
+ * it onto the copy's RW alias (the tail short of a host page stays the view's).
+ * ios_section_view_lock is held. Returns the bytes made one. */
+static size_t ios_section_view_alias( struct ios_section_view *s, const struct ios_section_view *r )
+{
+    ULONGLONG from = s->offset > r->offset ? s->offset : r->offset;
+    ULONGLONG to = s->offset + s->size < r->offset + r->size ? s->offset + s->size : r->offset + r->size;
+    struct ios_jit_mapping *m = ios_jit_presented_at( r->copy, NULL );
+    vm_address_t target;
+    vm_prot_t cur = 0, max = 0;
+    kern_return_t kr;
+    char *copy;
+    size_t len;
+
+    if (!m || from >= to) return 0;
+    copy = r->copy + (from - r->offset);
+    len = to - from;
+    if (copy + len > (char *)m->jit_base + m->size) len = (char *)m->jit_base + m->size - copy;
+    len &= ~host_page_mask;
+    target = (vm_address_t)(s->base + (from - s->offset));
+    if (!len || ((target | (uintptr_t)copy) & host_page_mask)) return 0;
+    kr = vm_remap( mach_task_self(), &target, len, 0, VM_FLAGS_FIXED | VM_FLAGS_OVERWRITE, mach_task_self(),
+                   (vm_address_t)((char *)ios_jit_rw_base_global + (copy - (char *)ios_jit_rx_base_global)),
+                   FALSE, &cur, &max, VM_INHERIT_DEFAULT );
+    if (kr != KERN_SUCCESS)
+    {
+        dprintf( 2, "[remap] the view %p+%#lx could not become the copy at %p: kr=%d\n",
+                 (void *)target, (unsigned long)len, copy, kr );
+        return 0;
+    }
+    return len;
+}
+
+/* Record a native child's view of a plain section (virtual_map_section_body), and
+ * make it one with a copy its section is mapped at. */
+static void ios_section_view_add( char *base, size_t size, int fd, ULONGLONG offset )
+{
+    struct ios_section_view *v;
+    struct stat st;
+    unsigned int i;
+
+    if (fstat( fd, &st )) return;
+    pthread_mutex_lock( &ios_section_view_lock );
+    if (!(v = ios_section_view_slot()))
+    {
+        pthread_mutex_unlock( &ios_section_view_lock );
+        return;
+    }
+    v->peb = ios_jit_current_peb();
+    v->base = base;
+    v->size = size;
+    v->dev = st.st_dev;
+    v->ino = st.st_ino;
+    v->offset = offset;
+    v->copy = NULL;
+    for (i = 0; i < ios_section_view_count; i++)
+    {
+        const struct ios_section_view *r = &ios_section_views[i];
+        if (r->peb == v->peb && r->copy && r->dev == v->dev && r->ino == v->ino) ios_section_view_alias( v, r );
+    }
+    pthread_mutex_unlock( &ios_section_view_lock );
+}
+
+/* Forget the view at base (unmap_view_of_section). */
+static void ios_section_view_remove( const void *base )
+{
+    unsigned int i;
+    pthread_mutex_lock( &ios_section_view_lock );
+    for (i = 0; i < ios_section_view_count; i++)
+        if (ios_section_views[i].peb && ios_section_views[i].base == base) ios_section_views[i].peb = NULL;
+    pthread_mutex_unlock( &ios_section_view_lock );
+}
+
+/* Forget a gone pseudo-process's views (ios_jit_reclaim_process). */
+static void ios_section_views_reclaim( void *peb )
+{
+    unsigned int i;
+    pthread_mutex_lock( &ios_section_view_lock );
+    for (i = 0; i < ios_section_view_count; i++)
+        if (ios_section_views[i].peb == peb) ios_section_views[i].peb = NULL;
+    pthread_mutex_unlock( &ios_section_view_lock );
+}
+
+/* x18-patch size bytes of a presented copy from image offset off, with the rest
+ * of the image's trampoline reservation, and flush them. cipher as for
+ * ios_jit_patch_x18. ios_section_view_lock is held. */
+static void ios_jit_repatch_x18( struct ios_jit_mapping *m, size_t off, size_t size, int cipher )
+{
+    char *image_rw = (char *)ios_jit_rw_base_global + ((char *)m->jit_base - (char *)ios_jit_rx_base_global);
+    size_t start = off > m->text_offset ? off : m->text_offset;
+    size_t end = off + size < m->text_offset + m->text_size ? off + size : m->text_offset + m->text_size;
+    size_t used = 0;
+
+    if (m->x18_tramp_size && start < end)
+    {
+        /* the windows of the load's scan, from the start of .text */
+        if (cipher == 1) start = m->text_offset + ((start - m->text_offset) & ~(size_t)1023);
+        start &= ~(size_t)3;
+        ios_jit_patch_x18( image_rw + start, (char *)m->jit_base + start, end - start, start,
+                           image_rw + m->x18_tramp_off + m->x18_tramp_used,
+                           (char *)m->jit_base + m->x18_tramp_off + m->x18_tramp_used,
+                           m->x18_tramp_size - m->x18_tramp_used, cipher, &used );
+        if (used) sys_icache_invalidate( (char *)m->jit_base + m->x18_tramp_off + m->x18_tramp_used, used );
+        m->x18_tramp_used += used;
+    }
+    __asm__ __volatile__( "dsb sy" ::: "memory" );
+    sys_icache_invalidate( (char *)m->jit_base + off, size );
+}
+
+/* NtMapViewOfSection[Ex] at a presented copy's address: see above. */
+static BOOL ios_remap_presented( HANDLE handle, PVOID *addr_ptr, SIZE_T commit_size, const LARGE_INTEGER *offset_ptr,
+                                 SIZE_T *size_ptr, ULONG alloc_type, ULONG protect, NTSTATUS *status )
+{
+    extern int ios_is_native_arm64_cur(void);
+    SECTION_BASIC_INFORMATION info;
+    struct ios_jit_mapping *m;
+    struct ios_section_view *v = NULL;
+    char *copy = *addr_ptr;
+    size_t size, one = 0;
+    uintptr_t pe;
+    void *view;
+    unsigned int i;
+
+    if (!copy || !ios_is_native_arm64_cur() || !(m = ios_jit_presented_at( copy, &pe ))) return FALSE;
+    if (NtQuerySection( handle, SectionBasicInformation, &info, sizeof(info), NULL ) ||
+        (info.Attributes & SEC_IMAGE)) return FALSE;
+    view = (void *)pe;
+    *status = virtual_map_section( handle, &view, 0, 0, commit_size, offset_ptr, size_ptr, alloc_type, protect, 0 );
+    if (!NT_SUCCESS( *status ))
+    {
+        dprintf( 2, "[remap] %s: section view at %p+%#lx could not take its backing store %p: %#x\n",
+                 ios_pe_module_name( m->pe_base, m->image_size ), copy, (unsigned long)*size_ptr, (void *)pe,
+                 (unsigned)*status );
+        return TRUE;
+    }
+    size = *size_ptr;
+    if (copy + size > (char *)m->jit_base + m->size) size = (char *)m->jit_base + m->size - copy;
+    pthread_mutex_lock( &ios_section_view_lock );
+    for (i = 0; i < ios_section_view_count; i++)
+        if (ios_section_views[i].peb && ios_section_views[i].base == view) v = &ios_section_views[i];
+    if (protect != PAGE_NOACCESS)
+    {
+        memcpy( (char *)ios_jit_rw_base_global + (copy - (char *)ios_jit_rx_base_global), view, size );
+        if (protect & (PAGE_EXECUTE | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY))
+            ios_jit_repatch_x18( m, copy - (char *)m->jit_base, size, 1 );
+    }
+    if (v)
+    {
+        v->copy = copy;
+        for (i = 0; i < ios_section_view_count; i++)
+        {
+            struct ios_section_view *s = &ios_section_views[i];
+            if (s->peb == v->peb && !s->copy && s->dev == v->dev && s->ino == v->ino)
+                one += ios_section_view_alias( s, v );
+        }
+    }
+    pthread_mutex_unlock( &ios_section_view_lock );
+    dprintf( 2, "[remap] %s: a section view (offset %#llx, prot %#x) at %p+%#lx, its image's copy: mapped at %p, "
+             "the copy took its bytes, %#lx bytes of other views made one with it; x18 trampolines %#lx of %#lx used%s\n",
+             ios_pe_module_name( m->pe_base, m->image_size ),
+             (unsigned long long)(offset_ptr ? offset_ptr->QuadPart : 0), (unsigned)protect, copy,
+             (unsigned long)size, view, (unsigned long)one, (unsigned long)m->x18_tramp_used,
+             (unsigned long)m->x18_tramp_size, v ? "" : " (no section record)" );
+    return TRUE;
+}
+
+/* NtFlushInstructionCache in a native child: see above. */
+static void ios_remap_flush( const char *addr, SIZE_T size )
+{
+    extern int ios_is_native_arm64_cur(void);
+    struct ios_jit_mapping *m;
+    struct ios_section_view *v = NULL;
+    unsigned int i;
+    void *peb;
+
+    if (!size || !ios_is_native_arm64_cur()) return;
+    peb = ios_jit_current_peb();
+    pthread_mutex_lock( &ios_section_view_lock );
+    if ((m = ios_jit_presented_at( addr, NULL )))
+    {
+        if (addr + size > (char *)m->jit_base + m->size) size = (char *)m->jit_base + m->size - addr;
+        ios_jit_repatch_x18( m, addr - (char *)m->jit_base, size, 2 );
+        pthread_mutex_unlock( &ios_section_view_lock );
+        return;
+    }
+    for (i = 0; i < ios_section_view_count; i++)
+    {
+        struct ios_section_view *s = &ios_section_views[i];
+        if (s->peb == peb && !s->copy && addr >= s->base && addr < s->base + s->size) v = s;
+    }
+    if (v)
+    {
+        ULONGLONG lo = v->offset + (addr - v->base);
+        ULONGLONG hi = lo + (addr + size <= v->base + v->size ? size : (SIZE_T)(v->base + v->size - addr));
+        for (i = 0; i < ios_section_view_count; i++)
+        {
+            struct ios_section_view *r = &ios_section_views[i];
+            ULONGLONG from, to;
+
+            if (r->peb != peb || !r->copy || r->dev != v->dev || r->ino != v->ino) continue;
+            from = lo > r->offset ? lo : r->offset;
+            to = hi < r->offset + r->size ? hi : r->offset + r->size;
+            if (from >= to || !(m = ios_jit_presented_at( r->copy, NULL ))) continue;
+            if (r->copy + (to - r->offset) > (char *)m->jit_base + m->size) continue;
+            {   /* a part not made one with the copy (ios_section_view_alias) is copied, but
+                 * for the words patched there already: their originals are the view's */
+                char *rx = r->copy + (from - r->offset);
+                char *rw = (char *)ios_jit_rw_base_global + (rx - (char *)ios_jit_rx_base_global);
+                const char *src = v->base + (from - v->offset);
+                const char *tramp = (char *)m->jit_base + m->x18_tramp_off;
+                size_t n = to - from, k, len;
+
+                if (memcmp( rw, src, n ))
+                    for (k = 0; k < n; k += len)
+                    {
+                        len = 4 - ((uintptr_t)(rx + k) & 3);
+                        if (len > n - k) len = n - k;
+                        if (!memcmp( rw + k, src + k, len )) continue;
+                        if (len == 4 && ios_x18_patched_site( *(const uint32_t *)(rw + k), *(const uint32_t *)(src + k),
+                                                              rx + k, tramp, m->x18_tramp_used )) continue;
+                        memcpy( rw + k, src + k, len );
+                    }
+            }
+            ios_jit_repatch_x18( m, r->copy + (from - r->offset) - (char *)m->jit_base, to - from, 2 );
+            ios_remap_flush_bytes += to - from;
+            if (!(ios_remap_flushes++ & 0xff) || ios_remap_flushes <= 8)
+                dprintf( 2, "[remap] %s: flushed %p+%#lx, its copy at %p (flush %lu, %lu bytes in all, "
+                         "x18 trampolines %#lx of %#lx used)\n",
+                         ios_pe_module_name( m->pe_base, m->image_size ), addr, (unsigned long)size,
+                         r->copy + (from - r->offset), ios_remap_flushes, ios_remap_flush_bytes,
+                         (unsigned long)m->x18_tramp_used, (unsigned long)m->x18_tramp_size );
+        }
+    }
+    pthread_mutex_unlock( &ios_section_view_lock );
+}
