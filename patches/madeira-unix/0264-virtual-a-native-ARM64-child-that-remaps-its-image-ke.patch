@@ -5420,6 +5503,27 @@ static unsigned char *ios_x18_build_data_map( const char *text, size_t text_size
         }
     }
     for (size_t k = 0; k < text_size / 32 + 1; k++) data_map[k] |= x64_map[k];
+    /* Playport (PLA-514): with cipher, a 1 KB window (from the start of text) in which
+     * more than 8 of its 256 words fall in the two unallocated top-level encoding
+     * groups (op0 = 0b0001, 0b0011) is data. No compiler emits those words, and
+     * encrypted bytes put an eighth of their words there. World of Warcraft's ARM64
+     * client ships most of its .text encrypted and decrypts it at run time from the
+     * bytes at its image: a word patched there decrypts to garbage. */
+    if (cipher)
+    {
+        for (size_t w0 = 0; w0 < text_size; w0 += 1024)
+        {
+            size_t end = w0 + 1024 < text_size ? w0 + 1024 : text_size, b;
+            int unallocated = 0;
+            for (b = w0; b + 4 <= end; b += 4)
+            {
+                uint32_t op0 = (*(const uint32_t *)(text + b) >> 25) & 0xf;
+                unallocated += op0 == 1 || op0 == 3;
+            }
+            if (unallocated > 8)
+                for (b = w0; b + 4 <= end; b += 4) data_map[(b / 4) >> 3] |= 1 << ((b / 4) & 7);
+        }
+    }
     free( x64_map );
     return data_map;
 }
