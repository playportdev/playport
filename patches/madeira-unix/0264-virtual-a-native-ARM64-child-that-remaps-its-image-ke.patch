+/* Playport (PLA-514): the data map of code a program decrypted at run time and flushed:
+ * every word is data but those reachable from the first one, following fall-through,
+ * B, B.cond, CBZ/CBNZ, TBZ/TBNZ (not into calls), up to a RET, BR, their pointer-
+ * authenticated forms, a UDF (which World of Warcraft's client executes on purpose to
+ * raise) or an unallocated word. A reachable word is code even where an LDR reads it as
+ * a literal: it runs.
+ * Code whose words sit beside encrypted bytes, and obfuscated code with junk words
+ * after its branches, is patched without touching those: a patched encrypted word
+ * decrypts to garbage. Caller frees; NULL on alloc failure. */
+static unsigned char *ios_x18_reachable_map( const char *text, size_t text_size )
+{
+    size_t words = text_size / 4, top = 0, i;
+    unsigned char *seen = calloc( 1, words / 8 + 1 ), *data_map = malloc( text_size / 32 + 1 );
+    size_t *stack = malloc( (words + 1) * sizeof(*stack) );
+
+    if (!seen || !data_map || !stack)
+    {
+        free( seen );
+        free( data_map );
+        free( stack );
+        return NULL;
+    }
+    memset( data_map, 0xff, text_size / 32 + 1 );
+    if (words) stack[top++] = 0;
+    while (top)
+    {
+        size_t w = stack[--top];
+        while (w < words && !(seen[w >> 3] & (1 << (w & 7))))
+        {
+            uint32_t insn = ((const uint32_t *)text)[w];
+            uint32_t op0 = (insn >> 25) & 0xf;
+            int64_t off = 0;
+            int branch = 0, next = 1;
+
+            seen[w >> 3] |= 1 << (w & 7);
+            if (op0 == 1 || op0 == 3) { seen[w >> 3] &= ~(1 << (w & 7)); break; }   /* not code */
+            if ((insn & 0xfc000000) == 0x14000000)                              /* B */
+            {
+                off = (int64_t)((int32_t)(insn << 6) >> 6) * 4; branch = 1; next = 0;
+            }
+            else if ((insn & 0xff000010) == 0x54000000 || (insn & 0x7e000000) == 0x34000000)
+            {                                                                   /* B.cond, CBZ/CBNZ */
+                off = (int64_t)((int32_t)(insn << 8) >> 13) * 4; branch = 1;
+            }
+            else if ((insn & 0x7e000000) == 0x36000000)                         /* TBZ/TBNZ */
+            {
+                off = (int64_t)((int32_t)(insn << 13) >> 18) * 4; branch = 1;
+            }
+            else if ((insn & 0xfffffc1f) == 0xd65f0000 || (insn & 0xfffffc1f) == 0xd61f0000 ||
+                     insn == 0xd65f0bff || insn == 0xd65f0fff || (insn & 0xfefff800) == 0xd61f0800 ||
+                     (insn & 0xffff0000) == 0)
+                next = 0;                                       /* RET, BR, RETAA/AB, BRAA/AB(Z), UDF */
+            if (branch && (int64_t)w * 4 + off >= 0 && (size_t)((int64_t)w * 4 + off) < text_size)
+                stack[top++] = (size_t)((int64_t)w * 4 + off) / 4;
+            if (!next) break;
+            w++;
+        }
+    }
+    for (i = 0; i < words; i++)
+        if (seen[i >> 3] & (1 << (i & 7))) data_map[i >> 3] &= ~(1 << (i & 7));
+    free( seen );
+    free( stack );
+    return data_map;
+}
