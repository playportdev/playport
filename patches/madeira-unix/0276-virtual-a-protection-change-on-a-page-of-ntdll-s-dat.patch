+/* Playport (PLA-516): what a protection change on an image page copies into the pool copy
+ * (pp_image_sync.h): only the words written while the page was open, into the copy of the
+ * process that made the change. */
+#include "pp_image_sync.h"
+static struct ppis_table ios_image_sync;
+static pthread_mutex_t ios_image_sync_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* The mapping whose copy a protection change of [base, base + size) syncs: the current
+ * process's own copy of the image (a child's ntdll), else the shared one, as
+ * ios_jit_translate_addr_for_owner resolves an address; -1 when no image holds the region. */
+static int ios_image_sync_mapping( uintptr_t base, size_t size )
+{
+    void *owner = ios_jit_current_peb();
+    int i, shared = -1, any = -1;
+
+    for (i = 0; i < ios_jit_mapping_count; i++)
+    {
+        uintptr_t pe_start = (uintptr_t)ios_jit_mappings[i].pe_base;
+        if (base < pe_start || base + size > pe_start + ios_jit_mappings[i].size) continue;
+        if (ios_jit_mappings[i].owner_peb == owner) return i;
+        if (!ios_jit_mappings[i].owner_peb && shared < 0) shared = i;
+        if (any < 0) any = i;
+    }
+    return shared >= 0 ? shared : any;
+}
