 }
 
+/* Playport (PLA-516): whether [off, off + size) of an image lies in writable sections
+ * (IMAGE_SCN_MEM_WRITE, .data): where the image's own code keeps its globals, in its copy. */
+static int ios_img_off_is_writable( const void *img, size_t img_size, size_t off )
+{
+    const IMAGE_DOS_HEADER *dos = img;
+    const IMAGE_NT_HEADERS *nt;
+    const IMAGE_SECTION_HEADER *sec;
+    unsigned i;
+
+    if (!img || dos->e_magic != IMAGE_DOS_SIGNATURE) return 0;
+    if ((size_t)dos->e_lfanew + sizeof *nt > img_size) return 0;
+    nt = (const IMAGE_NT_HEADERS *)((const char *)img + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE) return 0;
+    sec = IMAGE_FIRST_SECTION( nt );
+    for (i = 0; i < nt->FileHeader.NumberOfSections; i++)
+    {
+        size_t lo = sec[i].VirtualAddress;
+        size_t vs = ((sec[i].Misc.VirtualSize ? sec[i].Misc.VirtualSize : sec[i].SizeOfRawData) + 0xfff) & ~(size_t)0xfff;
+        if (off < lo || off >= lo + vs) continue;
+        return (sec[i].Characteristics & IMAGE_SCN_MEM_WRITE) ? 1 : 0;
+    }
+    return 0;
+}
+
+static int ios_img_range_is_writable( const void *img, size_t img_size, size_t off, size_t size )
+{
+    return size && ios_img_off_is_writable( img, img_size, off ) &&
+           ios_img_off_is_writable( img, img_size, off + size - 1 );
+}
