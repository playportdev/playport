--- /dev/null
+++ b/build/ntdll-unix/pp_image_sync.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * What a protection change on an image page copies into the image's pool copy (Playport, PLA-516).
+ *
+ * An ARM64EC image runs from its JIT-pool copy, and its own code reads and writes its globals there:
+ * for those bytes the copy is the live one and the image's page is stale. The loader, though, writes
+ * a module's import table and ARM64EC metadata slots at the image's address, between a protection
+ * change that opens the page (PAGE_READWRITE) and one that restores it, and NtProtectVirtualMemory
+ * then brings the image's page into the copy. Copying the whole page put stale bytes over the live
+ * ones: a guest's VirtualProtect of a page of ntdll's .data (World of Warcraft's x64 client hooks
+ * Wow64PrepareForException there; the page also holds the loader's hash_table, node_ntdll, tls_dirs)
+ * wrote the image's copy of those over the pool's, and a process then crashed in
+ * find_basename_module.
+ *
+ * So the image's bytes are kept when a page is opened (ppis_keep), and when it is restored only the
+ * 8-byte words written in between are copied (ppis_take, ppis_merge). A region with nothing kept
+ * (larger than PPIS_MAX_BYTES, or never opened) is copied whole, as before.
+ */
+#ifndef PP_IMAGE_SYNC_H
+#define PP_IMAGE_SYNC_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define PPIS_SNAPS     8
+#define PPIS_MAX_BYTES 0x10000
+
+struct ppis_snap
+{
+    uintptr_t base;
+    size_t size;
+    unsigned char *bytes;
+};
+
+struct ppis_table
+{
+    struct ppis_snap snap[PPIS_SNAPS];
+    unsigned next;
+};
+
+/* A protection that opens a page for writing: what the loader (PAGE_READWRITE) and a guest
+ * (PAGE_EXECUTE_READWRITE) ask for before they write. A write-copy protection is what they restore. */
+static inline int ppis_opens( unsigned int prot )
+{
+    prot &= 0xff;
+    return prot == 0x04 /* PAGE_READWRITE */ || prot == 0x40 /* PAGE_EXECUTE_READWRITE */;
+}
+
+/* Keeps the image's bytes of [base, base + size) as they are now; 1 when kept. */
+static inline int ppis_keep( struct ppis_table *t, const void *base, size_t size )
+{
+    unsigned i;
+
+    if (!size || size > PPIS_MAX_BYTES) return 0;
+    for (i = 0; i < PPIS_SNAPS; i++)
+        if (t->snap[i].bytes && t->snap[i].base == (uintptr_t)base && t->snap[i].size == size) break;
+    if (i == PPIS_SNAPS)
+    {
+        i = t->next++ % PPIS_SNAPS;
+        free( t->snap[i].bytes );
+        t->snap[i].bytes = NULL;
+    }
+    if (!t->snap[i].bytes && !(t->snap[i].bytes = malloc( size ))) return 0;
+    memcpy( t->snap[i].bytes, base, size );
+    t->snap[i].base = (uintptr_t)base;
+    t->snap[i].size = size;
+    return 1;
+}
+
+/* The bytes kept when exactly [base, base + size) was opened, now the caller's to free; NULL if none. */
+static inline unsigned char *ppis_take( struct ppis_table *t, const void *base, size_t size )
+{
+    unsigned i;
+
+    for (i = 0; i < PPIS_SNAPS; i++)
+        if (t->snap[i].bytes && t->snap[i].base == (uintptr_t)base && t->snap[i].size == size)
+        {
+            unsigned char *bytes = t->snap[i].bytes;
+            t->snap[i].bytes = NULL;
+            return bytes;
+        }
+    return NULL;
+}
+
+/* Whether the 8-byte word at offset of src (offset + 8 <= the region's size) was written since
+ * was was kept: the relocation and pointer passes after a merge touch only those words, as they
+ * would only those a whole copy had brought in. */
+static inline int ppis_written( const unsigned char *src, const unsigned char *was, size_t offset )
+{
+    return memcmp( src + offset, was + offset, 8 ) != 0;
+}
+
+/* Copies to dst each 8-byte word (and trailing byte) of src that differs from was: what was written
+ * since was was kept. Whole words, so a pointer written over a relocated one is never half copied.
+ * Returns the bytes copied. */
+static inline size_t ppis_merge( unsigned char *dst, const unsigned char *src, const unsigned char *was,
+                                 size_t size )
+{
+    size_t i, copied = 0;
+
+    for (i = 0; i + 8 <= size; i += 8)
+        if (memcmp( src + i, was + i, 8 ))
+        {
+            memcpy( dst + i, src + i, 8 );
+            copied += 8;
+        }
+    for (; i < size; i++)
+        if (src[i] != was[i])
+        {
+            dst[i] = src[i];
+            copied++;
+        }
+    return copied;
+}
+
+#endif /* PP_IMAGE_SYNC_H */
