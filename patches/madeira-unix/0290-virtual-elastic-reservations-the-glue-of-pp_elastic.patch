From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Mon, 2 Nov 2026 17:44:30 +0100
Subject: [PATCH] virtual: elastic reservations, the glue of pp_elastic.h

The Wine glue of decision 0180's rule: virtual_ios.c now calls
pp_elastic.h (madeira-unix 0289) and performs only the mappings it
decides. Nothing changes until a reservation fails for room
(STATUS_NO_MEMORY). Then:

- the untouched upper part of the large plain reservation with the most
  lendable room goes back to the host (free_pages on the view's tail):
  the view shrinks in Wine's view tracking, keeps a 32 MiB guard at its
  new end, and its claim, the size the guest was told, is remembered;
- an unhinted reserve-only ask from 1 GiB that cannot be placed whole
  gets a short grant with its guard, below earlier claims, and is told
  it got its full size;
- once engaged, an elastic ask of 256 MiB or more is placed outside
  every live claim when a gap there holds it whole, else as today;
  nothing is lent or shortened before today's placement has failed;
- a never-shrunk ask (limited, aligned, commit-at-reserve) gets at
  most one lend, from a lender whose freed range holds it, and today's
  placement once more.

A commit, in allocate_virtual_memory's commit branch for both entry
points, is matched to its own elastic view first, then to the claim
covering it. Reaching the guard or the claim beyond it grows the view
in place, doubling, with a no-overwrite fixed mapping, the guard moving
up; when the space above is taken it returns STATUS_NO_MEMORY and is
logged with what blocked it. It is never served inside another view.
The views carry VPROT_ELASTIC (PR #84's flag); their release ends the
claim. A decommit or release over a shortened view's claim frees its
real view, as Windows frees the whole reservation. VirtualQuery reports the real view, never the tail beyond it as
the guest's; a query inside a shortened view's claim is logged.

Never shrunk, by property: hinted, aligned, placeholder, Ex asks with
address requirements, zero_bits/limited, commit-at-reserve, and every
ask the Social Club layout's router sees, which runs first. The window is the guest's below FEX's band; free
ranges come from the kernel map, so the holds are never lent.

One tag, [elastic], for place, grant, lend, grow, refuse and query:
address, real size, claim, committed height; each kind counted, its
first 32 lines printed and then every power of two, in both variants.

Linear: PLA-802
Class: feature
Evidence: docs/evidence/2026-11-02-elastic-reservations.md
Offered-upstream: no; the address-space layout is the iOS port's
---
 build/ntdll-unix/virtual_ios.c | 498 ++++++++++++++++++++++++++++++++-
 1 file changed, 493 insertions(+), 5 deletions(-)

diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index 0b72e3a..a4e41a0 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -124,6 +124,7 @@ extern kern_return_t vm_protect(mach_port_t target_task, vm_address_t address,
 #define VPROT_WOW64_VM 0x4000 /* anonymous i386 storage, logical EXEC only */
 #define VPROT_WOW64_DATA 0x8000 /* a data section's view (file or pagefile backed) */
 #define VPROT_X64_IMAGE 0x10000 /* pure x86-64 image: logical EXEC only, no pool copy */
+#define VPROT_ELASTIC 0x20000 /* Playport (PLA-802): a view pp_elastic.h tracks (ios_ppe) */
 #include "ios_process_image.h"
 #include "ios_copy_extent.h"
 #include "wine/debug.h"
@@ -1483,6 +1484,13 @@ static void ios_pool_owner_search( const uint64_t *wanted, unsigned nwanted )
 static struct { uint64_t base, size, committed; unsigned commits, collisions; } ios_soft[IOS_SOFT_MAX];
 static unsigned ios_soft_n;
 
+/* Playport (PLA-802, decision 0180): elastic reservations. The policy is
+ * pp_elastic.h; the glue (ios_elastic_*, before allocate_virtual_memory_body)
+ * performs what it decides. One state for the address space, which every
+ * pseudo-process shares, under virtual_mutex. */
+#include "pp_elastic.h"
+static struct ppe_state ios_ppe;
+
 static int ios_soft_find( uint64_t addr )
 {
     /* The smallest matching range wins. */
@@ -10732,6 +10740,8 @@ static void delete_view( struct file_view *view ) /* [in] View */
     ios_swap_release_range( view->base, view->size, 0 );   /* ml1077 */
 #ifdef WINE_IOS
     ios_code_alias_drop( view );   /* Playport (PLA-516) */
+    /* Playport (PLA-802): its claim ends with it (pp_elastic.h). */
+    if (view->protect & VPROT_ELASTIC) ppe_released( &ios_ppe, (uint64_t)(uintptr_t)view->base );
 #endif
     if (!(view->protect & VPROT_SYSTEM)) unmap_area( view->base, view->size );
     if (ios_retire_trace_armed) ios_retire_mark( "D1u\n" );   /* unmap_area done */
@@ -15131,6 +15141,14 @@ static NTSTATUS remove_pages_from_view( struct file_view *view, char *base, size
         unregister_view( view );
         if (view->base == base)
         {
+#ifdef WINE_IOS
+            /* Playport (PLA-802): pp_elastic.h knows a view by its base. */
+            if (view->protect & VPROT_ELASTIC)
+            {
+                ppe_released( &ios_ppe, (uint64_t)(uintptr_t)view->base );
+                view->protect &= ~VPROT_ELASTIC;
+            }
+#endif
             view->base = base + size;
             view->size -= size;
         }
@@ -21376,6 +21394,443 @@ static NTSTATUS decommit_pages( struct file_view *view, char *base, size_t size
 #include "pp_sc_vm.h"
 #include "pp_sc_access.h"
 
+/***********************************************************************
+ *           Elastic reservations (Playport, PLA-802, decision 0180)
+ *
+ * The glue around pp_elastic.h, the policy: it reads the guest window's free
+ * ranges, performs the mappings the module decides and reports them back.
+ * Under virtual_mutex throughout (recursive: allocate_virtual_memory nests).
+ * Nothing changes until a reservation fails for room.
+ *
+ * One tag, [elastic], for place, grant, lend, grow and refuse, and for a
+ * VirtualQuery inside a shortened view's claim: each line gives the address,
+ * the real size, the claim and the committed height. Each kind is counted;
+ * its first 32 lines print, then every power of two. Plain dprintf, so the
+ * release variant has them too, as it has [alloc-fail].
+ */
+#define IOS_PPE_TOP      0x7c00000000ULL   /* FEX's band starts here */
+#define IOS_PPE_GAPS_MAX 512
+#define IOS_PPE_MB(x)    ((unsigned long long)(x) >> 20)
+#define IOS_PPE_KB(x)    ((unsigned long long)(x) >> 10)
+
+enum ios_ppe_kind { IOS_PPE_PLACE, IOS_PPE_GRANT, IOS_PPE_LEND, IOS_PPE_GROW, IOS_PPE_REFUSE, IOS_PPE_QUERY,
+                    IOS_PPE_LINES };
+static unsigned ios_ppe_lines[IOS_PPE_LINES];
+static struct ppe_gap ios_ppe_gaps[IOS_PPE_GAPS_MAX];
+
+/* Counts a line of a kind: its number when it prints, else 0. */
+static unsigned ios_ppe_line( enum ios_ppe_kind kind )
+{
+    unsigned n = ++ios_ppe_lines[kind];
+
+    return n <= 32 || !(n & (n - 1)) ? n : 0;
+}
+
+/* An ask for pp_elastic.h: its properties, and the limit and alignment a
+ * never-shrunk one requires. limit_high: zero_bits' limit or an Ex upper
+ * limit (the highest address, inclusive); the others are
+ * NtAllocateVirtualMemoryEx's requirements. */
+static struct ppe_ask ios_ppe_ask( void *hint, SIZE_T size, ULONG type, ULONG_PTR limit_low, ULONG_PTR limit_high,
+                                   ULONG_PTR align, ULONG attributes )
+{
+    struct ppe_ask ask = { size, 0, limit_high ? (uint64_t)limit_high + 1 : 0, align };
+
+    if (hint) ask.flags |= PPE_ASK_HINT;
+    if (limit_high) ask.flags |= PPE_ASK_LIMIT;
+    if (limit_low || attributes) ask.flags |= PPE_ASK_EX_ADDR;
+    if (align) ask.flags |= PPE_ASK_ALIGN;
+    if (type & MEM_COMMIT) ask.flags |= PPE_ASK_COMMIT;
+    if (type & (MEM_RESERVE_PLACEHOLDER | MEM_REPLACE_PLACEHOLDER)) ask.flags |= PPE_ASK_PLACEHOLDER;
+    /* Every ask the Social Club layout's router sees is the layout's (ppsc_route's guards). */
+    if (ppsc_ready && type == MEM_RESERVE && !limit_low && !limit_high && !align && !attributes && ppsc_helper())
+        ask.flags |= PPE_ASK_LAYOUT;
+    return ask;
+}
+
+/* The guest window's free ranges of at least min bytes, ascending, between
+ * the usable floor and FEX's band: the holds are mapped, so they are not
+ * among them. Past IOS_PPE_GAPS_MAX the smallest go. */
+static unsigned ios_ppe_gaps_read( uint64_t min )
+{
+    uint64_t prev = ios_usable_va_floor;
+    unsigned n = 0;
+
+    if (min < PPE_GRAIN) min = PPE_GRAIN;
+    while (prev < IOS_PPE_TOP)
+    {
+        mach_vm_address_t a = prev;
+        mach_vm_size_t sz = 0;
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t obj = MACH_PORT_NULL;
+        uint64_t end;
+
+        if (mach_vm_region( mach_task_self(), &a, &sz, VM_REGION_BASIC_INFO_64,
+                            (vm_region_info_t)&info, &cnt, &obj ) != KERN_SUCCESS || a > IOS_PPE_TOP)
+        {
+            a = IOS_PPE_TOP;
+            sz = 0;
+        }
+        end = a;
+        if (end > prev && end - prev >= min)
+        {
+            int keep = 1;
+
+            if (n == IOS_PPE_GAPS_MAX)
+            {
+                unsigned s = 0, k;
+
+                for (k = 1; k < n; k++) if (ios_ppe_gaps[k].size < ios_ppe_gaps[s].size) s = k;
+                if (ios_ppe_gaps[s].size >= end - prev) keep = 0;
+                else memmove( &ios_ppe_gaps[s], &ios_ppe_gaps[s + 1], (--n - s) * sizeof(ios_ppe_gaps[0]) );
+            }
+            if (keep)
+            {
+                ios_ppe_gaps[n].base = prev;
+                ios_ppe_gaps[n].size = end - prev;
+                n++;
+            }
+        }
+        if (a + sz <= prev) break;
+        prev = a + sz;
+    }
+    return n;
+}
+
+/* Free bytes from `from` up to the next mapping or FEX's band; *next: where they end. */
+static uint64_t ios_ppe_free_above( uint64_t from, uint64_t *next )
+{
+    mach_vm_address_t a = from;
+    mach_vm_size_t sz = 0;
+    vm_region_basic_info_data_64_t info;
+    mach_msg_type_number_t cnt = VM_REGION_BASIC_INFO_COUNT_64;
+    mach_port_t obj = MACH_PORT_NULL;
+
+    if (from >= IOS_PPE_TOP) a = from;
+    else if (mach_vm_region( mach_task_self(), &a, &sz, VM_REGION_BASIC_INFO_64,
+                             (vm_region_info_t)&info, &cnt, &obj ) != KERN_SUCCESS || a > IOS_PPE_TOP)
+        a = IOS_PPE_TOP;
+    if (a < from) a = from;
+    *next = a;
+    return a - from;
+}
+
+/* Track a view placed at base: real usable bytes of claim. Only views in the
+ * guest window: room lent above it is no use to an ask. */
+static void ios_ppe_track( void *base, SIZE_T claim, SIZE_T real, unsigned flags )
+{
+    uint64_t b = (uint64_t)(uintptr_t)base;
+    struct file_view *view;
+
+    if (b < ios_usable_va_floor || b + real > IOS_PPE_TOP) return;
+    if (ppe_placed( &ios_ppe, b, claim, real, flags ) < 0) return;
+    if ((view = find_view( base, 0 )) && view->base == base) view->protect |= VPROT_ELASTIC;
+    else ppe_released( &ios_ppe, b );
+}
+
+/* Shrink view i to keep bytes, its last PPE_GUARD the guard, and give the
+ * rest back to the host. The guest keeps the view and its claim. */
+static int ios_ppe_lend( int i, uint64_t keep, SIZE_T ask )
+{
+    const struct ppe_view *pv = &ios_ppe.v[i];
+    struct file_view *view = find_view( (void *)(uintptr_t)pv->base, 0 );
+    size_t span;
+    unsigned n;
+
+    if (!view || (uint64_t)(uintptr_t)view->base != pv->base || keep >= view->size) return 0;
+    span = view->size;
+    if (free_pages( view, (char *)view->base + keep, view->size - keep )) return 0;
+    ppe_lent( &ios_ppe, i, keep );
+    if ((n = ios_ppe_line( IOS_PPE_LEND )))
+        dprintf( 2, "[elastic] lend #%u 0x%llx real %llu MB claim %llu MB high %llu KB: keeps %llu MB with its "
+                    "guard, %llu MB back to the host for a %llu MB ask\n",
+                 n, (unsigned long long)pv->base, IOS_PPE_MB(pv->real), IOS_PPE_MB(pv->claim),
+                 IOS_PPE_KB(pv->high), IOS_PPE_MB(keep), IOS_PPE_MB(span - keep), IOS_PPE_MB(ask) );
+    return 1;
+}
+
+/* Grow view i in place to real usable bytes: the space above its guard is
+ * mapped no-overwrite and becomes part of the view, the guard moving up. */
+static int ios_ppe_grow( int i, uint64_t real )
+{
+    const struct ppe_view *pv = &ios_ppe.v[i];
+    char *old_end = (char *)(uintptr_t)ppe_view_end( &ios_ppe, i );
+    size_t delta = real - pv->real;
+    struct file_view *view = find_view( (void *)(uintptr_t)pv->base, 0 );
+    BYTE vprot;
+
+    if (!view || (uint64_t)(uintptr_t)view->base != pv->base || (char *)view->base + view->size != old_end)
+        return 0;
+    if (find_view_range( old_end, delta )) return 0;
+    if (anon_mmap_tryfixed( old_end, delta, PROT_NONE, 0 ) == MAP_FAILED) return 0;
+    if (!alloc_pages_vprot( old_end, delta ))
+    {
+        munmap( old_end, delta );
+        return 0;
+    }
+    vprot = get_page_vprot( old_end - page_size ) & ~VPROT_COMMITTED;   /* the old guard's: reserved */
+    unregister_view( view );
+    view->size += delta;
+    register_view( view );
+    set_page_vprot( old_end, delta, vprot );
+    ppe_grown( &ios_ppe, i, real );
+    return 1;
+}
+
+/* A reservation placed as today: tracked when it may lend. */
+static void ios_elastic_placed( void *base, SIZE_T size, unsigned flags )
+{
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    ios_ppe_track( base, size, size, flags );
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+}
+
+/* Map a module decision's view at d->addr: the ask whole (PPE_PLACE), or a
+ * short grant's real part and guard (PPE_SHORT). Logs it and tracks it. */
+static NTSTATUS ios_ppe_map( const struct ppe_decision *d, const struct ppe_ask *ask, ULONG type, ULONG protect,
+                             void **ret, SIZE_T *size_ptr )
+{
+    int is_short = d->kind == PPE_SHORT;
+    uint64_t real = is_short ? d->real : ask->size;
+    void *p = (void *)(uintptr_t)d->addr;
+    SIZE_T sz = is_short ? d->real + PPE_GUARD : ask->size;
+    unsigned line;
+    NTSTATUS status;
+
+    if ((status = allocate_virtual_memory( &p, &sz, type & ~MEM_TOP_DOWN, protect, 0, 0, 0, 0 ))) return status;
+    ios_ppe_track( p, ask->size, real, ask->flags );
+    if (is_short && (line = ios_ppe_line( IOS_PPE_GRANT )))
+        dprintf( 2, "[elastic] grant #%u %p real %llu MB + %llu MB guard claim %llu MB high 0 KB: "
+                    "a %llu MB ask, told it got all of it\n", line, p, IOS_PPE_MB(real),
+                 IOS_PPE_MB(PPE_GUARD), IOS_PPE_MB(ask->size), IOS_PPE_MB(ask->size) );
+    else if (!is_short && (line = ios_ppe_line( IOS_PPE_PLACE )))
+        dprintf( 2, "[elastic] place #%u %p real %llu MB claim %llu MB high 0 KB: whole, outside "
+                    "every claim\n", line, p, IOS_PPE_MB(sz), IOS_PPE_MB(ask->size) );
+    *ret = p;
+    *size_ptr = is_short ? (ask->size + page_mask) & ~(SIZE_T)page_mask : sz;   /* a short grant reports the ask */
+    return STATUS_SUCCESS;
+}
+
+/* Before today's placement of a reservation: once a placement has failed, an
+ * elastic ask of a lender's size goes outside every live claim when a gap
+ * there holds it whole (ppe_before: PPE_PLACE or PPE_TODAY, never a lend or a
+ * short grant). Returns 1 with *status when it placed it, else 0: today's
+ * placement follows. */
+static int ios_elastic_before( void **ret, SIZE_T *size_ptr, ULONG type, ULONG protect, const struct ppe_ask *ask,
+                               NTSTATUS *status )
+{
+    struct ppe_decision d;
+    sigset_t sigset;
+    int placed = 0;
+
+    if (!ppe_before_engages( &ios_ppe, ask )) return 0;
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    ios_ppe.window = IOS_PPE_TOP - ios_usable_va_floor;
+    d = ppe_before( &ios_ppe, ask, ios_ppe_gaps, ios_ppe_gaps_read( ppe_gap_min( ask->size ) ) );
+    if (d.kind == PPE_PLACE && !ios_ppe_map( &d, ask, type, protect, ret, size_ptr ))
+    {
+        *status = STATUS_SUCCESS;
+        placed = 1;
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    return placed;
+}
+
+/* Today's placement of a reservation failed for room: perform pp_elastic.h's
+ * decisions. A never-shrunk ask gets at most one lend, from a lender whose
+ * freed range holds it, and today's placement once more. Returns the status,
+ * with *ret and *size_ptr set on success. */
+static NTSTATUS ios_elastic_failed( void **ret, SIZE_T *size_ptr, ULONG type, ULONG protect,
+                                    const struct ppe_ask *ask, ULONG_PTR limit_low, ULONG_PTR limit_high,
+                                    ULONG_PTR align, ULONG attributes )
+{
+    void *hint = *ret, *p;
+    SIZE_T sz;
+    uint64_t min = ppe_gap_min( ask->size ), failed_at = 0;
+    struct ppe_decision d;
+    NTSTATUS status = STATUS_NO_MEMORY;
+    sigset_t sigset;
+    unsigned tries;
+
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    ios_ppe.window = IOS_PPE_TOP - ios_usable_va_floor;
+    d = ppe_failed( &ios_ppe, ask, ios_ppe_gaps, ios_ppe_gaps_read( min ) );
+    for (tries = 0; d.kind != PPE_FAIL && tries < 256; tries++)
+    {
+        if (d.kind == PPE_LEND)
+        {
+            if (!ios_ppe_lend( d.view, d.keep, ask->size )) break;
+            if (!ppe_elastic_ask( ask->flags ))
+            {
+                /* Never shrunk: today's placement once more, in the room lent. */
+                p = hint;
+                sz = ask->size;
+                if (!(status = allocate_virtual_memory( &p, &sz, type, protect, limit_low, limit_high, align, attributes )))
+                {
+                    *ret = p;
+                    *size_ptr = sz;
+                }
+                break;
+            }
+        }
+        else
+        {
+            if (!(status = ios_ppe_map( &d, ask, type, protect, ret, size_ptr ))) break;
+            status = STATUS_NO_MEMORY;
+            /* Something took the room meanwhile: read the window again, once. */
+            if (failed_at == d.addr) break;
+            failed_at = d.addr;
+        }
+        d = ppe_failed( &ios_ppe, ask, ios_ppe_gaps, ios_ppe_gaps_read( min ) );
+    }
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    if (status)
+    {
+        *ret = hint;
+        *size_ptr = ask->size;
+    }
+    return status;
+}
+
+/* After today's placement of an ask: track it, or hand a failure for room to
+ * pp_elastic.h. Any other ask and status is returned as is. */
+static NTSTATUS ios_elastic_after( NTSTATUS status, void **ret, SIZE_T *size_ptr, void *hint, ULONG type,
+                                   ULONG protect, const struct ppe_ask *ask, ULONG_PTR limit_low,
+                                   ULONG_PTR limit_high, ULONG_PTR align, ULONG attributes )
+{
+    if (!(type & MEM_RESERVE)) return status;
+    if (!status)
+    {
+        if (*ret && ppe_tracks( ask->size, ask->size, ask->flags )) ios_elastic_placed( *ret, ask->size, ask->flags );
+        return status;
+    }
+    /* Layout asks fail as today; room lent in the window is no use under a limit below it. */
+    if (status != STATUS_NO_MEMORY || (ask->flags & PPE_ASK_LAYOUT) || (ask->limit && ask->limit <= ios_usable_va_floor))
+        return status;
+    *ret = hint;
+    *size_ptr = ask->size;
+    return ios_elastic_failed( ret, size_ptr, type, protect, ask, limit_low, limit_high, align, attributes );
+}
+
+/* What blocked a view's growth at `blocker`, for the refuse line. */
+static const char *ios_ppe_blocker( int i, uint64_t blocker, char *buf, size_t len )
+{
+    const struct ppe_view *pv = &ios_ppe.v[i];
+    struct file_view *other;
+
+    if (blocker == pv->base + pv->claim) return "the end of its claim";
+    if (blocker >= IOS_PPE_TOP) return "FEX's band";
+    if (blocker == ppe_view_end( &ios_ppe, i )) return "a mapping at its guard's end";
+    if ((other = find_view( (void *)(uintptr_t)blocker, 0 )))
+    {
+        snprintf( buf, len, "view %p+%llu MB", other->base, IOS_PPE_MB(other->size) );
+        return buf;
+    }
+    return "a host mapping";
+}
+
+/* A commit of [base, base + size), page-rounded, virtual_mutex held: in a
+ * shortened view's guard or claim it grows the view in place or is refused
+ * (STATUS_NO_MEMORY), never served in another view. Every other commit is
+ * served as today. */
+static NTSTATUS ios_elastic_commit( char *base, size_t size )
+{
+    struct file_view *view = find_view( base, 0 );
+    uint64_t a = (uint64_t)(uintptr_t)base, from, next = 0, free_above, old;
+    const struct ppe_view *pv;
+    struct ppe_commit_decision c;
+    char what[64];
+    unsigned n;
+    int i;
+
+    if (view ? !(view->protect & VPROT_ELASTIC) : !ppe_any_shortened( &ios_ppe )) return STATUS_SUCCESS;
+    if ((i = ppe_owner( &ios_ppe, a, view ? (uint64_t)(uintptr_t)view->base : 0 )) < 0) return STATUS_SUCCESS;
+    pv = &ios_ppe.v[i];
+    if (!ppe_shortened( pv ))
+    {
+        /* Whole: served as today; only its committed height is the module's. */
+        if (a + size <= pv->base + pv->real) ppe_served( &ios_ppe, i, a, size );
+        return STATUS_SUCCESS;
+    }
+    from = ppe_view_end( &ios_ppe, i );
+    free_above = ios_ppe_free_above( from, &next );
+    old = pv->real;
+    c = ppe_commit( &ios_ppe, i, a, size, free_above, next );
+    if (c.kind == PPE_GROW)
+    {
+        if (ios_ppe_grow( i, c.real ))
+        {
+            if ((n = ios_ppe_line( IOS_PPE_GROW )))
+                dprintf( 2, "[elastic] grow #%u 0x%llx real %llu -> %llu MB claim %llu MB high %llu KB: commit "
+                            "%p+0x%lx, guard moved up\n", n, (unsigned long long)pv->base, IOS_PPE_MB(old),
