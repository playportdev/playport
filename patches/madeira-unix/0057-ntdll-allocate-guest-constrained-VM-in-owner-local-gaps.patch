+/* Wine interprets counts 1..21 as high zero bits in a 32-bit address, and
+ * masks >=32 by their highest set bit (not as sparse allowed-bit masks).
+ * Apply these limits to guest offsets, never to the high host base. */
+static NTSTATUS ios_wow64_vm_limit( uintptr_t zero_bits, uint64_t *end )
+{
+    uint64_t limit;
+    uintptr_t bits;
+    if ((zero_bits > 21 && zero_bits < 32) ||
+        (zero_bits > 32 && zero_bits < granularity_mask)) return STATUS_INVALID_PARAMETER_3;
+    if (!zero_bits) return STATUS_SUCCESS;
+    if (zero_bits < 32) limit = (UINT64_C(1) << (32 - zero_bits)) - 1;
+    else
+    {
+        limit = 1;
+        for (bits = zero_bits; bits >>= 1;) limit = (limit << 1) | 1;
+    }
+    *end = min( *end, limit == UINT64_MAX ? limit : limit + 1 );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS ios_wow64_vm_allocate_limited( uintptr_t window, void **addr, size_t *size,
+                                              ULONG type, ULONG protect, uintptr_t zero_bits,
+                                              uint64_t end )
+{
+    void *base, *candidate;
+    size_t length;
+    uint32_t guest;
+    NTSTATUS status;
+    if (!addr || !size || !*size || !ios_wow64_valid_base( window ) ||
+        end > IOS_WOW64_WINDOW_SIZE) return STATUS_INVALID_PARAMETER;
+    if ((status = ios_wow64_vm_limit( zero_bits, &end ))) return status;
+    if (!(type & (MEM_RESERVE | MEM_COMMIT)) ||
+        (type & ~(MEM_RESERVE | MEM_COMMIT | MEM_TOP_DOWN))) return STATUS_NOT_SUPPORTED;
+    if (!*addr)
+    {
+        if (*size > SIZE_MAX - host_page_mask) return STATUS_INVALID_PARAMETER;
+        length = (*size + host_page_mask) & ~host_page_mask;
+        if (end <= IOS_WOW64_NULL_GUARD || length > end - IOS_WOW64_NULL_GUARD)
+            return STATUS_CONFLICTING_ADDRESSES;
+        status = ios_wow64_image_gap( window, length, IOS_WOW64_NULL_GUARD, end,
+                                      !!(type & MEM_TOP_DOWN), &guest );
+        if (status) return status;
+        candidate = (void *)(window + guest);
+        type |= MEM_RESERVE; /* NULL commit implicitly reserves, as Wine does. */
+    }
+    else
+    {
+        if (!ios_wow64_vm_range( window, *addr, *size, &base, &length ))
+            return STATUS_INVALID_PARAMETER;
+        if ((uintptr_t)base - window >= end || length > end - ((uintptr_t)base - window))
+            return STATUS_INVALID_PARAMETER;
+        candidate = *addr;
+        length = *size;
+    }
+    /* Keep caller outputs unchanged through failed selection/claim/protection. */
+    status = ios_wow64_vm_allocate( window, &candidate, &length, type & ~MEM_TOP_DOWN, protect );
+    if (!status) { *addr = candidate; *size = length; }
+    return status;
+}
+
 static NTSTATUS ios_wow64_vm_protect( uintptr_t window, void **addr, size_t *size,
                                      ULONG protect, ULONG *old_protect )
