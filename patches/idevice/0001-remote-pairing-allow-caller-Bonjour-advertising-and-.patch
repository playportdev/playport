index 891cfdb..d932da4 100644
--- a/idevice/src/remote_pairing/responder.rs
+++ b/idevice/src/remote_pairing/responder.rs
@@ -172,9 +172,25 @@ impl<R: super::RpPairingSocketProvider> PairableHost<R> {
     where
         Fut: std::future::Future<Output = ()>,
     {
+        self.accept_with_pin(pairing_file, None, pin_callback).await
+    }
+
+    /// Accept with a caller-generated six-digit PIN, so a mobile host can show
+    /// it before the user leaves for Settings. None preserves random generation.
+    pub async fn accept_with_pin<Fut>(
+        &mut self,
+        pairing_file: &mut RpPairingFile,
+        setup_pin: Option<String>,
+        pin_callback: impl FnOnce(String) -> Fut,
+    ) -> Result<PeerDevice, IdeviceError>
+    where
+        Fut: std::future::Future<Output = ()>,
+    {
+        if setup_pin.as_ref().is_some_and(|p| p.len() != 6 || !p.bytes().all(|b| b.is_ascii_digit())) {
+            return Err(IdeviceError::FfiInvalidArg);
+        }
         self.handshake().await?;
-        let peer_device = self.pair_setup(pairing_file, pin_callback).await?;
-        Ok(peer_device)
+        self.pair_setup(pairing_file, setup_pin, pin_callback).await
     }
 
     /// Receive the device's handshake request and reply with our device info.
@@ -249,6 +265,7 @@ impl<R: super::RpPairingSocketProvider> PairableHost<R> {
     async fn pair_setup<Fut>(
         &mut self,
         pairing_file: &mut RpPairingFile,
+        setup_pin: Option<String>,
         pin_callback: impl FnOnce(String) -> Fut,
     ) -> Result<PeerDevice, IdeviceError>
     where
@@ -268,7 +285,7 @@ impl<R: super::RpPairingSocketProvider> PairableHost<R> {
         let pin = if self.host_info.allows_pinless_pairing {
             "000000".to_string()
         } else {
-            format!("{:06}", rand::rng().random_range(0..1_000_000))
+            setup_pin.unwrap_or_else(|| format!("{:06}", rand::rng().random_range(0..1_000_000)))
         };
         let verifier = srp_client.compute_verifier(SRP_USERNAME, pin.as_bytes(), &salt);
 
