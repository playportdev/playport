+++ b/ffi/src/pairable_host.rs
@@ -112,6 +112,80 @@ pub unsafe extern "C" fn pairable_host_cancel_free(cancel: *mut PairableHostCanc
     let _ = unsafe { Box::from_raw(cancel) };
 }
 
+/// Accept a pairing using caller-provided service advertising (e.g. Apple's
+/// Bonjour on iOS, where raw multicast sockets need a restricted entitlement).
+///
+/// `advertise` is called after binding, with the service instance identifier,
+/// JSON TXT dictionary and listening port. The caller publishes exactly these
+/// values until this function returns. `paired` receives temporary XML plist
+/// bytes on success; copy them into secure storage before the callback returns.
+/// This call blocks; run it off the UI thread. A cancel token is required.
+/// The caller generates and displays the six-digit PIN before starting.
+///
+/// # Safety
+/// Strings must be valid NUL-terminated UTF-8. Callbacks and context must remain
+/// live until return. cancel must be a live pairable_host_cancel_new token.
+/// Callback strings/bytes are borrowed only for the duration of the callback.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn pairable_host_accept_bonjour(
+    name: *const c_char,
+    setup_pin: *const c_char,
+    advertise: Option<extern "C" fn(identifier: *const c_char, txt_json: *const c_char, port: u16, context: *mut c_void)>,
+    paired: Option<extern "C" fn(data: *const u8, len: usize, context: *mut c_void)>,
+    context: *mut c_void,
+    cancel: *const PairableHostCancel,
+) -> *mut IdeviceFfiError {
+    if name.is_null() || setup_pin.is_null() || cancel.is_null() || advertise.is_none() || paired.is_none() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let name = match unsafe { CStr::from_ptr(name) }.to_str() {
+        Ok(s) => s.to_owned(),
+        Err(_) => return ffi_err!(IdeviceError::FfiInvalidString),
+    };
+    let pin = match unsafe { CStr::from_ptr(setup_pin) }.to_str() {
+        Ok(s) if s.len() == 6 && s.bytes().all(|b| b.is_ascii_digit()) => s.to_owned(),
+        _ => return ffi_err!(IdeviceError::FfiInvalidArg),
+    };
+    let cancel = unsafe { &*cancel }.0.clone();
+    let ctx = PinCtx(context);
+    let result = run_sync_local(async move {
+        if cancel.is_canceled() {
+            return Err(IdeviceError::CanceledByUser);
+        }
+        let listener = tokio::net::TcpListener::bind((Ipv4Addr::UNSPECIFIED, 0))
+            .await.map_err(|e| IdeviceError::InternalError(format!("bind: {e}")))?;
+        let port = listener.local_addr()
+            .map_err(|e| IdeviceError::InternalError(format!("address: {e}")))?.port();
+        let mut file = RpPairingFile::generate(&name);
+        let info = PairableHostInfo::generate(&name, "Mac17,7");
+        let identifier = CString::new(file.identifier.as_str())
+            .map_err(|_| IdeviceError::FfiInvalidString)?;
+        let records: std::collections::BTreeMap<_, _> = info.mdns_txt_records(&file.identifier).into_iter().collect();
+        let txt = CString::new(serde_json::to_string(&records)
+            .map_err(|e| IdeviceError::InternalError(e.to_string()))?)
+            .map_err(|_| IdeviceError::FfiInvalidString)?;
+        advertise.unwrap()(identifier.as_ptr(), txt.as_ptr(), port, ctx.0);
+        let pair = async {
+            let (stream, _) = listener.accept().await
+                .map_err(|e| IdeviceError::InternalError(format!("accept: {e}")))?;
+            let mut host = PairableHost::new(RpPairingSocket::new_device(stream), info);
+            host.accept_with_pin(&mut file, Some(pin), |_| async {}).await?;
+            let bytes = file.to_bytes();
+            paired.unwrap()(bytes.as_ptr(), bytes.len(), ctx.0);
+            Ok::<(), IdeviceError>(())
+        };
+        tokio::select! {
+            biased;
+            _ = cancel.canceled() => Err(IdeviceError::CanceledByUser),
+            r = pair => r,
+        }
+    });
+    match result {
+        Ok(()) => null_mut(),
+        Err(e) => ffi_err!(e),
+    }
+}
+
 /// Advertises this computer as a pairable host and accepts a single device-initiated
 /// pairing.
 ///
