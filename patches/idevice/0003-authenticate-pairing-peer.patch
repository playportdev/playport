diff --git a/idevice/src/remote_pairing/peer_auth.rs b/idevice/src/remote_pairing/peer_auth.rs
new file mode 100644
index 0000000..f4c1034
--- /dev/null
+++ b/idevice/src/remote_pairing/peer_auth.rs
@@ -0,0 +1,225 @@
+//! Peer identity pinned only by an authenticated SRP setup; never by reconnect.
+use ed25519_dalek::{Signature, VerifyingKey};
+use hkdf::Hkdf;
+use sha2::Sha512;
+use super::{RpPairingFile, errors::RemotePairingError, tlv::{self, TLV8Entry, PairingDataComponentType as T}};
+use crate::IdeviceError;
+
+fn reject() -> IdeviceError { RemotePairingError::PeerAuthenticationFailed.into() }
+
+pub(super) fn pin_setup_peer(entries: &[TLV8Entry], session_key: &[u8], accessory: bool,
+                            record: &mut RpPairingFile) -> Result<(), IdeviceError> {
+    let id = tlv::collect_component_data(entries, T::Identifier);
+    let public = tlv::collect_component_data(entries, T::PublicKey);
+    let signature = tlv::collect_component_data(entries, T::Signature);
+    if id.is_empty() { return Err(reject()); }
+    let public: [u8; 32] = public.as_slice().try_into().map_err(|_| reject())?;
+    let public = VerifyingKey::from_bytes(&public).map_err(|_| reject())?;
+    if public.is_weak() { return Err(reject()); }
+    let signature = Signature::from_slice(&signature).map_err(|_| reject())?;
+    let (salt, info): (&[u8], &[u8]) = if accessory {
+        (b"Pair-Setup-Accessory-Sign-Salt", b"Pair-Setup-Accessory-Sign-Info")
+    } else {
+        (b"Pair-Setup-Controller-Sign-Salt", b"Pair-Setup-Controller-Sign-Info")
+    };
+    let mut x = [0u8; 32];
+    Hkdf::<Sha512>::new(Some(salt), session_key).expand(info, &mut x).map_err(|_| reject())?;
+    let mut signed = x.to_vec();
+    signed.extend_from_slice(&id);
+    signed.extend_from_slice(public.as_bytes());
+    public.verify_strict(&signed, &signature).map_err(|_| reject())?;
+    record.peer_identifier = Some(id);
+    record.peer_public_key = Some(public);
+    Ok(())
+}
+
+pub(super) fn verify_pair_peer(entries: &[TLV8Entry], record: &RpPairingFile,
+                              peer_ephemeral: &[u8; 32], client_ephemeral: &[u8; 32]) -> Result<(), IdeviceError> {
+    let id = tlv::collect_component_data(entries, T::Identifier);
+    let signature = Signature::from_slice(&tlv::collect_component_data(entries, T::Signature)).map_err(|_| reject())?;
+    let expected = record.peer_identifier.as_ref().ok_or(RemotePairingError::PeerIdentityMissing)?;
+    let public = record.peer_public_key.as_ref().ok_or(RemotePairingError::PeerIdentityMissing)?;
+    if &id != expected || id.is_empty() || public.is_weak() { return Err(reject()); }
+    let mut signed = peer_ephemeral.to_vec();
+    signed.extend_from_slice(&id);
+    signed.extend_from_slice(client_ephemeral);
+    public.verify_strict(&signed, &signature).map_err(|_| reject())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ed25519_dalek::{Signer, SigningKey};
+
+    fn setup(key: &SigningKey, session: &[u8], accessory: bool) -> Vec<TLV8Entry> {
+        let (salt, info): (&[u8], &[u8]) = if accessory {
+            (b"Pair-Setup-Accessory-Sign-Salt", b"Pair-Setup-Accessory-Sign-Info")
+        } else { (b"Pair-Setup-Controller-Sign-Salt", b"Pair-Setup-Controller-Sign-Info") };
+        let id = b"test-peer";
+        let mut x = [0; 32];
+        Hkdf::<Sha512>::new(Some(salt), session).expand(info, &mut x).unwrap();
+        let mut message = x.to_vec();
+        message.extend_from_slice(id);
+        message.extend_from_slice(key.verifying_key().as_bytes());
+        vec![TLV8Entry { tlv_type: T::Identifier, data: id.to_vec() },
+             TLV8Entry { tlv_type: T::PublicKey, data: key.verifying_key().to_bytes().to_vec() },
+             TLV8Entry { tlv_type: T::Signature, data: key.sign(&message).to_bytes().to_vec() }]
+    }
+
+    #[test]
+    fn setup_pins_only_verified_identity_and_round_trips() {
+        let key = SigningKey::from_bytes(&[7; 32]);
+        for accessory in [false, true] {
+            let entries = setup(&key, b"authenticated srp session", accessory);
+            let mut record = RpPairingFile::generate("test");
+            pin_setup_peer(&entries, b"authenticated srp session", accessory, &mut record).unwrap();
+            let loaded = RpPairingFile::from_bytes(&record.to_bytes()).unwrap();
+            assert_eq!(loaded.peer_identifier.as_deref(), Some(b"test-peer".as_slice()));
+            assert_eq!(loaded.peer_public_key.unwrap(), key.verifying_key());
+            assert!(pin_setup_peer(&entries, b"wrong session", accessory, &mut record).is_err());
+            assert!(pin_setup_peer(&entries, b"authenticated srp session", !accessory, &mut record).is_err());
+            for missing in 0..entries.len() {
+                let mut bad = entries.clone(); bad.remove(missing);
+                assert!(pin_setup_peer(&bad, b"authenticated srp session", accessory, &mut record).is_err());
+            }
+            let mut bad = entries.clone(); bad[2].data[0] ^= 1;
+            assert!(pin_setup_peer(&bad, b"authenticated srp session", accessory, &mut record).is_err());
+        }
+    }
+
+    #[test]
+    fn verify_binds_both_ephemerals_identity_and_pinned_key() {
+        let key = SigningKey::from_bytes(&[7; 32]);
+        let mut record = RpPairingFile::generate("test");
+        let peer = [1; 32]; let client = [2; 32];
+        record.peer_identifier = Some(b"test-peer".to_vec());
+        record.peer_public_key = Some(key.verifying_key());
+        let mut message = peer.to_vec(); message.extend_from_slice(b"test-peer"); message.extend(client);
+        let entries = vec![TLV8Entry { tlv_type: T::Identifier, data: b"test-peer".to_vec() },
+            TLV8Entry { tlv_type: T::Signature, data: key.sign(&message).to_bytes().to_vec() }];
+        verify_pair_peer(&entries, &record, &peer, &client).unwrap();
+        assert!(verify_pair_peer(&entries, &record, &[3; 32], &client).is_err());
+        assert!(verify_pair_peer(&entries, &record, &peer, &[3; 32]).is_err());
+        record.peer_identifier = Some(b"other-peer".to_vec());
+        assert!(verify_pair_peer(&entries, &record, &peer, &client).is_err());
+        record.peer_identifier = Some(b"test-peer".to_vec());
+        record.peer_public_key = Some(SigningKey::from_bytes(&[8; 32]).verifying_key());
+        assert!(verify_pair_peer(&entries, &record, &peer, &client).is_err());
+        record.peer_public_key = None;
+        assert!(verify_pair_peer(&entries, &record, &peer, &client).is_err());
+    }
+    use super::super::{RemotePairingClient, RpPairingSocketProvider};
+    use chacha20poly1305::{ChaCha20Poly1305, KeyInit, Nonce, aead::Aead};
+    use std::{collections::VecDeque, future::Future, pin::Pin, sync::atomic::{AtomicUsize, Ordering}};
+    use serde::Serialize;
+    use base64::{Engine, engine::general_purpose::STANDARD};
+    use plist_macro::plist;
+    use rsa::rand_core::OsRng;
+    use x25519_dalek::{EphemeralSecret, PublicKey};
+
+    #[derive(Debug, Clone, Copy, PartialEq)]
+    enum Mode { Valid, BadSignature, WrongIdentifier, BadCiphertext, ZeroEphemeral }
+    #[derive(Debug)]
+    struct Peer {
+        key: SigningKey,
+        mode: Mode,
+        responses: VecDeque<plist::Value>,
+        m1: usize,
+        m3: usize,
+        setup: usize,
+    }
+    impl Peer {
+        fn new(mode: Mode) -> Self { Self { key: SigningKey::from_bytes(&[7; 32]), mode,
+            responses: VecDeque::new(), m1: 0, m3: 0, setup: 0 } }
+        fn respond(&mut self, tlv: Vec<u8>) {
+            self.responses.push_back(plist!({"event": {"_0": {"pairingData": {"_0": {
+                "data": Self::serialize_bytes(&tlv)
+            }}}}}));
+        }
+    }
+    impl RpPairingSocketProvider for Peer {
+        fn serialize_bytes(bytes: &[u8]) -> plist::Value { plist::Value::String(STANDARD.encode(bytes)) }
+        fn deserialize_bytes(value: plist::Value) -> Option<Vec<u8>> { STANDARD.decode(value.as_string()?).ok() }
+        fn recv_plain<'a>(&'a mut self) -> Pin<Box<dyn Future<Output=Result<plist::Value,IdeviceError>> + Send + 'a>> {
+            let next = self.responses.pop_front().ok_or_else(reject);
+            Box::pin(async move { next })
+        }
+        fn send_encrypted(&mut self, _: Vec<u8>, _: usize) -> Pin<Box<dyn Future<Output=Result<(),IdeviceError>> + Send + '_>> {
+            panic!("unauthenticated client must not request a tunnel")
+        }
+        fn send_plain(&mut self, value: impl Serialize, _: usize) -> Pin<Box<dyn Future<Output=Result<(),IdeviceError>> + Send + '_>> {
+            let value = serde_json::to_value(value).unwrap();
+            if value.get("request").is_some() {
+                self.responses.push_back(plist!({"response": {"_1": {"handshake": {"_0": {"accepted": true}}}}}));
+            } else if let Some(data) = value.pointer("/event/_0/pairingData/_0") {
+                if data["kind"] == "setupManualPairing" { self.setup += 1; }
+                let entries = tlv::deserialize_tlv8(&STANDARD.decode(data["data"].as_str().unwrap()).unwrap()).unwrap();
+                let state = tlv::collect_component_data(&entries, T::State);
+                if state == [1] {
+                    self.m1 += 1;
+                    let client: [u8; 32] = tlv::collect_component_data(&entries, T::PublicKey).try_into().unwrap();
+                    let private = EphemeralSecret::random_from_rng(OsRng);
+                    let mut ephemeral = PublicKey::from(&private).to_bytes();
+                    let shared = private.diffie_hellman(&PublicKey::from(client));
+                    let id = if self.mode == Mode::WrongIdentifier { b"wrong-peer".as_slice() } else { b"test-peer".as_slice() };
+                    let mut signed = ephemeral.to_vec(); signed.extend_from_slice(id); signed.extend(client);
+                    let mut signature = self.key.sign(&signed).to_bytes().to_vec();
+                    if self.mode == Mode::BadSignature { signature[0] ^= 1; }
+                    let identity = tlv::serialize_tlv8(&[
+                        TLV8Entry { tlv_type: T::Identifier, data: id.to_vec() },
+                        TLV8Entry { tlv_type: T::Signature, data: signature },
+                    ]);
+                    let mut key = [0; 32];
+                    Hkdf::<Sha512>::new(Some(b"Pair-Verify-Encrypt-Salt"), shared.as_bytes())
+                        .expand(b"Pair-Verify-Encrypt-Info", &mut key).unwrap();
+                    let mut encrypted = ChaCha20Poly1305::new((&key).into())
+                        .encrypt(Nonce::from_slice(b"\x00\x00\x00\x00PV-Msg02"), identity.as_slice()).unwrap();
+                    if self.mode == Mode::BadCiphertext { encrypted[0] ^= 1; }
+                    if self.mode == Mode::ZeroEphemeral { ephemeral = [0; 32]; }
+                    self.respond(tlv::serialize_tlv8(&[
+                        TLV8Entry { tlv_type: T::State, data: vec![2] },
+                        TLV8Entry { tlv_type: T::PublicKey, data: ephemeral.to_vec() },
+                        TLV8Entry { tlv_type: T::EncryptedData, data: encrypted },
+                    ]));
+                } else if state == [3] {
+                    self.m3 += 1;
+                    self.respond(tlv::serialize_tlv8(&[TLV8Entry { tlv_type: T::State, data: vec![4] }]));
+                }
+            }
+            Box::pin(async { Ok(()) })
+        }
+    }
+
+    #[tokio::test]
+    async fn invalid_peer_never_gets_m3_tunnel_or_implicit_enrollment() {
+        for mode in [Mode::Valid, Mode::BadSignature, Mode::WrongIdentifier, Mode::BadCiphertext, Mode::ZeroEphemeral] {
+            let mut record = RpPairingFile::generate("test");
+            record.peer_identifier = Some(b"test-peer".to_vec());
+            record.peer_public_key = Some(SigningKey::from_bytes(&[7; 32]).verifying_key());
+            let mut client = RemotePairingClient::new(Peer::new(mode), "test");
+            let enrollment = AtomicUsize::new(0);
+            let result = client.connect(&mut record, || async { enrollment.fetch_add(1, Ordering::SeqCst); "000000".into() }).await;
+            assert_eq!(result.is_ok(), mode == Mode::Valid);
+            assert_eq!(client.inner.m3, usize::from(mode == Mode::Valid));
+            assert_eq!(client.inner.setup, 0);
+            assert_eq!(enrollment.load(Ordering::SeqCst), 0);
+            if mode != Mode::Valid {
+                assert!(!client.authenticated);
+                assert!(client.create_tcp_listener().await.is_err());
+            }
+        }
+        for wrong in [false, true] {
+            let mut record = RpPairingFile::generate("test");
+            if wrong {
+                record.peer_identifier = Some(b"test-peer".to_vec());
+                record.peer_public_key = Some(SigningKey::from_bytes(&[8; 32]).verifying_key());
+            }
+            let mut client = RemotePairingClient::new(Peer::new(Mode::Valid), "test");
+            assert!(client.connect(&mut record, || async { panic!("no enrollment fallback") }).await.is_err());
+            assert_eq!(client.inner.m3, 0);
+            assert_eq!(client.inner.setup, 0);
+            assert!(client.create_tcp_listener().await.is_err());
+        }
+    }
+
+}
