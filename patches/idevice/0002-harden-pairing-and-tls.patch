+}
+
+fn parse_server_hello(message: &[u8]) -> Result<([u8; 32], [u8; 2]), IdeviceError> {
+    // Header + version + random + session-id length + cipher + compression.
+    if message.len() < 42 || message[4..6] != TLS_12 {
+        return Err(IdeviceError::InternalError("Invalid TLS ServerHello".into()));
+    }
+    let sid_len = message[38] as usize;
+    if sid_len > 32 || message.len() < 42 + sid_len || message[41 + sid_len] != 0 {
+        return Err(IdeviceError::InternalError("Invalid TLS ServerHello parameters".into()));
+    }
+    Ok((message[6..38].try_into().unwrap(), message[39 + sid_len..41 + sid_len].try_into().unwrap()))
+}
+
+/// Only a complete, authenticated Finished permits application traffic.
+fn verify_server_finished(plaintext: &[u8], expected: &[u8]) -> Result<(), IdeviceError> {
+    // TLS 1.2 Finished has exactly 12 bytes of verify_data (RFC 5246 7.4.9).
+    if expected.len() != 12
+        || plaintext.len() != 16
+        || plaintext[..4] != [HS_FINISHED, 0, 0, 12]
+        || plaintext[4..] != *expected
+    {
+        return Err(IdeviceError::InternalError("Invalid TLS server Finished".into()));
+    }
+    Ok(())
+}
