-fn parse_handshake_messages(data: &[u8]) -> Vec<(u8, Vec<u8>)> {
+fn parse_handshake_messages(data: &[u8]) -> Result<Vec<(u8, Vec<u8>)>, IdeviceError> {
     let mut msgs = Vec::new();
     let mut pos = 0;
     while pos + 4 <= data.len() {
