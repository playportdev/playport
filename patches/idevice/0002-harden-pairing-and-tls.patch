+
+    #[test]
+    fn rejects_padding_underflow_before_mac() {
+        let keys = derive_key_block(&[1; 48], &[2; 32], &[3; 32], CipherSuite::Aes128CbcSha);
+        let iv = [0; 16];
+        let bad = [255; 16];
+        let enc = Aes128CbcEnc::new(keys.server_write_key[..16].into(), (&iv).into())
+            .encrypt_padded_vec_mut::<aes::cipher::block_padding::NoPadding>(&bad);
+        let mut record = iv.to_vec();
+        record.extend(enc);
+        assert!(decrypt_record(&keys, true, 0, CT_HANDSHAKE, &record).is_err());
+    }
+
+    #[tokio::test]
+    async fn actual_handshake_rejects_authenticated_but_wrong_finished() {
+        for corrupt in [false, true] {
+            let (client, mut server) = tokio::io::duplex(8192);
+            let peer = async {
+                let (_, hello) = read_record(&mut server).await.unwrap();
+                let client_random: [u8; 32] = hello[6..38].try_into().unwrap();
+                let server_random = [3; 32];
+                let suite = CipherSuite::Aes256CbcSha384;
+                let mut body = TLS_12.to_vec();
+                body.extend(server_random);
+                body.extend([0, 0, 0xaf, 0]);
+                let mut flight = make_handshake(HS_SERVER_HELLO, &body);
+                flight.extend(make_handshake(HS_SERVER_HELLO_DONE, &[]));
+                server.write_all(&make_record(CT_HANDSHAKE, &flight)).await.unwrap();
+                let mut transcript = hello;
+                transcript.extend(flight);
+                let (_, cke) = read_record(&mut server).await.unwrap();
+                transcript.extend(cke);
+                let _ = read_record(&mut server).await.unwrap();
+                let (_, encrypted) = read_record(&mut server).await.unwrap();
+                let master = derive_master_secret(b"test psk", &client_random, &server_random, suite);
+                let mut keys = derive_key_block(&master, &client_random, &server_random, suite);
+                transcript.extend(decrypt_record(&keys, false, 0, CT_HANDSHAKE, &encrypted).unwrap());
+                let mut verify = finished_verify_data(&master, b"server finished", &transcript, suite);
+                if corrupt { verify[0] ^= 1; }
+                std::mem::swap(&mut keys.client_write_key, &mut keys.server_write_key);
+                std::mem::swap(&mut keys.client_mac_key, &mut keys.server_mac_key);
+                let encrypted = encrypt_record(&keys, 0, CT_HANDSHAKE, &make_handshake(HS_FINISHED, &verify));
+                server.write_all(&make_record(CT_CHANGE_CIPHER_SPEC, &[1])).await.unwrap();
+                server.write_all(&make_record(CT_HANDSHAKE, &encrypted)).await.unwrap();
+            };
+            let (result, ()) = tokio::join!(tls_psk_handshake(client, b"test psk"), peer);
+            assert_eq!(result.is_err(), corrupt);
+        }
+    }
+
+    #[test]
+    fn rejects_truncated_hello_and_handshake_frames() {
+        for n in 0..42 {
+            assert!(parse_server_hello(&vec![0; n]).is_err());
+        }
+        assert!(parse_handshake_messages(&[2, 0, 0, 20, 0]).is_err());
+        assert!(parse_handshake_messages(&[2, 0]).is_err());
+        let mut body = vec![3, 3];
+        body.extend_from_slice(&[1; 32]);
+        body.extend_from_slice(&[0, 0, 0xaf, 0]);
+        let valid = make_handshake(HS_SERVER_HELLO, &body);
+        assert!(parse_server_hello(&valid).is_ok());
+        let mut bad = valid;
+        bad[38] = 32;
+        assert!(parse_server_hello(&bad).is_err());
+    }
+
+    #[test]
+    fn accepts_only_exact_finished() {
+        let expected = [0x42; 12];
+        let valid = make_handshake(HS_FINISHED, &expected);
+        assert!(verify_server_finished(&valid, &expected).is_ok());
+        for i in 0..valid.len() {
+            let mut changed = valid.clone();
+            changed[i] ^= 1;
+            assert!(verify_server_finished(&changed, &expected).is_err());
+        }
+        for n in 0..valid.len() {
+            assert!(verify_server_finished(&valid[..n], &expected).is_err());
+        }
+        let mut extra = valid;
+        extra.push(0);
+        assert!(verify_server_finished(&extra, &expected).is_err());
+    }
+
+    #[test]
+    fn binds_finished_to_master_secret_and_transcript() {
+        for suite in [CipherSuite::Aes128CbcSha, CipherSuite::Aes256CbcSha384] {
+            let expected = finished_verify_data(&[1; 48], b"server finished", b"transcript", suite);
+            let valid = make_handshake(HS_FINISHED, &expected);
+            for other in [
+                finished_verify_data(&[2; 48], b"server finished", b"transcript", suite),
+                finished_verify_data(&[1; 48], b"server finished", b"changed", suite),
+                finished_verify_data(&[1; 48], b"client finished", b"transcript", suite),
+            ] {
+                assert!(verify_server_finished(&valid, &other).is_err());
+            }
+        }
+    }
 }
 
