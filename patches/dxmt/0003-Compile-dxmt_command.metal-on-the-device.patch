-
-dxmt_shaders_lib = metallib_generator.process(dxmt_shaders_ir)
+# Embedded as MSL source and compiled by Metal at device creation
+# (MTLDevice_newLibraryWithSource), so building it needs no Apple tool. A
+# runtime source compile cannot resolve quoted includes, so they are inlined.
+dxmt_shaders_src = custom_target('dxmt_command_source',
+  input   : dxmt_shaders,
+  output  : 'dxmt_command.metal',
+  command : [ find_program('python3'), files('inline_metal_includes.py'), '@INPUT@', '@OUTPUT@' ],
+)
 
-dxmt_shaders_header = hexdump_generator.process(dxmt_shaders_lib)
+dxmt_shaders_header = hexdump_generator.process(dxmt_shaders_src)
 
 dxmt_lib = static_library('dxmt', dxmt_src, dxmt_shaders_header, dxmt_version,
   dependencies        : [ util_dep, airconv_forward_dep, winemetal_dep ],
