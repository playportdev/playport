diff --git a/src/dxmt/inline_metal_includes.py b/src/dxmt/inline_metal_includes.py
new file mode 100644
index 0000000..b272f44
--- /dev/null
+++ b/src/dxmt/inline_metal_includes.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+# Inline the quoted #include lines of a Metal source file (from its own
+# directory), so the result compiles with MTLDevice newLibraryWithSource,
+# which has no include path. System includes (<metal_stdlib>) stay as they are.
+import os, re, sys
+
+def expand(path, seen):
+    out = []
+    for line in open(path, encoding='utf-8'):
+        m = re.match(r'\s*#\s*include\s+"([^"]+)"', line)
+        if not m:
+            out.append(line)
+            continue
+        inc = os.path.join(os.path.dirname(path), m.group(1))
+        if inc in seen:
+            continue
+        seen.add(inc)
+        out.append('// begin %s\n' % m.group(1))
+        # the inlined header is no longer a separate file
+        out.extend(l for l in expand(inc, seen) if not re.match(r'\s*#\s*pragma\s+once', l))
+        out.append('// end %s\n' % m.group(1))
+    return out
+
+src, dst = sys.argv[1], sys.argv[2]
+with open(dst, 'w', encoding='utf-8') as f:
+    f.writelines(expand(src, set()))
