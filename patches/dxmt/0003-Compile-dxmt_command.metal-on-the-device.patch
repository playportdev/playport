diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index d1c7a8b..731eacd 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -4954,16 +4954,46 @@ _MTLDevice_newIndirectCommandBuffer(void *obj) {
   return STATUS_SUCCESS;
 }
 
+/* Playport: dxmt_command.metal is compiled here on the device instead of with
+ * Apple's offline tools. The options match what `metal -c` records for it
+ * (Metal 3.2, fast math); the source is UTF-8, which ASCII decoding rejects. */
 static NTSTATUS
 _MTLDevice_newLibraryWithSource(void *obj) {
   struct unixcall_mtldevice_newlibrarywithsource *params = obj;
+  const char *source = params->source.ptr;
+  uint64_t length = params->length;
+  params->ret_error = 0;
+  params->ret_library = 0;
+  if (wmtr_enabled()) {
+    /* The host's RM_OP_NEW_LIBRARY compiles the source with default options. */
+    if (length && length <= RM_CHUNK_BYTES - sizeof(struct rm_arg_handle)) {
+      uint8_t *msg = malloc(sizeof(struct rm_arg_handle) + length);
+      if (msg) {
+        struct rm_arg_handle *a = (void *)msg;
+        a->handle = params->device;
+        memcpy(msg + sizeof *a, source, length);
+        struct rm_ret_handle r;
+        if (wmtr_call(RM_OP_NEW_LIBRARY, msg, (uint32_t)(sizeof *a + length), &r, sizeof r, 0) == RM_OK)
+          params->ret_library = r.handle;
+        free(msg);
+      }
+    }
+    return STATUS_SUCCESS;
+  }
   id<MTLDevice> device = (id<MTLDevice>)params->device;
-  NSString *source =
-      [[NSString alloc] initWithBytes:params->source.ptr length:params->length encoding:NSASCIIStringEncoding];
+  NSString *str = [[NSString alloc] initWithBytes:source length:length encoding:NSUTF8StringEncoding];
+  MTLCompileOptions *options = [[MTLCompileOptions alloc] init];
+  if (@available(macOS 15.0, iOS 18.0, *)) {
+    options.languageVersion = MTLLanguageVersion3_2;
+    options.mathMode = MTLMathModeFast;
+    options.mathFloatingPointFunctions = MTLMathFloatingPointFunctionsFast;
+  }
   NSError *err = NULL;
-  params->ret_library = (obj_handle_t)[device newLibraryWithSource:source options:nil error:&err];
+  if (str)
+    params->ret_library = (obj_handle_t)[device newLibraryWithSource:str options:options error:&err];
   params->ret_error = (obj_handle_t)err;
-  [source release];
+  [options release];
+  [str release];
   return STATUS_SUCCESS;
 }
 
