 #include "wmt_remote_client.h"
 
+/* Playport: shader and pipeline compile timing. Every DXBC-to-AIR conversion,
+ * library, function and pipeline-state creation logs one line on stderr
+ * (s1-host.log) with the wall time it ended, so a frame hitch can be matched
+ * against compile work by time (tools/perf.py):
+ *   [shader-time] HH:MM:SS.mmm <op> <ms> ms
+ * A few hundred per title launch; the conversions only on a DXMT shader-cache
+ * miss. MADEIRA_NO_DIAGNOSTICS (the host app's release build) logs none: this
+ * is a bare stderr line, which DXMT_LOG_LEVEL does not reach. */
+#include <sys/time.h>
+struct shc_timer { const char *op; uint64_t t0; };
+static inline uint64_t shc_now_ns(void) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+static inline struct shc_timer shc_timer_begin(const char *op) {
+  struct shc_timer t = { op, shc_now_ns() };
+  return t;
+}
+static void shc_timer_end(struct shc_timer *t) {
+  static int quiet = -1;
+  if (quiet < 0) {
+    const char *v = getenv("MADEIRA_NO_DIAGNOSTICS");
+    quiet = v && *v;
+  }
+  if (quiet)
+    return;
+  uint64_t ns = shc_now_ns() - t->t0;
+  struct timeval tv; struct tm tm;
+  gettimeofday(&tv, NULL);
+  localtime_r(&tv.tv_sec, &tm);
+  fprintf(stderr, "[shader-time] %02d:%02d:%02d.%03d %s %.3f ms\n", tm.tm_hour, tm.tm_min, tm.tm_sec,
+          (int)(tv.tv_usec / 1000), t->op, ns / 1e6);
+}
+#define SHC_TIMED(op) struct shc_timer _shc __attribute__((cleanup(shc_timer_end))) = shc_timer_begin(op)
+
 /* Playport: the background GPU gate
