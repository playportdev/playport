From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Fri, 25 Sep 2026 04:45:00 +0200
Subject: [PATCH] dxmt: initialize the encoding context's device before its
 command contexts

ArgumentEncodingContext declared device_ and queue_ last, after the
command contexts it builds in its initializer list. ClearUAV's
constructor creates its ten pipelines through
SimpleCommandContext::getComputePipeline, which reads ctx.device_, so
those calls read the member before it was initialized: whatever the
heap held there. Where that memory was zero the calls messaged nil and
every ClearUAV pipeline was silently nil; Witcher 3's heap held garbage,
so device creation died in objc_msgSend inside
MTLDevice_newComputePipelineState. The two members are now declared
(and initialized) before the command contexts.

Class: upstream-bug
Evidence: docs/evidence/2026-09-25-witcher3-setup.md
Offered-upstream: no
---
 src/dxmt/dxmt_context.cpp |  6 +++---
 src/dxmt/dxmt_context.hpp | 13 ++++++++++---
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index b323906..8dbd0b0 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -32,6 +32,8 @@
 namespace dxmt {
 
 ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Device device, InternalCommandLibrary &lib) :
+    device_(device),
+    queue_(queue),
     lib(lib),
     emulated_cmd(device, lib, *this),
     clear_rt_cmd(device, *this),
@@ -39,9 +41,7 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
     clear_uav_cmd(device, *this),
     mv_scale_cmd(device, lib, *this),
     tile_barrier_cmd(device, lib, *this),
-    timestamp_state_(device),
-    device_(device),
-    queue_(queue) {
+    timestamp_state_(device) {
   dummy_sampler_info_.support_argument_buffers = true;
   dummy_sampler_info_.border_color = WMTSamplerBorderColorTransparentBlack;
   dummy_sampler_info_.compare_function = WMTCompareFunctionNever;
diff --git a/src/dxmt/dxmt_context.hpp b/src/dxmt/dxmt_context.hpp
index 1cd99ca..174eb79 100644
--- a/src/dxmt/dxmt_context.hpp
+++ b/src/dxmt/dxmt_context.hpp
@@ -829,6 +829,16 @@ public:
   uint32_t tess_num_output_control_point_element;
   uint32_t tess_threads_per_patch;
 
+private:
+  /* Declared before the command contexts below: their constructors already
+   * use them (ClearUAV builds its pipelines through
+   * SimpleCommandContext::getComputePipeline, which reads device_), and
+   * members are initialized in declaration order, so declared after them they
+   * were still uninitialized memory at that point. */
+  WMT::Device device_;
+  CommandQueue& queue_;
+
+public:
   InternalCommandLibrary &lib;
   EmulatedCommandContext emulated_cmd;
   ClearRTV<ArgumentEncodingContext> clear_rt_cmd;
@@ -917,9 +927,6 @@ private:
   uint64_t barrier_index_ = 0;
 
   uint64_t intrapass_barrier_control_bits_ = 0;
-
-  WMT::Device device_;
-  CommandQueue& queue_;
 };
 
 template <>
