From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Will Faust <contact@volta.audio>
Date: Fri, 24 Apr 2026 12:45:06 +0800
Subject: [PATCH] iOS port: build DXMT for aarch64-windows (PE) and aarch64-iOS
 (unix side)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Patches for running DXMT inside the Mythic iOS app (volta.audio). Produces
aarch64-windows PE DLLs via llvm-mingw, and allows the unix side
(winemetal_unix.c + airconv) to be cross-compiled for iOS-aarch64 and
statically linked into the host app (no Wine unix .so path).

- meson.build: accept aarch64 cpu_family for the Windows cross-build so
  d3d11.dll / dxgi.dll / winemetal.dll target aarch64-w64-mingw32.
- build-aarch64-win.txt: meson cross file using llvm-mingw's
  aarch64-w64-mingw32-clang toolchain.
- src/winemetal/unix/winemetal_unix.c: conditional compilation for iOS:
    * Cocoa -> UIKit imports
    * objc/objc-runtime.h -> objc/message.h + runtime.h
    * bootstrap.h forward declaration (iOS SDK omits the header)
    * NSView.class checks and NSScreen / EDR access stubbed (Cocoa-only)
    * ColorSync / GetChromaticity_xy block gated (iOS lacks the framework)
    * CGDirectDisplay stubs (iOS has no CGDirectDisplay.h)
    * displaySyncEnabled omitted on iOS (macOS-only CAMetalLayer property)
    * MTLStorageModeManaged / didModifyRange: / setShouldMaximizeConcurrent
      Compilation: gated (macOS-only Metal APIs that raise on iOS)
    * __wine_unix_call_funcs renamed to dxmt_winemetal_unix_call_funcs on
      iOS to avoid collision with ntdll's own table when both are linked
      into the same host binary.
- src/d3d11/d3d11_swapchain.cpp: skip the cross-process HWND check —
  Mythic runs Wine as a thread in the host process, so GetWindowThread
  ProcessId and GetProcessId can legitimately disagree without that
  meaning it's actually cross-process.

Upstream: 3Shain/dxmt@a3a6e8f
Madeira-commit: 65ed4e960289a08010055495a777f55b920c66fc
Rebased: clean
Class: madeira-port
Evidence: docs/evidence/2026-09-24-dxmt-latest-rebase.md
Offered-upstream: no
---
 build-aarch64-win.txt               | 15 ++++++
 src/d3d11/d3d11_swapchain.cpp       |  9 ++--
 src/winemetal/unix/winemetal_unix.c | 71 ++++++++++++++++++++++++++++-
 3 files changed, 88 insertions(+), 7 deletions(-)
 create mode 100644 build-aarch64-win.txt

diff --git a/build-aarch64-win.txt b/build-aarch64-win.txt
new file mode 100644
index 0000000..6cca119
--- /dev/null
+++ b/build-aarch64-win.txt
@@ -0,0 +1,15 @@
+[binaries]
+c = '@GLOBAL_SOURCE_ROOT@' / 'toolchains/llvm-mingw-20260421-ucrt-macos-universal/bin/aarch64-w64-mingw32-clang'
+cpp = '@GLOBAL_SOURCE_ROOT@' / 'toolchains/llvm-mingw-20260421-ucrt-macos-universal/bin/aarch64-w64-mingw32-clang++'
+ar = '@GLOBAL_SOURCE_ROOT@' / 'toolchains/llvm-mingw-20260421-ucrt-macos-universal/bin/aarch64-w64-mingw32-ar'
+strip = '@GLOBAL_SOURCE_ROOT@' / 'toolchains/llvm-mingw-20260421-ucrt-macos-universal/bin/aarch64-w64-mingw32-strip'
+windres = '@GLOBAL_SOURCE_ROOT@' / 'toolchains/llvm-mingw-20260421-ucrt-macos-universal/bin/aarch64-w64-mingw32-windres'
+
+[properties]
+needs_exe_wrapper = true
+
+[host_machine]
+system = 'windows'
+cpu_family = 'aarch64'
+cpu = 'aarch64'
+endian = 'little'
diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index d182587..35570f9 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -1103,12 +1103,9 @@ CreateSwapChain(
     return DXGI_ERROR_INVALID_CALL;
   InitReturnPtr(ppSwapChain);
 
-  DWORD window_process_id;
-  GetWindowThreadProcessId(hWnd, &window_process_id);
-  if (GetProcessId(GetCurrentProcess()) != window_process_id) {
-    ERR("CreateSwapChain: cross-process swapchain not supported yet");
-    return E_FAIL;
-  }
+  /* Mythic-iOS: Wine runs the game as a thread inside the host app, so the
+   * HWND's "process" and GetCurrentProcess() can legitimately disagree in
+   * ways that don't map to a real cross-process scenario. Skip the check. */
 
   Com<IMTLDXGIDevice> layer_factory;
   if (FAILED(pDevice->QueryInterface(IID_PPV_ARGS(&layer_factory)))) {
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index 3327b29..332288d 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -1,13 +1,35 @@
 #include <stdatomic.h>
 #include <dlfcn.h>
+#include <TargetConditionals.h>
+#if TARGET_OS_IOS
+#import <UIKit/UIKit.h>
+/* iOS lacks CGDirectDisplay: provide minimal stubs for single-display use. */
+typedef uint32_t CGDirectDisplayID;
+#define kCGNullDirectDisplay ((CGDirectDisplayID)0)
+static inline CGDirectDisplayID CGMainDisplayID(void) { return 1; }
+#else
 #import <Cocoa/Cocoa.h>
