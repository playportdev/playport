diff --git a/src/d3d11/d3d11_swapchain.cpp b/src/d3d11/d3d11_swapchain.cpp
index 35570f9..7b792fe 100644
--- a/src/d3d11/d3d11_swapchain.cpp
+++ b/src/d3d11/d3d11_swapchain.cpp
@@ -741,13 +741,24 @@ public:
       return DXGI_ERROR_INVALID_CALL;
 
     HRESULT hr = S_OK;
+#ifdef DXMT_IOS
+    // iOS has no real window manager, so wsi::isMinimized / isForeground
+    // return meaningless values. Treat the single iOS surface as always
+    // visible + foregrounded.
+    bool window_minimized = false;
+#else
     bool window_minimized = wsi::isMinimized(hWnd);
+#endif
     if ((window_minimized || desc_.Width == 0 || desc_.Height == 0)
         // MSDN: You will not receive DXGI_STATUS_OCCLUDED if you're using a flip model swap chain.
         && desc_.SwapEffect <= DXGI_SWAP_EFFECT_SEQUENTIAL)
       hr = DXGI_STATUS_OCCLUDED;
+#ifdef DXMT_IOS
+    bool should_exit_fs = false;
+#else
     bool should_exit_fs = handle_alt_tab_ // At the moment this is still broken for certain games
                           && !fullscreen_desc_.Windowed && !window_minimized && !wsi::isForeground(hWnd);
+#endif
     if (hr == S_OK && should_exit_fs)
       hr = DXGI_STATUS_OCCLUDED;
     if (PresentFlags & DXGI_PRESENT_TEST)
diff --git a/src/util/meson.build b/src/util/meson.build
index 93dd7bc..10bdb97 100644
--- a/src/util/meson.build
+++ b/src/util/meson.build
@@ -30,6 +30,15 @@ if not dxmt_crossbuild
     'wsi_window_headless.cpp',
     'wsi_platform_darwin.cpp',
   ])
+elif host_machine.cpu_family() == 'aarch64' and host_machine.system() == 'windows'
+  # Mythic iOS target: aarch64-windows PE, but running inside our iOS Wine
+  # with no real window manager. Use headless wsi to stop user32 calls from
+  # returning garbage.
+  util_src += files([
+    'wsi_monitor_headless.cpp',
+    'wsi_window_headless.cpp',
+    'wsi_platform_win32.cpp',
+  ])
 else
   util_src += files([
     'wsi_monitor_win32.cpp',
