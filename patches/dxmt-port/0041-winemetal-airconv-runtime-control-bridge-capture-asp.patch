+WINEMETAL_API obj_handle_t
+MTLDevice_newPlacementHeap(obj_handle_t device, uint64_t size, enum WMTResourceOptions options) {
+  struct WMTHeapInfo info = {};
+  info.size = size;
+  info.options = (enum WMTResourceOptions)(
+      ((options & 0x30) == WMTResourceStorageModePrivate ? WMTResourceStorageModePrivate
+                                                         : WMTResourceStorageModeShared) |
+      WMTResourceHazardTrackingModeTracked
+  );
+  info.type = WMTHeapTypePlacement;
+  return MTLDevice_newHeap(device, &info);
+}
