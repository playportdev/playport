     &_MTLDevice_registryID,
     &_rmg_MTLSharedEvent_waitUntilSignaledValue,
-    &_MTLCounterSampleBuffer_newTimestampBuffer,
-    &_MTLCounterSampleBuffer_resolveCounterRange,
-    &_MTLCommandBuffer_blitCommandEncoderWithSampleBuffers,
-    &_MTLCommandBuffer_property,
-    &_MTLDevice_newTileRenderPipelineState,
+    &_rmg_MTLCounterSampleBuffer_newTimestampBuffer,
+    &_rmg_MTLCounterSampleBuffer_resolveCounterRange,
+    &_rmg_MTLCommandBuffer_blitCommandEncoderWithSampleBuffers,
+    &_rmg_MTLCommandBuffer_property,
+    &_rmg_MTLDevice_newTileRenderPipelineState,
     &_MTLDevice_newResidencySet,
     &_MTLResidencySet_addAllocations,
     &_MTLResidencySet_removeAllocations,
-    &_MTLResidencySet_removeAllAllocations,
+    &_rmg_MTLResidencySet_removeAllAllocations,
     &_MTLResidencySet_commit,
     &_MTLCommandQueue_addResidencySet,
     &_MTLDevice_newHeap,
-    &_MTLDevice_heapBufferSizeAndAlign,
+    &_rmg_MTLDevice_heapBufferSizeAndAlign,
     &_MTLDevice_heapTextureSizeAndAlign,
-    &_MTLHeap_newBuffer,
+    &_rmg_MTLHeap_newBuffer,
     &_MTLHeap_newTexture,
-    &_MTLDevice_newIndirectCommandBuffer,
-    &_MTLDevice_newLibraryWithSource,
-    &_MTLTexture_getBytes,
+    &_rmg_MTLDevice_newIndirectCommandBuffer,
+    &_rmg_MTLDevice_newLibraryWithSource,
+    &_rmg_MTLTexture_getBytes,
     /* Madeira's appended slots (madeira-d3d12 and the geometry-emulation
      * pipeline). APPENDED after upstream's, never inserted: the slot number is
      * the ABI. Madeira's own residency-set slots are not carried: upstream
@@ -5323,25 +5323,25 @@ const void *__wine_unix_call_wow64_funcs[] = {
     &_rmg_MTLDevice_newSharedEventWithMachPort,
     &_MTLDevice_registryID,
     &_rmg_MTLSharedEvent_waitUntilSignaledValue,
-    &_MTLCounterSampleBuffer_newTimestampBuffer,
-    &_MTLCounterSampleBuffer_resolveCounterRange,
-    &_MTLCommandBuffer_blitCommandEncoderWithSampleBuffers,
-    &_MTLCommandBuffer_property,
-    &_MTLDevice_newTileRenderPipelineState,
+    &_rmg_MTLCounterSampleBuffer_newTimestampBuffer,
+    &_rmg_MTLCounterSampleBuffer_resolveCounterRange,
+    &_rmg_MTLCommandBuffer_blitCommandEncoderWithSampleBuffers,
+    &_rmg_MTLCommandBuffer_property,
+    &_rmg_MTLDevice_newTileRenderPipelineState,
     &_MTLDevice_newResidencySet,
     &_MTLResidencySet_addAllocations,
     &_MTLResidencySet_removeAllocations,
-    &_MTLResidencySet_removeAllAllocations,
+    &_rmg_MTLResidencySet_removeAllAllocations,
     &_MTLResidencySet_commit,
     &_MTLCommandQueue_addResidencySet,
     &_MTLDevice_newHeap,
-    &_MTLDevice_heapBufferSizeAndAlign,
+    &_rmg_MTLDevice_heapBufferSizeAndAlign,
     &_MTLDevice_heapTextureSizeAndAlign,
-    &_MTLHeap_newBuffer,
+    &_rmg_MTLHeap_newBuffer,
     &_MTLHeap_newTexture,
-    &_MTLDevice_newIndirectCommandBuffer,
-    &_MTLDevice_newLibraryWithSource,
-    &_MTLTexture_getBytes,
+    &_rmg_MTLDevice_newIndirectCommandBuffer,
+    &_rmg_MTLDevice_newLibraryWithSource,
+    &_rmg_MTLTexture_getBytes,
     &_madeira_ir_convert_wow64,
     &_MTLDevice_newRenderPipelineStateVD_wow64,
     &_MTLDevice_newGeometryEmulationPipelineState_wow64,
