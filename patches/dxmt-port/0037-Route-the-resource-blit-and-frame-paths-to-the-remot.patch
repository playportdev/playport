+static unsigned long wmtr_flush_n;
 #define WMTR_BUFS_MAX 4096
 static struct wmtr_buf wmtr_bufs[WMTR_BUFS_MAX];
 static unsigned wmtr_bufs_n;
@@ -258,6 +319,7 @@ static void wmtr_buf_remove(uint64_t handle) {
