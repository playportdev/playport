+    unsigned long long rw_base;/* OUT: ml639 alias jit_rw_alias BASE (never offset) */
+    unsigned long long rx_base;/* OUT: ml639 alias jit_rx_alias BASE (never offset) */
+    unsigned int slot;        /* OUT: ml639 matched table slot index */
