+ *
+ * callback MUST be the arm64ec_redirect_ptr()-resolved pointer. */
+struct ios_register_hold_release_params
+{
+    unsigned int size;      /* sizeof(struct) — set by caller, checked by callee */
+    unsigned int version;   /* 1 */
