 dlls/ntdll/signal_arm64ec.c |  95 ++++++++++++++++++++--
 dlls/rpcrt4/ndr_marshall.c  |  55 +++++++++++++
 dlls/rpcrt4/ndr_stubless.c  |  40 +++++++--
