From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Will Faust <willtechnoduck@gmail.com>
Date: Tue, 4 Aug 2026 18:35:19 +0800
Subject: [PATCH] iOS-Mythic ml493 (#61, #79): glyph-rasterisation and
 connect-outcome probes

dwrite: count what actually happens to a glyph run, not just that one
occurred. [dwrite-bounds] reports GetAlphaTextureBounds' rect and how
many came back EMPTY; [dwrite-ink] reports whether the alpha texture
CreateAlphaTexture hands back has any ink at all; [dwrite-outline]
covers the path route so "no glyph work of any kind" is a conclusion the
run can support rather than an absence assumed.

That split is what cracked the text wall: 12/12 bounds EMPTY with
[dwrite-ink] never called at all, because a caller told a glyph run has
zero extent has no reason to ask for its texture. Invisible text, no
error reported anywhere. Counting calls alone could not have told
"never asked" from "asked and got nothing".

sock: [srv-conn-done] adds the OUTCOME half of the [srv-conn] census.
The dial census showed Steam reaching the CMs (dport=443/27018, ret=-1
EINPROGRESS) with none appearing ESTABLISHED, but could not say whether
the handshake completed and a higher layer rejected it or the handshake
never landed. It completes: dport=443 event=OUT err=0, so the login
blocker sits above TCP in TLS/WebSocket.

(cherry picked from commit 70d2028f1d7988f9e1674ce5e38174f2987a904e)
Madeira-commit: fce01b7875c751cab121f973aebea6c03516f360
Rebased: clean
Class: madeira-port
Evidence: docs/evidence/2026-09-26-wine-latest-rebase.md
Offered-upstream: no
---
 dlls/dwrite/font.c | 45 +++++++++++++++++++++++++++++++++++++++++++++
 server/sock.c      | 24 ++++++++++++++++++++++++
 2 files changed, 69 insertions(+)

diff --git a/dlls/dwrite/font.c b/dlls/dwrite/font.c
index 9544784b8cc..44b0053db33 100644
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -1117,6 +1117,17 @@ static HRESULT WINAPI dwritefontface_GetGlyphRunOutline(IDWriteFontFace5 *iface,
     if (!count)
         return S_OK;
 
+    /* ml493 probe: the OTHER way a glyph can reach a rasteriser (paths
+     * rather than alpha textures). Instrumented so that "zero glyph work
+     * of any kind" is a conclusion the run can actually support, instead
+     * of an absence I would otherwise have to assume. */
+    {
+        static LONG calls;
+        LONG n = InterlockedIncrement(&calls);
+        if (n <= 8 || (n % 500) == 0)
+            ERR("[dwrite-outline] rev=ml493 call#%ld emSize=%.1f glyphs=%u\n", n, emSize, count);
+    }
+
     run.fontFace = (IDWriteFontFace *)iface;
     run.fontEmSize = emSize;
     run.glyphCount = count;
@@ -5886,6 +5897,21 @@ static HRESULT WINAPI glyphrunanalysis_GetAlphaTextureBounds(IDWriteGlyphRunAnal
     }
 
     glyphrunanalysis_get_texturebounds(analysis, bounds);
+
+    /* ml493 probe: an EMPTY rect here means the caller draws nothing and
+     * never reaches CreateAlphaTexture — so a zero [dwrite-ink] count on
+     * its own would be ambiguous. Log both so the two failure modes
+     * ("no glyph has any extent" vs "extent fine, texture blank") are
+     * distinguishable from one run. */
+    {
+        static LONG calls, empties;
+        LONG n = InterlockedIncrement(&calls);
+        BOOL empty = IsRectEmpty(bounds);
+        if (empty) InterlockedIncrement(&empties);
+        if (n <= 12 || (n % 500) == 0)
+            ERR("[dwrite-bounds] rev=ml493 call#%ld type=%d bounds=%s%s (empty=%ld)\n",
+                n, type, wine_dbgstr_rect(bounds), empty ? " EMPTY" : "", empties);
+    }
     return S_OK;
 }
 
@@ -6069,6 +6095,25 @@ static HRESULT WINAPI glyphrunanalysis_CreateAlphaTexture(IDWriteGlyphRunAnalysi
         }
     }
 
+    /* ml493 probe: is the texture we hand back actually INKED? Chromium
+     * renders every glyph through here, so an all-zero texture is
+     * invisible text with no error anywhere — exactly the symptom on the
+     * Steam login page (boxes, SVG and QR paint; no glyph ever does).
+     * Counting calls alone cannot tell "never asked" from "asked and got
+     * nothing", so this reports both the call count and the ink. */
+    {
+        static LONG calls, inked, blank;
+        UINT32 i, ink = 0;
+        LONG n;
+        for (i = 0; i < size; i++) if (bitmap[i]) { ink++; if (ink > 8) break; }
+        n = InterlockedIncrement(&calls);
+        if (ink) InterlockedIncrement(&inked); else InterlockedIncrement(&blank);
+        if (n <= 12 || (n % 500) == 0)
+            ERR("[dwrite-ink] rev=ml493 call#%ld type=%d size=%u bounds=%s ink=%s "
+                "(inked=%ld blank=%ld)\n", n, type, size, wine_dbgstr_rect(bounds),
+                ink ? "YES" : "NO", inked, blank);
+    }
+
     return S_OK;
 }
 
diff --git a/server/sock.c b/server/sock.c
index 226a305e75a..30df1c2acd7 100644
--- a/server/sock.c
+++ b/server/sock.c
@@ -1391,6 +1391,30 @@ static void sock_dispatch_events( struct sock *sock, enum connection_state prevs
         }
         if (event & (POLLERR | POLLHUP))
             post_socket_event( sock, AFD_POLL_BIT_CONNECT_ERR );
+        /* iOS-Mythic ml493: the OUTCOME half of the [srv-conn] census.
+         * ml493's log proved Steam dials the CMs (dport=443/27018, ret=-1
+         * EINPROGRESS) yet not one appears ESTABLISHED, so every
+         * PingWebSocketCM fails inside a second — but the dial census alone
+         * cannot say whether the handshake completed and a higher layer
+         * (TLS/WebSocket) rejected it, or the handshake never landed at all.
+         * One line per connecting socket's first event decides that. */
+        {
+            static int done_logged;
+            if (done_logged < 96)
+            {
+                unsigned short dport = 0;
+                if (sock->peer_addr.addr.sa_family == WS_AF_INET) dport = ntohs( sock->peer_addr.in.sin_port );
+                else if (sock->peer_addr.addr.sa_family == WS_AF_INET6) dport = ntohs( sock->peer_addr.in6.sin6_port );
+                done_logged++;
+                fprintf( stderr, "[srv-conn-done] dport=%u event=%s%s%s%s err=%d rev=ml493\n",
+                         dport,
+                         (event & POLLOUT) ? "OUT" : "",
+                         (event & POLLERR) ? "|ERR" : "",
+                         (event & POLLHUP) ? "|HUP" : "",
+                         (event & POLLIN) ? "|IN" : "",
+                         sock->errors[AFD_POLL_BIT_CONNECT_ERR] );
+            }
+        }
         break;
 
     case SOCK_LISTENING:
