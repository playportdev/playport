+        UNICODE_STRING alt;
+        const WCHAR *base = libname, *p;
+        for (p = libname; *p; p++) if (*p == '\\' || *p == '/') base = p + 1;
+        if (wcslen( base ) + ARRAY_SIZE( sysx64W ) + 4 < MAX_PATH)
+        {
+            wcscpy( buf, sysx64W );
+            wcscat( buf, base );
+            if (!wcschr( base, '.' )) wcscat( buf, L".dll" );
+            RtlInitUnicodeString( &alt, buf );
