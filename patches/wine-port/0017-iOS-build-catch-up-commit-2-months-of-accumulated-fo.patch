+#ifdef __arm64ec__
+    /* iOS-Mythic mixed-arch pseudo-processes: in a native-ARM64 session the
+     * shared system32 farm serves ARM64 binaries for colliding names, which
+     * an AMD64 child (running this EC ntdll privately) cannot load. Fall
