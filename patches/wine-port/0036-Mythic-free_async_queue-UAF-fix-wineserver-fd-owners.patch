+static void ios_note_free( const struct object *obj )
+{
+    struct ios_free_rec *r = &ios_free_ring[ios_free_seq % IOS_FREE_RING];
+    r->obj = obj;
+    r->ops = obj->ops;
+    r->size = obj->ops ? (unsigned long)obj->ops->size : 0;
+    r->freed_from = __builtin_return_address(0);
+    ios_grab_fp( r->fp, 5 );
