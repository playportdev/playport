+        if (++n > 400000) return -1;        /* undecidable, fail OPEN */
+        it = it->next;
+    }
+    return 0;
+}
+
+static void ios_report_dead_release( const struct object *obj, const void *from )
+{
+    char b[1024];
+    const void *fp[8];
+    int n, i, k, found = 0;
