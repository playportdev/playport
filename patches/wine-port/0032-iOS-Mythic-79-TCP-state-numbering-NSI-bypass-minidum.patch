+            *addr = ios_alert_waiters[i].addr;
+            *age_s = (int)((now.QuadPart - (LONGLONG)ios_alert_waiters[i].since) / 10000000);
+            *inf = ios_alert_waiters[i].inf;
+            return 1;
+        }
+    }
+    return 0;
+}
