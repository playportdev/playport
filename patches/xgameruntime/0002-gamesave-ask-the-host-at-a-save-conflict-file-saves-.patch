+/* The host's answers to save conflicts (NULL: no host), one for the container Other,
+ * the reply's stated size when it is shorter than the text (0: the whole text), and the
+ * questions asked: the last one, and each one's container in order. */
+static const char *conflict_answer;
+static const char *conflict_answer_other;
+static UINT16 conflict_answer_size;
+static unsigned conflicts_asked;
+static char conflict_request[8192];
+static char conflict_containers[256];
+/* The cloud lists Other beside Save. */
+static BOOL two_containers;
 #define CHECK( name, expr )                                                                                            \
     do                                                                                                                 \
     {                                                                                                                  \
@@ -35,6 +46,24 @@ public:
     HRESULT DirectRequest( const WCHAR *, const WCHAR *, const WCHAR *, const void *, DWORD, DWORD *, BYTE **,
                            SIZE_T * ) override;
     void CloseUser( XUserHandle ) override {}
+    HRESULT Conflict( const char *request, SIZE_T size, char **response, UINT16 *responseSize ) override
+    {
+        const char *answer = conflict_answer, *container;
+        ++conflicts_asked;
+        snprintf( conflict_request, sizeof( conflict_request ), "%.*s", ( int )size, request );
+        if ( ( container = strstr( conflict_request, "<Container>" ) ) )
+            snprintf( conflict_containers + strlen( conflict_containers ),
+                      sizeof( conflict_containers ) - strlen( conflict_containers ), "%.*s;",
+                      ( int )strcspn( container + 11, "<" ), container + 11 );
+        if ( strstr( conflict_request, "<Container>Other</Container>" ) ) answer = conflict_answer_other;
+        if ( !answer ) return E_NOTIMPL;
+        /* As the bridge gives it: exactly the stated bytes, no terminator added. */
+        *responseSize = conflict_answer_size ? conflict_answer_size : ( UINT16 )strlen( answer );
+        *response = static_cast<char *>( malloc( strlen( answer ) ) );
+        if ( !*response ) return E_OUTOFMEMORY;
+        memcpy( *response, answer, strlen( answer ) );
+        return S_OK;
+    }
 };
