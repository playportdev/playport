+                unresolved = TRUE;
+                continue;
+            }
         }
-        if ( mode == SYNC_UPLOAD )
+        if ( mode == SYNC_UPLOAD || ( exists && state.dirty && remoteChanged && chosen == SAVE_CHOICE_LOCAL ) )
         {
