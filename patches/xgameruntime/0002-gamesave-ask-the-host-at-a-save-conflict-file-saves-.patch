+    const char *blobs[][2] = { { "one", "remote-A" }, { "two", "remote-B" } };
+    WIN32_FIND_DATAA data;
+    HANDLE find;
+    unsigned count = 0;
+    *whole = 0;
+    snprintf( pattern, sizeof( pattern ), "%s\\.recovery-cloud-*", provider->root );
+    if ( ( find = save_find_first( pattern, &data ) ) == INVALID_HANDLE_VALUE ) return 0;
+    do
+    {
+        unsigned matched = 0;
+        ++count;
+        for ( UINT32 i = 0; i < ARRAY_SIZE( blobs ); i++ )
+        {
+            char *key = provider->files ? files_cache_key( blobs[i][0] ) : hex_encode( blobs[i][0] );
+            BYTE *bytes = NULL;
+            SIZE_T size = 0;
+            snprintf( file, sizeof( file ), "%s\\%s\\b_%s", provider->root, data.cFileName, key ? key : "" );
+            if ( key && SUCCEEDED( read_file( file, &bytes, &size ) ) && size == 8 && !memcmp( bytes, blobs[i][1], 8 ) )
+                ++matched;
+            free( bytes );
+            free( key );
+        }
+        if ( matched == ARRAY_SIZE( blobs ) ) ++*whole;
+    } while ( FindNextFileA( find, &data ) );
+    FindClose( find );
+    return count;
