--- a/src/System/GameSave/Transactions.h
+++ b/src/System/GameSave/Transactions.h
@@ -126,3 +126,46 @@ done:
     delete_directory( incoming.root );
     return hr;
 }
+
+/* Before the local side of a save conflict replaces the cloud's: the cloud's container,
+ * downloaded whole into a private tree, kept as a .recovery-cloud- copy beside the
+ * .recovery- copies a download keeps of the local side. Fails, keeping nothing partial,
+ * when the cloud's container cannot be read whole. */
+static HRESULT cloud_keep_recovery( struct XGameSaveProvider *provider, const char *name, const char *display,
+                                    const char *remote_time )
+{
+    struct XGameSaveProvider incoming = { 0 };
+    char source[2048], target[2048], recovery[2048], guid_text[64];
+    WCHAR stage_wide[4096], source_wide[4096], recovery_wide[4096], guid_wide[40];
+    GUID guid;
+    HRESULT hr;
+
+    if ( FAILED( hr = CoCreateGuid( &guid ) ) ) return hr;
+    if ( !StringFromGUID2( guid, guid_wide, ARRAY_SIZE( guid_wide ) ) ||
+         !WideCharToMultiByte( CP_UTF8, 0, guid_wide, -1, guid_text, sizeof( guid_text ), NULL, NULL ) )
+        return E_FAIL;
+    if ( snprintf( incoming.root, sizeof( incoming.root ), "%s\\.incoming-%s", provider->root, guid_text ) >=
+             sizeof( incoming.root ) ||
+         !container_dir( provider, name, target, sizeof( target ) ) ||
+         snprintf( recovery, sizeof( recovery ), "%s\\.recovery-cloud-%s-%s", provider->root,
+                   strrchr( target, '\\' ) + 1, guid_text ) >= sizeof( recovery ) )
+        return E_GS_INVALID_CONTAINER_NAME;
+    if ( !save_wide_path( incoming.root, stage_wide ) || !save_wide_path( recovery, recovery_wide ) )
+        return E_GS_INVALID_CONTAINER_NAME;
+    if ( FAILED( hr = files_mkdir( provider->root ) ) ) return hr;
+    if ( !CreateDirectoryW( stage_wide, NULL ) ) return HRESULT_FROM_WIN32( GetLastError() );
+    incoming.transport = provider->transport;
+    incoming.user = provider->user;
+    incoming.auth = provider->auth;
+    incoming.files = provider->files;
+    strcpy( incoming.base, provider->base );
+    hr = cloud_download_into( &incoming, name, display, remote_time );
+    if ( SUCCEEDED( hr ) &&
+         ( !container_dir( &incoming, name, source, sizeof( source ) ) || !save_wide_path( source, source_wide ) ) )
+        hr = E_GS_INVALID_CONTAINER_NAME;
+    if ( SUCCEEDED( hr ) && !MoveFileExW( source_wide, recovery_wide, MOVEFILE_WRITE_THROUGH ) )
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+    if ( SUCCEEDED( hr ) ) SaveStatus( "xodus-savesync: cloud side kept in %s\n", strrchr( recovery, '\\' ) + 1 );
+    delete_directory( incoming.root );
+    return hr;
+}
