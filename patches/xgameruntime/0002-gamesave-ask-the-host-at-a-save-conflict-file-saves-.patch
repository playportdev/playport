+    SAVE_CHOICE_CLOUD,
 };
 
+/* Appends text to out, XML-escaped when escape is set; control characters become '?'.
+ * FALSE when it does not fit. */
+static BOOL save_xml_append( char *out, SIZE_T size, SIZE_T *len, const char *text, BOOL escape )
+{
+    for ( const char *p = text ? text : ""; *p; p++ )
+    {
+        char one[2] = { ( BYTE )*p < 0x20 ? '?' : *p, 0 };
+        const char *piece = one;
+        SIZE_T n;
+        if ( escape && *p == '<' ) piece = "&lt;";
+        else if ( escape && *p == '>' ) piece = "&gt;";
+        else if ( escape && *p == '&' ) piece = "&amp;";
+        else if ( escape && *p == '"' ) piece = "&quot;";
+        else if ( escape && *p == '\'' ) piece = "&apos;";
+        n = strlen( piece );
+        if ( *len + n >= size ) return FALSE;
+        memcpy( out + *len, piece, n );
+        *len += n;
+    }
+    out[*len] = 0;
+    return TRUE;
+}
+
+/* A container changed here and in the cloud since the last sync: the player chooses
+ * which to keep (Playport's SAVE_CONFLICT_REQUEST to the host, which shows each side's
+ * time and device). Anything but a clear answer chooses nothing: this session plays on
+ * the local saves, both sides kept, and the next connected session asks again. */
+static enum save_choice ask_save_conflict( struct XGameSaveProvider *provider, const struct container_state *state,
+                                           const struct remote_container *remote )
+{
+    char request[8192], localTime[40], *response = NULL;
+    const char *fields[][2] = {
+        { "Scid", provider->scid },
+        { "Container", state->name },
+        { "DisplayName", state->display && *state->display ? state->display : remote->display },
+        { "LocalTime", localTime },
+        { "CloudTime", remote->time },
+        { "CloudDevice", remote->device },
+    };
+    enum save_choice choice = SAVE_CHOICE_NONE;
+    SIZE_T len = 0;
+    UINT16 size = 0;
+    BOOL ok;
+    HRESULT hr;
+
+    format_iso_time( state->time, localTime, sizeof( localTime ) );
+    ok = save_xml_append( request, sizeof( request ), &len, "<SaveConflictRequest>", FALSE );
+    for ( UINT32 i = 0; ok && i < ARRAY_SIZE( fields ); i++ )
+        ok = save_xml_append( request, sizeof( request ), &len, "<", FALSE ) &&
+             save_xml_append( request, sizeof( request ), &len, fields[i][0], FALSE ) &&
+             save_xml_append( request, sizeof( request ), &len, ">", FALSE ) &&
+             save_xml_append( request, sizeof( request ), &len, fields[i][1], TRUE ) &&
+             save_xml_append( request, sizeof( request ), &len, "</", FALSE ) &&
+             save_xml_append( request, sizeof( request ), &len, fields[i][0], FALSE ) &&
+             save_xml_append( request, sizeof( request ), &len, ">", FALSE );
+    if ( !ok || !save_xml_append( request, sizeof( request ), &len, "</SaveConflictRequest>", FALSE ) )
+        return SAVE_CHOICE_NONE;
+    hr = GetSaveTransport( provider ).Conflict( request, len, &response, &size );
+    if ( SUCCEEDED( hr ) && response && size )
+    {
+        if ( strstr( response, "<Choice>local</Choice>" ) ) choice = SAVE_CHOICE_LOCAL;
+        else if ( strstr( response, "<Choice>cloud</Choice>" ) ) choice = SAVE_CHOICE_CLOUD;
+    }
+    free( response );
+    SaveStatus( "xodus-savesync: conflict asked, hr %#lx, keeping %s\n", hr,
+                choice == SAVE_CHOICE_LOCAL ? "local" : choice == SAVE_CHOICE_CLOUD ? "cloud" : "both (local only)" );
+    return choice;
+}
