diff --git a/src/System/Package/Mount.h b/src/System/Package/Mount.h
new file mode 100644
index 0000000..f35e0d6
--- /dev/null
+++ b/src/System/Package/Mount.h
@@ -0,0 +1,298 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * XPackageMount for packages already extracted on disk: the current game's own
+ * folder, and an installed add-on (content) package of it or a related game,
+ * found as XPackageEnumeratePackages finds it (Content.h). A content package is
+ * mounted only with the account's signed Durable licence for it, the same one
+ * XStoreAcquireLicenseForPackage asks for (Store/PackageLicense.h,
+ * xstore_content_license): being on disk is never a licence. The mount path is
+ * the package's folder; nothing is copied or unpacked. */
+
+HRESULT xstore_content_license( const char *store, LONG *canceled );
+/* An account-free test executable names its own decision (tests/Nexus/package-content.cpp). */
+#ifndef PACKAGE_MOUNT_LICENSE
+#define PACKAGE_MOUNT_LICENSE xstore_content_license
+#endif
+
+#define PACKAGE_MOUNT_PATH ( MAX_PATH * 3 )
+
+struct package_mount
+{
+    char identifier[33], store[13], path[PACKAGE_MOUNT_PATH];
+    BOOL content;
+    struct package_mount *next;
+};
+static SRWLOCK package_mount_lock = SRWLOCK_INIT;
+static struct package_mount *package_mounts;
+
+static BOOL package_mount_id( const char *identifier )
+{
+    UINT i;
+    if ( !identifier || strlen( identifier ) != 32 ) return FALSE;
+    for ( i = 0; i < 32; i++ )
+        if ( !( ( identifier[i] >= '0' && identifier[i] <= '9' ) || ( identifier[i] >= 'a' && identifier[i] <= 'f' ) ) )
+            return FALSE;
+    return TRUE;
+}
+
+static BOOL package_mount_utf8( const WCHAR *path, char *out )
+{
+    return WideCharToMultiByte( CP_UTF8, WC_ERR_INVALID_CHARS, path, -1, out, PACKAGE_MOUNT_PATH, NULL, NULL ) > 1;
+}
+
+/* An installed content package of the current game or a related one, by identifier. */
+static HRESULT package_mount_content( const char *identifier, struct package_mount *mount )
+{
+    struct content_snapshot *snapshot;
+    HRESULT hr;
+    UINT i, found = 0;
+    if ( !( snapshot = static_cast<std::remove_reference_t<decltype( snapshot )>>( calloc( 1, sizeof( *snapshot ) ) ) ) )
+        return E_OUTOFMEMORY;
+    snapshot->current = GetContentConfiguration();
+    hr = E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER;
+    if ( content_id( snapshot->current.store ) && snapshot->current.identity[0] &&
+         SUCCEEDED( content_discover( snapshot ) ) )
+    {
+        for ( i = 0; i < snapshot->count; i++ )
+        {
+            const struct content_package *package = &snapshot->packages[i];
+            if ( strcmp( package->identifier, identifier ) ||
+                 !content_matches( snapshot, package, XPackageEnumerationScope::ThisAndRelated ) )
+                continue;
+            if ( found++ ) break;
+            memcpy( mount->store, package->store, sizeof( mount->store ) );
+            if ( !package_mount_utf8( package->path, mount->path ) ) found = 2;
+        }
+        if ( found == 1 )
+        {
+            mount->content = TRUE;
+            hr = S_OK;
+        }
+    }
+    free( snapshot );
+    return hr;
+}
+
+/* The current game's own package: the folder holding its MicrosoftGame.config, the
+ * one its executable lives in or under, when the identifier is its own. */
+static HRESULT package_mount_current( const char *identifier, struct package_mount *mount )
+{
+    WCHAR path[MAX_PATH], file[MAX_PATH], *sep;
+    char own[33];
+    if ( FAILED( package_identifier( own, sizeof( own ) ) ) || strcmp( own, identifier ) )
+        return E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER;
+    if ( !GetModuleFileNameW( NULL, path, ARRAY_SIZE( path ) ) || !( sep = wcsrchr( path, '\\' ) ) )
+        return E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER;
+    *sep = 0;
+    while ( content_join( path, L"MicrosoftGame.config", file ) )
+    {
+        if ( GetFileAttributesW( file ) != INVALID_FILE_ATTRIBUTES )
+        {
+            if ( !package_mount_utf8( path, mount->path ) ) break;
+            mount->content = FALSE;
+            return S_OK;
+        }
+        if ( !( sep = wcsrchr( path, '\\' ) ) || sep <= path + 2 ) break;
+        *sep = 0;
+    }
+    return E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER;
+}
+
+/* What `identifier` names on disk, without any licence: installation lookup only. */
+static HRESULT package_mount_resolve( const char *identifier, struct package_mount *mount )
+{
+    HRESULT hr;
+    memset( mount, 0, sizeof( *mount ) );
+    if ( !package_mount_id( identifier ) ) return E_INVALIDARG;
+    memcpy( mount->identifier, identifier, sizeof( mount->identifier ) );
+    if ( ( hr = package_mount_content( identifier, mount ) ) != E_GAMEPACKAGE_NO_PACKAGE_IDENTIFIER ) return hr;
+    return package_mount_current( identifier, mount );
+}
+
+/* Licence (content packages), then a registered handle. */
+static HRESULT package_mount_finish( struct package_mount *resolved, LONG *canceled, struct package_mount **out )
+{
+    struct package_mount *mount;
+    HRESULT hr;
+    *out = NULL;
+    if ( resolved->content && FAILED( hr = PACKAGE_MOUNT_LICENSE( resolved->store, canceled ) ) ) return hr;
+    if ( InterlockedCompareExchange( canceled, 0, 0 ) ) return E_ABORT;
+    if ( !( mount = static_cast<std::remove_reference_t<decltype( mount )>>( malloc( sizeof( *mount ) ) ) ) )
+        return E_OUTOFMEMORY;
+    *mount = *resolved;
+    *out = mount;
+    return S_OK;
+}
+
+static void package_mount_publish( struct package_mount *mount )
+{
+    AcquireSRWLockExclusive( &package_mount_lock );
+    mount->next = package_mounts;
+    package_mounts = mount;
+    ReleaseSRWLockExclusive( &package_mount_lock );
+}
+
+static HRESULT package_mount_sync( const char *identifier, XPackageMountHandle *out )
+{
+    struct package_mount resolved, *mount;
+    LONG canceled = 0;
+    HRESULT hr;
+    if ( !out ) return E_INVALIDARG;
+    *out = NULL;
+    if ( FAILED( hr = package_mount_resolve( identifier, &resolved ) ) ) return hr;
+    if ( FAILED( hr = package_mount_finish( &resolved, &canceled, &mount ) ) ) return hr;
+    package_mount_publish( mount );
+    *out = reinterpret_cast<XPackageMountHandle>( mount );
+    return S_OK;
+}
+
+static HRESULT package_mount_path( XPackageMountHandle handle, SIZE_T size, char *path, SIZE_T *needed )
+{
+    struct package_mount *mount;
+    HRESULT hr = E_INVALIDARG;
+    AcquireSRWLockShared( &package_mount_lock );
+    for ( mount = package_mounts; mount && mount != reinterpret_cast<struct package_mount *>( handle ); mount = mount->next )
+        ;
+    if ( mount )
+    {
+        SIZE_T length = strlen( mount->path ) + 1;
+        hr = S_OK;
+        if ( needed ) *needed = length;
+        if ( path )
+        {
+            if ( size < length )
+                hr = E_NOT_SUFFICIENT_BUFFER;
+            else
+                memcpy( path, mount->path, length );
+        }
+    }
+    ReleaseSRWLockShared( &package_mount_lock );
+    return hr;
+}
+
+static void package_mount_close( XPackageMountHandle handle )
+{
+    struct package_mount **link, *mount;
+    AcquireSRWLockExclusive( &package_mount_lock );
+    for ( link = &package_mounts; *link && *link != reinterpret_cast<struct package_mount *>( handle );
+          link = &( *link )->next )
+        ;
+    mount = *link;
+    if ( mount ) *link = mount->next;
+    ReleaseSRWLockExclusive( &package_mount_lock );
+    free( mount );
+}
+
+/* The runtime's own XAsync implementation, with a reference; not through QueryApiImpl,
+ * which would tie package code to the DLL's entry points. */
+static HRESULT package_mount_threading( IXThreadingImpl **out )
+{
+    *out = x_threading_impl;
+    if ( !*out ) return E_UNEXPECTED;
+    ( *out )->AddRef();
+    return S_OK;
+}
+
+struct package_mount_async
+{
+    LONG refs, canceled, started;
+    struct package_mount resolved;
+    struct package_mount *mount;
+    IXThreadingImpl *threading;
+    XAsyncBlock *async;
+};
+static const char package_mount_identity{};
+
+static void package_mount_async_release( struct package_mount_async *context )
+{
+    if ( InterlockedDecrement( &context->refs ) ) return;
+    free( context->mount );
+    ( context->threading )->Release();
+    free( context );
+}
+
+static DWORD WINAPI package_mount_worker( void *arg )
+{
+    package_mount_async *context = static_cast<package_mount_async *>( arg );
+    HRESULT hr = E_ABORT;
+    if ( !InterlockedCompareExchange( &context->canceled, 0, 0 ) )
+        hr = package_mount_finish( &context->resolved, &context->canceled, &context->mount );
+    if ( InterlockedCompareExchange( &context->canceled, 0, 0 ) ) hr = E_ABORT;
+    ( context->threading )->XAsyncComplete( context->async, hr, SUCCEEDED( hr ) ? sizeof( void * ) : 0 );
+    package_mount_async_release( context );
+    return 0;
+}
+
+static HRESULT WINAPI package_mount_provider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    package_mount_async *context = static_cast<package_mount_async *>( data->context );
+    HANDLE worker;
+    HRESULT hr;
+    switch ( op )
+    {
+    case XAsyncOp::Begin:
+        return ( context->threading )->XAsyncSchedule( data->async, 0 );
+    case XAsyncOp::DoWork:
+        if ( InterlockedCompareExchange( &context->started, 1, 0 ) ) return E_PENDING;
+        if ( InterlockedCompareExchange( &context->canceled, 0, 0 ) ) return E_ABORT;
+        context->async = data->async;
+        InterlockedIncrement( &context->refs );
+        if ( !( worker = CreateThread( NULL, 0, package_mount_worker, context, 0, NULL ) ) )
+        {
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+            package_mount_async_release( context );
+            return hr;
+        }
+        CloseHandle( worker );
+        return E_PENDING;
+    case XAsyncOp::GetResult:
+        if ( !data->buffer || data->bufferSize < sizeof( void * ) || !context->mount ) return E_INVALIDARG;
+        package_mount_publish( context->mount );
+        memcpy( data->buffer, &context->mount, sizeof( void * ) );
+        context->mount = NULL;
+        break;
+    case XAsyncOp::Cancel:
+        InterlockedExchange( &context->canceled, TRUE );
+        break;
+    case XAsyncOp::Cleanup:
+        package_mount_async_release( context );
+        break;
+    default:
+        break;
+    }
+    return S_OK;
+}
+
+/* The package is resolved now (an unknown one fails at once); its licence and the
+ * handle come from the async work. There is no UI: a missing licence is
+ * E_ACCESSDENIED, as the Store's own licence calls answer. */
+static HRESULT package_mount_begin( const char *identifier, XAsyncBlock *async )
+{
+    struct package_mount_async *context;
+    HRESULT hr;
+    if ( !async ) return E_INVALIDARG;
+    if ( !( context = static_cast<std::remove_reference_t<decltype( context )>>( calloc( 1, sizeof( *context ) ) ) ) )
+        return E_OUTOFMEMORY;
+    context->refs = 1;
+    if ( FAILED( hr = package_mount_resolve( identifier, &context->resolved ) ) ||
+         FAILED( hr = package_mount_threading( &context->threading ) ) )
+    {
+        free( context );
+        return hr;
+    }
+    hr = ( context->threading )
+             ->XAsyncBegin( async, context, &package_mount_identity, "XPackageMountWithUiAsync", package_mount_provider );
+    if ( FAILED( hr ) ) package_mount_async_release( context );
+    return hr;
+}
+
+static HRESULT package_mount_result( XAsyncBlock *async, XPackageMountHandle *out )
+{
+    IXThreadingImpl *threading;
+    HRESULT hr;
+    if ( !async || !out ) return E_INVALIDARG;
+    *out = NULL;
+    if ( FAILED( hr = package_mount_threading( &threading ) ) ) return hr;
+    hr = ( threading )->XAsyncGetResult( async, &package_mount_identity, sizeof( void * ), out, NULL );
+    ( threading )->Release();
+    return hr;
+}
