+/* Playport (PLA-465): about once a second, from queue submits, log
+ * [kk-residency]: the device residency set's additions, removals and commits
+ * in the interval, the commits' total and longest time, those over 1 ms, and
+ * the removals not yet committed. */
+void
+kk_residency_log(struct kk_device *dev)
+{
+   static int64_t last_ns;
+   static struct kk_memory_stats last;
+   const int64_t now = os_time_get_nano();
+   const int64_t then = p_atomic_read(&last_ns);
+   if (then != 0 && now - then < INT64_C(1000000000))
+      return;
+   if (p_atomic_cmpxchg(&last_ns, then, now) != then)
+      return;
+
+   struct kk_memory_stats *s = &kk_memory_stats;
+   simple_mtx_lock(&dev->residency_set.mutex);
+   const int64_t adds = s->residency_adds, removes = s->residency_removes,
+                 commits = s->residency_commits,
+                 removal_commits = s->residency_removal_commits,
+                 commit_ns = s->residency_commit_ns,
+                 max_ns = s->residency_commit_max_ns,
+                 slow = s->residency_slow_commits;
+   s->residency_commit_max_ns = 0;
+   const uint32_t pending = dev->residency_set.removed_count;
+   const uint64_t pending_B = dev->residency_set.removed_B;
+   simple_mtx_unlock(&dev->residency_set.mutex);
+
+   fprintf(stderr,
+           "[kk-residency] s=%.2f mode=%s adds=%" PRId64 " removes=%" PRId64
+           " commits=%" PRId64 " removal-commits=%" PRId64
+           " commit-ms=%.3f max-ms=%.3f over-1ms=%" PRId64
+           " pending=%u/%.1f MiB\n",
+           then ? (now - then) / 1e9 : 0.0,
+           kk_residency_at_submit ? "submit" : "alloc", adds - last.residency_adds,
+           removes - last.residency_removes, commits - last.residency_commits,
+           removal_commits - last.residency_removal_commits,
+           (commit_ns - last.residency_commit_ns) / 1e6, max_ns / 1e6,
+           slow - last.residency_slow_commits, pending,
+           pending_B / (1024.0 * 1024.0));
+   last.residency_adds = adds;
+   last.residency_removes = removes;
+   last.residency_commits = commits;
+   last.residency_removal_commits = removal_commits;
+   last.residency_commit_ns = commit_ns;
+   last.residency_slow_commits = slow;
+}
+
 void
 kk_destroy_bo(struct kk_device *dev, struct kk_bo *bo)
 {
@@ -242,9 +295,9 @@ kk_destroy_bo(struct kk_device *dev, struct kk_bo *bo)
    /* We may only have a mapped buffer, for example if the memory was imported
     * from a host pointer */
    if (bo->mtl_handle)
-      kk_device_remove_heap_from_residency_set(dev, bo->mtl_handle);
+      kk_device_remove_heap_from_residency_set(dev, bo->mtl_handle, bo->size_B);
    else
-      kk_device_remove_buffer_from_residency_set(dev, bo->map);
+      kk_device_remove_buffer_from_residency_set(dev, bo->map, bo->size_B);
 
    mtl_release(bo->map);
 
