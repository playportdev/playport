+/* Playport (PLA-465): commit the set and request its residency, timed for
+ * the [kk-mem] census. Under the set's mutex. */
+static void
+kk_residency_commit_locked(struct kk_device *dev, bool removals_only)
+{
+   p_atomic_set(&dev->residency_set.committing, 1u);
+   const int64_t start = os_time_get_nano();
+   mtl_residency_set_commit(dev->residency_set.handle);
+   /* A paging hint; once the set is resident it returns at once. */
+   if (!removals_only)
+      mtl_residency_set_request_residency(dev->residency_set.handle);
+   const int64_t ns = os_time_get_nano() - start;
+   p_atomic_set(&dev->residency_set.committing, 0u);
+
+   dev->residency_set.dirty = false;
+   p_atomic_set(&dev->residency_set.removed_count, 0u);
+   dev->residency_set.removed_B = 0u;
+   dev->residency_set.removed_since_ns = 0;
+
+   struct kk_memory_stats *s = &kk_memory_stats;
+   p_atomic_inc(removals_only ? &s->residency_removal_commits
+                              : &s->residency_commits);
+   p_atomic_add(&s->residency_commit_ns, ns);
+   if (ns > INT64_C(1000000))
+      p_atomic_inc(&s->residency_slow_commits);
+   if (ns > s->residency_commit_max_ns)
+      s->residency_commit_max_ns = ns; /* under the mutex */
+}
+
+/* Playport (PLA-465): an allocation was added. Upstream committed the set at
+ * the next submit, on the queue thread; it is committed here instead, before
+ * the allocation is returned, so a submit that uses it needs no commit and
+ * the commit's cost (it grows with the bytes added) falls on the thread that
+ * allocates. MESA_KK_RESIDENCY=submit keeps upstream's way. */
+static void
+kk_residency_added_locked(struct kk_device *dev)
+{
+   p_atomic_inc(&kk_memory_stats.residency_adds);
+   dev->residency_set.dirty = true;
+   if (!kk_residency_at_submit)
+      kk_residency_commit_locked(dev, false);
+}
+
+/* Playport (PLA-465): an allocation was removed. The set keeps it alive until
+ * the next commit, which an addition or a submit makes
+ * (kk_device_make_resources_resident). */
+static void
+kk_residency_removed_locked(struct kk_device *dev, uint64_t size_B)
+{
+   p_atomic_inc(&kk_memory_stats.residency_removes);
+   dev->residency_set.dirty = true;
+   if (dev->residency_set.removed_count == 0u)
+      dev->residency_set.removed_since_ns = os_time_get_nano();
+   p_atomic_inc(&dev->residency_set.removed_count);
+   dev->residency_set.removed_B += size_B;
+}
+
 void
-kk_device_add_heap_to_residency_set(struct kk_device *dev, mtl_heap *heap)
+kk_device_add_heap_to_residency_set(struct kk_device *dev, mtl_heap *heap,
+                                    uint64_t size_B)
 {
    simple_mtx_lock(&dev->residency_set.mutex);
    mtl_residency_set_add_allocation(dev->residency_set.handle, heap);
-   dev->residency_set.dirty = true;
+   kk_residency_added_locked(dev);
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
