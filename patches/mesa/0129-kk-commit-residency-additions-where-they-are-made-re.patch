-kk_device_add_buffer_to_residency_set(struct kk_device *dev, mtl_buffer *buffer)
+kk_device_add_buffer_to_residency_set(struct kk_device *dev, mtl_buffer *buffer,
+                                      uint64_t size_B)
 {
    simple_mtx_lock(&dev->residency_set.mutex);
    mtl_residency_set_add_allocation(dev->residency_set.handle, buffer);
-   dev->residency_set.dirty = true;
+   kk_residency_added_locked(dev);
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
 void
 kk_device_remove_buffer_from_residency_set(struct kk_device *dev,
-                                           mtl_buffer *buffer)
+                                           mtl_buffer *buffer, uint64_t size_B)
 {
    simple_mtx_lock(&dev->residency_set.mutex);
    mtl_residency_set_remove_allocation(dev->residency_set.handle, buffer);
-   dev->residency_set.dirty = true;
+   kk_residency_removed_locked(dev, size_B);
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
+bool
+kk_device_commit_residency_removals(struct kk_device *dev)
+{
+   simple_mtx_lock(&dev->residency_set.mutex);
+   const bool any = dev->residency_set.removed_count != 0u;
+   if (any)
+      kk_residency_commit_locked(dev, true);
+   simple_mtx_unlock(&dev->residency_set.mutex);
+   return any;
+}
+
 void
 kk_device_make_resources_resident(struct kk_device *dev)
 {
-   simple_mtx_lock(&dev->residency_set.mutex);
-   /* Playport, MESA_KK_BATCH2 "residency": commit and request residency only
-    * after the set changed. The set is attached to the queue, so a committed
-    * set needs no commit at every submit; requestResidency is a paging hint. */
-   if (!KK_BATCH2(RESIDENCY) || dev->residency_set.dirty) {
-      mtl_residency_set_commit(dev->residency_set.handle);
-      mtl_residency_set_request_residency(dev->residency_set.handle);
-      dev->residency_set.dirty = false;
+   if (kk_residency_at_submit) {
+      simple_mtx_lock(&dev->residency_set.mutex);
+      /* Playport, MESA_KK_BATCH2 "residency": commit and request residency
+       * only after the set changed. The set is attached to the queue, so a
+       * committed set needs no commit at every submit; requestResidency is a
+       * paging hint. */
+      if (!KK_BATCH2(RESIDENCY) || dev->residency_set.dirty)
+         kk_residency_commit_locked(dev, false);
+      simple_mtx_unlock(&dev->residency_set.mutex);
+      return;
    }
+
+   /* Playport (PLA-465): every addition is already committed. Removals wait
+    * until they hold KK_RESIDENCY_REMOVED_MAX_B or the oldest is
+    * KK_RESIDENCY_REMOVED_MAX_NS old, which costs memory only: a removed
+    * allocation stays resident and alive a little longer. The submit does
+    * not wait for a commit another thread is making (which commits the
+    * removals too); the unlocked reads are only a hint. */
+   if (p_atomic_read(&dev->residency_set.removed_count) == 0u ||
+       p_atomic_read(&dev->residency_set.committing))
+      return;
+   simple_mtx_lock(&dev->residency_set.mutex);
+   if (dev->residency_set.removed_count != 0u &&
+       (dev->residency_set.removed_B >= KK_RESIDENCY_REMOVED_MAX_B ||
+        os_time_get_nano() - dev->residency_set.removed_since_ns >=
+           KK_RESIDENCY_REMOVED_MAX_NS))
+      kk_residency_commit_locked(dev, true);
    simple_mtx_unlock(&dev->residency_set.mutex);
 }
 
