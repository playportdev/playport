    }
    e->current = i;
    if (!e->render) {
@@ -363,7 +420,7 @@ kk_fault_descriptors_changed(struct kk_cmd_buffer *cmd)
 
 void
 kk_fault_pipeline_built(struct kk_device *dev, void *pipeline,
-                        const char *msl_hex)
+                        const char *msl_hex, uint64_t outputs_written)
 {
    if (!KK_DEBUG(FAULT) || !pipeline || !msl_hex)
       return;
@@ -371,13 +428,92 @@ kk_fault_pipeline_built(struct kk_device *dev, void *pipeline,
    memcpy(prefix, msl_hex, 16);
    prefix[16] = '\0';
    const uint64_t msl = strtoull(prefix, NULL, 16);
+   const uint8_t writes =
+      ((outputs_written & VARYING_BIT_LAYER) ? KK_FAULT_WRITES_LAYER : 0u) |
+      ((outputs_written & VARYING_BIT_VIEWPORT) ? KK_FAULT_WRITES_VIEWPORT : 0u);
    simple_mtx_lock(&dev->fault.lock);
-   _mesa_hash_table_u64_insert(dev->fault.pipelines,
-                               (uint64_t)(uintptr_t)pipeline,
-                               (void *)(uintptr_t)msl);
+   /* A Metal object freed and its address reused: the entry is rewritten in
+    * place, as a command buffer may still point at it */
+   struct kk_fault_pipeline_info *info = _mesa_hash_table_u64_search(
+      dev->fault.pipelines, (uint64_t)(uintptr_t)pipeline);
+   if (!info) {
+      info = malloc(sizeof(*info));
+      if (info)
+         _mesa_hash_table_u64_insert(dev->fault.pipelines,
+                                     (uint64_t)(uintptr_t)pipeline, info);
+   }
+   if (info)
+      *info = (struct kk_fault_pipeline_info){.msl = msl, .writes = writes};
    simple_mtx_unlock(&dev->fault.lock);
 }
 
+static void
+format_writes(uint8_t writes, char *buf, size_t size)
+{
+   snprintf(buf, size, "%s%s%s%s", writes ? "[" : "",
+            (writes & KK_FAULT_WRITES_LAYER) ? "layer" : "",
+            writes == (KK_FAULT_WRITES_LAYER | KK_FAULT_WRITES_VIEWPORT)
+               ? ","
+               : "",
+            (writes & KK_FAULT_WRITES_VIEWPORT) ? "viewport]"
+            : writes                            ? "]"
+                                                : "");
+}
+
+static bool
+skipped(const struct kk_device *dev, const struct kk_fault_pipeline_info *p)
+{
+   if (!p)
+      return false;
+   if (p->writes & dev->fault.skip_writes)
+      return true;
+   for (uint32_t i = 0; i < dev->fault.skip_count; i++) {
+      if (p->msl && (p->msl >> (64u - 4u * dev->fault.skip[i].digits)) ==
+                       dev->fault.skip[i].prefix)
+         return true;
+   }
+   return false;
+}
+
+bool
+kk_fault_skip_draw(struct kk_cmd_buffer *cmd, uint32_t instances)
+{
+   struct kk_fault_encoder *e = open_encoder(cmd);
+   struct kk_fault_pipeline_info *p = cmd->fault.pipeline;
+   if (!e || !e->render || !p)
+      return false;
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   if (p->writes) {
+      const uint32_t layers = MAX2(e->layers, 1u);
+      const uint32_t bit = 1u << (MIN2(layers, 32u) - 1u);
+      simple_mtx_lock(&dev->fault.lock);
+      const bool log = !(p->noted_layers & bit) &&
+                       dev->fault.layer_notes < KK_FAULT_LAYER_NOTES;
+      if (log) {
+         p->noted_layers |= bit;
+         dev->fault.layer_notes++;
+      }
+      simple_mtx_unlock(&dev->fault.lock);
+      if (log) {
+         char writes[24];
+         format_writes(p->writes, writes, sizeof(writes));
+         fprintf(stderr,
+                 "[kk-fault] msl=%016" PRIx64 " writes %s: drawn in a pass of "
+                 "%u layer(s) %ux%u, x%u instance(s) (cb #%u enc %u)\n",
+                 p->msl, writes, e->layers, e->area_w, e->area_h, instances,
+                 cmd->fault.serial,
+                 (unsigned)util_dynarray_num_elements(&cmd->fault.trail,
+                                                      struct kk_fault_encoder) -
+                    1u);
+         fflush(stderr);
+      }
+   }
+   if (!skipped(dev, p))
+      return false;
+   e->skipped++;
+   return true;
+}
+
 static void
 view_ids(const struct kk_image_view *view, uint64_t ids[9])
 {
@@ -700,17 +836,62 @@ log_high_water(struct kk_fault_commit *c)
 static const char *const attachment_names[KK_FAULT_ATTACHMENTS] = {
    "c0", "c1", "c2", "c3", "c4", "c5", "c6", "c7", "depth", "stencil"};
 
+static bool
+ts_written(const struct kk_fault_commit *c, uint64_t ts)
+{
+   return ts && ts >= c->committed_ts && c->dev->fault.timestamp_hz;
+}
+
 /* "+1.234" ms after the commit, "-" if the GPU wrote none for this cb */
 static void
 format_ts(const struct kk_fault_commit *c, uint64_t ts, char *buf, size_t size)
 {
-   if (!ts || ts < c->committed_ts || !c->dev->fault.timestamp_hz)
+   if (!ts_written(c, ts))
       snprintf(buf, size, "-");
    else
       snprintf(buf, size, "+%.3f",
                (double)(ts - c->committed_ts) * 1000.0 / c->dev->fault.timestamp_hz);
 }
 
+/* Where the GPU stopped, from the encoders' timestamps: the first encoder
+ * that started and did not end, else the one after the last that ended */
+static void
+log_stop(const struct kk_fault_commit *c, const struct kk_fault_encoder *trail,
+         uint32_t count, const uint64_t *ts)
+{
+   if (!ts) {
+      fprintf(stderr, "[kk-fault] cb #%u stopped: not known (no encoder "
+                      "timestamps)\n", c->serial);
+      return;
+   }
+   int32_t unfinished = -1, last_ended = -1;
+   uint32_t written = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      if (trail[i].ts == ~0u)
+         continue;
+      const bool started = ts_written(c, ts[2u * i]);
+      const bool ended = ts_written(c, ts[2u * i + 1u]);
+      written += started || ended;
+      if (started && !ended && unfinished < 0)
+         unfinished = i;
+      if (ended)
+         last_ended = i;
+   }
+   if (unfinished >= 0)
+      fprintf(stderr, "[kk-fault] cb #%u stopped in enc %d: it started and "
+                      "did not end\n", c->serial, unfinished);
+   else if (!written)
+      fprintf(stderr, "[kk-fault] cb #%u stopped before any encoder wrote a "
+                      "timestamp\n", c->serial);
+   else if ((uint32_t)(last_ended + 1) < count)
+      fprintf(stderr, "[kk-fault] cb #%u stopped after enc %d, the last that "
+                      "ended: enc %d did not start\n",
+              c->serial, last_ended, last_ended + 1);
+   else
+      fprintf(stderr, "[kk-fault] cb #%u stopped after its last encoder "
+                      "ended\n", c->serial);
+}
+
 static void
 log_encoder(struct kk_fault_commit *c, uint32_t i,
             const struct kk_fault_encoder *e, const uint64_t *ts)
@@ -753,9 +934,11 @@ log_encoder(struct kk_fault_commit *c, uint32_t i,
    if (e->pipeline_count) {
       fprintf(stderr, "[kk-fault] cb #%u enc %u   pipelines", c->serial, i);
       for (unsigned p = 0; p < e->pipeline_count; p++) {
+         char writes[24];
