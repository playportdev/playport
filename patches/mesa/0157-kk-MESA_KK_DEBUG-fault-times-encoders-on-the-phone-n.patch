+/* Playport (PLA-880), MESA_KK_EXPERIMENTAL=layer_clamp: a layer at or past
+ * the render pass's layers becomes 0 */
+static bool
+kk_clamp_layer_store(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_store_output ||
+       nir_intrinsic_io_semantics(intr).location != VARYING_SLOT_LAYER)
+      return false;
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *layer = intr->src[0].ssa;
+   if (layer->bit_size != 32)
+      return false;
+   nir_def *layers = nir_load_render_target_layers_kk(b);
+   nir_src_rewrite(&intr->src[0],
+                   nir_bcsel(b, nir_ult(b, layer, layers), layer,
+                             nir_imm_int(b, 0)));
+   return true;
+}
