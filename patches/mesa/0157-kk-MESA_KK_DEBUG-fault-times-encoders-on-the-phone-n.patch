+/* Encoder timestamps the counter heap keeps, two an encoder: as many as one
+ * heap may have (the phone refuses 8192: "max is 4096") */
+#define KK_FAULT_TIMESTAMPS KK_TS_HEAP_ENTRIES
+
+/* MESA_KK_FAULT_SKIP=a,b,...: each entry an MSL hash prefix of 1 to 16 hex
+ * digits, or "layer" or "viewport" (a vertex stage writing one) */
+static void
+parse_skip(struct kk_fault_device *f, char *out, size_t size)
+{
+   const char *s = getenv("MESA_KK_FAULT_SKIP");
+   out[0] = '\0';
+   while (s && *s) {
+      const size_t len = strcspn(s, ",");
+      char entry[24];
+      snprintf(entry, sizeof(entry), "%.*s", (int)MIN2(len, sizeof(entry) - 1u), s);
+      const char *what = NULL;
+      if (!strcmp(entry, "layer")) {
+         f->skip_writes |= KK_FAULT_WRITES_LAYER;
+         what = entry;
+      } else if (!strcmp(entry, "viewport")) {
+         f->skip_writes |= KK_FAULT_WRITES_VIEWPORT;
+         what = entry;
+      } else if (len >= 1u && len <= 16u && strspn(entry, "0123456789abcdefABCDEF") == len &&
+                 f->skip_count < KK_FAULT_SKIPS) {
+         f->skip[f->skip_count].prefix = strtoull(entry, NULL, 16);
+         f->skip[f->skip_count].digits = len;
+         f->skip_count++;
+         what = entry;
+      }
+      const size_t used = strlen(out);
+      if (len)
+         snprintf(out + used, size - used, "%s%s%s", used ? "," : "",
+                  what ? what : entry, what ? "" : "(ignored)");
+      s += len;
+      if (*s == ',')
+         s++;
+   }
+}
+
 void
 kk_fault_device_init(struct kk_device *dev)
 {
@@ -48,12 +89,17 @@ kk_fault_device_init(struct kk_device *dev)
          mtl_new_timestamp_counter_heap(dev->mtl_handle, KK_FAULT_TIMESTAMPS);
       dev->fault.timestamp_hz = mtl_device_timestamp_frequency(dev->mtl_handle);
    }
+   char skip[160];
+   parse_skip(&dev->fault, skip, sizeof(skip));
    fprintf(stderr,
            "[kk-fault] on: encoder labels, command buffer trails, geometry heap "
-           "ring%s, encoder timestamps%s; Metal encoder status: %s\n",
+           "ring%s, encoder timestamps%s; Metal encoder status: %s%s%s; "
+           "vertex layer clamp %s\n",
            dev->fault.ring ? "" : " (not allocated)",
            dev->fault.timestamps ? "" : " (none)",
-           mtl_enable_encoder_execution_status());
+           mtl_enable_encoder_execution_status(),
+           skip[0] ? "; skipping draws: " : "", skip,
+           KK_EXPERIMENTAL(LAYER_CLAMP) ? "on" : "off");
    fflush(stderr);
 }
 
