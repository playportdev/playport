+/* The stages of the pipeline this thread is creating, for
+ * vk_pipeline_creating_stage_spirv. */
+static thread_local const VkPipelineShaderStageCreateInfo *creating_stages;
+static thread_local uint32_t creating_stage_count;
+
+bool
+vk_pipeline_creating_stage_spirv(mesa_shader_stage stage,
+                                 const uint32_t **words, size_t *size,
+                                 const char **entrypoint,
+                                 const VkSpecializationInfo **specialization)
+{
+   for (uint32_t i = 0; i < creating_stage_count; i++) {
+      const VkPipelineShaderStageCreateInfo *info = &creating_stages[i];
+      if (vk_to_mesa_shader_stage(info->stage) != stage)
+         continue;
+
+      VK_FROM_HANDLE(vk_shader_module, module, info->module);
+      if (module != NULL) {
+         /* A driver's internal module holds NIR, not SPIR-V. */
+         if (module->size == 0)
+            return false;
+         *words = (const uint32_t *)module->data;
+         *size = module->size;
+      } else {
+         const VkShaderModuleCreateInfo *minfo =
+            vk_find_struct_const(info->pNext, SHADER_MODULE_CREATE_INFO);
+         if (minfo == NULL)
+            return false;
+         *words = minfo->pCode;
+         *size = minfo->codeSize;
+      }
+      *entrypoint = info->pName;
+      *specialization = info->pSpecializationInfo;
+      return true;
+   }
+   return false;
+}
