 };
 
+static void
+kk_msl_hash(const struct msl_compile_data *first,
+            const struct msl_compile_data *second, char hex[BLAKE3_HEX_LEN])
+{
+   struct mesa_blake3 ctx;
+   blake3_hash hash;
+   _mesa_blake3_init(&ctx);
+   _mesa_blake3_update(&ctx, first->code, strlen(first->code) + 1);
+   if (second)
+      _mesa_blake3_update(&ctx, second->code, strlen(second->code) + 1);
+   _mesa_blake3_final(&ctx, hash);
+   _mesa_blake3_format(hex, hash);
+}
+
+/* MESA_KK_DUMP_MSL_MIN_KB=N: a Metal build whose MSL is over N KB writes,
+ * before it is built, into the directory beside MESA_SHADER_CACHE_DIR named
+ * kk-dump: per stage MSL.STAGE.metal and, when the pipeline being created
+ * gave SPIR-V, MSL.STAGE.spv, then MSL.txt with the entry points and
+ * specialization constants. MSL is the first 16 hex digits of the MSL hash,
+ * as MESA_KK_DEBUG=compile's msl= shows it. A hash already dumped is not
+ * dumped again, and nothing more is written once the directory holds
+ * KK_DUMP_CAP_BYTES. */
+#define KK_DUMP_CAP_BYTES (200ull << 20)
+
+static simple_mtx_t kk_dump_lock = SIMPLE_MTX_INITIALIZER;
+static char kk_dump_dir[PATH_MAX];
+/* Bytes in kk_dump_dir; -1 until the directory has been looked at, and
+ * kk_dump_dir stays empty when there is none. */
+static int64_t kk_dump_bytes = -1;
+static bool kk_dump_cap_logged;
+
+/* The dump directory, made and its bytes counted on first use; NULL when
+ * there is none. Takes kk_dump_lock. */
+static const char *
+kk_dump_directory(void)
+{
+   if (kk_dump_bytes >= 0)
+      return kk_dump_dir[0] ? kk_dump_dir : NULL;
+   kk_dump_bytes = 0;
+
+   const char *cache = getenv("MESA_SHADER_CACHE_DIR");
+   size_t len = cache ? strlen(cache) : 0;
+   while (len > 1 && cache[len - 1] == '/')
+      len--;
+   while (len > 0 && cache[len - 1] != '/')
+      len--;
+   if (len == 0 ||
+       snprintf(kk_dump_dir, sizeof(kk_dump_dir), "%.*skk-dump", (int)len,
+                cache) >= (int)sizeof(kk_dump_dir) ||
+       (mkdir(kk_dump_dir, 0755) != 0 && errno != EEXIST)) {
+      fprintf(stderr, "[kk-dump] no directory beside MESA_SHADER_CACHE_DIR "
+                      "(%s): nothing is dumped\n", cache ? cache : "unset");
+      kk_dump_dir[0] = 0;
+      return NULL;
+   }
+
+   DIR *dir = opendir(kk_dump_dir);
+   if (dir) {
+      for (struct dirent *e; (e = readdir(dir));) {
+         struct stat st;
+         if (fstatat(dirfd(dir), e->d_name, &st, 0) == 0 && S_ISREG(st.st_mode))
+            kk_dump_bytes += st.st_size;
+      }
+      closedir(dir);
+   }
+   fprintf(stderr, "[kk-dump] MSL over %d KB goes to %s (%lld bytes there, "
+                   "cap %llu)\n",
+           kk_dump_msl_min_kb, kk_dump_dir, (long long)kk_dump_bytes,
+           (unsigned long long)KK_DUMP_CAP_BYTES);
+   return kk_dump_dir;
+}
+
+static bool
+kk_dump_file(const char *dir, const char *name, const void *data, size_t size)
+{
+   char path[PATH_MAX];
+   snprintf(path, sizeof(path), "%s/%s", dir, name);
+   FILE *f = fopen(path, "wb");
+   if (!f)
+      return false;
+   bool ok = fwrite(data, 1, size, f) == size;
+   ok = fclose(f) == 0 && ok;
+   kk_dump_bytes += size;
+   return ok;
+}
+
+/* One stage of a build, for kk_dump_msl */
+struct kk_dump_stage {
+   mesa_shader_stage stage;
+   const struct msl_compile_data *data;
+   const uint32_t *spirv;
+   size_t spirv_size;
+   const char *entrypoint;
+   const VkSpecializationInfo *specialization;
+};
+
+static void
+kk_dump_msl(const char *kind, const char *msl,
+            mesa_shader_stage first_stage, const struct msl_compile_data *first,
+            mesa_shader_stage second_stage,
+            const struct msl_compile_data *second)
+{
+   struct kk_dump_stage stages[2] = {
+      {first_stage, first},
+      {second_stage, second},
+   };
+   const uint32_t stage_count = second ? 2u : 1u;
+   size_t msl_bytes = 0, bytes = 0;
+   for (uint32_t i = 0; i < stage_count; i++) {
+      struct kk_dump_stage *s = &stages[i];
+      msl_bytes += strlen(s->data->code);
+      if (vk_pipeline_creating_stage_spirv(s->stage, &s->spirv, &s->spirv_size,
+                                           &s->entrypoint, &s->specialization))
+         bytes += s->spirv_size;
+   }
+   if (msl_bytes <= (size_t)kk_dump_msl_min_kb * 1024u)
+      return;
+   bytes += msl_bytes;
+
+   simple_mtx_lock(&kk_dump_lock);
+   const char *dir = kk_dump_directory();
+   char name[64], path[PATH_MAX];
+   snprintf(name, sizeof(name), "%.16s.txt", msl);
+   snprintf(path, sizeof(path), "%s/%s", dir ? dir : "", name);
+   struct stat st;
+   if (dir == NULL || stat(path, &st) == 0) {
+      simple_mtx_unlock(&kk_dump_lock);
+      return;
+   }
+   if (kk_dump_bytes + bytes > KK_DUMP_CAP_BYTES) {
+      if (!kk_dump_cap_logged)
+         fprintf(stderr, "[kk-dump] %s holds %lld bytes, cap %llu: no more "
+                         "dumps (first left out: msl=%.16s bytes=%zu)\n",
+                 dir, (long long)kk_dump_bytes,
+                 (unsigned long long)KK_DUMP_CAP_BYTES, msl, bytes);
+      kk_dump_cap_logged = true;
+      simple_mtx_unlock(&kk_dump_lock);
+      return;
+   }
+
+   char *text = NULL;
+   size_t text_size = 0;
+   FILE *txt = open_memstream(&text, &text_size);
+   bool ok = txt != NULL;
+   if (txt)
+      fprintf(txt, "kind %s\nmsl %s\n", kind, msl);
+   for (uint32_t i = 0; i < stage_count; i++) {
+      const struct kk_dump_stage *s = &stages[i];
+      const char *ext = _mesa_shader_stage_to_file_ext(s->stage);
+      snprintf(name, sizeof(name), "%.16s.%s.metal", msl, ext);
+      ok = kk_dump_file(dir, name, s->data->code, strlen(s->data->code)) && ok;
+      if (txt)
+         fprintf(txt, "stage %s msl_bytes %zu msl_entry %s", ext,
+                 strlen(s->data->code), s->data->entrypoint_name);
+      if (s->spirv == NULL) {
+         if (txt)
+            fprintf(txt, " spirv none\n");
+         continue;
+      }
+      snprintf(name, sizeof(name), "%.16s.%s.spv", msl, ext);
+      ok = kk_dump_file(dir, name, s->spirv, s->spirv_size) && ok;
+      if (!txt)
+         continue;
+      fprintf(txt, " spirv_bytes %zu spirv_entry %s", s->spirv_size,
+              s->entrypoint);
+      const VkSpecializationInfo *spec = s->specialization;
+      fprintf(txt, " spec_constants %u",
+              spec ? spec->mapEntryCount : 0u);
+      for (uint32_t c = 0; spec && c < spec->mapEntryCount; c++) {
+         const VkSpecializationMapEntry *e = &spec->pMapEntries[c];
+         fprintf(txt, " %u:", e->constantID);
+         for (size_t b = 0; b < e->size && e->offset + b < spec->dataSize; b++)
+            fprintf(txt, "%02x",
+                    ((const uint8_t *)spec->pData)[e->offset + b]);
+      }
+      fprintf(txt, "\n");
+   }
+   if (txt && fclose(txt) == 0) {
+      snprintf(name, sizeof(name), "%.16s.txt", msl);
+      ok = kk_dump_file(dir, name, text, text_size) && ok;
+   } else {
+      ok = false;
+   }
+   free(text);
+   fprintf(stderr, "[kk-dump] %s msl=%.16s bytes=%zu%s\n", kind, msl,
+           msl_bytes, ok ? "" : " (a file could not be written)");
+   simple_mtx_unlock(&kk_dump_lock);
+}
+
+/* What a Metal build does before it builds: the MSL hash, and the dump. */
+static void
+kk_begin_metal_build(struct kk_metal_build *build,
+                     mesa_shader_stage first_stage,
+                     const struct msl_compile_data *first,
+                     mesa_shader_stage second_stage,
