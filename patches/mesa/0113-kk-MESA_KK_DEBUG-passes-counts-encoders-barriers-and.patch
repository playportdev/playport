+};
+
+static struct {
+   simple_mtx_t lock;
+   int64_t start_ns; /* 0 until the first submit */
+   uint32_t frames;
+} kk_pass_log = {.lock = SIMPLE_MTX_INITIALIZER};
+
+void
+kk_pass_stats_log(uint32_t frames, bool final)
+{
+   if (!KK_DEBUG(PASSES))
+      return;
+   int64_t now = os_time_get_nano();
+   simple_mtx_lock(&kk_pass_log.lock);
+   kk_pass_log.frames += frames;
+   if (!kk_pass_log.start_ns) {
+      kk_pass_log.start_ns = now;
+      simple_mtx_unlock(&kk_pass_log.lock);
+      return;
+   }
+   double span_s = (now - kk_pass_log.start_ns) / 1e9;
+   if (span_s < 1.0 && !final) {
+      simple_mtx_unlock(&kk_pass_log.lock);
+      return;
+   }
+   /* Totals over the interval, then per presented frame */
+   char line[2048];
+   int len = snprintf(line, sizeof(line), "[kk-passes] %.2f s%s: frames=%u",
+                      span_s, final ? " final" : "", kk_pass_log.frames);
+   uint32_t totals[KK_PASS_STAT_COUNT];
+   for (unsigned i = 0; i < KK_PASS_STAT_COUNT; i++) {
+      totals[i] = p_atomic_xchg(&kk_pass_stats[i], 0u);
+      len += snprintf(line + len, sizeof(line) - len, " %s=%u",
+                      kk_pass_stat_names[i], totals[i]);
+   }
+   len += snprintf(line + len, sizeof(line) - len, " | per frame:");
+   for (unsigned i = 0; i < KK_PASS_STAT_COUNT; i++) {
+      len += snprintf(line + len, sizeof(line) - len, " %s=%.1f",
+                      kk_pass_stat_names[i],
+                      kk_pass_log.frames ? (double)totals[i] / kk_pass_log.frames
+                                         : 0.0);
+   }
+   fprintf(stderr, "%s\n", line);
+   fflush(stderr);
+   kk_pass_log.start_ns = now;
+   kk_pass_log.frames = 0;
+   simple_mtx_unlock(&kk_pass_log.lock);
+}
