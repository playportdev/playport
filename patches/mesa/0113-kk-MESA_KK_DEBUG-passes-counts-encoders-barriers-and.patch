@@ -64,6 +72,51 @@ extern uint32_t kk_gpu_begins, kk_gpu_once_begins, kk_gpu_passes, kk_gpu_ds_comp
 
 #define KK_DEBUG(flag) unlikely(kk_mesa_debug_flags &KK_DEBUG_##flag)
 
+/* Playport (PLA-72): the counts [kk-passes] logs with KK_DEBUG(PASSES), in
+ * the order kk_pass_stat_names (kk_debug.c) names them */
+enum kk_pass_stat {
+   KK_PASS_STAT_CMD_BUFFERS,     /* command buffers begun */
+   KK_PASS_STAT_PASSES,          /* vkCmdBeginRendering */
+   KK_PASS_STAT_RENDER_ENCODERS, /* Metal render encoders begun */
+   KK_PASS_STAT_COMPUTE_ENCODERS,
+   KK_PASS_STAT_DRAWS,           /* Metal draws */
+   KK_PASS_STAT_EMPTY_RENDER,    /* render encoders ended without a draw */
+   KK_PASS_STAT_CLEAR_ONLY,      /* passes with a clear load and no draw */
+   KK_PASS_STAT_END_BARRIERS,    /* encoder-end barriers, all stages */
+   KK_PASS_STAT_PIPELINE_BARRIERS, /* vkCmdPipelineBarrier2 */
+   KK_PASS_STAT_BARRIERS_RENDER, /* ... in a render encoder, not splitting */
+   KK_PASS_STAT_BARRIER_SPLITS,  /* ... that split the render encoder */
+   KK_PASS_STAT_BARRIERS_COMPUTE, /* ... in a compute encoder */
+   KK_PASS_STAT_BARRIERS_IDLE,   /* ... with no encoder open */
+   KK_PASS_STAT_COMPUTE_SPLITS,  /* render encoders ended for compute work */
+   /* A clear-only pass, then with no encoder between, a pass that loads an
+    * attachment the first cleared: DXMT folds the clear into the load */
+   KK_PASS_STAT_FOLD_CANDIDATES,
+   /* A pass, then with no encoder or barrier between, one with the same
+    * attachments and area that loads every one the first stored: DXMT
+    * merges them */
+   KK_PASS_STAT_MERGE_CANDIDATES,
+   /* A depth or stencil aspect a pass stored, cleared or discarded on its
+    * whole area by the next pass of the command buffer that uses it, with
+    * no encoder between (a DontCare store loses nothing) or with encoders
+    * between (their reads, if any, are not seen) */
+   KK_PASS_STAT_DEAD_DS_DIRECT,
+   KK_PASS_STAT_DEAD_DS_LATER,
+   KK_PASS_STAT_COUNT,
+};
+
+extern uint32_t kk_pass_stats[KK_PASS_STAT_COUNT];
+
+#define KK_PASS_STAT(name)                                                     \
+   do {                                                                        \
+      if (KK_DEBUG(PASSES))                                                    \
+         p_atomic_inc(&kk_pass_stats[KK_PASS_STAT_##name]);                    \
+   } while (0)
+
+/* Called after each submit with the frames it presented; logs [kk-passes]
+ * once the interval reaches a second, or at once when final. */
+extern void kk_pass_stats_log(uint32_t frames, bool final);
+
 /* Playport: MESA_KK_BATCH2=1 turns on these CPU-cost items, less the ones
  * MESA_KK_BATCH2_SKIP names (comma-separated, the names in kk_debug.c), so a
