 struct kk_encoder;
 
+/* Playport (PLA-72): one attachment of a pass, as MESA_KK_DEBUG=passes
+ * compares passes (kk_pass_debug_begin_rendering) */
+struct kk_pass_debug_att {
+   const struct vk_image *image; /* NULL: no attachment */
+   VkFormat format;
+   uint32_t level, layer, layers;
+   VkAttachmentLoadOp load_op;
+   VkAttachmentStoreOp store_op;
+};
+
+#define KK_PASS_DEBUG_ATTS (KK_MAX_RTS + 2)
+#define KK_PASS_DEBUG_STORES 8
+
+struct kk_pass_debug {
+   /* Encoders begun and pipeline barriers or event waits recorded in this
+    * command buffer */
+   uint32_t encoders, barriers;
+   /* Draws since the render encoder and since the pass began */
+   uint32_t encoder_draws, pass_draws;
+   /* The pass has a clear load action */
+   bool pass_clears;
+
+   /* The last pass, as it ended: colour slots, then depth and stencil */
+   bool last_valid, last_clear_only;
+   uint32_t last_encoders, last_barriers;
+   VkRect2D last_area;
+   uint32_t last_layers, last_view_mask, last_color_count;
+   struct kk_pass_debug_att last[KK_PASS_DEBUG_ATTS];
+
+   /* Depth and stencil aspects a pass stored that no later pass used yet,
+    * with the encoder count at that pass's end */
+   struct {
+      const struct vk_image *image;
+      uint32_t level, layer;
+      VkImageAspectFlags aspect;
+      uint32_t encoders;
+   } stored[KK_PASS_DEBUG_STORES];
+   uint32_t stored_next;
+};
