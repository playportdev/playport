+/* Playport (PLA-72): MESA_KK_DEBUG=passes. A pass's attachments as
+ * kk_pass_debug compares them: colour slots, then depth and stencil. */
+static void
+kk_pass_debug_atts(const struct kk_rendering_state *render,
+                   struct kk_pass_debug_att *atts)
+{
+   memset(atts, 0, sizeof(*atts) * KK_PASS_DEBUG_ATTS);
+   for (uint32_t i = 0; i < KK_PASS_DEBUG_ATTS; i++) {
+      const struct kk_attachment *att =
+         i < KK_MAX_RTS
+            ? (i < render->color_att_count ? &render->color_att[i] : NULL)
+         : i == KK_MAX_RTS ? &render->depth_att
+                           : &render->stencil_att;
+      if (!att || !att->iview)
+         continue;
+      atts[i] = (struct kk_pass_debug_att){
+         .image = att->iview->vk.image,
+         .format = att->vk_format,
+         .level = att->iview->vk.base_mip_level,
+         .layer = att->iview->vk.base_array_layer,
+         .layers = att->iview->vk.layer_count,
+         .load_op = att->load_op,
+         .store_op = att->store_op,
+      };
+   }
+}
+
+static bool
+kk_pass_debug_same_subresource(const struct kk_pass_debug_att *a,
+                               const struct kk_pass_debug_att *b)
+{
+   return a->image == b->image && a->format == b->format &&
+          a->level == b->level && a->layer == b->layer &&
+          a->layers == b->layers;
+}
+
+void
+kk_pass_debug_begin_rendering(struct kk_cmd_buffer *cmd)
+{
+   struct kk_pass_debug *pd = &cmd->pass_debug;
+   const struct kk_rendering_state *render = &cmd->state.gfx.render;
+   const bool whole = render->rendering_to_whole_framebuffer &&
+                      !(render->flags & VK_RENDERING_RESUMING_BIT);
+   struct kk_pass_debug_att atts[KK_PASS_DEBUG_ATTS];
+   kk_pass_debug_atts(render, atts);
+
+   pd->pass_draws = 0u;
+   pd->pass_clears = false;
+   for (uint32_t i = 0; i < KK_PASS_DEBUG_ATTS; i++)
+      pd->pass_clears |= whole && atts[i].image &&
+                         atts[i].load_op == VK_ATTACHMENT_LOAD_OP_CLEAR;
+
+   const bool direct = pd->last_valid && pd->encoders == pd->last_encoders;
+   if (direct && pd->last_clear_only) {
+      bool fold = false;
+      for (uint32_t i = 0; i < KK_PASS_DEBUG_ATTS; i++) {
+         if (!atts[i].image || atts[i].load_op != VK_ATTACHMENT_LOAD_OP_LOAD)
+            continue;
+         for (uint32_t j = 0; j < KK_PASS_DEBUG_ATTS; j++)
+            fold |= pd->last[j].image &&
+                    pd->last[j].load_op == VK_ATTACHMENT_LOAD_OP_CLEAR &&
+                    kk_pass_debug_same_subresource(&atts[i], &pd->last[j]);
+      }
+      if (fold)
+         KK_PASS_STAT(FOLD_CANDIDATES);
+   }
+   if (direct && pd->barriers == pd->last_barriers &&
+       !memcmp(&pd->last_area, &render->area, sizeof(render->area)) &&
+       pd->last_layers == render->layer_count &&
+       pd->last_view_mask == render->view_mask &&
+       pd->last_color_count == render->color_att_count) {
+      bool merge = true;
+      for (uint32_t i = 0; i < KK_PASS_DEBUG_ATTS; i++) {
+         merge &= !atts[i].image == !pd->last[i].image;
+         if (!merge || !atts[i].image)
+            continue;
+         merge &= kk_pass_debug_same_subresource(&atts[i], &pd->last[i]) &&
+                  atts[i].load_op == VK_ATTACHMENT_LOAD_OP_LOAD &&
+                  pd->last[i].store_op == VK_ATTACHMENT_STORE_OP_STORE;
+      }
+      if (merge)
+         KK_PASS_STAT(MERGE_CANDIDATES);
+   }
+
+   /* A stored depth or stencil aspect this pass uses: dead if the pass
+    * clears or discards all of it, read otherwise */
+   for (uint32_t i = KK_MAX_RTS; i < KK_PASS_DEBUG_ATTS; i++) {
+      if (!atts[i].image)
+         continue;
+      const VkImageAspectFlags aspect =
+         i == KK_MAX_RTS ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_STENCIL_BIT;
+      for (uint32_t j = 0; j < KK_PASS_DEBUG_STORES; j++) {
+         if (pd->stored[j].image != atts[i].image ||
+             pd->stored[j].level != atts[i].level ||
+             pd->stored[j].layer != atts[i].layer ||
+             pd->stored[j].aspect != aspect)
+            continue;
+         if (whole && (atts[i].load_op == VK_ATTACHMENT_LOAD_OP_CLEAR ||
+                       atts[i].load_op == VK_ATTACHMENT_LOAD_OP_DONT_CARE)) {
+            if (pd->stored[j].encoders == pd->encoders)
+               KK_PASS_STAT(DEAD_DS_DIRECT);
+            else
+               KK_PASS_STAT(DEAD_DS_LATER);
+         }
+         pd->stored[j].image = NULL;
+      }
+   }
+}
+
+void
+kk_pass_debug_end_rendering(struct kk_cmd_buffer *cmd)
+{
+   struct kk_pass_debug *pd = &cmd->pass_debug;
+   const struct kk_rendering_state *render = &cmd->state.gfx.render;
+
+   const bool clear_only = pd->pass_clears && !pd->pass_draws;
+   if (clear_only)
+      KK_PASS_STAT(CLEAR_ONLY);
+
+   pd->last_valid = true;
+   pd->last_clear_only = clear_only;
+   pd->last_encoders = pd->encoders;
+   pd->last_barriers = pd->barriers;
+   pd->last_area = render->area;
+   pd->last_layers = render->layer_count;
+   pd->last_view_mask = render->view_mask;
+   pd->last_color_count = render->color_att_count;
+   kk_pass_debug_atts(render, pd->last);
+
+   const bool force_store = render->force_attachment_store;
+   for (uint32_t i = KK_MAX_RTS; i < KK_PASS_DEBUG_ATTS; i++) {
+      const struct kk_attachment *att =
+         i == KK_MAX_RTS ? &render->depth_att : &render->stencil_att;
+      const VkImageAspectFlags aspect =
+         i == KK_MAX_RTS ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_STENCIL_BIT;
+      if (!att->iview ||
+          kk_get_attachment_store_op(att, force_store,
+                                     render->rendering_to_whole_framebuffer,
+                                     aspect) == MTL_STORE_ACTION_DONT_CARE)
+         continue;
+      uint32_t slot = pd->stored_next;
+      for (uint32_t j = 0; j < KK_PASS_DEBUG_STORES; j++) {
+         if (!pd->stored[j].image ||
+             (pd->stored[j].image == pd->last[i].image &&
+              pd->stored[j].level == pd->last[i].level &&
+              pd->stored[j].layer == pd->last[i].layer &&
+              pd->stored[j].aspect == aspect)) {
+            slot = j;
+            break;
+         }
+      }
+      if (slot == pd->stored_next)
+         pd->stored_next = (pd->stored_next + 1u) % KK_PASS_DEBUG_STORES;
+      pd->stored[slot].image = pd->last[i].image;
+      pd->stored[slot].level = pd->last[i].level;
+      pd->stored[slot].layer = pd->last[i].layer;
+      pd->stored[slot].aspect = aspect;
+      pd->stored[slot].encoders = pd->encoders;
+   }
+}
