+ * allocation for perspective view-projection matrices and log the most
+ * frequent |row 0|, |row 1| pairs (P00, P11) as [kk-proj] lines. */
+void kk_debug_scan_projections(unsigned probe);
+
 extern const VkExternalMemoryProperties kk_mtlheap_mem_props;
 extern const VkExternalMemoryProperties kk_host_mem_props;
 
