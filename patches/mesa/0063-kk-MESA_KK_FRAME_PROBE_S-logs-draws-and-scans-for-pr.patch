index f046505..f17caed 100644
--- a/src/kosmickrisp/vulkan/kk_debug.h
+++ b/src/kosmickrisp/vulkan/kk_debug.h
@@ -78,6 +78,13 @@ extern enum kk_experimental kk_mesa_experimental_flags;
  * default, dumps nothing */
 extern int kk_dump_msl_min_kb;
 
+/* MESA_KK_FRAME_PROBE_S: every this many seconds after the process's first
+ * draw, ten times at most, log the state of the next 2500 draws ([kk-draw])
+ * and scan the host-visible device memory for perspective view-projection
+ * matrices ([kk-proj], kk_debug_scan_projections); 0, the default, does
+ * neither */
+extern int kk_frame_probe_s;
+
