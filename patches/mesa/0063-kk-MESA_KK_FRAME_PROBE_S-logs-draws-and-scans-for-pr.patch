 src/kosmickrisp/vulkan/kk_debug.c         |   3 +
 src/kosmickrisp/vulkan/kk_debug.h         |   7 ++
 src/kosmickrisp/vulkan/kk_device_memory.c | 117 +++++++++++++++++++++-
 src/kosmickrisp/vulkan/kk_device_memory.h |   5 +
 5 files changed, 165 insertions(+), 7 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index 47eeab0..f08f72f 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -30,6 +30,7 @@
 #include "kk_debug.h"
 #include "kk_device_memory.h"
 #include "util/u_atomic.h"
+#include "util/os_time.h"
 #include "util/format/u_format.h"
 #include <stdio.h>
 
@@ -2380,11 +2381,39 @@ build_draw_data(struct kk_cmd_buffer *cmd, struct kk_draw_command *data,
    return draw;
 }
 
+/* MESA_KK_FRAME_PROBE_S: whether this draw is in a probe's window; starts a
+ * probe (its projection scan and a window of 2500 draws) when one is due. */
+static bool
+kk_frame_probe_draw(void)
+{
+   static int64_t start_ns = 0;
+   static uint32_t probes = 0u;
+   static int32_t window = 0;
+   int64_t now = os_time_get_nano();
+   int64_t start = p_atomic_read(&start_ns);
+
+   if (!start) {
+      p_atomic_cmpxchg(&start_ns, 0, now);
+      start = p_atomic_read(&start_ns);
+   }
+   uint32_t done = p_atomic_read(&probes);
+   if (done < 10u &&
+       now - start >= (int64_t)(done + 1u) * kk_frame_probe_s * 1000000000ll &&
+       p_atomic_cmpxchg(&probes, done, done + 1u) == done) {
+      fprintf(stderr, "[kk-proj] probe=%u at %llds: the next 2500 draws follow\n",
+              done + 1u, (long long)((now - start) / 1000000000ll));
+      p_atomic_set(&window, 2500);
+      kk_debug_scan_projections(done + 1u);
+   }
+   return p_atomic_read(&window) > 0 && p_atomic_dec_return(&window) >= 0;
+}
+
 static void
-kk_debug_log_draw(struct kk_cmd_buffer *cmd, const struct kk_draw_command *data)
+kk_debug_log_draw(struct kk_cmd_buffer *cmd, const struct kk_draw_command *data,
+                  bool probe)
 {
    static uint32_t logged = 0u;
-   if (p_atomic_inc_return(&logged) > 400u)
+   if (!probe && p_atomic_inc_return(&logged) > 400u)
       return;
    const struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
    const struct kk_rendering_state *r = &cmd->state.gfx.render;
@@ -2470,10 +2499,11 @@ kk_draw(struct kk_cmd_buffer *cmd, struct kk_draw_command *data)
    struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
 
    kk_flush_gfx_state(cmd);
-   if (KK_DEBUG(DRAWS)) {
-      kk_debug_log_draw(cmd, data);
+   bool probe = kk_frame_probe_s > 0 && kk_frame_probe_draw();
+   if (KK_DEBUG(DRAWS) || probe)
+      kk_debug_log_draw(cmd, data, probe);
+   if (KK_DEBUG(DRAWS))
       kk_debug_log_vertices(cmd, data);
-   }
 
    data->restart = dyn->ia.primitive_restart_enable;
    data->restart_index = dyn->ia.primitive_restart_index;
