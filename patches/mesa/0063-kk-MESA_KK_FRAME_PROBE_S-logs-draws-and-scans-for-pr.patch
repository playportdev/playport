diff --git a/src/kosmickrisp/vulkan/kk_device_memory.c b/src/kosmickrisp/vulkan/kk_device_memory.c
index 2415298..fe35738 100644
--- a/src/kosmickrisp/vulkan/kk_device_memory.c
+++ b/src/kosmickrisp/vulkan/kk_device_memory.c
@@ -22,6 +22,9 @@
 #include "util/u_memory.h"
 
 #include <inttypes.h>
+#include <math.h>
+#include <stdlib.h>
+#include "util/os_time.h"
 #include <sys/mman.h>
 #include <pthread.h>
 
@@ -155,7 +158,7 @@ kk_AllocateMemory(VkDevice device, const VkMemoryAllocateInfo *pAllocateInfo,
       kk_bo_set_kind(mem->bo, KK_BO_KIND_DEVICE_MEMORY);
    }
 
-   if (KK_DEBUG(DRAWS))
+   if (KK_DEBUG(DRAWS) || kk_frame_probe_s > 0)
       kk_debug_record_memory(dev, mem->bo);
 
    *pMem = kk_device_memory_to_handle(mem);
@@ -218,6 +221,116 @@ kk_debug_read_gpu(struct kk_device *dev, uint64_t gpu, void *dst, size_t size)
    return found;
 }
 
+/* A view-projection VP = P * V, with V a rigid view transform: the xyz parts
+ * of VP's rows 0, 1 and 3 are orthogonal, |row 3| = 1, |row 0| = P00 and
+ * |row 1| = P11, so P11 / P00 is the aspect the game projected with. Both
+ * row- and column-major layouts are tried, at every 16-byte offset. */
+struct kk_proj_hit {
+   int32_t p00, p11; /* times 10000 */
+   uint32_t count;
+};
+
+static float
+kk_proj_dot(const float *a, const float *b)
+{
+   return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+static void
+kk_proj_check(const float *m, struct kk_proj_hit *hits, uint32_t *hit_count,
+              uint32_t *dropped)
+{
+   for (int column_major = 0; column_major < 2; column_major++) {
+      float r[4][3];
+      for (int i = 0; i < 4; i++)
+         for (int c = 0; c < 3; c++)
+            r[i][c] = column_major ? m[c * 4 + i] : m[i * 4 + c];
+      float n3 = kk_proj_dot(r[3], r[3]);
+      if (!(fabsf(n3 - 1.0f) < 4e-3f))
+         continue;
+      float n0 = sqrtf(kk_proj_dot(r[0], r[0]));
+      float n1 = sqrtf(kk_proj_dot(r[1], r[1]));
+      if (!(n0 > 0.1f && n0 < 20.0f && n1 > 0.1f && n1 < 20.0f))
+         continue;
+      if (fabsf(n0 - 1.0f) < 1e-3f && fabsf(n1 - 1.0f) < 1e-3f)
+         continue; /* a rigid transform, not a projection */
+      if (fabsf(kk_proj_dot(r[0], r[1])) > 2e-3f * n0 * n1 ||
+          fabsf(kk_proj_dot(r[0], r[3])) > 2e-3f * n0 ||
+          fabsf(kk_proj_dot(r[1], r[3])) > 2e-3f * n1)
+         continue;
+      int32_t p00 = (int32_t)lroundf(n0 * 10000.0f);
+      int32_t p11 = (int32_t)lroundf(n1 * 10000.0f);
+      uint32_t i;
+      for (i = 0; i < *hit_count; i++)
+         if (hits[i].p00 == p00 && hits[i].p11 == p11)
+            break;
+      if (i < *hit_count)
+         hits[i].count++;
+      else if (*hit_count < 256)
+         hits[(*hit_count)++] = (struct kk_proj_hit){p00, p11, 1u};
+      else
+         (*dropped)++;
+   }
+}
+
+static int
+kk_proj_hit_order(const void *a, const void *b)
+{
+   const struct kk_proj_hit *x = a, *y = b;
+   return x->count < y->count ? 1 : x->count > y->count ? -1 : 0;
+}
+
+static void *
+kk_debug_scan_thread(void *arg)
+{
+   unsigned probe = (unsigned)(uintptr_t)arg;
+   struct kk_proj_hit *hits = calloc(256, sizeof(*hits));
+   uint32_t hit_count = 0u, dropped = 0u, bos = 0u;
+   uint64_t bytes = 0u;
+   int64_t start = os_time_get_nano();
+
+   if (!hits)
+      return NULL;
+   /* Under the registry lock: no allocation is freed while it is read. */
+   pthread_mutex_lock(&kk_debug_mem_lock);
+   for (uint32_t i = 0; i < ARRAY_SIZE(kk_debug_mem); i++) {
+      const struct kk_bo *bo = kk_debug_mem[i].bo;
+      if (!bo || !bo->cpu || bo->size_B < 64u)
+         continue;
+      const float *f = bo->cpu;
+      uint64_t floats = bo->size_B / 4u;
+      bos++;
+      bytes += bo->size_B;
+      for (uint64_t o = 0; o + 16u <= floats; o += 4u)
+         kk_proj_check(f + o, hits, &hit_count, &dropped);
+   }
+   pthread_mutex_unlock(&kk_debug_mem_lock);
+   qsort(hits, hit_count, sizeof(*hits), kk_proj_hit_order);
+   fprintf(stderr, "[kk-proj] probe=%u scanned %u allocations, %llu MB in %lld ms: "
+           "%u distinct pairs, %u not counted\n", probe, bos,
+           (unsigned long long)(bytes >> 20),
+           (long long)((os_time_get_nano() - start) / 1000000), hit_count, dropped);
+   for (uint32_t i = 0; i < hit_count && i < 24u; i++)
+      fprintf(stderr, "[kk-proj] probe=%u P00 %.4f P11 %.4f aspect %.4f hits %u\n", probe,
+              hits[i].p00 / 10000.0, hits[i].p11 / 10000.0,
+              hits[i].p00 ? (double)hits[i].p11 / hits[i].p00 : 0.0, hits[i].count);
+   free(hits);
+   return NULL;
+}
+
+void
+kk_debug_scan_projections(unsigned probe)
+{
+   pthread_t thread;
+   pthread_attr_t attr;
+
+   pthread_attr_init(&attr);
+   pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+   if (pthread_create(&thread, &attr, kk_debug_scan_thread, (void *)(uintptr_t)probe))
+      fprintf(stderr, "[kk-proj] probe=%u: no scan thread\n", probe);
+   pthread_attr_destroy(&attr);
+}
+
 VKAPI_ATTR void VKAPI_CALL
 kk_FreeMemory(VkDevice device, VkDeviceMemory _mem,
               const VkAllocationCallbacks *pAllocator)
@@ -228,7 +341,7 @@ kk_FreeMemory(VkDevice device, VkDeviceMemory _mem,
    if (!mem)
       return;
 
-   if (KK_DEBUG(DRAWS))
+   if (KK_DEBUG(DRAWS) || kk_frame_probe_s > 0)
       kk_debug_forget_memory(dev, mem->bo);
 
    /* According to spec, memory is implicitly unmapped upon free */
diff --git a/src/kosmickrisp/vulkan/kk_device_memory.h b/src/kosmickrisp/vulkan/kk_device_memory.h
index 30b07e9..6c1347e 100644
--- a/src/kosmickrisp/vulkan/kk_device_memory.h
+++ b/src/kosmickrisp/vulkan/kk_device_memory.h
@@ -29,6 +29,11 @@ VK_DEFINE_NONDISP_HANDLE_CASTS(kk_device_memory, vk.base, VkDeviceMemory,
  * registry lock. The caller never retains a pointer to freed memory. */
 bool kk_debug_read_gpu(struct kk_device *dev, uint64_t gpu, void *dst, size_t size);
 
