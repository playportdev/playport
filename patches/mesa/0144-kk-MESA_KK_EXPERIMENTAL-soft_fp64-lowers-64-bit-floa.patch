    KK_EXPERIMENTAL_NO_QUAD_MERGE_BLOCK = 1ull << 22,
+   /* Playport (PLA-815): shaderFloat64, with 64-bit denorms preserved and
+    * float controls independent, and every 64-bit float operation lowered
+    * to integer code by Mesa's soft-fp64 library (float64.glsl), as ANV's
+    * fp64_workaround_enabled does on GPUs without FP64. Metal has no double.
+    * Changes only shaders that could not be built without it, so it is not
+    * in the pipeline cache UUID. Must be named */
+   KK_EXPERIMENTAL_SOFT_FP64 = 1ull << 23,
 };
 
 extern enum kk_experimental kk_mesa_experimental_flags;
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index c193084..cba6781 100644
