+  ],
+  depfile : 'float64_spv.h.d',
+)
+
 kk_entrypoints = custom_target(
   'kk_entrypoints',
   input : [vk_entrypoints_gen, vk_api_xml],
@@ -153,6 +170,7 @@ libkk = static_library(
   [
     kk_files,
     kk_entrypoints,
+    kk_float64_spv_h,
     sha1_h,
   ],
   include_directories : [
