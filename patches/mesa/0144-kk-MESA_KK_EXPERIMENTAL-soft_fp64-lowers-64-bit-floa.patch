       .shaderInt64 = true,
+      /* Playport (PLA-815): in software (kk_preprocess_nir) */
+      .shaderFloat64 = KK_EXPERIMENTAL(SOFT_FP64),
       .shaderResourceMinLod = true,
       .shaderSampledImageArrayDynamicIndexing = true,
       .shaderStorageBufferArrayDynamicIndexing = true,
@@ -789,7 +794,11 @@ kk_get_device_properties(
       .independentResolve = true,
       .driverID = VK_DRIVER_ID_MESA_KOSMICKRISP,
       .conformanceVersion = (VkConformanceVersion){1, 4, 6, 2},
-      .denormBehaviorIndependence = VK_SHADER_FLOAT_CONTROLS_INDEPENDENCE_NONE,
+      /* Playport (PLA-815): with soft_fp64, ALL, which vkd3d-proton needs to
+       * report FP64: the fp16/fp32 denorm modes still cannot be asked for */
+      .denormBehaviorIndependence =
+         KK_EXPERIMENTAL(SOFT_FP64) ? VK_SHADER_FLOAT_CONTROLS_INDEPENDENCE_ALL
+                                    : VK_SHADER_FLOAT_CONTROLS_INDEPENDENCE_NONE,
       .roundingModeIndependence = VK_SHADER_FLOAT_CONTROLS_INDEPENDENCE_NONE,
       /* Playport (PLA-72): neither with MESA_KK_EXPERIMENTAL=no_fp_preserve */
       .shaderSignedZeroInfNanPreserveFloat16 = !KK_EXPERIMENTAL(NO_FP_PRESERVE),
@@ -797,7 +806,8 @@ kk_get_device_properties(
       .shaderSignedZeroInfNanPreserveFloat64 = false,
       .shaderDenormPreserveFloat16 = false,
       .shaderDenormPreserveFloat32 = false,
-      .shaderDenormPreserveFloat64 = false,
+      /* Playport (PLA-815): float64.glsl keeps subnormals */
+      .shaderDenormPreserveFloat64 = KK_EXPERIMENTAL(SOFT_FP64),
       .shaderDenormFlushToZeroFloat16 = false,
       .shaderDenormFlushToZeroFloat32 = false,
       .shaderDenormFlushToZeroFloat64 = false,
@@ -1410,6 +1420,7 @@ kk_enumerate_physical_devices(struct vk_instance *_instance)
    if (result != VK_SUCCESS)
       goto fail_disk_cache;
 
+   simple_mtx_init(&pdev->softfp64_mtx, mtx_plain);
    list_add(&pdev->vk.link, &instance->vk.physical_devices.list);
 
    return VK_SUCCESS;
@@ -1434,9 +1445,47 @@ kk_physical_device_destroy(struct vk_physical_device *vk_pdev)
    kk_physical_device_free_disk_cache(pdev);
    vk_physical_device_finish(&pdev->vk);
    mtl_release(pdev->mtl_dev_handle);
+   ralloc_free(pdev->softfp64);
+   simple_mtx_destroy(&pdev->softfp64_mtx);
    vk_free(&pdev->vk.instance->alloc, pdev);
 }
 
+/* Playport (PLA-815): Mesa's soft-fp64 library (src/compiler/glsl/float64.glsl,
+ * built to SPIR-V with the driver) as NIR, for nir_lower_doubles; built at the
+ * first shader that needs it, as ANV's anv_ensure_fp64_shader does, since the
+ * NIR takes megabytes. */
+const nir_shader *
+kk_physical_device_softfp64(struct kk_physical_device *pdev)
+{
+   simple_mtx_lock(&pdev->softfp64_mtx);
+   if (!pdev->softfp64) {
+      const struct spirv_capabilities caps = {
+         .Addresses = true,
+         .Float64 = true,
+         .Int8 = true,
+         .Int16 = true,
+         .Int64 = true,
+         .Shader = true,
+      };
+      const struct spirv_to_nir_options options = {
+         .capabilities = &caps,
+         .environment = NIR_SPIRV_VULKAN,
+         .create_library = true,
+      };
+      nir_shader *nir = spirv_to_nir(
+         float64_spv_source, ARRAY_SIZE(float64_spv_source), NULL,
+         MESA_SHADER_COMPUTE, "main", &options, &kk_nir_options);
+      assert(nir != NULL);
+      NIR_PASS(_, nir, nir_lower_variable_initializers, nir_var_function_temp);
+      NIR_PASS(_, nir, nir_lower_returns);
+      NIR_PASS(_, nir, nir_inline_functions);
+      nir_sweep(nir);
+      pdev->softfp64 = nir;
+   }
+   simple_mtx_unlock(&pdev->softfp64_mtx);
+   return pdev->softfp64;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 kk_GetPhysicalDeviceProperties2(VkPhysicalDevice physicalDevice,
                                 VkPhysicalDeviceProperties2 *pProperties)
