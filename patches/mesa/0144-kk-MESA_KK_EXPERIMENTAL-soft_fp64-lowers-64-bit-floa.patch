diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index 7da02a6..39b6eb0 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -111,7 +111,7 @@ kk_get_spirv_options(struct vk_physical_device *vk_pdev,
 }
 
 static void
-kk_preprocess_nir(UNUSED struct vk_physical_device *vk_pdev, nir_shader *nir,
+kk_preprocess_nir(struct vk_physical_device *vk_pdev, nir_shader *nir,
                   UNUSED const struct vk_pipeline_robustness_state *rs)
 {
    /* First, before nir_shader_gather_info below, the runtime's descriptor
@@ -129,6 +129,31 @@ kk_preprocess_nir(UNUSED struct vk_physical_device *vk_pdev, nir_shader *nir,
 
    msl_preprocess_nir(nir);
 
+   /* Playport (PLA-815), MESA_KK_EXPERIMENTAL=soft_fp64: Metal has no double,
+    * so every 64-bit float operation becomes a call into Mesa's soft-fp64
+    * library, inlined, as ANV does (anv_shader_compile.c). Here every function
+    * is inlined and every ALU op scalar, which nir_lower_doubles needs, and
+    * nir_lower_io has not yet split 64-bit varyings. What is left is 64-bit
+    * integer code, which the MSL backend writes as long and ulong. */
+   if (KK_EXPERIMENTAL(SOFT_FP64) && (nir->info.bit_sizes_float & 64)) {
+      const nir_shader *softfp64 = kk_physical_device_softfp64(
+         container_of(vk_pdev, struct kk_physical_device, vk));
+      /* No soft routine for flrp or a fused ffma: split them first */
+      NIR_PASS(_, nir, nir_lower_flrp, 64, false);
+      NIR_PASS(_, nir, nir_opt_algebraic);
+      NIR_PASS(_, nir, nir_lower_doubles, softfp64,
+               nir->options->lower_doubles_options);
+      bool conversions = false;
+      NIR_PASS(conversions, nir, nir_lower_int64_float_conversions);
+      if (conversions) {
+         NIR_PASS(_, nir, nir_opt_algebraic);
+         NIR_PASS(_, nir, nir_lower_doubles, softfp64,
+                  nir->options->lower_doubles_options);
+      }
+      NIR_PASS(_, nir, nir_lower_vars_to_ssa);
+      NIR_PASS(_, nir, nir_opt_dce);
+   }
+
    /* Cannot be part of msl_preprocess_nir since clc does not expose
     * has_base_workgroup_id */
    nir_lower_compute_system_values_options csv_options = {
diff --git a/src/kosmickrisp/vulkan/meson.build b/src/kosmickrisp/vulkan/meson.build
index 71e1bdc..1b5d4d0 100644
