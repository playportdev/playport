diff --git a/src/kosmickrisp/bridge/mtl_device.m b/src/kosmickrisp/bridge/mtl_device.m
index 575c130..2ec6aec 100644
--- a/src/kosmickrisp/bridge/mtl_device.m
+++ b/src/kosmickrisp/bridge/mtl_device.m
@@ -263,6 +263,20 @@ mtl_timestamp_counter_heap_read(mtl_counter_heap *heap, uint32_t count,
    }
 }
 
+bool
+mtl_timestamp_counter_heap_read_range(mtl_counter_heap *heap, uint32_t first,
+                                      uint32_t count, uint64_t *timestamps)
+{
+   @autoreleasepool {
+      NSData *data = [(id<MTL4CounterHeap>)heap
+         resolveCounterRange:NSMakeRange(first, count)];
+      if (!data || data.length != count * sizeof(MTL4TimestampHeapEntry))
+         return false;
+      memcpy(timestamps, data.bytes, data.length);
+      return true;
+   }
+}
+
 /* Resource queries */
