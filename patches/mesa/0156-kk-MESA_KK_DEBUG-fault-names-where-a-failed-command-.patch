+++ b/src/kosmickrisp/bridge/mtl_device.h
@@ -50,6 +50,11 @@ mtl_counter_heap *mtl_new_timestamp_counter_heap(mtl_device *dev,
 /* CPU timeline resolve, only after all writes completed. One uint64_t per entry. */
 bool mtl_timestamp_counter_heap_read(mtl_counter_heap *heap, uint32_t count,
                                       uint64_t *timestamps);
+/* Playport (PLA-880): the same for entries first..first+count-1; an entry
+ * never written (or invalidated) reads 0 */
+bool mtl_timestamp_counter_heap_read_range(mtl_counter_heap *heap,
+                                           uint32_t first, uint32_t count,
+                                           uint64_t *timestamps);
 
 /* Resource queries */
