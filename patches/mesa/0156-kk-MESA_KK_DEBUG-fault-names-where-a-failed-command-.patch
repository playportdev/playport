+static struct kk_fault_encoder *
+last_encoder(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->fault.serial ||
+       !util_dynarray_num_elements(&cmd->fault.trail, struct kk_fault_encoder))
+      return NULL;
+   return util_dynarray_last_ptr(&cmd->fault.trail, struct kk_fault_encoder);
+}
+
+void
+kk_fault_begin_rendering(struct kk_cmd_buffer *cmd)
+{
+   cmd->fault.rendering = false;
+   cmd->fault.desc_dirty = true;
+}
+
+void
+kk_fault_end_rendering(struct kk_cmd_buffer *cmd)
+{
+   cmd->fault.rendering = false;
+}
+
+static void
+note_attachment(struct kk_fault_attachment *a, const struct kk_attachment *att,
+                const struct kk_rendering_state *r)
+{
+   const struct kk_image_view *view = att->iview;
+   if (!view)
+      return;
+   *a = (struct kk_fault_attachment){
+      .image = view->vk.image,
+      .vk_format = att->vk_format,
+      .level = view->vk.base_mip_level,
+      .layer = view->vk.base_array_layer,
+      .layers = r->view_mask ? util_last_bit(r->view_mask) : r->layer_count,
+      .width = view->vk.extent.width,
+      .height = view->vk.extent.height,
+      .samples = view->vk.image->samples,
+      .load_op = att->load_op,
+      .store_op = att->store_op,
+      .store_action = 0xff,
+   };
+}
+
 void
 kk_fault_begin_encoder(struct kk_cmd_buffer *cmd, bool render)
 {
