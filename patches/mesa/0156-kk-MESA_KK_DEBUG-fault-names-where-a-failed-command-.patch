+void
+kk_fault_view_init(struct kk_device *dev, const struct kk_image_view *view)
+{
+   if (!KK_DEBUG(FAULT))
+      return;
+   uint64_t ids[9];
+   view_ids(view, ids);
+   simple_mtx_lock(&dev->fault.lock);
+   for (unsigned i = 0; i < 9; i++) {
+      if (!ids[i])
+         continue;
+      struct kk_fault_view *v = malloc(sizeof(*v));
+      if (!v)
+         break;
+      *v = (struct kk_fault_view){
+         .image = view->vk.image,
+         .level = view->vk.base_mip_level,
+         .levels = view->vk.level_count,
+         .layer = view->vk.base_array_layer,
+         .layers = view->vk.layer_count,
+      };
+      free(_mesa_hash_table_u64_search(dev->fault.views, ids[i]));
+      _mesa_hash_table_u64_insert(dev->fault.views, ids[i], v);
+   }
+   simple_mtx_unlock(&dev->fault.lock);
+}
+
+void
+kk_fault_view_finish(struct kk_device *dev, const struct kk_image_view *view)
+{
+   if (!KK_DEBUG(FAULT))
+      return;
+   uint64_t ids[9];
+   view_ids(view, ids);
+   simple_mtx_lock(&dev->fault.lock);
+   for (unsigned i = 0; i < 9; i++) {
+      if (!ids[i])
+         continue;
+      struct kk_fault_view *v = _mesa_hash_table_u64_search(dev->fault.views, ids[i]);
+      /* Another view may have the ID now (a reused texture) */
+      if (v && v->image == view->vk.image) {
+         _mesa_hash_table_u64_remove(dev->fault.views, ids[i]);
+         free(v);
+      }
+   }
+   simple_mtx_unlock(&dev->fault.lock);
+}
