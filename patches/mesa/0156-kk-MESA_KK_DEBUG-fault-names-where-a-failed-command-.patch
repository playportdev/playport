+/* The draw's sampled, storage and input attachment descriptors, against the
+ * encoder's attachments, once after each change of the graphics descriptors
+ * or of the render encoder */
+static void
+scan_feedback(struct kk_cmd_buffer *cmd, struct kk_fault_encoder *e)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   const struct kk_descriptor_state *desc = &cmd->state.gfx.descriptors;
+   bool found = false;
+   simple_mtx_lock(&dev->fault.lock);
+   for (uint32_t s = 0; s < KK_MAX_SETS && !found; s++) {
+      const struct kk_descriptor_set_layout *layout;
+      const uint8_t *data;
+      uint32_t size;
+      if (desc->sets[s]) {
+         layout = desc->sets[s]->layout;
+         data = desc->sets[s]->mapped_ptr;
+         size = desc->sets[s]->size;
+      } else if (desc->push[s]) {
+         layout = desc->push[s]->layout;
+         data = desc->push[s]->data;
+         size = sizeof(desc->push[s]->data);
+      } else {
+         continue;
+      }
+      if (!layout || !data)
+         continue;
+      for (uint32_t b = 0; b < layout->binding_count && !found; b++) {
+         const struct kk_descriptor_set_binding_layout *bl = &layout->binding[b];
+         if (bl->type != VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE &&
+             bl->type != VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER &&
+             bl->type != VK_DESCRIPTOR_TYPE_STORAGE_IMAGE &&
+             bl->type != VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT)
+            continue;
+         const uint32_t count = MIN2(bl->array_size, 256u);
+         for (uint32_t el = 0; el < count && !found; el++) {
+            const uint32_t offset = bl->offset + el * bl->stride;
+            if (offset + sizeof(uint64_t) > size)
+               break;
+            uint64_t id;
+            memcpy(&id, data + offset, sizeof(id));
+            if (!id)
+               continue;
+            const struct kk_fault_view *v =
+               _mesa_hash_table_u64_search(dev->fault.views, id);
+            if (!v)
+               continue;
+            for (unsigned a = 0; a < KK_FAULT_ATTACHMENTS; a++) {
+               const struct kk_fault_attachment *att = &e->att[a];
+               if (att->image != v->image ||
+                   !ranges_overlap(v->level, v->levels, att->level, 1u) ||
+                   !ranges_overlap(v->layer, v->layers, att->layer,
+                                   MAX2(att->layers, 1u)))
+                  continue;
+               if (!e->feedback.count)
+                  e->feedback = (struct kk_fault_feedback){
+                     .draw = e->draws,
+                     .set = s,
+                     .attachment = a,
+                     .binding = b,
+                     .elem = el,
+                     .type = bl->type,
+                     .level = v->level,
+                     .levels = v->levels,
+                     .layer = v->layer,
+                     .layers = v->layers,
+                  };
+               e->feedback.count++;
+               found = true;
+               break;
+            }
+         }
+      }
+   }
+   simple_mtx_unlock(&dev->fault.lock);
+}
