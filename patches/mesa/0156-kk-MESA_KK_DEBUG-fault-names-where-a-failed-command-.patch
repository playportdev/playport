+   struct kk_fault_encoder e = {
+      .render = render,
+      .current = KK_FAULT_PIPELINES,
+      .ts = ~0u,
+      .meta = f->meta,
+   };
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   if (render) {
+      const struct kk_rendering_state *r = &cmd->state.gfx.render;
+      e.area_w = r->area.extent.width;
+      e.area_h = r->area.extent.height;
+      e.layers = r->layer_count;
+      e.view_mask = r->view_mask;
+      for (unsigned i = 0; i < MIN2(r->color_att_count, 8u); i++)
+         note_attachment(&e.att[i], &r->color_att[i], r);
+      note_attachment(&e.att[8], &r->depth_att, r);
+      note_attachment(&e.att[9], &r->stencil_att, r);
+      if (f->rendering)
+         e.flags |= KK_FAULT_CONTINUED;
+      f->rendering = true;
+      f->desc_dirty = true;
+   }
+   if (dev->fault.timestamps) {
+      e.ts = (p_atomic_add_return(&dev->fault.timestamp_next, 2u) - 2u) %
+             KK_FAULT_TIMESTAMPS;
+      if (render)
+         mtl_render_write_timestamp(cmd->metal.render, MTL_RENDER_STAGE_VERTEX,
