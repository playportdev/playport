+static void
+view_ids(const struct kk_image_view *view, uint64_t ids[9])
+{
+   for (unsigned p = 0; p < 3; p++) {
+      ids[3 * p] = p < view->plane_count ? view->planes[p].sampled_gpu_resource_id : 0;
+      ids[3 * p + 1] = p < view->plane_count ? view->planes[p].storage_gpu_resource_id : 0;
+      ids[3 * p + 2] = p < view->plane_count ? view->planes[p].input_gpu_resource_id : 0;
+   }
+}
