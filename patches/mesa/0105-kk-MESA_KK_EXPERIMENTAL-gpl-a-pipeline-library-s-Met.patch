+      else
+         src->fragment_at_link = "memory";
+      return;
+   }
+   job->refs = 2;
+   job->dev = dev;
+   job->state = KK_GPL_LIBRARY_QUEUED;
+   job->vertex = vertex;
+   job->start = start;
+   job->queued = os_time_get_nano();
+   job->phases = phases;
+
+   if (KK_DEBUG(MEMORY))
+      kk_shader_count(shader, 1);
+   p_atomic_inc(&kk_gpl_memory_stats(dev)->shaders);
+   if (vertex) {
+      src->vertex = shader;
+      src->vertex_job = job;
+   } else {
+      src->fragment = shader;
+      src->fragment_job = job;
+   }
+
+   mtx_lock(&q->lock);
+   if (!q->started && !q->stop)
+      q->started = thrd_create(&q->thread, kk_gpl_library_worker, dev) ==
+                   thrd_success;
+   if (q->started && !q->stop) {
+      list_addtail(&job->link, &q->jobs);
+      q->queued++;
+      cnd_signal(&q->cond);
+      mtx_unlock(&q->lock);
+      return;
+   }
+   /* Without the thread, built here */
+   p_atomic_set(&job->state, KK_GPL_LIBRARY_BUILDING);
+   mtx_unlock(&q->lock);
+   mtl_library *library = kk_gpl_library_job_build(job);
+   mtx_lock(&q->lock);
+   mtl_library *unused = kk_gpl_library_job_done(q, job, library);
+   mtx_unlock(&q->lock);
+   if (unused)
+      mtl_release(unused);
+   kk_gpl_library_job_unref(job);
+}
+
+/* The source of job goes: a queued job leaves the queue unbuilt, one
+ * building keeps its library only until it is built. */
+static void
+kk_gpl_library_job_drop(struct kk_gpl_library_job *job)
+{
+   struct kk_gpl_library_queue *q = job->dev->gpl_library_queue;
+   uint32_t state = KK_GPL_LIBRARY_DROPPED;
+   if (q) {
+      mtx_lock(&q->lock);
+      state = job->state;
+      if (state == KK_GPL_LIBRARY_QUEUED || state == KK_GPL_LIBRARY_BUILDING) {
+         if (state == KK_GPL_LIBRARY_QUEUED)
+            list_del(&job->link);
+         p_atomic_set(&job->state, KK_GPL_LIBRARY_DROPPED);
+         q->dropped++;
+      }
+      mtx_unlock(&q->lock);
+   }
+   if (KK_DEBUG(COMPILE) && (state == KK_GPL_LIBRARY_QUEUED ||
+                             state == KK_GPL_LIBRARY_BUILDING))
+      fprintf(stderr, "[kk-compile] gpl %s dropped %s queue_ms=%.1f\n",
+              job->vertex ? "vertex" : "fragment",
+              state == KK_GPL_LIBRARY_QUEUED ? "queued" : "building",
+              (os_time_get_nano() - job->queued) / 1e6);
+   if (state == KK_GPL_LIBRARY_QUEUED)
+      kk_gpl_library_job_unref(job);
+   kk_gpl_library_job_unref(job);
+}
+
+/* Moves a queued job to the queue's front */
+static void
+kk_gpl_library_job_promote(struct kk_gpl_library_queue *q,
+                           struct kk_gpl_library_job *job)
+{
+   mtx_lock(&q->lock);
+   if (job->state == KK_GPL_LIBRARY_QUEUED && q->jobs.next != &job->link) {
+      list_del(&job->link);
+      list_add(&job->link, &q->jobs);
+      q->promoted++;
+   }
+   mtx_unlock(&q->lock);
+}
+
+void
+kk_gpl_library_queue_log(struct kk_device *dev, const char *when)
+{
+   struct kk_gpl_library_queue *q = dev->gpl_library_queue;
+   if (q == NULL)
+      return;
+   mtx_lock(&q->lock);
+   /* Nothing queued yet, or MESA_KK_DEBUG=sync_libraries */
+   if (!q->started) {
+      mtx_unlock(&q->lock);
+      return;
+   }
+   const uint32_t queued = q->queued, built = q->built, failed = q->failed,
+                  dropped = q->dropped, promoted = q->promoted,
+                  waiting = list_length(&q->jobs);
+   mtx_unlock(&q->lock);
+   fprintf(stderr,
+           "[kk-compile] gpl-queue %s queued=%u built=%u failed=%u "
+           "dropped=%u promoted=%u waiting=%u\n",
+           when, queued, built, failed, dropped, promoted, waiting);
+}
+
+void
+kk_gpl_library_queue_finish(struct kk_device *dev)
+{
+   struct kk_gpl_library_queue *q = dev->gpl_library_queue;
+   if (q == NULL)
+      return;
+   if (KK_DEBUG(COMPILE))
+      kk_gpl_library_queue_log(dev, "finish");
+
+   /* What is still queued is dropped; the build in progress ends first */
+   struct list_head left;
+   list_inithead(&left);
+   mtx_lock(&q->lock);
+   q->stop = true;
+   list_for_each_entry(struct kk_gpl_library_job, job, &q->jobs, link)
+      p_atomic_set(&job->state, KK_GPL_LIBRARY_DROPPED);
+   list_splicetail(&q->jobs, &left);
+   list_inithead(&q->jobs);
+   cnd_broadcast(&q->cond);
+   mtx_unlock(&q->lock);
+   if (q->started)
+      thrd_join(q->thread, NULL);
+   list_for_each_entry_safe(struct kk_gpl_library_job, job, &left, link)
+      kk_gpl_library_job_unref(job);
+
+   cnd_destroy(&q->cond);
+   mtx_destroy(&q->lock);
+   free(q);
+   dev->gpl_library_queue = NULL;
+}
+
+/* The Metal library of a shader compiled on its own: built at once, or by
+ * its job once built (NULL until then) */
+static mtl_library *
+kk_gpl_built_library(mtl_library *library,
+                     const struct kk_gpl_library_job *job)
+{
+   if (library || job == NULL)
+      return library;
+   return p_atomic_read(&job->state) == KK_GPL_LIBRARY_BUILT ? job->library
+                                                            : NULL;
+}
+
+const char *
+kk_gpl_library_blocker(struct kk_device *dev,
+                       struct kk_shader *const *sources)
+{
+   const struct kk_gpl_source *vsrc = sources[MESA_SHADER_VERTEX]->gpl;
+   const struct kk_shader *fs_source = sources[MESA_SHADER_FRAGMENT];
+   /* A fragment shader compiled at link needs the vertex shader's library
+    * only; the empty fragment shader's is built at once */
+   struct kk_gpl_library_job *jobs[2] = {
+      vsrc->vertex_job,
+      fs_source && fs_source->gpl->fragment ? fs_source->gpl->fragment_job
+                                            : NULL,
+   };
+   static const char *const failed[2] = {"vertex-library",
+                                         "fragment-library"};
+   bool pending = false;
+   for (uint32_t i = 0; i < ARRAY_SIZE(jobs); i++) {
+      if (jobs[i] == NULL)
+         continue;
+      const uint32_t state = p_atomic_read(&jobs[i]->state);
+      if (state == KK_GPL_LIBRARY_FAILED)
+         return failed[i];
+      if (state == KK_GPL_LIBRARY_BUILT)
+         continue;
+      pending = true;
+      if (state == KK_GPL_LIBRARY_QUEUED)
+         kk_gpl_library_job_promote(dev->gpl_library_queue, jobs[i]);
+   }
+   return pending ? "library-pending" : NULL;
+}
