 #include <dirent.h>
 #include <errno.h>
@@ -47,6 +49,7 @@
 
 #ifdef __APPLE__
 #include <pthread.h>
+#include <pthread/qos.h>
 #else
 #include <sys/syscall.h>
 #include <unistd.h>
@@ -3902,18 +3905,457 @@ struct kk_gpl_front_end {
    int64_t lowered, compiled;
 };
 
+/* The phases of a pipeline library shader's build before its Metal library,
+ * for [kk-compile] gpl-phases: all 0 for a deserialized one (front_end
+ * NULL) */
+struct kk_gpl_phases {
+   int64_t lower_ns, nir_ns, msl_ns;
+};
+
+static struct kk_gpl_phases
+kk_gpl_phases_of(const struct kk_shader *shader, int64_t start,
+                 const struct kk_gpl_front_end *front_end)
+{
+   if (front_end == NULL)
+      return (struct kk_gpl_phases){0};
+   return (struct kk_gpl_phases){
+      .lower_ns = front_end->lowered - start,
+      .nir_ns = front_end->compiled - front_end->lowered - shader->gpl_msl_ns,
+      .msl_ns = shader->gpl_msl_ns,
+   };
+}
+
+/* MESA_KK_DEBUG=compile: the [kk-compile] gpl line of a Metal library built
+ * for a pipeline library shader (how: built, deserialized or FAIL; ms since
+ * the shader's build began at start), and its gpl-phases line: the time of
+ * each phase, the Metal builds in flight, the wait for serial_libraries and
+ * (queue_ms, PLA-437) the time it waited in the device's queue. */
+static void
+kk_gpl_log_library(const char *kind, const char *how, int64_t start,
+                   const struct kk_library_build *build,
+                   const struct kk_gpl_phases *phases, int64_t queue_ns)
+{
+   fprintf(stderr, "[kk-compile] gpl %s %s ms=%.1f library_ms=%.1f\n", kind,
+           how, (os_time_get_nano() - start) / 1e6, build->ns / 1e6);
+   struct timespec wall = {0};
+   timespec_get(&wall, TIME_UTC);
+   fprintf(stderr,
+           "[kk-compile] gpl-phases %s %s lower_ms=%.1f nir_ms=%.1f "
+           "msl_ms=%.1f wait_ms=%.1f library_ms=%.1f "
+           "libraries_inflight=%u pipelines_inflight=%u bytes=%zu "
+           "tid=%llu wall_ms=%lld queue_ms=%.1f\n",
+           kind, how, phases->lower_ns / 1e6, phases->nir_ns / 1e6,
+           phases->msl_ns / 1e6, build->wait_ns / 1e6, build->ns / 1e6,
+           build->libraries_inflight, build->pipelines_inflight,
+           build->data->code ? strlen(build->data->code) : 0,
+           (unsigned long long)kk_thread_id(),
+           (long long)(wall.tv_sec * INT64_C(1000) + wall.tv_nsec / 1000000),
+           queue_ns / 1e6);
+}
+
+/* Playport (PLA-437): the build of a Metal library for a vertex or fragment
+ * shader compiled on its own, queued in the device's kk_gpl_library_queue.
+ * vkCreateGraphicsPipelines makes the MSL (4-14 ms on the phone) and queues
+ * the Metal library (0.2-1 s each, 600 at a Portal 2 chapter load, most of
+ * which its draws never use), so that the application's compile threads do
+ * not wait for it, nor its draws behind it. */
+enum kk_gpl_library_state {
+   KK_GPL_LIBRARY_QUEUED,
+   KK_GPL_LIBRARY_BUILDING,
+   KK_GPL_LIBRARY_BUILT,
+   KK_GPL_LIBRARY_FAILED,
+   /* Its source went while it was queued or building, or the device while
+    * it was queued: never built, or its library released at once */
+   KK_GPL_LIBRARY_DROPPED,
+};
+
+struct kk_gpl_library_job {
+   /* In the queue's jobs while KK_GPL_LIBRARY_QUEUED */
+   struct list_head link;
+   /* Its source's reference (struct kk_gpl_source::vertex_job or
+    * fragment_job), and the queue's while queued or building */
+   int32_t refs;
+   struct kk_device *dev;
+   /* enum kk_gpl_library_state, set under the queue's lock and read without
+    * it; library is set before it becomes KK_GPL_LIBRARY_BUILT */
+   uint32_t state;
+   mtl_library *library;
+   bool vertex;
+   /* A copy of the shader's MSL, packed as the shader's is (or not, if
+    * packing failed), so that the job does not depend on the shader */
+   struct msl_compile_data msl;
+   /* For [kk-compile]: when the shader's build began and when it was queued,
+    * and the phases before */
+   int64_t start, queued;
+   struct kk_gpl_phases phases;
+};
+
+struct kk_gpl_library_queue {
+   mtx_t lock;
+   cnd_t cond;
+   /* Oldest first; a link that needs one moves it to the front
+    * (kk_gpl_library_blocker) */
+   struct list_head jobs;
+   /* One thread builds them one at a time, at utility QoS on Apple systems:
+    * the phone's Metal compiler service runs about two builds at a time, and
+    * this leaves the other to the builds that draws wait for. Started with
+    * the first job. */
+   thrd_t thread;
+   bool started, stop;
+   /* For MESA_KK_DEBUG=compile: jobs queued, built, failed, dropped, and
+    * moved to the front */
+   uint32_t queued, built, failed, dropped, promoted;
+};
+
+VkResult
+kk_gpl_library_queue_init(struct kk_device *dev)
+{
+   struct kk_gpl_library_queue *q = calloc(1, sizeof(*q));
+   if (q == NULL)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   if (mtx_init(&q->lock, mtx_plain) != thrd_success) {
+      free(q);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   if (cnd_init(&q->cond) != thrd_success) {
+      mtx_destroy(&q->lock);
+      free(q);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   list_inithead(&q->jobs);
+   dev->gpl_library_queue = q;
+   return VK_SUCCESS;
+}
+
+static void
+kk_gpl_library_job_unref(struct kk_gpl_library_job *job)
+{
+   if (!p_atomic_dec_zero(&job->refs))
+      return;
+   if (job->library) {
+      mtl_release(job->library);
+      p_atomic_dec(&kk_gpl_memory_stats(job->dev)->libraries);
+   }
+   free(job->msl.packed);
+   ralloc_free(job->msl.code);
+   free(job);
+}
+
+/* Builds job's Metal library, on the queue's thread (or the calling one, if
+ * the thread could not start) */
+static mtl_library *
+kk_gpl_library_job_build(struct kk_gpl_library_job *job)
+{
+   const int64_t queue_ns = os_time_get_nano() - job->queued;
+   char *code = kk_msl_data_code_dup(&job->msl);
+   const struct msl_compile_data data = {.code = code};
+   struct kk_library_build build = {
+      .device = job->dev,
+      .data = &data,
+      .kind = "gpl",
+      .step = job->vertex ? "vertex-library" : "fragment-library",
+      .src = KK_SRC_TRANSLATED,
+   };
+   if (code)
+      kk_build_library(&build);
+   if (KK_DEBUG(COMPILE))
+      kk_gpl_log_library(job->vertex ? "vertex" : "fragment",
+                         build.library ? "built" : "FAIL", job->start, &build,
+                         &job->phases, queue_ns);
+   ralloc_free(code);
+   return build.library;
+}
+
+/* Under the queue's lock: the end of job's build. Returns the library if
+ * nothing keeps it (job was dropped meanwhile), for the caller to release
+ * outside the lock. */
+static mtl_library *
+kk_gpl_library_job_done(struct kk_gpl_library_queue *q,
+                        struct kk_gpl_library_job *job, mtl_library *library)
+{
+   if (job->state == KK_GPL_LIBRARY_DROPPED)
+      return library;
+   if (library) {
+      job->library = library;
+      p_atomic_inc(&kk_gpl_memory_stats(job->dev)->libraries);
+      q->built++;
+      p_atomic_set(&job->state, KK_GPL_LIBRARY_BUILT);
+   } else {
+      q->failed++;
+      p_atomic_set(&job->state, KK_GPL_LIBRARY_FAILED);
+   }
+   return NULL;
+}
+
+static int
+kk_gpl_library_worker(void *data)
+{
+   struct kk_device *dev = data;
+   struct kk_gpl_library_queue *q = dev->gpl_library_queue;
+   u_thread_setname("kk-gpl-library");
+#ifdef __APPLE__
+   pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+#endif
+   mtx_lock(&q->lock);
+   while (true) {
+      while (!q->stop && list_is_empty(&q->jobs))
+         cnd_wait(&q->cond, &q->lock);
+      if (q->stop)
+         break;
+      struct kk_gpl_library_job *job =
+         list_first_entry(&q->jobs, struct kk_gpl_library_job, link);
+      list_del(&job->link);
+      p_atomic_set(&job->state, KK_GPL_LIBRARY_BUILDING);
+      mtx_unlock(&q->lock);
+
+      mtl_library *library = kk_gpl_library_job_build(job);
+
+      mtx_lock(&q->lock);
+      mtl_library *unused = kk_gpl_library_job_done(q, job, library);
+      mtx_unlock(&q->lock);
+      if (unused)
+         mtl_release(unused);
+      kk_gpl_library_job_unref(job);
+      mtx_lock(&q->lock);
+   }
+   mtx_unlock(&q->lock);
+   return 0;
+}
+
+/* Queues the Metal library of a vertex or fragment shader compiled on its
+ * own (as kk_gpl_build_library would build it) into src, which keeps the
+ * shader with its MSL packed, and the job. */
+static void
+kk_gpl_queue_library(struct kk_device *dev, struct kk_gpl_source *src,
+                     struct kk_shader *shader, int64_t start,
+                     const struct kk_gpl_front_end *front_end)
+{
+   struct kk_gpl_library_queue *q = dev->gpl_library_queue;
+   const bool vertex = shader->info.stage == MESA_SHADER_VERTEX;
+   const struct kk_gpl_phases phases =
+      kk_gpl_phases_of(shader, start, front_end);
+   /* Links copy the MSL out again (kk_msl_data_code_dup) */
+   kk_shader_pack_msl(shader);
+   const struct msl_compile_data *data = &shader->msl_data[shader->info.stage];
+
+   struct kk_gpl_library_job *job = calloc(1, sizeof(*job));
+   if (job && data->packed) {
+      job->msl.packed = malloc(data->packed_size);
+      if (job->msl.packed) {
+         memcpy(job->msl.packed, data->packed, data->packed_size);
+         job->msl.packed_size = data->packed_size;
+         job->msl.code_size = data->code_size;
+      }
