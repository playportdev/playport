+   const uint32_t first = f->part_first;
+   keep_parts(f);
+
+   struct kk_fault_commit *c = new_commit(cmd, callback, user_data);
+   if (!c)
+      return NULL;
+   c->begin = c->first = first;
+   c->part = c->parts = parts ? parts + 1u : 0u;
+   c->last = true;
