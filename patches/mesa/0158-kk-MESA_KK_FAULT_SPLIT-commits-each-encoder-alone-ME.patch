+void
+kk_fault_split(struct kk_cmd_buffer *cmd)
+{
+   struct kk_fault_cmd *f = &cmd->fault;
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   if (!f->serial || !dev->fault.split)
+      return;
+   if (f->part_encoders < dev->fault.split) {
+      f->part_encoders++;
+      return;
+   }
+   mtl_command_buffer *next =
+      util_dynarray_num_elements(&f->spare, mtl_command_buffer *)
+         ? util_dynarray_pop(&f->spare, mtl_command_buffer *)
+         : kk_cmd_pool_get_cmd_buf(kk_cmd_buffer_pool(cmd));
+   if (!next) {
+      /* No other Metal command buffer: this one takes the encoder too */
+      f->part_encoders++;
+      return;
+   }
+   mtl_end_command_buffer(cmd->metal.cmd_buf);
+   const struct kk_fault_part part = {
+      .cb = cmd->metal.cmd_buf,
+      .first = f->part_first,
+      .count = f->part_encoders,
+   };
+   util_dynarray_append(&f->parts, part);
+   mtl_begin_command_buffer(next, cmd->metal.allocator);
+   cmd->metal.cmd_buf = next;
+   f->part_first += f->part_encoders;
+   f->part_encoders = 1u;
+}
+
+void
+kk_fault_end_draw(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->fault.serial || !kk_cmd_buffer_device(cmd)->fault.split_draws ||
+       !cmd->metal.render)
+      return;
+   /* As a compute encoder inside a pass ends it (cs_get_compute) */
+   kk_apply_attachment_store_ops(cmd, true);
+   cs_end(cmd);
+   kk_cmd_buffer_dirty_all_gfx(cmd);
+   cmd->state.gfx.need_to_start_render_pass = true;
+}
