+/* MESA_KK_FAULT_SPLIT=N (encoders a Metal command buffer holds) or draw
+ * (each draw its own render encoder, each encoder alone); what the [kk-fault]
+ * on: line says of it */
+static void
+parse_split(struct kk_fault_device *f, char *out, size_t size)
+{
+   const char *s = getenv("MESA_KK_FAULT_SPLIT");
+   out[0] = '\0';
+   if (!s || !*s)
+      return;
+   char *end;
+   const unsigned long n = strtoul(s, &end, 10);
+   if (!strcmp(s, "draw")) {
+      f->split = 1u;
+      f->split_draws = true;
+      snprintf(out, size, "; Metal command buffers: one per draw");
+   } else if (*end == '\0' && n >= 1u && n <= KK_FAULT_MAX_ENCODERS) {
+      f->split = n;
+      if (n == 1u)
+         snprintf(out, size, "; Metal command buffers: one per encoder");
+      else
+         snprintf(out, size, "; Metal command buffers: one per %lu encoders", n);
+   } else {
+      snprintf(out, size, "; MESA_KK_FAULT_SPLIT=%.16s ignored", s);
+   }
+}
