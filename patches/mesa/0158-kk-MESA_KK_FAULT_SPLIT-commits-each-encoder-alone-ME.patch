+/* MESA_KK_FAULT_SKIP's pass kinds and render areas */
+static bool
+skipped_pass(const struct kk_device *dev, const struct kk_fault_encoder *e,
+             uint32_t instances)
+{
+   const uint8_t kinds = dev->fault.skip_kinds;
+   if (((kinds & KK_FAULT_SKIP_LAYERED) && e->layers > 1u) ||
+       ((kinds & KK_FAULT_SKIP_INSTANCED) && instances > 1u))
+      return true;
+   for (uint32_t i = 0; i < dev->fault.skip_area_count; i++) {
+      if (e->area_w == dev->fault.skip_areas[i].w &&
+          e->area_h == dev->fault.skip_areas[i].h)
+         return true;
+   }
+   return false;
+}
