+struct kk_fault_commit *
+kk_fault_commit_new(struct kk_cmd_buffer *cmd, mtl_command_queue *queue,
+                    mtl_feedback_handler_callback part_callback,
+                    void *part_data, mtl_feedback_handler_callback callback,
+                    void *user_data)
+{
+   struct kk_fault_cmd *f = &cmd->fault;
+   if (!f->serial)
+      return NULL;
+   /* MESA_KK_FAULT_SPLIT: the parts before metal.cmd_buf, each alone with a
+    * copy of its encoders' trail */
+   const uint32_t parts =
+      util_dynarray_num_elements(&f->parts, struct kk_fault_part);
+   const uint32_t recorded =
+      util_dynarray_num_elements(&f->trail, struct kk_fault_encoder);
+   const struct kk_fault_encoder *trail = util_dynarray_begin(&f->trail);
+   uint32_t part_index = 0u;
+   util_dynarray_foreach(&f->parts, struct kk_fault_part, part) {
+      struct kk_fault_commit *pc = new_commit(cmd, part_callback, part_data);
+      mtl_commit_options *options = mtl_new_commit_options();
+      part_index++;
+      if (pc) {
+         pc->first = part->first;
+         pc->part = part_index;
+         pc->parts = parts + 1u;
+         if (part->first < recorded) {
+            const uint32_t n = MIN2(part->count, recorded - part->first);
+            void *copy = util_dynarray_grow(&pc->trail, struct kk_fault_encoder, n);
+            if (copy)
+               memcpy(copy, trail + part->first, n * sizeof(*trail));
+         }
+         mtl_commit_options_add_feedback_handler(options, kk_fault_feedback, pc);
+      } else {
+         mtl_commit_options_add_feedback_handler(options, part_callback, part_data);
+      }
+      mtl_command_queue_commit(queue, &part->cb, 1u, options);
+      mtl_release(options);
