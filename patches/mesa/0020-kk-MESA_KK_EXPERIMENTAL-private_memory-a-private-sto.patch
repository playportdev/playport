 }
 
+void
+mtl_heap_private_buffer_size_and_align_with_length(mtl_device *device,
+                                                   uint64_t *size_B,
+                                                   uint64_t *align_B)
+{
+   @autoreleasepool {
+      id<MTLDevice> dev = (id<MTLDevice>)device;
+      MTLResourceOptions options = MTLResourceStorageModePrivate |
+                                   MTLResourceCPUCacheModeDefaultCache |
+                                   MTLResourceHazardTrackingModeUntracked;
+      MTLSizeAndAlign size_align = [dev heapBufferSizeAndAlignWithLength:*size_B options:options];
+      *size_B = size_align.size;
+      *align_B = size_align.align;
+   }
+}
