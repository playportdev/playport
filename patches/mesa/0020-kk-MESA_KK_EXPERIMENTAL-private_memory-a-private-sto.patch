+static VkResult
+kk_alloc_bo_storage(struct kk_device *dev, struct vk_object_base *log_obj,
+                    uint64_t size_B, uint64_t align_B, bool private_storage,
+                    struct kk_bo **bo_out)
 {
    VkResult result = VK_SUCCESS;
 
@@ -54,17 +55,24 @@ kk_alloc_bo(struct kk_device *dev, struct vk_object_base *log_obj,
