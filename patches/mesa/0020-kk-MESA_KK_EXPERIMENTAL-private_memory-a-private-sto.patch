+      };
+   }
+
+   pdev->host_visible_mem_types |= BITFIELD_BIT(pdev->mem_type_count);
    pdev->mem_types[pdev->mem_type_count++] = (VkMemoryType){
       .propertyFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
                        VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
