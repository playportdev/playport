+/* Whether the image may be bound to private memory (a memory type that is
+ * not host visible): a Metal texture placed in a heap, which nothing reads or
+ * writes with the CPU. Linear images are buffer-backed textures, host image
+ * copies write with the CPU, and external and sparse images keep the memory
+ * they always had. */
+static bool
+kk_image_may_be_private(const struct kk_image *image)
+{
+   return KK_EXPERIMENTAL(PRIVATE_MEMORY) &&
+          image->vk.tiling == VK_IMAGE_TILING_OPTIMAL &&
+          !(image->vk.usage & VK_IMAGE_USAGE_HOST_TRANSFER_BIT_EXT) &&
+          !(image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT) &&
+          image->vk.external_handle_types == 0;
+}
+
 static void
 kk_image_plane_size_align_B(struct kk_device *dev, const struct kk_image *image,
                             const struct kk_image_plane *plane,
@@ -607,6 +622,19 @@ kk_image_plane_size_align_B(struct kk_device *dev, const struct kk_image *image,
 {
    *size_B_out = plane->layout.size_B;
    *align_B_out = plane->layout.align_B;
+
+   /* Metal may need more room or alignment for the texture in a private heap
+    * (lossless compression keeps metadata beside it). Requirements and binds
+    * both come here, so the larger of the two fits either heap. */
+   if (kk_image_may_be_private(image)) {
+      uint64_t private_size_B, private_align_B;
+      struct kk_image_layout layout = plane->layout;
+      mtl_heap_private_texture_size_and_align(dev->mtl_handle, &layout,
+                                              &private_size_B,
+                                              &private_align_B);
+      *size_B_out = MAX2(*size_B_out, private_size_B);
+      *align_B_out = MAX2(*align_B_out, private_align_B);
+   }
 }
 
 static void
@@ -709,6 +737,9 @@ kk_get_image_memory_requirements(struct kk_device *dev, struct kk_image *image,
       }
    }
 
+   if (!kk_image_may_be_private(image))
+      memory_types &= pdev->host_visible_mem_types;
+
    // TODO hope for the best?
 
    uint64_t size_B = 0;
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
