@@ -103,7 +128,8 @@ kk_destroy_bo(struct kk_device *dev, struct kk_bo *bo)
    else
       kk_device_remove_buffer_from_residency_set(dev, bo->map);
 
-   mtl_release(bo->map);
+   if (bo->map)
+      mtl_release(bo->map);
 
    if (bo->mtl_handle)
