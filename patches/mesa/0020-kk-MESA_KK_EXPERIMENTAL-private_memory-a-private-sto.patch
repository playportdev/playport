+   /* Memory nothing maps is a private-storage Metal heap. The type comes
+    * first: the spec orders a type whose flags are a subset of another's
+    * before it, and DXVK, vkd3d-proton and the WSI take the first type that
+    * fits, so what they do not map lands here. */
+   if (KK_EXPERIMENTAL(PRIVATE_MEMORY)) {
+      pdev->mem_types[pdev->mem_type_count++] = (VkMemoryType){
+         .propertyFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT,
