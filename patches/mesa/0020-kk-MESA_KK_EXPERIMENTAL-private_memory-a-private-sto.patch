+   mtl_heap *handle = mtl_new_heap(dev->mtl_handle, size_B, options);
    if (handle == NULL) {
       result = vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY, "%m");
       goto fail_heap;
    }
 
-   mtl_buffer *map = mtl_new_buffer_with_length(handle, size_B, 0u);
-   if (map == NULL) {
-      result = vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY, "%m");
-      goto fail_map;
+   mtl_buffer *map = NULL;
+   if (!private_storage) {
+      map = mtl_new_buffer_with_length(handle, size_B, 0u);
+      if (map == NULL) {
+         result = vk_errorf(log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY, "%m");
+         goto fail_map;
+      }
    }
 
    struct kk_bo *bo = CALLOC_STRUCT(kk_bo);
@@ -77,8 +85,10 @@ kk_alloc_bo(struct kk_device *dev, struct vk_object_base *log_obj,
    bo->mtl_handle = handle;
    bo->size_B = size_B;
    bo->map = map;
-   bo->gpu = mtl_buffer_get_gpu_address(map);
-   bo->cpu = mtl_get_contents(map);
+   if (map) {
+      bo->gpu = mtl_buffer_get_gpu_address(map);
+      bo->cpu = mtl_get_contents(map);
+   }
 
    kk_device_add_heap_to_residency_set(dev, handle);
 
@@ -86,13 +96,28 @@ kk_alloc_bo(struct kk_device *dev, struct vk_object_base *log_obj,
    return result;
 
 fail_alloc:
-   mtl_release(map);
+   if (map)
+      mtl_release(map);
 fail_map:
    mtl_release(handle);
 fail_heap:
    return result;
 }
 
+VkResult
+kk_alloc_bo(struct kk_device *dev, struct vk_object_base *log_obj,
+            uint64_t size_B, uint64_t align_B, struct kk_bo **bo_out)
+{
+   return kk_alloc_bo_storage(dev, log_obj, size_B, align_B, false, bo_out);
+}
+
+VkResult
+kk_alloc_private_bo(struct kk_device *dev, struct vk_object_base *log_obj,
+                    uint64_t size_B, uint64_t align_B, struct kk_bo **bo_out)
+{
+   return kk_alloc_bo_storage(dev, log_obj, size_B, align_B, true, bo_out);
+}
+
 void
 kk_destroy_bo(struct kk_device *dev, struct kk_bo *bo)
