--- a/src/kosmickrisp/bridge/mtl_device.m
+++ b/src/kosmickrisp/bridge/mtl_device.m
@@ -264,6 +264,22 @@ mtl_heap_buffer_size_and_align_with_length(mtl_device *device, uint64_t *size_B,
