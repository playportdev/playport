+   if (nir->info.inputs_read & clip_cull)
+      return "fragment-clip-input";
+   if ((nir->info.inputs_read & VARYING_BIT_PRIMITIVE_ID) ||
+       BITSET_TEST(nir->info.system_values_read, SYSTEM_VALUE_PRIMITIVE_ID))
+      return "fragment-primitive-id";
