+ * a float to a float or normalized format, an integer of the format's
+ * signedness otherwise. */
+static bool
+kk_gpl_output_type_fits(enum pipe_format format, nir_alu_type type)
+{
+   nir_alu_type base = nir_alu_type_get_base_type(type);
+   if (util_format_is_pure_sint(format))
+      return base == nir_type_int;
+   if (util_format_is_pure_uint(format))
+      return base == nir_type_uint;
+   return base == nir_type_float;
