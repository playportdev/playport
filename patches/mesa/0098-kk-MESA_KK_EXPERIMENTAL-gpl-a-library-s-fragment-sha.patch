+const struct kk_gpl_source *
+kk_gpl_empty_fragment(struct kk_device *dev)
+{
+   struct kk_gpl_cache *cache = dev->gpl_cache;
+   if (!cache)
+      return NULL;
+   simple_mtx_lock(&cache->empty_lock);
+   if (!cache->empty_compiled) {
+      kk_gpl_compile_empty_fragment(dev, &cache->empty);
+      cache->empty_compiled = true;
+   }
+   simple_mtx_unlock(&cache->empty_lock);
+   return &cache->empty;
+}
