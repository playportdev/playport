From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Wed, 28 Oct 2026 19:56:03 +0100
Subject: [PATCH] kk: size a depth or stencil copy's staging buffer by its
 aspect

vkCmdCopyImage2 between images Metal cannot blit (different formats or
sample counts) goes image -> buffer -> image. copy_through_buffer writes
the copied aspect's own format (the depth alone of a depth/stencil
image, or S8), but kk_CmdCopyImage2 sized the buffer from the plane's
whole format. The Witcher 3 copies the depth of its 1300x600
D32_SFLOAT_S8_UINT target into an R32_SFLOAT image every frame: it
allocated 6,240,000 bytes (8 a texel) and used 3,120,000, an 8 MiB
command BO in place of a 4 MiB one. A stencil aspect used 1/8 of it.

Take the aspect's format in one helper and size the buffer with it.
The copy itself is unchanged: Metal has no colour view of a depth
texture, so a depth/stencil-to-colour copy stays on the buffer path.

Linear: PLA-463
Class: upstream-bug
Evidence: docs/evidence/2026-10-28-kk-depth-copy-staging-size.md
Offered-upstream: no
---
 src/kosmickrisp/vulkan/kk_cmd_copy.c | 52 ++++++++++++++++------------
 1 file changed, 29 insertions(+), 23 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_copy.c b/src/kosmickrisp/vulkan/kk_cmd_copy.c
index 67bb33f..c5e64f4 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_copy.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_copy.c
@@ -143,6 +143,24 @@ kk_CmdCopyImageToBuffer2(VkCommandBuffer commandBuffer,
    }
 }
 
+/* The format of one aspect of a plane as a texture<->buffer copy reads or
+ * writes it: the depth or stencil alone of a depth/stencil format. */
+static enum pipe_format
+copy_aspect_format(const struct kk_image_plane *plane,
+                   VkImageAspectFlags aspect, enum mtl_blit_options *options)
+{
+   enum pipe_format format = plane->layout.format.pipe;
+   *options = MTL_BLIT_OPTION_NONE;
+   if (aspect == VK_IMAGE_ASPECT_DEPTH_BIT) {
+      format = util_format_get_depth_only(format);
+      *options = MTL_BLIT_OPTION_DEPTH_FROM_DEPTH_STENCIL;
+   } else if (aspect == VK_IMAGE_ASPECT_STENCIL_BIT) {
+      format = PIPE_FORMAT_S8_UINT;
+      *options = MTL_BLIT_OPTION_STENCIL_FROM_DEPTH_STENCIL;
+   }
+   return format;
+}
+
 /* Copies images by doing a texture->buffer->texture transfer. Returns the new
  * buffer offset for subsequent copies. */
 static size_t
@@ -155,27 +173,11 @@ copy_through_buffer(struct kk_cmd_buffer *cmd, struct kk_image *src,
    struct kk_image_plane *dst_plane = &dst->planes[dst_index];
 
    /* Handle depth/stencil for copies to/from compatible color formats */
-   enum pipe_format src_format = src_plane->layout.format.pipe;
-   enum mtl_blit_options src_options = MTL_BLIT_OPTION_NONE;
-   if (region->srcSubresource.aspectMask == VK_IMAGE_ASPECT_DEPTH_BIT) {
-      src_format = util_format_get_depth_only(src_format);
-      src_options = MTL_BLIT_OPTION_DEPTH_FROM_DEPTH_STENCIL;
-   } else if (region->srcSubresource.aspectMask ==
-              VK_IMAGE_ASPECT_STENCIL_BIT) {
-      src_format = PIPE_FORMAT_S8_UINT;
-      src_options = MTL_BLIT_OPTION_STENCIL_FROM_DEPTH_STENCIL;
-   }
-
-   enum pipe_format dst_format = dst_plane->layout.format.pipe;
-   enum mtl_blit_options dst_options = MTL_BLIT_OPTION_NONE;
-   if (region->dstSubresource.aspectMask == VK_IMAGE_ASPECT_DEPTH_BIT) {
-      dst_format = util_format_get_depth_only(dst_format);
-      dst_options = MTL_BLIT_OPTION_DEPTH_FROM_DEPTH_STENCIL;
-   } else if (region->dstSubresource.aspectMask ==
-              VK_IMAGE_ASPECT_STENCIL_BIT) {
-      dst_format = PIPE_FORMAT_S8_UINT;
-      dst_options = MTL_BLIT_OPTION_STENCIL_FROM_DEPTH_STENCIL;
-   }
+   enum mtl_blit_options src_options, dst_options;
+   enum pipe_format src_format = copy_aspect_format(
+      src_plane, region->srcSubresource.aspectMask, &src_options);
+   enum pipe_format dst_format = copy_aspect_format(
+      dst_plane, region->dstSubresource.aspectMask, &dst_options);
 
    bool is_src_compressed = util_format_is_compressed(src_format);
    bool is_dst_compressed = util_format_is_compressed(dst_format);
@@ -371,8 +373,12 @@ kk_CmdCopyImage2(VkCommandBuffer commandBuffer,
       if (can_do_image_to_image_copy(src, src_index, dst, dst_index))
          copy_image(cmd, src, src_index, dst, dst_index, region);
       else {
-         struct kk_image_plane *src_plane = &src->planes[src_index];
-         enum pipe_format src_format = src_plane->layout.format.pipe;
+         /* Size the buffer in the format copy_through_buffer writes it: a
+          * depth aspect of Z32_FLOAT_S8X24_UINT is 4 bytes a texel, not 8. */
+         enum mtl_blit_options options;
+         enum pipe_format src_format =
+            copy_aspect_format(&src->planes[src_index],
+                               region->srcSubresource.aspectMask, &options);
          const uint32_t buffer_stride_B =
             util_format_get_stride(src_format, region->extent.width);
          const uint32_t buffer_size_2d_B = util_format_get_2d_size(
