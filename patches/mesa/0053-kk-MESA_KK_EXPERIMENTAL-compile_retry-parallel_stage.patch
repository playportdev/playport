-/* MSL to a Metal library; *ns receives the time it took. */
-static mtl_library *
-kk_build_library(struct kk_device *device, const struct msl_compile_data *data,
-                 int64_t *ns, struct mtl_build_error *error)
+/* MESA_KK_EXPERIMENTAL=compile_retry: a library or pipeline build that failed
+ * because Metal's compiler service connection was interrupted is built again,
+ * at most KK_COMPILE_RETRIES times, KK_COMPILE_RETRY_WAIT_MS after each
+ * failure. Metal has already retried such a build itself by then ("This
+ * error occurred after multiple retries"). */
+#define KK_COMPILE_RETRIES 2u
+#define KK_COMPILE_RETRY_WAIT_MS 200u
+
+/* Whether a failed build step is built again; if so, logs the retry and
+ * waits. *retries counts the step's retries so far; start is when the failed
+ * attempt began. */
+static bool
+kk_retry_build(const char *kind, const char *step, const char *src,
+               uint32_t *retries, const struct mtl_build_error *error,
+               int64_t start)
+{
+   if (!KK_EXPERIMENTAL(COMPILE_RETRY) || !error->compiler_interrupted ||
+       *retries >= KK_COMPILE_RETRIES)
+      return false;
+
+   (*retries)++;
+   fprintf(stderr,
+           "[kk-compile] %s retry %u/%u step=%s after_ms=%.1f err=%s:%lld "
+           "src=%s tid=%llu\n",
+           kind, *retries, KK_COMPILE_RETRIES, step,
+           (os_time_get_nano() - start) / 1e6, error->domain,
+           (long long)error->code, src, (unsigned long long)kk_thread_id());
+   os_time_sleep(KK_COMPILE_RETRY_WAIT_MS * 1000);
+   return true;
+}
+
+/* One MSL library build: what to build, and how it went. */
+struct kk_library_build {
+   struct kk_device *device;
+   const struct msl_compile_data *data;
+   const char *kind, *step, *src;
+   mtl_library *library;
+   int64_t ns; /* retries included */
+   uint32_t retries;
+   struct mtl_build_error error;
+};
+
+static void
+kk_build_library(struct kk_library_build *build)
 {
-   struct kk_physical_device *pdev = kk_device_physical(device);
+   struct kk_physical_device *pdev = kk_device_physical(build->device);
    const int64_t start = os_time_get_nano();
-   memset(error, 0, sizeof(*error));
-   mtl_library *library = mtl_new_library(
-      device->mtl_compiler_handle, data->code, pdev->info.msl_version,
-      MTL_MATH_MODE_FAST, MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST, error);
-   *ns = os_time_get_nano() - start;
-   return library;
+   int64_t attempt_start;
+   do {
+      attempt_start = os_time_get_nano();
+      memset(&build->error, 0, sizeof(build->error));
+      build->library = mtl_new_library(
+         build->device->mtl_compiler_handle, build->data->code,
+         pdev->info.msl_version, MTL_MATH_MODE_FAST,
+         MTL_MATH_FLOATING_POINT_FUNCTIONS_FAST,
+         KK_EXPERIMENTAL(LIBRARY_SIZE_OPT), &build->error);
+   } while (build->library == NULL &&
+            kk_retry_build(build->kind, build->step, build->src,
+                           &build->retries, &build->error, attempt_start));
+   build->ns = os_time_get_nano() - start;
+}
+
+static int
+kk_build_library_thread(void *build)
+{
+   kk_build_library(build);
+   return 0;
 }
 
