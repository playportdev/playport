+/* The known-fail list: an MSL whose Metal build failed with Metal's compiler
+ * service interrupted KK_KNOWN_FAIL_INTERRUPTS times is not built again; its
+ * build fails at once, as the failed builds did (VK_ERROR_INVALID_SHADER_NV),
+ * logging "[kk-compile] skip known-fail". iOS ends MTLCompilerService at its
+ * 150 MB memory limit, and Red Dead Redemption 2 asked for the same few
+ * pipelines again and again, each failing after 34 to 47 s (PLA-364).
+ *
+ * Each such failure appends the full MSL hash as a line to
+ * MESA_SHADER_CACHE_DIR/kk-known-fail-UUID.txt, UUID the device's
+ * pipelineCacheUUID (the driver build, GPU and MSL version), so the list
+ * lasts across launches until Mesa or the MSL changes; files of other UUIDs
+ * are deleted, and clearing the shader cache clears the list. Without
+ * MESA_SHADER_CACHE_DIR it lasts for the process. MESA_KK_DEBUG=no_known_fail
+ * turns it off. */
+#define KK_KNOWN_FAIL_INTERRUPTS 2u
+
+static simple_mtx_t kk_known_fail_lock = SIMPLE_MTX_INITIALIZER;
+/* Full MSL hash -> interrupted failures, NULL until loaded */
+static struct hash_table *kk_known_fail;
+/* The list's file, empty when there is none */
+static char kk_known_fail_path[PATH_MAX];
+
+static void
+kk_known_fail_count(const char *hex)
+{
+   struct hash_entry *entry = _mesa_hash_table_search(kk_known_fail, hex);
+   if (entry)
+      entry->data = (void *)((uintptr_t)entry->data + 1u);
+   else
+      _mesa_hash_table_insert(kk_known_fail, ralloc_strdup(kk_known_fail, hex),
+                              (void *)(uintptr_t)1u);
+}
+
+/* Reads the list once. Takes kk_known_fail_lock. */
+static void
+kk_known_fail_load(const uint8_t *cache_uuid)
+{
+   if (kk_known_fail)
+      return;
+   kk_known_fail = _mesa_hash_table_create(NULL, _mesa_hash_string,
+                                           _mesa_key_string_equal);
+   const char *dir = getenv("MESA_SHADER_CACHE_DIR");
+   if (dir == NULL || dir[0] == 0)
+      return;
+
+   char name[64] = "kk-known-fail-";
+   for (unsigned i = 0; i < VK_UUID_SIZE; i++)
+      snprintf(name + strlen(name), 3, "%02x", cache_uuid[i]);
+   strcat(name, ".txt");
+   if (snprintf(kk_known_fail_path, sizeof(kk_known_fail_path), "%s/%s", dir,
+                name) >= (int)sizeof(kk_known_fail_path)) {
+      kk_known_fail_path[0] = 0;
+      return;
+   }
+
+   DIR *d = opendir(dir);
+   if (d) {
+      for (struct dirent *e; (e = readdir(d));) {
+         if (strncmp(e->d_name, "kk-known-fail-", 14) == 0 &&
+             strcmp(e->d_name, name) != 0)
+            unlinkat(dirfd(d), e->d_name, 0);
+      }
+      closedir(d);
+   }
+
+   FILE *f = fopen(kk_known_fail_path, "r");
+   if (f == NULL)
+      return;
+   char line[BLAKE3_HEX_LEN + 2];
+   unsigned known = 0;
+   while (fgets(line, sizeof(line), f)) {
+      line[strcspn(line, "\n")] = 0;
+      if (strlen(line) != BLAKE3_HEX_LEN - 1)
+         continue;
+      kk_known_fail_count(line);
+      struct hash_entry *entry = _mesa_hash_table_search(kk_known_fail, line);
+      known += (uintptr_t)entry->data == KK_KNOWN_FAIL_INTERRUPTS;
+   }
+   fclose(f);
+   fprintf(stderr, "[kk-compile] known-fail list %s: %u MSL skipped\n",
+           kk_known_fail_path, known);
+}
+
+/* Whether the build's MSL is on the known-fail list; logs the skip. */
+static bool
+kk_known_fail_skip(const struct kk_metal_build *build)
+{
+   if (KK_DEBUG(NO_KNOWN_FAIL))
+      return false;
+   simple_mtx_lock(&kk_known_fail_lock);
+   kk_known_fail_load(build->cache_uuid);
+   struct hash_entry *entry = _mesa_hash_table_search(kk_known_fail,
+                                                      build->msl);
+   const uintptr_t failures = entry ? (uintptr_t)entry->data : 0u;
+   simple_mtx_unlock(&kk_known_fail_lock);
+   if (failures < KK_KNOWN_FAIL_INTERRUPTS)
+      return false;
+   fprintf(stderr,
+           "[kk-compile] skip known-fail %s msl=%.16s interrupted=%u src=%s "
+           "tid=%llu\n",
+           build->kind, build->msl, (unsigned)failures, build->src,
+           (unsigned long long)kk_thread_id());
+   return true;
+}
+
+/* Counts a build that failed with the compiler service interrupted. */
+static void
+kk_known_fail_record(const struct kk_metal_build *build)
+{
+   if (KK_DEBUG(NO_KNOWN_FAIL) || build->failed_step == NULL ||
+       !build->error.compiler_interrupted)
+      return;
+   simple_mtx_lock(&kk_known_fail_lock);
+   kk_known_fail_load(build->cache_uuid);
+   kk_known_fail_count(build->msl);
+   const uintptr_t failures =
+      (uintptr_t)_mesa_hash_table_search(kk_known_fail, build->msl)->data;
+   FILE *f = kk_known_fail_path[0] ? fopen(kk_known_fail_path, "a") : NULL;
+   if (f) {
+      fprintf(f, "%s\n", build->msl);
+      fclose(f);
+   }
+   simple_mtx_unlock(&kk_known_fail_lock);
+   if (failures == KK_KNOWN_FAIL_INTERRUPTS)
+      fprintf(stderr,
+              "[kk-compile] known-fail %s msl=%.16s: interrupted %u times, "
+              "later builds of it fail at once%s\n",
+              build->kind, build->msl, (unsigned)failures,
+              f ? "" : " (in this process only)");
+}
+
