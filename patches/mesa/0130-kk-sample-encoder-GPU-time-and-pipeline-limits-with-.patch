 #include "mtl_render_state.h"
 
 #include "mtl_format.h"
+#include <Metal/MTL4RenderPass.h>
+#include <Metal/MTLTexture.h>
+
+void
+mtl_render_pass_profile_attachments(mtl_render_pass_descriptor *descriptor,
+                                    struct mtl_profile_attachments *info)
+{
+   @autoreleasepool {
+      MTL4RenderPassDescriptor *desc = (MTL4RenderPassDescriptor *)descriptor;
+      for (unsigned i = 0; i < 10; i++) {
+         MTLRenderPassAttachmentDescriptor *att = i < 8 ? desc.colorAttachments[i]
+            : i == 8 ? desc.depthAttachment : desc.stencilAttachment;
+         info->formats[i] = (uint32_t)att.texture.pixelFormat;
+         info->loads[i] = (uint32_t)att.loadAction;
+         info->stores[i] = (uint32_t)att.storeAction;
+      }
+   }
+}
 
