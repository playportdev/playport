@@ -250,6 +250,19 @@ mtl_new_timestamp_counter_heap(mtl_device *dev, uint32_t count)
    }
 }
 
+bool
+mtl_timestamp_counter_heap_read(mtl_counter_heap *heap, uint32_t count,
+                                 uint64_t *timestamps)
+{
+   @autoreleasepool {
+      NSData *data = [(id<MTL4CounterHeap>)heap resolveCounterRange:NSMakeRange(0, count)];
+      if (!data || data.length != count * sizeof(MTL4TimestampHeapEntry))
+         return false;
+      memcpy(timestamps, data.bytes, data.length);
+      return true;
+   }
+}
