@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef KK_PASS_PROF_H
+#define KK_PASS_PROF_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "kosmickrisp/bridge/mtl_types.h"
+
+struct kk_cmd_buffer;
+struct kk_device;
+struct kk_queue;
+struct kk_pass_prof;
+
+/* Queue-owned while recording a frame; each sampled commit holds another ref.
+ * Only the queue writes metadata. The last GPU completion resolves and logs it.
+ * No heap or replay outside two frames per 1200 presents, or during capture. */
+void kk_pass_prof_queue_init(struct kk_queue *queue);
+void kk_pass_prof_before_submit(struct kk_queue *queue);
+void kk_pass_prof_present(struct kk_queue *queue);
+void kk_pass_prof_queue_finish(struct kk_queue *queue);
+void kk_pass_prof_ref(struct kk_pass_prof *prof);
+void kk_pass_prof_unref(struct kk_pass_prof *prof, bool success);
+void kk_pass_prof_attach(struct kk_cmd_buffer *cmd, struct kk_pass_prof *prof);
+void kk_pass_prof_begin(struct kk_cmd_buffer *cmd, bool render);
+void kk_pass_prof_end(struct kk_cmd_buffer *cmd, bool render);
+void kk_pass_prof_pipeline(struct kk_cmd_buffer *cmd, void *pipeline);
+void kk_pass_prof_draw(struct kk_cmd_buffer *cmd);
+void kk_pass_prof_copy(struct kk_cmd_buffer *cmd);
+void kk_pass_prof_store(struct kk_cmd_buffer *cmd, unsigned index, unsigned action);
+void kk_pass_prof_log_pipeline(struct kk_device *dev, void *pipeline,
+                               bool render, const char *msl, uint32_t requested);
+
+#endif
