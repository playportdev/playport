@@ -105,6 +105,23 @@ mtl_new_library_function_descriptor(mtl_library *library, const char *entry_poin
    }
 }
 
+void
+mtl_pipeline_profile_limits(void *pipeline, bool render,
+                             uint64_t *max_threads, uint64_t *static_bytes)
+{
+   @autoreleasepool {
+      if (render) {
+         id<MTLRenderPipelineState> p = (id<MTLRenderPipelineState>)pipeline;
+         *max_threads = p.maxTotalThreadsPerThreadgroup;
+         *static_bytes = 0;
+      } else {
+         id<MTLComputePipelineState> p = (id<MTLComputePipelineState>)pipeline;
+         *max_threads = p.maxTotalThreadsPerThreadgroup;
+         *static_bytes = p.staticThreadgroupMemoryLength;
+      }
+   }
+}
+
