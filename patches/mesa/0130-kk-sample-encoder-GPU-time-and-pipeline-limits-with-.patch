diff --git a/src/kosmickrisp/vulkan/kk_pass_prof.c b/src/kosmickrisp/vulkan/kk_pass_prof.c
new file mode 100644
index 0000000..faae0c8
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_pass_prof.c
@@ -0,0 +1,323 @@
+/* SPDX-License-Identifier: MIT */
+/* Playport (PLA-466): encoder-boundary timestamps, not a register/spill counter.
+ * Sampling replays just the selected submissions so recording ahead, reusable
+ * and simultaneous-use Vulkan command buffers cannot overwrite a live sample.
+ * A frame is bounded to one heap (2048 encoders); overflow/failure discards the
+ * whole frame rather than reporting a plausible but incomplete GPU total. */
+#include "kk_pass_prof.h"
+#include "kk_cmd_buffer.h"
+#include "kk_device.h"
+#include "kk_physical_device.h"
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include "util/u_atomic.h"
+#include "util/u_debug.h"
+#include <inttypes.h>
+#include <errno.h>
+#include <unistd.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define PP_PASSES 2048u
+#define PP_PERIOD 1200u
+#define PP_FIRST 600u
+
+struct kk_profile_pass {
+   bool render, mixed, native_copy;
+   uint32_t cb, width, height, samples, draws;
+   void *pipeline;
+   struct mtl_profile_attachments attachments;
+};
+
+struct kk_pass_prof {
+   uint32_t refs, failed;
+   uint32_t report, present, count, cbs;
+   uint64_t frequency;
+   mtl_counter_heap *heap;
+   struct kk_profile_pass passes[PP_PASSES];
+};
+
+static uint32_t reports;
+
+static bool
+kk_pass_prof_timed(const struct kk_profile_pass *pass)
+{
+   /* Metal 4's in-encoder timestamps do not time native copies, even with
+    * precise sampling and dispatch/blit barriers (PLA-474). A mixed copy +
+    * dispatch encoder is conservatively unavailable too, not a partial cost. */
+   return pass->render || (pass->pipeline && !pass->native_copy);
+}
+
+void
+kk_pass_prof_queue_init(struct kk_queue *queue)
+{
+   const struct kk_physical_device *pdev =
+      kk_device_physical(kk_queue_device(queue));
+   queue->pass_prof_enabled = pdev->settings.pass_prof;
+   if (queue->pass_prof_enabled)
+      fprintf(stderr, "[pass-prof] armed: KosmicKrisp, 2 frames every 1200 presents, first 600; encoder GPU ms\n");
+}
+
+void
+kk_pass_prof_before_submit(struct kk_queue *queue)
+{
+   if (!queue->pass_prof_enabled || queue->pass_prof)
+      return;
+   const uint32_t phase = (queue->pass_prof_presents + 1u) % PP_PERIOD;
+   if (phase != PP_FIRST && phase != PP_FIRST + 1u)
+      return;
+   struct kk_device *dev = kk_queue_device(queue);
+   /* Independent guard at the allocation site: capture must never see a heap. */
+   if (kk_device_physical(dev)->settings.gpu_capture_enabled)
+      return;
+   struct kk_pass_prof *prof = calloc(1, sizeof(*prof));
+   if (!prof)
+      goto fail;
+   prof->frequency = mtl_device_timestamp_frequency(dev->mtl_handle);
+   if (!prof->frequency) {
+      free(prof);
+      goto fail;
+   }
+   prof->heap = mtl_new_timestamp_counter_heap(dev->mtl_handle, PP_PASSES * 2u);
+   if (!prof->heap) {
+      free(prof);
+      goto fail;
+   }
+   prof->refs = 1u;
+   prof->report = p_atomic_inc_return(&reports);
+   prof->present = queue->pass_prof_presents + 1u;
+   queue->pass_prof = prof;
+   return;
+fail:
+   fprintf(stderr, "[pass-prof] KosmicKrisp: allocation/frequency failed; off\n");
+   queue->pass_prof_enabled = false;
+}
+
+void
+kk_pass_prof_ref(struct kk_pass_prof *prof)
+{
+   if (prof)
+      p_atomic_inc(&prof->refs);
+}
+
+void
+kk_pass_prof_unref(struct kk_pass_prof *prof, bool success)
+{
+   if (!prof)
+      return;
+   if (!success)
+      p_atomic_set(&prof->failed, 1u);
+   if (!p_atomic_dec_zero(&prof->refs))
+      return;
+
+   uint64_t ts[PP_PASSES * 2u];
+   bool valid = !p_atomic_read(&prof->failed) && prof->count &&
+      mtl_timestamp_counter_heap_read(prof->heap, prof->count * 2u, ts);
+   for (uint32_t i = 0; valid && i < prof->count; i++)
+      if (kk_pass_prof_timed(&prof->passes[i]))
+         valid = ts[2u * i] && ts[2u * i + 1u] >= ts[2u * i];
+
+   /* Serialize sampled frames against other stdio writers. Wine also writes
+    * directly to the fd, so each pass below is assembled before one write.
+    * No GPU wait or per-pass logging in the recording/submission hot path. */
+   flockfile(stderr);
+   if (!valid) {
+      fprintf(stderr, "[pass-prof] discarded KosmicKrisp present %u: incomplete, overflow, GPU error or invalid timestamps\n",
+              prof->present);
+   } else {
+      fprintf(stderr, "[pass-prof] report %u at present %u: KosmicKrisp, %u encoders, %u command buffers, frequency=%" PRIu64 " Hz\n",
+              prof->report, prof->present, prof->count, prof->cbs,
+              prof->frequency);
+      fflush(stderr); /* The pass records use the fd directly. */
+      double sum = 0.0;
+      uint32_t draws = 0, untimed = 0;
+      uint64_t first = UINT64_MAX, last = 0;
+      for (uint32_t i = 0; i < prof->count; i++) {
+         if (ts[2u * i] && ts[2u * i + 1u] >= ts[2u * i]) {
+            first = MIN2(first, ts[2u * i]);
+            last = MAX2(last, ts[2u * i + 1u]);
+         }
+      }
+      const double ms_per_tick = 1000.0 / prof->frequency;
+      for (uint32_t i = 0; i < prof->count; i++) {
+         struct kk_profile_pass *p = &prof->passes[i];
+         const bool timed = kk_pass_prof_timed(p);
+         double ms = timed ? (ts[2u * i + 1u] - ts[2u * i]) * ms_per_tick : 0.0;
+         if (timed)
+            sum += ms;
+         else
+            untimed++;
+         draws += p->draws;
+         /* At most ten numeric attachments, no external strings; well below
+          * this bound and PIPE_BUF. Do not split a line across fprintf calls:
+          * Wine's fd writes bypass flockfile and can splice a pass in half. */
+         char line[2048];
+         int len = snprintf(line, sizeof(line), "[pass-prof]  f0 p%u cb%u ", i, p->cb);
+         if (p->render) {
+            len += snprintf(line + len, sizeof(line) - len, "render %ux%u x%u",
+                            p->width, p->height, p->samples);
+            for (unsigned a = 0; a < 10; a++) {
+               if (!p->attachments.formats[a])
+                  continue;
+               char name[8];
+               if (a < 8)
+                  snprintf(name, sizeof(name), "c%u", a);
+               else
+                  snprintf(name, sizeof(name), "%s", a == 8 ? "d" : "st");
+               /* Numeric Metal load/store actions; unlike DXMT's letters,
+                * these also preserve resolve and unknown store actions. */
+               len += snprintf(line + len, sizeof(line) - len, " %s=%u/%u:%u",
+                               name, p->attachments.formats[a],
+                               p->attachments.loads[a], p->attachments.stores[a]);
+            }
+            len += snprintf(line + len, sizeof(line) - len, " draws=%u ", p->draws);
+         } else {
+            len += snprintf(line + len, sizeof(line) - len, "compute ");
+         }
+         if (timed)
+            len += snprintf(line + len, sizeof(line) - len, "gpu=%.6f at=%.6f..%.6f pipeline=",
+                            ms, (ts[2u * i] - first) * ms_per_tick,
+                            (ts[2u * i + 1u] - first) * ms_per_tick);
+         else
+            len += snprintf(line + len, sizeof(line) - len, "gpu=NA reason=%s pipeline=",
+                            p->native_copy ? "native-copy" : "no-dispatch");
+         if (p->mixed)
+            len += snprintf(line + len, sizeof(line) - len, "mixed\n");
+         else
+            len += snprintf(line + len, sizeof(line) - len, "%p\n", p->pipeline);
+         assert(len > 0 && len < sizeof(line));
+         ssize_t written;
+         do {
+            written = write(fileno(stderr), line, len);
+         } while (written < 0 && errno == EINTR);
+      }
+      char span[64] = "NA";
+      if (first != UINT64_MAX)
+         snprintf(span, sizeof(span), "%.6f", (last - first) * ms_per_tick);
+      fprintf(stderr, "[pass-prof] frame 0: %u passes, %u draws, sum gpu %.6f ms, span %s ms, untimed %u\n",
+              prof->count, draws, sum, span, untimed);
+   }
+   fflush(stderr);
+   funlockfile(stderr);
+   for (uint32_t i = 0; i < prof->count; i++)
+      if (prof->passes[i].pipeline)
+         mtl_release(prof->passes[i].pipeline);
+   mtl_release(prof->heap);
+   free(prof);
+}
+
+void
+kk_pass_prof_present(struct kk_queue *queue)
+{
+   if (!queue->pass_prof_enabled)
+      return;
+   queue->pass_prof_presents++;
+   struct kk_pass_prof *prof = queue->pass_prof;
+   queue->pass_prof = NULL;
+   kk_pass_prof_unref(prof, true);
+}
+
+void
+kk_pass_prof_queue_finish(struct kk_queue *queue)
+{
+   /* A tail without a present is not a complete sampled frame. */
+   kk_pass_prof_unref(queue->pass_prof, false);
+   queue->pass_prof = NULL;
+}
+
+void
+kk_pass_prof_attach(struct kk_cmd_buffer *cmd, struct kk_pass_prof *prof)
+{
+   cmd->pass_prof = prof;
+   if (prof)
+      cmd->pass_prof_cb = ++prof->cbs;
+}
+
+void
+kk_pass_prof_begin(struct kk_cmd_buffer *cmd, bool render)
+{
+   struct kk_pass_prof *prof = cmd->pass_prof;
+   if (!prof)
+      return;
+   cmd->pass_prof_index = prof->count;
+   if (prof->count == PP_PASSES) {
+      p_atomic_set(&prof->failed, 1u);
+      return;
+   }
+   uint32_t i = prof->count++;
+   struct kk_profile_pass *p = &prof->passes[i];
+   p->render = render;
+   p->cb = cmd->pass_prof_cb;
+   if (render) {
+      const struct kk_rendering_state *r = &cmd->state.gfx.render;
+      p->width = r->area.extent.width;
+      p->height = r->area.extent.height;
+      p->samples = r->samples;
+      mtl_render_pass_profile_attachments(cmd->state.gfx.render_pass_descriptor,
+                                         &p->attachments);
+      mtl_render_write_timestamp(cmd->metal.render, MTL_RENDER_STAGE_VERTEX,
+                                 prof->heap, 2u * i);
+   } else {
+      mtl_compute_write_timestamp_precise(cmd->metal.compute, prof->heap, 2u * i);
+   }
+}
+
+void
+kk_pass_prof_end(struct kk_cmd_buffer *cmd, bool render)
+{
+   struct kk_pass_prof *prof = cmd->pass_prof;
+   if (!prof || cmd->pass_prof_index == PP_PASSES)
+      return;
+   uint32_t i = cmd->pass_prof_index;
+   if (render) {
+      mtl_render_write_timestamp(cmd->metal.render, MTL_RENDER_STAGE_FRAGMENT,
+                                 prof->heap, 2u * i + 1u);
+   } else {
+      mtl_compute_write_timestamp_precise(cmd->metal.compute, prof->heap, 2u * i + 1u);
+   }
+}
+
+void
+kk_pass_prof_pipeline(struct kk_cmd_buffer *cmd, void *pipeline)
+{
+   if (!cmd->pass_prof || cmd->pass_prof_index == PP_PASSES)
+      return;
+   struct kk_profile_pass *p = &cmd->pass_prof->passes[cmd->pass_prof_index];
+   if (!p->pipeline)
+      p->pipeline = mtl_retain(pipeline);
+   else if (p->pipeline != pipeline)
+      p->mixed = true;
+}
+
+void
+kk_pass_prof_store(struct kk_cmd_buffer *cmd, unsigned index, unsigned action)
+{
+   if (cmd->pass_prof && cmd->pass_prof_index != PP_PASSES)
+      cmd->pass_prof->passes[cmd->pass_prof_index].attachments.stores[index] = action;
+}
+
+void
+kk_pass_prof_copy(struct kk_cmd_buffer *cmd)
+{
+   if (cmd->pass_prof && cmd->pass_prof_index != PP_PASSES)
+      cmd->pass_prof->passes[cmd->pass_prof_index].native_copy = true;
+}
+
+void
+kk_pass_prof_draw(struct kk_cmd_buffer *cmd)
+{
+   if (cmd->pass_prof && cmd->pass_prof_index != PP_PASSES)
+      cmd->pass_prof->passes[cmd->pass_prof_index].draws++;
+}
+
+void
+kk_pass_prof_log_pipeline(struct kk_device *dev, void *pipeline, bool render,
+                          const char *msl, uint32_t requested)
+{
+   if (!pipeline || !kk_device_physical(dev)->settings.pass_prof)
+      return;
+   uint64_t threads = 0, memory = 0;
+   mtl_pipeline_profile_limits(pipeline, render, &threads, &memory);
+   fprintf(stderr, "[pass-prof] pipeline %p kind=%s msl=%.16s max_threads=%" PRIu64
+           " static_tg_bytes=%" PRIu64 " requested_threads=%u\n", pipeline,
+           render ? "render" : "compute", msl, threads, memory, requested);
+}
