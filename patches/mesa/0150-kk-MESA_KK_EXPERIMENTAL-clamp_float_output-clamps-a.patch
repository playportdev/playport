 #include "nir.h"
 #include "nir_builder.h"
 #include "nir_builtin_builder.h"
@@ -123,6 +125,51 @@ msl_nir_fs_force_output_signedness(
                                      render_target_formats);
 }
 
+static bool
+fs_clamp_float_output(nir_builder *b, nir_intrinsic_instr *intrin, void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   nir_io_semantics io = nir_intrinsic_io_semantics(intrin);
+   if (io.location < FRAG_RESULT_DATA0 || FRAG_RESULT_DATA7 < io.location)
+      return false;
+
+   enum pipe_format *render_target_formats = (enum pipe_format *)data;
+   enum pipe_format format =
+      render_target_formats[io.location - FRAG_RESULT_DATA0];
+   if (!util_format_is_float(format))
+      return false;
+
+   nir_def *value = intrin->src[0].ssa;
+   if (!(nir_intrinsic_src_type(intrin) & nir_type_float) ||
+       (value->bit_size != 16 && value->bit_size != 32))
+      return false;
+
+   /* Playport (PLA-815): D3D12's render target conversion flushes a shader's
+    * Inf or NaN to 0, the format's invalid value; Metal keeps them. A game's
+    * next shader that multiplies such a value by 0 then makes a NaN (DIRT 5's
+    * sky table from its transmittance table), and a kept Inf lights the scene
+    * to white. Map both to 0 here, where the format is known. */
+   b->cursor = nir_before_instr(&intrin->instr);
+   nir_def *nan = nir_fneu(b, value, value);
+   nir_def *inf = nir_fge(b, nir_fabs(b, value),
+                          nir_imm_floatN_t(b, INFINITY, value->bit_size));
+   nir_def *zero = nir_imm_zero(b, value->num_components, value->bit_size);
+   nir_def *clamped = nir_bcsel(b, nir_ior(b, nan, inf), zero, value);
+   nir_src_rewrite(&intrin->src[0], clamped);
+   return true;
+}
+
+bool
+msl_nir_fs_clamp_float_output(
+   nir_shader *nir, enum pipe_format render_target_formats[MAX_DRAW_BUFFERS])
+{
+   return nir_shader_intrinsics_pass(nir, fs_clamp_float_output,
+                                     nir_metadata_control_flow,
+                                     render_target_formats);
+}
+
