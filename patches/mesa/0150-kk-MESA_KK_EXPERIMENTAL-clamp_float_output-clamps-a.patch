+/* Playport (PLA-815): what a float colour output that is Inf or NaN becomes,
+ * and which targets it applies to. D3D12's render target conversion of Inf and
+ * NaN is only defined for a format that can hold them: R11G11B10F and R9G9B9E5
+ * have no encoding for either, while an IEEE half/float target stores what the
+ * shader wrote. These are experiments, named in the title's Graphics options:
+ *
+ *   MESA_KK_CLAMP_FLOAT_OUTPUT=zero   Inf/NaN become 0 (the default: the value
+ *                                     D3D12 is taken to store, and the one
+ *                                     DIRT 5's race renders right with)
+ *   MESA_KK_CLAMP_FLOAT_OUTPUT=max    Inf/NaN become the format's largest
+ *                                     finite value
+ *   MESA_KK_CLAMP_FLOAT_OUTPUT=none   the store keeps what the shader wrote
+ *   MESA_KK_CLAMP_FLOAT_OUTPUT_KEEP_IEEE=1
+ *                                     only a format without an Inf/NaN
+ *                                     encoding converts; an IEEE target keeps
+ *                                     the shader's Inf and NaN
+ */
+enum clamp_float_output_mode {
+   CLAMP_FLOAT_OUTPUT_ZERO,
+   CLAMP_FLOAT_OUTPUT_MAX,
+   CLAMP_FLOAT_OUTPUT_NONE,
+};
+
+static enum clamp_float_output_mode
+clamp_float_output_mode(void)
+{
+   static int mode = -1;
+   if (mode < 0) {
+      const char *opt = debug_get_option("MESA_KK_CLAMP_FLOAT_OUTPUT", "zero");
+      mode = strcmp(opt, "none") == 0 ? CLAMP_FLOAT_OUTPUT_NONE
+           : strcmp(opt, "max") == 0  ? CLAMP_FLOAT_OUTPUT_MAX
+                                      : CLAMP_FLOAT_OUTPUT_ZERO;
+   }
+   return (enum clamp_float_output_mode)mode;
+}
+
+/* A target whose format has no encoding for Inf or NaN, so a store of one has
+ * to become a finite value. */
+static bool
+format_has_no_inf_or_nan(enum pipe_format format)
+{
+   return format == PIPE_FORMAT_R11G11B10_FLOAT ||
+          format == PIPE_FORMAT_R9G9B9E5_FLOAT;
+}
+
+static float
+format_largest_finite(enum pipe_format format, unsigned bit_size)
+{
+   if (format == PIPE_FORMAT_R11G11B10_FLOAT)
+      return 65024.0f;
+   return bit_size == 16 ? 65504.0f : FLT_MAX;
+}
+
+static bool
+fs_clamp_float_output(nir_builder *b, nir_intrinsic_instr *intrin, void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   nir_io_semantics io = nir_intrinsic_io_semantics(intrin);
+   if (io.location < FRAG_RESULT_DATA0 || FRAG_RESULT_DATA7 < io.location)
+      return false;
+
+   enum pipe_format *render_target_formats = (enum pipe_format *)data;
+   enum pipe_format format =
+      render_target_formats[io.location - FRAG_RESULT_DATA0];
+   if (!util_format_is_float(format))
+      return false;
+
+   enum clamp_float_output_mode mode = clamp_float_output_mode();
+   if (mode == CLAMP_FLOAT_OUTPUT_NONE)
+      return false;
+   if (debug_get_bool_option("MESA_KK_CLAMP_FLOAT_OUTPUT_KEEP_IEEE", false) &&
+       !format_has_no_inf_or_nan(format))
+      return false;
+
+   nir_def *value = intrin->src[0].ssa;
+   if (!(nir_intrinsic_src_type(intrin) & nir_type_float) ||
+       (value->bit_size != 16 && value->bit_size != 32))
+      return false;
+
+   b->cursor = nir_before_instr(&intrin->instr);
+   nir_def *nan = nir_fneu(b, value, value);
+   nir_def *inf = nir_fge(b, nir_fabs(b, value),
+                          nir_imm_floatN_t(b, INFINITY, value->bit_size));
+   nir_def *replacement;
+   if (mode == CLAMP_FLOAT_OUTPUT_MAX) {
+      nir_def *one = nir_imm_floatN_t(
+         b, format_largest_finite(format, value->bit_size), value->bit_size);
+      nir_def *comps[NIR_MAX_VEC_COMPONENTS] = {one, one, one, one};
+      replacement = nir_vec(b, comps, value->num_components);
+   } else {
+      replacement = nir_imm_zero(b, value->num_components, value->bit_size);
+   }
+   nir_def *clamped = nir_bcsel(b, nir_ior(b, nan, inf), replacement, value);
+   nir_src_rewrite(&intrin->src[0], clamped);
+   return true;
+}
+
+bool
+msl_nir_fs_clamp_float_output(
+   nir_shader *nir, enum pipe_format render_target_formats[MAX_DRAW_BUFFERS])
+{
+   return nir_shader_intrinsics_pass(nir, fs_clamp_float_output,
+                                     nir_metadata_control_flow,
+                                     render_target_formats);
+}
+
