+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBindTransformFeedbackBuffers2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstBinding, uint32_t bindingCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pBindingInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   for (uint32_t i = 0; i < bindingCount; i++) {
+      const VkDeviceAddressRangeKHR *range = &pBindingInfos[i].addressRange;
+      gfx->xfb.buffers[firstBinding + i] = (struct kk_addr_range){
+         .addr = range->address,
+         .range = range->size,
+      };
+   }
+}
+
+/* vkCmdBeginTransformFeedbackEXT loads the command buffer's byte offsets
+ * from the counter buffers (zero where there is none); End stores them back.
+ * The offsets live in memory the GPU updates as draws capture, so both are GPU
+ * copies. */
+static void
+kk_begin_end_xfb(struct kk_cmd_buffer *cmd, uint32_t first_counter,
+                 uint32_t counter_count,
+                 const VkBindTransformFeedbackBuffer2InfoEXT *counters,
+                 bool begin)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+
+   gfx->xfb.enabled = begin;
+
+   if (!gfx->xfb.offsets) {
+      struct kk_ptr offsets = kk_pool_alloc(cmd, 4 * sizeof(uint32_t), 4);
+      memset(offsets.cpu, 0, 4 * sizeof(uint32_t));
+      gfx->xfb.offsets = offsets.gpu;
+   }
+
+   uint64_t dest[4] = {0}, src[4] = {0};
+   bool any = false;
+
+   if (begin) {
+      /* Every offset is (re)loaded: from its counter buffer, else zero. */
+      for (unsigned i = 0; i < 4; ++i)
+         dest[i] = gfx->xfb.offsets + i * sizeof(uint32_t);
+      any = true;
+   }
+
+   for (uint32_t i = 0; counters && i < counter_count; ++i) {
+      uint64_t addr = counters[i].addressRange.address;
+      uint32_t idx = first_counter + i;
+      if (!addr || idx >= 4)
+         continue;
+
+      if (begin) {
+         src[idx] = addr;
+      } else {
+         dest[idx] = addr;
+         src[idx] = gfx->xfb.offsets + idx * sizeof(uint32_t);
+         any = true;
+      }
+   }
+
+   if (any) {
+      libkk_copy_xfb_counters(cmd, kk_grid_1d(4), true, dest[0], dest[1],
+                              dest[2], dest[3], src[0], src[1], src[2],
+                              src[3]);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdBeginTransformFeedback2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstCounterRange,
+   uint32_t counterRangeCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterRange, counterRangeCount, pCounterInfos,
+                    true);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdEndTransformFeedback2EXT(
+   VkCommandBuffer commandBuffer, uint32_t firstCounterRange,
+   uint32_t counterRangeCount,
+   const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfos)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_begin_end_xfb(cmd, firstCounterRange, counterRangeCount, pCounterInfos,
+                    false);
+}
+
+/* A draw whose vertex count is what transform feedback captured: turn the
+ * counter into an indirect draw command on the GPU, then draw indirectly. */
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawIndirectByteCount2EXT(
+   VkCommandBuffer commandBuffer, uint32_t instanceCount,
+   uint32_t firstInstance, const VkBindTransformFeedbackBuffer2InfoEXT *pCounterInfo,
+   uint32_t counterOffset, uint32_t vertexStride)
+{
+   if (instanceCount == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+
+   struct kk_ptr draw = kk_pool_alloc(cmd, sizeof(VkDrawIndirectCommand), 4);
+   if (unlikely(!draw.gpu))
+      return;
+
+   libkk_draw_indirect_byte_count(cmd, kk_grid_1d(1), true, draw.gpu,
+                                  pCounterInfo->addressRange.address,
+                                  counterOffset, vertexStride, instanceCount,
+                                  firstInstance);
+
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+
+   struct kk_draw_command data = {
+      .prim = vk_topology_to_mesa(dyn->ia.primitive_topology),
+      .upload_mask = build_per_draw_upload_mask(cmd),
+      .indirect = true,
+      .predicate_count = cmd->state.cond_render.enabled ? 1u : 0u,
+      .predicate_op[0] = cmd->state.cond_render.inverted
+                            ? KK_PREDICATE_EQ_ZERO
+                            : KK_PREDICATE_NEQ_ZERO,
+      .draw_count = 1,
+      .predicate_addr[0] = cmd->state.cond_render.address,
+      .indirect_command.addr = draw.gpu,
+      .indirect_command.stride = sizeof(VkDrawIndirectCommand),
+   };
+
+   kk_draw(cmd, &data);
+}
