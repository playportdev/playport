diff --git a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
index e5c43bc..7cafbb2 100644
--- a/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
+++ b/src/kosmickrisp/vulkan/kk_nir_lower_descriptors.c
@@ -828,11 +828,26 @@ lower_poly(struct nir_builder *b, nir_intrinsic_instr *intrin, void *data)
    case nir_intrinsic_load_provoking_last:
       return lower_sysval_to_per_draw(b, intrin, provoking_last);
    case nir_intrinsic_load_rasterization_stream:
-      /* Only stream 0 is rasterized: there is no transform feedback. */
-      b->cursor = nir_instr_remove(&intrin->instr);
-      nir_def_rewrite_uses(&intrin->def,
-                           nir_imm_intN_t(b, 0, intrin->def.bit_size));
+      return lower_sysval_to_per_draw(b, intrin, rasterization_stream);
+   case nir_intrinsic_load_ro_sink_address_poly:
+      return lower_sysval_to_per_draw(b, intrin, zero_page);
+   case nir_intrinsic_load_stat_query_address_poly:
+      /* Pipeline statistics queries are not exposed: the counters poly's
+       * pre-GS program keeps go to the scratch page. */
+      return lower_sysval_to_per_draw(b, intrin, scratch_page);
+   case nir_intrinsic_ro_to_rw_poly: {
+      /* poly reads through the zero page and writes through this; redirect
+       * those writes to the scratch page. */
+      b->cursor = nir_before_instr(&intrin->instr);
+      nir_def *zero_page = load_per_draw(b, 1, 64,
