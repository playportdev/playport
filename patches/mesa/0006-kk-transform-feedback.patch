+static const nir_shader_compiler_options *
+kk_get_nir_options(struct vk_physical_device *vk_pdev, mesa_shader_stage stage,
+                   UNUSED const struct vk_pipeline_robustness_state *rs)
+{
+   /* Geometry shaders unroll their loops (as honeykrisp's do) so that poly
+    * can count their vertices and primitives at compile time: a geometry
+    * shader with static counts needs no index buffer written at run time and
+    * rasterizes with a static topology. Metal unrolls everything else. */
+   if (stage == MESA_SHADER_GEOMETRY) {
+      static once_flag once = ONCE_FLAG_INIT;
+      call_once(&once, kk_init_gs_nir_options);
+      return &kk_gs_nir_options;
+   }
+   return &kk_nir_options;
