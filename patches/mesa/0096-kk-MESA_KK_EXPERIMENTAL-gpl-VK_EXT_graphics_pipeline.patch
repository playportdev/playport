diff --git a/src/kosmickrisp/vulkan/kk_gpl.c b/src/kosmickrisp/vulkan/kk_gpl.c
new file mode 100644
index 0000000..a778c7e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_gpl.c
@@ -0,0 +1,317 @@
+/*
+ * Copyright 2026 The Playport authors
+ * SPDX-License-Identifier: MIT
+ *
+ * Playport (PLA-424): links pipeline library shaders at the draw. See
+ * kk_gpl.h.
+ */
+
+#include "kk_gpl.h"
+
+#include "kk_cmd_buffer.h"
+#include "kk_debug.h"
+#include "kk_device.h"
+#include "kk_physical_device.h"
+#include "kk_shader.h"
+
+#include "util/hash_table.h"
+#include "util/os_time.h"
+#include "util/simple_mtx.h"
+#include "util/u_atomic.h"
+
+#include "vk_render_pass.h"
+
+#include <stdio.h>
+
+struct kk_gpl_link {
+   blake3_hash key;
+   /* The sources linked, by stage (0 for none) */
+   uint64_t ids[KK_GPL_STAGES];
+   /* The shaders compiled for them, by stage. All NULL when the link
+    * failed: draws with it are skipped, and it is not compiled again. */
+   struct kk_shader *linked[KK_GPL_STAGES];
+};
+
+struct kk_gpl_cache {
+   simple_mtx_t lock;
+   /* blake3 key -> struct kk_gpl_link */
+   struct hash_table *links;
+   /* For MESA_KK_DEBUG=compile */
+   uint32_t compiled, failed;
+};
+
+static uint32_t
+kk_gpl_key_hash(const void *key)
+{
+   uint32_t h;
+   memcpy(&h, key, sizeof(h));
+   return h;
+}
+
+static bool
+kk_gpl_key_equal(const void *a, const void *b)
+{
+   return memcmp(a, b, sizeof(blake3_hash)) == 0;
+}
+
+VkResult
+kk_gpl_device_init(struct kk_device *dev)
+{
+   if (!KK_EXPERIMENTAL(GPL))
+      return VK_SUCCESS;
+
+   struct kk_gpl_cache *cache =
+      vk_zalloc(&dev->vk.alloc, sizeof(*cache), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!cache)
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   cache->links =
+      _mesa_hash_table_create(NULL, kk_gpl_key_hash, kk_gpl_key_equal);
+   if (!cache->links) {
+      vk_free(&dev->vk.alloc, cache);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   simple_mtx_init(&cache->lock, mtx_plain);
+   dev->gpl_cache = cache;
+   return VK_SUCCESS;
+}
+
+static void
+kk_gpl_link_destroy(struct kk_device *dev, struct kk_gpl_link *link)
+{
+   for (uint32_t s = 0; s < KK_GPL_STAGES; s++) {
+      if (link->linked[s])
+         kk_shader_release(dev, link->linked[s]);
+   }
+   free(link);
+}
+
+void
+kk_gpl_device_finish(struct kk_device *dev)
+{
+   struct kk_gpl_cache *cache = dev->gpl_cache;
+   if (!cache)
+      return;
+   hash_table_foreach(cache->links, entry)
+      kk_gpl_link_destroy(dev, entry->data);
+   _mesa_hash_table_destroy(cache->links, NULL);
+   simple_mtx_destroy(&cache->lock);
+   vk_free(&dev->vk.alloc, cache);
+   dev->gpl_cache = NULL;
+}
+
+void
+kk_gpl_forget(struct kk_device *dev, uint64_t id)
+{
+   struct kk_gpl_cache *cache = dev->gpl_cache;
+   if (!cache)
+      return;
+
+   /* The application destroys a library's shader only once no command
+    * buffer in flight uses a pipeline made with it, so neither do the
+    * links made with it. */
+   struct kk_gpl_link *dead[64];
+   uint32_t count;
+   do {
+      count = 0;
+      simple_mtx_lock(&cache->lock);
+      hash_table_foreach(cache->links, entry) {
+         struct kk_gpl_link *link = entry->data;
+         bool uses = false;
+         for (uint32_t s = 0; s < KK_GPL_STAGES; s++)
+            uses |= link->ids[s] == id;
+         if (!uses)
+            continue;
+         _mesa_hash_table_remove(cache->links, entry);
+         dead[count++] = link;
+         if (count == ARRAY_SIZE(dead))
+            break;
+      }
+      simple_mtx_unlock(&cache->lock);
+      for (uint32_t i = 0; i < count; i++)
+         kk_gpl_link_destroy(dev, dead[i]);
+   } while (count == ARRAY_SIZE(dead));
+}
+
+/* The render pass state of the current rendering, as a pipeline for it
+ * would have. */
+static void
+kk_gpl_rendering_rp(const struct kk_cmd_buffer *cmd,
+                    struct vk_render_pass_state *rp)
+{
+   const struct kk_rendering_state *render = &cmd->state.gfx.render;
+   memset(rp, 0, sizeof(*rp));
+   rp->color_attachment_count = render->color_att_count;
+   rp->attachments = 0;
+   for (uint32_t i = 0; i < render->color_att_count; i++) {
+      rp->color_attachment_formats[i] = render->color_att[i].vk_format;
+      if (render->color_att[i].vk_format != VK_FORMAT_UNDEFINED)
+         rp->attachments |= MESA_VK_RP_ATTACHMENT_COLOR_0_BIT << i;
+   }
+   rp->depth_attachment_format = render->depth_att.vk_format;
+   if (rp->depth_attachment_format != VK_FORMAT_UNDEFINED)
+      rp->attachments |= MESA_VK_RP_ATTACHMENT_DEPTH_BIT;
+   rp->stencil_attachment_format = render->stencil_att.vk_format;
+   if (rp->stencil_attachment_format != VK_FORMAT_UNDEFINED)
+      rp->attachments |= MESA_VK_RP_ATTACHMENT_STENCIL_BIT;
+}
+
+/* Everything a whole pipeline's compile reads, from the library shaders and
+ * the draw's dynamic and rendering state. */
+struct kk_gpl_draw_state {
+   struct vk_graphics_pipeline_state state;
+   struct vk_input_assembly_state ia;
+   struct vk_multisample_state ms;
+   struct vk_render_pass_state rp;
+   struct vk_multiview_state mv;
+};
+
+static void
+kk_gpl_draw_state(const struct kk_cmd_buffer *cmd,
+                  struct kk_shader *const *sources,
+                  struct kk_gpl_draw_state *out)
+{
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+   const struct kk_gpl_cmd_state *g = &cmd->state.gpl;
+   memset(out, 0, sizeof(*out));
+   struct vk_graphics_pipeline_state *st = &out->state;
+
+   /* What the bound pipeline does not set is dynamic. */
+   BITSET_DECLARE(all, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX);
+   BITSET_ONES(all);
+   BITSET_ANDNOT(st->dynamic, all, g->static_set);
+
+   for (uint32_t s = 0; s < KK_GPL_STAGES; s++) {
+      if (sources[s])
+         st->shader_stages |= mesa_to_vk_shader_stage(s);
+   }
+
+   st->vi = dyn->vi;
+   out->ia = dyn->ia;
+   st->ia = &out->ia;
+   st->ts = &dyn->ts;
+   st->vp = &dyn->vp;
+   st->rs = &dyn->rs;
+   st->fsr = &dyn->fsr;
+
+   const struct kk_gpl_source *fs =
+      sources[MESA_SHADER_FRAGMENT] ? sources[MESA_SHADER_FRAGMENT]->gpl
+                                    : NULL;
+   out->ms = (struct vk_multisample_state){
+      .rasterization_samples = dyn->ms.rasterization_samples,
+      .sample_shading_enable = fs && fs->sample_shading_enable,
+      .min_sample_shading = fs ? fs->min_sample_shading : 0.0f,
+      .sample_mask = dyn->ms.sample_mask,
+      .alpha_to_coverage_enable = dyn->ms.alpha_to_coverage_enable,
+      .alpha_to_one_enable = dyn->ms.alpha_to_one_enable,
+      .sample_locations_enable = dyn->ms.sample_locations_enable,
+      .sample_locations = dyn->ms.sample_locations,
+   };
+   /* A pipeline without rasterization has no multisample state */
+   st->ms = out->ms.rasterization_samples ? &out->ms : NULL;
+   st->ds = &dyn->ds;
+   st->cb = &dyn->cb;
+   st->cal = &dyn->cal;
+   st->ial = &dyn->ial;
+
+   kk_gpl_rendering_rp(cmd, &out->rp);
+   st->rp = &out->rp;
+   out->mv.view_mask = cmd->state.gfx.render.view_mask;
+   st->mv = &out->mv;
+}
+
+static void
+kk_gpl_key(struct kk_device *dev, struct kk_shader *const *sources,
+           const struct vk_graphics_pipeline_state *st, blake3_hash key)
+{
+   blake3_hash state_hash;
+   VkShaderStageFlags stages = st->shader_stages | VK_SHADER_STAGE_VERTEX_BIT |
+                               VK_SHADER_STAGE_FRAGMENT_BIT;
+   dev->vk.shader_ops->hash_state(dev->vk.physical, st,
+                                  &dev->vk.enabled_features, stages,
+                                  state_hash);
+
+   struct mesa_blake3 ctx;
+   _mesa_blake3_init(&ctx);
+   _mesa_blake3_update(&ctx, state_hash, sizeof(state_hash));
+   _mesa_blake3_update(&ctx, st->dynamic, sizeof(st->dynamic));
+   for (uint32_t s = 0; s < KK_GPL_STAGES; s++) {
+      uint64_t id = sources[s] ? sources[s]->gpl->id : 0;
+      _mesa_blake3_update(&ctx, &id, sizeof(id));
+   }
+   _mesa_blake3_final(&ctx, key);
+}
+
+bool
+kk_gpl_resolve(struct kk_cmd_buffer *cmd)
+{
+   struct kk_gpl_cmd_state *g = &cmd->state.gpl;
+   struct kk_shader *sources[KK_GPL_STAGES];
+   bool any = false;
+   for (uint32_t s = 0; s < KK_GPL_STAGES; s++) {
+      sources[s] = g->bound[s];
+      any |= sources[s] != NULL;
+   }
+   if (!any)
+      return true;
+
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_gpl_cache *cache = dev->gpl_cache;
+   struct kk_gpl_draw_state ds;
+   kk_gpl_draw_state(cmd, sources, &ds);
+   blake3_hash key;
+   kk_gpl_key(dev, sources, &ds.state, key);
+   if (!g->dirty && memcmp(key, g->key, sizeof(key)) == 0)
+      return cmd->state.shaders[MESA_SHADER_VERTEX] != NULL;
+
+   simple_mtx_lock(&cache->lock);
+   struct hash_entry *entry = _mesa_hash_table_search(cache->links, key);
+   struct kk_gpl_link *link = entry ? entry->data : NULL;
+   simple_mtx_unlock(&cache->lock);
+
+   if (!link) {
+      link = calloc(1, sizeof(*link));
+      if (!link)
+         return false;
+      memcpy(link->key, key, sizeof(key));
+      for (uint32_t s = 0; s < KK_GPL_STAGES; s++)
+         link->ids[s] = sources[s] ? sources[s]->gpl->id : 0;
+
+      const int64_t start = os_time_get_nano();
+      VkResult result =
+         kk_gpl_link_compile(dev, sources, &ds.state, link->linked);
+      if (KK_DEBUG(COMPILE))
+         fprintf(stderr, "[kk-compile] link %s ms=%.1f stages=%#x\n",
+                 result == VK_SUCCESS ? "full" : "FAIL",
+                 (os_time_get_nano() - start) / 1e6,
+                 ds.state.shader_stages);
+
+      /* Another thread may have linked the same meanwhile: keep the first. */
+      simple_mtx_lock(&cache->lock);
+      entry = _mesa_hash_table_search(cache->links, key);
+      if (entry) {
+         simple_mtx_unlock(&cache->lock);
+         kk_gpl_link_destroy(dev, link);
+         link = entry->data;
+      } else {
+         _mesa_hash_table_insert(cache->links, link->key, link);
+         if (result == VK_SUCCESS)
+            cache->compiled++;
+         else
+            cache->failed++;
+         simple_mtx_unlock(&cache->lock);
+      }
+   }
+
+   memcpy(g->key, key, sizeof(key));
+   g->dirty = false;
+   if (link->linked[MESA_SHADER_VERTEX] == NULL) {
+      /* Failed: leave nothing of it bound, and skip its draws. */
+      cmd->state.shaders[MESA_SHADER_VERTEX] = NULL;
+      return false;
+   }
+   for (uint32_t s = 0; s < KK_GPL_STAGES; s++)
+      kk_cmd_bind_linked_shader(cmd, s, link->linked[s]);
+   return true;
+}
