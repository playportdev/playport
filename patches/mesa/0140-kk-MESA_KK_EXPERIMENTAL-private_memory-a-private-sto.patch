+/* Whether the image may be bound to private memory (a memory type that is
+ * not host visible): a Metal texture placed in a heap, which nothing reads or
+ * writes with the CPU. Linear images are buffer-backed textures, host image
+ * copies write with the CPU, and external and sparse images keep the memory
+ * they always had. */
+static bool
+kk_image_may_be_private(const struct kk_image *image)
+{
+   return KK_EXPERIMENTAL(PRIVATE_MEMORY) &&
+          image->vk.tiling == VK_IMAGE_TILING_OPTIMAL &&
+          !(image->vk.usage & VK_IMAGE_USAGE_HOST_TRANSFER_BIT_EXT) &&
+          !(image->vk.create_flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT) &&
+          image->vk.external_handle_types == 0;
+}
