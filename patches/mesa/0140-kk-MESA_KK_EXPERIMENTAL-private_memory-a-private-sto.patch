    *align_B_out = plane->layout.align_B;
+
+   /* Metal may need more room or alignment for the texture in a private heap
+    * (lossless compression keeps metadata beside it). Requirements and binds
+    * both come here, so the larger of the two fits either heap. */
+   if (kk_image_may_be_private(image)) {
+      uint64_t private_size_B = 0u, private_align_B = 0u;
+      struct kk_image_layout layout = plane->layout;
+      mtl_heap_private_texture_size_and_align(dev->mtl_handle, &layout,
+                                              &private_size_B,
+                                              &private_align_B);
+      *size_B_out = MAX2(*size_B_out, private_size_B);
+      *align_B_out = MAX2(*align_B_out, private_align_B);
+   }
 }
 
