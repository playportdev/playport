+/* A built shader's MSL source as a new ralloc string, inflated if it is
+ * packed; NULL if it cannot be. */
+static char *
+kk_msl_data_code_dup(const struct msl_compile_data *data)
+{
+   if (data->code)
+      return ralloc_strdup(NULL, data->code);
+   if (data->packed == NULL)
+      return NULL;
+   char *code = ralloc_size(NULL, data->code_size);
+   uLongf size = data->code_size;
+   if (code == NULL ||
+       uncompress((Bytef *)code, &size, data->packed, data->packed_size) !=
+          Z_OK ||
+       size != data->code_size) {
+      ralloc_free(code);
+      return NULL;
+   }
+   return code;
+}
+
 static void
 kk_shader_pack_msl(struct kk_shader *shader)
 {
@@ -1075,6 +1096,7 @@ kk_shader_destroy(struct vk_device *vk_dev, struct kk_shader *shader,
       struct kk_gpl_source *src = shader->gpl;
       kk_gpl_forget(dev, src->id);
       kk_gpl_source_release(dev, src);
+      p_atomic_dec(&kk_gpl_memory_stats(dev)->sources);
       for (uint32_t i = 0; i < src->set_layout_count; i++) {
          if (src->set_layouts[i])
             vk_descriptor_set_layout_unref(&dev->vk, src->set_layouts[i]);
@@ -3497,16 +3519,33 @@ kk_msl_serialize(struct kk_shader *shader, mesa_shader_stage stage,
    kk_msl_data_serialize(&shader->msl_data[stage], blob);
 }
 
+/* Playport (PLA-424): a pipeline library's shader serialized
+ * (kk_gpl_serialize). Its blob starts with KK_GPL_BLOB_MAGIC where a whole
+ * pipeline's starts with its stage, and then KK_GPL_BLOB_VERSION: a blob of
+ * another version is refused, not read. The cache key changes with it too
+ * (kk_hash_graphics_state). */
+#define KK_GPL_BLOB_MAGIC   0x4c50474bu /* "KGPL" */
+#define KK_GPL_BLOB_VERSION 1u
+static_assert(offsetof(struct kk_shader_info, stage) == 0 &&
+                 sizeof(mesa_shader_stage) == sizeof(uint32_t),
+              "a whole pipeline's blob starts with its stage");
+
+static bool kk_gpl_serialize(const struct kk_shader *shader,
+                             struct blob *blob);
+static VkResult kk_gpl_deserialize(struct kk_device *dev,
+                                   struct blob_reader *blob,
+                                   const VkAllocationCallbacks *pAllocator,
+                                   struct vk_shader **shader_out);
+
 static bool
 kk_shader_serialize(struct vk_device *vk_dev, const struct vk_shader *vk_shader,
                     struct blob *blob)
 {
    struct kk_shader *shader = container_of(vk_shader, struct kk_shader, vk);
 
-   /* Playport (PLA-424): a pipeline library's shader holds NIR and set
-    * layouts, not MSL; it is not serialized. */
+   /* Playport (PLA-424): a pipeline library's shader */
    if (shader->gpl)
-      return false;
+      return kk_gpl_serialize(shader, blob);
 
    blob_write_bytes(blob, &shader->info, sizeof(shader->info));
    kk_msl_serialize(shader, shader->info.stage, blob);
@@ -3564,6 +3603,13 @@ kk_deserialize_shader(struct vk_device *vk_dev, struct blob_reader *blob,
 {
    struct kk_device *dev = container_of(vk_dev, struct kk_device, vk);
 
+   /* Playport (PLA-424): a pipeline library's shader (kk_gpl_serialize) */
+   uint32_t first = 0;
+   if (blob->end - blob->current >= (ptrdiff_t)sizeof(first))
+      memcpy(&first, blob->current, sizeof(first));
+   if (first == KK_GPL_BLOB_MAGIC)
+      return kk_gpl_deserialize(dev, blob, pAllocator, shader_out);
+
    struct kk_shader_info info;
    blob_copy_bytes(blob, &info, sizeof(info));
    if (blob->overrun)
@@ -3807,6 +3853,57 @@ kk_gpl_single_slot_varyings(nir_shader *nir, bool *indirect)
                                      nir_metadata_control_flow, indirect);
 }
 
+/* Builds the Metal library of a vertex or fragment shader compiled on its own
+ * (or deserialized: msl_src) into src, which keeps both, or says why it could
+ * not be built. kind names it on the [kk-compile] gpl line. A kept shader's
+ * MSL is packed, and it and its library are counted. */
+static void
+kk_gpl_build_library(struct kk_device *dev, struct kk_gpl_source *src,
+                     struct kk_shader *shader, const char *kind,
+                     const char *msl_src, int64_t start)
+{
+   const bool vertex = shader->info.stage == MESA_SHADER_VERTEX;
+   struct kk_library_build build = {
+      .device = dev,
+      .data = &shader->msl_data[shader->info.stage],
+      .kind = "gpl",
+      .step = vertex ? "vertex-library" : "fragment-library",
+      .src = msl_src,
+   };
+   kk_build_library(&build);
+   if (KK_DEBUG(COMPILE)) {
+      const char *how = build.library == NULL ? "FAIL"
+                        : strcmp(msl_src, KK_SRC_DESERIALIZED) == 0
+                           ? "deserialized"
+                           : "built";
+      fprintf(stderr, "[kk-compile] gpl %s %s ms=%.1f library_ms=%.1f\n", kind,
+              how, (os_time_get_nano() - start) / 1e6, build.ns / 1e6);
+   }
+   if (build.library == NULL) {
+      kk_shader_destroy(&dev->vk, shader, &dev->vk.alloc);
+      if (vertex)
+         src->vertex_blocker = "vertex-library";
+      else
+         src->fragment_at_link = "fragment-library";
+      return;
+   }
+
+   /* Links copy the MSL out again (kk_msl_data_code_dup) */
+   kk_shader_pack_msl(shader);
+   if (KK_DEBUG(MEMORY))
+      kk_shader_count(shader, 1);
+   struct kk_gpl_memory_stats *memory = kk_gpl_memory_stats(dev);
