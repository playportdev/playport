-   simple_mtx_unlock(&cache->lock);
+      simple_mtx_unlock(&cache->lock);
+   }
 
-   blake3_hash key;
-   kk_gpl_key(dev, sources, &ds.state, blocker == NULL, key);
+   if (!keyed || keyed_separate != (blocker == NULL))
