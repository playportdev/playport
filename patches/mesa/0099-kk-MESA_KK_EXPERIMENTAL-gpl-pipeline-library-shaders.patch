@@ -444,15 +518,25 @@ kk_gpl_resolve(struct kk_cmd_buffer *cmd)
          link = entry->data;
       } else {
          _mesa_hash_table_insert(cache->links, link->key, link);
-         if (result == VK_SUCCESS)
