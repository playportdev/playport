+/* Every reason a struct kk_gpl_source keeps (kk_gpl_compile_vertex,
+ * kk_gpl_compile_fragment, kk_gpl_build_library), by which a blob names
+ * one */
+static const char *const kk_gpl_source_reasons[] = {
+   "stages",           "xfb",
+   "memory",           "varying-indirect",
+   "vertex-compile",   "vertex-library",
+   "debug-solid",      "input-attachment",
+   "fragment-clip-input", "fragment-primitive-id",
+   "dual-source",      "triangle-merge",
+   "fragment-compile", "fragment-library",
+};
+
+/* Reasons that may not hold in another run: a source with one is not
+ * serialized */
+static bool
+kk_gpl_reason_is_transient(const char *reason)
+{
+   return reason && (strcmp(reason, "memory") == 0 ||
+                     strcmp(reason, "vertex-library") == 0 ||
+                     strcmp(reason, "fragment-library") == 0);
+}
+
+static void
+kk_gpl_reason_serialize(struct blob *blob, const char *reason)
+{
+   blob_write_string(blob, reason ? reason : "");
+}
+
+/* *ok is cleared for a reason that is not in kk_gpl_source_reasons */
+static const char *
+kk_gpl_reason_deserialize(struct blob_reader *blob, bool *ok)
+{
+   const char *reason = blob_read_string(blob);
+   if (reason == NULL) {
+      *ok = false;
+      return NULL;
+   }
+   if (reason[0] == 0)
+      return NULL;
+   for (uint32_t i = 0; i < ARRAY_SIZE(kk_gpl_source_reasons); i++) {
+      if (strcmp(reason, kk_gpl_source_reasons[i]) == 0)
+         return kk_gpl_source_reasons[i];
+   }
+   *ok = false;
+   return NULL;
+}
+
+/* What compiling NIR with a descriptor set layout reads of it
+ * (kk_nir_lower_descriptors). Immutable samplers matter only for their
+ * Y'CbCr conversions (lookup_ycbcr_conversion): a layout with one is not
+ * serialized. */
+static bool
+kk_gpl_set_layout_serializable(const struct vk_descriptor_set_layout *vk_layout)
+{
+   const struct kk_descriptor_set_layout *layout =
+      vk_to_kk_descriptor_set_layout((struct vk_descriptor_set_layout *)vk_layout);
+   for (uint32_t b = 0; b < layout->binding_count; b++) {
+      const struct kk_descriptor_set_binding_layout *binding =
+         &layout->binding[b];
+      if (binding->immutable_samplers == NULL)
+         continue;
+      for (uint32_t i = 0; i < binding->array_size; i++) {
+         const struct kk_sampler *sampler = binding->immutable_samplers[i];
+         if (sampler && sampler->vk.ycbcr_conversion)
+            return false;
+      }
+   }
+   return true;
+}
+
+static void
+kk_gpl_set_layout_serialize(struct blob *blob,
+                            const struct vk_descriptor_set_layout *vk_layout)
+{
+   const struct kk_descriptor_set_layout *layout =
+      vk_to_kk_descriptor_set_layout((struct vk_descriptor_set_layout *)vk_layout);
+   blob_write_uint32(blob, layout->vk.flags);
+   blob_write_uint32(blob, layout->vk.dynamic_descriptor_count);
+   blob_write_bytes(blob, layout->vk.blake3, sizeof(layout->vk.blake3));
+   blob_write_uint32(blob, layout->flags);
+   blob_write_uint32(blob, layout->non_variable_descriptor_buffer_size);
+   blob_write_uint32(blob, layout->max_buffer_size);
+   blob_write_bytes(blob, layout->dynamic_ubos, sizeof(layout->dynamic_ubos));
+   blob_write_uint32(blob, layout->descriptor_count);
+   blob_write_uint32(blob, layout->binding_count);
+   for (uint32_t b = 0; b < layout->binding_count; b++) {
+      const struct kk_descriptor_set_binding_layout *binding =
+         &layout->binding[b];
+      blob_write_uint32(blob, binding->type);
+      blob_write_uint32(blob, binding->flags);
+      blob_write_uint32(blob, binding->array_size);
+      blob_write_uint32(blob, binding->offset);
+      blob_write_uint8(blob, binding->stride);
+      blob_write_uint8(blob, binding->dynamic_buffer_index);
+   }
+}
+
+/* A layout with what kk_gpl_set_layout_serialize wrote, for compiling only:
+ * no immutable samplers, no embedded sampler buffer. */
+static struct vk_descriptor_set_layout *
+kk_gpl_set_layout_deserialize(struct kk_device *dev, struct blob_reader *blob)
+{
+   const VkDescriptorSetLayoutCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .flags = blob_read_uint32(blob),
+   };
+   const uint32_t dynamic_descriptor_count = blob_read_uint32(blob);
+   blake3_hash blake3;
+   blob_copy_bytes(blob, blake3, sizeof(blake3));
+   const uint32_t flags = blob_read_uint32(blob);
+   const uint32_t non_variable_size = blob_read_uint32(blob);
+   const uint32_t max_buffer_size = blob_read_uint32(blob);
+   BITSET_DECLARE(dynamic_ubos, KK_MAX_DYNAMIC_BUFFERS);
+   blob_copy_bytes(blob, dynamic_ubos, sizeof(dynamic_ubos));
+   const uint32_t descriptor_count = blob_read_uint32(blob);
+   const uint32_t binding_count = blob_read_uint32(blob);
+   /* Each binding takes 18 bytes of the blob */
+   if (blob->overrun || binding_count > (blob->end - blob->current) / 18)
+      return NULL;
+
+   struct kk_descriptor_set_layout *layout = vk_descriptor_set_layout_zalloc(
+      &dev->vk,
+      sizeof(*layout) + binding_count * sizeof(layout->binding[0]), &info);
+   if (layout == NULL)
+      return NULL;
+   layout->vk.dynamic_descriptor_count = dynamic_descriptor_count;
+   memcpy(layout->vk.blake3, blake3, sizeof(blake3));
+   layout->flags = flags;
+   layout->non_variable_descriptor_buffer_size = non_variable_size;
+   layout->max_buffer_size = max_buffer_size;
+   BITSET_COPY(layout->dynamic_ubos, dynamic_ubos);
+   layout->descriptor_count = descriptor_count;
+   layout->binding_count = binding_count;
+   for (uint32_t b = 0; b < binding_count; b++) {
+      struct kk_descriptor_set_binding_layout *binding = &layout->binding[b];
+      binding->type = blob_read_uint32(blob);
+      binding->flags = blob_read_uint32(blob);
+      binding->array_size = blob_read_uint32(blob);
+      binding->offset = blob_read_uint32(blob);
+      binding->stride = blob_read_uint8(blob);
+      binding->dynamic_buffer_index = blob_read_uint8(blob);
+   }
+   return &layout->vk;
+}
+
+/* A vertex or fragment shader compiled on its own: what links read of it */
+static void
+kk_gpl_shader_serialize(struct blob *blob, const struct kk_shader *shader)
+{
+   blob_write_bytes(blob, &shader->info, sizeof(shader->info));
+   kk_msl_data_serialize(&shader->msl_data[shader->info.stage], blob);
+   blob_write_uint8(blob, shader->gpl_vertex_fetch);
+   blob_write_bytes(blob, shader->gpl_varying_types,
+                    sizeof(shader->gpl_varying_types));
+   blob_write_uint32(blob, shader->gpl_varyings_read);
+   blob_write_bytes(blob, shader->gpl_output_types,
+                    sizeof(shader->gpl_output_types));
+   blob_write_uint8(blob, shader->gpl_writes_depth);
+   blob_write_uint8(blob, shader->gpl_dual_source);
+}
+
+static struct kk_shader *
+kk_gpl_shader_deserialize(struct kk_device *dev, struct blob_reader *blob,
+                          mesa_shader_stage stage)
+{
+   struct kk_shader_info info;
+   blob_copy_bytes(blob, &info, sizeof(info));
+   if (blob->overrun || info.stage != stage)
+      return NULL;
+   struct kk_shader *shader = vk_shader_zalloc(
+      &dev->vk, &kk_shader_ops, stage, &dev->vk.alloc, sizeof(*shader));
+   if (shader == NULL)
+      return NULL;
+   shader->info = info;
+   if (kk_msl_data_deserialize(blob, &shader->msl_data[stage]) != VK_SUCCESS) {
+      kk_shader_destroy(&dev->vk, shader, &dev->vk.alloc);
+      return NULL;
+   }
+   shader->gpl_vertex_fetch = blob_read_uint8(blob);
+   blob_copy_bytes(blob, shader->gpl_varying_types,
+                   sizeof(shader->gpl_varying_types));
+   shader->gpl_varyings_read = blob_read_uint32(blob);
+   blob_copy_bytes(blob, shader->gpl_output_types,
+                   sizeof(shader->gpl_output_types));
+   shader->gpl_writes_depth = blob_read_uint8(blob);
+   shader->gpl_dual_source = blob_read_uint8(blob);
+   if (blob->overrun) {
+      kk_shader_destroy(&dev->vk, shader, &dev->vk.alloc);
+      return NULL;
+   }
+   return shader;
+}
+
+/* A pipeline library's shader: its struct kk_gpl_source. False (the shader
+ * is not cached) if it cannot be read back the same: a reason that may not
+ * hold in another run, or a set layout with a Y'CbCr conversion. */
+static bool
+kk_gpl_serialize(const struct kk_shader *shader, struct blob *blob)
+{
+   const struct kk_gpl_source *src = shader->gpl;
+   if (kk_gpl_reason_is_transient(src->vertex_blocker) ||
+       kk_gpl_reason_is_transient(src->fragment_at_link))
+      return false;
+   for (uint32_t i = 0; i < src->set_layout_count; i++) {
+      if (src->set_layouts[i] &&
+          !kk_gpl_set_layout_serializable(src->set_layouts[i]))
+         return false;
+   }
+
+   blob_write_uint32(blob, KK_GPL_BLOB_MAGIC);
+   blob_write_uint32(blob, KK_GPL_BLOB_VERSION);
+   blob_write_uint32(blob, shader->info.stage);
+   blob_write_uint64(blob, src->nir_size);
+   blob_write_bytes(blob, src->nir, src->nir_size);
+   blob_write_uint32(blob, src->flags);
+   blob_write_bytes(blob, &src->rs, sizeof(src->rs));
+   blob_write_uint32(blob, src->set_layout_count);
+   for (uint32_t i = 0; i < src->set_layout_count; i++) {
+      blob_write_uint8(blob, src->set_layouts[i] != NULL);
+      if (src->set_layouts[i])
+         kk_gpl_set_layout_serialize(blob, src->set_layouts[i]);
+   }
+   blob_write_uint32(blob, src->embedded_sampler_count);
+   blob_write_bytes(blob, src->embedded_samplers,
+                    src->embedded_sampler_count *
+                       sizeof(*src->embedded_samplers));
+   blob_write_uint32(blob, src->push_constant_range_count);
+   blob_write_bytes(blob, &src->push_constant_range,
+                    sizeof(src->push_constant_range));
+   blob_write_uint8(blob, src->sample_shading_enable);
+   blob_write_bytes(blob, &src->min_sample_shading,
+                    sizeof(src->min_sample_shading));
+   blob_write_uint32(blob, src->view_mask);
+
+   kk_gpl_reason_serialize(blob, src->vertex_blocker);
+   blob_write_uint8(blob, src->vertex != NULL);
+   if (src->vertex)
+      kk_gpl_shader_serialize(blob, src->vertex);
+   kk_gpl_reason_serialize(blob, src->fragment_fallback);
+   kk_gpl_reason_serialize(blob, src->fragment_at_link);
+   blob_write_uint8(blob, src->fragment != NULL);
+   if (src->fragment)
+      kk_gpl_shader_serialize(blob, src->fragment);
+   return !blob->out_of_memory;
+}
