  */
 
 #ifndef KK_GPL_H
@@ -89,6 +93,17 @@ struct kk_gpl_source {
    const char *fragment_at_link;
 };
 
+/* MESA_KK_DEBUG=memory: a device's live pipeline library shaders (each a
+ * struct kk_gpl_source), the shaders compiled on their own for them (and
+ * the empty fragment shader), their Metal libraries, and links. Updated
+ * with atomics. */
+struct kk_gpl_memory_stats {
+   int32_t sources;
+   int32_t shaders;
+   int32_t libraries;
+   int32_t links;
+};
+
 /* Graphics stages a link covers: vertex to fragment */
 #define KK_GPL_STAGES (MESA_SHADER_FRAGMENT + 1)
 
@@ -102,6 +117,11 @@ struct kk_gpl_cmd_state {
    BITSET_DECLARE(static_set, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX);
    /* Key of the link bound last */
    blake3_hash key;
+   /* Why that link compiled the whole pipeline (NULL if it did not), and the
+    * colour attachment count it was checked with: a draw whose key is the
+    * same in that mode needs no blocker checks (kk_gpl_resolve) */
+   const char *blocker;
+   uint32_t color_attachment_count;
    bool dirty;
 };
 
@@ -113,6 +133,9 @@ void kk_gpl_device_finish(struct kk_device *dev);
 /* Drops the links that use the source with this id */
 void kk_gpl_forget(struct kk_device *dev, uint64_t id);
 
+/* The device's counts, NULL without MESA_KK_EXPERIMENTAL=gpl */
+struct kk_gpl_memory_stats *kk_gpl_memory_stats(struct kk_device *dev);
+
 /* Before a draw: links the bound library shaders, if any, and binds the
