+++ b/src/kosmickrisp/vulkan/kk_gpl.h
@@ -21,6 +21,10 @@
  * serves every vertex input state and topology of a class. What they cannot
  * serve falls back to the whole compile, counted by reason ([kk-compile]
  * link lines).
+ *
+ * A pipeline library's shader serializes (pipeline caches) with its NIR and
+ * what compiling it needs, and with the MSL of the shaders compiled on their
