+      return kk_cmd_pool_get_allocator_retire(pool);
+
    if (KK_BATCH2(ALLOC)) {
       struct kk_cmd_allocator **all = util_dynarray_begin(free_list);
       for (unsigned i = n; i-- > 0u;) {
@@ -342,7 +529,11 @@ kk_CreateCommandPool(VkDevice _device,
 
    pool->metal.free_allocators = UTIL_DYNARRAY_INIT;
    pool->metal.allocator_count = 0u;
+   pool->metal.sealed_count = 0u;
    pool->metal.free_cmd_bufs = UTIL_DYNARRAY_INIT;
+   mtx_init(&pool->retire.lock, mtx_plain);
+   cnd_init(&pool->retire.done);
+   pool->retire.in_flight = 0u;
 
    list_inithead(&pool->free_bos);
    pool->num_free_bos = 0;
@@ -368,6 +559,7 @@ kk_cmd_pool_release_mtl_objects(struct kk_cmd_pool *pool)
    }
    util_dynarray_clear(&pool->metal.free_allocators);
