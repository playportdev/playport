 /* Playport: the recording this command buffer encoded is no longer needed
- * (it is reset, freed or begins again, so not pending). */
+ * (it is reset, freed or begins again, so not pending). With
+ * MESA_KK_EXPERIMENTAL=cmd_retire a recording released without a commit
+ * taints its allocator. */
 static void
 kk_cmd_release_allocator(struct kk_cmd_buffer *cmd)
 {
-   if (cmd->metal.encoded_in) {
-      assert(cmd->metal.encoded_in->users > 0u);
-      cmd->metal.encoded_in->users--;
+   struct kk_cmd_allocator *allocator = cmd->metal.encoded_in;
+   if (allocator) {
+      assert(p_atomic_read(&allocator->users) > 0u);
+      if (KK_EXPERIMENTAL(CMD_RETIRE) && !cmd->metal.committed &&
+          !allocator->tainted) {
+         allocator->tainted = true;
+         p_atomic_inc(&kk_cmd_retire_stats.allocator_taints);
+      }
+      p_atomic_dec(&allocator->users);
       cmd->metal.encoded_in = NULL;
    }
+   /* The next recording is uncommitted until kk_queue_commit */
+   cmd->metal.committed = false;
+}
+
+struct kk_cmd_retire *
+kk_cmd_detach_retire(struct kk_cmd_buffer *cmd)
+{
+   struct kk_cmd_pool *pool = kk_cmd_buffer_pool(cmd);
+   struct kk_device *dev = kk_cmd_pool_device(pool);
+   struct kk_cmd_retire *retire =
+      vk_zalloc(&dev->vk.alloc, sizeof(*retire), 8,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (retire == NULL)
+      return NULL;
+
+   retire->dev = dev;
+   retire->pool = pool;
+   list_inithead(&retire->bos);
+   list_inithead(&retire->large_bos);
+   list_splicetail(&cmd->uploader.bos, &retire->bos);
+   list_inithead(&cmd->uploader.bos);
+   list_splicetail(&cmd->large_bos, &retire->large_bos);
+   list_inithead(&cmd->large_bos);
+   list_for_each_entry(struct kk_cmd_bo, bo, &retire->bos, link)
+      retire->bytes += bo->bo->size_B;
+   list_for_each_entry(struct kk_cmd_bo, bo, &retire->large_bos, link)
+      retire->bytes += bo->bo->size_B;
+   retire->allocator = cmd->metal.encoded_in;
+   cmd->metal.encoded_in = NULL;
+   /* Its BOs may be another recording's once the commit completes */
+   cmd->uploader.bo = NULL;
+   cmd->uploader.offset = 0;
+
+   /* The census: the buffer holds none of it now */
+   cmd->census.upload_B = 0u;
+   cmd->census.alloc_added_B = 0u;
+
+   kk_cmd_pool_retire_add(pool, retire->bytes);
+   return retire;
 }
 
 static void
@@ -569,7 +632,7 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
 
       if (allocator == NULL)
          goto fail_allocator;
-      allocator->users++;
+      p_atomic_inc(&allocator->users);
       cmd->metal.encoded_in = allocator;
       cmd->metal.allocator = allocator->handle;
    }
