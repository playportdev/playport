+
+void
+kk_cmd_pool_retire_add(struct kk_cmd_pool *pool, uint64_t bytes)
+{
+   mtx_lock(&pool->retire.lock);
+   pool->retire.in_flight++;
+   mtx_unlock(&pool->retire.lock);
+   p_atomic_inc(&kk_cmd_retire_stats.in_flight);
+   p_atomic_add(&kk_cmd_retire_stats.in_flight_B, (int64_t)bytes);
+}
+
+void
+kk_cmd_pool_retire(struct kk_cmd_retire *retire)
+{
+   struct kk_cmd_pool *pool = retire->pool;
+   struct kk_device *dev = retire->dev;
+
+   /* The only submit of this recording completed: the GPU reads none of it.
+    * The hold drops first, because once in_flight reaches 0 the pool's
+    * thread may destroy the allocator. Its reset, if any, is the pool
+    * thread's, at a later Begin (kk_cmd_pool_get_allocator). */
+   if (retire->allocator)
+      p_atomic_dec(&retire->allocator->users);
+
+   mtx_lock(&pool->retire.lock);
+   kk_cmd_pool_free_bo_list_locked(pool, &retire->bos);
+   kk_cmd_pool_free_large_bo_list_locked(pool, &retire->large_bos);
+   assert(pool->retire.in_flight > 0u);
+   if (--pool->retire.in_flight == 0u)
+      cnd_broadcast(&pool->retire.done);
+   mtx_unlock(&pool->retire.lock);
+
+   p_atomic_dec(&kk_cmd_retire_stats.in_flight);
+   p_atomic_add(&kk_cmd_retire_stats.in_flight_B, -(int64_t)retire->bytes);
+   p_atomic_inc(&kk_cmd_retire_stats.retired);
+   p_atomic_add(&kk_cmd_retire_stats.retired_B, (int64_t)retire->bytes);
+   vk_free(&dev->vk.alloc, retire);
+}
+
+/* Before the pool's allocators or the pool itself go: a retirement still
+ * to run drops a hold on one of them and returns BOs to the pool */
+static void
+kk_cmd_pool_wait_retired(struct kk_cmd_pool *pool)
+{
+   if (!KK_EXPERIMENTAL(CMD_RETIRE))
+      return;
+   mtx_lock(&pool->retire.lock);
+   while (pool->retire.in_flight > 0u)
+      cnd_wait(&pool->retire.done, &pool->retire.lock);
+   mtx_unlock(&pool->retire.lock);
+}
+
 /* Playport, MESA_KK_BATCH2 "alloc": a pool makes up to this many allocators
  * so that one without users is usually free to reset; past it a recording
  * shares one that still has users, as before. Per-command-buffer allocators
@@ -266,6 +366,90 @@ kk_cmd_pool_new_allocator(struct kk_cmd_pool *pool)
    return allocator;
 }
 
+static void
+kk_cmd_pool_destroy_allocator(struct kk_cmd_pool *pool,
+                              struct kk_cmd_allocator *allocator)
+{
+   if (KK_DEBUG(MEMORY))
+      kk_allocators_remove(allocator->handle);
+   mtl_release(allocator->handle);
+   assert(pool->metal.allocator_count > 0u);
+   pool->metal.allocator_count--;
+   if (allocator->sealed)
+      pool->metal.sealed_count--;
+   vk_free(&pool->vk.alloc, allocator);
+}
+
+void
+kk_cmd_pool_end_allocator(struct kk_cmd_pool *pool,
+                          struct kk_cmd_allocator *allocator)
+{
+   if (allocator->sealed ||
+       mtl_command_allocator_allocated_size(allocator->handle) <=
+          KK_CMD_ALLOCATOR_SEAL_B)
+      return;
+   allocator->sealed = true;
+   pool->metal.sealed_count++;
+   p_atomic_inc(&kk_cmd_retire_stats.allocator_seals);
+}
+
+/* MESA_KK_EXPERIMENTAL=cmd_retire, on the pool's thread (for the queue's
+ * pool, under the queue mutex). In order:
+ * - a free allocator with no users is reset and taken; a tainted one is
+ *   destroyed instead, never reset;
+ * - with fewer than KK_CMD_POOL_UNSEALED_MAX unsealed allocators, a new one;
+ * - else the least-filled unsealed, untainted free one, which still has
+ *   users;
+ * - else (every unsealed one records now) a new one. */
+static struct kk_cmd_allocator *
+kk_cmd_pool_get_allocator_retire(struct kk_cmd_pool *pool)
+{
+   struct util_dynarray *free_list = &pool->metal.free_allocators;
+   struct kk_cmd_allocator *share = NULL;
+   uint64_t share_B = UINT64_MAX;
+
+   unsigned i = 0u;
+   while (i < util_dynarray_num_elements(free_list, struct kk_cmd_allocator *)) {
+      struct kk_cmd_allocator **all = util_dynarray_begin(free_list);
+      struct kk_cmd_allocator *allocator = all[i];
+      if (p_atomic_read(&allocator->users) == 0u) {
+         const unsigned n =
+            util_dynarray_num_elements(free_list, struct kk_cmd_allocator *);
+         all[i] = all[n - 1u];
+         (void)util_dynarray_pop(free_list, struct kk_cmd_allocator *);
+         if (allocator->tainted) {
+            kk_cmd_pool_destroy_allocator(pool, allocator);
+            p_atomic_inc(&kk_cmd_retire_stats.allocator_destroys);
+            continue;
+         }
+         mtl_command_allocator_reset(allocator->handle);
+         if (allocator->sealed) {
+            allocator->sealed = false;
+            pool->metal.sealed_count--;
+         }
+         p_atomic_inc(&kk_cmd_retire_stats.allocator_resets);
+         return allocator;
+      }
+      if (!allocator->sealed && !allocator->tainted) {
+         const uint64_t size =
+            mtl_command_allocator_allocated_size(allocator->handle);
+         if (size < share_B) {
+            share = allocator;
+            share_B = size;
+         }
+      }
+      i++;
+   }
+
+   if (share == NULL || pool->metal.allocator_count - pool->metal.sealed_count <
+                           KK_CMD_POOL_UNSEALED_MAX)
+      return kk_cmd_pool_new_allocator(pool);
+
+   util_dynarray_delete_unordered(free_list, struct kk_cmd_allocator *, share);
+   p_atomic_inc(&kk_cmd_retire_stats.allocator_shares);
+   return share;
+}
+
