 struct kk_gpl_cache {
    simple_mtx_t lock;
    /* blake3 key -> struct kk_gpl_link */
    struct hash_table *links;
+   /* Vertex and fragment source id pairs (kk_gpl_pair) whose separate link
+    * fell back -> the reason */
+   struct hash_table_u64 *unfit_pairs;
    /* For MESA_KK_DEBUG=compile */
