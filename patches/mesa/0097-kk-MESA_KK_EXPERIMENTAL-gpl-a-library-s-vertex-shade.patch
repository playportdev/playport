+static uint64_t
+kk_gpl_pair(struct kk_shader *const *sources)
+{
+   const uint64_t fs = sources[MESA_SHADER_FRAGMENT]
+                          ? sources[MESA_SHADER_FRAGMENT]->gpl->id
+                          : 0;
+   return sources[MESA_SHADER_VERTEX]->gpl->id << 32 ^ fs;
+}
+
+/* Counts a fallback; the count so far. Under the cache's lock. */
+static uint32_t
+kk_gpl_count_fallback(struct kk_gpl_cache *cache, const char *reason)
+{
+   for (uint32_t i = 0; i < KK_GPL_FALLBACK_REASONS; i++) {
+      if (cache->fallbacks[i].reason == NULL)
+         cache->fallbacks[i].reason = reason;
+      if (cache->fallbacks[i].reason == reason)
+         return ++cache->fallbacks[i].count;
+   }
+   return 0;
+}
