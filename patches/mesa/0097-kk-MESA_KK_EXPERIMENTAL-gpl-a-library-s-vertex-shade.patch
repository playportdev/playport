+/* Playport (PLA-424): the struct kk_vertex_fetch table of a vertex shader
+ * compiled for a pipeline library, from the dynamic vertex input state, in
+ * the attribute slots of kk_root_descriptor_table::draw.attrib_base. */
+static uint64_t
+kk_upload_vertex_fetch(struct kk_cmd_buffer *cmd, const struct kk_shader *vs)
+{
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+   struct kk_vertex_fetch fetch[KK_MAX_ATTRIBS] = {0};
+   unsigned slot = 0;
+   u_foreach_bit(i, vs->info.vs.attribs_read) {
+      if (dyn->vi->attributes_valid & BITFIELD_BIT(i)) {
+         const struct vk_vertex_attribute_state *attr = &dyn->vi->attributes[i];
+         const struct vk_vertex_binding_state *binding =
+            &dyn->vi->bindings[attr->binding];
+         fetch[slot].format =
+            kk_vertex_fetch_format(vk_format_to_pipe_format(attr->format));
+         if (binding->input_rate == VK_VERTEX_INPUT_RATE_INSTANCE)
+            fetch[slot].format |= KK_VERTEX_FETCH_INSTANCED;
+         fetch[slot].stride = dyn->vi_binding_strides[attr->binding];
+         fetch[slot].divisor = binding->divisor;
+      }
+      slot++;
+   }
+   return kk_pool_upload(cmd, fetch, MAX2(slot, 1u) * sizeof(fetch[0]), 16u)
+      .gpu;
+}
