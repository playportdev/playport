+const char *
+kk_gpl_vertex_blocker(struct kk_shader *const *sources,
+                      const struct vk_graphics_pipeline_state *state)
+{
+   const struct kk_shader *vs = sources[MESA_SHADER_VERTEX];
+   if (vs == NULL)
+      return "stages";
+   for (uint32_t s = MESA_SHADER_TESS_CTRL; s <= MESA_SHADER_GEOMETRY; s++) {
+      if (sources[s])
+         return "stages";
+   }
+   if (vs->gpl->vertex == NULL)
+      return vs->gpl->vertex_blocker;
+
+   if ((state->mv ? state->mv->view_mask : 0) != vs->gpl->view_mask)
+      return "multiview";
+
+   /* VK_POLYGON_MODE_POINT adds a geometry shader to triangles */
+   if (state->rs && state->rs->polygon_mode == VK_POLYGON_MODE_POINT &&
+       state->ia) {
+      enum mesa_prim prim = kk_topology_class(state->ia->primitive_topology);
+      if (prim == MESA_PRIM_TRIANGLES || prim == MESA_PRIM_TRIANGLES_ADJACENCY)
+         return "point-fill";
+   }
+
+   u_foreach_bit(i, vs->gpl->vertex->info.vs.attribs_read) {
+      if (state->vi && (state->vi->attributes_valid & BITFIELD_BIT(i)) &&
+          kk_vertex_fetch_format(vk_format_to_pipe_format(
+             state->vi->attributes[i].format)) == 0)
+         return "vertex-format";
+   }
+   return NULL;
