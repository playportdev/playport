+/* Playport (PLA-424): the runtime vertex fetch (struct kk_vertex_fetch). */
+
+uint32_t
+kk_vertex_fetch_format(enum pipe_format format)
+{
+   if (!kk_vbo_supports_format(format))
+      return 0;
+
+   const struct util_format_description *desc = util_format_description(format);
+   int chan = util_format_get_first_non_void_channel(format);
+   if (chan < 0)
+      return 0;
+   const struct util_format_channel_description *c = &desc->channel[chan];
+
+   enum kk_vertex_fetch_layout layout;
+   uint32_t channels = 1;
+   if (is_rg11_b10(desc)) {
+      layout = KK_VERTEX_FETCH_RG11B10F;
+   } else if (is_rgb10_a2(desc)) {
+      layout = KK_VERTEX_FETCH_RGB10A2;
+   } else {
+      switch (c->size) {
+      case 8:
+         layout = KK_VERTEX_FETCH_ARRAY8;
+         break;
+      case 16:
+         layout = KK_VERTEX_FETCH_ARRAY16;
+         break;
+      case 32:
+         layout = KK_VERTEX_FETCH_ARRAY32;
+         break;
+      default:
+         return 0;
+      }
+      channels = desc->nr_channels;
+      for (unsigned i = 0; i < channels; ++i) {
+         if (desc->channel[i].size != c->size ||
+             desc->channel[i].type != c->type)
+            return 0;
+      }
+   }
+
+   enum kk_vertex_fetch_numeric numeric;
+   switch (c->type) {
+   case UTIL_FORMAT_TYPE_UNSIGNED:
+      numeric = c->normalized     ? KK_VERTEX_FETCH_UNORM
+                : c->pure_integer ? KK_VERTEX_FETCH_UINT
+                                  : KK_VERTEX_FETCH_USCALED;
+      break;
+   case UTIL_FORMAT_TYPE_SIGNED:
+      numeric = c->normalized     ? KK_VERTEX_FETCH_SNORM
+                : c->pure_integer ? KK_VERTEX_FETCH_SINT
+                                  : KK_VERTEX_FETCH_SSCALED;
+      break;
+   case UTIL_FORMAT_TYPE_FLOAT:
+      if (layout != KK_VERTEX_FETCH_RG11B10F && c->size != 16 && c->size != 32)
+         return 0;
+      numeric = KK_VERTEX_FETCH_FLOAT;
+      break;
+   default:
+      return 0;
+   }
+
+   uint32_t swizzle = 0;
+   for (unsigned i = 0; i < 4; ++i) {
+      if (desc->swizzle[i] > PIPE_SWIZZLE_1)
+         return 0;
+      swizzle |= desc->swizzle[i] << (3 * i);
+   }
+
+   return layout << KK_VERTEX_FETCH_LAYOUT_SHIFT |
+          channels << KK_VERTEX_FETCH_CHANNELS_SHIFT |
+          numeric << KK_VERTEX_FETCH_NUMERIC_SHIFT |
+          swizzle << KK_VERTEX_FETCH_SWIZZLE_SHIFT;
+}
+
+static nir_def *
+fetch_field(nir_builder *b, nir_def *format, unsigned shift, unsigned bits)
+{
+   return nir_ubitfield_extract_imm(b, format, shift, bits);
+}
+
+/* The four 32-bit words the attribute's channels start from: one load per
+ * channel of the attribute's channel size, each within the attribute (a
+ * channel past the last one stored reads the last one again). The branches
+ * are uniform: every vertex of a draw has the same layout. */
+static void
+fetch_raw(nir_builder *b, nir_def *layout, nir_def *channels, nir_def *base,
+          nir_def *byte_offset, nir_def *raw[4])
+{
+   nir_def *last = nir_iadd_imm(b, nir_umax(b, channels, nir_imm_int(b, 1)), -1);
+   nir_def *a8[4], *a16[4], *a32[4];
+
+   nir_push_if(b, nir_ieq_imm(b, layout, KK_VERTEX_FETCH_ARRAY8));
+   for (unsigned c = 0; c < 4; ++c) {
+      nir_def *i = nir_iadd(b, byte_offset, nir_umin(b, nir_imm_int(b, c), last));
+      a8[c] = nir_u2u32(b, nir_load_constant_agx(b, 1, 8, base, i,
+                                                 .format = PIPE_FORMAT_R8_UINT,
+                                                 .base = 0u));
+   }
+   nir_push_else(b, NULL);
+   nir_push_if(b, nir_ieq_imm(b, layout, KK_VERTEX_FETCH_ARRAY16));
+   for (unsigned c = 0; c < 4; ++c) {
+      nir_def *i = nir_iadd(b, nir_ushr_imm(b, byte_offset, 1),
+                            nir_umin(b, nir_imm_int(b, c), last));
+      a16[c] = nir_u2u32(b, nir_load_constant_agx(b, 1, 16, base, i,
+                                                  .format = PIPE_FORMAT_R16_UINT,
+                                                  .base = 0u));
+   }
+   nir_push_else(b, NULL);
+   for (unsigned c = 0; c < 4; ++c) {
+      nir_def *i = nir_iadd(b, nir_ushr_imm(b, byte_offset, 2),
+                            nir_umin(b, nir_imm_int(b, c), last));
+      a32[c] = nir_load_constant_agx(b, 1, 32, base, i,
+                                     .format = PIPE_FORMAT_R32_UINT, .base = 0u);
+   }
+   nir_pop_if(b, NULL);
+   nir_def *wide[4];
+   for (unsigned c = 0; c < 4; ++c)
+      wide[c] = nir_if_phi(b, a16[c], a32[c]);
+   nir_pop_if(b, NULL);
+   for (unsigned c = 0; c < 4; ++c)
+      raw[c] = nir_if_phi(b, a8[c], wide[c]);
+}
+
+static void
+runtime_load(struct nir_builder *b, nir_intrinsic_instr *intr, bool robustness2)
+{
+   b->cursor = nir_instr_remove(&intr->instr);
+
+   nir_src *offset_src = nir_get_io_offset_src(intr);
+   assert(nir_src_is_const(*offset_src) && "no attribute indirects");
+   unsigned index = nir_intrinsic_base(intr) + nir_src_as_uint(*offset_src);
+
+   /* This attribute's slot of the layout */
+   nir_def *per_draw = nir_load_per_draw_ptr_kk(b, 1, 64);
+   nir_def *table = nir_load_global_constant(
+      b, 1, 64,
+      nir_iadd_imm(b, per_draw, offsetof(struct kk_per_draw_data, vertex_fetch)),
+      .align_mul = 8);
+   nir_def *entry = nir_load_global_constant(
+      b, 4, 32,
+      nir_iadd_imm(b, table, index * sizeof(struct kk_vertex_fetch)),
+      .align_mul = 16);
+   nir_def *format = nir_channel(b, entry, 0);
+   nir_def *stride = nir_channel(b, entry, 1);
+   nir_def *divisor = nir_channel(b, entry, 2);
+
+   nir_def *layout = fetch_field(b, format, KK_VERTEX_FETCH_LAYOUT_SHIFT, 3);
+   nir_def *channels = fetch_field(b, format, KK_VERTEX_FETCH_CHANNELS_SHIFT, 3);
+   nir_def *numeric = fetch_field(b, format, KK_VERTEX_FETCH_NUMERIC_SHIFT, 3);
+   nir_def *instanced =
+      nir_ine_imm(b, nir_iand_imm(b, format, KK_VERTEX_FETCH_INSTANCED), 0);
+
+   /* The element, as kk_nir_lower_vbo computes it for a known rate */
+   nir_def *per_instance = nir_bcsel(
+      b, nir_ieq_imm(b, divisor, 0), nir_imm_int(b, 0),
+      nir_udiv(b, nir_load_instance_id(b),
+               nir_umax(b, divisor, nir_imm_int(b, 1))));
+   per_instance = nir_iadd(b, per_instance, nir_load_base_instance(b));
+   nir_def *el = nir_bcsel(b, instanced, per_instance, nir_load_vertex_id(b));
+   BITSET_SET(b->shader->info.system_values_read, SYSTEM_VALUE_INSTANCE_ID);
+   BITSET_SET(b->shader->info.system_values_read, SYSTEM_VALUE_BASE_INSTANCE);
+   BITSET_SET(b->shader->info.system_values_read, SYSTEM_VALUE_VERTEX_ID);
+
+   nir_def *argbuf = nir_load_buffer_ptr_kk(b, 1, 64, .binding = 0);
+   nir_def *base = nir_load_global_constant(
+      b, 1, 64,
+      nir_iadd_imm(b, argbuf,
+                   offsetof(struct kk_root_descriptor_table,
+                            draw.attrib_base[index])));
+
+   nir_def *raw[4];
+   fetch_raw(b, layout, channels, base, nir_imul(b, el, stride), raw);
+
+   if (robustness2) {
+      nir_def *bounds = nir_load_global_constant(
+         b, 1, 32,
+         nir_iadd_imm(b, argbuf,
+                      offsetof(struct kk_root_descriptor_table,
+                               draw.attrib_clamps[index])));
+      nir_def *oob = nir_ult(b, bounds, el);
+      for (unsigned c = 0; c < 4; ++c)
+         raw[c] = nir_bcsel(b, oob, nir_imm_int(b, 0), raw[c]);
+   }
+
+   /* Channel bits, then the packed formats split into channels */
+   nir_def *packed10 = nir_ieq_imm(b, layout, KK_VERTEX_FETCH_RGB10A2);
+   nir_def *packed11 = nir_ieq_imm(b, layout, KK_VERTEX_FETCH_RG11B10F);
+   nir_def *size = nir_bcsel(
+      b, nir_ieq_imm(b, layout, KK_VERTEX_FETCH_ARRAY8), nir_imm_int(b, 8),
+      nir_bcsel(b, nir_ieq_imm(b, layout, KK_VERTEX_FETCH_ARRAY16),
+                nir_imm_int(b, 16), nir_imm_int(b, 32)));
+   nir_def *f11 = nir_format_unpack_11f11f10f(b, raw[0]);
+
+   const bool is_int_dest =
+      nir_alu_type_get_base_type(nir_intrinsic_dest_type(intr)) !=
+      nir_type_float;
+   nir_def *conv[4];
+   for (unsigned c = 0; c < 4; ++c) {
+      nir_def *bits =
+         nir_bcsel(b, packed10, nir_imm_int(b, c == 3 ? 2 : 10), size);
+      nir_def *v = nir_bcsel(
+         b, packed10, nir_ubitfield_extract_imm(b, raw[0], 10 * c, c == 3 ? 2 : 10),
+         raw[c]);
+
+      nir_def *shift = nir_isub(b, nir_imm_int(b, 32), bits);
+      nir_def *sext = nir_ishr(b, nir_ishl(b, v, shift), shift);
+      nir_def *umax = nir_ushr(b, nir_imm_int(b, ~0), shift);
+      nir_def *smax = nir_ushr(b, nir_imm_int(b, 0x7fffffff), shift);
+
+      nir_def *unorm = nir_fdiv(b, nir_u2f32(b, v), nir_u2f32(b, umax));
+      nir_def *snorm = nir_fmax(b, nir_fdiv(b, nir_i2f32(b, sext), nir_i2f32(b, smax)),
+                                nir_imm_float(b, -1.0f));
+      nir_def *flt = nir_bcsel(b, nir_ieq_imm(b, bits, 16),
+                               nir_f2f32(b, nir_u2u16(b, v)), v);
+
+      nir_def *r = unorm;
+      r = nir_bcsel(b, nir_ieq_imm(b, numeric, KK_VERTEX_FETCH_SNORM), snorm, r);
+      r = nir_bcsel(b, nir_ieq_imm(b, numeric, KK_VERTEX_FETCH_USCALED),
+                    nir_u2f32(b, v), r);
+      r = nir_bcsel(b, nir_ieq_imm(b, numeric, KK_VERTEX_FETCH_SSCALED),
+                    nir_i2f32(b, sext), r);
+      r = nir_bcsel(b, nir_ieq_imm(b, numeric, KK_VERTEX_FETCH_UINT), v, r);
+      r = nir_bcsel(b, nir_ieq_imm(b, numeric, KK_VERTEX_FETCH_SINT), sext, r);
+      r = nir_bcsel(b, nir_ieq_imm(b, numeric, KK_VERTEX_FETCH_FLOAT), flt, r);
+      conv[c] = nir_bcsel(b, packed11,
+                          c < 3 ? nir_channel(b, f11, c) : nir_imm_int(b, 0), r);
+   }
+
+   /* The format's swizzle, which also gives the missing components */
+   nir_def *one = nir_imm_int(b, is_int_dest ? 1 : fui(1.0f));
+   nir_def *channels_out[4] = {NULL};
+   for (unsigned i = 0; i < intr->num_components; ++i) {
+      unsigned c = nir_intrinsic_component(intr) + i;
+      nir_def *s =
+         fetch_field(b, format, KK_VERTEX_FETCH_SWIZZLE_SHIFT + 3 * c, 3);
+      nir_def *v = conv[0];
+      for (unsigned k = 1; k < 4; ++k)
+         v = nir_bcsel(b, nir_ieq_imm(b, s, k), conv[k], v);
+      v = nir_bcsel(b, nir_ieq_imm(b, s, PIPE_SWIZZLE_0), nir_imm_int(b, 0), v);
+      v = nir_bcsel(b, nir_ieq_imm(b, s, PIPE_SWIZZLE_1), one, v);
+
+      if (intr->def.bit_size == 16)
+         v = is_int_dest ? nir_u2u16(b, v) : nir_f2f16(b, v);
+      channels_out[i] = v;
+   }
+
+   nir_def *logical = nir_vec(b, channels_out, intr->num_components);
+   nir_def_rewrite_uses(&intr->def, logical);
+}
+
+bool
+kk_nir_lower_vbo_runtime(nir_shader *nir, bool robustness2)
+{
+   assert(nir->info.stage == MESA_SHADER_VERTEX);
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   /* Collected first: each load adds control flow. */
+   struct util_dynarray loads;
+   util_dynarray_init(&loads, NULL);
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic == nir_intrinsic_load_input)
+            util_dynarray_append_typed(&loads, nir_intrinsic_instr *, intr);
+      }
+   }
+
+   nir_builder b = nir_builder_create(impl);
+   util_dynarray_foreach(&loads, nir_intrinsic_instr *, intr)
+      runtime_load(&b, *intr, robustness2);
+
+   bool progress = loads.size > 0;
+   util_dynarray_fini(&loads);
+   return nir_progress(progress, impl, nir_metadata_none);
+}
