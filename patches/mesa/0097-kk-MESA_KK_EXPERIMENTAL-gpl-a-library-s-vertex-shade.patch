+/* Playport (PLA-424): vertex fetch from a layout given at draw time, for a
+ * vertex shader compiled for a pipeline library without its vertex input
+ * state. kk_per_draw_data::vertex_fetch points at one entry per attribute
+ * slot (the slots of kk_root_descriptor_table::draw.attrib_base), which
+ * kk_flush_dynamic_state fills from the dynamic vertex input state. */
+struct kk_vertex_fetch {
+   /* KK_VERTEX_FETCH_* fields; 0 for an attribute without a format */
+   uint32_t format;
+   uint32_t stride;
+   /* Instanced attributes: 0 gives every instance the first element */
+   uint32_t divisor;
+   uint32_t pad;
+};
+
+/* How the attribute is stored */
+enum kk_vertex_fetch_layout {
+   KK_VERTEX_FETCH_NONE = 0,
+   /* 1 to 4 channels of 8, 16 or 32 bits */
+   KK_VERTEX_FETCH_ARRAY8 = 1,
+   KK_VERTEX_FETCH_ARRAY16 = 2,
+   KK_VERTEX_FETCH_ARRAY32 = 3,
+   /* One 32-bit word: 10, 10, 10 and 2 bits, or 11, 11 and 10-bit floats */
+   KK_VERTEX_FETCH_RGB10A2 = 4,
+   KK_VERTEX_FETCH_RG11B10F = 5,
+};
+
+/* How its channels convert */
+enum kk_vertex_fetch_numeric {
+   KK_VERTEX_FETCH_UNORM = 0,
+   KK_VERTEX_FETCH_SNORM = 1,
+   KK_VERTEX_FETCH_USCALED = 2,
+   KK_VERTEX_FETCH_SSCALED = 3,
+   KK_VERTEX_FETCH_UINT = 4,
+   KK_VERTEX_FETCH_SINT = 5,
+   KK_VERTEX_FETCH_FLOAT = 6,
+};
+
+/* kk_vertex_fetch::format: the layout (3 bits), the channels stored (3
+ * bits), the numeric type (3 bits), the format's swizzle (PIPE_SWIZZLE_X to
+ * PIPE_SWIZZLE_1, 3 bits for each of 4 components) and the input rate. */
+#define KK_VERTEX_FETCH_LAYOUT_SHIFT   0
+#define KK_VERTEX_FETCH_CHANNELS_SHIFT 3
+#define KK_VERTEX_FETCH_NUMERIC_SHIFT  6
+#define KK_VERTEX_FETCH_SWIZZLE_SHIFT  9
+#define KK_VERTEX_FETCH_INSTANCED      (1u << 21)
+
+/* format's kk_vertex_fetch::format without the input rate, or 0 if the
+ * runtime fetch cannot read it */
+uint32_t kk_vertex_fetch_format(enum pipe_format format);
+
+bool kk_nir_lower_vbo_runtime(nir_shader *shader, bool robustness2);
+
 #ifdef __cplusplus
 } /* extern C */
