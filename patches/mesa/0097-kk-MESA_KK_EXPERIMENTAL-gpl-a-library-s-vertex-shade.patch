          slot++;
       }
       desc->root_dirty = true;
+      gfx->per_draw_data.vertex_fetch =
+         vs->gpl_vertex_fetch && vs->info.vs.attribs_read
+            ? kk_upload_vertex_fetch(cmd, vs)
+            : 0u;
    }
 
    if (desc->root_dirty)
@@ -1953,8 +1985,13 @@ static void
 kk_bind_per_draw_data(struct kk_cmd_buffer *cmd)
 {
