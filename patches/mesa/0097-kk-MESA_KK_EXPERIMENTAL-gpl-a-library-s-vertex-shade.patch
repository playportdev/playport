+/* Rewrites the VARYING_SLOT_VARn outputs (a vertex shader) or inputs (a
+ * fragment shader) of an array to one slot each, as nir_to_msl reads them.
+ * Sets *indirect if an offset is not constant. */
+static bool
+single_slot_varying(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   bool *indirect = data;
+   if (b->shader->info.stage == MESA_SHADER_VERTEX
+          ? intr->intrinsic != nir_intrinsic_store_output
+          : intr->intrinsic != nir_intrinsic_load_input &&
+               intr->intrinsic != nir_intrinsic_load_interpolated_input)
+      return false;
+
+   nir_io_semantics io = nir_intrinsic_io_semantics(intr);
+   if (io.location < VARYING_SLOT_VAR0 || io.location > VARYING_SLOT_VAR31)
+      return false;
+   nir_src *offset = nir_get_io_offset_src(intr);
+   if (!nir_src_is_const(*offset)) {
+      *indirect = true;
+      return false;
+   }
+   unsigned off = nir_src_as_uint(*offset);
+   if (off == 0 && io.num_slots == 1)
+      return false;
+
+   io.location += off;
+   io.num_slots = 1;
+   nir_intrinsic_set_io_semantics(intr, io);
+   nir_intrinsic_set_base(intr, nir_intrinsic_base(intr) + off);
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_src_rewrite(offset, nir_imm_int(b, 0));
+   return true;
+}
