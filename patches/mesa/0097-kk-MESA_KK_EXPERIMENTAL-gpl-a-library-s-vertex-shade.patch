+/* What a fragment shader reads of the vertex shader compiled on its own */
+struct kk_gpl_fs_match {
+   uint64_t written;
+   const uint8_t *types;
+   const char *blocker;
+};
+
+/* An input the vertex shader does not write reads 0, as linking would make
+ * it, and an input of another type than the output cannot link. */
+static bool
+match_fs_input(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_input &&
+       intr->intrinsic != nir_intrinsic_load_interpolated_input)
+      return false;
+
+   struct kk_gpl_fs_match *m = data;
+   nir_io_semantics io = nir_intrinsic_io_semantics(intr);
+   nir_src *offset = nir_get_io_offset_src(intr);
+   if (!nir_src_is_const(*offset)) {
+      m->blocker = "varying-indirect";
+      return false;
+   }
+   unsigned location = io.location + nir_src_as_uint(*offset);
+   if (location == VARYING_SLOT_CLIP_DIST0 ||
+       location == VARYING_SLOT_CLIP_DIST1 ||
+       location == VARYING_SLOT_CULL_DIST0 ||
+       location == VARYING_SLOT_CULL_DIST1) {
+      m->blocker = "fragment-clip-input";
+      return false;
+   }
+   if (!(m->written & BITFIELD64_BIT(location))) {
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def, nir_imm_zero(b, intr->def.num_components,
+                                               intr->def.bit_size));
+      return true;
+   }
+   if (location >= VARYING_SLOT_VAR0 && location <= VARYING_SLOT_VAR31 &&
+       m->types[location - VARYING_SLOT_VAR0] != nir_intrinsic_dest_type(intr))
+      m->blocker = "varying-type";
+   return false;
+}
