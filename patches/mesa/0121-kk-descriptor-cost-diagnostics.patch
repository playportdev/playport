+static VkResult ATTRIBUTE_NOINLINE
+kk_CreateDescriptorPool_diagnostic(VkDevice _device,
+                        const VkDescriptorPoolCreateInfo *pCreateInfo,
+                        const VkAllocationCallbacks *pAllocator,
+                        VkDescriptorPool *pDescriptorPool)
+{
