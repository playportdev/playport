+static void ATTRIBUTE_NOINLINE
+kk_CmdBindDescriptorSets2KHR_diagnostic(
+   VkCommandBuffer commandBuffer,
+   const VkBindDescriptorSetsInfoKHR *pBindDescriptorSetsInfo)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   struct kk_descriptor_scope scope =
+      kk_descriptor_begin(&dev->descriptor_stats, KK_DESCRIPTOR_BIND);
+   kk_descriptor_add(scope.stats, scope.op, KK_DESCRIPTOR_SETS,
+                     pBindDescriptorSetsInfo->descriptorSetCount);
+   kk_descriptor_add(scope.stats, scope.op, KK_DESCRIPTOR_DYNAMIC_OFFSETS,
+                     pBindDescriptorSetsInfo->dynamicOffsetCount);
+   kk_CmdBindDescriptorSets2KHR_impl(commandBuffer, pBindDescriptorSetsInfo);
+   kk_descriptor_end(scope, false);
+}
