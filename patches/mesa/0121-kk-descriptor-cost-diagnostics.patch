+static void ATTRIBUTE_NOINLINE
+kk_UpdateDescriptorSets_diagnostic(VkDevice device, uint32_t descriptorWriteCount,
+                        const VkWriteDescriptorSet *pDescriptorWrites,
+                        uint32_t descriptorCopyCount,
+                        const VkCopyDescriptorSet *pDescriptorCopies)
+{
+   VK_FROM_HANDLE(kk_device, dev, device);
+   struct kk_descriptor_scope scope =
+      kk_descriptor_begin(&dev->descriptor_stats, KK_DESCRIPTOR_UPDATE);
+   kk_descriptor_writes(scope, descriptorWriteCount, pDescriptorWrites);
+   kk_descriptor_add(scope.stats, scope.op, KK_DESCRIPTOR_COPY_RECORDS,
+                     descriptorCopyCount);
+   for (uint32_t i = 0; i < descriptorCopyCount; i++) {
+      const VkCopyDescriptorSet *copy = &pDescriptorCopies[i];
+      VK_FROM_HANDLE(kk_descriptor_set, src, copy->srcSet);
+      bool bytes = src->layout->binding[copy->srcBinding].type ==
+                   VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK;
+      kk_descriptor_add(
+         scope.stats, scope.op,
+         bytes ? KK_DESCRIPTOR_COPY_BYTES : KK_DESCRIPTOR_COPY_ELEMENTS,
+         copy->descriptorCount);
+   }
+   kk_UpdateDescriptorSets_impl(device, descriptorWriteCount, pDescriptorWrites,
+                                descriptorCopyCount, pDescriptorCopies);
+   kk_descriptor_end(scope, false);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_UpdateDescriptorSets(VkDevice device, uint32_t descriptorWriteCount,
+                        const VkWriteDescriptorSet *pDescriptorWrites,
+                        uint32_t descriptorCopyCount,
+                        const VkCopyDescriptorSet *pDescriptorCopies)
+{
+   if (KK_DEBUG(DESCRIPTOR_STATS))
+      kk_UpdateDescriptorSets_diagnostic(device, descriptorWriteCount, pDescriptorWrites, descriptorCopyCount, pDescriptorCopies);
+   else
+      kk_UpdateDescriptorSets_impl(device, descriptorWriteCount, pDescriptorWrites, descriptorCopyCount, pDescriptorCopies);
+}
