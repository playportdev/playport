+
+/* PLA-431: fixed per-device aggregates, no thread registry or hot-path lock. */
+#include <inttypes.h>
+#include <unistd.h>
+#include "kk_descriptor_stats.h"
+
+static const char *const descriptor_ops[KK_DESCRIPTOR_OP_COUNT] = {
+   "pool_create", "allocate",        "free", "pool_reset", "pool_destroy",
+   "update",      "template_update", "bind", "push",       "push_template",
+};
+static const char *const descriptor_fields[KK_DESCRIPTOR_FIELD_COUNT] = {
+   "calls",           "sets",         "write_records", "write_elements",
+   "write_bytes",     "copy_records", "copy_elements", "copy_bytes",
+   "dynamic_offsets", "pool_entries", "pool_elements", "pool_bytes",
+   "failures",        "timed_calls",  "elapsed_ticks", "max_ticks",
+   "clock_errors",    "active",
+};
+
+/* Saturate, rather than silently wrap. Once overflow is sticky the entire
+ * device sequence is unsuitable for interval subtraction, including frames. */
+static void
+descriptor_add_checked(struct kk_descriptor_stats *s, uint64_t *dst, uint64_t n)
+{
+   uint64_t old = __atomic_load_n(dst, __ATOMIC_RELAXED);
+   for (;;) {
+      bool overflow = n > UINT64_MAX - old;
+      uint64_t next = overflow ? UINT64_MAX : old + n;
+      if (overflow)
+         __atomic_store_n(&s->overflow, 1, __ATOMIC_RELAXED);
+      if (__atomic_compare_exchange_n(dst, &old, next, false, __ATOMIC_RELAXED,
+                                      __ATOMIC_RELAXED))
+         return;
+   }
+}
+
+void
+kk_descriptor_add(struct kk_descriptor_stats *s, enum kk_descriptor_op op,
+                  enum kk_descriptor_field field, uint64_t n)
+{
+   descriptor_add_checked(s, &s->values[op][field], n);
+}
+
+struct kk_descriptor_scope
+kk_descriptor_begin(struct kk_descriptor_stats *s, enum kk_descriptor_op op)
+{
+   /* Publication brackets are seq_cst, the payload counters relaxed. This
+    * does NOT turn a live snapshot into an event-time transaction. */
+   if (!__atomic_add_fetch(&s->entered, 1, __ATOMIC_SEQ_CST))
+      __atomic_store_n(&s->overflow, 1, __ATOMIC_RELAXED);
+   kk_descriptor_add(s, op, KK_DESCRIPTOR_ACTIVE, 1);
+   kk_descriptor_add(s, op, KK_DESCRIPTOR_CALLS, 1);
+   return (struct kk_descriptor_scope){s, op, kk_descriptor_clock()};
+}
+
+void
+kk_descriptor_end_at(struct kk_descriptor_scope scope, bool failed,
+                     uint64_t end)
+{
+   struct kk_descriptor_stats *s = scope.stats;
+   uint64_t *values = s->values[scope.op];
+   if (failed)
+      kk_descriptor_add(s, scope.op, KK_DESCRIPTOR_FAILURES, 1);
+   if (!scope.start || !end || end < scope.start) {
+      kk_descriptor_add(s, scope.op, KK_DESCRIPTOR_CLOCK_ERRORS, 1);
+   } else {
+      uint64_t elapsed = end - scope.start;
+      kk_descriptor_add(s, scope.op, KK_DESCRIPTOR_TIMED_CALLS, 1);
+      kk_descriptor_add(s, scope.op, KK_DESCRIPTOR_ELAPSED, elapsed);
+      uint64_t old =
+         __atomic_load_n(&values[KK_DESCRIPTOR_MAX], __ATOMIC_RELAXED);
+      while (old < elapsed && !__atomic_compare_exchange_n(
+                                 &values[KK_DESCRIPTOR_MAX], &old, elapsed,
+                                 false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+      }
+   }
+   __atomic_sub_fetch(&values[KK_DESCRIPTOR_ACTIVE], 1, __ATOMIC_RELAXED);
+   if (!__atomic_add_fetch(&s->completed, 1, __ATOMIC_SEQ_CST))
+      __atomic_store_n(&s->overflow, 1, __ATOMIC_RELAXED);
+}
+
+void
+kk_descriptor_end(struct kk_descriptor_scope scope, bool failed)
+{
+   kk_descriptor_end_at(scope, failed, kk_descriptor_clock());
+}
+
+void
+kk_descriptor_writes(struct kk_descriptor_scope scope, uint32_t count,
+                     const VkWriteDescriptorSet *writes)
+{
+   kk_descriptor_add(scope.stats, scope.op, KK_DESCRIPTOR_WRITE_RECORDS, count);
+   for (uint32_t i = 0; i < count; i++)
+      kk_descriptor_add(
+         scope.stats, scope.op,
+         writes[i].descriptorType == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK
+            ? KK_DESCRIPTOR_WRITE_BYTES
+            : KK_DESCRIPTOR_WRITE_ELEMENTS,
+         writes[i].descriptorCount);
+}
+
+void
+kk_descriptor_template(struct kk_descriptor_scope scope,
+                       const struct vk_descriptor_update_template *t)
+{
+   kk_descriptor_add(scope.stats, scope.op, KK_DESCRIPTOR_WRITE_RECORDS,
+                     t->entry_count);
+   for (uint32_t i = 0; i < t->entry_count; i++)
+      kk_descriptor_add(
+         scope.stats, scope.op,
+         t->entries[i].type == VK_DESCRIPTOR_TYPE_INLINE_UNIFORM_BLOCK
+            ? KK_DESCRIPTOR_WRITE_BYTES
+            : KK_DESCRIPTOR_WRITE_ELEMENTS,
+         t->entries[i].array_count);
+}
+
+void
+kk_descriptor_stats_init(struct kk_descriptor_stats *s)
+{
+   static uint64_t generation;
+   s->generation = __atomic_add_fetch(&generation, 1, __ATOMIC_RELAXED);
+   s->init_ns = kk_descriptor_clock();
+   s->overflow = !s->generation;
+   fprintf(
+      stderr,
+      "[kk-descriptor] v=1 component=kk kind=enabled pid=%ld device=%" PRIu64
+      " init_ticks=%" PRIu64
+      " hz=1000000000 clock=monotonic_elapsed cpu_clock=unsupported"
+      " coverage=legacy_entrypoints scopes=disjoint rollback=allocate"
+      " work=requested inline=bytes push=api_records failures=vk_result_or_command_error_at_exit"
+      " excluded=layout_template_lifecycle_constants_attachments_shader_loads"
+      " publication=relaxed_bracketed boundary=timestamp_range final_may_be_incomplete=1\n",
+      (long)getpid(), s->generation, s->init_ns);
+   /* Bounded raw samples, not a correction to operation durations. The outer
+    * empty measurement includes both checked reads and atomic publication.
+    * Calibration uses scratch counters, never contaminates operation totals. */
+   struct kk_descriptor_stats scratch = {0};
+   for (unsigned i = 0; i < 16; i++) {
+      scratch.values[KK_DESCRIPTOR_UPDATE][KK_DESCRIPTOR_CLOCK_ERRORS] = 0;
+      uint64_t a = kk_descriptor_clock(), b = kk_descriptor_clock();
+      uint64_t c = kk_descriptor_clock();
+      struct kk_descriptor_scope scope =
+         kk_descriptor_begin(&scratch, KK_DESCRIPTOR_UPDATE);
+      kk_descriptor_end(scope, false);
+      uint64_t d = kk_descriptor_clock();
+      bool adjacent_ok = a && b && b >= a;
+      bool empty_ok =
+         c && d && d >= c &&
+         scratch.values[KK_DESCRIPTOR_UPDATE][KK_DESCRIPTOR_CLOCK_ERRORS] == 0;
+      fprintf(
+         stderr,
+         "[kk-descriptor] v=1 component=kk kind=calibration pid=%ld device=%" PRIu64
+         " sample=%u hz=1000000000 reads=6 adjacent_ok=%u adjacent_ticks=%" PRIu64
+         " empty_ok=%u empty_ticks=%" PRIu64 "\n",
+         (long)getpid(), s->generation, i, adjacent_ok, adjacent_ok ? b - a : 0,
+         empty_ok, empty_ok ? d - c : 0);
+   }
+}
+
+void
+kk_descriptor_stats_log(struct kk_descriptor_stats *s, uint32_t frames,
+                        bool final)
+{
+   descriptor_add_checked(s, &s->frames, frames);
+   /* Serializes reports only. Never blocks an instrumented operation. */
+   if (__atomic_exchange_n(&s->logging, 1, __ATOMIC_ACQUIRE))
+      return;
+   uint64_t a = kk_descriptor_clock();
+   bool start_ok = s->init_ns && a &&
+                   (!s->last_log_ns || a >= s->last_log_ns);
+   if (!start_ok) {
+      descriptor_add_checked(s, &s->report_clock_errors, 1);
+      /* With no usable clock, emit one failure report rather than one per
+       * submit. The final report still exposes all failed report attempts. */
+      if (!final && s->reported_clock_failure) {
+         __atomic_store_n(&s->logging, 0, __ATOMIC_RELEASE);
+         return;
+      }
+   }
+   s->reported_clock_failure = !start_ok;
+   if (!final && start_ok && s->last_log_ns &&
+       a - s->last_log_ns < 1000000000) {
+      __atomic_store_n(&s->logging, 0, __ATOMIC_RELEASE);
+      return;
+   }
+   descriptor_add_checked(s, &s->snapshot, 1);
+   uint64_t entered0 = __atomic_load_n(&s->entered, __ATOMIC_SEQ_CST);
+   uint64_t completed0 = __atomic_load_n(&s->completed, __ATOMIC_SEQ_CST);
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   uint64_t values[KK_DESCRIPTOR_OP_COUNT][KK_DESCRIPTOR_FIELD_COUNT];
+   for (unsigned op = 0; op < KK_DESCRIPTOR_OP_COUNT; op++)
+      for (unsigned f = 0; f < KK_DESCRIPTOR_FIELD_COUNT; f++)
+         values[op][f] = __atomic_load_n(&s->values[op][f], __ATOMIC_RELAXED);
+   uint64_t presented = __atomic_load_n(&s->frames, __ATOMIC_RELAXED);
+   uint32_t overflow = __atomic_load_n(&s->overflow, __ATOMIC_RELAXED);
+   __atomic_thread_fence(__ATOMIC_SEQ_CST);
+   uint64_t entered1 = __atomic_load_n(&s->entered, __ATOMIC_SEQ_CST);
+   uint64_t completed1 = __atomic_load_n(&s->completed, __ATOMIC_SEQ_CST);
+   uint64_t b = kk_descriptor_clock();
+   bool quiet = entered0 == completed0 && entered0 == entered1 &&
+                entered0 == completed1 && !overflow;
+   bool clock_ok = start_ok && b && b >= a;
+   if (!b || (a && b < a))
+      descriptor_add_checked(s, &s->report_clock_errors, 1);
+   flockfile(stderr);
+   for (unsigned op = 0; op < KK_DESCRIPTOR_OP_COUNT; op++) {
+      fprintf(
+         stderr,
+         "[kk-descriptor] v=1 component=kk kind=snapshot pid=%ld device=%" PRIu64
+         " init_ticks=%" PRIu64 " ts_begin=%" PRIu64 " ts_end=%" PRIu64
+         " hz=1000000000 snapshot=%" PRIu64 " frames=%" PRIu64
+         " final=%u clock_ok=%u report_clock_errors=%" PRIu64 " overflow=%u"
+         " quiescent=%u entered_before=%" PRIu64 " completed_before=%" PRIu64
+         " entered_after=%" PRIu64 " completed_after=%" PRIu64 " op=%s",
+         (long)getpid(), s->generation, s->init_ns, a, b, s->snapshot,
+         presented, final, clock_ok, s->report_clock_errors, overflow, quiet, entered0, completed0,
+         entered1, completed1, descriptor_ops[op]);
+      for (unsigned f = 0; f < KK_DESCRIPTOR_FIELD_COUNT; f++)
+         fprintf(stderr, " %s=%" PRIu64, descriptor_fields[f], values[op][f]);
+      fputc('\n', stderr);
+   }
+   funlockfile(stderr);
+   s->last_log_ns = a;
+   __atomic_store_n(&s->logging, 0, __ATOMIC_RELEASE);
+}
