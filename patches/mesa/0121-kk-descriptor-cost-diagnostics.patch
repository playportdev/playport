diff --git a/src/kosmickrisp/vulkan/kk_descriptor_stats.h b/src/kosmickrisp/vulkan/kk_descriptor_stats.h
new file mode 100644
index 0000000..77a4aa3
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_descriptor_stats.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef KK_DESCRIPTOR_STATS_H
+#define KK_DESCRIPTOR_STATS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "c11/time.h"
+#include "vulkan/vulkan_core.h"
+#include "vk_descriptor_update_template.h"
+
+/* Disjoint Vulkan entrypoint scopes. Common-runtime wrappers aren't timed;
+ * allocation rollback uses the untimed free implementation. These elapsed
+ * sums overlap client Vulkan envelopes and must never be added to them. */
+enum kk_descriptor_op {
+   KK_DESCRIPTOR_POOL_CREATE,
+   KK_DESCRIPTOR_ALLOCATE,
+   KK_DESCRIPTOR_FREE,
+   KK_DESCRIPTOR_POOL_RESET,
+   KK_DESCRIPTOR_POOL_DESTROY,
+   KK_DESCRIPTOR_UPDATE,
+   KK_DESCRIPTOR_TEMPLATE_UPDATE,
+   KK_DESCRIPTOR_BIND,
+   KK_DESCRIPTOR_PUSH,
+   KK_DESCRIPTOR_PUSH_TEMPLATE,
+   KK_DESCRIPTOR_OP_COUNT,
+};
+
+enum kk_descriptor_field {
+   KK_DESCRIPTOR_CALLS,
+   KK_DESCRIPTOR_SETS,
+   KK_DESCRIPTOR_WRITE_RECORDS,
+   KK_DESCRIPTOR_WRITE_ELEMENTS,
+   KK_DESCRIPTOR_WRITE_BYTES,
+   KK_DESCRIPTOR_COPY_RECORDS,
+   KK_DESCRIPTOR_COPY_ELEMENTS,
+   KK_DESCRIPTOR_COPY_BYTES,
+   KK_DESCRIPTOR_DYNAMIC_OFFSETS,
+   KK_DESCRIPTOR_POOL_ENTRIES,
+   KK_DESCRIPTOR_POOL_ELEMENTS,
+   KK_DESCRIPTOR_POOL_BYTES,
+   KK_DESCRIPTOR_FAILURES,
+   KK_DESCRIPTOR_TIMED_CALLS,
+   KK_DESCRIPTOR_ELAPSED,
+   KK_DESCRIPTOR_MAX,
+   KK_DESCRIPTOR_CLOCK_ERRORS,
+   KK_DESCRIPTOR_ACTIVE,
+   KK_DESCRIPTOR_FIELD_COUNT,
+};
+
+struct kk_descriptor_stats {
+   uint64_t values[KK_DESCRIPTOR_OP_COUNT][KK_DESCRIPTOR_FIELD_COUNT];
+   uint64_t generation, init_ns, frames, last_log_ns, snapshot;
+   uint64_t entered, completed, report_clock_errors;
+   bool reported_clock_failure;
+   uint32_t overflow, logging;
+};
+
+struct kk_descriptor_scope {
+   struct kk_descriptor_stats *stats;
+   enum kk_descriptor_op op;
+   uint64_t start;
+};
+
+/* Unlike os_time_get_nano, check EVERY primitive read. Zero is an invalid
+ * timestamp, never a valid failed-clock duration. No CPU clock is available. */
+static inline uint64_t
+kk_descriptor_clock_value(int status, int64_t sec, int64_t nsec)
+{
+   if (status != TIME_MONOTONIC || sec < 0 || nsec < 0 || nsec >= 1000000000 ||
+       (uint64_t)sec > (UINT64_MAX - (uint64_t)nsec) / 1000000000)
+      return 0;
+   return (uint64_t)sec * 1000000000 + nsec;
+}
+
+static inline uint64_t
+kk_descriptor_clock(void)
+{
+   struct timespec ts = {0};
+   int status = timespec_get(&ts, TIME_MONOTONIC);
+   return kk_descriptor_clock_value(status, ts.tv_sec, ts.tv_nsec);
+}
+
+void kk_descriptor_add(struct kk_descriptor_stats *s, enum kk_descriptor_op op,
+                       enum kk_descriptor_field field, uint64_t n);
+struct kk_descriptor_scope kk_descriptor_begin(struct kk_descriptor_stats *s,
+                                               enum kk_descriptor_op op);
+void kk_descriptor_end_at(struct kk_descriptor_scope scope, bool failed,
+                          uint64_t end);
+void kk_descriptor_end(struct kk_descriptor_scope scope, bool failed);
+void kk_descriptor_writes(struct kk_descriptor_scope scope, uint32_t count,
+                          const VkWriteDescriptorSet *writes);
+void kk_descriptor_template(struct kk_descriptor_scope scope,
+                            const struct vk_descriptor_update_template *t);
+void kk_descriptor_stats_init(struct kk_descriptor_stats *s);
+void kk_descriptor_stats_log(struct kk_descriptor_stats *s, uint32_t frames,
+                             bool final);
+#endif
