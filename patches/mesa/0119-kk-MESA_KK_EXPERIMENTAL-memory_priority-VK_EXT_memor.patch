From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Fri, 23 Oct 2026 07:13:07 +0200
Subject: [PATCH] kk: MESA_KK_EXPERIMENTAL=memory_priority,
 VK_EXT_memory_priority and VK_EXT_pageable_device_local_memory accepted

With MESA_KK_EXPERIMENTAL=memory_priority, KosmicKrisp advertises
VK_EXT_memory_priority and VK_EXT_pageable_device_local_memory with
their memoryPriority and pageableDeviceLocalMemory features, as DXVK and
vkd3d-proton use them for residency hints. Without the flag nothing
changes.

A priority changes nothing. Every heap stays in the device's one
residency set for its lifetime: Metal has no priority for an allocation,
taking a heap out of the set would fault any later GPU access to it, and
setPurgeableState may discard the contents, which a priority must not.
vkAllocateMemory accepts a VkMemoryPriorityAllocateInfoEXT and
vkSetDeviceMemoryPriorityEXT does nothing. With MESA_KK_DEBUG=memory the
[kk-mem] line counts both ("priority allocations=N sets=N"). No shader
or cache key changes.

Linear: PLA-431
Class: feature
Evidence: docs/evidence/2026-10-22-kk-memory-priority-host.md
Offered-upstream: not yet
---
 src/kosmickrisp/vulkan/kk_bo.c              | 13 +++++++++++--
 src/kosmickrisp/vulkan/kk_bo.h              |  5 +++++
 src/kosmickrisp/vulkan/kk_debug.c           |  1 +
 src/kosmickrisp/vulkan/kk_debug.h           |  4 ++++
 src/kosmickrisp/vulkan/kk_device_memory.c   | 20 ++++++++++++++++++++
 src/kosmickrisp/vulkan/kk_physical_device.c |  9 +++++++++
 6 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_bo.c b/src/kosmickrisp/vulkan/kk_bo.c
index 45e725e..a83c86b 100644
--- a/src/kosmickrisp/vulkan/kk_bo.c
+++ b/src/kosmickrisp/vulkan/kk_bo.c
@@ -7,6 +7,7 @@
 #include "kk_bo.h"
 
 #include "kk_cmd_pool.h"
+#include "kk_debug.h"
 #include "kk_device.h"
 #include "kk_gpl.h"
 #include "kk_physical_device.h"
@@ -146,6 +147,14 @@ kk_memory_log(struct kk_device *dev)
                p_atomic_read(&gpl_stats->shaders),
                p_atomic_read(&gpl_stats->libraries),
                p_atomic_read(&gpl_stats->links));
+   /* Playport (PLA-431): with MESA_KK_EXPERIMENTAL=memory_priority, the
+    * priorities the application gave, which change nothing */
+   char priority[64] = "";
+   if (KK_EXPERIMENTAL(MEMORY_PRIORITY))
+      snprintf(priority, sizeof(priority),
+               " | priority allocations=%d sets=%d",
+               p_atomic_read(&kk_memory_stats.priority_allocations),
+               p_atomic_read(&kk_memory_stats.priority_sets));
 #define KK_BO_FIELD(kind)                                                      \
    p_atomic_read(&kk_memory_stats.bo_count[KK_BO_KIND_##kind]),                \
       p_atomic_read(&kk_memory_stats.bo_bytes[KK_BO_KIND_##kind]) / mib
@@ -153,7 +162,7 @@ kk_memory_log(struct kk_device *dev)
            "[kk-mem] metal=%.0f bos=%.0f memory=%d/%.0f internal=%d/%.0f "
            "descriptor=%d/%.0f query=%d/%.0f command=%d/%.0f | shaders=%d "
            "pipelines=%d msl=%.1f | cache raw=%d/%.1f precomp=%d/%.1f | "
-           "allocators=%u/%.1f MiB%s\n",
+           "allocators=%u/%.1f MiB%s%s\n",
            mtl_device_current_allocated_size(dev->mtl_handle) / mib,
            bo_total / mib, KK_BO_FIELD(DEVICE_MEMORY), KK_BO_FIELD(INTERNAL),
            KK_BO_FIELD(DESCRIPTOR_POOL), KK_BO_FIELD(QUERY),
@@ -164,7 +173,7 @@ kk_memory_log(struct kk_device *dev)
            p_atomic_read(&vk_pipeline_cache_stats.raw_bytes) / mib,
            p_atomic_read(&vk_pipeline_cache_stats.precomp_count),
            p_atomic_read(&vk_pipeline_cache_stats.precomp_bytes) / mib,
-           allocator_count, allocator_bytes / mib, gpl);
+           allocator_count, allocator_bytes / mib, gpl, priority);
 #undef KK_BO_FIELD
 }
 
diff --git a/src/kosmickrisp/vulkan/kk_bo.h b/src/kosmickrisp/vulkan/kk_bo.h
index bf1fdcf..b23705a 100644
--- a/src/kosmickrisp/vulkan/kk_bo.h
+++ b/src/kosmickrisp/vulkan/kk_bo.h
@@ -38,6 +38,11 @@ struct kk_memory_stats {
    int32_t shaders;
    int32_t pipelines;
    int64_t msl_bytes;
+   /* Playport (PLA-431): with MESA_KK_EXPERIMENTAL=memory_priority,
+    * allocations given a VkMemoryPriorityAllocateInfoEXT and
+    * vkSetDeviceMemoryPriorityEXT calls */
+   int32_t priority_allocations;
+   int32_t priority_sets;
 };
 
 extern struct kk_memory_stats kk_memory_stats;
diff --git a/src/kosmickrisp/vulkan/kk_debug.c b/src/kosmickrisp/vulkan/kk_debug.c
index 5eeae2d..6671be9 100644
--- a/src/kosmickrisp/vulkan/kk_debug.c
+++ b/src/kosmickrisp/vulkan/kk_debug.c
@@ -60,6 +60,7 @@ const struct debug_named_value experimental_flags[] = {
    {"narrow_barriers", KK_EXPERIMENTAL_NARROW_BARRIERS},
    {"ds_dont_care", KK_EXPERIMENTAL_DS_DONT_CARE},
    {"ubo_vec4_bounds", KK_EXPERIMENTAL_UBO_VEC4_BOUNDS},
+   {"memory_priority", KK_EXPERIMENTAL_MEMORY_PRIORITY},
    {NULL, 0},
 };
 
diff --git a/src/kosmickrisp/vulkan/kk_debug.h b/src/kosmickrisp/vulkan/kk_debug.h
index 222116f..e61b2e7 100644
--- a/src/kosmickrisp/vulkan/kk_debug.h
+++ b/src/kosmickrisp/vulkan/kk_debug.h
@@ -238,6 +238,10 @@ enum kk_experimental {
     * not one checked load per component (kk_nir_merge_ubo_loads); within
     * the 64-byte robustUniformBufferAccessSizeAlignment the device reports */
    KK_EXPERIMENTAL_UBO_VEC4_BOUNDS = 1ull << 15,
+   /* Playport (PLA-431): advertise VK_EXT_memory_priority and
+    * VK_EXT_pageable_device_local_memory. Their priorities are accepted and
+    * change nothing: every heap stays in the device's one residency set */
+   KK_EXPERIMENTAL_MEMORY_PRIORITY = 1ull << 16,
 };
 
 extern enum kk_experimental kk_mesa_experimental_flags;
diff --git a/src/kosmickrisp/vulkan/kk_device_memory.c b/src/kosmickrisp/vulkan/kk_device_memory.c
index d0c0c64..c1e78b9 100644
--- a/src/kosmickrisp/vulkan/kk_device_memory.c
+++ b/src/kosmickrisp/vulkan/kk_device_memory.c
@@ -161,6 +161,14 @@ kk_AllocateMemory(VkDevice device, const VkMemoryAllocateInfo *pAllocateInfo,
    if (KK_DEBUG(DRAWS) || kk_frame_probe_s > 0)
       kk_debug_record_memory(dev, mem->bo);
 
+   /* Playport (PLA-431): Metal has no priority for an allocation, and every
+    * heap stays in the device's residency set, so a priority changes
+    * nothing; MESA_KK_DEBUG=memory counts them */
+   if (KK_DEBUG(MEMORY) &&
+       vk_find_struct_const(pAllocateInfo->pNext,
+                            MEMORY_PRIORITY_ALLOCATE_INFO_EXT))
+      p_atomic_inc(&kk_memory_stats.priority_allocations);
+
    *pMem = kk_device_memory_to_handle(mem);
 
    return VK_SUCCESS;
@@ -482,6 +490,18 @@ kk_GetDeviceMemoryCommitment(VkDevice device, VkDeviceMemory _mem,
    *pCommittedMemoryInBytes = mem->bo->size_B;
 }
 
+/* Playport (PLA-431): VK_EXT_pageable_device_local_memory. The memory stays
+ * resident whatever its priority: taking a heap out of the residency set
+ * would fault any later GPU access to it, and setPurgeableState may discard
+ * the contents, which a priority must not. */
+VKAPI_ATTR void VKAPI_CALL
+kk_SetDeviceMemoryPriorityEXT(VkDevice device, VkDeviceMemory memory,
+                              float priority)
+{
+   if (KK_DEBUG(MEMORY))
+      p_atomic_inc(&kk_memory_stats.priority_sets);
+}
+
 #ifdef VK_USE_PLATFORM_METAL_EXT
 VKAPI_ATTR VkResult VKAPI_CALL
 kk_GetMemoryMetalHandleEXT(
diff --git a/src/kosmickrisp/vulkan/kk_physical_device.c b/src/kosmickrisp/vulkan/kk_physical_device.c
index f8b1f19..5b0ab8e 100644
--- a/src/kosmickrisp/vulkan/kk_physical_device.c
+++ b/src/kosmickrisp/vulkan/kk_physical_device.c
@@ -222,9 +222,12 @@ kk_get_device_extensions(const struct kk_instance *instance,
       .EXT_load_store_op_none = true,
       .EXT_map_memory_placed = true,
       .EXT_memory_budget = true,
+      /* Playport: only with MESA_KK_EXPERIMENTAL=memory_priority (PLA-431) */
+      .EXT_memory_priority = KK_EXPERIMENTAL(MEMORY_PRIORITY),
       .EXT_multi_draw = true,
       .EXT_mutable_descriptor_type = true,
       .EXT_nested_command_buffer = true,
+      .EXT_pageable_device_local_memory = KK_EXPERIMENTAL(MEMORY_PRIORITY),
       .EXT_post_depth_coverage = true,
       .EXT_primitive_restart_index = true,
       .EXT_primitive_topology_list_restart = true,
@@ -524,6 +527,9 @@ kk_get_device_features(
       .memoryMapRangePlaced = false,
       .memoryUnmapReserve = true,
 
+      /* VK_EXT_memory_priority, Playport (PLA-431) */
+      .memoryPriority = KK_EXPERIMENTAL(MEMORY_PRIORITY),
+
       /* VK_EXT_multi_draw */
       .multiDraw = true,
 
@@ -532,6 +538,9 @@ kk_get_device_features(
       .nestedCommandBufferRendering = true,
       .nestedCommandBufferSimultaneousUse = true,
 
+      /* VK_EXT_pageable_device_local_memory, Playport (PLA-431) */
+      .pageableDeviceLocalMemory = KK_EXPERIMENTAL(MEMORY_PRIORITY),
+
       /* VK_EXT_primitive_restart_index */
       .primitiveRestartIndex = true,
 
