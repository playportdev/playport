From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Wed, 21 Oct 2026 02:23:08 +0200
Subject: [PATCH] kk: keep the depth/stencil states compiled for dynamic state;
 [kk-gpu] counts begins, passes and those compiles

A pipeline with no static depth/stencil state (every colour-only
pipeline: the runtime gives it none) takes its state from dynamic
state, and kk_flush_pipeline compiled a new Metal depth/stencil state
(3-4 descriptor objects and newDepthStencilState) whenever that state
was dirty, which every new render encoder makes it. RDR2 runs about
3.4 draws per render pass, so this ran for most passes.

The device now keeps the states it compiled, up to 64, keyed by every
field kk_compile_ds_state reads, and a lookup returns another
reference, so the command buffer's release is unchanged.
MESA_KK_DS_CACHE=0 compiles every time, as before.

With MESA_KK_DEBUG=gpu the [kk-gpu] line also gives, per interval,
command buffer begins, those with ONE_TIME_SUBMIT (without it the
dispatch layer records every command a second time), render passes
begun and depth/stencil states compiled.

Linear: PLA-364
Class: feature
Evidence: docs/evidence/2026-10-21-rdr2-cs-fastpath-and-heap.md
Offered-upstream: no
---
 src/kosmickrisp/vulkan/kk_cmd_buffer.c |  8 +++
 src/kosmickrisp/vulkan/kk_cmd_draw.c   |  3 ++
 src/kosmickrisp/vulkan/kk_debug.h      |  7 +++
 src/kosmickrisp/vulkan/kk_device.c     |  6 +++
 src/kosmickrisp/vulkan/kk_device.h     | 15 ++++++
 src/kosmickrisp/vulkan/kk_queue.c      |  9 +++-
 src/kosmickrisp/vulkan/kk_shader.c     | 72 +++++++++++++++++++++++++-
 7 files changed, 117 insertions(+), 3 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index b17e9d9..7283f5f 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -9,6 +9,7 @@
 
 #include "kk_buffer.h"
 #include "kk_cmd_pool.h"
+#include "kk_debug.h"
 #include "kk_descriptor_set_layout.h"
 #include "kk_entrypoints.h"
 #include "kk_format.h"
@@ -20,6 +21,8 @@
 #include "kosmickrisp/bridge/mtl_encoder.h"
 #include "kosmickrisp/bridge/vk_to_mtl_map.h"
 
+#include "util/u_atomic.h"
+
 #include "vk_alloc.h"
 #include "vk_common_entrypoints.h"
 #include "vk_format.h"
@@ -214,6 +217,11 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
    vk_command_buffer_begin(&cmd->vk, pBeginInfo);
    cmd->one_time_submit =
       pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+   if (KK_DEBUG(GPU)) {
+      p_atomic_inc(&kk_gpu_begins);
+      if (cmd->one_time_submit)
+         p_atomic_inc(&kk_gpu_once_begins);
+   }
 
    /* vk_command_buffer_begin will reset the command buffer meaning the
     * allocator may be returned to the pool. Request a new one. */
diff --git a/src/kosmickrisp/vulkan/kk_cmd_draw.c b/src/kosmickrisp/vulkan/kk_cmd_draw.c
index f08f72f..3b9bf00 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_draw.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_draw.c
@@ -263,6 +263,9 @@ kk_CmdBeginRendering(VkCommandBuffer commandBuffer,
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
    struct vk_dynamic_graphics_state *dyn = &cmd->vk.dynamic_graphics_state;
 
+   if (KK_DEBUG(GPU))
+      p_atomic_inc(&kk_gpu_passes);
+
    struct kk_rendering_state *render = &cmd->state.gfx.render;
 
    memset(render, 0, sizeof(*render));
diff --git a/src/kosmickrisp/vulkan/kk_debug.h b/src/kosmickrisp/vulkan/kk_debug.h
index 1ca9386..0ff9729 100644
--- a/src/kosmickrisp/vulkan/kk_debug.h
+++ b/src/kosmickrisp/vulkan/kk_debug.h
@@ -5,6 +5,8 @@
 #ifndef KK_DEBUG_H
 #define KK_DEBUG_H 1
 
+#include <stdint.h>
+
 enum kk_debug {
    /* Print out the NIR from the compiler */
    KK_DEBUG_NIR = 1ull << 0,
@@ -51,6 +53,11 @@ enum kk_debug {
 
 extern enum kk_debug kk_mesa_debug_flags;
 
+/* Counters [kk-gpu] logs with KK_DEBUG(GPU) and clears each line: command
+ * buffer begins, those with ONE_TIME_SUBMIT, render passes begun, and Metal
+ * depth/stencil states compiled for dynamic state (kk_gpu_log). */
+extern uint32_t kk_gpu_begins, kk_gpu_once_begins, kk_gpu_passes, kk_gpu_ds_compiles;
+
 #define KK_DEBUG(flag) unlikely(kk_mesa_debug_flags &KK_DEBUG_##flag)
 
 enum kk_experimental {
diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index c0cf073..ee3d1db 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -343,6 +343,9 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
    if (result != VK_SUCCESS)
       goto fail_meta;
 
+   simple_mtx_init(&dev->ds_states.lock, mtx_plain);
+   dev->ds_states.count = 0u;
+
    result = kk_init_sampler_heap(dev, &dev->samplers);
    if (result != VK_SUCCESS)
       goto fail_query_table;
@@ -410,6 +413,9 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
    kk_device_finish_meta(dev);
    kk_device_finish_lib(dev);
    kk_query_table_finish(dev, &dev->occlusion_queries);
+   for (uint32_t i = 0u; i < dev->ds_states.count; i++)
+      mtl_release(dev->ds_states.entries[i].state);
+   simple_mtx_destroy(&dev->ds_states.lock);
    kk_destroy_sampler_heap(dev, &dev->samplers);
    vk_pipeline_cache_destroy(dev->vk.mem_cache, NULL);
 
diff --git a/src/kosmickrisp/vulkan/kk_device.h b/src/kosmickrisp/vulkan/kk_device.h
index 19b2715..204e096 100644
--- a/src/kosmickrisp/vulkan/kk_device.h
+++ b/src/kosmickrisp/vulkan/kk_device.h
@@ -18,6 +18,7 @@
 #include "kosmickrisp/clc/kk_precompiled_shader.h"
 #include "libkk_shaders.h"
 
+#include "util/simple_mtx.h"
 #include "util/u_dynarray.h"
 
 #include "vk_device.h"
@@ -76,6 +77,8 @@ struct kk_precompiled_cache {
    struct kk_precompiled_shader shaders[LIBKK_NUM_PROGRAMS];
 };
 
+#define KK_DS_STATE_CACHE_SIZE 64u
+
 struct kk_device {
    struct vk_device vk;
 
@@ -111,6 +114,18 @@ struct kk_device {
    struct kk_bo *sink_bo;
    uint64_t zero_page_addr;
    uint64_t scratch_page_addr;
+
+   /* Compiled depth/stencil states for dynamic depth/stencil state, by their
+    * packed fields (kk_compile_depth_stencil_state). Each holds one reference;
+    * a lookup hands out another. Full, a state is compiled uncached. */
+   struct {
+      simple_mtx_t lock;
+      uint32_t count;
+      struct {
+         uint64_t key[2];
+         mtl_depth_stencil_state *state;
+      } entries[KK_DS_STATE_CACHE_SIZE];
+   } ds_states;
 };
 
 #define KK_SINK_PAGE_SIZE 16384u
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 22e9d02..186a966 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -51,6 +51,8 @@ static struct {
    uint64_t present_wait_ns;
 } kk_gpu = {.lock = SIMPLE_MTX_INITIALIZER};
 
+uint32_t kk_gpu_begins, kk_gpu_once_begins, kk_gpu_passes, kk_gpu_ds_compiles;
+
 static void
 kk_gpu_wsi_totals(uint64_t *acquire_wait_ns, uint64_t *present_wait_ns)
 {
@@ -109,7 +111,8 @@ kk_gpu_log(uint32_t frames, int64_t submit_ns, bool final)
    fprintf(stderr,
            "[kk-gpu] %.2f s%s: frames=%u fps=%.1f gpu=%.1f ms busy=%.1f ms "
            "(%.0f%%) cbs=%u gpu/frame=%.2f ms acquire=%.1f ms "
-           "present-wait=%.1f ms submit=%.1f ms\n",
+           "present-wait=%.1f ms submit=%.1f ms begins=%u once=%u passes=%u "
+           "ds-compiles=%u\n",
            span_s, final ? " final" : "", kk_gpu.frames,
            span_s > 0.0 ? kk_gpu.frames / span_s : 0.0, kk_gpu.gpu_s * 1000.0,
            kk_gpu.busy_s * 1000.0,
@@ -117,7 +120,9 @@ kk_gpu_log(uint32_t frames, int64_t submit_ns, bool final)
            kk_gpu.cmd_buffers, per_frame,
            (acquire_wait_ns - kk_gpu.acquire_wait_ns) / 1e6,
            (present_wait_ns - kk_gpu.present_wait_ns) / 1e6,
-           kk_gpu.submit_ns / 1e6);
+           kk_gpu.submit_ns / 1e6, p_atomic_xchg(&kk_gpu_begins, 0u),
+           p_atomic_xchg(&kk_gpu_once_begins, 0u), p_atomic_xchg(&kk_gpu_passes, 0u),
+           p_atomic_xchg(&kk_gpu_ds_compiles, 0u));
    fflush(stderr);
    kk_gpu.start_ns = now;
    kk_gpu.acquire_wait_ns = acquire_wait_ns;
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index d45dc84..6b6b1e6 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -34,6 +34,7 @@
 #include "util/simple_mtx.h"
 #include "util/os_time.h"
 #include "util/u_atomic.h"
+#include "util/u_debug.h"
 
 #include <dirent.h>
 #include <errno.h>
@@ -2246,6 +2247,8 @@ kk_compile_compute_pipeline(struct kk_device *device,
 static mtl_depth_stencil_state *
 kk_compile_ds_state(struct kk_device *device, struct kk_shader_info *info)
 {
+   if (KK_DEBUG(GPU))
+      p_atomic_inc(&kk_gpu_ds_compiles);
    mtl_stencil_descriptor *front = NULL;
    mtl_stencil_descriptor *back = NULL;
    mtl_depth_stencil_descriptor *descriptor =
@@ -2331,6 +2334,50 @@ kk_gather_ds_info(const struct vk_depth_stencil_state *ds, bool has_depth,
    }
 }
 
+/* Playport: dynamic depth/stencil state compiled a new Metal state (3-4
+ * descriptor objects and newDepthStencilState) at every dirty flush, and every
+ * new render encoder dirties it: a colour-only pipeline has no static state,
+ * so each of its passes compiled one. The device keeps the states it compiled,
+ * by their packed fields. MESA_KK_DS_CACHE=0 compiles every time, as before. */
+static bool
+kk_ds_cache_enabled(void)
+{
+   static int enabled = -1;
+   if (enabled < 0)
+      enabled = !debug_get_bool_option("MESA_KK_DS_CACHE", true) ? 0 : 1;
+   return enabled;
+}
+
+static uint64_t
+kk_ds_stencil_key(const uint8_t depth_fail, const uint8_t fail, const uint8_t pass,
+                  const uint8_t compare, const uint8_t compare_mask,
+                  const uint8_t write_mask)
+{
+   return (uint64_t)depth_fail | ((uint64_t)fail << 8) | ((uint64_t)pass << 16) |
+          ((uint64_t)compare << 24) | ((uint64_t)compare_mask << 32) |
+          ((uint64_t)write_mask << 40);
+}
+
+/* Every field kk_compile_ds_state reads, packed. */
+static void
+kk_ds_state_key(const struct kk_shader_info *info, uint64_t key[2])
+{
+   key[0] = (uint64_t)info->vs.has_depth_write |
+            ((uint64_t)info->vs.has_stencil_test << 1) |
+            ((uint64_t)(uint32_t)info->vs.depth_compare_op << 8);
+   key[1] = 0u;
+   if (info->vs.has_stencil_test) {
+      key[0] |= kk_ds_stencil_key(info->vs.stencil_front.depth_fail, info->vs.stencil_front.fail,
+                                  info->vs.stencil_front.pass, info->vs.stencil_front.compare,
+                                  info->vs.stencil_front.compare_mask,
+                                  info->vs.stencil_front.write_mask) << 16;
+      key[1] = kk_ds_stencil_key(info->vs.stencil_back.depth_fail, info->vs.stencil_back.fail,
+                                 info->vs.stencil_back.pass, info->vs.stencil_back.compare,
+                                 info->vs.stencil_back.compare_mask,
+                                 info->vs.stencil_back.write_mask);
+   }
+}
+
 mtl_depth_stencil_state *
 kk_compile_depth_stencil_state(struct kk_device *device,
                                const struct vk_depth_stencil_state *ds,
@@ -2338,7 +2385,30 @@ kk_compile_depth_stencil_state(struct kk_device *device,
 {
    struct kk_shader_info info = {};
    kk_gather_ds_info(ds, has_depth, has_stencil, &info);
-   return kk_compile_ds_state(device, &info);
+   if (!kk_ds_cache_enabled())
+      return kk_compile_ds_state(device, &info);
+
+   uint64_t key[2];
+   kk_ds_state_key(&info, key);
+   simple_mtx_lock(&device->ds_states.lock);
+   for (uint32_t i = 0u; i < device->ds_states.count; i++) {
+      if (device->ds_states.entries[i].key[0] == key[0] &&
+          device->ds_states.entries[i].key[1] == key[1]) {
+         mtl_depth_stencil_state *state =
+            mtl_retain(device->ds_states.entries[i].state);
+         simple_mtx_unlock(&device->ds_states.lock);
+         return state;
+      }
+   }
+   mtl_depth_stencil_state *state = kk_compile_ds_state(device, &info);
+   if (state && device->ds_states.count < KK_DS_STATE_CACHE_SIZE) {
+      uint32_t i = device->ds_states.count++;
+      device->ds_states.entries[i].key[0] = key[0];
+      device->ds_states.entries[i].key[1] = key[1];
+      device->ds_states.entries[i].state = mtl_retain(state);
+   }
+   simple_mtx_unlock(&device->ds_states.lock);
+   return state;
 }
 
 /* Copies all msl shader data to the vertex and gathers information for pipeline
