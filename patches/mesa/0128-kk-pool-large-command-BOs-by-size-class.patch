    vk_free(&pool->vk.alloc, bo);
 }
 
+/* Command pools are externally synchronized, including recording into any
+ * of their command buffers. No queue lock or global cache is needed. The
+ * caller returns BOs only at reset/free/begin, never at End or submission. */
+static void
+kk_cmd_pool_remove_large_bo(struct kk_cmd_pool *pool, struct kk_cmd_bo *bo)
+{
+   list_del(&bo->link);
+   list_del(&bo->lru_link);
+   assert(pool->large_free_bytes >= bo->bo->size_B);
+   pool->large_free_bytes -= bo->bo->size_B;
+}
+
+static void
+kk_cmd_pool_trim_large_bos(struct kk_cmd_pool *pool, uint64_t limit)
+{
+   while (pool->large_free_bytes > limit) {
+      struct kk_cmd_bo *bo =
+         list_first_entry(&pool->large_lru, struct kk_cmd_bo, lru_link);
+      kk_cmd_pool_remove_large_bo(pool, bo);
+      kk_cmd_bo_destroy(pool, bo);
+   }
+}
+
+VkResult
+kk_cmd_pool_alloc_large_bo(struct kk_cmd_pool *pool, uint32_t size_B,
+                            uint32_t alignment_B, struct kk_cmd_bo **bo_out)
+{
+   unsigned size_class = KK_CMD_LARGE_BO_CLASSES;
+   uint32_t allocation_size = size_B;
+   const uint32_t required = MAX2(size_B, alignment_B);
+   if (required <= KK_CMD_LARGE_BO_MAX) {
+      size_class = 0;
+      allocation_size = 1u << KK_CMD_LARGE_BO_MIN_LOG2;
+      while (allocation_size < required) {
+         allocation_size <<= 1;
+         size_class++;
+      }
+      /* Best fit: prefer the smallest available class that meets the ask. */
+      for (unsigned i = size_class; i < KK_CMD_LARGE_BO_CLASSES; i++) {
+         if (list_is_empty(&pool->large_free_bos[i]))
+            continue;
+         struct kk_cmd_bo *bo =
+            list_first_entry(&pool->large_free_bos[i], struct kk_cmd_bo, link);
+         kk_cmd_pool_remove_large_bo(pool, bo);
+         kk_bo_set_kind(bo->bo, KK_BO_KIND_COMMAND);
+         p_atomic_inc(&kk_memory_stats.command_large_reuses);
+         *bo_out = bo;
+         return VK_SUCCESS;
+      }
+   }
+
+   VkResult result =
+      kk_cmd_bo_create(pool, allocation_size, alignment_B, bo_out);
+   /* Idle cached heaps must not turn a fresh allocation into an OOM. */
+   if (result == VK_ERROR_OUT_OF_DEVICE_MEMORY && pool->large_free_bytes) {
+      kk_cmd_pool_trim_large_bos(pool, 0);
+      result = kk_cmd_bo_create(pool, allocation_size, alignment_B, bo_out);
+   }
+   if (result == VK_SUCCESS) {
+      (*bo_out)->size_class = size_class;
+      p_atomic_inc(&kk_memory_stats.command_large_allocations);
+   }
+   return result;
+}
+
+void
+kk_cmd_pool_free_large_bo_list(struct kk_cmd_pool *pool, struct list_head *bos)
+{
+   list_for_each_entry_safe(struct kk_cmd_bo, bo, bos, link) {
+      list_del(&bo->link);
+      if (bo->size_class >= KK_CMD_LARGE_BO_CLASSES ||
+          bo->bo->size_B > KK_CMD_LARGE_BO_MAX) {
+         kk_cmd_bo_destroy(pool, bo);
+         continue;
+      }
+      kk_bo_set_kind(bo->bo, KK_BO_KIND_COMMAND_POOL);
+      list_addtail(&bo->link, &pool->large_free_bos[bo->size_class]);
+      list_addtail(&bo->lru_link, &pool->large_lru);
+      pool->large_free_bytes += bo->bo->size_B;
+      kk_cmd_pool_trim_large_bos(pool, KK_CMD_LARGE_BO_CACHE_MAX);
+   }
+}
+
 static void
 kk_cmd_pool_destroy_bos(struct kk_cmd_pool *pool)
 {
@@ -98,6 +183,8 @@ kk_cmd_pool_destroy_bos(struct kk_cmd_pool *pool)
       kk_cmd_bo_destroy(pool, bo);
 
    list_inithead(&pool->free_bos);
+   pool->num_free_bos = 0;
+   kk_cmd_pool_trim_large_bos(pool, 0);
 }
 
 VkResult
@@ -115,7 +202,7 @@ kk_cmd_pool_alloc_bo(struct kk_cmd_pool *pool, struct kk_cmd_bo **bo_out)
       return VK_SUCCESS;
    }
 
-   return kk_cmd_bo_create(pool, bo_out);
+   return kk_cmd_bo_create(pool, KK_CMD_BO_SIZE, 0, bo_out);
 }
 
 void
@@ -123,7 +210,7 @@ kk_cmd_pool_free_bo_list(struct kk_cmd_pool *pool, struct list_head *bos)
 {
    list_for_each_entry_safe(struct kk_cmd_bo, bo, bos, link) {
       list_del(&bo->link);
-      if (pool->num_free_bos > KK_CMD_POOL_BO_MAX) {
+      if (pool->num_free_bos >= KK_CMD_POOL_BO_MAX) {
          kk_cmd_bo_destroy(pool, bo);
       } else {
          list_addtail(&bo->link, &pool->free_bos);
@@ -237,6 +324,11 @@ kk_CreateCommandPool(VkDevice _device,
    pool->metal.free_cmd_bufs = UTIL_DYNARRAY_INIT;
 
    list_inithead(&pool->free_bos);
+   pool->num_free_bos = 0;
+   for (unsigned i = 0; i < KK_CMD_LARGE_BO_CLASSES; i++)
+      list_inithead(&pool->large_free_bos[i]);
+   list_inithead(&pool->large_lru);
+   pool->large_free_bytes = 0;
 
    *pCmdPool = kk_cmd_pool_to_handle(pool);
 
@@ -292,6 +384,7 @@ kk_ResetCommandPool(VkDevice _device, VkCommandPool commandPool,
       return result;
 
    if (flags & VK_COMMAND_POOL_RESET_RELEASE_RESOURCES_BIT) {
+      kk_cmd_pool_destroy_bos(pool);
       kk_cmd_pool_release_mtl_objects(pool);
    }
 
@@ -313,4 +406,6 @@ kk_cmd_pool_set_label(struct kk_cmd_pool *pool, const char *label)
 {
    list_for_each_entry(struct kk_cmd_bo, bo, &pool->free_bos, link)
       kk_bo_set_label(bo->bo, label);
+   list_for_each_entry(struct kk_cmd_bo, bo, &pool->large_lru, lru_link)
+      kk_bo_set_label(bo->bo, label);
 }
