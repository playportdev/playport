--- a/src/kosmickrisp/vulkan/kk_cmd_pool.h
+++ b/src/kosmickrisp/vulkan/kk_cmd_pool.h
@@ -17,12 +17,24 @@
 #define KK_CMD_BO_SIZE     (1024 * 128)
 #define KK_CMD_POOL_BO_MAX 32
 
+/* Large command BOs: 256 KiB through 16 MiB, capped per pool, not per
+ * command buffer. Only idle BOs count against this limit. */
+#define KK_CMD_LARGE_BO_MIN_LOG2 18
+#define KK_CMD_LARGE_BO_CLASSES 7
+#define KK_CMD_LARGE_BO_MAX (1u << 24)
+#define KK_CMD_LARGE_BO_CACHE_MAX (64u * 1024 * 1024)
+
 /* Recyclable command buffer BO, used for both push buffers and upload */
 struct kk_cmd_bo {
    struct kk_bo *bo;
 
    /** Link in kk_cmd_pool::free_bos or kk_cmd_buffer::bos */
    struct list_head link;
+
+   /* Large BOs only: second link in the pool's oldest-returned-first LRU.
+    * size_class == KK_CMD_LARGE_BO_CLASSES means uncacheable. */
+   struct list_head lru_link;
+   unsigned size_class;
 };
 
 struct kk_cmd_pool {
@@ -32,6 +44,10 @@ struct kk_cmd_pool {
    struct list_head free_bos;
    uint32_t num_free_bos;
 
+   struct list_head large_free_bos[KK_CMD_LARGE_BO_CLASSES];
+   struct list_head large_lru;
+   uint64_t large_free_bytes;
+
    struct {
       /* struct kk_cmd_allocator *: not recording now */
       struct util_dynarray free_allocators;
@@ -68,6 +84,12 @@ VkResult kk_cmd_pool_alloc_bo(struct kk_cmd_pool *pool,
 
 void kk_cmd_pool_free_bo_list(struct kk_cmd_pool *pool, struct list_head *bos);
 
+VkResult kk_cmd_pool_alloc_large_bo(struct kk_cmd_pool *pool, uint32_t size_B,
+                                    uint32_t alignment_B,
+                                    struct kk_cmd_bo **bo_out);
+void kk_cmd_pool_free_large_bo_list(struct kk_cmd_pool *pool,
+                                    struct list_head *bos);
+
 struct kk_cmd_allocator *kk_cmd_pool_get_allocator(struct kk_cmd_pool *pool);
 
 /* The live Metal command allocators and the memory they hold, for the
