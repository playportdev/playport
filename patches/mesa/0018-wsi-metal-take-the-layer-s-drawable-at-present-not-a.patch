From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Thu, 8 Oct 2026 12:00:00 +0200
Subject: [PATCH] wsi/metal: take the layer's drawable at present, not at
 acquire

The Metal WSI took a CAMetalDrawable from the layer in
vkAcquireNextImageKHR, which blocks until the display frees one. The
application renders into the swapchain image, not into the drawable;
only the blit at present needs the drawable. DXVK acquires the next
image right after each present, on the thread that submits every
command buffer, so on an iPhone at 120 Hz the next frame's work reached
the GPU only once a drawable came free, and the frame then had to be
drawn, blitted and presented before its refresh: 1.2 % of frames missed
a refresh (p99 16.67 ms) where DXMT, which asks for its drawable when it
encodes the present pass after the frame's work, missed 0.4 %.

Acquire now hands out the next image once the blit of its previous
present is done (its throttle fence, which the drawable used to imply),
and a new optional swapchain hook, prepare_present, called by
wsi_common_queue_present after its throttle wait and before the blit is
submitted, takes the drawable, binds it and records the blit.

Class: ios-port
Evidence: docs/evidence/2026-10-08-vulkan-perf-p99.md
Offered-upstream: no
---
 src/vulkan/wsi/wsi_common.c         |  3 +
 src/vulkan/wsi/wsi_common_metal.c   | 88 +++++++++++++++++++----------
 src/vulkan/wsi/wsi_common_private.h |  5 ++
 3 files changed, 65 insertions(+), 31 deletions(-)

diff --git a/src/vulkan/wsi/wsi_common.c b/src/vulkan/wsi/wsi_common.c
index f40f078..8f69437 100644
--- a/src/vulkan/wsi/wsi_common.c
+++ b/src/vulkan/wsi/wsi_common.c
@@ -2477,6 +2477,9 @@ wsi_common_queue_present(const struct wsi_device *wsi,
          if (results[i] != VK_SUCCESS)
             continue;
       }
+
+      if (swapchain->prepare_present)
+         results[i] = swapchain->prepare_present(swapchain, image_index);
    }
 
    /* Gather up all the semaphores we need to wait on */
diff --git a/src/vulkan/wsi/wsi_common_metal.c b/src/vulkan/wsi/wsi_common_metal.c
index 049cde2..8a4b026 100644
--- a/src/vulkan/wsi/wsi_common_metal.c
+++ b/src/vulkan/wsi/wsi_common_metal.c
@@ -609,6 +609,15 @@ wsi_cmd_blit_image_to_image(const struct wsi_swapchain *chain,
    return result;
 }
 
+/* An image is handed out at acquire without a drawable, and the drawable is
+ * taken from the layer only at present, after the frame's own work has been
+ * submitted: the application renders into the swapchain image, not into the
+ * drawable, and only the blit at present needs it. Taking the drawable at
+ * acquire made a caller that acquires right after presenting (DXVK) wait for
+ * the display to free one before it could submit the next frame's work, so
+ * that work started on the GPU only when a drawable came free and the frame
+ * then had to be drawn, blitted and presented before its refresh. DXMT asks
+ * for its drawable when it encodes the present pass, after the frame. */
 static VkResult
 wsi_metal_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
                                        const VkAcquireNextImageInfoKHR *info,
@@ -616,38 +625,54 @@ wsi_metal_swapchain_acquire_next_image(struct wsi_swapchain *wsi_chain,
 {
    struct wsi_metal_swapchain *chain =
       (struct wsi_metal_swapchain *)wsi_chain;
-   struct timespec start_time, end_time;
-   struct timespec rel_timeout;
-
-   timespec_from_nsec(&rel_timeout, info->timeout);
-
-   clock_gettime(CLOCK_MONOTONIC, &start_time);
-   timespec_add(&end_time, &rel_timeout, &start_time);
-
-   while (1) {
-      /* Try to acquire an drawable. Unfortunately we might block for up to 1 second. */
-      CAMetalDrawable *drawable = wsi_metal_layer_acquire_drawable(chain->surface->pLayer);
-      if (drawable) {
-         uint32_t i = (chain->current_image_index++) % chain->base.image_count;
-         struct wsi_metal_image *image = &chain->images[i];
-         *image_index = i;
-         image->drawable = drawable;
-         if (!wsi_chain->wsi->sw) {
-            chain->base.wsi->metal.bind_drawable_to_vkimage(image->base.blit.image,
-                                                            image->drawable);
-            /* Since present images will only be backed by MTLTextures after acquisition,
-             * we need to re-record the command buffer so it uses the new drawable. */
-            wsi_cmd_blit_image_to_image(wsi_chain, &wsi_chain->image_info, &image->base);
-         }
-         return VK_SUCCESS;
-      }
-
-      /* Check for timeout. */
-      struct timespec current_time;
-      clock_gettime(CLOCK_MONOTONIC, &current_time);
-      if (timespec_after(&current_time, &end_time))
-         return VK_NOT_READY;
+   const struct wsi_device *wsi = wsi_chain->wsi;
+   uint32_t i = chain->current_image_index % chain->base.image_count;
+
+   /* The image is free once the blit of its previous present is done. Its
+    * throttle fence (wsi_common_queue_present) is signalled with that blit;
+    * taking the drawable used to imply it, since a drawable comes free only
+    * after a later frame was shown. */
+   if (wsi_chain->fences[i] != VK_NULL_HANDLE) {
+      VkResult result = wsi->WaitForFences(wsi_chain->device, 1,
+                                           &wsi_chain->fences[i], true,
+                                           info->timeout);
+      if (result == VK_TIMEOUT)
+         return info->timeout ? VK_TIMEOUT : VK_NOT_READY;
+      if (result != VK_SUCCESS)
+         return result;
    }
+
+   chain->current_image_index++;
+   *image_index = i;
+   return VK_SUCCESS;
+}
+
+static VkResult
+wsi_metal_swapchain_prepare_present(struct wsi_swapchain *wsi_chain,
+                                    uint32_t image_index)
+{
+   struct wsi_metal_swapchain *chain =
+      (struct wsi_metal_swapchain *)wsi_chain;
+   struct wsi_metal_image *image = &chain->images[image_index];
+
+   assert(image->drawable == NULL);
+
+   /* nextDrawable waits up to a second for the display to free one; the
+    * present cannot go ahead without it, so wait as long as it takes, as an
+    * acquire with no timeout did before. */
+   CAMetalDrawable *drawable;
+   while (!(drawable = wsi_metal_layer_acquire_drawable(chain->surface->pLayer)))
+      ;
+
+   image->drawable = drawable;
+   if (wsi_chain->wsi->sw)
+      return VK_SUCCESS;
+
+   chain->base.wsi->metal.bind_drawable_to_vkimage(image->base.blit.image,
+                                                   image->drawable);
+   /* The drawable's MTLTexture is fixed into the blit when it is recorded. */
+   return wsi_cmd_blit_image_to_image(wsi_chain, &wsi_chain->image_info,
+                                      &image->base);
 }
 
 static VkResult
@@ -1003,6 +1028,7 @@ wsi_metal_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
    chain->base.release_images = wsi_metal_swapchain_release_images;
    chain->base.set_present_mode = wsi_metal_swapchain_set_present_mode;
    chain->base.queue_present = wsi_metal_swapchain_queue_present;
+   chain->base.prepare_present = wsi_metal_swapchain_prepare_present;
    chain->base.wait_for_present = wsi_metal_swapchain_wait_for_present;
    chain->base.wait_for_present2 = wsi_metal_swapchain_wait_for_present;
    chain->base.set_hdr_metadata = wsi_metal_swapchain_set_hdr_metadata;
diff --git a/src/vulkan/wsi/wsi_common_private.h b/src/vulkan/wsi/wsi_common_private.h
index 3d2cd7d..c56fd1b 100644
--- a/src/vulkan/wsi/wsi_common_private.h
+++ b/src/vulkan/wsi/wsi_common_private.h
@@ -311,6 +311,11 @@ struct wsi_swapchain {
                              uint32_t image_index,
                              uint64_t present_id,
                              const VkPresentRegionKHR *damage);
+   /* Optional. Called by wsi_common_queue_present for each image after its
+    * throttle wait and before the image's blit is submitted: the Metal WSI
+    * takes the layer's drawable and records the blit into it here. */
+   VkResult (*prepare_present)(struct wsi_swapchain *swap_chain,
+                               uint32_t image_index);
    VkResult (*wait_for_present)(struct wsi_swapchain *swap_chain,
                                 uint64_t present_id,
                                 uint64_t timeout);
-- 
2.55.0

