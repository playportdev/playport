+   p_atomic_inc(&kk_memory_stats.bo_count[bo->kind]);
    bo->mtl_handle = handle;
    bo->size_B = size_B;
    bo->map = map;
@@ -93,9 +101,63 @@ fail_heap:
    return result;
 }
 
+struct kk_memory_stats kk_memory_stats;
+
+void
+kk_bo_set_kind(struct kk_bo *bo, enum kk_bo_kind kind)
+{
+   if (bo->kind == KK_BO_KIND_IMPORTED)
+      return;
+   p_atomic_add(&kk_memory_stats.bo_bytes[bo->kind], -(int64_t)bo->size_B);
+   p_atomic_dec(&kk_memory_stats.bo_count[bo->kind]);
+   bo->kind = kind;
+   p_atomic_add(&kk_memory_stats.bo_bytes[kind], (int64_t)bo->size_B);
+   p_atomic_inc(&kk_memory_stats.bo_count[kind]);
+}
+
+void
+kk_memory_log(struct kk_device *dev)
+{
+   static int64_t last_ns;
+   const int64_t now = os_time_get_nano();
+   const int64_t last = p_atomic_read(&last_ns);
+   if (last != 0 && now - last < INT64_C(10000000000))
+      return;
+   if (p_atomic_cmpxchg(&last_ns, last, now) != last)
+      return;
+
+   const double mib = 1024.0 * 1024.0;
+   int64_t bo_total = 0;
+   for (unsigned i = KK_BO_KIND_INTERNAL; i < KK_BO_KIND_COUNT; i++)
+      bo_total += p_atomic_read(&kk_memory_stats.bo_bytes[i]);
+#define KK_BO_FIELD(kind)                                                      \
+   p_atomic_read(&kk_memory_stats.bo_count[KK_BO_KIND_##kind]),                \
+      p_atomic_read(&kk_memory_stats.bo_bytes[KK_BO_KIND_##kind]) / mib
+   fprintf(stderr,
+           "[kk-mem] metal=%.0f bos=%.0f memory=%d/%.0f internal=%d/%.0f "
+           "descriptor=%d/%.0f query=%d/%.0f command=%d/%.0f | shaders=%d "
+           "pipelines=%d msl=%.1f | cache raw=%d/%.1f precomp=%d/%.1f MiB\n",
+           mtl_device_current_allocated_size(dev->mtl_handle) / mib,
+           bo_total / mib, KK_BO_FIELD(DEVICE_MEMORY), KK_BO_FIELD(INTERNAL),
+           KK_BO_FIELD(DESCRIPTOR_POOL), KK_BO_FIELD(QUERY),
+           KK_BO_FIELD(COMMAND), p_atomic_read(&kk_memory_stats.shaders),
+           p_atomic_read(&kk_memory_stats.pipelines),
+           p_atomic_read(&kk_memory_stats.msl_bytes) / mib,
+           p_atomic_read(&vk_pipeline_cache_stats.raw_count),
+           p_atomic_read(&vk_pipeline_cache_stats.raw_bytes) / mib,
+           p_atomic_read(&vk_pipeline_cache_stats.precomp_count),
+           p_atomic_read(&vk_pipeline_cache_stats.precomp_bytes) / mib);
+#undef KK_BO_FIELD
+}
+
 void
 kk_destroy_bo(struct kk_device *dev, struct kk_bo *bo)
 {
+   if (bo->kind != KK_BO_KIND_IMPORTED) {
+      p_atomic_add(&kk_memory_stats.bo_bytes[bo->kind], -(int64_t)bo->size_B);
+      p_atomic_dec(&kk_memory_stats.bo_count[bo->kind]);
+   }
+
    /* We may only have a mapped buffer, for example if the memory was imported
     * from a host pointer */
    if (bo->mtl_handle)
diff --git a/src/kosmickrisp/vulkan/kk_bo.h b/src/kosmickrisp/vulkan/kk_bo.h
