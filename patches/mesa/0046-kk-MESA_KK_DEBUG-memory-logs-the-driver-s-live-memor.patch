 struct kk_device;
 struct vk_object_base;
 
+/* What a buffer object backs, for the [kk-mem] census (MESA_KK_DEBUG=memory).
+ * Imported memory is not the driver's allocation and is not counted. */
+enum kk_bo_kind {
+   KK_BO_KIND_IMPORTED = 0,
+   KK_BO_KIND_INTERNAL,
+   KK_BO_KIND_DEVICE_MEMORY,
+   KK_BO_KIND_DESCRIPTOR_POOL,
+   KK_BO_KIND_QUERY,
+   KK_BO_KIND_COMMAND,
+   KK_BO_KIND_COUNT,
+};
+
+/* Live counts for the [kk-mem] census, updated with atomics. */
+struct kk_memory_stats {
+   int64_t bo_bytes[KK_BO_KIND_COUNT];
+   int32_t bo_count[KK_BO_KIND_COUNT];
+   /* Live kk_shader objects, the pipelines among them that hold Metal
+    * pipeline states, and the MSL source they keep for serialization */
+   int32_t shaders;
+   int32_t pipelines;
+   int64_t msl_bytes;
+};
+
+extern struct kk_memory_stats kk_memory_stats;
+
 struct kk_bo {
+   enum kk_bo_kind kind;
    mtl_heap *mtl_handle;
    mtl_buffer *map;
    uint64_t size_B;
@@ -45,4 +71,10 @@ VkResult kk_bo_unmap(struct kk_device *dev, struct kk_bo *bo, void *addr,
 
 void kk_bo_set_label(struct kk_bo *bo, const char *label);
 
+void kk_bo_set_kind(struct kk_bo *bo, enum kk_bo_kind kind);
+
+/* One [kk-mem] line when MESA_KK_DEBUG has memory and 10 s have passed since
+ * the last one. */
+void kk_memory_log(struct kk_device *dev);
+
 #endif /* KK_BO_H */
