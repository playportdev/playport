@@ -925,12 +925,41 @@ kk_lower_nir(struct kk_device *dev, nir_shader *nir, bool emulated_stage,
 
 static const struct vk_shader_ops kk_shader_ops;
 
+/* Adds (sign 1) or removes (sign -1) a shader from the [kk-mem] census. */
+static void
+kk_shader_count(struct kk_shader *shader, int sign)
+{
+   int64_t msl = 0;
+   for (unsigned i = 0; i < MESA_SHADER_STAGES; i++) {
+      if (shader->msl_data[i].code)
+         msl += strlen(shader->msl_data[i].code) + 1;
+   }
+   const struct msl_compile_data *gs_data[] = {&shader->gs_main,
+                                               &shader->gs_count,
+                                               &shader->gs_pre};
+   for (unsigned i = 0; i < ARRAY_SIZE(gs_data); ++i) {
+      if (gs_data[i]->code)
+         msl += strlen(gs_data[i]->code) + 1;
+   }
+   const bool pipeline =
+      (shader->info.stage == MESA_SHADER_COMPUTE && shader->pipeline.cs) ||
+      (shader->info.stage == MESA_SHADER_VERTEX && shader->pipeline.gfx.render);
+
+   p_atomic_add(&kk_memory_stats.shaders, sign);
+   p_atomic_add(&kk_memory_stats.pipelines, pipeline ? sign : 0);
+   p_atomic_add(&kk_memory_stats.msl_bytes, sign * msl);
+   shader->counted = sign > 0;
+}
+
 static void
 kk_shader_destroy(struct vk_device *vk_dev, struct kk_shader *shader,
                   const VkAllocationCallbacks *pAllocator)
 {
    struct kk_device *dev = container_of(vk_dev, struct kk_device, vk);
 
+   if (shader->counted)
+      kk_shader_count(shader, -1);
+
    struct kk_pipeline_handles *pipe = &shader->pipeline;
 
    if (shader->info.stage == MESA_SHADER_COMPUTE) {
@@ -2668,14 +2697,19 @@ kk_compile_shaders_noted(struct vk_device *device, uint32_t shader_count,
                          const VkAllocationCallbacks *pAllocator,
                          struct vk_shader **shaders_out)
 {
-   if (!KK_DEBUG(COMPILE))
-      return kk_compile_shaders(device, shader_count, infos, state,
-                                enabled_features, pAllocator, shaders_out);
-   const int64_t start = os_time_get_nano();
+   const int64_t start = KK_DEBUG(COMPILE) ? os_time_get_nano() : 0;
    VkResult result = kk_compile_shaders(device, shader_count, infos, state,
                                         enabled_features, pAllocator,
                                         shaders_out);
-   kk_note_shader_source(false, start);
+   if (KK_DEBUG(COMPILE))
+      kk_note_shader_source(false, start);
+   if (KK_DEBUG(MEMORY) && result == VK_SUCCESS) {
+      for (uint32_t i = 0; i < shader_count; i++) {
+         if (shaders_out[i])
+            kk_shader_count(
+               container_of(shaders_out[i], struct kk_shader, vk), 1);
+      }
+   }
    return result;
 }
 
