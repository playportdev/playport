 /* MESA_KK_EXPERIMENTAL=cmd_retire, on the pool's thread (for the queue's
- * pool, under the queue mutex). In order:
- * - a free allocator with no users is reset and taken; a tainted one is
- *   destroyed instead, never reset;
- * - with fewer than KK_CMD_POOL_UNSEALED_MAX unsealed allocators, a new one;
- * - else the least-filled unsealed, untainted free one, which still has
- *   users;
- * - else (every unsealed one records now) a new one. */
+ * pool, under the queue mutex). An allocator's users are the recordings that
+ * may still be read by the GPU, so one without users is idle. Metal's reset
+ * keeps an allocator's heaps (MTL4CommandAllocator.h: "reuse its existing
+ * internal memory heaps"), so only a destroy gives memory back. In order:
+ * - idle and tainted: destroyed, never reset;
+ * - idle and sealed (heaps past KK_CMD_ALLOCATOR_SEAL_B): destroyed;
+ * - idle and clean: the first is reset and taken, up to
+ *   KK_CMD_POOL_UNSEALED_MAX - 1 more stay for later Begins, the rest are
+ *   destroyed;
+ * - none idle: a new one while the pool has fewer than
+ *   KK_CMD_POOL_UNSEALED_MAX unsealed ones or no unsealed one to share, and
+ *   fewer than KK_CMD_POOL_ALLOCATOR_CAP in all;
+ * - else the least-filled unsealed, untainted ended one, which still has
+ *   users; at the cap, if there is none, the least-filled sealed one;
+ * - else (every allocator records now or is tainted) a new one past the
+ *   cap: a Metal allocator serves one recording at a time. */
 static struct kk_cmd_allocator *
 kk_cmd_pool_get_allocator_retire(struct kk_cmd_pool *pool)
 {
    struct util_dynarray *free_list = &pool->metal.free_allocators;
-   struct kk_cmd_allocator *share = NULL;
-   uint64_t share_B = UINT64_MAX;
+   struct kk_cmd_allocator *take = NULL;
+   unsigned idle_kept = 0u;
 
+   /* The idle ones: destroy, take or keep */
    unsigned i = 0u;
    while (i < util_dynarray_num_elements(free_list, struct kk_cmd_allocator *)) {
       struct kk_cmd_allocator **all = util_dynarray_begin(free_list);
       struct kk_cmd_allocator *allocator = all[i];
-      if (p_atomic_read(&allocator->users) == 0u) {
-         const unsigned n =
-            util_dynarray_num_elements(free_list, struct kk_cmd_allocator *);
-         all[i] = all[n - 1u];
-         (void)util_dynarray_pop(free_list, struct kk_cmd_allocator *);
-         if (allocator->tainted) {
-            kk_cmd_pool_destroy_allocator(pool, allocator);
-            p_atomic_inc(&kk_cmd_retire_stats.allocator_destroys);
-            continue;
-         }
-         mtl_command_allocator_reset(allocator->handle);
-         if (allocator->sealed) {
-            allocator->sealed = false;
-            pool->metal.sealed_count--;
-         }
-         p_atomic_inc(&kk_cmd_retire_stats.allocator_resets);
-         return allocator;
+      if (p_atomic_read(&allocator->users) != 0u) {
+         i++;
+         continue;
       }
-      if (!allocator->sealed && !allocator->tainted) {
-         const uint64_t size =
-            mtl_command_allocator_allocated_size(allocator->handle);
-         if (size < share_B) {
-            share = allocator;
-            share_B = size;
-         }
+      int64_t *destroyed = NULL;
+      if (allocator->tainted)
+         destroyed = &kk_cmd_retire_stats.allocator_destroys;
+      else if (allocator->sealed)
+         destroyed = &kk_cmd_retire_stats.allocator_releases;
+      else if (take != NULL && idle_kept + 1u >= KK_CMD_POOL_UNSEALED_MAX)
+         destroyed = &kk_cmd_retire_stats.allocator_trims;
+      if (destroyed == NULL && take != NULL) {
+         idle_kept++;
+         i++;
+         continue;
+      }
+      const unsigned n =
+         util_dynarray_num_elements(free_list, struct kk_cmd_allocator *);
+      all[i] = all[n - 1u];
+      (void)util_dynarray_pop(free_list, struct kk_cmd_allocator *);
+      if (destroyed) {
+         kk_cmd_pool_destroy_allocator(pool, allocator);
+         p_atomic_inc(destroyed);
+      } else {
+         take = allocator;
       }
-      i++;
    }
 
-   if (share == NULL || pool->metal.allocator_count - pool->metal.sealed_count <
-                           KK_CMD_POOL_UNSEALED_MAX)
+   if (take) {
+      mtl_command_allocator_reset(take->handle);
+      p_atomic_inc(&kk_cmd_retire_stats.allocator_resets);
+      return take;
+   }
+
+   /* None idle: the ended ones still in flight, to share */
+   struct kk_cmd_allocator *share = NULL, *sealed_share = NULL;
+   uint64_t share_B = UINT64_MAX, sealed_share_B = UINT64_MAX;
+   util_dynarray_foreach(free_list, struct kk_cmd_allocator *, entry) {
+      struct kk_cmd_allocator *allocator = *entry;
+      if (allocator->tainted)
+         continue;
+      const uint64_t size =
+         mtl_command_allocator_allocated_size(allocator->handle);
+      if (!allocator->sealed && size < share_B) {
+         share = allocator;
+         share_B = size;
+      } else if (allocator->sealed && size < sealed_share_B) {
+         sealed_share = allocator;
+         sealed_share_B = size;
+      }
+   }
+
+   const uint32_t count = pool->metal.allocator_count;
+   if (count < KK_CMD_POOL_ALLOCATOR_CAP &&
+       (share == NULL ||
+        count - pool->metal.sealed_count < KK_CMD_POOL_UNSEALED_MAX))
       return kk_cmd_pool_new_allocator(pool);
 
+   if (share == NULL && count >= KK_CMD_POOL_ALLOCATOR_CAP) {
+      share = sealed_share;
+      if (share)
+         p_atomic_inc(&kk_cmd_retire_stats.allocator_capped_shares);
+   }
+   if (share == NULL) {
+      p_atomic_inc(&kk_cmd_retire_stats.allocator_over_cap);
+      return kk_cmd_pool_new_allocator(pool);
+   }
+
    util_dynarray_delete_unordered(free_list, struct kk_cmd_allocator *, share);
    p_atomic_inc(&kk_cmd_retire_stats.allocator_shares);
    return share;
