diff --git a/src/kosmickrisp/vulkan/kk_fault.c b/src/kosmickrisp/vulkan/kk_fault.c
new file mode 100644
index 0000000..7f47e98
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_fault.c
@@ -0,0 +1,356 @@
+/*
+ * Copyright 2026 The Playport authors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Playport (PLA-880), MESA_KK_DEBUG=fault: see kk_fault.h */
+
+#include "kk_fault.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "kk_bo.h"
+#include "kk_cmd_buffer.h"
+#include "kk_debug.h"
+#include "kk_device.h"
+
+#include "kosmickrisp/bridge/mtl_bridge.h"
+#include "poly/geometry.h"
+#include "util/u_atomic.h"
+
+#define MIB (1024.0 * 1024.0)
+
+void
+kk_fault_device_init(struct kk_device *dev)
+{
+   if (!KK_DEBUG(FAULT))
+      return;
+   if (kk_alloc_bo(dev, &dev->vk.base, KK_FAULT_RING * sizeof(uint32_t), 0,
+                   &dev->fault.ring) == VK_SUCCESS)
+      memset(dev->fault.ring->cpu, 0, KK_FAULT_RING * sizeof(uint32_t));
+   else
+      dev->fault.ring = NULL;
+   fprintf(stderr,
+           "[kk-fault] on: encoder labels, command buffer trails, geometry heap "
+           "ring%s; Metal encoder status: %s\n",
+           dev->fault.ring ? "" : " (not allocated)",
+           mtl_enable_encoder_execution_status());
+   fflush(stderr);
+}
+
+void
+kk_fault_device_finish(struct kk_device *dev)
+{
+   if (dev->fault.ring)
+      kk_destroy_bo(dev, dev->fault.ring);
+   dev->fault.ring = NULL;
+}
+
+void
+kk_fault_cmd_init(struct kk_cmd_buffer *cmd)
+{
+   cmd->fault.trail = UTIL_DYNARRAY_INIT;
+}
+
+void
+kk_fault_cmd_finish(struct kk_cmd_buffer *cmd)
+{
+   util_dynarray_fini(&cmd->fault.trail);
+}
+
+void
+kk_fault_begin_cmd(struct kk_cmd_buffer *cmd)
+{
+   struct kk_fault_cmd *f = &cmd->fault;
+   util_dynarray_clear(&f->trail);
+   f->flags = 0u;
+   f->open = false;
+   f->dropped = 0u;
+   f->serial = KK_DEBUG(FAULT)
+                  ? p_atomic_inc_return(&kk_cmd_buffer_device(cmd)->fault.serial)
+                  : 0u;
+}
+
+static struct kk_fault_encoder *
+open_encoder(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->fault.open)
+      return NULL;
+   return util_dynarray_last_ptr(&cmd->fault.trail, struct kk_fault_encoder);
+}
+
+void
+kk_fault_begin_encoder(struct kk_cmd_buffer *cmd, bool render)
+{
+   struct kk_fault_cmd *f = &cmd->fault;
+   if (!f->serial)
+      return;
+   if (util_dynarray_num_elements(&f->trail, struct kk_fault_encoder) ==
+       KK_FAULT_MAX_ENCODERS) {
+      f->dropped++;
+      f->open = false;
+      return;
+   }
+   util_dynarray_append(&f->trail, (struct kk_fault_encoder){.render = render});
+   f->open = true;
+}
+
+/* "render draws=N" or "compute dispatches=N copies=N", then the flags */
+static void
+describe(const struct kk_fault_encoder *e, char *buf, size_t size)
+{
+   int n = e->render
+              ? snprintf(buf, size, "render draws=%u", e->draws)
+              : snprintf(buf, size, "compute dispatches=%u copies=%u",
+                         e->dispatches, e->copies);
+   static const char *const names[] = {"tess", "gs", "unroll", "heap",
+                                       "indirect"};
+   for (unsigned i = 0; i < ARRAY_SIZE(names) && n > 0 && (size_t)n < size; i++) {
+      if (e->flags & (1u << i))
+         n += snprintf(buf + n, size - n, " %s", names[i]);
+   }
+}
+
+void
+kk_fault_end_encoder(struct kk_cmd_buffer *cmd, void *encoder)
+{
+   struct kk_fault_encoder *e = open_encoder(cmd);
+   if (!e)
+      return;
+   char what[128], label[160];
+   describe(e, what, sizeof(what));
+   const unsigned index =
+      util_dynarray_num_elements(&cmd->fault.trail, struct kk_fault_encoder) - 1u;
+   snprintf(label, sizeof(label), "kk#%u.%u %s", cmd->fault.serial, index, what);
+   mtl_encoder_set_label(encoder, label);
+   cmd->fault.open = false;
+}
+
+void
+kk_fault_draw(struct kk_cmd_buffer *cmd)
+{
+   struct kk_fault_encoder *e = open_encoder(cmd);
+   if (e)
+      e->draws++;
+}
+
+void
+kk_fault_pipeline(struct kk_cmd_buffer *cmd)
+{
+   struct kk_fault_encoder *e = open_encoder(cmd);
+   if (e && !e->render)
+      e->dispatches++;
+}
+
+void
+kk_fault_copy(struct kk_cmd_buffer *cmd)
+{
+   struct kk_fault_encoder *e = open_encoder(cmd);
+   if (e)
+      e->copies++;
+}
+
+void
+kk_fault_note(struct kk_cmd_buffer *cmd, uint32_t flags)
+{
+   if (!cmd->fault.serial)
+      return;
+   cmd->fault.flags |= flags;
+   struct kk_fault_encoder *e = open_encoder(cmd);
+   if (e)
+      e->flags |= flags;
+}
+
+void
+kk_fault_heap_reset(struct kk_cmd_buffer *cmd, mtl_compute_encoder *encoder)
+{
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   if (!cmd->fault.serial)
+      return;
+   kk_fault_note(cmd, KK_FAULT_HEAP);
+   if (!dev->fault.ring || !dev->heap)
+      return;
+   const uint32_t slot =
+      (p_atomic_inc_return(&dev->fault.ring_next) - 1u) % KK_FAULT_RING;
+   dev->fault.ring_serial[slot] = cmd->fault.serial;
+   /* After the heap's users before it in this encoder, and before the reset
+    * the caller encodes next */
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_DISPATCH, MTL_STAGE_BLIT);
+   mtl_copy_from_buffer_to_buffer(encoder, dev->heap->map,
+                                  offsetof(struct poly_heap, bottom),
+                                  dev->fault.ring->map,
+                                  slot * sizeof(uint32_t), sizeof(uint32_t));
+   mtl_barrier_after_encoder_stages(encoder, MTL_STAGE_BLIT, MTL_STAGE_DISPATCH);
+}
+
+struct kk_fault_commit {
+   struct kk_device *dev;
+   mtl_feedback_handler_callback callback;
+   void *user_data;
+   uint32_t serial, flags, dropped, count;
+   struct kk_fault_encoder trail[];
+};
+
+struct kk_fault_commit *
+kk_fault_commit_new(struct kk_cmd_buffer *cmd,
+                    mtl_feedback_handler_callback callback, void *user_data)
+{
+   if (!cmd->fault.serial)
+      return NULL;
+   const uint32_t count =
+      util_dynarray_num_elements(&cmd->fault.trail, struct kk_fault_encoder);
+   struct kk_fault_commit *c =
+      malloc(sizeof(*c) + count * sizeof(struct kk_fault_encoder));
+   if (!c)
+      return NULL;
+   *c = (struct kk_fault_commit){
+      .dev = kk_cmd_buffer_device(cmd),
+      .callback = callback,
+      .user_data = user_data,
+      .serial = cmd->fault.serial,
+      .flags = cmd->fault.flags,
+      .dropped = cmd->fault.dropped,
+      .count = count,
+   };
+   if (count)
+      memcpy(c->trail, util_dynarray_begin(&cmd->fault.trail),
+             count * sizeof(struct kk_fault_encoder));
+   return c;
+}
+
+/* The heap's size and the most any user of it has allocated that the GPU has
+ * left for the CPU to see: the bottom each recorded reset found, and the
+ * header's bottom (the last user's, not reset yet). *serial is the command
+ * buffer whose reset found the most, 0 for the header's. */
+struct heap_usage {
+   uint32_t size, header_bottom, largest, largest_serial, recorded, over;
+};
+
+static bool
+heap_usage(struct kk_device *dev, struct heap_usage *u)
+{
+   struct kk_bo *heap = p_atomic_read(&dev->heap);
+   if (!heap)
+      return false;
+   const volatile struct poly_heap *h = heap->cpu;
+   *u = (struct heap_usage){.size = h->size, .header_bottom = h->bottom};
+   if (dev->fault.ring) {
+      const volatile uint32_t *ring = dev->fault.ring->cpu;
+      u->recorded = MIN2(p_atomic_read(&dev->fault.ring_next), KK_FAULT_RING);
+      for (uint32_t i = 0; i < u->recorded; i++) {
+         const uint32_t b = ring[i];
+         if (b > u->largest) {
+            u->largest = b;
+            u->largest_serial = dev->fault.ring_serial[i];
+         }
+         if (b >= u->size)
+            u->over++;
+      }
+   }
+   return true;
+}
+
+static void
+log_high_water(struct kk_fault_commit *c)
+{
+   struct heap_usage u;
+   if (!heap_usage(c->dev, &u))
+      return;
+   const uint32_t high = MAX2(u.largest, u.header_bottom);
+   uint32_t old = p_atomic_read(&c->dev->fault.heap_high_water);
+   /* A first mark, 8 MiB more, or an overflow */
+   while (high > old &&
+          (old == 0u || high >= old + (8u << 20) ||
+           (high >= u.size && old < u.size))) {
+      const uint32_t seen =
+         p_atomic_cmpxchg(&c->dev->fault.heap_high_water, old, high);
+      if (seen == old) {
+         fprintf(stderr,
+                 "[kk-fault] geometry heap high-water %.1f MiB of %.1f MiB "
+                 "(cb #%u)%s\n",
+                 high / MIB, u.size / MIB, c->serial,
+                 high >= u.size ? " OVERFLOW" : "");
+         fflush(stderr);
+         return;
+      }
+      old = seen;
+   }
+}
+
+static void
+log_failure(struct kk_fault_commit *c, const struct mtl_feedback_data *data,
+            uint32_t last_completed)
+{
+   uint32_t render = 0u, draws = 0u, dispatches = 0u, copies = 0u;
+   for (uint32_t i = 0; i < c->count; i++) {
+      render += c->trail[i].render;
+      draws += c->trail[i].draws;
+      dispatches += c->trail[i].dispatches;
+      copies += c->trail[i].copies;
+   }
+   char flags[64] = "";
+   static const char *const names[] = {"tess", "gs", "unroll", "heap",
+                                       "indirect"};
+   for (unsigned i = 0; i < ARRAY_SIZE(names); i++) {
+      if (c->flags & (1u << i))
+         snprintf(flags + strlen(flags), sizeof(flags) - strlen(flags), "%s%s",
+                  flags[0] ? "," : "", names[i]);
+   }
+   fprintf(stderr,
+           "[kk-fault] cb #%u failed (error=%d): encoders=%u render=%u "
+           "compute=%u draws=%u dispatches=%u copies=%u flags=%s "
+           "last-completed=#%u\n",
+           c->serial, (int)data->error, c->count + c->dropped, render,
+           c->count - render, draws, dispatches, copies,
+           flags[0] ? flags : "none", last_completed);
+   const uint32_t listed = MIN2(c->count, 512u);
+   for (uint32_t i = 0; i < listed; i++) {
+      char what[128];
+      describe(&c->trail[i], what, sizeof(what));
+      fprintf(stderr, "[kk-fault] cb #%u enc %u %s\n", c->serial, i, what);
+   }
+   if (c->count + c->dropped > listed)
+      fprintf(stderr, "[kk-fault] cb #%u: %u more encoders not listed\n",
+              c->serial, c->count + c->dropped - listed);
+
+   struct heap_usage u;
+   if (!heap_usage(c->dev, &u)) {
+      fprintf(stderr, "[kk-fault] geometry heap: not allocated (no draw has "
+                      "used it)\n");
+   } else {
+      fprintf(stderr,
+              "[kk-fault] geometry heap: last user's bottom=%.1f MiB of %.1f "
+              "MiB%s\n",
+              u.header_bottom / MIB, u.size / MIB,
+              u.header_bottom >= u.size ? " OVERFLOW" : "");
+      if (c->dev->fault.ring)
+         fprintf(stderr,
+                 "[kk-fault] geometry heap resets: %u recorded, largest %.1f "
+                 "MiB found by the reset in cb #%u, %u over the heap\n",
+                 u.recorded, u.largest / MIB, u.largest_serial, u.over);
+   }
+   fflush(stderr);
+}
+
+void
+kk_fault_feedback(struct mtl_feedback_data *data)
+{
+   struct kk_fault_commit *c = data->user_data;
+   struct kk_device *dev = c->dev;
+   const uint32_t last_completed = p_atomic_read(&dev->fault.last_completed);
+
+   struct mtl_feedback_data inner = *data;
+   inner.user_data = c->user_data;
+   c->callback(&inner);
+
+   if (data->error != MTL_COMMAND_QUEUE_ERROR_NONE) {
+      log_failure(c, data, last_completed);
+   } else {
+      p_atomic_set(&dev->fault.last_completed, c->serial);
+      if (c->flags & KK_FAULT_HEAP)
+         log_high_water(c);
+   }
+   free(c);
+}
diff --git a/src/kosmickrisp/vulkan/kk_fault.h b/src/kosmickrisp/vulkan/kk_fault.h
new file mode 100644
index 0000000..bcd8800
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_fault.h
@@ -0,0 +1,103 @@
+/*
+ * Copyright 2026 The Playport authors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef KK_FAULT_H
+#define KK_FAULT_H 1
+
+/* Playport (PLA-880), MESA_KK_DEBUG=fault: what a failed Metal command buffer
+ * held. Metal 4 has no public encoder execution status (MTL4CommitFeedback
+ * gives an NSError and two GPU times; MTL4CommandBufferOptions has only a log
+ * state), so the driver keeps its own record:
+ *
+ * - each encoder is labelled "kk#<serial>.<index> <kind> ..." with what it
+ *   encoded, so a label Metal reports (or a GPU capture shows) names the
+ *   command buffer and pass;
+ * - each command buffer keeps a trail of its encoders (kind, draws,
+ *   dispatches, copies, tessellation / geometry / unroll / geometry heap
+ *   use), copied at commit; a failed commit logs it as [kk-fault] lines;
+ * - each reset of the geometry heap (kk_heap, the 128 MiB scratch of
+ *   tessellation, geometry shaders and strip unrolls that every draw using
+ *   it allocates from) first copies the bytes the previous user allocated
+ *   into a ring, so a failure shows whether a draw overflowed the heap
+ *   (poly_heap_alloc_offs has no way to fail: its abort is a return).
+ *
+ * Without the flag none of this runs; a failed commit still logs the full
+ * error chain (kk_queue.c). */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "kosmickrisp/bridge/mtl_types.h"
+#include "util/u_dynarray.h"
+
+struct kk_bo;
+struct kk_cmd_buffer;
+struct kk_device;
+
+enum kk_fault_flag {
+   KK_FAULT_TESS = 1u << 0,     /* a tessellated draw's compute stages */
+   KK_FAULT_GS = 1u << 1,       /* a geometry shader's compute stages */
+   KK_FAULT_UNROLL = 1u << 2,   /* a strip or fan unrolled for restart */
+   KK_FAULT_HEAP = 1u << 3,     /* a geometry heap reset (kk_heap) */
+   KK_FAULT_INDIRECT = 1u << 4, /* an indirect draw */
+};
+
+/* One encoder of a command buffer's trail */
+struct kk_fault_encoder {
+   bool render;
+   uint8_t flags; /* enum kk_fault_flag */
+   uint32_t draws, dispatches, copies;
+};
+
+/* A command buffer's trail, reset at vkBeginCommandBuffer */
+struct kk_fault_cmd {
+   uint32_t serial; /* 0: not traced (no MESA_KK_DEBUG=fault) */
+   uint32_t flags;  /* every encoder's flags */
+   bool open;       /* the last encoder is still being encoded */
+   uint32_t dropped; /* encoders past KK_FAULT_MAX_ENCODERS, counted only */
+   struct util_dynarray trail; /* struct kk_fault_encoder */
+};
+
+#define KK_FAULT_MAX_ENCODERS 2048u
+/* Geometry heap resets the ring keeps: the bytes each found allocated */
+#define KK_FAULT_RING 1024u
+
+/* The device's part */
+struct kk_fault_device {
+   struct kk_bo *ring; /* KK_FAULT_RING uint32_t, written by the GPU */
+   uint32_t ring_next; /* the next slot, atomic */
+   uint32_t ring_serial[KK_FAULT_RING]; /* the command buffer of each slot */
+   uint32_t serial;    /* the last command buffer serial, atomic */
+   uint32_t last_completed; /* the last serial that completed, atomic */
+   uint32_t heap_high_water; /* bytes, the highest logged */
+};
+
+void kk_fault_device_init(struct kk_device *dev);
+void kk_fault_device_finish(struct kk_device *dev);
+
+void kk_fault_cmd_init(struct kk_cmd_buffer *cmd);
+void kk_fault_cmd_finish(struct kk_cmd_buffer *cmd);
+void kk_fault_begin_cmd(struct kk_cmd_buffer *cmd);
+
+void kk_fault_begin_encoder(struct kk_cmd_buffer *cmd, bool render);
+void kk_fault_end_encoder(struct kk_cmd_buffer *cmd, void *encoder);
+void kk_fault_draw(struct kk_cmd_buffer *cmd);
+void kk_fault_pipeline(struct kk_cmd_buffer *cmd);
+void kk_fault_copy(struct kk_cmd_buffer *cmd);
+void kk_fault_note(struct kk_cmd_buffer *cmd, uint32_t flags);
+
+/* Before a command buffer's first use of the geometry heap resets it: copies
+ * the heap's bottom (what the last user allocated) into the next ring slot,
+ * in encoder, before the reset's write */
+void kk_fault_heap_reset(struct kk_cmd_buffer *cmd, mtl_compute_encoder *encoder);
+
+/* Wraps a commit's feedback: the trail is copied now, logged if the commit
+ * fails, and callback(user_data) runs as before. NULL when not traced. */
+struct kk_fault_commit;
+struct kk_fault_commit *
+kk_fault_commit_new(struct kk_cmd_buffer *cmd,
+                    mtl_feedback_handler_callback callback, void *user_data);
+void kk_fault_feedback(struct mtl_feedback_data *data);
+
+#endif /* KK_FAULT_H */
diff --git a/src/kosmickrisp/vulkan/kk_pass_prof.c b/src/kosmickrisp/vulkan/kk_pass_prof.c
index faae0c8..67e4827 100644
--- a/src/kosmickrisp/vulkan/kk_pass_prof.c
+++ b/src/kosmickrisp/vulkan/kk_pass_prof.c
@@ -279,6 +279,9 @@ kk_pass_prof_end(struct kk_cmd_buffer *cmd, bool render)
 void
 kk_pass_prof_pipeline(struct kk_cmd_buffer *cmd, void *pipeline)
 {
+   /* Playport (PLA-880): this hook, the draw and the copy one feed
+    * MESA_KK_DEBUG=fault's trail too */
+   kk_fault_pipeline(cmd);
    if (!cmd->pass_prof || cmd->pass_prof_index == PP_PASSES)
       return;
    struct kk_profile_pass *p = &cmd->pass_prof->passes[cmd->pass_prof_index];
@@ -298,6 +301,7 @@ kk_pass_prof_store(struct kk_cmd_buffer *cmd, unsigned index, unsigned action)
 void
 kk_pass_prof_copy(struct kk_cmd_buffer *cmd)
 {
+   kk_fault_copy(cmd);
    if (cmd->pass_prof && cmd->pass_prof_index != PP_PASSES)
