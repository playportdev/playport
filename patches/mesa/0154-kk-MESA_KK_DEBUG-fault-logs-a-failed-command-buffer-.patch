+/* Playport (PLA-880): host time in seconds, the clock of MTL4CommitFeedback's
+ * GPUStartTime and GPUEndTime */
+static double
+kk_host_time_s(void)
+{
+   static mach_timebase_info_data_t timebase;
+   if (!timebase.denom)
+      mach_timebase_info(&timebase);
+   return (double)mach_absolute_time() * timebase.numer / timebase.denom / 1e9;
+}
+
+static const char *
+kk_encoder_error_state(MTLCommandEncoderErrorState state)
+{
+   switch (state) {
+   case MTLCommandEncoderErrorStateCompleted: return "completed";
+   case MTLCommandEncoderErrorStateAffected: return "affected";
+   case MTLCommandEncoderErrorStatePending: return "pending";
+   case MTLCommandEncoderErrorStateFaulted: return "FAULTED";
+   default: return "unknown";
+   }
+}
+
+/* One line, quoted, of an object's description, at most 400 characters */
+static NSString *
+kk_one_line(id value)
+{
+   NSString *s = [[value description]
+      stringByReplacingOccurrencesOfString:@"\n" withString:@" "];
+   return s.length > 400 ? [[s substringToIndex:400] stringByAppendingString:@"..."] : s;
+}
+
+/* Playport (PLA-880): an NSError and everything under it, a line per item,
+ * indented by depth: domain, code, description, failure reason, each user
+ * info entry, Metal's encoder infos (MTLCommandBufferEncoderInfoErrorKey),
+ * and the underlying errors (NSUnderlyingErrorKey,
+ * NSMultipleUnderlyingErrorsKey) in turn */
+static void
+kk_append_error(NSMutableString *out, NSError *error, unsigned depth,
+                NSString *what)
+{
+   NSString *indent = [@"" stringByPaddingToLength:2 * depth withString:@" "
+                                     startingAtIndex:0];
+   if (depth > 8 || out.length > 16384) {
+      [out appendFormat:@"%@%@...\n", indent, what];
+      return;
+   }
+   [out appendFormat:@"%@%@domain=%@ code=%ld desc=\"%@\"\n", indent, what,
+                     error.domain, (long)error.code,
+                     kk_one_line(error.localizedDescription)];
+   if (error.localizedFailureReason)
+      [out appendFormat:@"%@  reason=\"%@\"\n", indent,
+                        kk_one_line(error.localizedFailureReason)];
+   NSArray *keys = [error.userInfo.allKeys
+      sortedArrayUsingSelector:@selector(compare:)];
+   for (NSString *key in keys) {
+      id value = error.userInfo[key];
+      if ([key isEqual:NSLocalizedDescriptionKey] ||
+          [key isEqual:NSLocalizedFailureReasonErrorKey] ||
+          [key isEqual:NSUnderlyingErrorKey] ||
+          [key isEqual:NSMultipleUnderlyingErrorsKey])
+         continue;
+      if ([value isKindOfClass:[NSError class]]) {
+         kk_append_error(out, value, depth + 1,
+                         [NSString stringWithFormat:@"%@: ", key]);
+      } else if ([value isKindOfClass:[NSArray class]]) {
+         NSArray *items = value;
+         [out appendFormat:@"%@  %@: %lu item(s)\n", indent, key,
+                           (unsigned long)items.count];
+         NSUInteger i = 0;
+         for (id item in items) {
+            if ([item conformsToProtocol:@protocol(MTLCommandBufferEncoderInfo)]) {
+               id<MTLCommandBufferEncoderInfo> info = item;
+               [out appendFormat:@"%@    encoder[%lu] state=%s label=\"%@\" "
+                                 @"signposts=%@\n",
+                                 indent, (unsigned long)i,
+                                 kk_encoder_error_state(info.errorState),
+                                 info.label,
+                                 kk_one_line([info.debugSignposts
+                                    componentsJoinedByString:@","])];
+            } else if ([item isKindOfClass:[NSError class]]) {
+               kk_append_error(out, item, depth + 2,
+                               [NSString stringWithFormat:@"[%lu] ", (unsigned long)i]);
+            } else {
+               [out appendFormat:@"%@    [%lu] %s %@\n", indent, (unsigned long)i,
+                                 object_getClassName(item), kk_one_line(item)];
+            }
+            if (++i == 512)
+               break;
+         }
+      } else {
+         [out appendFormat:@"%@  %@=%@\n", indent, key, kk_one_line(value)];
+      }
+   }
+   NSError *underlying = error.userInfo[NSUnderlyingErrorKey];
+   if ([underlying isKindOfClass:[NSError class]])
+      kk_append_error(out, underlying, depth + 1, @"underlying: ");
+   NSArray *multiple = error.userInfo[NSMultipleUnderlyingErrorsKey];
+   if ([multiple isKindOfClass:[NSArray class]]) {
+      NSUInteger i = 0;
+      for (id item in multiple) {
+         if ([item isKindOfClass:[NSError class]])
+            kk_append_error(out, item, depth + 1,
+                            [NSString stringWithFormat:@"underlying[%lu]: ",
+                                                       (unsigned long)i]);
+         i++;
+      }
+   }
+}
+
+/* The error chain, then the feedback object's class and methods (Metal 4's
+ * concrete feedback may carry more than its protocol declares) */
+static NSString *
+kk_error_detail(NSError *error, id feedback)
+{
+   NSMutableString *out = [NSMutableString string];
+   kk_append_error(out, error, 0, @"");
+   [out appendFormat:@"feedback %@", kk_methods_of(feedback)];
+   return out;
+}
