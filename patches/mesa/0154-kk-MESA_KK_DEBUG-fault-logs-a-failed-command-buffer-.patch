+/* Playport (PLA-880): asks Metal for each encoder's execution status in a
+ * failed command buffer's error (MTLCommandBufferErrorOptionEncoderExecution
+ * Status). Metal 4 declares no such option (MTL4CommandBufferOptions has only
+ * logState), so this sets errorOptions on the options every later
+ * mtl_begin_command_buffer uses only if the runtime's MTL4CommandBufferOptions
+ * answers to setErrorOptions:. Returns what it did and the methods the
+ * runtime's commit and command buffer option classes have, for the log; a
+ * static string. */
+const char *mtl_enable_encoder_execution_status(void);
+
 #endif /* MTL_COMMAND_BUFFER_H */
