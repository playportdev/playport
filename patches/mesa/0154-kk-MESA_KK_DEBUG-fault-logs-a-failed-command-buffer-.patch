+
+/* Playport (PLA-880): "Class: methods", the instance methods of obj's class
+ * and its superclasses below NSObject (mtl_command_queue.m uses it too) */
+NSString *
+kk_methods_of(id obj)
+{
+   NSMutableArray<NSString *> *names = [NSMutableArray array];
+   for (Class c = object_getClass(obj); c && c != [NSObject class];
+        c = class_getSuperclass(c)) {
+      unsigned count = 0;
+      Method *methods = class_copyMethodList(c, &count);
+      for (unsigned i = 0; i < count; i++) {
+         NSString *name = NSStringFromSelector(method_getName(methods[i]));
+         if (![name hasPrefix:@"."] && ![names containsObject:name])
+            [names addObject:name];
+      }
+      free(methods);
+   }
+   return [NSString stringWithFormat:@"%s: %@", object_getClassName(obj),
+                                     [names componentsJoinedByString:@" "]];
+}
+
+const char *
+mtl_enable_encoder_execution_status(void)
+{
+   static char note[4096];
+   @autoreleasepool {
+      MTL4CommandBufferOptions *options = [MTL4CommandBufferOptions new];
+      SEL set = NSSelectorFromString(@"setErrorOptions:");
+      NSString *what;
+      if ([options respondsToSelector:set]) {
+         ((void (*)(id, SEL, NSUInteger))objc_msgSend)(
+            options, set, MTLCommandBufferErrorOptionEncoderExecutionStatus);
+         kk_status_options = options;
+         what = @"on (MTL4CommandBufferOptions errorOptions, not public API)";
+      } else {
+         what = @"unavailable (MTL4CommandBufferOptions has no errorOptions)";
+      }
+      MTL4CommitOptions *commit = [[MTL4CommitOptions new] autorelease];
+      MTL4CommandQueueDescriptor *queue =
+         [[MTL4CommandQueueDescriptor new] autorelease];
+      snprintf(note, sizeof(note), "%s; methods %s; %s; %s", what.UTF8String,
+               kk_methods_of(options).UTF8String,
+               kk_methods_of(commit).UTF8String,
+               kk_methods_of(queue).UTF8String);
+      if (!kk_status_options)
+         [options release];
+   }
+   return note;
+}
