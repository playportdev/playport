diff --git a/FEXCore/Source/Interface/Core/JIT/IosPauseYieldOs.h b/FEXCore/Source/Interface/Core/JIT/IosPauseYieldOs.h
new file mode 100644
index 0000000..1d87834
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/JIT/IosPauseYieldOs.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+// Playport: MADEIRA_FEX_PAUSE=yield-os[:K], the PAUSE that gives the core back (IOS_PAUSE_YIELD_OS in
+// Arm64Emitter.h). Apple's cores treat YIELD as a NOP, so a guest spin-wait loop holds its core at full rate;
+// WFE holds it too, waiting (decision 0163). Here each PAUSE is still a YIELD, but it also counts in the
+// guest thread's frame, and every K-th one makes a swtch_pri Mach trap, what Darwin's sched_yield is: the
+// kernel depresses the thread and runs another runnable thread on the core, if one waits, else returns at once.
+//
+// The trap is raw (svc #0x80, x16 = -59) so that no Wine syscall frame or FEX register spill is involved: to
+// Wine and FEX it is one more JIT instruction. Darwin's Mach traps keep every register but x0 (the result) and
+// NZCV, which holds the guest's flags; the sequence saves and restores x0 (a guest register on ARM64EC) and
+// x16 and sets no flags. A header of its own so a host test can emit it with FEX's CodeEmitter.
+
+#include <CodeEmitter/Emitter.h>
+
+#include <cstdint>
+
+namespace FEXCore::CPU {
+
+// After's limits: the compare is one SUB with a 12-bit immediate.
+inline constexpr uint32_t IosPauseYieldOsMaxAfter = 4095;
+
+// Darwin's Mach trap number of swtch_pri, as libsystem_kernel loads it (movn x16, #0x3a).
+inline constexpr int32_t IosSwtchPriTrap = -59;
+
+// Emits PAUSE as: Count = *(State + CountOffset) + 1; if Count == After { *(...) = 0; swtch_pri } else
+// { *(...) = Count; YIELD }, with After in 1..IosPauseYieldOsMaxAfter. Tmp1 and Tmp2 are scratch; neither may
+// be x0, x16 or State.
+template<typename EmitterT>
+void IosEmitPauseYieldOs(EmitterT& E, ARMEmitter::XRegister State, uint32_t CountOffset, uint32_t After,
+                         ARMEmitter::XRegister Tmp1, ARMEmitter::XRegister Tmp2) {
+  ARMEmitter::ForwardLabel Trap;
+  ARMEmitter::ForwardLabel Done;
+
+  E.ldr(Tmp1, State, CountOffset);
+  E.add(ARMEmitter::Size::i64Bit, Tmp1, Tmp1, 1);
+  // SUB and CBZ, not CMP: NZCV holds the guest's flags.
+  E.sub(ARMEmitter::Size::i64Bit, Tmp2, Tmp1, After);
+  (void)E.cbz(ARMEmitter::Size::i64Bit, Tmp2, &Trap);
+  E.str(Tmp1, State, CountOffset);
+  E.yield();
+  (void)E.b(&Done);
+
+  (void)E.Bind(&Trap);
+  E.str(ARMEmitter::XReg::zr, State, CountOffset);
+  E.mov(ARMEmitter::Size::i64Bit, Tmp1, ARMEmitter::XReg::x0);
+  E.mov(ARMEmitter::Size::i64Bit, Tmp2, ARMEmitter::XReg::x16);
+  E.movn(ARMEmitter::Size::i64Bit, ARMEmitter::XReg::x16, static_cast<uint32_t>(-IosSwtchPriTrap - 1));
+  E.svc(0x80);
+  E.mov(ARMEmitter::Size::i64Bit, ARMEmitter::XReg::x0, Tmp1);
+  E.mov(ARMEmitter::Size::i64Bit, ARMEmitter::XReg::x16, Tmp2);
+
+  (void)E.Bind(&Done);
+}
+
+} // namespace FEXCore::CPU
