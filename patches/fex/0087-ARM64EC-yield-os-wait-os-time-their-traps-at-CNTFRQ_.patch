diff --git a/FEXCore/include/FEXCore/Utils/IosPauseOption.h b/FEXCore/include/FEXCore/Utils/IosPauseOption.h
index 81bd197..a89f87e 100644
--- a/FEXCore/include/FEXCore/Utils/IosPauseOption.h
+++ b/FEXCore/include/FEXCore/Utils/IosPauseOption.h
@@ -20,6 +20,15 @@ inline constexpr uint32_t PauseYieldOsMaxAfter = 4095; // IosPauseYieldOs.h: a 1
 inline constexpr uint32_t PauseWaitOsDefaultUsec = 50;
 inline constexpr uint32_t PauseWaitOsMaxUsec = 5000;   // the guest's spin waits for up to 5 ms; more is a hang
 
+// A trap shorter than 2 us counts as short: an idle swtch_pri takes about 0.3 us and a context switch away and
+// back takes several. In generic-timer ticks at Freq, CNTFRQ_EL0, which is not mach_absolute_time's 24 MHz
+// everywhere (Armv8.6 fixes it at 1 GHz); clamped for the emitted SUB's 12-bit immediate (JIT/IosPauseYieldOs.h):
+// 48 at 24 MHz, 2000 at 1 GHz.
+inline constexpr uint32_t PauseShortTicks(uint64_t Freq) {
+  const uint64_t T = Freq / 500000;
+  return T < 1 ? 1 : T > 4095 ? 4095 : static_cast<uint32_t>(T);
+}
