+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace FEX::Windows {
+// FEX_SMCCHECKS_FOR=<exe>=<mode> (PLA-401 diagnostics): SMCChecks <mode> for the one
+// process whose executable base name is <exe>, compared case-insensitively as Windows
+// compares file names. Every other process keeps the SMCChecks its configuration gives.
+// <mode> is FEX's own spelling: none, mtrack or full.
+struct SMCChecksForResult {
+  enum class KindType { OtherProcess, Apply, Invalid };
+  KindType Kind;
+  uint8_t Mode; // FEXCore::Config::ConfigSMCChecks, when Kind is Apply
+};
+
+inline bool SMCChecksForNameEquals(std::string_view A, std::string_view B) {
+  if (A.size() != B.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < A.size(); ++i) {
+    char a = A[i], b = B[i];
+    if (a >= 'A' && a <= 'Z') {
+      a = static_cast<char>(a - 'A' + 'a');
+    }
+    if (b >= 'A' && b <= 'Z') {
+      b = static_cast<char>(b - 'A' + 'a');
+    }
+    if (a != b) {
+      return false;
+    }
+  }
+  return true;
+}
+
+inline SMCChecksForResult ParseSMCChecksFor(std::string_view Spec, std::string_view AppName) {
+  using enum SMCChecksForResult::KindType;
+  // The mode follows the last '=': an executable name cannot contain one in practice,
+  // and the mode never does.
+  const auto Eq = Spec.rfind('=');
+  if (Eq == std::string_view::npos || Eq == 0) {
+    return {Invalid, 0};
+  }
+  const auto Exe = Spec.substr(0, Eq);
+  const auto ModeName = Spec.substr(Eq + 1);
+  uint8_t Mode;
+  if (ModeName == "none") {
+    Mode = 0;
+  } else if (ModeName == "mtrack") {
+    Mode = 1;
+  } else if (ModeName == "full") {
+    Mode = 2;
+  } else {
+    return {Invalid, 0};
+  }
+  return SMCChecksForNameEquals(Exe, AppName) ? SMCChecksForResult {Apply, Mode} : SMCChecksForResult {OtherProcess, 0};
+}
+} // namespace FEX::Windows
