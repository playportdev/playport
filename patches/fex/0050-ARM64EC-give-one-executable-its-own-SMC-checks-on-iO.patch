+#ifdef FEX_IOS_HOST
+// PLA-401 diagnostics: FEX_SMCCHECKS_FOR (SMCChecksFor.h) sets SMCChecks for one
+// executable only. The environment layer is FEX's highest, so a session-wide
+// FEX_SMCCHECKS cannot be narrowed by an app config; this is set over it, in this
+// process only, before any code is translated. Silent unless the variable is set.
+static void ApplySMCChecksFor(std::string_view AppName) {
+  static_assert(FEXCore::Config::CONFIG_SMC_NONE == 0 && FEXCore::Config::CONFIG_SMC_MTRACK == 1 && FEXCore::Config::CONFIG_SMC_FULL == 2,
+                "SMCChecksFor.h uses FEX's SMCChecks values");
+  const char* Spec = getenv("FEX_SMCCHECKS_FOR");
+  if (!Spec) {
+    return;
+  }
+  const auto Result = FEX::Windows::ParseSMCChecksFor(Spec, AppName);
+  using enum FEX::Windows::SMCChecksForResult::KindType;
+  if (Result.Kind == Apply) {
+    FEXCore::Config::Set(FEXCore::Config::CONFIG_SMCCHECKS, fextl::fmt::format("{}", Result.Mode));
+  }
+  FEX_CONFIG_OPT(SMCChecks, SMCCHECKS);
+  static constexpr const char* ModeNames[] = {"none", "mtrack", "full"};
+  const auto Effective = SMCChecks();
+  LogMan::Msg::EFmt("[smc-for] exe={} for={} {} smcchecks={}", AppName, Spec,
+                    Result.Kind == Apply ? "applied" : Result.Kind == Invalid ? "invalid-ignored" : "other-process",
+                    Effective < 3 ? ModeNames[Effective] : "unknown");
+}
+#endif
+
 NTSTATUS ProcessInit() {
   /* iOS-Madeira: DualMap::WriteOffset (RX→RW alias distance) is set below,
