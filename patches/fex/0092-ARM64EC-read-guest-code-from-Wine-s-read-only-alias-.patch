 // The whole 32-bit window for every block (OpcodeDispatcher.cpp's BeginFunction
 // takes 0 to 4 GiB in 32-bit mode as the guest window).
 int IosSubfloorWindowForCode(uint64_t, uint64_t* Low, uint64_t* Size, uint64_t* Real) {
