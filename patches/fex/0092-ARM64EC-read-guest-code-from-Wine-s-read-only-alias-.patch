 const Decoder::DecodeStream Decoder::AdjustAddrForSpecialRegion(const uint8_t* _InstStream, uint64_t EntryPoint, uint64_t RIP) {
@@ -1416,6 +1417,23 @@ const Decoder::DecodeStream Decoder::AdjustAddrForSpecialRegion(const uint8_t* _
       };
     }
   }
+  /* Playport (PLA-516): code on a host page Wine keeps closed for a no-access
