diff --git a/Source/Windows/ARM64EC/IosJitAlias.cpp b/Source/Windows/ARM64EC/IosJitAlias.cpp
index 4127fe2e1..82248132a 100644
--- a/Source/Windows/ARM64EC/IosJitAlias.cpp
+++ b/Source/Windows/ARM64EC/IosJitAlias.cpp
@@ -495,6 +495,106 @@ static bool IosSubfloorAdd(uint64_t LowBase, uint64_t RealBase, uint64_t Size) {
 }
 /* ======================= end ml951 SUB-FLOOR WINDOWS ===================== */
 
+/* ===================== Playport (PLA-516) CODE-READ ALIASES ===================
+ *
+ * Wine keeps a host page that holds a committed PAGE_NOACCESS 4 KB page beside
+ * code PROT_NONE, so the guest's read of the closed page faults as on Windows;
+ * an access to its open pages is completed by Wine's Mach handler. The decoder
+ * reading such a page's code, a byte at a time, took one Mach exception per
+ * byte (21.4 M in 400 s of World of Warcraft's x64 client). Wine therefore
+ * makes a read-only alias of the view (the same memory) and sends it here
+ * through BTCpu64IosAddAliasMapping with kIosCodeReadFlag set in Size
+ * (Size == the flag alone retires it). FEX's own reads of guest code -- the
+ * decoder's byte source and the disk cache's hashing -- go to the alias; guest
+ * accesses and every executable-range question keep the guest address. Query
+ * only, like the sub-floor table: Module.S never sees it. */
+static constexpr uint64_t kIosCodeReadFlag = 1ull << 63;
+static constexpr int kMaxCodeReadEntries = 32;
+
+struct IosCodeReadEntry {
+  uint64_t Base;
+  uint64_t Alias;
+  uint64_t Size;
+  uint64_t _Padding;
+};
+static IosCodeReadEntry g_CodeRead[kMaxCodeReadEntries];
+static int g_CodeReadCount;               // slots ever used
+static volatile uint64_t g_CodeReadGen;  // odd while a slot changes
+
+// Under AliasWriteLock.
+static void IosCodeReadSlotSet(int Slot, uint64_t Base, uint64_t Alias, uint64_t Size) {
+  __atomic_store_n(&g_CodeReadGen, g_CodeReadGen + 1, __ATOMIC_RELAXED);
+  __atomic_thread_fence(__ATOMIC_SEQ_CST);
+  g_CodeRead[Slot].Base = Base;
+  g_CodeRead[Slot].Alias = Alias;
+  g_CodeRead[Slot].Size = Size;
+  if (Slot == g_CodeReadCount) {
+    __atomic_store_n(&g_CodeReadCount, Slot + 1, __ATOMIC_RELEASE);
+  }
+  __atomic_thread_fence(__ATOMIC_SEQ_CST);
+  __atomic_store_n(&g_CodeReadGen, g_CodeReadGen + 1, __ATOMIC_RELEASE);
+}
+
+// Nothing here may log (see BTCpu64IosAddAliasMapping). 0 when the table is full.
+static int IosCodeReadUpdate(uint64_t Base, uint64_t Alias, uint64_t Size) {
+  int Result = 1, Free = -1;
+  AliasWriteLock();
+  const int Count = g_CodeReadCount;
+  for (int i = 0; i < Count; i++) {
+    if (g_CodeRead[i].Size && g_CodeRead[i].Base == Base && g_CodeRead[i].Alias == Alias) {
+      if (!Size) {
+        IosCodeReadSlotSet(i, 0, 0, 0);
+      }
+      AliasWriteUnlock();
+      return 1;
+    }
+    if (!g_CodeRead[i].Size && Free < 0) {
+      Free = i;
+    }
+  }
+  if (Size) {
+    if (Free < 0 && Count < kMaxCodeReadEntries) {
+      Free = Count;
+    }
+    if (Free < 0) {
+      Result = 0;
+    } else {
+      IosCodeReadSlotSet(Free, Base, Alias, Size);
+    }
+  }
+  AliasWriteUnlock();
+  return Result;
+}
+
+// Where FEX reads the guest code byte at Addr: its view's alias, or Addr. A
+// reader that races a change gives Addr, whose read Wine's handler completes.
+uint64_t IosCodeReadAddr(uint64_t Addr) {
+  if (!__atomic_load_n(&g_CodeReadCount, __ATOMIC_ACQUIRE)) {
+    return Addr; // the common case: no image has a noaccess-split page
+  }
+  for (int Try = 0; Try < 4; Try++) {
+    const uint64_t Gen = __atomic_load_n(&g_CodeReadGen, __ATOMIC_ACQUIRE);
+    if (Gen & 1) {
+      continue;
+    }
+    uint64_t Result = Addr;
+    const int Count = __atomic_load_n(&g_CodeReadCount, __ATOMIC_ACQUIRE);
+    for (int i = 0; i < Count; i++) {
+      const uint64_t Base = g_CodeRead[i].Base, Size = g_CodeRead[i].Size;
+      if (Size && Addr - Base < Size) {
+        Result = g_CodeRead[i].Alias + (Addr - Base);
+        break;
+      }
+    }
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    if (__atomic_load_n(&g_CodeReadGen, __ATOMIC_RELAXED) == Gen) {
+      return Result;
+    }
+  }
+  return Addr;
+}
+/* =================== end Playport (PLA-516) CODE-READ ALIASES ================= */
+
 /* Returns 1 when the alias is in the table (or retired), 0 when it was
  * refused because the table is full: the caller (Wine's ntdll-unix) logs it.
  *
@@ -523,6 +623,9 @@ int BTCpu64IosAddAliasMapping(uint64_t PeBase, uint64_t JitBase, uint64_t Size)
   if (Size && PeBase < kIosSubfloorFloor) {
     return IosSubfloorAdd(PeBase, JitBase, Size) ? 1 : 0;
   }
+  if (Size & kIosCodeReadFlag) {
+    return IosCodeReadUpdate(PeBase, JitBase, Size & ~kIosCodeReadFlag);
+  }
   AliasWriteLock();
   const int Result = IosAddAliasMappingLocked(PeBase, JitBase, Size);
   AliasWriteUnlock();
