@@ -169,6 +169,11 @@ uint64_t IosSubfloorToReal(uint64_t Address) {
   return Window::Base ? Window::ToHost(Address) : Address;
 }
 
+// Wine sends code-read aliases to the ARM64EC module only (IosJitAlias.cpp).
+uint64_t IosCodeReadAddr(uint64_t Address) {
+  return Address;
+}
