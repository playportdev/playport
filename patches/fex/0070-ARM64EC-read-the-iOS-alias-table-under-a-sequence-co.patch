+  /* ml951: a sub-floor window arrives through this same entry point, marked by
+   * a below-4GB "PeBase" (no real PE base can be there on iOS). Route it to the
+   * query-only table and return -- it must NEVER land in IosAliasEntries, which
+   * Module.S uses to rewrite branch targets. */
+  if (Size && PeBase < kIosSubfloorFloor) {
+    return IosSubfloorAdd(PeBase, JitBase, Size) ? 1 : 0;
+  }
+  AliasWriteLock();
+  const int Result = IosAddAliasMappingLocked(PeBase, JitBase, Size);
+  AliasWriteUnlock();
+  return Result;
+}
+
+static int IosAddAliasMappingLocked(uint64_t PeBase, uint64_t JitBase, uint64_t Size) {
   if (!Size) {
     const int count = g_EntryCount;
+    bool Changing = false;
     for (int i = 0; i < count; i++) {
       if (g_Entries[i].Size && g_Entries[i].PeBase == PeBase && g_Entries[i].JitBase == JitBase) {
+        if (!Changing) {
+          AliasChangeBegin();
+          Changing = true;
+        }
         g_Entries[i].Size = 0;  // a zero-size entry matches no query, Module.S's walk included
         __sync_synchronize();
       }
     }
+    if (Changing) {
+      AliasChangeEnd();
+    }
     return 1;
   }
 
-  /* ml951: a sub-floor window arrives through this same entry point, marked by
-   * a below-4GB "PeBase" (no real PE base can be there on iOS). Route it to the
-   * query-only table and return -- it must NEVER land in IosAliasEntries, which
-   * Module.S uses to rewrite branch targets. */
-  if (PeBase < kIosSubfloorFloor) {
-    return IosSubfloorAdd(PeBase, JitBase, Size) ? 1 : 0;
-  }
-
   int count = g_EntryCount;
 
   // Identical re-registration: nothing to do.
@@ -400,6 +476,14 @@ int BTCpu64IosAddAliasMapping(uint64_t PeBase, uint64_t JitBase, uint64_t Size)
     }
   }
 
+  AliasChangeBegin();
+  const int Result = IosAliasInsert(PeBase, JitBase, Size, count);
+  AliasChangeEnd();
+  return Result;
+}
+
+// Between AliasChangeBegin and AliasChangeEnd: count is IosAliasCount.
+static int IosAliasInsert(uint64_t PeBase, uint64_t JitBase, uint64_t Size, int count) {
   // Retire every entry whose PE range overlaps the incoming image: a live
   // image proves any overlapping entry is dead (two images cannot share a VA).
   for (int i = 0; i < count; i++) {
@@ -441,27 +525,29 @@ int BTCpu64IosAddAliasMapping(uint64_t PeBase, uint64_t JitBase, uint64_t Size)
 }
 
