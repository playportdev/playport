 .endm
+// Playport: ExitFunctionEC and ExitFunctionECJit read IosAliasEntries under IosAliasGen, the table's
+// sequence count (IosJitAlias.cpp), which a writer makes odd while it changes the table. BEGIN leaves
+// the target untranslated while it is odd, else puts it in x17 bits 32-63 (bits 0-31 count the walk's
+// entries); END branches to \changed when it moved since, so a slot retired and reused under the read
+// cannot pair one image's PeBase and Size with another's JitBase. Untranslated is always correct:
+// the PE VA reaches the pool copy through the Mach exec-fault redirect. END clobbers x16.
+.macro IOS_ALIAS_READ_BEGIN
+  adrp x17, IosAliasGen
+  add x17, x17, #:lo12:IosAliasGen
+  ldar x17, [x17]
+  tbnz x17, #0, ios_ec_xlate_done
+  lsl x17, x17, #32
+.endm
+.macro IOS_ALIAS_READ_END changed
+  dmb ishld
+  adrp x16, IosAliasGen
+  ldr x16, [x16, #:lo12:IosAliasGen]
+  eor x16, x17, x16, lsl #32
+  lsr x16, x16, #32
+  cbnz x16, \changed
+.endm
 #endif
 
