From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Wed, 21 Oct 2026 10:58:03 +0200
Subject: [PATCH 70/71] ARM64EC: read the iOS alias table under a sequence
 count, one writer at a time

Module.S's x64->EC translation (ExitFunctionEC, ExitFunctionECJit and
ExitToX64's FFS bypass) read an IosAliasEntries slot's PeBase, Size and
JitBase as three plain loads with no order among them. The writer
retires a slot (Size 0) and later reuses it for another image (PeBase,
JitBase, barrier, Size), so a reader across a retire and reuse could
pair the old image's PeBase with the new image's Size and JitBase and
branch into the wrong pool copy. BTCpu64IosAddAliasMapping also had no
lock: two images loading at once in two processes could take the same
retired slot or the same new index, and one image was then not listed.

IosAliasGen is now the table's sequence count: a writer, one at a time
under a spin lock, makes it odd before its first entry store and even
after its last. The asm walks read it with LDAR first and again after
the entry (DMB ISHLD), and leave the target untranslated when it was
odd or moved: the PE VA then reaches the pool copy through the Mach
exec-fault redirect, as an image not in the table always has.
IosJitTranslate and IosJitReverseTranslate read again instead. The lock
is taken over after about 4 M spins and an odd count left by a writer
that ended inside moves on by two, so a thread killed in its unix call
cannot stop later images from being listed.

Linear: PLA-364
Class: ios-port
Evidence: docs/evidence/2026-10-21-batch2.md
Offered-upstream: no; Madeira's iOS code
---
 Source/Windows/ARM64EC/IosJitAlias.cpp | 134 ++++++++++++++++++++-----
 Source/Windows/ARM64EC/Module.S        |  72 ++++++++++---
 2 files changed, 168 insertions(+), 38 deletions(-)

diff --git a/Source/Windows/ARM64EC/IosJitAlias.cpp b/Source/Windows/ARM64EC/IosJitAlias.cpp
index 7fdeb5c98..ab121a2cf 100644
--- a/Source/Windows/ARM64EC/IosJitAlias.cpp
+++ b/Source/Windows/ARM64EC/IosJitAlias.cpp
@@ -53,11 +53,70 @@ volatile int IosAliasCount = 0;
  * runtime) are registered late, so oldest-first cost ~150 iterations per
  * x64->EC call at up to a million calls a second. */
 IosAliasEntry* volatile IosAliasLast = nullptr;
+/* Playport: the table's sequence count. BTCpu64IosAddAliasMapping makes it odd before it changes an
+ * entry and even again after, so a reader that sees it odd, or sees it move across its read, drops
+ * what it read: Module.S's walks then leave the target untranslated, IosJitTranslate and
+ * IosJitReverseTranslate read again. Without it a reader could pair a retired slot's old PeBase with
+ * the Size and JitBase of the image that reused it, and branch into the wrong copy. */
+volatile uint64_t IosAliasGen = 0;
 }
 
 namespace {
 IosAliasEntry* const g_Entries = IosAliasEntries;
 volatile int& g_EntryCount = IosAliasCount;
+
+/* Playport: one writer at a time. Two images loading at once in different processes could take
+ * the same retired slot or the same new index, and one image was then left out of the table. */
+std::atomic<uint32_t> g_AliasWriteLock {0};
+
+/* Bounded: a writer ended inside (a thread killed in its unix call) must not stop every later image
+ * from being listed, so after about 4 M spins the lock is taken over. */
+void AliasWriteLock() {
+  for (uint32_t Spins = 0; g_AliasWriteLock.exchange(1, std::memory_order_acquire); ) {
+    while (g_AliasWriteLock.load(std::memory_order_relaxed)) {
+      __asm__ volatile("yield");
+      if (++Spins >= (1u << 22)) {
+        return;
+      }
+    }
+  }
+}
+
+void AliasWriteUnlock() {
+  g_AliasWriteLock.store(0, std::memory_order_release);
+}
+
+// Under the lock: the count goes odd before the first entry store and even after the last. An odd
+// count here was left by a writer that ended inside; it moves on by two, still odd.
+void AliasChangeBegin() {
+  const uint64_t Gen = IosAliasGen;
+  __atomic_store_n(&IosAliasGen, (Gen & 1) ? Gen + 2 : Gen + 1, __ATOMIC_RELAXED);
+  __atomic_thread_fence(__ATOMIC_SEQ_CST);
+}
+
+void AliasChangeEnd() {
+  __atomic_thread_fence(__ATOMIC_SEQ_CST);
+  __atomic_store_n(&IosAliasGen, IosAliasGen + 1, __ATOMIC_RELEASE);
+}
+
+// A reader's consistent view: Read(count) runs until no change overlapped it. After many
+// attempts against a writer that does not finish, the caller's untranslated answer stands.
+template<typename F>
+uint64_t AliasRead(uint64_t Untranslated, F Read) {
+  for (int Attempt = 0; Attempt < 4096; Attempt++) {
+    const uint64_t Gen = __atomic_load_n(&IosAliasGen, __ATOMIC_ACQUIRE);
+    if (Gen & 1) {
+      __asm__ volatile("yield");
+      continue;
+    }
+    const uint64_t Result = Read(__atomic_load_n(&g_EntryCount, __ATOMIC_ACQUIRE));
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    if (__atomic_load_n(&IosAliasGen, __ATOMIC_RELAXED) == Gen) {
+      return Result;
+    }
+  }
+  return Untranslated;
+}
 }  // namespace
 
