-    uint64_t jb = g_Entries[i].JitBase;
-    uint64_t sz = g_Entries[i].Size;
-    if (Addr >= jb && Addr < jb + sz) {
-      return g_Entries[i].PeBase + (Addr - jb);
+  return AliasRead(Addr, [Addr](int count) {
+    for (int i = 0; i < count; i++) {
+      uint64_t jb = g_Entries[i].JitBase;
+      uint64_t sz = g_Entries[i].Size;
+      if (Addr >= jb && Addr < jb + sz) {
+        return g_Entries[i].PeBase + (Addr - jb);
