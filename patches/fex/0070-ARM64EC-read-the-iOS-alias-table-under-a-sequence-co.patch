+  return AliasRead(Addr, [Addr](int count) {
+    for (int i = 0; i < count; i++) {
+      uint64_t pb = g_Entries[i].PeBase;
+      uint64_t sz = g_Entries[i].Size;
+      if (Addr >= pb && Addr < pb + sz) {
