+
+/* Playport, MADEIRA_FEX_BATCH2 "alias" (IosFexBatch2 bit 0, Arm64Emitter.h): every listed image's
+ * 64 KB granules, kept by the writer under IosAliasGen, so Module.S translates an x64->EC target with
+ * one probe instead of the hint and walk. Open addressing from (granule + 1) & 32767, linear probing,
+ * never more than half full. Key: granule + 1, 0 for an empty slot. Delta: JitBase - PeBase of the one
+ * image the granule lies in whole, or kAliasGranulePart (odd, no delta is) when it is only partly an
+ * image's or two images claim it: those take the walk. Module.S relies on the 16-byte slot, the 32768
+ * slots and key below 2^40. */
+struct IosAliasGranule {
+  uint64_t Key;
+  uint64_t Delta;
+};
+constexpr uint32_t kAliasGranuleSlots = 32768;
+constexpr uint64_t kAliasGranulePart = 1;
+alignas(16) IosAliasGranule IosAliasGranules[kAliasGranuleSlots];
+extern uint32_t IosFexBatch2;
 }
 
 namespace {
@@ -99,6 +116,70 @@ void AliasChangeEnd() {
   __atomic_store_n(&IosAliasGen, IosAliasGen + 1, __ATOMIC_RELEASE);
 }
 
+uint32_t g_AliasGranulesUsed = 0;
+
+// Under the lock with IosAliasGen odd. False when the table would be more than half full.
+bool AliasGranulePut(uint64_t Key, uint64_t Delta) {
+  for (uint32_t i = Key & (kAliasGranuleSlots - 1);; i = (i + 1) & (kAliasGranuleSlots - 1)) {
+    IosAliasGranule& Slot = IosAliasGranules[i];
+    if (Slot.Key == Key) {
+      if (Slot.Delta != Delta) {
+        Slot.Delta = kAliasGranulePart;
+      }
+      return true;
+    }
+    if (!Slot.Key) {
+      if (g_AliasGranulesUsed >= kAliasGranuleSlots / 2) {
+        return false;
+      }
+      Slot.Delta = Delta;
+      Slot.Key = Key;
+      g_AliasGranulesUsed++;
+      return true;
+    }
+  }
+}
+
+bool AliasGranulesAddImage(uint64_t PeBase, uint64_t JitBase, uint64_t Size) {
+  const uint64_t End = PeBase + Size;
+  if (!Size || End < PeBase || (End >> 56)) {
+    return false;
+  }
+  const uint64_t Delta = JitBase - PeBase;
+  for (uint64_t Granule = PeBase >> 16; Granule <= (End - 1) >> 16; Granule++) {
+    const bool Whole = (Granule << 16) >= PeBase && ((Granule + 1) << 16) <= End && !(Delta & 1);
+    if (!AliasGranulePut(Granule + 1, Whole ? Delta : kAliasGranulePart)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Under the lock with IosAliasGen odd: the granule lookup off (bit 0 cleared) and the table emptied,
+// as no later change keeps it: a reader whose read of bit 0 was older than the count it then reads
+// finds every slot empty and leaves the target untranslated. Module.S walks as before.
+void AliasGranulesOff() {
+  __atomic_fetch_and(&IosFexBatch2, ~1u, __ATOMIC_RELAXED);
+  memset(IosAliasGranules, 0, sizeof(IosAliasGranules));
+  g_AliasGranulesUsed = 0;
+}
+
+// Under the lock with IosAliasGen odd: the table from the live entries, or off on overflow.
+void AliasGranulesRebuild() {
+  if (!(__atomic_load_n(&IosFexBatch2, __ATOMIC_RELAXED) & 1)) {
+    return;
+  }
+  memset(IosAliasGranules, 0, sizeof(IosAliasGranules));
+  g_AliasGranulesUsed = 0;
+  const int count = g_EntryCount;
+  for (int i = 0; i < count; i++) {
+    if (g_Entries[i].Size && !AliasGranulesAddImage(g_Entries[i].PeBase, g_Entries[i].JitBase, g_Entries[i].Size)) {
+      AliasGranulesOff();
+      return;
+    }
+  }
+}
