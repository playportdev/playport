+/* Playport: MADEIRA_FEX_BATCH2 "alias" on (Module.cpp, ProcessInit): sets bit 0 and builds the granule
+ * table from the entries listed so far, under the writer lock, so no image added meanwhile is missed.
+ * Returns the granules used, or -1 when they did not fit and the walk stays. */
+int IosAliasGranulesEnable(void) {
+  AliasWriteLock();
+  AliasChangeBegin();
+  __atomic_fetch_or(&IosFexBatch2, 1u, __ATOMIC_RELAXED);
+  AliasGranulesRebuild();
+  const int Used = (__atomic_load_n(&IosFexBatch2, __ATOMIC_RELAXED) & 1) ? static_cast<int>(g_AliasGranulesUsed) : -1;
+  AliasChangeEnd();
+  AliasWriteUnlock();
+  return Used;
+}
+
 // Between AliasChangeBegin and AliasChangeEnd: count is IosAliasCount.
 static int IosAliasInsert(uint64_t PeBase, uint64_t JitBase, uint64_t Size, int count) {
+  bool Retired = false;
+  const int Listed = IosAliasList(PeBase, JitBase, Size, count, Retired);
+  if (__atomic_load_n(&IosFexBatch2, __ATOMIC_RELAXED) & 1) {
+    if (Retired) {
+      AliasGranulesRebuild();
+    } else if (Listed && !AliasGranulesAddImage(PeBase, JitBase, Size)) {
+      AliasGranulesOff();
+    }
+  }
+  return Listed;
+}
