--- a/Source/Windows/Common/InvalidationTracker.cpp
+++ b/Source/Windows/Common/InvalidationTracker.cpp
@@ -118,7 +118,7 @@ void InvalidationTracker::HandleMemoryProtectionNotification(uint64_t Address, u
 
   if (NeedsInvalidate) {
     // IntervalsLock cannot be held during invalidation
-    InvalidateIntervalInternal(AlignedBase, AlignedSize);
+    InvalidateIntervalInternal(AlignedBase, AlignedSize, InvProtect);
   }
 }
 
@@ -168,7 +168,7 @@ void InvalidationTracker::HandleProcessExecuteFlagsChange(ULONG Flags) {
 
   // Invalidate all cached code: previously-compiled blocks may contain NoExec stubs for addresses
   // that are now executable (or reference regions whose executability just changed).
-  InvalidateIntervalInternalLocked(0, std::numeric_limits<uint64_t>::max());
+  InvalidateIntervalInternalLocked(0, std::numeric_limits<uint64_t>::max(), InvDEP);
 }
 
 void InvalidationTracker::HandleImageMap(std::string_view Name, uint64_t Address) {
@@ -342,7 +342,7 @@ InvalidationTracker::InvalidateContainingSectionResult InvalidationTracker::Inva
     SectionSize += Info.RegionSize;
   }
 
-  InvalidateIntervalInternal(SectionBase, SectionSize);
+  InvalidateIntervalInternal(SectionBase, SectionSize, InvSection);
 
   if (Free) {
     std::unique_lock Lock(IntervalsLock);
@@ -364,7 +364,7 @@ void InvalidationTracker::InvalidateAlignedInterval(uint64_t Address, uint64_t S
   const auto AlignedBase = Address & FEXCore::Utils::FEX_PAGE_MASK;
   const auto AlignedSize = std::max(Size, (Address - AlignedBase + Size + FEXCore::Utils::FEX_PAGE_SIZE - 1) & FEXCore::Utils::FEX_PAGE_MASK);
 
-  InvalidateIntervalInternal(AlignedBase, AlignedSize);
+  InvalidateIntervalInternal(AlignedBase, AlignedSize, InvAligned);
 
   if (Free) {
     std::unique_lock Lock(IntervalsLock);
@@ -402,7 +402,7 @@ bool InvalidationTracker::HandleRWXAccessViolation(FEXCore::Core::InternalThread
     {
       std::scoped_lock Lock(CTX.GetCodeInvalidationMutex());
 
-      InvalidateIntervalInternalLocked(FaultAddress & FEXCore::Utils::FEX_PAGE_MASK, FEXCore::Utils::FEX_PAGE_SIZE);
+      InvalidateIntervalInternalLocked(FaultAddress & FEXCore::Utils::FEX_PAGE_MASK, FEXCore::Utils::FEX_PAGE_SIZE, InvAccessViolation);
 
       // Invalidate, then unprotect the faulting page with the compilation lock held to ensure that any racing invalidations are not dropped.
       ULONG TmpProt;
@@ -488,12 +488,29 @@ void InvalidationTracker::DetectMonoBackpatcherBlock(FEXCore::Core::InternalThre
     }
   }
 #ifndef FEX_IOS_HOST
-  /* ml648: SKIPPED ON iOS. DisableSMCDetection() reprotects every RWX interval
-   * as WRITABLE, and iOS will never grant write on the guest VA — that is the
-   * entire reason the RW alias exists. On iOS it can only churn protections
-   * that cannot change. The win here comes purely from MarkMonoBackpatcherBlock
-   * plus the alias-directed MonoBackpatcherWrite. */
   DisableSMCDetection();
+#else
+  /* Playport: do what upstream does on iOS too. Madeira skipped this (ml648)
+   * because the guest VA of Mono's code could not be made writable. Since
+   * madeira-unix 0019 that range is the pool's RW view, and 0027 applies the
+   * write/no-write half of a protection there, so the reprotect works. Without
+   * it every block FEX compiles from a Mono code page reprotects the page
+   * read-only (ReprotectRWXIntervals), Mono's next method written into that
+   * page faults, and FEX invalidates the whole page and resets every thread's
+   * call-return stack: in Hollow Knight about 19,000 reprotects, 2,300 access
+   * violations and 17,000 resets before the first frame. Upstream turns the
+   * tracking off here because MonoHacks covers Mono's own code patching: the
+   * call backpatcher becomes MonoBackpatcherWrite and tail-call sites get
+   * inline SMC checks (Frontend.cpp IsBranchMonoTailcall).
+   * MADEIRA_KEEP_SMC=1 keeps the tracking, for an A/B. */
+  {
+    const char* Keep = getenv("MADEIRA_KEEP_SMC");
+    const bool KeepSMC = Keep && Keep[0] == '1';
+    LogMan::Msg::EFmt("[smc-off] Mono backpatcher detected: SMC detection {}", KeepSMC ? "KEPT (MADEIRA_KEEP_SMC=1)" : "disabled, as upstream");
+    if (!KeepSMC) {
+      DisableSMCDetection();
+    }
+  }
 #endif
   {
     std::scoped_lock CodeLock(CTX.GetCodeInvalidationMutex());
@@ -535,17 +552,56 @@ ULONG InvalidationTracker::GetUntrapProt(uint64_t Address) const {
   return PAGE_EXECUTE_READWRITE;
 }
 
-void InvalidationTracker::InvalidateIntervalInternal(uint64_t Address, uint64_t Size) {
+void InvalidationTracker::InvalidateIntervalInternal(uint64_t Address, uint64_t Size, InvalidationSource Src) {
   std::scoped_lock CodeLock(CTX.GetCodeInvalidationMutex());
-  InvalidateIntervalInternalLocked(Address, Size);
+  InvalidateIntervalInternalLocked(Address, Size, Src);
 }
 
-void InvalidationTracker::InvalidateIntervalInternalLocked(uint64_t Address, uint64_t Size) {
+/* Playport [inv-census]: how many code invalidations each caller makes and
+ * what they cost. Every invalidation clears the lookup caches for the range
+ * and, where a thread had blocks there, resets that thread's call-return
+ * stack (Core.cpp ResetCallRetStack), so this is the price of SMC tracking.
+ * One line every 1024 invalidations: counts by source, and the microseconds
+ * spent in this function by source (the generic timer). */
+namespace {
+std::atomic<uint64_t> InvCount[InvalidationTracker::InvSourceCount];
+std::atomic<uint64_t> InvTicks[InvalidationTracker::InvSourceCount];
+std::atomic<uint64_t> InvTotal;
+inline uint64_t InvNow() {
+  uint64_t V;
+  __asm__ volatile("mrs %0, cntvct_el0" : "=r"(V));
+  return V;
+}
+inline uint64_t InvTicksPerUs() {
+  uint64_t V;
+  __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(V));
+  V /= 1000000;
+  return V ? V : 24;
+}
+} // namespace
+
+void InvalidationTracker::InvalidateIntervalInternalLocked(uint64_t Address, uint64_t Size, InvalidationSource Src) {
   // NOTE: This assumes CodeInvalidationMutex is locked by the caller
+  const uint64_t T0 = InvNow();
   CTX.InvalidateCodeBuffersCodeRange(Address, Size);
   for (auto Thread : Threads) {
     CTX.InvalidateThreadCachedCodeRange(Thread.second, Address, Size);
   }
+  const uint32_t S = Src < InvSourceCount ? Src : InvOther;
+  InvCount[S].fetch_add(1, std::memory_order_relaxed);
+  InvTicks[S].fetch_add(InvNow() - T0, std::memory_order_relaxed);
+  // The release app sets MADEIRA_NO_DIAGNOSTICS: count, but print nothing.
+  static const bool Quiet = getenv("MADEIRA_NO_DIAGNOSTICS") != nullptr;
+  if (((InvTotal.fetch_add(1, std::memory_order_relaxed) + 1) & 0x3ff) == 0 && !Quiet) {
+    const uint64_t F = InvTicksPerUs();
+    auto Us = [&](uint32_t I) { return InvTicks[I].load(std::memory_order_relaxed) / F; };
+    auto N = [&](uint32_t I) { return InvCount[I].load(std::memory_order_relaxed); };
+    LogMan::Msg::EFmt("[inv-census] n={} smc_off={} | protect {} {}us | av {} {}us | aligned {} {}us | section {} {}us | dep {} {}us | "
+                      "untracked {} {}us | other {} {}us",
+                      InvTotal.load(std::memory_order_relaxed), SMCDetectionDisabled ? 1 : 0, N(InvProtect), Us(InvProtect),
+                      N(InvAccessViolation), Us(InvAccessViolation), N(InvAligned), Us(InvAligned), N(InvSection), Us(InvSection),
+                      N(InvDEP), Us(InvDEP), N(InvUntrackedWrite), Us(InvUntrackedWrite), N(InvOther), Us(InvOther));
+  }
 }
 
 bool InvalidationTracker::ProtectRWXIntervalsInternal(uint64_t Address, uint64_t Size, bool ForWriteLocked) {
@@ -566,7 +622,7 @@ bool InvalidationTracker::ProtectRWXIntervalsInternal(uint64_t Address, uint64_t
           // applied and the invalidation mutex must be locked throughout.
           // Do this lazily only when an RWX region is actually hit.
           // NOTE: This assumes CodeInvalidationMutex is locked by the caller
-          InvalidateIntervalInternalLocked(Address, Size);
+          InvalidateIntervalInternalLocked(Address, Size, InvUntrackedWrite);
         }
         HitRWXInterval = true;
       }
