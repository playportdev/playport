From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Tue, 20 Oct 2026 16:55:38 +0200
Subject: [PATCH] ARM64EC: a leaner ExitFunctionEC for the JIT's own exits on
 iOS

Every guest call into ARM64EC code leaves the JIT through ExitFunctionEC
(Module.S). On iOS that stub reads FPCR to clear AFP's NEP and AH bits,
counts the call with an LSE atomic on a shared IosXpFex shard, checks
the PLA-401 call ring, finds the CPU area through TPIDRRO_EL0, the TEB's
TSD slot and TEB->ChpeV2CpuAreaInfo, reads the suspend doorbell through
the CPU area, and starts the alias-table walk at a process-wide last-hit
pointer every thread writes.

ExitFunctionECJit is the same stub for exits from JIT code, where x28
holds the thread's CpuStateFrame:
- no FPCR test: it is installed only when AFP is off, and then FEX never
  sets FPCR.NEP or FPCR.AH;
- no ring check: it is installed only while FEX_EC_CALL_RING left the
  ring off;
- the CPU area comes from the frame (IosCpuArea, stored by ThreadInit)
  and the doorbell from the frame's own SuspendDoorbell, which
  ChpeV2CpuAreaInfo->SuspendDoorbell points at; the InSimulation store
  still comes before the doorbell load;
- the call is counted in the frame (IosXpCallCount) and, while
  IosXpFexOn is set, added to the shard 64 at a time with STADD;
- the alias walk starts at the thread's own last hit (IosAliasHint). A
  retired entry has Size 0 and misses, as IosAliasLast does.
The suspend point, the entry-thunk dispatch and everything after the
translation are ExitFunctionEC's own code. The three frame fields are
appended after the existing ones (iOS ARM64EC only); Module.S reads them
at fixed offsets that static_asserts in Module.cpp check. This tree's
frame has no guest branch history, so the offsets are 3856-3872, not
Madeira's 4080-4096.

On when AFP is off (FEX_HOSTFEATURES=disableafp; Playport's default
keeps AFP on, RDR2's compatibility default turns it off), as in Madeira;
MADEIRA_FEX_EC_EXIT_LEAN=0 at launch keeps ExitFunctionEC. The [xp-api]
x64->EC rate lags by fewer than 64 calls per thread. One "FEX:
ec-exit-lean-v1 ... enabled= afp= ring=" line logs the choice.

Madeira-commit: 58a152b3b600d78237611fadadb49472208aa900 (willfaust/FEX)
Linear: PLA-364
Class: feature
Evidence: docs/evidence/2026-10-20-rdr2-perf-ports.md
Offered-upstream: no; the stub's iOS lookups are the iOS port's
---
 FEXCore/include/FEXCore/Core/CoreState.h |  9 ++++
 Source/Windows/ARM64EC/Module.S          | 69 ++++++++++++++++++++++++
 Source/Windows/ARM64EC/Module.cpp        | 27 ++++++++++
 3 files changed, 105 insertions(+)

diff --git a/FEXCore/include/FEXCore/Core/CoreState.h b/FEXCore/include/FEXCore/Core/CoreState.h
index 3e845ea..89f7c06 100644
--- a/FEXCore/include/FEXCore/Core/CoreState.h
+++ b/FEXCore/include/FEXCore/Core/CoreState.h
@@ -494,6 +494,15 @@ struct CpuStateFrame {
   // pointer does not change once the first ARM64EC image is mapped, before any thread enters the JIT.
   uint64_t IosEcCodeBitMap {};
 #endif
+
+#if defined(FEX_IOS_HOST) && defined(ARCHITECTURE_arm64ec)
+  // Read by ExitFunctionECJit in ARM64EC/Module.S at fixed offsets (checked in ARM64EC/Module.cpp): this
+  // thread's ChpeV2CpuAreaInfo, its x64 -> ARM64EC calls not yet added to IosXpFex, and the alias table
+  // entry its last translation used.
+  uint64_t IosCpuArea {};
+  uint64_t IosXpCallCount {};
+  uint64_t IosAliasHint {};
+#endif
 };
 #if defined(FEX_IOS_HOST) && defined(ARCHITECTURE_arm64ec)
 static_assert(offsetof(CpuStateFrame, IosEcCodeBitMap) % 8 == 0 && offsetof(CpuStateFrame, IosEcCodeBitMap) <= 32760,
diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
index 1afb171..3fb3ca8 100644
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -292,6 +292,75 @@ BeginSimulation:
   mov x11, #0 // Zero ENTRY_FILL_SRA_SINGLE_INST_REG to avoid single step
   br x16 // DispatcherLoopTopEnterECFillSRA(SingleInst:x10, CPUArea:x17)
 
+#ifdef FEX_IOS_HOST
+// FEXCore::Core::CpuStateFrame offsets read below; ARM64EC/Module.cpp checks them with static_asserts.
+#define IOS_FRAME_SUSPEND_DOORBELL 1512
+#define IOS_FRAME_CPU_AREA 3856
+#define IOS_FRAME_XP_COUNT 3864
+#define IOS_FRAME_ALIAS_HINT 3872
+
+  // ExitFunctionEC for exits from JIT code, where x28 is this thread's CpuStateFrame; installed as
+  // Pointers.ExitFunctionEC when AFP is off, so FPCR.NEP and FPCR.AH are never set and there is
+  // nothing to clear, and only while the PLA-401 call ring is off (it has no ring append). The CPU
+  // area and the suspend doorbell come from the frame, the x64->EC call is counted per thread and
+  // added to IosXpFex 64 at a time while IosXpFexOn is set (each 64th call of the thread goes to the
+  // target ring), and the alias lookup starts at this thread's last hit. Same contract and clobbers
+  // as ExitFunctionEC, whose tail it shares.
+.global ExitFunctionECJit
+ExitFunctionECJit:
+  ldr x16, [x28, #IOS_FRAME_XP_COUNT]
+  add x16, x16, #1
+  str x16, [x28, #IOS_FRAME_XP_COUNT]
+  tst x16, #63
+  b.ne 2f
+  adrp x16, IosXpFexOn
+  ldr x23, [x16, #:lo12:IosXpFexOn]
+  cbz x23, 2f
+  adrp x16, IosXpFex
+  add x16, x16, #:lo12:IosXpFex
+  mov x23, sp
+  ubfx x23, x23, #16, #4
+  add x17, x16, x23, lsl #6
+  add x17, x17, #64
+  mov x4, #64
+  stadd x4, [x17]
+  add x17, x16, #3136
+  mov x4, #1
+  ldadd x4, x23, [x17]
+  and x23, x23, #4095
+  add x17, x16, #3200
+  str x9, [x17, x23, lsl #3]
+2:
+  ldr x17, [x28, #IOS_FRAME_CPU_AREA]
+  strb wzr, [x17, #0x0] // ChpeV2CpuAreaInfo->InSimulation
+  ldr w17, [x28, #IOS_FRAME_SUSPEND_DOORBELL] // *ChpeV2CpuAreaInfo->SuspendDoorbell
+  cbnz w17, ExitFunctionSuspendPoint
+  ldr x16, [x28, #IOS_FRAME_ALIAS_HINT]
+  cbz x16, ios_ec_jit_xlate_walk
+  ldr x23, [x16]        // Entry.PeBase
+  sub x23, x9, x23
+  ldr x4, [x16, #16]    // Entry.Size
+  cmp x23, x4
+  b.lo ios_ec_xlate_hit
+ios_ec_jit_xlate_walk:
+  adrp x17, IosAliasCount
+  ldr w17, [x17, #:lo12:IosAliasCount]
+  adrp x16, IosAliasEntries
+  add x16, x16, #:lo12:IosAliasEntries
+  add x16, x16, x17, lsl #5   // one past the last entry
+ios_ec_jit_xlate_loop:
+  cbz w17, ios_ec_xlate_done
+  sub x16, x16, #32
+  sub w17, w17, #1
+  ldr x23, [x16]        // Entry.PeBase
+  sub x23, x9, x23
+  ldr x4, [x16, #16]    // Entry.Size
+  cmp x23, x4
+  b.hs ios_ec_jit_xlate_loop
+  str x16, [x28, #IOS_FRAME_ALIAS_HINT]
+  b ios_ec_xlate_hit
+#endif
+
   // Called into by FEXCore
   // Expects the target code address in x9
 .global ExitFunctionEC
diff --git a/Source/Windows/ARM64EC/Module.cpp b/Source/Windows/ARM64EC/Module.cpp
index e573e88..815499a 100644
--- a/Source/Windows/ARM64EC/Module.cpp
+++ b/Source/Windows/ARM64EC/Module.cpp
@@ -111,6 +111,8 @@ uint64_t IosFfsBypassLog[4] {};
  *   2112  EC->x64 calls through ExitToX64 (not the FFS bypass), 16 shards
  *   3136  ring index (every 64th x64->EC call of a shard appends its target)
  *   3200  ring[4096] of target addresses (as the x64 caller called them)
+ * ExitFunctionECJit adds its thread's x64->EC calls 64 at a time and rings every
+ * 64th call of the thread instead.
  * Keep in sync with Module.S and build/ntdll-unix/server_ios.c (ios_xp_fex_*). */
 extern "C" __attribute__((aligned(64))) uint64_t IosXpFex[4496];
 __attribute__((aligned(64))) uint64_t IosXpFex[4496] {};
@@ -134,6 +136,8 @@ extern "C" __attribute__((aligned(8))) uint64_t IosEcRing;
 __attribute__((aligned(8))) uint64_t IosEcRing = 0;
 constexpr size_t IosEcRingRings = 64, IosEcRingEntries = 512;
 constexpr size_t IosEcRingBytes = 4096 + IosEcRingRings * IosEcRingEntries * 64;
+/* Non-zero when JIT exits use ExitFunctionECJit (Module.S) instead of ExitFunctionEC; set in ProcessInit. */
+static uint32_t IosEcExitLean = 0;
 #endif // FEX_IOS_HOST
 
 namespace Exception {
@@ -144,6 +148,9 @@ extern "C" {
 extern IMAGE_DOS_HEADER __ImageBase; // Provided by the linker
 
 extern void* ExitFunctionEC;
+#ifdef FEX_IOS_HOST
+extern void* ExitFunctionECJit;
+#endif
 extern void* CheckCall;
 extern void* ExitFunctionSuspendPoint;
 extern void* ExitFunctionSuspendResumePoint;
@@ -1372,6 +1379,15 @@ NTSTATUS ProcessInit() {
     auto HostFeatures =
       FEX::Windows::CPUFeatures::FetchHostFeatures(IsWine, FEXCore::HostFeatures::HostTypeEnum::Arm64ec, FEX::Windows::UnixLib::GetPID());
     CTX = FEXCore::Context::Context::CreateNewContext(HostFeatures);
+#ifdef FEX_IOS_HOST
+    /* ExitFunctionECJit (Module.S) leaves out ExitFunctionEC's FPCR test, so it is used only without AFP,
+     * when FEX never sets FPCR.NEP or FPCR.AH, and only while the call ring (FEX_EC_CALL_RING, armed above)
+     * is off: it appends no ring entry. MADEIRA_FEX_EC_EXIT_LEAN=0 keeps ExitFunctionEC. */
+    const char* LeanOpt = getenv("MADEIRA_FEX_EC_EXIT_LEAN");
+    IosEcExitLean = !HostFeatures.SupportsAFP && !IosEcRing && !(LeanOpt && strcmp(LeanOpt, "0") == 0);
+    LogMan::Msg::IFmt("FEX: ec-exit-lean-v1 madeira-bcd enabled={} afp={} ring={}", IosEcExitLean != 0,
+                      HostFeatures.SupportsAFP, IosEcRing != 0);
+#endif
   }
 
 #ifdef FEX_IOS_HOST
@@ -2554,7 +2570,18 @@ NTSTATUS ThreadInit() {
 #ifdef FEX_IOS_HOST
   IosTiLog("[FEX-iOS] TI:callret\n");
 #endif
+#ifdef FEX_IOS_HOST
+  static_assert(offsetof(FEXCore::Core::CpuStateFrame, SuspendDoorbell) == 1512, "IOS_FRAME_SUSPEND_DOORBELL in Module.S");
+  static_assert(offsetof(FEXCore::Core::CpuStateFrame, IosCpuArea) == 3856, "IOS_FRAME_CPU_AREA in Module.S");
+  static_assert(offsetof(FEXCore::Core::CpuStateFrame, IosXpCallCount) == 3864, "IOS_FRAME_XP_COUNT in Module.S");
+  static_assert(offsetof(FEXCore::Core::CpuStateFrame, IosAliasHint) == 3872, "IOS_FRAME_ALIAS_HINT in Module.S");
+  // ExitFunctionECJit reads the CPU area from the frame; the doorbell it reads is the frame's own
+  // SuspendDoorbell, which CPUArea.Area->SuspendDoorbell points at (set below).
+  Thread->CurrentFrame->IosCpuArea = reinterpret_cast<uint64_t>(CPUArea.Area);
+  Thread->CurrentFrame->Pointers.ExitFunctionEC = reinterpret_cast<uintptr_t>(IosEcExitLean ? &ExitFunctionECJit : &ExitFunctionEC);
+#else
   Thread->CurrentFrame->Pointers.ExitFunctionEC = reinterpret_cast<uintptr_t>(&ExitFunctionEC);
+#endif
   CPUArea.StateFrame() = Thread->CurrentFrame;
 
   uint64_t EnterEC = Thread->CurrentFrame->Pointers.DispatcherLoopTopEnterEC;
