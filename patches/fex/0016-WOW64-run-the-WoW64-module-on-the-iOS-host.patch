+// Before InitCore: the JIT's RW alias and the guest window.
+static bool IosHostInit() {
+  // rpmalloc chose FEX's host band before logging existed (rpmalloc.c ios_fex_band_select).
+  if (ios_va_log_len > 0) {
+    LogMan::Msg::EFmt("[wow64-fex] host band selector log:\n{}", std::string_view(ios_va_log, ios_va_log_len));
+  }
+
+  /* Emitted code is written through the JIT pool's RW alias. The app publishes
+   * both bases to Wine, which forwards them to every process (as for the
+   * ARM64EC module); without them there is no writable view of the code. */
+  const char* RwEnv = getenv("WINE_IOS_JIT_RW");
+  const char* RxEnv = getenv("WINE_IOS_JIT_RX");
+  const uint64_t Rw = RwEnv ? strtoull(RwEnv, nullptr, 16) : 0;
+  const uint64_t Rx = RxEnv ? strtoull(RxEnv, nullptr, 16) : 0;
+  if (!Rw || !Rx) {
+    LogMan::Msg::EFmt("[wow64-fex] FATAL: WINE_IOS_JIT_RW/RX missing (RW={} RX={}): no RW alias for the JIT pool", RwEnv ? RwEnv : "(null)",
+                      RxEnv ? RxEnv : "(null)");
+    return false;
+  }
+  FEXCore::DualMap::WriteOffset = static_cast<int64_t>(Rw - Rx);
+
+  /* The window base from the paired TEB32: Wine stores its guest self pointer
+   * (NT_TIB32.Self) and guest PEB32, and native callers get PEB32's host
+   * address from ProcessWow64Information. Both must give the same base. */
+  static constexpr size_t Teb32SelfOffset = 0x18;
+  static constexpr size_t Teb32PebOffset = 0x30;
+  const uint64_t HostTeb32 = GetWowTEB(NtCurrentTeb());
+  const uint32_t GuestTeb32 = *reinterpret_cast<const uint32_t*>(HostTeb32 + Teb32SelfOffset);
+  const uint32_t GuestPeb32 = *reinterpret_cast<const uint32_t*>(HostTeb32 + Teb32PebOffset);
+  ULONG_PTR HostPeb32 = 0;
+  NtQueryInformationProcess(NtCurrentProcess(), ProcessWow64Information, &HostPeb32, sizeof(HostPeb32), nullptr);
+  const uint64_t Base = HostTeb32 - GuestTeb32;
+  LogMan::Msg::EFmt("[wow64-fex] window base={:#x} teb32 host={:#x} guest={:#x} peb32 host={:#x} guest={:#x} write_offset={:#x}", Base,
+                    HostTeb32, GuestTeb32, HostPeb32, GuestPeb32, FEXCore::DualMap::WriteOffset);
+  if (!GuestTeb32 || Base < Window::Size || (Base & 0xffff) || HostPeb32 - GuestPeb32 != Base) {
+    LogMan::Msg::EFmt("[wow64-fex] FATAL: the TEB32 and PEB32 do not name one guest window");
+    return false;
+  }
+  Window::Base = Base;
+  return true;
+}
