+  }
 
 #ifdef FEX_IOS_HOST
   // PLA-401: report our generated-fault provenance (the guest code window is
@@ -1666,7 +1744,11 @@ bool ResetToConsistentStateImpl(const ThreadCPUArea CPUArea, EXCEPTION_RECORD* E
    * no genuine access violation loses its data address. */
   const bool IosDeferAvLog = Exception->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && Exception->NumberParameters >= 2 &&
                              Exception->ExceptionInformation[0] == 1;
+  const bool IosFull = IosExcLog::Count(*Exception);
   auto IosLogAv = [&]() {
+    if (!IosFull) {
+      return;
+    }
     LogMan::Msg::DFmt("Exception: Code: {:X} Address: {:X} AV {} of {:X}", Exception->ExceptionCode,
                       reinterpret_cast<uintptr_t>(Exception->ExceptionAddress),
                       Exception->ExceptionInformation[0] == 0 ? "READ" : Exception->ExceptionInformation[0] == 1 ? "WRITE" : "EXEC",
@@ -1677,6 +1759,9 @@ bool ResetToConsistentStateImpl(const ThreadCPUArea CPUArea, EXCEPTION_RECORD* E
    * the fault is not one FEX completes. */
   const bool IosDeferMisalignLog = Exception->ExceptionCode == EXCEPTION_DATATYPE_MISALIGNMENT;
   auto IosLogException = [&]() {
+    if (!IosFull) {
+      return;
+    }
     LogMan::Msg::DFmt("Exception: Code: {:X} Address: {:X}", Exception->ExceptionCode, reinterpret_cast<uintptr_t>(Exception->ExceptionAddress));
   };
   if (IosDeferAvLog || IosDeferMisalignLog) {
@@ -1865,7 +1950,10 @@ bool ResetToConsistentStateImpl(const ThreadCPUArea CPUArea, EXCEPTION_RECORD* E
   }
 
   if (!IsJIT && !IsDispatcherAddress(NativeContext->Pc)) {
-    LogMan::Msg::DFmt("Passing through exception");
+    IosExcLog::Record(IosExcLog::PassedThrough);
+    if (IosFull) {
+      LogMan::Msg::DFmt("Passing through exception");
+    }
     return false;
   }
 
@@ -1880,9 +1968,12 @@ bool ResetToConsistentStateImpl(const ThreadCPUArea CPUArea, EXCEPTION_RECORD* E
     return true;
   }
 
+  IosExcLog::Record(IosExcLog::Rethrown);
   if (IsEmulatorStackAddress(CPUArea, reinterpret_cast<uint64_t>(__builtin_frame_address(0)))) {
     Exception::RethrowGuestException(*Exception, *NativeContext);
-    LogMan::Msg::DFmt("Rethrowing onto guest stack: {:X}", NativeContext->Sp);
+    if (IosFull) {
+      LogMan::Msg::DFmt("Rethrowing onto guest stack: {:X}", NativeContext->Sp);
+    }
     return true;
   } else {
 #ifdef FEX_IOS_HOST
@@ -1893,11 +1984,13 @@ bool ResetToConsistentStateImpl(const ThreadCPUArea CPUArea, EXCEPTION_RECORD* E
     // anyway — same path Windows takes; worst case we crash here instead
     // of terminating with "Unexpected exception" silently. Better signal
     // than fatal bail.
-    LogMan::Msg::EFmt("iOS: rethrowing JIT fault onto guest stack despite "
-                       "frame@{:X} not in emulator-stack range ({:X}..{:X})",
-                       (uint64_t)__builtin_frame_address(0),
-                       CPUArea.EmulatorStackLimit(),
-                       CPUArea.EmulatorStackBase());
+    if (IosFull) {
+      LogMan::Msg::EFmt("iOS: rethrowing JIT fault onto guest stack despite "
+                         "frame@{:X} not in emulator-stack range ({:X}..{:X})",
+                         (uint64_t)__builtin_frame_address(0),
+                         CPUArea.EmulatorStackLimit(),
+                         CPUArea.EmulatorStackBase());
+    }
     Exception::RethrowGuestException(*Exception, *NativeContext);
     return true;
 #else
