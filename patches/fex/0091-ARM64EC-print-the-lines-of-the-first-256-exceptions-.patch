+/* Playport (PLA-516): every guest exception printed five to seven lines here, and Wine and the Mach
+ * handler add theirs. A guest that takes an exception per page of its code, or loops on one, filled
+ * the 256 MiB dev log before a run could be measured. The lines of the first IosExcFullLines
+ * exceptions are printed as before; after that each exception is only counted, by kind and outcome,
+ * and an [exc-census] line gives the counts every IosExcCensusEvery exceptions and at most every
+ * IosExcCensusSeconds while they keep coming. */
+namespace IosExcLog {
+constexpr uint64_t FullLines = 256;
+constexpr uint64_t CensusEvery = 65536;
+constexpr uint64_t CensusSeconds = 5;
+enum Kind { AvRead, AvWrite, AvExec, Breakpoint, SingleStep, Illegal, Misaligned, Other, KindCount };
+enum Outcome { PassedThrough, Rethrown, OutcomeCount };
+std::atomic<uint64_t> Seen {};
+std::atomic<uint64_t> ByKind[KindCount] {};
+std::atomic<uint64_t> ByOutcome[OutcomeCount] {};
+std::atomic<uint64_t> LastCensus {};
+
+static uint64_t Ticks() {
+  uint64_t Value;
+  __asm volatile("mrs %0, cntvct_el0" : "=r"(Value));
+  return Value;
+}
+
+static uint64_t TickFrequency() {
+  uint64_t Value;
+  __asm volatile("mrs %0, cntfrq_el0" : "=r"(Value));
+  return Value;
+}
+
+static Kind KindOf(const EXCEPTION_RECORD& Rec) {
+  switch (static_cast<NTSTATUS>(Rec.ExceptionCode)) {
+  case EXCEPTION_ACCESS_VIOLATION:
+    if (Rec.NumberParameters < 2) {
+      return Other;
+    }
+    return Rec.ExceptionInformation[0] == 0 ? AvRead : Rec.ExceptionInformation[0] == 1 ? AvWrite : AvExec;
+  case EXCEPTION_BREAKPOINT: return Breakpoint;
+  case EXCEPTION_SINGLE_STEP: return SingleStep;
+  case EXCEPTION_ILLEGAL_INSTRUCTION: return Illegal;
+  case EXCEPTION_DATATYPE_MISALIGNMENT: return Misaligned;
+  default: return Other;
+  }
+}
+
+// Counts the exception; true while its lines are printed in full.
+static bool Count(const EXCEPTION_RECORD& Rec) {
+  const uint64_t N = Seen.fetch_add(1, std::memory_order_relaxed) + 1;
+  ByKind[KindOf(Rec)].fetch_add(1, std::memory_order_relaxed);
+  if (N > FullLines) {
+    const uint64_t Now = Ticks();
+    uint64_t Last = LastCensus.load(std::memory_order_relaxed);
+    const bool Due = (N % CensusEvery) == 0 || Now - Last >= CensusSeconds * TickFrequency();
+    if (Due && LastCensus.compare_exchange_strong(Last, Now, std::memory_order_relaxed)) {
+      auto K = [](Kind I) { return ByKind[I].load(std::memory_order_relaxed); };
+      auto O = [](Outcome I) { return ByOutcome[I].load(std::memory_order_relaxed); };
+      LogMan::Msg::EFmt("[exc-census] {} exceptions seen (lines for the first {} only; a guest fault the JIT raises counts "
+                        "twice: its break, then the guest's own): av read {} write {} exec {}, breakpoint {}, single step {}, "
+                        "illegal {}, misaligned {}, other {}; passed through {}, rethrown to the guest {}, the rest handled here",
+                        N, FullLines, K(AvRead), K(AvWrite), K(AvExec), K(Breakpoint), K(SingleStep), K(Illegal), K(Misaligned),
+                        K(Other), O(PassedThrough), O(Rethrown));
+    }
+  }
+  return N <= FullLines;
+}
+
+static bool Full() {
+  return Seen.load(std::memory_order_relaxed) <= FullLines;
+}
+
+static void Record(Outcome O) {
+  ByOutcome[O].fetch_add(1, std::memory_order_relaxed);
+}
+} // namespace IosExcLog
+
