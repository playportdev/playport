@@ -1455,14 +1456,16 @@ NTSTATUS ProcessInit() {
     const char* QpcOpt = getenv("MADEIRA_X64_QPC_FASTPATH");
     IosRdtscSelfSync = QpcOpt && strcmp(QpcOpt, "1") == 0;
     LogMan::Msg::IFmt("FEX: rdtsc-self-sync enabled={}", IosRdtscSelfSync != 0);
-    /* Playport: MADEIRA_FEX_PAUSE=wfe, isb or yield-os[:K]: what x86 PAUSE compiles to (IosPauseMode in
+    /* Playport: MADEIRA_FEX_PAUSE=wfe, isb, yield-os[:K] or wait-os[:K[:U]]: what x86 PAUSE compiles to (IosPauseMode in
      * Arm64Emitter.h, FEX::Ios::ParsePauseOption); unset or anything else keeps FEX's YIELD. Set before any
      * code is compiled. */
     const char* PauseOpt = getenv("MADEIRA_FEX_PAUSE");
     const auto Pause = FEX::Ios::ParsePauseOption(PauseOpt);
     IosPauseMode = Pause.Mode;
     IosPauseYieldOsAfter = Pause.After;
-    LogMan::Msg::IFmt("FEX: pause mode={} after={} ({})", IosPauseMode, IosPauseYieldOsAfter, PauseOpt ? PauseOpt : "yield");
+    IosPauseWaitOsUsec = Pause.Usec;
+    LogMan::Msg::IFmt("FEX: pause mode={} after={} usec={} ({})", IosPauseMode, IosPauseYieldOsAfter, IosPauseWaitOsUsec,
+                      PauseOpt ? PauseOpt : "yield");
     /* Playport: MADEIRA_FEX_BATCH2=1 turns on the IosFexBatch2 items (Arm64Emitter.h), less the ones
      * MADEIRA_FEX_BATCH2_SKIP names (comma-separated: alias, ffs, dmb, uabp). Off by default. */
     const char* Batch2Opt = getenv("MADEIRA_FEX_BATCH2");
