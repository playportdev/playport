 extern "C" uint32_t IosPauseYieldOsAfter;
+extern "C" uint32_t IosPauseWaitOsUsec;
 extern "C" uint32_t IosFexBatch2;
 extern "C" uint32_t IosAfpOffFpcr; // Arm64Emitter.h: 0 none, 1 fiz, 2 ah, 3 ahx
