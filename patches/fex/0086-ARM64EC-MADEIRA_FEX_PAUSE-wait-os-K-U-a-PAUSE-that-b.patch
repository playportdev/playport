 .../Interface/Core/ArchHelpers/Arm64Emitter.h |  5 +-
 .../Interface/Core/JIT/IosPauseYieldOs.h      | 38 +++++++--
 FEXCore/Source/Interface/Core/JIT/MiscOps.cpp |  5 +-
 .../include/FEXCore/Utils/IosPauseOption.h    | 79 ++++++++++++-------
 Source/Windows/ARM64EC/Module.cpp             |  7 +-
 6 files changed, 97 insertions(+), 38 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
index 0f69229..e348750 100644
--- a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
+++ b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
@@ -30,6 +30,7 @@ extern "C" uint32_t IosEcCallRetPop = 0;
 extern "C" uint32_t IosRdtscSelfSync = 0;
 extern "C" uint32_t IosPauseMode = 0;
 extern "C" uint32_t IosPauseYieldOsAfter = 0;
