       char buf[160];
       const char* hexd = "0123456789abcdef";
       int n = 0;
@@ -2584,8 +2550,7 @@ NTSTATUS ThreadInit() {
       buf[n++] = '0'; buf[n++] = 'x';
       for (int j = 60; j >= 0; j -= 4) buf[n++] = hexd[(val >> j) & 0xf];
