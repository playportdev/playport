-      char buf[256];
-      const char *hexd = "0123456789abcdef";
-      const char *prefix = "[FEX-iOS] ThreadInit() done: EmulatorData[0]=0x";
-      int i = 0;
-      while (prefix[i]) { buf[i] = prefix[i]; i++; }
-      unsigned long long ed0 = (unsigned long long)CPUArea.Area->EmulatorData[0];
