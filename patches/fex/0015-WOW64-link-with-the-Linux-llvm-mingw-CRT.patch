From bd8edcaf6230b92787a0f67717218e8d25a5667f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Kamil=20Postro=C5=BCny?= <kamil@postrozny.pl>
Date: Sat, 3 Oct 2026 11:10:51 +0200
Subject: [PATCH] WOW64: build with the Linux llvm-mingw CRT

Use the same link rules as ARM64EC; without them the module lacks its
startup and C runtime. Keep the shared reserve-failure log free of iOS
band externs when FEX_IOS_HOST is off. This is build scaffolding, not
the iOS WoW64 transition/JIT port.

Class: linux-build
Evidence: docs/evidence/2026-10-03-portal2-runtime-build.md
Offered-upstream: no; matches the local ARM64EC host configuration
---
 Source/Windows/Common/CallRetStack.h |  4 ++++
 Source/Windows/WOW64/CMakeLists.txt  | 11 +++++++++--
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/Source/Windows/Common/CallRetStack.h b/Source/Windows/Common/CallRetStack.h
index 8d15f867b..6a2421a32 100644
--- a/Source/Windows/Common/CallRetStack.h
+++ b/Source/Windows/Common/CallRetStack.h
@@ -141,9 +141,13 @@ bool InitializeThread(FEXCore::Core::InternalThreadState* Thread) {
      * meant base + one guard page = 0x1000, dereferenced at once, and the
      * fault recursed until the stack was gone -- with the thread still owning
      * the loader lock. */
+#ifdef FEX_IOS_HOST
     LogMan::Msg::EFmt("[callret] RESERVE FAILED: {:#x} bytes in band [{:#x},{:#x}] -- thread cannot start",
                       (unsigned long long)CallRetStackAllocSize,
                       (unsigned long long)ios_fex_band_base, (unsigned long long)ios_fex_band_end);
+#else
+    LogMan::Msg::EFmt("[callret] RESERVE FAILED: {:#x} bytes -- thread cannot start", CallRetStackAllocSize);
+#endif
     return false;
   }
 
diff --git a/Source/Windows/WOW64/CMakeLists.txt b/Source/Windows/WOW64/CMakeLists.txt
index 5bc5accff..c416beda7 100644
--- a/Source/Windows/WOW64/CMakeLists.txt
+++ b/Source/Windows/WOW64/CMakeLists.txt
@@ -19,8 +19,15 @@ target_link_libraries(wow64fex PRIVATE
   wow64_ex
   ntdll_ex)
 
-target_link_options(wow64fex PRIVATE -static -nostdlib -nostartfiles -nodefaultlibs -lc++ -lc++abi -lunwind)
-target_link_libraries(wow64fex PRIVATE ${LIBGCC_PATH})
+# Like ARM64EC, the Linux llvm-mingw build uses mingw's startup and CRT.
+# CommonWindowsRuntime selects CRT_iOS.cpp for this build configuration.
+if (FEX_IOS_HOST_BUILD)
+  target_link_options(wow64fex PRIVATE -static)
+  target_link_libraries(wow64fex PRIVATE $<LINK_GROUP:RESCAN,c++;c++abi;unwind;gcc;mingwex;mingw32;ucrt;msvcrt>)
+else()
+  target_link_options(wow64fex PRIVATE -static -nostdlib -nostartfiles -nodefaultlibs -lc++ -lc++abi -lunwind)
+  target_link_libraries(wow64fex PRIVATE ${LIBGCC_PATH})
+endif()
 install(TARGETS wow64fex RUNTIME
   DESTINATION ${CMAKE_INSTALL_LIBDIR}
   COMPONENT Runtime)
-- 
