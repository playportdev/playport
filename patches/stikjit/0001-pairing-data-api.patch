From a26908d77e68191f6224120a03c08333e9095152 Mon Sep 17 00:00:00 2001
From: CircuitSerein <263436322+CircuitSerein@users.noreply.github.com>
Date: Fri, 23 Oct 2026 23:26:00 +0300
Subject: [PATCH] feat: accept pairing credentials from memory

Avoid plaintext temporary files and parse credentials through the byte FFI.

Class: feature
Evidence: docs/evidence/2026-10-23-pairing-hardening.md
Offered-upstream: not yet; local security verification in progress
---
 Sources/DDISession.swift | 17 ++++++++---------
 Sources/JITSession.swift | 17 ++++++++---------
 Sources/StikJIT.swift    | 20 ++++++++++----------
 3 files changed, 26 insertions(+), 28 deletions(-)

diff --git a/Sources/DDISession.swift b/Sources/DDISession.swift
index 8b9777c..74763a4 100644
--- a/Sources/DDISession.swift
+++ b/Sources/DDISession.swift
@@ -24,11 +24,11 @@ final class DDISession {
         }
     }
 
-    private let pairingFilePath: String
+    private let pairingData: Data
     private let configuration: StikJIT.Configuration
 
-    init(pairingFilePath: String, configuration: StikJIT.Configuration) {
-        self.pairingFilePath = pairingFilePath
+    init(pairingData: Data, configuration: StikJIT.Configuration) {
+        self.pairingData = pairingData
         self.configuration = configuration
     }
 
@@ -190,14 +190,13 @@ final class DDISession {
     }
 
     private func openPairingFile() throws -> OpaquePointer {
-        guard !pairingFilePath.isEmpty, FileManager.default.fileExists(atPath: pairingFilePath) else {
-            throw StikJITError.pairingFile("not found at \(pairingFilePath)")
-        }
         var handle: OpaquePointer?
-        try IdeviceFFI.check("failed to read pairing file") {
-            pairingFilePath.withCString { rp_pairing_file_read($0, &handle) }
+        try IdeviceFFI.check("failed to parse pairing credentials") {
+            pairingData.withUnsafeBytes { buffer in
+                rp_pairing_file_from_bytes(buffer.bindMemory(to: UInt8.self).baseAddress, UInt(buffer.count), &handle)
+            }
         }
-        guard let handle else { throw StikJITError.pairingFile("unreadable at \(pairingFilePath)") }
+        guard let handle else { throw StikJITError.pairingFile("invalid credentials") }
         return handle
     }
 
diff --git a/Sources/JITSession.swift b/Sources/JITSession.swift
