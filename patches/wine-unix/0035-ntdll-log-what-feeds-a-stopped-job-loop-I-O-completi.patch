+/* at a wait or delay: dump after 3 s with no operation on a watched handle, or
+ * 15 s after the last dump, if there was one since */
+static void iolog_quiet_check(void)
+{
+    ULONGLONG now = monotonic_counter(), last_op = iolog_last_op, last_dump = iolog_last_dump;
+
+    if (!last_op || last_dump >= last_op) return;
+    if (now - last_op <= 3 * TICKSPERSEC && now - (last_dump ? last_dump : iolog_base) <= 15 * TICKSPERSEC)
+        return;
+    if (InterlockedCompareExchange64( (LONG64 *)&iolog_last_dump, now, last_dump ) != (LONG64)last_dump) return;
+    iolog_dump( now );
+}
