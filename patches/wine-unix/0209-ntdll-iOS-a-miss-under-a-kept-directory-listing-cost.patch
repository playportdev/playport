+/* Whether find_file_in_dir looks for a name as an 8.3 short name too, which no
+ * listing holds. */
+static int ios_dircase_short_name( const WCHAR *name, int length )
+{
+    int is_short = is_legal_8dot3_name( name, length );
+#ifndef VFAT_IOCTL_READDIR_BOTH
+    is_short = is_short && length >= 8 && name[4] == '~';
+#endif
+    return is_short;
+}
+
+/* Whether a kept listing holds neither the name nor its reparse point "name?",
+ * in any case: then the walk would not find the component. Only for an ASCII
+ * name: the listing holds names composed (NFC), and the volume finds a name by
+ * its exact stat in either normalization. Under ios_dircase_mutex. */
+static int ios_dircase_absent( const struct ios_dircase_dir *dir, const WCHAR *name, int length )
+{
+    WCHAR upper[MAX_DIR_ENTRY_LEN + 1];
+    int i;
+
+    if (!dir->case_sensitive || length > MAX_DIR_ENTRY_LEN || ios_dircase_short_name( name, length )) return 0;
+    for (i = 0; i < length; i++)
+    {
+        if (name[i] >= 0x80) return 0;
+        upper[i] = ntdll_towupper( name[i] );
+    }
+    upper[length] = '?';
+    return !ios_dircase_find( dir, upper, length ) && !ios_dircase_find( dir, upper, length + 1 );
+}
+
+#define IOS_DIRCASE_COMPS 64   /* the components ios_dircase_known_missing takes */
+
+/* Playport (iOS, wine-unix 0209): a lookup that misses under a directory whose
+ * listing is kept by its absolute path, answered from that listing. unix_name
+ * holds the whole path as lookup_unix_name_walk's shortcut converted it: the
+ * prefix up to pos, then name with each backslash a slash. The deepest prefix
+ * that is a kept listing's path, byte for byte, decides. When its listing holds
+ * neither the next component nor that component's reparse point, the walk would
+ * stop there: every earlier component exists as spelled, so it finds each one
+ * by its exact stat, and then searches that directory in vain. One stat of the
+ * prefix first proves the listing is still that directory's. Returns 1 with
+ * *status, unix_name cut at that directory as the walk leaves it. Returns 0 to
+ * leave the lookup to the shortcut and the walk: no listing kept on the path, a
+ * component that is there in some case, an 8.3 short name, a directory changed
+ * or gone, a trailing backslash, or a missing last component that is to be
+ * created (the walk gives its name). */
+static int ios_dircase_known_missing( int root_fd, char *unix_name, int pos, const WCHAR *name,
+                                      unsigned int name_len, UINT disposition, NTSTATUS *status )
+{
+    uint32_t ends[IOS_DIRCASE_COMPS], hashes[IOS_DIRCASE_COMPS], h;
+    const WCHAR *comps[IOS_DIRCASE_COMPS], *p = name, *q, *end = name + name_len;
+    int lens[IOS_DIRCASE_COMPS], n = 0, k, absent, current;
+    struct ios_dircase_dir *dir;
+    struct ios_dircase_key key;
+    char *c = unix_name + pos, *slash, cut;
+    struct stat st;
+
+    if (root_fd != AT_FDCWD || unix_name[0] != '/' || !name_len || name[name_len - 1] == '\\') return 0;
+
+    /* Each component, and its directory's path (the prefix of unix_name before
+     * it) with that path's hash, in one pass. */
+    h = ios_dircase_path_hash( IOS_DIRCASE_FNV, unix_name, pos );
+    for (;;)
+    {
+        if (n == IOS_DIRCASE_COMPS) return 0;
+        for (q = p; q < end && *q != '\\'; q++) ;
+        ends[n] = c - unix_name;
+        hashes[n] = h;
+        comps[n] = p;
+        lens[n++] = q - p;
+        if (q == end) break;
+        if (!(slash = strchr( c + 1, '/' ))) return 0;
+        h = ios_dircase_path_hash( h, c, slash - c );
+        c = slash;
+        p = q + 1;
+    }
+
+    for (k = n - 1; k >= 0; k--)
+    {
+        mutex_lock( &ios_dircase_mutex );
+        dir = ios_dircase_at( &ios_dircase, unix_name, ends[k], hashes[k] );
+        absent = dir && ios_dircase_absent( dir, comps[k], lens[k] );
+        mutex_unlock( &ios_dircase_mutex );
+        if (!dir) continue;
+        if (!absent) return 0;
+        if (k == n - 1 && disposition != FILE_OPEN && disposition != FILE_OVERWRITE) return 0;
+
+        /* Is it still that directory's listing? */
+        cut = unix_name[ends[k]];
+        unix_name[ends[k]] = 0;
+        current = !fstatat( AT_FDCWD, unix_name, &st, 0 ) && S_ISDIR( st.st_mode );
+        if (current) ios_dircase_key_of( &st, &key );
+        mutex_lock( &ios_dircase_mutex );
+        if ((dir = ios_dircase_at( &ios_dircase, unix_name, ends[k], hashes[k] )))
+        {
+            if (!current || !ios_dircase_key_equal( &dir->key, &key ))
+            {
+                ios_dircase.stale++;
+                ios_dircase_drop( &ios_dircase, dir );
+                dir = NULL;
+            }
+            else if (!ios_dircase_absent( dir, comps[k], lens[k] )) dir = NULL;  /* another thread's newer listing */
+            else
+            {
+                dir->used = ++ios_dircase.clock;
+                ios_dircase.hits++;
+                ios_dircase.by_path_misses++;
+            }
+        }
+        mutex_unlock( &ios_dircase_mutex );
+        if (!dir)
+        {
+            unix_name[ends[k]] = cut;
+            return 0;
+        }
+        if (ios_fm_cur)
+        {
+            ios_fm_cur->walked = 1;
+            ios_fm_scan( unix_name, comps[k], lens[k], 0, 1 );
+        }
+        *status = k < n - 1 ? STATUS_OBJECT_PATH_NOT_FOUND : STATUS_OBJECT_NAME_NOT_FOUND;
+        return 1;
+    }
+    return 0;
+}
+
 /***********************************************************************
  *           find_file_in_dir
  *
@@ -3585,6 +3720,9 @@ static NTSTATUS lookup_unix_name_walk( int root_fd, OBJECT_ATTRIBUTES *attr, UNI
         char *p;
         unix_name[pos + 1 + ret] = 0;
         for (p = unix_name + pos ; *p; p++) if (*p == '\\') *p = '/';
+        /* Playport (iOS): a miss under a kept listing costs one stat (0209). */
+        if (!is_unix && ios_dircase_known_missing( root_fd, unix_name, pos, name, name_len, disposition, &status ))
+            return status;
         if (!fstatat( root_fd, unix_name, &st, 0 ))
         {
             if (disposition == FILE_CREATE) return STATUS_OBJECT_NAME_COLLISION;
diff --git a/dlls/ntdll/unix/ios_dircase.h b/dlls/ntdll/unix/ios_dircase.h
index 80fbdcd..e4252c7 100644
--- a/dlls/ntdll/unix/ios_dircase.h
+++ b/dlls/ntdll/unix/ios_dircase.h
@@ -15,7 +15,14 @@
  * its mtime and ctime are older than IOS_DIRCASE_RACY_NS: a change within the
  * same clock tick as the read could leave both times as they were.
  *
- * Plain C, no Wine headers: build/dircase/test.py compiles it on the host.
+ * A listing read through an absolute path is also kept under that path, byte
+ * for byte as the walk spelled it (wine-unix 0209). A lookup whose path runs
+ * through that directory, spelled the same, finds the listing by the path's
+ * prefix; one stat of the prefix proves the path still leads to the same,
+ * unchanged directory, and its listing then says whether the next component
+ * is there at all.
+ *
+ * Plain C, no Wine headers: tools/tests/test_dircase_ios.py compiles it on the host.
