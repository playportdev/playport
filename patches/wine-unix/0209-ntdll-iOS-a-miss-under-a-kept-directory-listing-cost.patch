 #ifndef IOS_DIRCASE_H
@@ -25,8 +32,10 @@
 #include <stdlib.h>
 #include <string.h>
 
-#define IOS_DIRCASE_MAX_DIRS 64
+#define IOS_DIRCASE_MAX_DIRS 1024
 #define IOS_DIRCASE_MAX_BYTES (24u << 20)       /* all listings together */
+#define IOS_DIRCASE_BUCKETS 1024                /* each index's chains, a power of two */
+#define IOS_DIRCASE_FNV 2166136261u             /* FNV-1a's offset basis */
 #define IOS_DIRCASE_MAX_ENTRIES 200000u         /* a bigger directory is not cached */
 #define IOS_DIRCASE_RACY_NS 2000000000ull       /* 2 s */
 
@@ -55,24 +64,43 @@ struct ios_dircase_dir
     uint32_t names_len, names_cap, uppers_len, uppers_cap;
     size_t bytes;
     uint64_t used;                /* the cache's clock at the last use */
+    unsigned index;               /* in the cache's dirs, while kept */
+    char *path;                   /* the absolute path it was read through, or NULL */
+    uint32_t path_len, path_hash;
+    struct ios_dircase_dir *next_ino, *next_path;   /* the cache's chains */
 };
 
 struct ios_dircase_cache
 {
     struct ios_dircase_dir *dirs[IOS_DIRCASE_MAX_DIRS];
+    struct ios_dircase_dir *by_ino[IOS_DIRCASE_BUCKETS], *by_path[IOS_DIRCASE_BUCKETS];
     unsigned count;
     size_t bytes;
     uint64_t clock;
     uint64_t hits, misses, builds, stale, evicted, uncached;
+    uint64_t by_path_misses;      /* lookups answered as missing through by_path */
 };
 
 static inline uint32_t ios_dircase_hash( const uint16_t *upper, uint32_t len )
 {
-    uint32_t h = 2166136261u;
+    uint32_t h = IOS_DIRCASE_FNV;
     while (len--) { h ^= *upper++; h *= 16777619u; }
     return h ? h : 1;
 }
 
+/* FNV-1a over a path's bytes, continuing from h (IOS_DIRCASE_FNV to start), so
+ * that a lookup hashes each of its path's prefixes in one pass. */
+static inline uint32_t ios_dircase_path_hash( uint32_t h, const char *path, uint32_t len )
+{
+    while (len--) { h ^= (unsigned char)*path++; h *= 16777619u; }
+    return h;
+}
+
+static inline unsigned ios_dircase_ino_bucket( uint64_t dev, uint64_t ino )
+{
+    return (unsigned)(((ino ^ (dev << 32)) * 0x9e3779b97f4a7c15ull) >> 40) & (IOS_DIRCASE_BUCKETS - 1);
+}
+
 static inline int ios_dircase_key_equal( const struct ios_dircase_key *a, const struct ios_dircase_key *b )
 {
     return a->dev == b->dev && a->ino == b->ino && a->mtime_sec == b->mtime_sec && a->mtime_nsec == b->mtime_nsec &&
@@ -92,6 +120,7 @@ static inline int ios_dircase_racy( const struct ios_dircase_key *key, int64_t n
 static inline void ios_dircase_free( struct ios_dircase_dir *dir )
 {
     if (!dir) return;
+    free( dir->path );
     free( dir->slots );
     free( dir->names );
     free( dir->uppers );
@@ -207,67 +236,147 @@ static inline const char *ios_dircase_find( const struct ios_dircase_dir *dir, c
     return s->name == UINT32_MAX ? NULL : dir->names + s->name;
 }
 
+/* Names a listing by the absolute path it was read through, before
+ * ios_dircase_put. 0 when out of memory. */
+static inline int ios_dircase_set_path( struct ios_dircase_dir *dir, const char *path, uint32_t len )
+{
+    if (!(dir->path = malloc( len + 1 ))) return 0;
+    memcpy( dir->path, path, len );
+    dir->path[len] = 0;
+    dir->path_len = len;
+    dir->path_hash = ios_dircase_path_hash( IOS_DIRCASE_FNV, path, len );
+    dir->bytes += len + 1;
+    return 1;
+}
+
+static inline void ios_dircase_unchain( struct ios_dircase_dir **link, struct ios_dircase_dir *dir, int by_path )
+{
+    for (; *link; link = by_path ? &(*link)->next_path : &(*link)->next_ino)
+        if (*link == dir)
+        {
+            *link = by_path ? dir->next_path : dir->next_ino;
+            return;
+        }
+}
+
+static inline void ios_dircase_chain_path( struct ios_dircase_cache *cache, struct ios_dircase_dir *dir )
+{
+    struct ios_dircase_dir **head = &cache->by_path[dir->path_hash & (IOS_DIRCASE_BUCKETS - 1)];
+    dir->next_path = *head;
+    *head = dir;
+}
+
+/* Drops a kept listing from the cache and frees it. */
+static inline void ios_dircase_drop( struct ios_dircase_cache *cache, struct ios_dircase_dir *dir )
+{
+    ios_dircase_unchain( &cache->by_ino[ios_dircase_ino_bucket( dir->key.dev, dir->key.ino )], dir, 0 );
+    if (dir->path) ios_dircase_unchain( &cache->by_path[dir->path_hash & (IOS_DIRCASE_BUCKETS - 1)], dir, 1 );
+    cache->bytes -= dir->bytes;
+    cache->dirs[dir->index] = cache->dirs[--cache->count];
+    cache->dirs[dir->index]->index = dir->index;
+    ios_dircase_free( dir );
+}
+
+/* The listing kept for a directory, whatever its key, or NULL. */
+static inline struct ios_dircase_dir *ios_dircase_of( const struct ios_dircase_cache *cache, uint64_t dev, uint64_t ino )
+{
+    struct ios_dircase_dir *dir = cache->by_ino[ios_dircase_ino_bucket( dev, ino )];
+    while (dir && (dir->key.dev != dev || dir->key.ino != ino)) dir = dir->next_ino;
+    return dir;
+}
+
+/* The listing kept under a path, byte for byte (hash: ios_dircase_path_hash of
+ * it), or NULL. Its names hold only once a fresh stat of the path matches its key. */
+static inline struct ios_dircase_dir *ios_dircase_at( const struct ios_dircase_cache *cache, const char *path,
+                                                      uint32_t len, uint32_t hash )
+{
+    struct ios_dircase_dir *dir = cache->by_path[hash & (IOS_DIRCASE_BUCKETS - 1)];
+    for (; dir; dir = dir->next_path)
+        if (dir->path_hash == hash && dir->path_len == len && !memcmp( dir->path, path, len )) return dir;
+    return NULL;
+}
+
 /* The cached listing of a directory whose fresh stat gave `key`, or NULL. A
  * listing of the same directory with an older key is dropped. */
 static inline struct ios_dircase_dir *ios_dircase_get( struct ios_dircase_cache *cache, const struct ios_dircase_key *key )
 {
-    unsigned i;
-    for (i = 0; i < cache->count; i++)
+    struct ios_dircase_dir *dir = ios_dircase_of( cache, key->dev, key->ino );
+    if (dir && ios_dircase_key_equal( &dir->key, key ))
+    {
+        dir->used = ++cache->clock;
+        cache->hits++;
+        return dir;
+    }
+    if (dir)
     {
-        struct ios_dircase_dir *dir = cache->dirs[i];
-        if (dir->key.dev != key->dev || dir->key.ino != key->ino) continue;
-        if (ios_dircase_key_equal( &dir->key, key ))
-        {
-            dir->used = ++cache->clock;
-            cache->hits++;
-            return dir;
-        }
         cache->stale++;
-        cache->bytes -= dir->bytes;
-        ios_dircase_free( dir );
-        cache->dirs[i] = cache->dirs[--cache->count];
-        break;
+        ios_dircase_drop( cache, dir );
     }
     cache->misses++;
     return NULL;
 }
 
+/* Names a kept listing that has no path yet (it was read through a directory
+ * handle) by an absolute path that leads to it now. A listing kept under that
+ * path before, of another directory, is dropped. 0 when out of memory. */
+static inline int ios_dircase_name( struct ios_dircase_cache *cache, struct ios_dircase_dir *dir, const char *path,
+                                    uint32_t len )
+{
+    struct ios_dircase_dir *old;
+    size_t bytes = dir->bytes;
+
+    if (dir->path) return 1;
+    if ((old = ios_dircase_at( cache, path, len, ios_dircase_path_hash( IOS_DIRCASE_FNV, path, len ) )))
+    {
+        cache->stale++;
+        ios_dircase_drop( cache, old );
+    }
+    if (!ios_dircase_set_path( dir, path, len )) return 0;
+    cache->bytes += dir->bytes - bytes;
+    ios_dircase_chain_path( cache, dir );
+    return 1;
+}
+
 /* Keeps a listing, evicting the least recently used ones to stay within the
  * limits. Returns 0 when it is not kept (too big, or another thread kept the
  * same listing first); the caller frees it then. A kept listing of the same
- * directory with another key is replaced. */
+ * directory with another key, or of another directory under the same path, is
+ * replaced. */
 static inline int ios_dircase_put( struct ios_dircase_cache *cache, struct ios_dircase_dir *dir )
 {
-    unsigned i;
+    struct ios_dircase_dir *old, **head;
 
     if (dir->bytes > IOS_DIRCASE_MAX_BYTES / 4)
     {
         cache->uncached++;
         return 0;
     }
-    for (i = 0; i < cache->count; i++)
+    if ((old = ios_dircase_of( cache, dir->key.dev, dir->key.ino )))
     {
-        struct ios_dircase_dir *old = cache->dirs[i];
-        if (old->key.dev != dir->key.dev || old->key.ino != dir->key.ino) continue;
         if (ios_dircase_key_equal( &old->key, &dir->key )) return 0;
-        cache->bytes -= old->bytes;
-        ios_dircase_free( old );
-        cache->dirs[i] = cache->dirs[--cache->count];
         cache->stale++;
-        break;
+        ios_dircase_drop( cache, old );
+    }
+    if (dir->path && (old = ios_dircase_at( cache, dir->path, dir->path_len, dir->path_hash )))
