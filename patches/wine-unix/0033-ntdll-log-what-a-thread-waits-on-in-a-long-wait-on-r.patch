From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Mon, 12 Oct 2026 17:30:47 +0200
Subject: [PATCH] ntdll: log what a thread waits on in a long wait, on request

A hang the thread samples show only as "in NtWaitForMultipleObjects"
needs the objects the thread waits on and who called the wait. With
WINEDEBUG naming warn+waitlog, a wait with no timeout or one of a
second or more logs its objects (type, name, an event's or semaphore's
state, a thread's id) and the module-relative return addresses found
on the caller's stack (from the syscall frame's sp, within the thread's
stack; an x86-64 frame keeps no frame-pointer chain), and a wait that
took a second or more logs its end. A thread logs a wait only when it
differs from its last logged one, and the log stops at 4000 lines. On
iOS NtWaitForMultipleObjects and NtWaitForSingleObject become wrappers
of the unchanged bodies; off, the cost is one debug-channel test per
wait.

Class: diagnostics
Evidence: docs/evidence/2026-10-12-jwe-watchdog.md
Offered-upstream: no; iOS-only diagnostics
---
 dlls/ntdll/unix/sync.c | 216 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 216 insertions(+)

diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index 2072089..2996017 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2464,11 +2464,227 @@ NTSTATUS WINAPI NtQueryTimer( HANDLE handle, TIMER_INFORMATION_CLASS class,
 }
 
 
+#ifdef WINE_IOS
+WINE_DECLARE_DEBUG_CHANNEL(waitlog);
+
+/* Playport (PLA-41): what a thread that stops in a long wait waits on, for a
+ * hang the thread samples show only as "in NtWaitForMultipleObjects". Off
+ * unless WINEDEBUG turns on warn+waitlog. A wait with no timeout or one of a
+ * second or more logs its objects (type, name, an event's or semaphore's
+ * state, a thread's id) and the return addresses on the caller's stack (an
+ * x86-64 frame keeps no frame-pointer chain), named by the module that holds
+ * them; a wait that took a second or more logs its end. A thread logs a wait
+ * only when it differs from its last logged one (the same handles and first
+ * caller), and the log stops after 4000 lines. Guest memory beyond this
+ * thread's TEB and stack is read with mach_vm_read_overwrite, which fails
+ * rather than faults. */
+struct waitlog_module { ULONG_PTR base, size; char name[24]; };
+
+static LONG waitlog_lines;
+
+static BOOL waitlog_read( const void *addr, void *buf, SIZE_T size )
+{
+    mach_vm_size_t got = 0;
+
+    return mach_vm_read_overwrite( mach_task_self(), (mach_vm_address_t)addr, size,
+                                   (mach_vm_address_t)buf, &got ) == KERN_SUCCESS && got == size;
+}
+
+static int waitlog_modules( TEB *teb, struct waitlog_module *mods, int max )
+{
+    PEB_LDR_DATA *ldr = NULL;
+    LIST_ENTRY *head, *cur = NULL;
+    PEB *peb = teb->Peb;   /* this thread's own TEB */
+    int n = 0, guard = 0;
+
+    if (!peb) return 0;
+    if (!waitlog_read( &peb->LdrData, &ldr, sizeof(ldr) ) || !ldr) return 0;
+    head = &ldr->InLoadOrderModuleList;
+    if (!waitlog_read( &head->Flink, &cur, sizeof(cur) )) return 0;
+    while (cur && cur != head && n < max && guard++ < 256)
+    {
+        LDR_DATA_TABLE_ENTRY entry;
+        WCHAR name[23];
+        USHORT len, i;
+
+        if (!waitlog_read( CONTAINING_RECORD( cur, LDR_DATA_TABLE_ENTRY, InLoadOrderLinks ),
+                           &entry, offsetof( LDR_DATA_TABLE_ENTRY, Flags ) )) break;
+        mods[n].base = (ULONG_PTR)entry.DllBase;
+        mods[n].size = entry.SizeOfImage;
+        len = min( entry.BaseDllName.Length / sizeof(WCHAR), ARRAY_SIZE(name) );
+        if (!len || !waitlog_read( entry.BaseDllName.Buffer, name, len * sizeof(WCHAR) )) len = 0;
+        for (i = 0; i < len; i++) mods[n].name[i] = name[i] < 0x80 ? name[i] : '?';
+        mods[n].name[len] = 0;
+        if (mods[n].base && mods[n].size) n++;
+        cur = entry.InLoadOrderLinks.Flink;
+    }
+    return n;
+}
+
+static void waitlog_ascii( char *out, size_t cap, const UNICODE_STRING *str )
+{
+    size_t i, len = min( str->Length / sizeof(WCHAR), cap - 1 );
+
+    for (i = 0; i < len; i++) out[i] = str->Buffer[i] >= 0x20 && str->Buffer[i] < 0x80 ? str->Buffer[i] : '?';
+    out[len] = 0;
+}
+
+static void waitlog_object( HANDLE handle, char *out, size_t cap )
+{
+    char type_buf[sizeof(OBJECT_TYPE_INFORMATION) + 64 * sizeof(WCHAR)];
+    char name_buf[sizeof(OBJECT_NAME_INFORMATION) + 260 * sizeof(WCHAR)];
+    OBJECT_TYPE_INFORMATION *type = (OBJECT_TYPE_INFORMATION *)type_buf;
+    OBJECT_NAME_INFORMATION *name = (OBJECT_NAME_INFORMATION *)name_buf;
+    EVENT_BASIC_INFORMATION event;
+    SEMAPHORE_BASIC_INFORMATION sem;
+    THREAD_BASIC_INFORMATION thread;
+    char type_str[32] = "?", name_str[100] = "";
+    size_t n;
+
+    if (!NtQueryObject( handle, ObjectTypeInformation, type, sizeof(type_buf), NULL ))
+        waitlog_ascii( type_str, sizeof(type_str), &type->TypeName );
+    if (!NtQueryObject( handle, ObjectNameInformation, name, sizeof(name_buf), NULL ))
+        waitlog_ascii( name_str, sizeof(name_str), &name->Name );
+    n = snprintf( out, cap, "%p:%s%s%s", handle, type_str, *name_str ? " " : "", name_str );
+    if (n >= cap) return;
+    if (!NtQueryEvent( handle, EventBasicInformation, &event, sizeof(event), NULL ))
+        snprintf( out + n, cap - n, " %s signaled=%d", event.EventType == NotificationEvent ? "manual" : "auto",
+                  (int)event.EventState );
+    else if (!NtQuerySemaphore( handle, SemaphoreBasicInformation, &sem, sizeof(sem), NULL ))
+        snprintf( out + n, cap - n, " count=%d/%d", (int)sem.CurrentCount, (int)sem.MaximumCount );
+    else if (!NtQueryInformationThread( handle, ThreadBasicInformation, &thread, sizeof(thread), NULL ))
+        snprintf( out + n, cap - n, " tid=%04x exit=%#x", (int)HandleToULong( thread.ClientId.UniqueThread ),
+                  (int)thread.ExitStatus );
+}
+
+/* returns whether the wait is long enough to log its end */
+static BOOL waitlog_start( DWORD count, const HANDLE *handles, WAIT_TYPE type, BOOLEAN alertable,
+                           const LARGE_INTEGER *timeout )
+{
+    static ULONG_PTR last_sig[256];
+    struct waitlog_module mods[160];
+    struct thread_data *data = get_thread_data();
+    TEB *teb = data ? data->teb : NULL;
+    ULONG_PTR sp = 0, caller_sp, top, callers[16], sig = 0;
+    char *frame;
+    int nmods, ncallers = 0, i, j;
+    DWORD tid;
+    char line[600], obj[200];
+    size_t n;
+
+    if (timeout && timeout->QuadPart <= 0 && timeout->QuadPart > -TICKSPERSEC) return FALSE;
+    if (!teb || waitlog_lines >= 4000) return FALSE;
+    tid = HandleToULong( teb->ClientId.UniqueThread );
+    nmods = waitlog_modules( teb, mods, ARRAY_SIZE(mods) );
+
+    /* The caller's stack pointer, saved by __wine_syscall_dispatcher (arm64
+     * syscall_frame.sp). This thread's own stack between it and the stack
+     * base is committed, so it is read directly. */
+    if ((frame = (char *)get_syscall_frame( data ))) sp = *(ULONG_PTR *)(frame + 0xf8);
+    caller_sp = sp;
+    top = (ULONG_PTR)teb->Tib.StackBase;
+    if (sp & 7 || sp < (ULONG_PTR)teb->Tib.StackLimit || sp >= top) top = sp;
+    else if (top - sp > 0x8000) top = sp + 0x8000;
+    for (; sp < top && ncallers < (int)ARRAY_SIZE(callers); sp += sizeof(ULONG_PTR))
+    {
+        ULONG_PTR value = *(ULONG_PTR *)sp;
+
+        for (j = 0; j < nmods; j++)
+            if (value >= mods[j].base + 0x1000 && value < mods[j].base + mods[j].size)
+            {
+                callers[ncallers++] = value;
+                break;
+            }
+    }
+
+    for (i = 0; i < (int)count; i++) sig = sig * 31 + (ULONG_PTR)handles[i];
+    sig = sig * 31 + (ncallers ? callers[0] : 0) + count;
+    if (last_sig[(tid >> 2) & 0xff] == sig) return TRUE;
+    last_sig[(tid >> 2) & 0xff] = sig;
+    if (InterlockedIncrement( &waitlog_lines ) > 4000) return FALSE;
+
+    n = snprintf( line, sizeof(line), "[waitlog] tid=%04x n=%u %s alertable=%u timeout=%s sp=%#lx stack=%p-%p callers=[",
+                  (int)tid, (unsigned int)count, type == WaitAll ? "all" : "any", alertable,
+                  debugstr_timeout( timeout ), (unsigned long)caller_sp, teb->Tib.StackLimit, teb->Tib.StackBase );
+    for (i = 0; i < ncallers && n < sizeof(line) - 48; i++)
+    {
+        for (j = 0; j < nmods; j++)
+            if (callers[i] >= mods[j].base && callers[i] < mods[j].base + mods[j].size) break;
+        n += snprintf( line + n, sizeof(line) - n, " %.20s+%#lx", mods[j].name,
+                       (unsigned long)(callers[i] - mods[j].base) );
+    }
+    if (n < sizeof(line) - 2) snprintf( line + n, sizeof(line) - n, " ]" );
+    WARN_(waitlog)( "%s\n", line );
+    for (i = 0; i < (int)count; i++)
+    {
+        waitlog_object( handles[i], obj, sizeof(obj) );
+        WARN_(waitlog)( "[waitlog]   tid=%04x obj[%d] %s\n", (int)tid, i, obj );
+    }
+    return TRUE;
+}
+
+static void waitlog_end( const HANDLE *handles, NTSTATUS status, ULONGLONG start )
+{
+    ULONGLONG ticks = monotonic_counter() - start;
+    struct thread_data *data = get_thread_data();
+
+    if (ticks < TICKSPERSEC || !data || !data->teb || InterlockedIncrement( &waitlog_lines ) > 4000) return;
+    WARN_(waitlog)( "[waitlog] tid=%04x end handle[0]=%p status=%#x after %u.%01u s\n",
+                    (int)HandleToULong( data->teb->ClientId.UniqueThread ), handles[0], (int)status,
+                    (unsigned int)(ticks / TICKSPERSEC), (unsigned int)(ticks % TICKSPERSEC / (TICKSPERSEC / 10)) );
+}
+
+static NTSTATUS wait_for_multiple_objects( DWORD count, const HANDLE *handles, WAIT_TYPE type,
+                                           BOOLEAN alertable, const LARGE_INTEGER *timeout );
+static NTSTATUS wait_for_single_object( HANDLE handle, BOOLEAN alertable, const LARGE_INTEGER *timeout );
+
 /******************************************************************
  *		NtWaitForMultipleObjects (NTDLL.@)
  */
 NTSTATUS WINAPI NtWaitForMultipleObjects( DWORD count, const HANDLE *handles, WAIT_TYPE type,
                                           BOOLEAN alertable, const LARGE_INTEGER *timeout )
+{
+    ULONGLONG start;
+    NTSTATUS ret;
+
+    if (!WARN_ON(waitlog) || !count || count > MAXIMUM_WAIT_OBJECTS ||
+        !waitlog_start( count, handles, type, alertable, timeout ))
+        return wait_for_multiple_objects( count, handles, type, alertable, timeout );
+    start = monotonic_counter();
+    ret = wait_for_multiple_objects( count, handles, type, alertable, timeout );
+    waitlog_end( handles, ret, start );
+    return ret;
+}
+
+#ifdef WINE_IOS
+static NTSTATUS wait_for_single_object( HANDLE handle, BOOLEAN alertable, const LARGE_INTEGER *timeout )
+#else
+/******************************************************************
+ *		NtWaitForSingleObject (NTDLL.@)
+ */
+NTSTATUS WINAPI NtWaitForSingleObject( HANDLE handle, BOOLEAN alertable, const LARGE_INTEGER *timeout )
+#endif
+{
+    ULONGLONG start;
+    NTSTATUS ret;
+
+    if (!WARN_ON(waitlog) || !waitlog_start( 1, &handle, WaitAny, alertable, timeout ))
+        return wait_for_single_object( handle, alertable, timeout );
+    start = monotonic_counter();
+    ret = wait_for_single_object( handle, alertable, timeout );
+    waitlog_end( &handle, ret, start );
+    return ret;
+}
+
+static NTSTATUS wait_for_multiple_objects( DWORD count, const HANDLE *handles, WAIT_TYPE type,
+                                           BOOLEAN alertable, const LARGE_INTEGER *timeout )
+#else
+/******************************************************************
+ *		NtWaitForMultipleObjects (NTDLL.@)
+ */
+NTSTATUS WINAPI NtWaitForMultipleObjects( DWORD count, const HANDLE *handles, WAIT_TYPE type,
+                                          BOOLEAN alertable, const LARGE_INTEGER *timeout )
+#endif
 {
     union select_op select_op;
     UINT i, flags = SELECT_INTERRUPTIBLE;
