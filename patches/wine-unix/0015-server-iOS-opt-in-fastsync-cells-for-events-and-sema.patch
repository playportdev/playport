+        if (cur <= 0) return 0;                  /* empty, or DISABLED */
+        if (__atomic_compare_exchange_n( &cell->sg, &sg,
+                                         MADEIRA_SG( MADEIRA_SG_GEN( sg ), cur - 1 ), 1,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+            return 1;
