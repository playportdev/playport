+    cell = &madeira_sync_cells[sem->cell];
+    sg = __atomic_load_n( &cell->sg, __ATOMIC_SEQ_CST );
+    while (MADEIRA_SG_STATE( sg ) != MADEIRA_CELL_DISABLED)
+    {
