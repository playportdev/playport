+            return 0;
+        }
+        if (__atomic_compare_exchange_n( &cell->sg, &sg,
+                                         MADEIRA_SG( MADEIRA_SG_GEN( sg ), cur + (int)add ), 1,
+                                         __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST ))
+        {
+            if (prev) *prev = (unsigned int)cur;
+            return 1;
+        }
+    }
