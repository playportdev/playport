From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Fri, 13 Nov 2026 13:00:00 +0100
Subject: [PATCH] win32u: iOS: a process takes only its own cache DCs
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

On iOS every Wine process is a pseudo-process of one app, so win32u's
list of DCEs is shared by all of them, and NtUserGetDCEx handed a
process the cache DCs of others, including those of a process that
had ended. A released cache DC keeps the surface of the window it was
last taken for until it is taken again, and the process that takes
it releases that surface. When that was the last reference, the
surface's pixels were freed with NtFreeVirtualMemory in the taker's
own address space.

Borderlands 2's Steam prerequisites showed what that costs (PLA-871).
The pixels of a 32-bit process's window are in its WoW64 window. The
VC++ 2005 installer's inner process had its dialog's pixels at host
0x71c0f90000, and its window slot was then given to the VC++ 2005 ATL
installer's inner process, whose dialog's pixels were allocated at the
same address. Painting its dialog, that process took a DC the first
one left, dropped the old surface, and freed its own pixels: the view
became a window gap, and the erase fault in solid_rects_32 could not
be dispatched. The process ended with 0x45 holding its surface's lock
(PLA-870), and VC++ 2005 ATL was recorded as installed although it was
not.

A process now takes only the cache DCs it made, keyed on the pid and
PEB at alloc_dce as the builtin classes are (a reused pid alone does
not match), and counts only those against the cache size: the set a
desktop process's list holds. A DC an ended process left behind is
never taken again. When the shared list is full and a process passes
over unused DCs of others, it says so on its first eight times
("[dce] pid …: a full DC cache, N DCs of other processes not taken"),
so a phone log shows the case PLA-871 was.

Class: ios-port
Evidence: PLA-871 (the phone's log of IPA 0023f811: the committed 0x60000 allocation at guest 0xfa0000 of the ATL installer's process is a window-gap view coalesced with its left neighbour when it faults, the same address and size the VC++ 2005 installer's process had in the same slot); tools/tests/test_dce_cache_ios.py (alloc_dce and this search, with a full cache of an ended process's DCs: the next process gets a new DC; its own are taken again)
Offered-upstream: no; iOS one-process runtime integration
---
 dlls/win32u/dce.c | 49 +++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 434a3743ef7..97f9716a4f8 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -43,6 +43,10 @@ struct dce
     UINT        flags;
     LONG        count;         /* usage count; 0 or 1 for cache DCEs, always 1 for window DCEs,
                                   always >= 1 for class DCEs */
+#ifdef WINE_IOS
+    DWORD       pid;           /* the pseudo-process that made it, and its PEB */
+    void       *peb;
+#endif
 };
 
 static struct list dce_list = LIST_INIT(dce_list);
@@ -971,6 +975,23 @@ void update_dc( DC *dc )
     }
 }
 
+#ifdef WINE_IOS
+/* Playport (PLA-871): every pseudo-process of the app shares dce_list, which on desktop
+ * holds only the calling process's DCs. A cache DC keeps its last window's surface until
+ * it is taken again, and a process that ended left its DCs so. Another process that took
+ * one over released that surface, and the last reference freed its pixels with
+ * NtFreeVirtualMemory in the taker's own address space: the pixels of a 32-bit process
+ * were in its WoW64 window, and when the next 32-bit process's window reused that slot,
+ * the address was the new process's own window surface (the VC++ 2005 ATL installer then
+ * faulted painting its dialog). A process takes only the DCs it made, keyed on (pid, PEB)
+ * as the builtin classes are, so that a reused pid alone does not match. */
+static BOOL is_current_process_dce( const struct dce *dce )
+{
+    return dce->pid == HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ) &&
+           dce->peb == NtCurrentTeb()->Peb;
+}
+#endif
+
 /***********************************************************************
  *           alloc_dce
  *
@@ -990,6 +1011,10 @@ static struct dce *alloc_dce(void)
     dce->clip_rgn  = 0;
     dce->flags     = 0;
     dce->count     = 1;
+#ifdef WINE_IOS
+    dce->pid       = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    dce->peb       = NtCurrentTeb()->Peb;
+#endif
 
     set_dc_dce( dce->hdc, dce );
     return dce;
@@ -1331,6 +1356,10 @@ HDC WINAPI NtUserGetDCEx( HWND hwnd, HRGN clip_rgn, DWORD flags )
     {
         struct dce *dceEmpty = NULL, *dceUnused = NULL, *found = NULL;
         unsigned int count = 0;
+#ifdef WINE_IOS
+        struct dce *other_unused = NULL;
+        unsigned int others = 0;
+#endif
 
         /* Strategy: First, we attempt to find a non-empty but unused DCE with
          * compatible flags. Next, we look for an empty entry. If the cache is
@@ -1340,6 +1369,14 @@ HDC WINAPI NtUserGetDCEx( HWND hwnd, HRGN clip_rgn, DWORD flags )
         LIST_FOR_EACH_ENTRY( dce, &dce_list, struct dce, entry )
         {
             if (!(dce->flags & DCX_CACHE)) break;
+#ifdef WINE_IOS
+            if (!is_current_process_dce( dce ))  /* PLA-871 */
+            {
+                others++;
+                if (!dce->count && dce->hwnd) other_unused = dce;
+                continue;
+            }
+#endif
             count++;
             if (dce->count) continue;
             dceUnused = dce;
@@ -1354,6 +1391,18 @@ HDC WINAPI NtUserGetDCEx( HWND hwnd, HRGN clip_rgn, DWORD flags )
         }
         if (!found) found = dceEmpty;
         if (!found && count >= DCE_CACHE_SIZE) found = dceUnused;
+#ifdef WINE_IOS
+        /* the case PLA-871 was: the shared list full, with unused DCs of other processes in it */
+        if (!found && other_unused && count + others >= DCE_CACHE_SIZE)
+        {
+            static LONG logged;
+            if (InterlockedIncrement( &logged ) <= 8)
+                fprintf( stderr, "[dce] pid %04x: a full DC cache, %u DCs of other processes not taken "
+                         "(the oldest unused: pid %04x, hwnd %p)\n",
+                         (UINT)HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ), others,
+                         (UINT)other_unused->pid, other_unused->hwnd );
+        }
+#endif
 
         dce = found;
         if (dce)
