From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Sun, 4 Oct 2026 13:00:00 +0200
Subject: [PATCH] ws2_32: convert an i386 child's resolver pointers through its
 window on iOS

The WoW64 thunks of getaddrinfo, gethostbyaddr, gethostbyname,
gethostname and getnameinfo took the i386 ws2_32's 32-bit pointers as
host pointers and packed their addrinfo and hostent results with
PtrToUlong of host addresses. In an i386 child those live at B + guest.
Take the inner pointers through the owner's window, and pack the
results with a checked inverse after checking the whole result span,
failing with WSAEFAULT rather than truncating. getaddrinfo now returns
put_addrinfo32's status instead of reporting success for a rejected
result. The arithmetic moves to one unix-side header that 0012's
socket conversion uses too; its guards are unchanged.

Class: feature
Evidence: docs/evidence/2026-10-04-portal2-gameplay.md
Offered-upstream: no; the window exists only on the iOS port
---
 dlls/ntdll/unix/socket.c |  4 +-
 dlls/ws2_32/unixlib.c    | 84 +++++++++++++++++++++++++++++-----------
 include/Makefile.in      |  1 +
 include/wine/ios_wow64.h | 43 ++++++++++++++++++++
 4 files changed, 107 insertions(+), 25 deletions(-)
 create mode 100644 include/wine/ios_wow64.h

diff --git a/dlls/ntdll/unix/socket.c b/dlls/ntdll/unix/socket.c
index 2cd469b..66da4b2 100644
--- a/dlls/ntdll/unix/socket.c
+++ b/dlls/ntdll/unix/socket.c
@@ -100,14 +100,14 @@ WINE_DEFAULT_DEBUG_CHANNEL(winsock);
  * B, so the buffers, addresses and control blocks its ws2_32 hands to the
  * AFD ioctls (32-bit pointers, or 64-bit fields holding them) are B + guest.
  * Callers that are not WoW64 keep their pointers. */
-extern uintptr_t ios_wow64_current_base(void);
+#include "wine/ios_wow64.h"
 static void *socket_wow64_ptr( ULONGLONG value )
 {
     uintptr_t base;
 
     if (!value || value >> 32 || !in_wow64_call() || !(base = ios_wow64_current_base()))
         return (void *)(uintptr_t)value;
-    return (char *)base + value;
+    return ios_wow64_to_host( base, value );
 }
 #undef u64_to_user_ptr
 #define u64_to_user_ptr(u) socket_wow64_ptr(u)
diff --git a/dlls/ws2_32/unixlib.c b/dlls/ws2_32/unixlib.c
index 7b97fa7..400710e 100644
--- a/dlls/ws2_32/unixlib.c
+++ b/dlls/ws2_32/unixlib.c
@@ -1092,8 +1092,42 @@ C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == ws_unix_funcs_count );
 
 #ifdef _WIN64
 
+#include <stdint.h>
+
 typedef ULONG PTR32;
 
+#ifdef WINE_IOS
+#include "wine/ios_wow64.h"
+
+static void *ws2_wow64_to_host( PTR32 guest )
+{
+    return ios_wow64_to_host( ios_wow64_current_base(), guest );
+}
+
+static int ws2_wow64_to_guest( const void *host, PTR32 *guest )
+{
+    return ios_wow64_to_guest( ios_wow64_current_base(), host, guest );
+}
+
+static int ws2_wow64_result_span( const void *host, size_t size )
+{
+    return ios_wow64_host_span( ios_wow64_current_base(), host, size );
+}
+#else
+#define ws2_wow64_to_host(guest) ULongToPtr(guest)
+static int ws2_wow64_to_guest( const void *host, PTR32 *guest )
+{
+    if ((uintptr_t)host > UINT32_MAX) return 0;
+    *guest = PtrToUlong(host);
+    return 1;
+}
+static int ws2_wow64_result_span( const void *host, size_t size )
+{
+    uintptr_t addr = (uintptr_t)host;
+    return addr && addr <= UINT32_MAX && size <= (ULONGLONG)UINT32_MAX + 1 - addr;
+}
+#endif
+
 struct WS_addrinfo32
 {
     int   ai_flags;
@@ -1135,6 +1169,8 @@ static NTSTATUS put_addrinfo32( const struct WS_addrinfo *info, struct WS_addrin
         return ERROR_INSUFFICIENT_BUFFER;
     }
 
+    if (!ws2_wow64_result_span( info32, needed_size )) return WSAEFAULT;
+
     memset( info32, 0, needed_size );
 
     for (src = info; src != NULL; src = src->ai_next)
@@ -1147,15 +1183,15 @@ static NTSTATUS put_addrinfo32( const struct WS_addrinfo *info, struct WS_addrin
         dst->ai_protocol = src->ai_protocol;
         if (src->ai_canonname)
         {
-            dst->ai_canonname = PtrToUlong( next );
+            if (!ws2_wow64_to_guest( next, &dst->ai_canonname )) return WSAEFAULT;
             strcpy( next, src->ai_canonname );
             next += strlen(next) + 1;
         }
         dst->ai_addrlen = src->ai_addrlen;
-        dst->ai_addr = PtrToUlong(next);
+        if (!ws2_wow64_to_guest( next, &dst->ai_addr )) return WSAEFAULT;
         memcpy( next, src->ai_addr, dst->ai_addrlen );
         next += dst->ai_addrlen;
-        if (prev) prev->ai_next = PtrToUlong(dst);
+        if (prev && !ws2_wow64_to_guest( dst, &prev->ai_next )) return WSAEFAULT;
         prev = dst;
         dst = (struct WS_addrinfo32 *)next;
     }
@@ -1185,6 +1221,8 @@ static NTSTATUS put_hostent32( const struct WS_hostent *host, struct WS_hostent3
         return ERROR_INSUFFICIENT_BUFFER;
     }
 
+    if (!ws2_wow64_result_span( host32, needed_size )) return WSAEFAULT;
+
     memset( host32, 0, needed_size );
 
     /* arrange the memory in the same order as windows >= XP */
@@ -1196,12 +1234,12 @@ static NTSTATUS put_hostent32( const struct WS_hostent *host, struct WS_hostent3
     addr_list = aliases + alias_count + 1;
     p = (char *)(addr_list + addr_count + 1);
 
-    host32->h_aliases = PtrToUlong( aliases );
-    host32->h_addr_list = PtrToUlong( addr_list );
+    if (!ws2_wow64_to_guest( aliases, &host32->h_aliases )) return WSAEFAULT;
+    if (!ws2_wow64_to_guest( addr_list, &host32->h_addr_list )) return WSAEFAULT;
 
     for (i = 0; i < addr_count; ++i)
     {
-        addr_list[i] = PtrToUlong( p );
+        if (!ws2_wow64_to_guest( p, &addr_list[i] )) return WSAEFAULT;
         memcpy( p, host->h_addr_list[i], host->h_length );
         p += host->h_length;
     }
@@ -1210,12 +1248,12 @@ static NTSTATUS put_hostent32( const struct WS_hostent *host, struct WS_hostent3
     {
         size_t len = strlen( host->h_aliases[i] ) + 1;
 
-        aliases[i] = PtrToUlong( p );
+        if (!ws2_wow64_to_guest( p, &aliases[i] )) return WSAEFAULT;
         memcpy( p, host->h_aliases[i], len );
         p += len;
     }
 
-    host32->h_name = PtrToUlong( p );
+    if (!ws2_wow64_to_guest( p, &host32->h_name )) return WSAEFAULT;
     strcpy( p, host->h_name );
     return STATUS_SUCCESS;
 }
@@ -1236,16 +1274,16 @@ static NTSTATUS wow64_unix_getaddrinfo( void *args )
     struct WS_addrinfo hints;
     struct getaddrinfo_params params =
     {
-        ULongToPtr( params32->node ),
-        ULongToPtr( params32->service ),
+        ws2_wow64_to_host( params32->node ),
+        ws2_wow64_to_host( params32->service ),
         NULL,
         NULL,
-        ULongToPtr(params32->size)
+        ws2_wow64_to_host(params32->size)
     };
 
     if (params32->hints)
     {
-        const struct WS_addrinfo32 *hints32 = ULongToPtr(params32->hints);
+        const struct WS_addrinfo32 *hints32 = ws2_wow64_to_host(params32->hints);
         hints.ai_flags    = hints32->ai_flags;
         hints.ai_family   = hints32->ai_family;
         hints.ai_socktype = hints32->ai_socktype;
@@ -1255,7 +1293,7 @@ static NTSTATUS wow64_unix_getaddrinfo( void *args )
 
     if (!(params.info = malloc( *params.size ))) return WSAENOBUFS;
     status = unix_getaddrinfo( &params );
-    if (!status) put_addrinfo32( params.info, ULongToPtr(params32->info), ULongToPtr(params32->size) );
+    if (!status) status = put_addrinfo32( params.info, ws2_wow64_to_host(params32->info), ws2_wow64_to_host(params32->size) );
     free( params.info );
     return status;
 }
@@ -1275,17 +1313,17 @@ static NTSTATUS wow64_unix_gethostbyaddr( void *args )
     NTSTATUS status;
     struct gethostbyaddr_params params =
     {
-        ULongToPtr( params32->addr ),
+        ws2_wow64_to_host( params32->addr ),
         params32->len,
         params32->family,
         NULL,
-        ULongToPtr(params32->size)
+        ws2_wow64_to_host(params32->size)
     };
 
     if (!(params.host = malloc( *params.size ))) return WSAENOBUFS;
     status = unix_gethostbyaddr( &params );
     if (!status)
-        status = put_hostent32( params.host, ULongToPtr(params32->host), ULongToPtr(params32->size) );
+        status = put_hostent32( params.host, ws2_wow64_to_host(params32->host), ws2_wow64_to_host(params32->size) );
     free( params.host );
     return status;
 }
@@ -1303,15 +1341,15 @@ static NTSTATUS wow64_unix_gethostbyname( void *args )
     NTSTATUS status;
     struct gethostbyname_params params =
     {
-        ULongToPtr( params32->name ),
+        ws2_wow64_to_host( params32->name ),
         NULL,
-        ULongToPtr(params32->size)
+        ws2_wow64_to_host(params32->size)
     };
 
     if (!(params.host = malloc( *params.size ))) return WSAENOBUFS;
     status = unix_gethostbyname( &params );
     if (!status)
-        status = put_hostent32( params.host, ULongToPtr(params32->host), ULongToPtr(params32->size) );
+        status = put_hostent32( params.host, ws2_wow64_to_host(params32->host), ws2_wow64_to_host(params32->size) );
     free( params.host );
     return status;
 }
@@ -1325,7 +1363,7 @@ static NTSTATUS wow64_unix_gethostname( void *args )
         unsigned int size;
     } const *params32 = args;
 
-    struct gethostname_params params = { ULongToPtr(params32->name), params32->size };
+    struct gethostname_params params = { ws2_wow64_to_host(params32->name), params32->size };
 
     if (!unix_gethostname( &params )) return 0;
     return errno_from_unix( errno );
@@ -1347,11 +1385,11 @@ static NTSTATUS wow64_unix_getnameinfo( void *args )
 
     struct getnameinfo_params params =
     {
-        ULongToPtr( params32->addr ),
+        ws2_wow64_to_host( params32->addr ),
         params32->addr_len,
-        ULongToPtr( params32->host ),
+        ws2_wow64_to_host( params32->host ),
         params32->host_len,
-        ULongToPtr( params32->serv ),
+        ws2_wow64_to_host( params32->serv ),
         params32->serv_len,
         params32->flags
     };
diff --git a/include/Makefile.in b/include/Makefile.in
index 008736e..49cfc06 100644
--- a/include/Makefile.in
+++ b/include/Makefile.in
@@ -1127,6 +1127,7 @@ SOURCES = \
 	wine/hid.h \
 	wine/http.h \
 	wine/iaccessible2.idl \
+	wine/ios_wow64.h \
 	wine/irot.idl \
 	wine/irpcss.idl \
