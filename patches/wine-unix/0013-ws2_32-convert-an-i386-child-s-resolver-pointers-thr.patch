diff --git a/include/wine/ios_wow64.h b/include/wine/ios_wow64.h
new file mode 100644
index 0000000..8b13de1
--- /dev/null
+++ b/include/wine/ios_wow64.h
@@ -0,0 +1,43 @@
+/* Owner-local unix-side WoW64 pointers on iOS.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * Explicit WoW64 callers only: handles and native callers are not pointers.
+ */
+#ifndef __WINE_IOS_WOW64_H
+#define __WINE_IOS_WOW64_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+extern uintptr_t ios_wow64_current_base(void);
+
+/* Same NULL/guard semantics as wow64.dll's wow64_window_to_host. */
+static inline void *ios_wow64_to_host( uintptr_t base, uint32_t guest )
+{
+    return guest ? (void *)(base + guest) : NULL;
+}
+
+/* Checked inverse: the base itself is not a guest NULL. Output is untouched
+ * on rejection, including native heap pointers outside this owner's window.
+ * Base zero preserves conventional low-address WoW64 on other platforms. */
+static inline int ios_wow64_to_guest( uintptr_t base, const void *host, uint32_t *guest )
+{
+    uintptr_t addr = (uintptr_t)host;
+
+    if (!host) { *guest = 0; return 1; }
+    if (addr <= base || addr - base >= UINT64_C(0x100000000)) return 0;
+    *guest = addr - base;
+    return 1;
+}
+
+/* Validate a whole packed result before touching it. A nonempty buffer must
+ * start at a representable non-NULL guest pointer and not cross the window. */
+static inline int ios_wow64_host_span( uintptr_t base, const void *host, size_t size )
+{
+    uint32_t guest;
+
+    if (!ios_wow64_to_guest( base, host, &guest )) return 0;
+    if (!size) return 1;
+    return guest && size <= UINT64_C(0x100000000) - guest;
+}
+
+#endif
