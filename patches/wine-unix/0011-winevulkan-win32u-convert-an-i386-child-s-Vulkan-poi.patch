+++ b/dlls/winevulkan/vulkan.c
@@ -1000,6 +1000,16 @@ NTSTATUS vk_is_available_device_function(void *arg)
 
 #endif /* _WIN64 */
 
+#ifdef WINE_IOS
+/* a host pointer for the guest that is not in its window (vulkan_private.h) */
+ULONG vulkan_wow64_rejected(const void *host, ULONG_PTR base)
+{
+    ERR("Playport: host pointer %p (from %p) is outside the guest window at %#lx, giving the guest 0\n",
+        host, __builtin_return_address(0), (unsigned long)base);
+    return 0;
+}
+#endif
+
 NTSTATUS wow64_init_vulkan(void *arg)
 {
     struct
diff --git a/dlls/winevulkan/vulkan_private.h b/dlls/winevulkan/vulkan_private.h
index bc8fe30..9b2d0aa 100644
--- a/dlls/winevulkan/vulkan_private.h
+++ b/dlls/winevulkan/vulkan_private.h
@@ -27,6 +27,61 @@
 
 #include "wine/rbtree.h"
 
+#ifdef WINE_IOS
+/* Playport (iOS): an i386 child's address space is a 4 GiB window at host
+ * B (patches/madeira-unix 0049), so its 32-bit pointers are host B + guest.
+ * The WoW64 thunks (thunk32_*, wow64_init_vulkan) convert every guest pointer
+ * with UlongToPtr and every pointer they hand back with PtrToUlong, so those
+ * two convert through the window. B comes from the calling thread's paired
+ * TEB32, whose Tib.Self is its guest address; it is 0 for a thread without
+ * a TEB32 or a window. Handles (HWND, HANDLE) are not pointers and use
+ * ULongToHandle/LongToHandle, which stay plain. */
+static inline ULONG_PTR vulkan_wow64_window_base(void)
+{
+    TEB *teb = NtCurrentTeb();
+    const TEB32 *teb32;
+
+    if (!teb->WowTebOffset) return 0;
+    teb32 = (const TEB32 *)((const char *)teb + teb->WowTebOffset);
+    return (ULONG_PTR)teb32 - teb32->Tib.Self;
+}
+
+static inline void *vulkan_wow64_to_host(ULONG guest)
+{
+    return guest ? (void *)(vulkan_wow64_window_base() + guest) : NULL;
+}
+
+extern ULONG vulkan_wow64_rejected(const void *host, ULONG_PTR base);
+
+static inline ULONG vulkan_wow64_to_guest(const void *host)
+{
+    ULONG_PTR base = vulkan_wow64_window_base(), offset = (ULONG_PTR)host - base;
+
+    if (!host) return 0;
+    if (offset >> 32) return vulkan_wow64_rejected(host, base);
+    return offset;
+}
+
+/* a dispatchable handle in a 64-bit handle field (debug utils' objectHandle):
+ * the guest's client object pointer for an i386 caller */
+static inline UINT64 vulkan_wow64_client_handle(UINT64 handle)
+{
+    ULONG_PTR base = vulkan_wow64_window_base();
+    return base && handle && !(handle >> 32) ? base + handle : handle;
+}
+
+#undef UlongToPtr
+#define UlongToPtr(ul) vulkan_wow64_to_host(ul)
+#undef PtrToUlong
+#define PtrToUlong(p) vulkan_wow64_to_guest(p)
+/* the command pool's client object is the guest's, and its handle value
+ * a guest pointer */
+#define command_pool_from_handle(handle) \
+    command_pool_from_handle((VkCommandPool)(uintptr_t)vulkan_wow64_client_handle((uintptr_t)(handle)))
+#else
+#define vulkan_wow64_client_handle(handle) (handle)
+#endif
+
 extern const struct vulkan_funcs *vk_funcs;
 
 struct wine_instance
@@ -151,4 +206,5 @@ static inline void *find_next_struct(const void *s, VkStructureType t)
     return NULL;
 }
 
+
 #endif /* __WINE_VULKAN_PRIVATE_H */
