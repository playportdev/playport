From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Playport <dev@playport.invalid>
Date: Sun, 4 Oct 2026 07:16:21 +0200
Subject: [PATCH 11/12] winevulkan, win32u: convert an i386 child's Vulkan
 pointers through its window on iOS

Portal 2's i386 Direct3D 9 runs on DXVK over winevulkan's WoW64 thunks.
An i386 child's 32-bit pointers are host B + guest in its window
(madeira-unix 0049), so the thunks' UlongToPtr and PtrToUlong convert
through the window, with B from the calling thread's TEB32. Handles
(HANDLE, HWND, HINSTANCE) keep plain conversions. A command pool's
handle, and debug utils' 64-bit handles of dispatchable objects, are
the guest's client object pointers and take the window too (DXVK resets
command pools every frame).

win32u's zero_bits is the session's (0), so a child's thread now takes
the 32-bit zero_bits: its device memory is mapped in its window with
VK_EXT_map_memory_placed, rounded to 64 KiB because KosmicKrisp remaps
its whole heap-aligned buffer, and a mapping fits the guest when it is
in the window rather than below 4 GiB.

Class: feature
Evidence: docs/evidence/2026-10-04-portal2-d3d9-vulkan.md
Offered-upstream: no; the window exists only on the iOS port
---
 dlls/win32u/vulkan.c             | 46 ++++++++++++++++++++++++++
 dlls/winevulkan/vulkan.c         | 10 ++++++
 dlls/winevulkan/vulkan_private.h | 56 ++++++++++++++++++++++++++++++++
 dlls/winevulkan/vulkan_thunks.c  | 34 +++++++++----------
 4 files changed, 129 insertions(+), 17 deletions(-)

diff --git a/dlls/win32u/vulkan.c b/dlls/win32u/vulkan.c
index 261c10c..fdae681 100644
--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -60,6 +60,30 @@ static const UINT EXTERNAL_FENCE_WIN32_BITS = VK_EXTERNAL_FENCE_HANDLE_TYPE_OPAQ
 
 #define ROUND_SIZE(size, mask) ((((SIZE_T)(size) + (mask)) & ~(SIZE_T)(mask)))
 
+#ifdef WINE_IOS
+/* Playport (iOS): one process holds the x86-64 session and its i386 children,
+ * and win32u's zero_bits is the session's (0). An i386 child's thread has a
+ * TEB32, and its address space is a 4 GiB window at host B (patches/
+ * madeira-unix 0049), where a 32-bit zero_bits allocation lands (0057). Its
+ * Vulkan memory is mapped there like any WoW64 process's, with the placed
+ * map, and a mapping fits the guest when it is inside the window. */
+static ULONG_PTR vulkan_window_base(void)
+{
+    TEB *teb = NtCurrentTeb();
+    const TEB32 *teb32;
+
+    if (!teb->WowTebOffset) return 0;
+    teb32 = (const TEB32 *)((const char *)teb + teb->WowTebOffset);
+    return (ULONG_PTR)teb32 - teb32->Tib.Self;
+}
+
+static ULONG_PTR vulkan_zero_bits(void)
+{
+    return NtCurrentTeb()->WowTebOffset ? 0x7fffffff : zero_bits;
+}
+#define zero_bits vulkan_zero_bits()
+#endif
+
 static BOOL use_external_memory(void)
 {
     return zero_bits != 0;
@@ -530,6 +554,11 @@ static VkResult init_physical_device( struct vulkan_physical_device *physical_de
         else TRACE( "Using VK_EXT_external_memory_host for memory mapping with alignment: %u\n", physical_device->external_memory_align );
     }
 
+#ifdef WINE_IOS
+    if (NtCurrentTeb()->WowTebOffset)
+        ERR( "Playport: i386 Vulkan memory maps: placed alignment %u, host-pointer alignment %u\n",
+             physical_device->map_placed_align, physical_device->external_memory_align );
+#endif
     driver_funcs->p_map_device_extensions( &extensions );
     if (extensions.has_VK_KHR_external_memory_win32 && zero_bits && !physical_device->map_placed_align)
     {
@@ -1138,6 +1167,11 @@ static VkResult win32u_vkMapMemory2KHR( VkDevice client_device, const VkMemoryMa
     {
         SIZE_T alloc_size = memory->size;
 
+#ifdef WINE_IOS
+        /* the driver remaps its whole buffer, rounded to its heap's alignment,
+         * so the view must cover that too */
+        alloc_size = ROUND_SIZE( alloc_size, 0xffff );
+#endif
         placed_info.pNext = info.pNext;
         info.pNext = &placed_info;
         info.offset = 0;
@@ -1175,7 +1209,19 @@ static VkResult win32u_vkMapMemory2KHR( VkDevice client_device, const VkMemoryMa
     }
 
 #ifdef _WIN64
+#ifdef WINE_IOS
+    if (NtCurrentTeb()->WowTebOffset)
+    {
+        static LONG logged;
+        if (InterlockedIncrement( &logged ) <= 8)
+            ERR( "Playport: i386 map of %#llx bytes: result %d at %p (placed %p, window %#lx)\n",
+                 (unsigned long long)memory->size, res, res == VK_SUCCESS ? *data : NULL,
+                 placed_info.pPlacedAddress, (unsigned long)vulkan_window_base() );
+    }
+    if (NtCurrentTeb()->WowTebOffset && res == VK_SUCCESS && ((UINT_PTR)*data - vulkan_window_base()) >> 32)
+#else
     if (NtCurrentTeb()->WowTebOffset && res == VK_SUCCESS && (UINT_PTR)*data >> 32)
+#endif
     {
         FIXME( "returned mapping %p does not fit 32-bit pointer\n", *data );
         device->p_vkUnmapMemory( device->host.device, memory->obj.host.device_memory );
diff --git a/dlls/winevulkan/vulkan.c b/dlls/winevulkan/vulkan.c
index 2dac08a..0dcecae 100644
