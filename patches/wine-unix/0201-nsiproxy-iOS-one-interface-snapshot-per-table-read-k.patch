+
 /* A sandbox that denies the routing sysctl yields an empty table, so
  * GetAdaptersAddresses still lists adapters and addresses (with no gateways)
  * instead of failing outright. Other failures are reported as upstream's BSD
  * path does. One line per family; no addresses. */
-static NTSTATUS ios_forward_unavailable( int family, int error, UINT_PTR *count )
+static NTSTATUS ios_forward_unavailable( int family, int error )
 {
     static int logged[2];
