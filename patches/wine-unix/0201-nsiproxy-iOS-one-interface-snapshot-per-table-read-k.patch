+++ b/dlls/nsiproxy.sys/ios_ifaddrs.h
@@ -0,0 +1,58 @@
+/* iOS NSI interface snapshots. SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef __WINE_IOS_IFADDRS_H
+#define __WINE_IOS_IFADDRS_H
+#include <errno.h>
+#include <ifaddrs.h>
+#include <string.h>
+#include <time.h>
+
+/* Bound stale topology and counters, and repeated failed/empty reads too. */
+#define IOS_IF_SNAPSHOT_MS 1000
+
+static inline unsigned long long ios_if_now_ms( void )
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (unsigned long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static inline int ios_if_fresh( int valid, unsigned long long taken, unsigned long long now )
+{
+    return valid && now >= taken && now - taken < IOS_IF_SNAPSHOT_MS;
+}
+
+struct ios_if_snapshot
+{
+    struct ifaddrs *addrs;
+    unsigned long long taken;
+    int valid, error;
+};
+
+/* Refresh once at the start of a read, not per row: one enumeration must
+ * keep the same list even if its walk crosses the TTL boundary. Its caller
+ * holds the owning table lock until it has finished using all the rows.
+ * Failures discard the old list, and are retried after the TTL, not N times
+ * while filling N interfaces. A successful empty list is valid too. */
+static inline void ios_if_snapshot_refresh( struct ios_if_snapshot *snap, unsigned long long now )
+{
+    if (ios_if_fresh( snap->valid, snap->taken, now )) return;
+    if (snap->addrs) freeifaddrs( snap->addrs );
+    snap->addrs = NULL;
+    snap->taken = now;
+    snap->valid = 1;
+    snap->error = 0;
+    if (getifaddrs( &snap->addrs ))
+    {
+        snap->error = errno;
+        snap->addrs = NULL;
+    }
+}
+
+static inline const struct ifaddrs *ios_if_find( const struct ifaddrs *list, const char *name, int family )
+{
+    for (; list; list = list->ifa_next)
+        if (list->ifa_addr && list->ifa_addr->sa_family == family && !strcmp( list->ifa_name, name ))
+            return list;
+    return NULL;
+}
+#endif
