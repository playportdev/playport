-static NTSTATUS ios_forward_enumerate_all( int family, void *key_data, UINT key_size,
-                                           void *rw_data, UINT rw_size, void *dynamic_data, UINT dynamic_size,
-                                           void *static_data, UINT static_size, UINT_PTR *count )
+/* A fresh NET_RT_DUMP of `family` in *buffer (malloc'd). Empty and denied
+ * snapshots succeed with NULL/0; callers cache those too, not just data. */
+static NTSTATUS ios_forward_dump( int family, unsigned char **buffer_out, size_t *size_out )
 {
     int mib[] = { CTL_NET, PF_ROUTE, 0, family, 1 /* NET_RT_DUMP */, 0 };
-    size_t size = 0, offset;
-    unsigned int attempt, num = 0;
-    BOOL want_data = key_size || rw_size || dynamic_size || static_size;
+    size_t size = 0;
+    unsigned int attempt;
     unsigned char *buffer = NULL;
-    NTSTATUS status = STATUS_SUCCESS;
+    *buffer_out = NULL;
+    *size_out = 0;
     for (attempt = 0; attempt < 3; ++attempt)
     {
-        if (sysctl( mib, ARRAY_SIZE(mib), NULL, &size, NULL, 0 )) return ios_forward_unavailable( family, errno, count );
-        if (!size) { *count = 0; return STATUS_SUCCESS; }
+        if (sysctl( mib, ARRAY_SIZE(mib), NULL, &size, NULL, 0 )) return ios_forward_unavailable( family, errno );
+        if (!size) return STATUS_SUCCESS;
         if (size > 16 * 1024 * 1024) return STATUS_NO_MEMORY;
         /* Slack for routes added between the two calls. */
         size += size / 4 + 4096;
@@ -41,11 +54,46 @@ static NTSTATUS ios_forward_enumerate_all( int family, void *key_data, UINT key_
             int error = errno;
             free( buffer );
             buffer = NULL;
-            if (error != ENOMEM) return ios_forward_unavailable( family, error, count );
+            if (error != ENOMEM) return ios_forward_unavailable( family, error );
         }
     }
     /* Still racing a growing table: a failed read, not a short caller buffer. */
-    if (!buffer) return ios_forward_unavailable( family, ENOMEM, count );
+    if (!buffer) return ios_forward_unavailable( family, ENOMEM );
+    *buffer_out = buffer;
+    *size_out = size;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS ios_forward_enumerate_all( int family, void *key_data, UINT key_size,
+                                           void *rw_data, UINT rw_size, void *dynamic_data, UINT dynamic_size,
+                                           void *static_data, UINT static_size, UINT_PTR *count )
+{
+    unsigned long long now;
+    unsigned int num = 0, slot = family == AF_INET6;
+    BOOL want_data = key_size || rw_size || dynamic_size || static_size;
+    unsigned char *buffer;
+    size_t size, offset;
+    NTSTATUS status = STATUS_SUCCESS;
+
+    /* No NDIS path takes this lock: route -> if_list is the only order. */
+    pthread_mutex_lock( &ios_route_lock );
+    now = ios_if_now_ms();
+    if (!ios_if_fresh( ios_route_cache[slot].valid, ios_route_cache[slot].taken, now ))
+    {
+        free( ios_route_cache[slot].buffer );
+        ios_route_cache[slot].status = ios_forward_dump( family, &ios_route_cache[slot].buffer,
+                                                        &ios_route_cache[slot].size );
+        ios_route_cache[slot].taken = now;
+        ios_route_cache[slot].valid = 1;
+    }
+    status = ios_route_cache[slot].status;
+    if (status)
+    {
+        pthread_mutex_unlock( &ios_route_lock );
+        return status;
+    }
+    buffer = ios_route_cache[slot].buffer;
+    size = ios_route_cache[slot].size;
     for (offset = 0; offset < size;)
     {
         struct ios_route_header header;
@@ -111,7 +159,7 @@ static NTSTATUS ios_forward_enumerate_all( int family, void *key_data, UINT key_
         }
         ++num;
     }
-    free( buffer );
+    pthread_mutex_unlock( &ios_route_lock );
     if (status) return status;
     if (!want_data || num <= *count) *count = num;
     else status = STATUS_BUFFER_OVERFLOW;
