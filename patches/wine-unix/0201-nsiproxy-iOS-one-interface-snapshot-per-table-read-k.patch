              denied ? ", serving an empty table" : "" );
-    if (!denied) return STATUS_NOT_SUPPORTED;
-    *count = 0;
-    return STATUS_SUCCESS;
+    return denied ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
