 dlls/nsiproxy.sys/ios_routes.h  |  96 ++++++++++++++++++++++++++++
 dlls/nsiproxy.sys/ip.c          |  24 ++++++-
 dlls/nsiproxy.sys/ndis.c        | 109 +++++++++++++++++++++++++++++++-
 4 files changed, 323 insertions(+), 6 deletions(-)
