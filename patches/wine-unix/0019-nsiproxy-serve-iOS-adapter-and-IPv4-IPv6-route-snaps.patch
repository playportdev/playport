                 *luid = entry->if_luid;
@@ -696,6 +796,9 @@ BOOL convert_luid_to_unix_name( const NET_LUID *luid, const char **unix_name )
     {
         LIST_FOR_EACH_ENTRY( entry, &if_list, struct if_entry, entry )
