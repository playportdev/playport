diff --git a/dlls/nsiproxy.sys/ios_forward.h b/dlls/nsiproxy.sys/ios_forward.h
new file mode 100644
index 0000000..a79cff1
--- /dev/null
+++ b/dlls/nsiproxy.sys/ios_forward.h
@@ -0,0 +1,100 @@
+/* iOS NSI forwarding tables. SPDX-License-Identifier: LGPL-2.1-or-later */
+#include <errno.h>
+#include "ios_routes.h"
+
+static NTSTATUS ios_forward_enumerate_all( int family, void *key_data, UINT key_size,
+                                           void *rw_data, UINT rw_size, void *dynamic_data, UINT dynamic_size,
+                                           void *static_data, UINT static_size, UINT_PTR *count )
+{
+    int mib[] = { CTL_NET, PF_ROUTE, 0, family, 1 /* NET_RT_DUMP */, 0 };
+    size_t size = 0, offset;
+    unsigned int attempt, num = 0;
+    BOOL want_data = key_size || rw_size || dynamic_size || static_size;
+    unsigned char *buffer = NULL;
+    NTSTATUS status = STATUS_SUCCESS;
+    for (attempt = 0; attempt < 3; ++attempt)
+    {
+        if (sysctl( mib, ARRAY_SIZE(mib), NULL, &size, NULL, 0 )) return STATUS_NOT_SUPPORTED;
+        if (!size) { *count = 0; return STATUS_SUCCESS; }
+        if (size > 16 * 1024 * 1024) return STATUS_NO_MEMORY;
+        if (!(buffer = malloc( size ))) return STATUS_NO_MEMORY;
+        if (!sysctl( mib, ARRAY_SIZE(mib), buffer, &size, NULL, 0 )) break;
+        {
+            int error = errno;
+            free( buffer );
+            buffer = NULL;
+            if (error != ENOMEM) return STATUS_NOT_SUPPORTED;
+        }
+    }
+    if (!buffer) return STATUS_BUFFER_OVERFLOW;
+    for (offset = 0; offset < size;)
+    {
+        struct ios_route_header header;
+        struct ios_route route;
+        NET_LUID luid;
+        int parsed = ios_route_parse( buffer + offset, size - offset, &route );
+        if (parsed < 0) { status = STATUS_INVALID_PARAMETER; break; }
+        memcpy( &header, buffer + offset, sizeof(header) );
+        offset += header.length;
+        if (!parsed || route.family != (family == AF_INET ? 2 : 30) ||
+            !convert_index_to_luid( route.index, &luid )) continue;
+        if (want_data && num < *count)
+        {
+            if (key_size)
+            {
+                memset( key_data, 0, key_size );
+                if (family == AF_INET)
+                {
+                    struct nsi_ipv4_forward_key *key = key_data;
+                    key->luid = key->luid2 = luid;
+                    memcpy( &key->prefix, route.prefix, 4 );
+                    memcpy( &key->next_hop, route.next_hop, 4 );
+                    key->prefix_len = route.prefix_len;
+                }
+                else
+                {
+                    struct nsi_ipv6_forward_key *key = key_data;
+                    key->luid = key->luid2 = luid;
+                    memcpy( &key->prefix, route.prefix, 16 );
+                    memcpy( &key->next_hop, route.next_hop, 16 );
+                    key->prefix_len = route.prefix_len;
+                }
+                key_data = (BYTE *)key_data + key_size;
+            }
+            if (rw_size)
+            {
+                struct nsi_ip_forward_rw *rw = rw_data;
+                memset( rw, 0, rw_size );
+                rw->site_prefix_len = route.prefix_len;
+                rw->valid_lifetime = rw->preferred_lifetime = ~0u;
+                rw->metric = route.metric;
+                rw->protocol = route.gateway ? MIB_IPPROTO_NETMGMT : MIB_IPPROTO_LOCAL;
+                rw->immortal = TRUE;
+                rw->loopback = luid.Info.IfType == IF_TYPE_SOFTWARE_LOOPBACK;
+                rw_data = (BYTE *)rw_data + rw_size;
+            }
+            if (dynamic_size)
+            {
+                memset( dynamic_data, 0, dynamic_size );
+                if (family == AF_INET)
+                    memcpy( &((struct nsi_ipv4_forward_dynamic *)dynamic_data)->addr2, route.prefix, 4 );
+                else memcpy( &((struct nsi_ipv6_forward_dynamic *)dynamic_data)->addr2, route.prefix, 16 );
+                dynamic_data = (BYTE *)dynamic_data + dynamic_size;
+            }
+            if (static_size)
+            {
+                struct nsi_ip_forward_static *stat = static_data;
+                memset( stat, 0, static_size );
+                stat->origin = NlroManual;
+                stat->if_index = route.index;
+                static_data = (BYTE *)static_data + static_size;
+            }
+        }
+        ++num;
+    }
+    free( buffer );
+    if (status) return status;
+    if (!want_data || num <= *count) *count = num;
+    else status = STATUS_BUFFER_OVERFLOW;
+    return status;
+}
diff --git a/dlls/nsiproxy.sys/ios_routes.h b/dlls/nsiproxy.sys/ios_routes.h
new file mode 100644
index 0000000..1e3108c
--- /dev/null
+++ b/dlls/nsiproxy.sys/ios_routes.h
@@ -0,0 +1,96 @@
+/* Read-only Darwin routing-message decoder for the iOS port.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * The iOS SDK omits net/route.h. These fixed-width fields describe Darwin's
+ * RTM_VERSION 5 / NET_RT_DUMP ABI; no pointers or kernel-private layout.
+ * Keep parsing independent of SDK headers so malformed snapshots are tested. */
+#ifndef WINE_IOS_ROUTES_H
+#define WINE_IOS_ROUTES_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+struct ios_route_header
+{
+    uint16_t length;
+    uint8_t version, type;
+    uint16_t index;
+    int32_t flags, addrs, pid, seq, error, use;
+    uint32_t inits, metrics[14];
+};
+_Static_assert(sizeof(struct ios_route_header) == 92, "Darwin route ABI");
+struct ios_route
+{
+    unsigned int family, index, prefix_len, metric, gateway;
+    unsigned char prefix[16], next_hop[16];
+};
+
+/* -1: malformed; 0: well-formed but not a usable IP route; 1: route. */
+static int ios_route_parse( const void *bytes, size_t size, struct ios_route *row )
+{
+    struct ios_route_header h;
+    const unsigned char *p = bytes, *addresses[8] = {0};
+    unsigned int lengths[8] = {0}, i, bits = 0, zero_seen = 0, addr_size, addr_offset;
+    size_t offset;
+    if (size < sizeof(h)) return -1;
+    memcpy( &h, bytes, sizeof(h) );
+    if (h.length < sizeof(h) || h.length > size) return -1;
+    if (h.version != 5 || h.type != 4 || !(h.flags & 1) ||
+        (h.flags & (0x8 | 0x1000 | 0x800000)) || !h.index || h.error) return 0;
+    if ((uint32_t)h.addrs & ~0xffu) return -1;
+    offset = sizeof(h);
+    for (i = 0; i < 8; ++i)
+    {
+        unsigned int length, stride;
+        if (!(h.addrs & (1u << i))) continue;
+        if (offset > h.length || h.length - offset < 2) return -1;
+        length = p[offset];
+        stride = length ? (length + 3) & ~3u : 4;
+        if (stride > h.length - offset) return -1;
+        addresses[i] = p + offset;
+        lengths[i] = length;
+        offset += stride;
+    }
+    if (!addresses[0] || lengths[0] < 2) return -1;
+    memset( row, 0, sizeof(*row) );
+    row->family = addresses[0][1]; /* Darwin AF_INET=2, AF_INET6=30 */
+    if (row->family == 2) { addr_offset = 4; addr_size = 4; }
+    else if (row->family == 30) { addr_offset = 8; addr_size = 16; }
+    else return 0;
+    if (lengths[0] < addr_offset + addr_size) return -1;
+    memcpy( row->prefix, addresses[0] + addr_offset, addr_size );
+    if (h.flags & 4) bits = addr_size * 8; /* host routes need no mask */
+    else if (addresses[2])
+    {
+        /* BSD compresses masks, and their family need not match DST. */
+        for (i = 0; i < addr_size; ++i)
+        {
+            unsigned int bit, byte = addr_offset + i < lengths[2] ? addresses[2][addr_offset + i] : 0;
+            for (bit = 0x80; bit; bit >>= 1)
+                if (byte & bit) { if (zero_seen) return -1; ++bits; }
+                else zero_seen = 1;
+        }
+    }
+    row->prefix_len = bits;
+    row->index = h.index;
+    row->metric = h.metrics[2];
+    row->gateway = !!(h.flags & 2);
+    if (row->gateway)
+    {
+        if (!addresses[1] || lengths[1] < 2) return -1;
+        if (addresses[1][1] != row->family) return 0; /* AF_LINK is on-link, not a gateway */
+        if (lengths[1] < addr_offset + addr_size) return -1;
+        memcpy( row->next_hop, addresses[1] + addr_offset, addr_size );
+    }
+    if (row->family == 30)
+    {
+        /* BSD's embedded link-local zone is represented by the NSI LUID. */
+        if (row->prefix[0] == 0xfe && (row->prefix[1] & 0xc0) == 0x80)
+            row->prefix[2] = row->prefix[3] = 0;
+        if (row->next_hop[0] == 0xfe && (row->next_hop[1] & 0xc0) == 0x80)
+            row->next_hop[2] = row->next_hop[3] = 0;
+    }
+    /* Normalize network prefixes, even if a scoped route contains host bits. */
+    for (i = bits; i < addr_size * 8; ++i) row->prefix[i / 8] &= ~(0x80u >> (i % 8));
+    return 1;
+}
+#endif
