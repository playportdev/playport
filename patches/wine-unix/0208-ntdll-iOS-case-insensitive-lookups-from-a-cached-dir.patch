From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Fri, 13 Nov 2026 12:41:04 +0100
Subject: [PATCH] ntdll: iOS: case-insensitive lookups from a cached directory
 listing, and a [file-miss] census

A Windows path whose last component is missing or differs in case from
the file on a case-sensitive volume, iOS's, makes lookup_unix_name walk
the path component by component with an exact stat each, and then makes
find_file_in_dir read the whole directory: getattrlistat for the
volume's case sensitivity, open, getdirentries, close. The reparse point
probe ("name?") reads the directory a second time. On the phone each of
those calls costs tens of microseconds through the sandbox. Borderlands 2
probes thousands of such paths while it installs its DLC, and its
"Searching for downloadable content" screen took about 100 s, its main
thread in find_file_in_dir.

- ios_dircase.h keeps each directory's names upper-cased (as wcsnicmp
  compares them) in a hash table. The key is the directory's device,
  inode, mtime and ctime. Adding, removing or renaming an entry changes
  the mtime and ctime, so a key equal to a fresh stat's still holds the
  listing. A listing is kept only when the directory did not change
  while it was read, and both times are over 2 s old; a change within
  the same clock tick could leave them unchanged. Of names that fold
  alike, the first in directory order wins, as in the scan. At most 64
  directories and 24 MiB are kept, least recently used first out. An
  8.3 short name still takes the scan.
- When the path up to the last component exists as named, the walk
  starts at the last component. The walk would find each earlier
  component by its exact stat anyway. This is not done for a unix name,
  whose components may hold a slash.
  That walk reuses what it knows: its directory's stat, and that the
  last component's exact name just missed. A miss in a kept listing
  then costs three stats (the path, its directory, the reparse point's
  name) and reads no directory.
- [file-miss], while the measurement counters are on (not in the
  release app): each lookup that walks, timed, by process and by the
  directory of its first case-insensitive search, with its component.
  Every 10 s of lookups, and at exit, one line gives the totals and the
  cache's counts, and up to 12 lines give the costliest directories.

Class: ios-port
Evidence: PLA-879 (owner logs pla844/owner-bl2e and owner-bl2f: Borderlands 2's DLC install on the phone, 5,741 files under DLC, mostly Compat/Localization/<LANG> with .int and .INT names; main thread 78-93 % busy, the profiler's top return addresses find_file_in_dir's exact stat, get_dir_case_sensitivity and openat); tools/tests/test_dircase_ios.py (ios_dircase.h, and find_file_in_dir with lookup_unix_name from this file.c over a real directory tree)
Offered-upstream: no; Wine's scan is cheap on Linux, and the cache's mtime rule has Wine-wide trade-offs to discuss first
---
 dlls/ntdll/unix/file.c        | 361 +++++++++++++++++++++++++++++++++-
 dlls/ntdll/unix/ios_dircase.h | 275 ++++++++++++++++++++++++++
 dlls/ntdll/unix/thread.c      |   3 +
 3 files changed, 633 insertions(+), 6 deletions(-)
 create mode 100644 dlls/ntdll/unix/ios_dircase.h

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index ee712a5..6ce2e68 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2674,6 +2674,282 @@ NTSTATUS WINAPI NtQueryDirectoryFile( HANDLE handle, HANDLE event, PIO_APC_ROUTI
 }
 
 
+
+/* Playport (iOS): case-insensitive lookups through a cache of directory listings
+ * (ios_dircase.h), and the [file-miss] census of the lookups that take the slow
+ * path. A path that misses the whole-path stat is walked component by component;
+ * a component that misses its exact stat is looked for case-insensitively in its
+ * directory. On iOS that scan (getattrlistat, open, getdirentries, close, plus the
+ * same again for the reparse point "name?") costs far more than on Linux, and a
+ * game that probes for files it does not have pays it for every probe. */
+#include "ios_dircase.h"
+
+extern int ios_counters_on;   /* sync.c: the measurement counters are on */
+
+static pthread_mutex_t ios_dircase_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct ios_dircase_cache ios_dircase;
+
+static unsigned long long ios_fm_now(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (unsigned long long)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+static void ios_dircase_key_of( const struct stat *st, struct ios_dircase_key *key )
+{
+    key->dev = st->st_dev;
+    key->ino = st->st_ino;
+#ifdef __APPLE__
+    key->mtime_sec = st->st_mtimespec.tv_sec;
+    key->mtime_nsec = st->st_mtimespec.tv_nsec;
+    key->ctime_sec = st->st_ctimespec.tv_sec;
+    key->ctime_nsec = st->st_ctimespec.tv_nsec;
+#else
+    key->mtime_sec = st->st_mtim.tv_sec;
+    key->mtime_nsec = st->st_mtim.tv_nsec;
+    key->ctime_sec = st->st_ctim.tv_sec;
+    key->ctime_nsec = st->st_ctim.tv_nsec;
+#endif
+}
+
+/* One slow lookup, as the census sees it: the directory where the first
+ * case-insensitive scan ran and its component, the scans and how they ended. */
+struct ios_fm_walk
+{
+    int walked;                   /* the whole-path stat missed */
+    int scans, folded, cached;    /* case-insensitive scans; found by folding; answered by the cache */
+    char dir[160], comp[64];
+};
+static __thread struct ios_fm_walk *ios_fm_cur;
+
+/* What a walk already knows when it starts at the last component: the stat of
+ * the directory (buf up to pos), and that the last component's exact name is not
+ * there (the whole-path stat just missed it). find_file_in_dir and
+ * ios_dircase_lookup use them instead of asking again; lookup_unix_name clears
+ * them when the walk returns. */
+static __thread struct
+{
+    const char *buf;
+    int pos;
+    int leaf_missing;
+    struct stat st;
+} ios_dir_hint;
+
+static int ios_hint_dir( const char *buf, int pos, struct stat *st )
+{
+    if (!ios_dir_hint.buf || ios_dir_hint.buf != buf || ios_dir_hint.pos != pos) return 0;
+    *st = ios_dir_hint.st;
+    return 1;
+}
+
+static int ios_hint_leaf_missing( const char *buf, int pos )
+{
+    if (!ios_dir_hint.buf || ios_dir_hint.buf != buf || ios_dir_hint.pos != pos || !ios_dir_hint.leaf_missing)
+        return 0;
+    ios_dir_hint.leaf_missing = 0;
+    return 1;
+}
+
+#define IOS_FM_SLOTS 128
+#define IOS_FM_TOP 12
+#define IOS_FM_PERIOD_NS 10000000000ull
+static struct ios_fm_ent
+{
+    char dir[160], comp[64];
+    unsigned int pid;
+    unsigned long long lookups, missing, folded, scans, cached, ns;
+} ios_fm_tab[IOS_FM_SLOTS];
+static int ios_fm_used;
+static unsigned long long ios_fm_t0, ios_fm_lookups, ios_fm_missing, ios_fm_ns, ios_fm_dropped;
+static pthread_mutex_t ios_fm_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static int ios_fm_cmp( const void *a, const void *b )
+{
+    const struct ios_fm_ent *x = a, *y = b;
+    return x->ns < y->ns ? 1 : x->ns > y->ns ? -1 : 0;
+}
+
+/* Under ios_fm_mutex: the period's totals, then its costliest directories. */
+static void ios_fm_flush_locked( unsigned long long now, const char *why )
+{
+    int i, n = ios_fm_used < IOS_FM_TOP ? ios_fm_used : IOS_FM_TOP;
+    if (!ios_fm_lookups) return;
+    dprintf( 2, "[file-miss] %s %.1f s: %llu slow lookups (%llu not found), %.1f ms; cache %llu hits %llu builds "
+             "%llu stale %llu evicted %llu racy-or-big, %u dirs %llu KiB; %llu lookups not tabled\n",
+             why, (now - ios_fm_t0) / 1e9, ios_fm_lookups, ios_fm_missing, ios_fm_ns / 1e6,
+             (unsigned long long)ios_dircase.hits, (unsigned long long)ios_dircase.builds,
+             (unsigned long long)ios_dircase.stale, (unsigned long long)ios_dircase.evicted,
+             (unsigned long long)ios_dircase.uncached, ios_dircase.count,
+             (unsigned long long)(ios_dircase.bytes >> 10), ios_fm_dropped );
+    qsort( ios_fm_tab, ios_fm_used, sizeof(*ios_fm_tab), ios_fm_cmp );
+    for (i = 0; i < n; i++)
+    {
+        const struct ios_fm_ent *e = &ios_fm_tab[i];
+        dprintf( 2, "[file-miss]   pid %04x dir=\"%s\" n=%llu missing=%llu folded=%llu scans=%llu cached=%llu "
+                 "%.1f ms (%.0f us each) e.g. \"%s\"\n", e->pid, e->dir, e->lookups, e->missing, e->folded, e->scans,
+                 e->cached, e->ns / 1e6, e->ns / 1e3 / e->lookups, e->comp );
+    }
+    memset( ios_fm_tab, 0, sizeof(ios_fm_tab) );
+    ios_fm_used = 0;
+    ios_fm_lookups = ios_fm_missing = ios_fm_ns = ios_fm_dropped = 0;
+    ios_fm_t0 = now;
+}
+
+/* The census's last period, at the process's exit (exit_process). */
+void ios_fm_flush( const char *why )
+{
+    if (!ios_counters_on) return;
+    mutex_lock( &ios_fm_mutex );
+    ios_fm_flush_locked( ios_fm_now(), why );
+    mutex_unlock( &ios_fm_mutex );
+}
+
+static void ios_fm_note( const struct ios_fm_walk *w, NTSTATUS status, unsigned long long ns )
+{
+    unsigned long long now = ios_fm_now();
+    unsigned int pid = HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+    int missing = status != STATUS_SUCCESS, i;
+    struct ios_fm_ent *e = NULL;
+
+    mutex_lock( &ios_fm_mutex );
+    if (!ios_fm_t0) ios_fm_t0 = now;
+    ios_fm_lookups++;
+    ios_fm_missing += missing;
+    ios_fm_ns += ns;
+    for (i = 0; i < ios_fm_used && !e; i++)
+        if (ios_fm_tab[i].pid == pid && !strcmp( ios_fm_tab[i].dir, w->dir )) e = &ios_fm_tab[i];
+    if (!e && ios_fm_used < IOS_FM_SLOTS)
+    {
+        e = &ios_fm_tab[ios_fm_used++];
+        e->pid = pid;
+        memcpy( e->dir, w->dir, sizeof(e->dir) );
+    }
+    if (e)
+    {
+        e->lookups++;
+        e->missing += missing;
+        e->folded += w->folded;
+        e->scans += w->scans;
+        e->cached += w->cached;
+        e->ns += ns;
+        memcpy( e->comp, w->comp, sizeof(e->comp) );
+    }
+    else ios_fm_dropped++;
+    if (now - ios_fm_t0 >= IOS_FM_PERIOD_NS) ios_fm_flush_locked( now, "every 10 s" );
+    mutex_unlock( &ios_fm_mutex );
+}
+
+/* The census's view of a case-insensitive scan of the directory unix_name names
+ * (its component `name`). */
+static void ios_fm_scan( const char *unix_name, const WCHAR *name, int length, int found, int cached )
+{
+    struct ios_fm_walk *w = ios_fm_cur;
+    const char *d;
+    int i;
+
+    if (!w) return;
+    if (!w->scans++)
+    {
+        d = strstr( unix_name, "/dosdevices/" );
+        d = d ? d + 12 : unix_name;
+        if (strlen( d ) >= sizeof(w->dir)) d += strlen( d ) - (sizeof(w->dir) - 1);
+        strcpy( w->dir, d );
+        for (i = 0; i < length && i < (int)sizeof(w->comp) - 1; i++)
+            w->comp[i] = name[i] >= 0x20 && name[i] < 0x7f ? name[i] : '?';
+        w->comp[i] = 0;
+    }
+    w->folded += found;
+    w->cached += cached;
+}
+
+/* A case-insensitive scan of the directory unix_name names (pos - 1 is its
+ * terminator) through the cache: 1 when found (the entry's name is appended at
+ * pos), 0 when not there, -1 when the cache cannot answer (the caller scans). */
+static int ios_dircase_lookup( int root_fd, char *unix_name, int pos, const WCHAR *name, int length )
+{
+    struct ios_dircase_key key, after;
+    struct ios_dircase_dir *dir;
+    struct timespec now;
+    struct stat st;
+    WCHAR upper[MAX_DIR_ENTRY_LEN], buffer[MAX_DIR_ENTRY_LEN];
+    const char *found;
+    struct dirent *de;
+    DIR *d;
+    int i, fd, ret, keep;
+
+    if (length > MAX_DIR_ENTRY_LEN) return -1;
+    if (!ios_hint_dir( unix_name, pos - 1, &st ) && fstatat( root_fd, unix_name, &st, 0 )) return -1;
+    if (!S_ISDIR( st.st_mode )) return -1;
+    ios_dircase_key_of( &st, &key );
+    for (i = 0; i < length; i++) upper[i] = ntdll_towupper( name[i] );
+
+    mutex_lock( &ios_dircase_mutex );
+    if ((dir = ios_dircase_get( &ios_dircase, &key )))
+    {
+        found = dir->case_sensitive ? ios_dircase_find( dir, upper, length ) : NULL;
+        ios_fm_scan( unix_name, name, length, !!found, 1 );
+        if (found)
+        {
+            unix_name[pos - 1] = '/';
+            strcpy( unix_name + pos, found );
+        }
+        mutex_unlock( &ios_dircase_mutex );
+        return !!found;
+    }
+    mutex_unlock( &ios_dircase_mutex );
+
+    /* Not cached: read the listing, then keep it if it is safe to. */
+    if (!(dir = ios_dircase_new( &key, get_dir_case_sensitivity( root_fd, unix_name ) ))) return -1;
+    if (dir->case_sensitive)
+    {
+        if ((fd = openat( root_fd, unix_name, O_RDONLY )) == -1)
+        {
+            ios_dircase_free( dir );
+            return -1;
+        }
+        if (!(d = fdopendir( fd )))
+        {
+            close( fd );
+            ios_dircase_free( dir );
+            return -1;
+        }
+        keep = 1;
+        while ((de = readdir( d )))
+        {
+            ret = ntdll_umbstowcs( de->d_name, strlen(de->d_name), buffer, MAX_DIR_ENTRY_LEN );
+            if (ret < 0) continue;
+            for (i = 0; i < ret; i++) buffer[i] = ntdll_towupper( buffer[i] );
+            if (!ios_dircase_add( dir, de->d_name, buffer, ret ))
+            {
+                keep = 0;
+                break;
+            }
+        }
+        closedir( d );
+        if (!keep)
+        {
+            ios_dircase_free( dir );
+            return -1;
+        }
+    }
+    clock_gettime( CLOCK_REALTIME, &now );
+    keep = !fstatat( root_fd, unix_name, &st, 0 ) && (ios_dircase_key_of( &st, &after ), ios_dircase_key_equal( &key, &after ))
+           && !ios_dircase_racy( &key, now.tv_sec, now.tv_nsec );
+    found = dir->case_sensitive ? ios_dircase_find( dir, upper, length ) : NULL;
+    ios_fm_scan( unix_name, name, length, !!found, 0 );
+    if (found)
+    {
+        unix_name[pos - 1] = '/';
+        strcpy( unix_name + pos, found );
+    }
+    mutex_lock( &ios_dircase_mutex );
+    if (!keep) ios_dircase.uncached++;
+    if (!keep || !ios_dircase_put( &ios_dircase, dir )) ios_dircase_free( dir );
+    mutex_unlock( &ios_dircase_mutex );
+    return !!found;
+}
+
 /***********************************************************************
  *           find_file_in_dir
  *
@@ -2698,7 +2974,8 @@ static NTSTATUS find_file_in_dir( int root_fd, char *unix_name, int pos, const W
     if (ret >= 0 && ret <= MAX_DIR_ENTRY_LEN)
     {
         unix_name[pos + ret] = 0;
-        if (!fstatat( root_fd, unix_name, &st, 0 )) return STATUS_SUCCESS;
+        if (!ios_hint_leaf_missing( unix_name, pos - 1 ) && !fstatat( root_fd, unix_name, &st, 0 ))
+            return STATUS_SUCCESS;
     }
     if (check_case) goto not_found;  /* we want an exact match */
 
@@ -2712,6 +2989,15 @@ static NTSTATUS find_file_in_dir( int root_fd, char *unix_name, int pos, const W
     is_name_8_dot_3 = is_name_8_dot_3 && length >= 8 && name[4] == '~';
 #endif
 
+    if (!is_name_8_dot_3)
+    {
+        switch (ios_dircase_lookup( root_fd, unix_name, pos, name, length ))
+        {
+        case 1: return STATUS_SUCCESS;
+        case 0: goto not_found;
+        }
+    }
+
     if (!is_name_8_dot_3 && !get_dir_case_sensitivity( root_fd, unix_name )) goto not_found;
 
     /* now look for it through the directory */
@@ -3249,13 +3535,13 @@ static NTSTATUS resolve_reparse_point( int fd, int root_fd, OBJECT_ATTRIBUTES *a
 
 
 /******************************************************************************
- *           lookup_unix_name
+ *           lookup_unix_name_walk
  *
- * Helper for nt_to_unix_file_name
+ * Helper for nt_to_unix_file_name; lookup_unix_name below times it for the census.
  */
-static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name,
-                                  unsigned int nt_pos, char **buffer, int unix_len, int pos,
-                                  UINT disposition, BOOL open_reparse, BOOL is_unix, unsigned int reparse_count )
+static NTSTATUS lookup_unix_name_walk( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name,
+                                       unsigned int nt_pos, char **buffer, int unix_len, int pos,
+                                       UINT disposition, BOOL open_reparse, BOOL is_unix, unsigned int reparse_count )
 {
     static const WCHAR invalid_charsW[] = { INVALID_NT_CHARS, '/', 0 };
     const WCHAR *name = attr->ObjectName->Buffer + nt_pos;
@@ -3311,6 +3597,39 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
     if (is_unix && (disposition == FILE_OPEN || disposition == FILE_OVERWRITE))
         return STATUS_OBJECT_NAME_NOT_FOUND;
 
+    if (ios_fm_cur) ios_fm_cur->walked = 1;
+
+    /* Playport (iOS): when the path up to its last component exists as named,
+     * only that component needs a case-insensitive search. The walk below would
+     * find each earlier component by its exact stat, so it starts at the last one.
+     * The shortcut above left the whole name in unix_name, each backslash as a
+     * slash; a unix name may hold a slash inside a component, so it is not done
+     * for one. */
+    if (!is_unix && ret >= 0 && ret < unix_len - pos - 1)
+    {
+        char *slash = strrchr( unix_name + pos, '/' );
+        const WCHAR *sep = name + name_len;
+
+        while (sep > name && sep[-1] != '\\') sep--;
+        if (slash && slash > unix_name + pos && sep > name && sep < name + name_len)
+        {
+            *slash = 0;
+            if (!fstatat( root_fd, unix_name, &st, 0 ) && S_ISDIR( st.st_mode ))
+            {
+                unsigned int skip = sep - name;
+                pos = slash - unix_name;
+                ios_dir_hint.buf = unix_name;
+                ios_dir_hint.pos = pos;
+                ios_dir_hint.leaf_missing = 1;
+                ios_dir_hint.st = st;
+                nt_pos += skip;
+                name += skip;
+                name_len -= skip;
+            }
+            else *slash = '/';
+        }
+    }
+
     /* now do it component by component */
 
     while (name_len)
@@ -3401,6 +3720,36 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
 }
 
 
+/* Playport (iOS): lookup_unix_name_walk, timed for the [file-miss] census when it
+ * walks (a nested lookup, a reparse point's target, counts in its caller's); the
+ * walk's directory hint ends with it. */
+static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name,
+                                  unsigned int nt_pos, char **buffer, int unix_len, int pos,
+                                  UINT disposition, BOOL open_reparse, BOOL is_unix, unsigned int reparse_count )
+{
+    struct ios_fm_walk walk;
+    unsigned long long t0;
+    NTSTATUS status;
+
+    if (!ios_counters_on || ios_fm_cur)
+    {
+        status = lookup_unix_name_walk( root_fd, attr, nt_name, nt_pos, buffer, unix_len, pos, disposition,
+                                        open_reparse, is_unix, reparse_count );
+        ios_dir_hint.buf = NULL;
+        return status;
+    }
+    memset( &walk, 0, sizeof(walk) );
+    ios_fm_cur = &walk;
+    t0 = ios_fm_now();
+    status = lookup_unix_name_walk( root_fd, attr, nt_name, nt_pos, buffer, unix_len, pos, disposition,
+                                    open_reparse, is_unix, reparse_count );
+    ios_dir_hint.buf = NULL;
+    ios_fm_cur = NULL;
+    if (walk.walked) ios_fm_note( &walk, status, ios_fm_now() - t0 );
+    return status;
+}
+
+
 /******************************************************************************
  *           nt_to_unix_file_name_no_root
  */
diff --git a/dlls/ntdll/unix/ios_dircase.h b/dlls/ntdll/unix/ios_dircase.h
new file mode 100644
index 0000000..80fbdcd
--- /dev/null
+++ b/dlls/ntdll/unix/ios_dircase.h
@@ -0,0 +1,275 @@
+/*
+ * Playport (iOS): a cache of directory listings for case-insensitive lookups.
+ *
+ * A Windows path that does not match a file's case on a case-sensitive volume
+ * (iOS's) sends find_file_in_dir through the directory: open it, read every
+ * entry, convert and compare each name. A name that does not exist at all pays
+ * the same, twice (lookup_unix_name tries "name?" for a reparse point next). A
+ * game that probes for files it does not have does that thousands of times.
+ *
+ * Here a directory's names are kept upper-cased (as wcsnicmp compares them) in
+ * a hash table, keyed by the directory's device, inode, mtime and ctime. Adding,
+ * removing or renaming an entry changes the directory's mtime and ctime, so a
+ * key that still matches a fresh stat of the directory is still its listing. A
+ * listing is kept only when the directory did not change while it was read, and
+ * its mtime and ctime are older than IOS_DIRCASE_RACY_NS: a change within the
+ * same clock tick as the read could leave both times as they were.
+ *
+ * Plain C, no Wine headers: build/dircase/test.py compiles it on the host.
+ */
+
+#ifndef IOS_DIRCASE_H
+#define IOS_DIRCASE_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define IOS_DIRCASE_MAX_DIRS 64
+#define IOS_DIRCASE_MAX_BYTES (24u << 20)       /* all listings together */
+#define IOS_DIRCASE_MAX_ENTRIES 200000u         /* a bigger directory is not cached */
+#define IOS_DIRCASE_RACY_NS 2000000000ull       /* 2 s */
+
+struct ios_dircase_key
+{
+    uint64_t dev, ino;
+    int64_t mtime_sec, mtime_nsec, ctime_sec, ctime_nsec;
+};
+
+struct ios_dircase_slot
+{
+    uint32_t hash;
+    uint32_t name;    /* offset of the NUL-terminated unix name in names; UINT32_MAX: empty */
+    uint32_t upper;   /* offset of the upper-cased name in uppers */
+    uint32_t len;     /* its length in WCHARs */
+};
+
+struct ios_dircase_dir
+{
+    struct ios_dircase_key key;
+    int case_sensitive;           /* 0: the volume folds case itself; nothing to look up */
+    uint32_t count, size;         /* entries, slots (a power of two) */
+    struct ios_dircase_slot *slots;
+    char *names;
+    uint16_t *uppers;
+    uint32_t names_len, names_cap, uppers_len, uppers_cap;
+    size_t bytes;
+    uint64_t used;                /* the cache's clock at the last use */
+};
+
+struct ios_dircase_cache
+{
+    struct ios_dircase_dir *dirs[IOS_DIRCASE_MAX_DIRS];
+    unsigned count;
+    size_t bytes;
+    uint64_t clock;
+    uint64_t hits, misses, builds, stale, evicted, uncached;
+};
+
+static inline uint32_t ios_dircase_hash( const uint16_t *upper, uint32_t len )
+{
+    uint32_t h = 2166136261u;
+    while (len--) { h ^= *upper++; h *= 16777619u; }
+    return h ? h : 1;
+}
+
+static inline int ios_dircase_key_equal( const struct ios_dircase_key *a, const struct ios_dircase_key *b )
+{
+    return a->dev == b->dev && a->ino == b->ino && a->mtime_sec == b->mtime_sec && a->mtime_nsec == b->mtime_nsec &&
+           a->ctime_sec == b->ctime_sec && a->ctime_nsec == b->ctime_nsec;
+}
+
+/* Whether a listing read now could miss a change made in the same tick: the
+ * directory's mtime or ctime is within IOS_DIRCASE_RACY_NS of now (or after it). */
+static inline int ios_dircase_racy( const struct ios_dircase_key *key, int64_t now_sec, int64_t now_nsec )
+{
+    int64_t now = now_sec * 1000000000ll + now_nsec;
+    int64_t m = key->mtime_sec * 1000000000ll + key->mtime_nsec;
+    int64_t c = key->ctime_sec * 1000000000ll + key->ctime_nsec;
+    return now - m < (int64_t)IOS_DIRCASE_RACY_NS || now - c < (int64_t)IOS_DIRCASE_RACY_NS;
+}
+
+static inline void ios_dircase_free( struct ios_dircase_dir *dir )
+{
+    if (!dir) return;
+    free( dir->slots );
+    free( dir->names );
+    free( dir->uppers );
+    free( dir );
+}
+
+static inline struct ios_dircase_dir *ios_dircase_new( const struct ios_dircase_key *key, int case_sensitive )
+{
+    struct ios_dircase_dir *dir = calloc( 1, sizeof(*dir) );
+    if (!dir) return NULL;
+    dir->key = *key;
+    dir->case_sensitive = case_sensitive;
+    dir->size = 16;
+    if (!(dir->slots = malloc( dir->size * sizeof(*dir->slots) )))
+    {
+        free( dir );
+        return NULL;
+    }
+    memset( dir->slots, 0xff, dir->size * sizeof(*dir->slots) );
+    dir->bytes = sizeof(*dir) + dir->size * sizeof(*dir->slots);
+    return dir;
+}
+
+static inline struct ios_dircase_slot *ios_dircase_probe( const struct ios_dircase_dir *dir, const uint16_t *upper,
+                                                         uint32_t len, uint32_t hash )
+{
+    uint32_t i = hash & (dir->size - 1);
+    for (;; i = (i + 1) & (dir->size - 1))
+    {
+        struct ios_dircase_slot *s = &dir->slots[i];
+        if (s->name == UINT32_MAX) return s;
+        if (s->hash == hash && s->len == len && !memcmp( dir->uppers + s->upper, upper, len * sizeof(*upper) ))
+            return s;
+    }
+}
+
+static inline int ios_dircase_grow( struct ios_dircase_dir *dir )
+{
+    uint32_t size = dir->size * 2, i;
+    struct ios_dircase_slot *old = dir->slots, *slots = malloc( size * sizeof(*slots) );
+    if (!slots) return 0;
+    memset( slots, 0xff, size * sizeof(*slots) );
+    dir->slots = slots;
+    for (i = 0; i < dir->size; i++)
+    {
+        uint32_t j = old[i].hash & (size - 1);
+        if (old[i].name == UINT32_MAX) continue;
+        while (slots[j].name != UINT32_MAX) j = (j + 1) & (size - 1);
+        slots[j] = old[i];
+    }
+    dir->bytes += (size - dir->size) * sizeof(*slots);
+    dir->size = size;
+    free( old );
+    return 1;
+}
+
+static inline int ios_dircase_append( void **buf, uint32_t *len, uint32_t *cap, const void *data, uint32_t n,
+                                      size_t elem, size_t *bytes )
+{
+    if (*len + n > *cap)
+    {
+        uint32_t cap2 = *cap ? *cap : 256;
+        void *p;
+        while (*len + n > cap2) cap2 *= 2;
+        if (!(p = realloc( *buf, (size_t)cap2 * elem ))) return 0;
+        *bytes += (size_t)(cap2 - *cap) * elem;
+        *buf = p;
+        *cap = cap2;
+    }
+    memcpy( (char *)*buf + (size_t)*len * elem, data, (size_t)n * elem );
+    *len += n;
+    return 1;
+}
+
+/* Adds an entry in directory order: the first of names that fold alike wins, as
+ * find_file_in_dir's own scan returns the first one readdir gives. 0 when out of
+ * memory or too many entries (then the listing must not be kept). */
+static inline int ios_dircase_add( struct ios_dircase_dir *dir, const char *unix_name, const uint16_t *upper,
+                                   uint32_t len )
+{
+    uint32_t hash = ios_dircase_hash( upper, len ), nlen = (uint32_t)strlen( unix_name ) + 1;
+    struct ios_dircase_slot *s;
+    char *names = dir->names;
+    uint16_t *uppers = dir->uppers;
+
+    if (dir->count >= IOS_DIRCASE_MAX_ENTRIES) return 0;
+    if ((dir->count + 1) * 4 > dir->size * 3 && !ios_dircase_grow( dir )) return 0;
+    s = ios_dircase_probe( dir, upper, len, hash );
+    if (s->name != UINT32_MAX) return 1;
+    s->hash = hash;
+    s->len = len;
+    s->name = dir->names_len;
+    s->upper = dir->uppers_len;
+    if (!ios_dircase_append( (void **)&names, &dir->names_len, &dir->names_cap, unix_name, nlen, 1, &dir->bytes ) ||
+        !ios_dircase_append( (void **)&uppers, &dir->uppers_len, &dir->uppers_cap, upper, len, sizeof(*upper),
+                             &dir->bytes ))
+    {
+        dir->names = names;
+        dir->uppers = uppers;
+        s->name = UINT32_MAX;
+        return 0;
+    }
+    dir->names = names;
+    dir->uppers = uppers;
+    dir->count++;
+    return 1;
+}
+
+/* The unix name of the entry that folds to `upper`, or NULL. */
+static inline const char *ios_dircase_find( const struct ios_dircase_dir *dir, const uint16_t *upper, uint32_t len )
+{
+    const struct ios_dircase_slot *s = ios_dircase_probe( dir, upper, len, ios_dircase_hash( upper, len ) );
+    return s->name == UINT32_MAX ? NULL : dir->names + s->name;
+}
+
+/* The cached listing of a directory whose fresh stat gave `key`, or NULL. A
+ * listing of the same directory with an older key is dropped. */
+static inline struct ios_dircase_dir *ios_dircase_get( struct ios_dircase_cache *cache, const struct ios_dircase_key *key )
+{
+    unsigned i;
+    for (i = 0; i < cache->count; i++)
+    {
+        struct ios_dircase_dir *dir = cache->dirs[i];
+        if (dir->key.dev != key->dev || dir->key.ino != key->ino) continue;
+        if (ios_dircase_key_equal( &dir->key, key ))
+        {
+            dir->used = ++cache->clock;
+            cache->hits++;
+            return dir;
+        }
+        cache->stale++;
+        cache->bytes -= dir->bytes;
+        ios_dircase_free( dir );
+        cache->dirs[i] = cache->dirs[--cache->count];
+        break;
+    }
+    cache->misses++;
+    return NULL;
+}
+
+/* Keeps a listing, evicting the least recently used ones to stay within the
+ * limits. Returns 0 when it is not kept (too big, or another thread kept the
+ * same listing first); the caller frees it then. A kept listing of the same
+ * directory with another key is replaced. */
+static inline int ios_dircase_put( struct ios_dircase_cache *cache, struct ios_dircase_dir *dir )
+{
+    unsigned i;
+
+    if (dir->bytes > IOS_DIRCASE_MAX_BYTES / 4)
+    {
+        cache->uncached++;
+        return 0;
+    }
+    for (i = 0; i < cache->count; i++)
+    {
+        struct ios_dircase_dir *old = cache->dirs[i];
+        if (old->key.dev != dir->key.dev || old->key.ino != dir->key.ino) continue;
+        if (ios_dircase_key_equal( &old->key, &dir->key )) return 0;
+        cache->bytes -= old->bytes;
+        ios_dircase_free( old );
+        cache->dirs[i] = cache->dirs[--cache->count];
+        cache->stale++;
+        break;
+    }
+    while (cache->count && (cache->count >= IOS_DIRCASE_MAX_DIRS || cache->bytes + dir->bytes > IOS_DIRCASE_MAX_BYTES))
+    {
+        unsigned i, lru = 0;
+        for (i = 1; i < cache->count; i++) if (cache->dirs[i]->used < cache->dirs[lru]->used) lru = i;
+        cache->bytes -= cache->dirs[lru]->bytes;
+        ios_dircase_free( cache->dirs[lru] );
+        cache->dirs[lru] = cache->dirs[--cache->count];
+        cache->evicted++;
+    }
+    dir->used = ++cache->clock;
+    cache->dirs[cache->count++] = dir;
+    cache->bytes += dir->bytes;
+    cache->builds++;
+    return 1;
+}
+
+#endif /* IOS_DIRCASE_H */
