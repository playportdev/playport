From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ChristopherHX <christopher.homberger@web.de>
Date: Thu, 30 Jul 2026 19:13:17 +0200
Subject: [PATCH] advapi32: Keep the registry's credentials when the host store
 has none matching.

CredEnumerateW enumerates the registry, then the host's store through
mountmgr. Where the host store is present but holds nothing that
matches the filter, mountmgr answers ERROR_NOT_FOUND, and that failed
the whole call even though the registry pass had found credentials
(the macOS keychain backend does this). Count the host's
ERROR_NOT_FOUND as success when the registry pass found any, in both
the sizing and the copying pass.

Ported from Xodus's "add mc gdk patchset", without its added traces of
credential target names and counts.

Ported-from: https://github.com/xodus-gaming/wine/commit/f7331a3eaf2f0f1e7bdb94dce9379cc1a4d7bfb6
Ported: adapted
Class: upstream-bug
Evidence: docs/evidence/2026-10-30-wine-gdk-port.md
Offered-upstream: no
---
 dlls/advapi32/cred.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/dlls/advapi32/cred.c b/dlls/advapi32/cred.c
index dd8d7ce..493300f 100644
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -1059,7 +1059,7 @@ BOOL WINAPI CredEnumerateW(LPCWSTR Filter, DWORD Flags, DWORD *Count, PCREDENTIA
     if (ret == ERROR_SUCCESS)
     {
         ret = host_enumerate_credentials(Filter, NULL, NULL, &len, Count);
-        if (ret == ERROR_NOT_SUPPORTED) ret = ERROR_SUCCESS;
+        if (ret == ERROR_NOT_SUPPORTED || (ret == ERROR_NOT_FOUND && *Count > 0)) ret = ERROR_SUCCESS;
     }
     if (ret == ERROR_SUCCESS && *Count == 0)
         ret = ERROR_NOT_FOUND;
@@ -1085,7 +1085,7 @@ BOOL WINAPI CredEnumerateW(LPCWSTR Filter, DWORD Flags, DWORD *Count, PCREDENTIA
             if (ret == ERROR_SUCCESS)
             {
                 ret = host_enumerate_credentials(Filter, *Credentials, buffer, &len, Count);
-                if (ret == ERROR_NOT_SUPPORTED) ret = ERROR_SUCCESS;
+                if (ret == ERROR_NOT_SUPPORTED || (ret == ERROR_NOT_FOUND && *Count > 0)) ret = ERROR_SUCCESS;
             }
         }
         else ret = ERROR_OUTOFMEMORY;
