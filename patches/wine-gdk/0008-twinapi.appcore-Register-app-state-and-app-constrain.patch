From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domsvoboda <domsvoboda@users.noreply.github.com>
Date: Fri, 23 Oct 2026 08:51:17 +0200
Subject: [PATCH] twinapi.appcore: Register app-state and app-constrained
 change notifications.

RegisterAppStateChangeNotification and
RegisterAppConstrainedChangeNotification failed with
ERROR_CALL_NOT_IMPLEMENTED, which aborts GDK titles at start. Keep each
registration and hand back a distinct handle; a Wine desktop process
has no lifecycle source, so no notification is ever sent. Unregistering
frees the entry, and the remaining ones are freed when the DLL unloads.

Ported from Xodus Nexus unchanged (its asset
wine-appstate-registration.patch, as migrated into nexus-wine).

Co-authored-by: Gustavo Rosa <628398+Gustav0ar@users.noreply.github.com>
Ported-from: https://github.com/domsvoboda/nexus-wine/commit/9064d380ff1d7cedd932e8072ff3f027a3c2fba0
Ported: clean
Class: feature
Evidence: docs/evidence/2026-10-30-wine-gdk-port.md
Offered-upstream: no
---
 dlls/twinapi.appcore/appstate-registration.h | 98 ++++++++++++++++++++
 dlls/twinapi.appcore/main.c                  | 34 +------
 2 files changed, 102 insertions(+), 30 deletions(-)
 create mode 100644 dlls/twinapi.appcore/appstate-registration.h

diff --git a/dlls/twinapi.appcore/appstate-registration.h b/dlls/twinapi.appcore/appstate-registration.h
new file mode 100644
index 0000000..26dbd10
--- /dev/null
+++ b/dlls/twinapi.appcore/appstate-registration.h
@@ -0,0 +1,98 @@
+/* App-state and constrained subscriptions for Wine desktop processes. No
+ * lifecycle event source exists here, so registration never invents notifications.
+ * This file is part of Wine and is licensed under LGPL-2.1-or-later. */
+
+#include <stdlib.h>
+
+struct appstate_registration
+{
+    struct appstate_registration *next;
+    PAPPSTATE_REGISTRATION handle;
+    PAPPSTATE_CHANGE_ROUTINE routine;
+    void *context;
+    BOOL constrained;
+};
+
+static SRWLOCK appstate_lock = SRWLOCK_INIT;
+static struct appstate_registration *appstate_registrations;
+static ULONG_PTR appstate_next_id;
+
+static ULONG appstate_register( PAPPSTATE_CHANGE_ROUTINE routine, void *context,
+                                BOOL constrained, PAPPSTATE_REGISTRATION *out )
+{
+    struct appstate_registration *registration;
+
+    if (!out) return ERROR_INVALID_PARAMETER;
+    *out = NULL;
+    if (!routine) return ERROR_INVALID_PARAMETER;
+    if (!(registration = malloc( sizeof(*registration) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    registration->routine = routine;
+    registration->context = context;
+    registration->constrained = constrained;
+
+    AcquireSRWLockExclusive( &appstate_lock );
+    if (appstate_next_id == ~(ULONG_PTR)0)
+    {
+        ReleaseSRWLockExclusive( &appstate_lock );
+        free( registration );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    registration->handle = (PAPPSTATE_REGISTRATION)++appstate_next_id;
+    registration->next = appstate_registrations;
+    appstate_registrations = registration;
+    *out = registration->handle;
+    ReleaseSRWLockExclusive( &appstate_lock );
+    return ERROR_SUCCESS;
+}
+
+ULONG WINAPI RegisterAppStateChangeNotification( PAPPSTATE_CHANGE_ROUTINE routine,
+                                                void *context, PAPPSTATE_REGISTRATION *out )
+{
+    return appstate_register( routine, context, FALSE, out );
+}
+
+ULONG WINAPI RegisterAppConstrainedChangeNotification( PAPPCONSTRAIN_CHANGE_ROUTINE routine,
+                                                      void *context, PAPPCONSTRAIN_REGISTRATION *out )
+{
+    PAPPSTATE_REGISTRATION registration;
+    ULONG status;
+
+    if (!out) return ERROR_INVALID_PARAMETER;
+    *out = NULL;
+    status = appstate_register( routine, context, TRUE, &registration );
+    if (!status) *out = (PAPPCONSTRAIN_REGISTRATION)registration;
+    return status;
+}
+
+void WINAPI UnregisterAppStateChangeNotification( PAPPSTATE_REGISTRATION handle )
+{
+    struct appstate_registration **cursor, *registration = NULL;
+
+    AcquireSRWLockExclusive( &appstate_lock );
+    for (cursor = &appstate_registrations; *cursor; cursor = &(*cursor)->next)
+    {
+        if ((*cursor)->handle != handle) continue;
+        registration = *cursor;
+        *cursor = registration->next;
+        break;
+    }
+    ReleaseSRWLockExclusive( &appstate_lock );
+    free( registration );
+}
+
+void WINAPI UnregisterAppConstrainedChangeNotification( PAPPCONSTRAIN_REGISTRATION handle )
+{
+    UnregisterAppStateChangeNotification( (PAPPSTATE_REGISTRATION)handle );
+}
+
+/* Called only during DLL unload, when callers must no longer use its APIs. */
+static void appstate_free_registrations(void)
+{
+    struct appstate_registration *registration;
+
+    while ((registration = appstate_registrations))
+    {
+        appstate_registrations = registration->next;
+        free( registration );
+    }
+}
diff --git a/dlls/twinapi.appcore/main.c b/dlls/twinapi.appcore/main.c
index bc82361..990a904 100644
--- a/dlls/twinapi.appcore/main.c
+++ b/dlls/twinapi.appcore/main.c
@@ -21,38 +21,12 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
 
-/***********************************************************************
- *           RegisterAppConstrainedChangeNotification (twinapi.appcore.@)
- */
-ULONG WINAPI RegisterAppConstrainedChangeNotification( PAPPCONSTRAIN_CHANGE_ROUTINE routine, void *context, PAPPCONSTRAIN_REGISTRATION *reg )
-{
-    FIXME( "routine %p, context %p, reg %p - stub.\n", routine, context, reg );
-    return ERROR_CALL_NOT_IMPLEMENTED;
-}
-
-/***********************************************************************
- *           RegisterAppStateChangeNotification (twinapi.appcore.@)
- */
-ULONG WINAPI RegisterAppStateChangeNotification( PAPPSTATE_CHANGE_ROUTINE routine, void *context, PAPPSTATE_REGISTRATION *reg )
-{
-    FIXME( "routine %p, context %p, reg %p - stub.\n", routine, context, reg );
-    return ERROR_CALL_NOT_IMPLEMENTED;
-}
-
-/***********************************************************************
- *           UnregisterAppConstrainedChangeNotification (twinapi.appcore.@)
- */
-void WINAPI UnregisterAppConstrainedChangeNotification( PAPPCONSTRAIN_REGISTRATION reg )
-{
-    FIXME( "reg %p - stub.\n", reg );
-}
+#include "appstate-registration.h"
 
-/***********************************************************************
- *           UnregisterAppStateChangeNotification (twinapi.appcore.@)
- */
-void WINAPI UnregisterAppStateChangeNotification( PAPPSTATE_REGISTRATION reg )
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
 {
-    FIXME( "reg %p - stub.\n", reg );
+    if (reason == DLL_PROCESS_DETACH && !reserved) appstate_free_registrations();
+    return TRUE;
 }
 
