+  void DxvkMemoryAllocator::drainPendingFrees(
+          VkDeviceSize                size) {
+    DxvkMemoryDrain::Wait wait = m_drain.begin(size);
+
+    auto t0 = high_resolution_clock::now();
+
+    bool waited = m_device->waitForSubmissionsUntil([this, &wait] {
+      return m_drain.done(wait, false);
+    });
+
+    if (!waited)
+      return;
+
+    auto t1 = high_resolution_clock::now();
+
+    auto ns = [] (high_resolution_clock::duration d) {
+      return int64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(d).count());
+    };
+
+    if (m_drain.finish(wait, ns(t1 - t0), ns(t1.time_since_epoch()))) {
+      auto mib = [] (uint64_t bytes) {
+        return (bytes + (1u << 19)) >> 20;
+      };
+
+      Logger::info(str::format("[dxvk-drain] waited ", ns(t1 - t0) / 1000000, " ms, ",
+        mib(m_drain.freedSince(wait)), " MiB freed for ", mib(size), " MiB",
+        " | drains=", m_drain.drains(), " waited=", m_drain.waitedNs() / 1000000, " ms",
+        " freed=", mib(m_drain.drainedBytes()), " MiB"));
+    }
+  }
