diff --git a/src/dxvk/dxvk_memory_drain.h b/src/dxvk/dxvk_memory_drain.h
new file mode 100644
index 0000000..4492a12
--- /dev/null
+++ b/src/dxvk/dxvk_memory_drain.h
@@ -0,0 +1,153 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace dxvk {
+
+  /**
+   * \brief Pending frees drained under memory pressure
+   *
+   * Memory that only GPU work in flight holds, the storage a discard
+   * retired or the storage of a released resource, returns to the
+   * allocator only when the command list that used it last completes.
+   * When an allocation that must succeed would grow a heap past its
+   * budget, or finds no memory at all, the allocator first waits for
+   * that work, then tries again. The wait ends as soon as the GPU work
+   * has returned as much memory as the allocation needs, or when no
+   * work is left in flight.
+   *
+   * Counters only: no Vulkan call, no lock.
+   */
+  class DxvkMemoryDrain {
+
+  public:
+
+    /// At most one log line a second
+    constexpr static int64_t LogIntervalNs = 1'000'000'000ll;
+
+    /**
+     * \brief One drain in progress
+     */
+    struct Wait {
+      /// Bytes freed before the drain started
+      uint64_t start = 0u;
+      /// Bytes the allocation needs
+      uint64_t need = 0u;
+    };
+
+    /**
+     * \brief Runs one allocation under memory pressure
+     *
+     * An allocation that may fail, a relocation or an eviction, is
+     * tried once as asked. One that must succeed is first tried with
+     * no heap growing past its budget; failing that, the pending frees
+     * are drained and it is tried as asked.
+     * \param [in] mustSucceed The caller uses what it gets
+     * \param [in] create Tries the allocation, keeping heaps within
+     *    their budgets when its argument is \c true
+     * \param [in] drain Waits for GPU work in flight to return memory
+     * \returns What the last try gave
+     */
+    template<typename Create, typename Drain>
+    static auto allocate(bool mustSucceed, const Create& create, const Drain& drain) {
+      if (!mustSucceed)
+        return create(false);
+
+      auto allocation = create(true);
+
+      if (allocation)
+        return allocation;
+
+      drain();
+      return create(false);
+    }
+
+    /**
+     * \brief Whether growing a heap passes its budget
+     *
+     * \param [in] allocated Memory the heap holds
+     * \param [in] size Memory the allocation would add
+     * \param [in] budget The heap's budget, 0 for none
+     */
+    static bool overBudget(uint64_t allocated, uint64_t size, uint64_t budget) {
+      return budget && allocated + size > budget;
+    }
+
+    /**
+     * \brief Counts memory returned to the allocator
+     *
+     * Called for each allocation freed into a pool or
+     * whose dedicated memory is released.
+     */
+    void freed(uint64_t size) {
+      m_freedBytes.fetch_add(size, std::memory_order_relaxed);
+    }
+
+    /**
+     * \brief Starts a drain
+     * \param [in] need Bytes the allocation needs
+     */
+    Wait begin(uint64_t need) const {
+      Wait wait;
+      wait.start = m_freedBytes.load(std::memory_order_relaxed);
+      wait.need = need ? need : 1u;
+      return wait;
+    }
+
+    /**
+     * \brief Bytes freed since a drain started
+     */
+    uint64_t freedSince(const Wait& wait) const {
+      return m_freedBytes.load(std::memory_order_relaxed) - wait.start;
+    }
+
+    /**
+     * \brief Whether a drain may stop waiting
+     *
+     * \param [in] wait The drain
+     * \param [in] idle No GPU work is left in flight
+     */
+    bool done(const Wait& wait, bool idle) const {
+      return idle || freedSince(wait) >= wait.need;
+    }
+
+    /**
+     * \brief Records a finished drain
+     *
+     * \param [in] wait The drain
+     * \param [in] waitedNs How long it waited
+     * \param [in] nowNs Current time
+     * \returns Whether to log a line now
+     */
+    bool finish(const Wait& wait, int64_t waitedNs, int64_t nowNs) {
+      m_drains.fetch_add(1u, std::memory_order_relaxed);
+      m_waitedNs.fetch_add(uint64_t(waitedNs > 0 ? waitedNs : 0), std::memory_order_relaxed);
+      m_drainedBytes.fetch_add(freedSince(wait), std::memory_order_relaxed);
+
+      int64_t last = m_lastLogNs.load(std::memory_order_relaxed);
+
+      if (last && nowNs - last < LogIntervalNs)
+        return false;
+
+      return m_lastLogNs.compare_exchange_strong(last, nowNs ? nowNs : 1);
+    }
+
+    /// Drains so far
+    uint64_t drains() const { return m_drains.load(std::memory_order_relaxed); }
+    /// Time all drains waited, in ns
+    uint64_t waitedNs() const { return m_waitedNs.load(std::memory_order_relaxed); }
+    /// Memory returned while drains waited
+    uint64_t drainedBytes() const { return m_drainedBytes.load(std::memory_order_relaxed); }
+
+  private:
+
+    std::atomic<uint64_t> m_freedBytes    = { 0u };
+    std::atomic<uint64_t> m_drains        = { 0u };
+    std::atomic<uint64_t> m_waitedNs      = { 0u };
+    std::atomic<uint64_t> m_drainedBytes  = { 0u };
+    std::atomic<int64_t>  m_lastLogNs     = { 0 };
+
+  };
+
+}
diff --git a/src/dxvk/dxvk_queue.h b/src/dxvk/dxvk_queue.h
index 5e05690..2b5e2e0 100644
--- a/src/dxvk/dxvk_queue.h
+++ b/src/dxvk/dxvk_queue.h
@@ -171,6 +171,34 @@ namespace dxvk {
       m_finishCond.wait(lock, pred);
     }
 
+    /**
+     * \brief Waits for submissions in flight until a condition holds
+     *
+     * Returns as soon as the predicate holds, or once no command list
+     * is left to submit or to complete. Must not be called from the
+     * submission or completion threads.
+     * \param [in] pred Predicate to check, with the queue locked
+     * \returns Whether any command list was in flight
+     */
+    template<typename Pred>
+    bool waitForCompletionUntil(const Pred& pred) {
+      std::unique_lock<dxvk::mutex> lock(m_mutex);
+
+      auto idle = [this] {
+        return m_submitQueue.empty() && m_finishQueue.empty();
+      };
+
+      if (idle())
+        return false;
+
+      // Each completed command list wakes this up. A failed submission
+      // leaves the queue without doing so, so check now and then too.
+      while (!pred() && !idle())
+        m_finishCond.wait_for(lock, std::chrono::milliseconds(10));
+
+      return true;
+    }
+
     /**
      * \brief Waits for all submissions to complete
      */
