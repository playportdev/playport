@@ -2780,6 +2827,93 @@ namespace dxvk {
   }
 
 
+  void DxvkMemoryAllocator::releaseToCensus(
+          DxvkResourceAllocation* allocation) {
+    auto now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      high_resolution_clock::now().time_since_epoch());
+    m_census->release(allocation->m_census, allocation->m_size, now.count());
+  }
+
+
+  void DxvkMemoryAllocator::logMemoryCensus(
+          high_resolution_clock::time_point currentTime) {
+    int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      currentTime.time_since_epoch()).count();
+
+    // At most one line a second, so the work below is rare
+    DxvkMemoryCensusTick tick = m_census->tick(now);
+
+    if (!tick.log)
+      return;
+
+    DxvkMemoryCensusSnapshot census = m_census->snapshot(now);
+
+    VkDeviceSize allocated = 0u;
+    VkDeviceSize used = 0u;
+
+    { std::lock_guard<dxvk::mutex> lock(m_mutex);
+
+      for (uint32_t i = 0; i < m_memHeapCount; i++) {
+        DxvkMemoryStats stats = getMemoryStats(i);
+        allocated += stats.memoryAllocated;
+        used += stats.memoryUsed;
+      }
+    }
+
+    // The driver's usage: on KosmicKrisp, Metal's current allocated
+    // size, the metal= of its [kk-mem] line
+    std::string metal = "-";
+
+    if (m_device->features().extMemoryBudget) {
+      VkPhysicalDeviceMemoryBudgetPropertiesEXT memBudget = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT };
+      VkPhysicalDeviceMemoryProperties2 memInfo = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_PROPERTIES_2, &memBudget };
+
+      auto vki = m_device->adapter()->vki();
+      vki->vkGetPhysicalDeviceMemoryProperties2(m_device->adapter()->handle(), &memInfo);
+
+      VkDeviceSize usage = 0u;
+
+      for (uint32_t i = 0; i < m_memHeapCount; i++)
+        usage += memBudget.heapUsage[i];
+
+      metal = std::to_string((usage + (1u << 19)) >> 20);
+    }
+
+    auto mib = [] (int64_t bytes) {
+      return (bytes + (bytes < 0 ? -(1 << 19) : (1 << 19))) / (1 << 20);
+    };
+
+    auto kind = [&census, &mib] (DxvkMemoryKind k) {
+      const auto& count = census.kinds[size_t(k)];
+      return str::format(count.count, "/", mib(int64_t(count.bytes)));
+    };
+
+    // allocated = the kinds + pending + cached + free: cached is what the
+    // allocator's caches hold, free the chunks' unallocated space
+    int64_t counted = int64_t(census.totalBytes());
+
+    std::stringstream line;
+    line << "[dxvk-mem] metal=" << metal
+         << " allocated=" << mib(int64_t(allocated))
+         << " used=" << mib(int64_t(used))
+         << " | rt=" << kind(DxvkMemoryKind::RenderTarget)
+         << " sampled=" << kind(DxvkMemoryKind::Sampled)
+         << " storage=" << kind(DxvkMemoryKind::Storage)
+         << " staging=" << kind(DxvkMemoryKind::Staging)
+         << " buffers=" << kind(DxvkMemoryKind::Buffer)
+         << " pending=" << census.pending.count << "/" << mib(int64_t(census.pending.bytes))
+         << " oldest=" << std::fixed << std::setprecision(2) << double(census.oldestPendingNs) / 1e9 << " s"
+         << " | cached=" << mib(int64_t(used) - counted)
+         << " free=" << mib(int64_t(allocated) - int64_t(used))
+         << " MiB";
+
+    if (tick.growing)
+      line << " | growing live" << (tick.grewBytes < 0 ? "" : "+") << mib(tick.grewBytes) << " MiB";
+
+    Logger::info(line.str());
+  }
+
+
   bool DxvkMemoryAllocator::enableDefrag() const {
     auto option = m_device->config().enableMemoryDefrag;
 
