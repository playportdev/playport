diff --git a/src/dxvk/dxvk_memory_census.h b/src/dxvk/dxvk_memory_census.h
new file mode 100644
index 0000000..7700eed
--- /dev/null
+++ b/src/dxvk/dxvk_memory_census.h
@@ -0,0 +1,307 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+#include <vulkan/vulkan_core.h>
+
+namespace dxvk {
+
+  /**
+   * \brief What a live allocation backs
+   *
+   * The memory census (PLAYPORT_DXVK_MEMORY=1) counts every allocation
+   * the allocator hands out for a buffer or image under one kind until
+   * it is freed. Imported memory and sparse pages are not counted.
+   */
+  enum class DxvkMemoryKind : uint8_t {
+    None          = 0, ///< Not counted
+    RenderTarget  = 1, ///< Image with colour or depth-stencil attachment usage
+    Sampled       = 2, ///< Image with neither attachment nor storage usage
+    Storage       = 3, ///< Image with storage and no attachment usage
+    Staging       = 4, ///< Buffer in host-visible memory: staging and upload
+    Buffer        = 5, ///< Any other buffer
+    Count         = 6,
+  };
+
+
+  /**
+   * \brief Census state of one allocation
+   *
+   * Kept in the allocation itself. An allocation that is released, i.e.
+   * nothing but GPU work that has not completed holds it any more, is
+   * linked into the census' list of pending frees, oldest first.
+   */
+  struct DxvkMemoryCensusEntry {
+    DxvkMemoryCensusEntry*  prev        = nullptr;
+    DxvkMemoryCensusEntry*  next        = nullptr;
+    int64_t                 releasedNs  = 0;
+    DxvkMemoryKind          kind        = DxvkMemoryKind::None;
+  };
+
+
+  struct DxvkMemoryCensusCount {
+    uint64_t count = 0u;
+    uint64_t bytes = 0u;
+  };
+
+
+  /**
+   * \brief Live memory by kind at one time
+   *
+   * The kinds and the pending frees partition what the census counts:
+   * an allocation is in its kind while live and in \c pending once
+   * released, until it is freed.
+   */
+  struct DxvkMemoryCensusSnapshot {
+    std::array<DxvkMemoryCensusCount, size_t(DxvkMemoryKind::Count)> kinds = { };
+    /// Released but not yet freed: waiting on GPU completion
+    DxvkMemoryCensusCount pending = { };
+    /// How long the oldest pending free has waited, 0 without one
+    int64_t oldestPendingNs = 0;
+
+    uint64_t totalBytes() const {
+      uint64_t total = pending.bytes;
+
+      for (const auto& kind : kinds)
+        total += kind.bytes;
+
+      return total;
+    }
+  };
+
+
+  /**
+   * \brief Whether to log now, and why
+   */
+  struct DxvkMemoryCensusTick {
+    bool    log       = false;
+    /// Logged early, within a second, because memory grew fast
+    bool    growing   = false;
+    /// What the census' total grew by since the last line
+    int64_t grewBytes = 0;
+  };
+
+
+  /**
+   * \brief Live allocator memory by kind
+   *
+   * Counters only: no Vulkan call, no allocation. Thread-safe; the
+   * pending list takes a lock, the counters are atomic.
+   */
+  class DxvkMemoryCensus {
+
+  public:
+
+    /// A line every 10 s, as KosmicKrisp's [kk-mem]
+    constexpr static int64_t IntervalNs = 10'000'000'000ll;
+    /// Within a second while memory grows fast
+    constexpr static int64_t FastIntervalNs = 1'000'000'000ll;
+    /// Growth since the last line that counts as fast
+    constexpr static int64_t GrowthBytes = int64_t(64) << 20;
+
+    /**
+     * \brief Kind of an image allocation
+     *
+     * Attachment usage wins over storage usage: a render target
+     * that is also a UAV is a render target.
+     */
+    static DxvkMemoryKind classifyImage(VkImageUsageFlags usage) {
+      if (usage & (VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT))
+        return DxvkMemoryKind::RenderTarget;
+
+      if (usage & VK_IMAGE_USAGE_STORAGE_BIT)
+        return DxvkMemoryKind::Storage;
+
+      return DxvkMemoryKind::Sampled;
+    }
+
+    /**
+     * \brief Kind of a buffer allocation
+     *
+     * Host-visible memory is what the CPU writes: staging buffers and
+     * upload (dynamic) buffers. Everything else is GPU-only.
+     */
+    static DxvkMemoryKind classifyBuffer(VkMemoryPropertyFlags memoryProperties) {
+      return (memoryProperties & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+        ? DxvkMemoryKind::Staging
+        : DxvkMemoryKind::Buffer;
+    }
+
+    /**
+     * \brief Counts a live allocation
+     */
+    void add(DxvkMemoryCensusEntry& entry, DxvkMemoryKind kind, uint64_t size) {
+      if (kind == DxvkMemoryKind::None)
+        return;
+
+      entry = DxvkMemoryCensusEntry();
+      entry.kind = kind;
+
+      counter(kind).add(size);
+    }
+
+    /**
+     * \brief Moves a live allocation to the pending frees
+     *
+     * Called when only GPU work holds it. Once only: a second call,
+     * or a call for an allocation that is not counted, does nothing.
+     */
+    void release(DxvkMemoryCensusEntry& entry, uint64_t size, int64_t nowNs) {
+      if (entry.kind == DxvkMemoryKind::None)
+        return;
+
+      std::lock_guard<std::mutex> lock(m_mutex);
+
+      if (entry.releasedNs)
+        return;
+
+      // Keep the list in release order even when two threads race
+      if (m_tail && m_tail->releasedNs > nowNs)
+        nowNs = m_tail->releasedNs;
+
+      entry.releasedNs = nowNs > 0 ? nowNs : 1;
+      entry.prev = m_tail;
+      entry.next = nullptr;
+
+      if (m_tail)
+        m_tail->next = &entry;
+      else
+        m_head = &entry;
+
+      m_tail = &entry;
+
+      counter(entry.kind).sub(size);
+      m_pending.add(size);
+    }
+
+    /**
+     * \brief Stops counting a freed allocation
+     */
+    void remove(DxvkMemoryCensusEntry& entry, uint64_t size) {
+      if (entry.kind == DxvkMemoryKind::None)
+        return;
+
+      if (entry.releasedNs) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+
+        if (entry.prev)
+          entry.prev->next = entry.next;
+        else
+          m_head = entry.next;
+
+        if (entry.next)
+          entry.next->prev = entry.prev;
+        else
+          m_tail = entry.prev;
+
+        m_pending.sub(size);
+      } else {
+        counter(entry.kind).sub(size);
+      }
+
+      entry = DxvkMemoryCensusEntry();
+    }
+
+    /**
+     * \brief Decides whether a line is due
+     *
+     * The first call logs. Then a line every 10 s, or, at most once a
+     * second, as soon as the total has grown by 64 MiB since the last
+     * line. One caller wins a given line.
+     */
+    DxvkMemoryCensusTick tick(int64_t nowNs) {
+      DxvkMemoryCensusTick result = { };
+
+      int64_t last = m_lastNs.load();
+      int64_t total = int64_t(totalBytes());
+
+      if (last && nowNs - last < IntervalNs) {
+        if (nowNs - last < FastIntervalNs
+         || total < m_lastBytes.load() + GrowthBytes)
+          return result;
+
+        result.growing = true;
+      }
+
+      if (!m_lastNs.compare_exchange_strong(last, nowNs))
+        return DxvkMemoryCensusTick();
+
+      result.log = true;
+      result.grewBytes = total - m_lastBytes.exchange(total);
+      return result;
+    }
+
+    /**
+     * \brief Live memory by kind, and the pending frees
+     */
+    DxvkMemoryCensusSnapshot snapshot(int64_t nowNs) const {
+      DxvkMemoryCensusSnapshot result;
+
+      // Under the lock, so that no allocation moving to the pending
+      // frees is counted twice or not at all
+      std::lock_guard<std::mutex> lock(m_mutex);
+
+      for (size_t i = 0; i < result.kinds.size(); i++)
+        result.kinds[i] = m_kinds[i].read();
+
+      result.pending = m_pending.read();
+
+      if (m_head && nowNs > m_head->releasedNs)
+        result.oldestPendingNs = nowNs - m_head->releasedNs;
+
+      return result;
+    }
+
+  private:
+
+    struct Counter {
+      std::atomic<uint64_t> count = { 0u };
+      std::atomic<uint64_t> bytes = { 0u };
+
+      void add(uint64_t size) {
+        count.fetch_add(1u, std::memory_order_relaxed);
+        bytes.fetch_add(size, std::memory_order_relaxed);
+      }
+
+      void sub(uint64_t size) {
+        count.fetch_sub(1u, std::memory_order_relaxed);
+        bytes.fetch_sub(size, std::memory_order_relaxed);
+      }
+
+      DxvkMemoryCensusCount read() const {
+        DxvkMemoryCensusCount result;
