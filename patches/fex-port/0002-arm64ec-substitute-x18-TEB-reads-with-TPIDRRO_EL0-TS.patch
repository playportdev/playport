From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Will Faust <willtechnoduck@gmail.com>
Date: Tue, 28 Apr 2026 01:51:56 +0800
Subject: [PATCH] arm64ec: substitute x18 TEB reads with TPIDRRO_EL0+TSD slot
 275 for iOS host
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

iOS clobbers x18 on context switches, breaking FEX ARM64EC's emitted reads
of `[x18, OFFSET]` for TEB->{PEB, ChpeV2CpuAreaInfo, ...}. Add a build-time
flag `FEX_IOS_HOST` (cannot use `__APPLE__` since we cross-compile to a
Windows PE — `__APPLE__` is the build host, not the runtime host).

When FEX_IOS_HOST is defined, all 13 sites that previously read TEB via x18
substitute the equivalent 4-instruction sequence:
  mrs xN, TPIDRRO_EL0
  and xN, xN, #~7
  ldr xN, [xN, #IOS_TEB_TSD_OFFSET]   ; TEB from pthread TSD slot 275 (=0x898)
  ldr xN, [xN, OFFSET]                 ; original TEB-relative load

C++ emitter sites (8):
- Arm64Emitter.cpp FillStaticRegs (every JIT block prologue)
- Dispatcher.cpp dispatcher loop top + EmitSignalGuardedRegion entry/exit
- JIT/MiscOps.cpp MonoBackpatcherWrite

Asm sites in Module.S (5):
- DispatchJump/check_target_ec/enter_jit/BeginSimulation/ExitFunctionEC

Also adds plain (non-EC-mangled) symbol aliases for NtContinueNative,
NtAllocateVirtualMemoryNative, NtProtectVirtualMemoryNative, JumpSetStack,
and routes the asm-side SyncThreadContext call to the unprefixed C symbol —
needed because llvm-mingw arm64ec emits `extern "C"` functions with plain
mangling but the asm-side declarations use EC mangling (`#`-prefixed).

The Apple x18-exclusion in the JIT register allocator (Arm64Emitter.cpp:76)
is unified under the same FEX_IOS_HOST flag, semantically equivalent.

The libkern/OSCacheControl.h include + sys_icache_invalidate path stays gated
on `__APPLE__ && !__arm64ec__` since it's only valid for native macOS FEX
builds, not for cross-compiled PE.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
Madeira-commit: 1587b0084b12a62e7fa5adf5aac6bb8e46c37809
Rebased: clean
Class: madeira-port
Evidence: docs/evidence/2026-09-24-fex-latest-rebase.md
Offered-upstream: no
---
 .../Core/ArchHelpers/Arm64Emitter.cpp         | 10 ++-
 .../Interface/Core/ArchHelpers/Arm64Emitter.h | 14 +++++
 .../Interface/Core/Dispatcher/Dispatcher.cpp  | 36 ++++++++++-
 FEXCore/Source/Interface/Core/JIT/MiscOps.cpp |  8 +++
 Source/Windows/ARM64EC/Module.S               | 62 +++++++++++++++++++
 5 files changed, 127 insertions(+), 3 deletions(-)

diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
index 18782d7..072e0ed 100644
--- a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
+++ b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.cpp
@@ -73,7 +73,7 @@ namespace x64 {
     ARMEmitter::Reg::r8, ARMEmitter::Reg::r16, ARMEmitter::Reg::r17,
   };
 
-#ifdef __APPLE__
+#ifdef FEX_IOS_HOST
   // On Apple platforms, x18 is reserved for platform TLS. Do not use it.
   constexpr std::array<ARMEmitter::Register, 6> RA = {
     // All these callee saved
@@ -825,7 +825,15 @@ void Arm64Emitter::FillStaticRegs(FillStaticRegOptions Options) {
 
 #ifdef ARCHITECTURE_arm64ec
   // Load STATE in from the CPU area as x28 is not callee saved in the ARM64EC ABI.
+#ifdef FEX_IOS_HOST
+  // iOS clobbers x18 — read TEB from TPIDRRO_EL0+TSD slot 275 instead.
+  mrs(TmpReg.X(), ARMEmitter::SystemRegister::TPIDRRO_EL0);
+  and_(ARMEmitter::Size::i64Bit, TmpReg.X(), TmpReg.X(), ~7ULL);
+  ldr(TmpReg.X(), TmpReg.X(), IOS_TEB_TSD_OFFSET);
+  ldr(TmpReg.X(), TmpReg.X(), TEB_CPU_AREA_OFFSET);
+#else
   ldr(TmpReg.X(), ARMEmitter::Reg::r18, TEB_CPU_AREA_OFFSET);
+#endif
   ldr(STATE, TmpReg, CPU_AREA_EMULATOR_DATA_OFFSET);
 #endif
 
diff --git a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
index 5ad6e7b..64233b9 100644
--- a/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
+++ b/FEXCore/Source/Interface/Core/ArchHelpers/Arm64Emitter.h
@@ -86,6 +86,20 @@ constexpr size_t CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET = 0x1;
 constexpr size_t CPU_AREA_EMULATOR_STACK_BASE_OFFSET = 0x8;
 constexpr size_t CPU_AREA_EMULATOR_DATA_OFFSET = 0x30;
 
+#ifdef FEX_IOS_HOST
+// iOS clobbers x18 on context switches, so any `[x18, OFFSET]` read can SEGV
+// if the OS preempts between a refresh and the read. The Wine ntdll-unix port
+// stores the TEB in pthread TSD slot 275 (offset 0x898 from TPIDRRO_EL0 & ~7);
+// TPIDRRO_EL0 IS preserved by iOS across context switches. Use this as the
+// canonical TEB-pointer source and emit a 3-instruction read at every site
+// that would otherwise touch x18.
+//
+// Must match TSD_TEB_SLOT_OFFSET in our Wine ntdll-unix x18 patcher. Defined
+// at build time via -DFEX_IOS_HOST=1 since we cross-compile to a Windows PE
+// (so __APPLE__ is not defined even though the host OS is iOS).
+constexpr size_t IOS_TEB_TSD_OFFSET = 0x898;
+#endif
+
 constexpr uint64_t EC_CODE_BITMAP_MAX_ADDRESS = 1ULL << 47;
 #endif
 
diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
index b57005b..c14e7d5 100644
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -1,6 +1,12 @@
 // SPDX-License-Identifier: MIT
 
-#ifdef __APPLE__
+// libkern/OSCacheControl.h is for cache invalidation when building NATIVE
+// iOS FEXCore (Phase 1 standalone .a path). When cross-compiling to a Windows
+// ARM64EC PE for iOS hosting, the target is Windows; libkern isn't available
+// and we use Windows cache-flush APIs instead. Gate this on the *build host*
+// being Apple (`__APPLE__` is defined when compiling natively on macOS) AND
+// not building for an arm64ec target.
+#if defined(__APPLE__) && !defined(__arm64ec__)
 #include <libkern/OSCacheControl.h>
 #endif
 
@@ -156,7 +162,15 @@ void Dispatcher::EmitDispatcher() {
   // Clobbers TMP1/2
   // Check the EC code bitmap incase we need to exit the JIT to call into native code.
   ARMEmitter::ForwardLabel l_NotECCode;
+#ifdef FEX_IOS_HOST
+  // iOS clobbers x18 — read TEB from TPIDRRO_EL0+TSD slot 275 instead.
+  mrs(TMP1, ARMEmitter::SystemRegister::TPIDRRO_EL0);
+  and_(ARMEmitter::Size::i64Bit, TMP1, TMP1, ~7ULL);
+  ldr(TMP1, TMP1, IOS_TEB_TSD_OFFSET);
+  ldr(TMP1, TMP1, TEB_PEB_OFFSET);
+#else
   ldr(TMP1, ARMEmitter::XReg::x18, TEB_PEB_OFFSET);
+#endif
   ldr(TMP1, TMP1, PEB_EC_CODE_BITMAP_OFFSET);
 
   lsr(ARMEmitter::Size::i64Bit, TMP2, RipReg, 18);
@@ -264,7 +278,15 @@ void Dispatcher::EmitDispatcher() {
 #endif
 
 #ifdef ARCHITECTURE_arm64ec
+#ifdef FEX_IOS_HOST
+    // iOS x18 quirk: TEB read via TPIDRRO_EL0+TSD slot 275.
+    mrs(TMP2, ARMEmitter::SystemRegister::TPIDRRO_EL0);
+    and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, ~7ULL);
+    ldr(TMP2, TMP2, IOS_TEB_TSD_OFFSET);
+    ldr(TMP2, TMP2, TEB_CPU_AREA_OFFSET);
+#else
     ldr(TMP2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+#endif
     LoadConstant(ARMEmitter::Size::i32Bit, TMP1, 1);
     strb(TMP1.W(), TMP2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
 #endif
@@ -272,7 +294,14 @@ void Dispatcher::EmitDispatcher() {
     Body();
 
 #ifdef ARCHITECTURE_arm64ec
+#ifdef FEX_IOS_HOST
+    mrs(TMP2, ARMEmitter::SystemRegister::TPIDRRO_EL0);
+    and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, ~7ULL);
+    ldr(TMP2, TMP2, IOS_TEB_TSD_OFFSET);
+    ldr(TMP2, TMP2, TEB_CPU_AREA_OFFSET);
+#else
     ldr(TMP2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+#endif
     strb(ARMEmitter::WReg::zr, TMP2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
 #endif
 
@@ -606,7 +635,10 @@ void Dispatcher::EmitDispatcher() {
 
   Start = reinterpret_cast<uint64_t>(DispatchPtr);
   End = GetCursorAddress<uint64_t>();
-#ifdef __APPLE__
+  // sys_icache_invalidate is from libkern (Apple-native only). When cross-
+  // compiling to Windows ARM64EC PE, libkern isn't available — use the
+  // portable ClearICache path instead. Gate on build host AND target.
+#if defined(__APPLE__) && !defined(__arm64ec__)
   {
     auto DispatchSize = End - reinterpret_cast<uint64_t>(DispatchPtr);
     auto* RWPtr = WritePtr(reinterpret_cast<uint8_t*>(DispatchPtr));
diff --git a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
index 469a4bd..9a4fe41 100644
--- a/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/MiscOps.cpp
@@ -339,7 +339,15 @@ DEF_OP(MonoBackpatcherWrite) {
   }
 
 #ifdef ARCHITECTURE_arm64ec
+#ifdef FEX_IOS_HOST
+  // iOS x18 quirk: TEB read via TPIDRRO_EL0+TSD slot 275.
+  mrs(TMP2, ARMEmitter::SystemRegister::TPIDRRO_EL0);
+  and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, ~7ULL);
+  ldr(TMP2, TMP2, IOS_TEB_TSD_OFFSET);
+  ldr(TMP2, TMP2, TEB_CPU_AREA_OFFSET);
+#else
   ldr(TMP2, ARMEmitter::XReg::x18, TEB_CPU_AREA_OFFSET);
+#endif
   LoadConstant(ARMEmitter::Size::i32Bit, TMP1, 1);
   strb(TMP1.W(), TMP2, CPU_AREA_IN_SYSCALL_CALLBACK_OFFSET);
 #endif
diff --git a/Source/Windows/ARM64EC/Module.S b/Source/Windows/ARM64EC/Module.S
index 4a59cf6..b3c1c83 100644
--- a/Source/Windows/ARM64EC/Module.S
+++ b/Source/Windows/ARM64EC/Module.S
@@ -1,6 +1,19 @@
 .text
 .balign 16
 
+// iOS clobbers x18 on context switches. Read TEB from TPIDRRO_EL0+TSD slot 275
+// (set up by our Wine ntdll-unix x18 patcher) instead of trusting x18 directly.
+// TPIDRRO_EL0 is preserved by iOS across context switches, and the AND #~7 +
+// ldr at TSD slot 275 (offset 0x898) is the canonical pthread TLS pattern.
+// Must match IOS_TEB_TSD_OFFSET in Arm64Emitter.h.
+#ifdef FEX_IOS_HOST
+.macro IOS_LOAD_TEB reg
+  mrs \reg, TPIDRRO_EL0
+  and \reg, \reg, #~7
+  ldr \reg, [\reg, #0x898]
+.endm
+#endif
+
   // __os_arm64x_x64_jump in ARM64EC docs
   // Expects target code address in x9
 .globl DispatchJump
@@ -16,7 +29,12 @@ RetToEntryThunk:
 
 check_target_ec:
   // Check if target is in fact x86 code
+#ifdef FEX_IOS_HOST
+  IOS_LOAD_TEB x16
+  ldr x16, [x16, #0x60] // TEB->PEB
+#else
   ldr x16, [x18, #0x60] // TEB->PEB
+#endif
   ldr x16, [x16, #0x368] // PEB->EcCodeBitMap
   lsr x17, x9, #18
   ldr x16, [x16, x17, lsl #3]
@@ -32,7 +50,12 @@ ExitToX64:
   str lr, [sp, #-8]! // Push return address to stack, this will be popped by the x86 RET instr.
 
 enter_jit:
+#ifdef FEX_IOS_HOST
+  IOS_LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#else
   ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#endif
   mov w16, #1
   strb w16, [x17, #0x0] // ChpeV2CpuAreaInfo->InSimulation
   ldr x16, [x17, #0x40] // ChpeV2CpuAreaInfo->EmulatorData[2] - DispatcherLoopTopEnterEC
@@ -41,12 +64,27 @@ enter_jit:
   // Invoked by KiUserEmulationDispatcher after e.g. an NtContinue to x86 code
 .global BeginSimulation
 BeginSimulation:
+#ifdef FEX_IOS_HOST
+  IOS_LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#else
   ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#endif
   ldr x16, [x17, #0x8] // ChpeV2CpuAreaInfo->EmulatorStackBase
   mov sp, x16
   ldr x0, [x17, #0x18] // ChpeV2CpuAreaInfo->ContextAmd64
+#ifdef FEX_IOS_HOST
+  // llvm-mingw arm64ec emits extern "C" funcs as plain (unprefixed) symbols.
+  bl SyncThreadContext
+#else
   bl "#SyncThreadContext"
+#endif
+#ifdef FEX_IOS_HOST
+  IOS_LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#else
   ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#endif
   ldr x16, [x17, #0x48] // ChpeV2CpuAreaInfo->EmulatorData[3] - DispatcherLoopTopEnterECFillSRA
   mov x11, #0 // Zero ENTRY_FILL_SRA_SINGLE_INST_REG to avoid single step
   br x16 // DispatcherLoopTopEnterECFillSRA(SingleInst:x10, CPUArea:x17)
@@ -59,7 +97,12 @@ ExitFunctionEC:
   mrs x17, fpcr
   and x17, x17, #~6 // NEP + AH
   msr fpcr, x17
+#ifdef FEX_IOS_HOST
+  IOS_LOAD_TEB x17
+  ldr x17, [x17, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#else
   ldr x17, [x18, #0x1788] // TEB->ChpeV2CpuAreaInfo
+#endif
   strb wzr, [x17, #0x0] // ChpeV2CpuAreaInfo->InSimulation
   ldr x17, [x17, #0x20] // ChpeV2CpuAreaInfo->SuspendDoorbell
   ldr w17, [x17]
@@ -120,13 +163,28 @@ ExitFunctionSuspendPoint:
 
   // Allows for continuing from a full native context, as the NTDLL NtContinue export takes in an x64 context with EC and
   // the conversion to that loses the ARM64EC ABI-disallowed registers that FEX uses.
+#ifdef FEX_IOS_HOST
+// llvm-mingw arm64ec emits unprefixed references from C code (`NtContinueNative`)
+// but the macro defines `#NtContinueNative` only. Add unprefixed aliases pointing
+// to the same code so the link resolves cleanly without linker-synthesized thunks.
+.global NtContinueNative
+NtContinueNative:
+#endif
 DIRECT_SYSCALL_WRAPPER("#NtContinueNative", WineNtContinueSyscallId, 0x43)
 DIRECT_SYSCALL_WRAPPER("#NtRaiseExceptionNative", WineNtRaiseExceptionSyscallId, 0x174)
 
   // Both of these are wrapped as FEX needs them to setup its call checker at startup time and their NTDLL thunks could
   // already be patched by then (and because the call checker isn't installed, their patched x86 versions would be invoked
   // when called by FEX).
+#ifdef FEX_IOS_HOST
+.global NtAllocateVirtualMemoryNative
+NtAllocateVirtualMemoryNative:
+#endif
 DIRECT_SYSCALL_WRAPPER("#NtAllocateVirtualMemoryNative", WineNtAllocateVirtualMemorySyscallId, 0x18)
+#ifdef FEX_IOS_HOST
+.global NtProtectVirtualMemoryNative
+NtProtectVirtualMemoryNative:
+#endif
 DIRECT_SYSCALL_WRAPPER("#NtProtectVirtualMemoryNative", WineNtProtectVirtualMemorySyscallId, 0x50)
 
   // A replacement for the standard ARM64EC call checker that ignores any FFS patches and always redirects to a function's
@@ -150,6 +208,10 @@ end:
   ret
 
   // Expects target address in x0, and the SP to set in x1
+#ifdef FEX_IOS_HOST
+.global JumpSetStack
+JumpSetStack:
+#endif
 .global "#JumpSetStack"
 "#JumpSetStack":
   mov sp, x1
