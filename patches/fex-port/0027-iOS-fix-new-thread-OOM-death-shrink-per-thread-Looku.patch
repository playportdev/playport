+#endif
 
   auto* Thread = CTX->CreateThread();
+#ifdef FEX_IOS_HOST
+  IosTiLog("[FEX-iOS] TI:createthread\n");
+#endif
 
   // Default segment setup.
   auto Frame = Thread->CurrentFrame;
@@ -1211,6 +1244,9 @@ NTSTATUS ThreadInit() {
 #endif
 
   FEX::Windows::CallRetStack::InitializeThread(Thread);
+#ifdef FEX_IOS_HOST
