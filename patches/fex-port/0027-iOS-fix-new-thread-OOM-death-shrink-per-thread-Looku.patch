 #ifdef FEX_IOS_HOST
   /* iOS-Mythic diagnostic: log entry to thread-init so we can confirm Wine
@@ -1148,7 +1169,13 @@ NTSTATUS ThreadInit() {
   }
 #endif
   std::scoped_lock Lock(ThreadCreationMutex);
+#ifdef FEX_IOS_HOST
