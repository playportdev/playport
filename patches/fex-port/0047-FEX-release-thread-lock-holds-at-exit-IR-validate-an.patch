+          for (size_t i = 0; i < NumWords; ++i) {
+            LogMan::Msg::EFmt("[ircap]   +{:#06x}  {:08x}", HostFrom + static_cast<ptrdiff_t>(i * 4), Words[i]);
+          }
+        } else {
