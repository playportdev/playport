+#ifdef FEX_IOS_HOST
+/* iOS-Mythic ml306 (task #51): CallbackPtr entry-state capture buffer, defined in Dispatcher.cpp
+ * and written by emitted code at CallbackPtr entry. Read by the [cb-entry] reporter below. */
