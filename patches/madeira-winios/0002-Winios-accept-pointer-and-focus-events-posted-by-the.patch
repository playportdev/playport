From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Thu, 24 Sep 2026 12:00:00 +0200
Subject: [PATCH] Winios: accept pointer and focus events posted by the host
 app

Two event kinds the host posts that only a host-driven app needs: absolute
pointer input and focus changes.

Class: host-app
Evidence: docs/evidence/2026-09-24-bootstrap.md
Offered-upstream: no
---
 app/Madeira/Winios/Winios.m | 69 +++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/app/Madeira/Winios/Winios.m b/app/Madeira/Winios/Winios.m
index 088b8c6..778365f 100644
--- a/app/Madeira/Winios/Winios.m
+++ b/app/Madeira/Winios/Winios.m
@@ -512,6 +512,71 @@ void winios_post_key(int vk, int down) {
     winios_q_push_ev(WINIOS_EV_KEY, vk, 0, down ? 0 : KEYEVENTF_KEYUP, 0);
 }
 
+/* Playport (app HostIO): two event kinds the host posts that only a
+ * Wine thread can resolve, so they are converted here, in the drain, which runs
+ * on the guest thread that is pumping its messages.
+ *
+ *   WINIOS_EV_CLIENT_MOUSE  x, y are 0..65535 fractions of the foreground
+ *       window's client area (the host knows where a touch landed on the
+ *       presented image, not where Wine put the window); posted as an absolute
+ *       mouse event at that client point in desktop pixels.
+ *   WINIOS_EV_FOCUS         x = 0: the app left the foreground; the desktop
+ *       becomes Wine's foreground window, as winemac.drv does on app
+ *       deactivation, so the game gets WM_ACTIVATEAPP(FALSE)/WM_KILLFOCUS.
+ *       x = 1: the window that lost it gets it back.
+ *
+ * Ring order is kept: a focus loss posted before the key releases reaches the
+ * game while the keys are still down, as on a desktop. */
+#define WINIOS_EV_CLIENT_MOUSE 2
+#define WINIOS_EV_FOCUS        3
+
+typedef struct { int left, top, right, bottom; } winios_wrect;   /* Wine RECT: LONG is 32-bit on LP64 */
+typedef struct { int x, y; } winios_wpoint;
+extern HWND NtUserGetForegroundWindow(void);
+extern BOOL NtUserSetForegroundWindow(HWND hwnd);
+extern HWND get_desktop_window(void);
+extern BOOL get_client_rect(HWND hwnd, winios_wrect *rect, UINT dpi);
+extern BOOL client_to_screen(HWND hwnd, winios_wpoint *pt);
+
+static HWND g_focus_saved;   /* drain thread only */
+
+static void winios_drain_client_mouse(const winios_input_event_t *e) {
+    HWND fg = NtUserGetForegroundWindow();
+    winios_wrect rc;
+    winios_wpoint pt;
+    if (!fg || fg == get_desktop_window() || !get_client_rect(fg, &rc, 0) || rc.right <= 0 || rc.bottom <= 0) {
+        fprintf(stderr, "[winios] client pointer dropped: no foreground client area (fg=%p)\n", fg);
+        return;
+    }
+    pt.x = (int)((long long)e->x * rc.right / 65536);
+    pt.y = (int)((long long)e->y * rc.bottom / 65536);
+    client_to_screen(fg, &pt);
+    winios_drv_post_mouse(pt.x, pt.y, e->flags | MOUSEEVENTF_ABSOLUTE, e->data, NULL);
+}
+
+static void winios_drain_focus(int active) {
+    HWND desk = get_desktop_window(), fg = NtUserGetForegroundWindow();
+    if (!active) {
+        if (fg && fg != desk) {
+            g_focus_saved = fg;
+            NtUserSetForegroundWindow(desk);
+        }
+    } else if (g_focus_saved) {
+        NtUserSetForegroundWindow(g_focus_saved);
+        g_focus_saved = NULL;
+    }
+    fprintf(stderr, "[winios] focus %s fg=%p -> %p\n", active ? "back" : "lost", fg, NtUserGetForegroundWindow());
+}
+
+/* fx, fy: 0..65535 across the client area; flags: MOUSEEVENTF_* (ABSOLUTE implied). */
+void winios_post_client_pointer(int fx, int fy, unsigned int flags, unsigned int data) {
+    winios_q_push_ev(WINIOS_EV_CLIENT_MOUSE, fx, fy, flags, data);
+}
+
+void winios_post_focus(int active) {
+    winios_q_push_ev(WINIOS_EV_FOCUS, active ? 1 : 0, 0, 0, 0);
+}
+
 BOOL winios_pProcessEvents(DWORD mask) {
     static unsigned int cnt;
     static int quiet = -1;
@@ -546,6 +611,10 @@ BOOL winios_pProcessEvents(DWORD mask) {
         fprintf(stderr, "[winios] drain type=%u x=%d y=%d flags=0x%x\n", e.type, e.x, e.y, e.flags); fflush(stderr);
         if (e.type == WINIOS_EV_KEY)
             winios_drv_post_key((unsigned short)e.x, e.flags);
+        else if (e.type == WINIOS_EV_CLIENT_MOUSE)
+            winios_drain_client_mouse(&e);
+        else if (e.type == WINIOS_EV_FOCUS)
+            winios_drain_focus(e.x);
         else
             winios_drv_post_mouse(e.x, e.y, e.flags, e.data, NULL);
         drained = TRUE;
