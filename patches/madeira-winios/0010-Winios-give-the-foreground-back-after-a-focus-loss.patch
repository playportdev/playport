-        g_focus_saved = NULL;
+        fprintf(stderr, "[winios] focus lost fg=%p (focus %p, pid %04x) -> %p active=%p ok=%d waited=%.3f s\n",
+                fg, focus, pid, NtUserGetForegroundWindow(), get_active_window(), ok, waited);
+        return;
     }
-    fprintf(stderr, "[winios] focus %s fg=%p -> %p active=%p ok=%d waited=%.3f s\n", active ? "back" : "lost",
-            fg, NtUserGetForegroundWindow(), get_active_window(), ok, waited);
