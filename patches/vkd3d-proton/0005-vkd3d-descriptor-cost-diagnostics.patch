diff --git a/libs/vkd3d/vkd3d_descriptor_stats.c b/libs/vkd3d/vkd3d_descriptor_stats.c
new file mode 100644
index 0000000..745c8b3
--- /dev/null
+++ b/libs/vkd3d/vkd3d_descriptor_stats.c
@@ -0,0 +1,328 @@
+/* Checked elapsed scopes. A thread sum can exceed wall time; never subtract native windows. */
+#include "vkd3d_descriptor_stats.h"
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+#include <pthread.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <time.h>
+#include <unistd.h>
+#endif
+
+struct descriptor_state
+{
+    struct vkd3d_descriptor_stats *stats;
+    struct descriptor_state *parent;
+    unsigned int row;
+    uint64_t start, children, last_child_end;
+    bool valid, excluded;
+};
+static _Thread_local struct descriptor_state stack[32];
+static _Thread_local struct descriptor_state *top;
+static _Thread_local uint64_t depth;
+static _Atomic uint64_t generation;
+static const char *const ops[] = {"prep_graphics", "prep_compute", "prep_other",
+    "copy_resource", "copy_sampler", "copy_rtv", "copy_dsv", "copy_unknown",
+    "simple_resource", "simple_sampler", "simple_rtv", "simple_dsv", "simple_unknown",
+    "spec_data_excluded", "vk_update", "vk_bind", "vk_push", "vk_other"};
+static const char *const categories[] = {"prep", "standalone", "excluded"};
+static const char *const fields[] = {"calls", "completed", "dst_ranges", "src_ranges",
+    "requested_elements", "processed_elements", "metadata_bytes", "payload_bytes", "mapped_copy_calls",
+    "sets", "records", "vk_elements", "dirty_root_slots", "table_slots", "work_unknown",
+    "failures", "timed_calls", "elapsed_ticks", "direct_child_ticks", "exclusive_ticks", "max_ticks",
+    "thread_sum_outer_elapsed_ticks", "clock_errors", "nest_errors"};
+_Static_assert(sizeof(ops) / sizeof(*ops) == VKD3D_DS_OP_COUNT, "operation names");
+_Static_assert(sizeof(fields) / sizeof(*fields) == VKD3D_DS_FIELD_COUNT, "field names");
+
+static uint64_t add(struct vkd3d_descriptor_stats *s, _Atomic uint64_t *value, uint64_t n)
+{
+    uint64_t old = atomic_load_explicit(value, memory_order_relaxed), next;
+    do
+    {
+        next = n > UINT64_MAX - old ? UINT64_MAX : old + n;
+    } while (!atomic_compare_exchange_weak_explicit(value, &old, next, memory_order_seq_cst, memory_order_relaxed));
+    if (next == UINT64_MAX)
+        atomic_store_explicit(&s->overflow, true, memory_order_relaxed);
+    return next;
+}
+static void work(struct vkd3d_descriptor_stats *s, unsigned int row, enum vkd3d_descriptor_field f, uint64_t n)
+{
+    add(s, &s->rows[row][f], n);
+}
+static bool read_clock(struct vkd3d_descriptor_stats *s, uint64_t *ticks)
+{
+    return s->clock.hz && s->clock.read && s->clock.read(s->clock.context, ticks);
+}
+static bool platform_read(void *context, uint64_t *ticks)
+{
+#ifdef _WIN32
+    LARGE_INTEGER value;
+    (void)context;
+    if (!QueryPerformanceCounter(&value) || value.QuadPart < 0)
+        return false;
+    *ticks = value.QuadPart;
+#else
+    struct timespec value;
+    (void)context;
+    if (clock_gettime(CLOCK_MONOTONIC, &value) || value.tv_sec < 0 || value.tv_nsec < 0
+            || value.tv_nsec >= 1000000000 || (uint64_t)value.tv_sec > (UINT64_MAX - value.tv_nsec) / 1000000000)
+        return false;
+    *ticks = (uint64_t)value.tv_sec * 1000000000 + value.tv_nsec;
+#endif
+    return true;
+}
+#ifdef _WIN32
+static pthread_once_t frequency_once = PTHREAD_ONCE_INIT;
+static uint64_t frequency;
+static void init_frequency(void)
+{
+    LARGE_INTEGER value;
+    if (QueryPerformanceFrequency(&value) && value.QuadPart > 0)
+        frequency = value.QuadPart;
+}
+#endif
+void vkd3d_descriptor_begin_enabled(struct vkd3d_descriptor_scope *scope, struct vkd3d_descriptor_stats *s,
+        enum vkd3d_descriptor_op op)
+{
+    struct descriptor_state *parent = top, *state;
+    bool excluded = op == VKD3D_DS_SPEC_DATA || op == VKD3D_DS_COPY_RTV || op == VKD3D_DS_COPY_DSV
+            || op == VKD3D_DS_SIMPLE_RTV || op == VKD3D_DS_SIMPLE_DSV || (parent && parent->excluded);
+    unsigned int category = excluded ? 2 : (op <= VKD3D_DS_PREP_OTHER
+            || (parent && parent->row / VKD3D_DS_OP_COUNT == 0) ? 0 : 1);
+    scope->stats = s;
+    scope->row = category * VKD3D_DS_OP_COUNT + op;
+    add(s, &s->entered, 1);
+    work(s, scope->row, VKD3D_DS_CALLS, 1);
+    if (depth++ >= sizeof(stack) / sizeof(*stack))
+    {
+        work(s, scope->row, VKD3D_DS_NEST_ERRORS, 1);
+        if (parent)
+        {
+            parent->valid = false;
+            work(parent->stats, parent->row, VKD3D_DS_NEST_ERRORS, 1);
+        }
+        return;
+    }
+    state = &stack[depth - 1];
+    *state = (struct descriptor_state){.stats = s, .parent = parent, .row = scope->row, .excluded = excluded};
+    state->valid = read_clock(s, &state->start);
+    if (parent && (parent->stats != s || !state->valid || state->start < parent->start
+            || state->start < parent->last_child_end))
+    {
+        state->valid = parent->valid = false;
+        work(s, scope->row, VKD3D_DS_NEST_ERRORS, 1);
+        work(parent->stats, parent->row, VKD3D_DS_NEST_ERRORS, 1);
+    }
+    scope->state = top = state;
+}
+void vkd3d_descriptor_end_enabled(struct vkd3d_descriptor_scope *scope)
+{
+    struct vkd3d_descriptor_stats *s = scope->stats;
+    struct descriptor_state *state = scope->state, *parent;
+    uint64_t end = 0, elapsed = 0, old;
+    bool read_ok = state && read_clock(s, &end);
+    bool ok = read_ok && state->valid && top == state && end >= state->start;
+    if (ok)
+    {
+        elapsed = end - state->start;
+        ok = state->children <= elapsed && end >= state->last_child_end;
+    }
+    if (ok)
+    {
+        work(s, scope->row, VKD3D_DS_TIMED, 1);
+        work(s, scope->row, VKD3D_DS_ELAPSED, elapsed);
+        work(s, scope->row, VKD3D_DS_CHILDREN, state->children);
+        work(s, scope->row, VKD3D_DS_EXCLUSIVE, elapsed - state->children);
+        if (!state->parent)
+            work(s, scope->row, VKD3D_DS_OUTER, elapsed);
+        old = atomic_load_explicit(&s->rows[scope->row][VKD3D_DS_MAX], memory_order_relaxed);
+        while (old < elapsed && !atomic_compare_exchange_weak_explicit(&s->rows[scope->row][VKD3D_DS_MAX],
+                &old, elapsed, memory_order_relaxed, memory_order_relaxed)) {}
+    }
+    else
+    {
+        work(s, scope->row, VKD3D_DS_CLOCK_ERRORS, 1);
+        work(s, scope->row, VKD3D_DS_NEST_ERRORS, 1);
+    }
+    if (state)
+    {
+        parent = state->parent;
+        if (parent)
+        {
+            if (!ok || parent->stats != s || elapsed > UINT64_MAX - parent->children)
+            {
+                parent->valid = false;
+                work(parent->stats, parent->row, VKD3D_DS_NEST_ERRORS, 1);
+            }
+            else
+            {
+                parent->children += elapsed;
+                if (end > parent->last_child_end)
+                    parent->last_child_end = end;
+            }
+        }
+        top = parent;
+    }
+    --depth;
+    work(s, scope->row, VKD3D_DS_COMPLETED, 1);
+    add(s, &s->completed, 1);
+    scope->end_ticks = end;
+    scope->valid = ok;
+    scope->stats = NULL;
+}
+void vkd3d_descriptor_add_enabled(struct vkd3d_descriptor_scope *scope, enum vkd3d_descriptor_field field, uint64_t n)
+{
+    work(scope->stats, scope->row, field, n);
+}
+void vkd3d_descriptor_current_add_enabled(struct vkd3d_descriptor_stats *s, enum vkd3d_descriptor_field field, uint64_t n)
+{
+    if (top && top->stats == s && depth <= sizeof(stack) / sizeof(*stack))
+        work(s, top->row, field, n);
+}
+void vkd3d_descriptor_capture(struct vkd3d_descriptor_stats *s, struct vkd3d_descriptor_snapshot *v)
+{
+    unsigned int i, f;
+    bool begin_ok;
+    memset(v, 0, sizeof(*v));
+    v->sequence = add(s, &s->snapshot, 1);
+    begin_ok = read_clock(s, &v->begin);
+    v->entered_before = atomic_load_explicit(&s->entered, memory_order_seq_cst);
+    v->completed_before = atomic_load_explicit(&s->completed, memory_order_seq_cst);
+    for (i = 0; i < VKD3D_DS_ROW_COUNT; ++i)
+        for (f = 0; f < VKD3D_DS_FIELD_COUNT; ++f)
+            v->rows[i][f] = atomic_load_explicit(&s->rows[i][f], memory_order_relaxed);
+    v->entered_after = atomic_load_explicit(&s->entered, memory_order_seq_cst);
+    v->completed_after = atomic_load_explicit(&s->completed, memory_order_seq_cst);
+    v->clock_ok = read_clock(s, &v->end) && begin_ok && v->end >= v->begin;
+    v->quiescent = v->entered_before == v->entered_after && v->completed_before == v->completed_after
+            && v->entered_before == v->completed_before;
+    v->executions = atomic_load_explicit(&s->executions, memory_order_relaxed);
+    v->overflow = atomic_load_explicit(&s->overflow, memory_order_relaxed);
+    v->report_errors = atomic_load_explicit(&s->report_errors, memory_order_relaxed);
+}
+static int prefix(struct vkd3d_descriptor_stats *s, char *line, size_t size, const char *kind)
+{
+#ifdef _WIN32
+    uint64_t pid = GetCurrentProcessId();
+#else
+    uint64_t pid = getpid();
+#endif
+    return snprintf(line, size, "[vkd3d-descriptor] v=1 component=vkd3d kind=%s pid=%"PRIu64
+            " module=%"PRIuPTR" device=%"PRIu64" init_ticks=%"PRIu64" init_ok=%u hz=%"PRIu64" clock_kind=%s",
+            kind, pid, (uintptr_t)&generation, s->device, s->init_ticks, s->init_ok, s->clock.hz, s->clock.kind);
+}
+static void emit(struct vkd3d_descriptor_stats *s, const char *line)
+{
+    if (s->emit && !s->emit(s->emit_context, line))
+        add(s, &s->report_errors, 1);
+}
+void vkd3d_descriptor_report(struct vkd3d_descriptor_stats *s, bool final)
+{
+    struct vkd3d_descriptor_snapshot v;
+    uint64_t now = 0, previous;
+    unsigned int i, f;
+    int n;
+    bool ok;
+    char line[4096];
+    if (!s || !s->emit || atomic_flag_test_and_set_explicit(&s->reporting, memory_order_acquire))
+        return;
+    ok = read_clock(s, &now);
+    previous = atomic_load_explicit(&s->last_report, memory_order_relaxed);
+    if (!ok || now < previous)
+        add(s, &s->report_errors, 1);
+    if (!final && previous && (!ok || now < previous || now - previous < s->clock.hz))
+        goto done;
+    if (ok)
+        atomic_store_explicit(&s->last_report, now, memory_order_relaxed);
+    vkd3d_descriptor_capture(s, &v);
+    v.clock_ok = v.clock_ok && ok && now >= previous;
+    for (i = 0; i < VKD3D_DS_ROW_COUNT; ++i)
+    {
+        n = prefix(s, line, sizeof(line), "snapshot");
+        n += snprintf(line + n, sizeof(line) - n,
+                " snapshot=%"PRIu64" ts_begin=%"PRIu64" ts_end=%"PRIu64" client_execute_requests=%"PRIu64
+                " final=%u clock_ok=%u quiescent=%u overflow=%u report_errors=%"PRIu64
+                " entered_before=%"PRIu64" completed_before=%"PRIu64" entered_after=%"PRIu64" completed_after=%"PRIu64
+                " op=%s category=%s", v.sequence, v.begin, v.end, v.executions, final, v.clock_ok, v.quiescent,
+                v.overflow, v.report_errors, v.entered_before, v.completed_before, v.entered_after, v.completed_after,
+                ops[i % VKD3D_DS_OP_COUNT], categories[i / VKD3D_DS_OP_COUNT]);
+        for (f = 0; f < VKD3D_DS_FIELD_COUNT; ++f)
+            n += snprintf(line + n, sizeof(line) - n, " %s=%"PRIu64, fields[f], v.rows[i][f]);
+        snprintf(line + n, sizeof(line) - n, " active=%"PRIu64, v.rows[i][VKD3D_DS_CALLS] >= v.rows[i][VKD3D_DS_COMPLETED]
+                ? v.rows[i][VKD3D_DS_CALLS] - v.rows[i][VKD3D_DS_COMPLETED] : UINT64_MAX);
+        emit(s, line);
+    }
+done:
+    atomic_flag_clear_explicit(&s->reporting, memory_order_release);
+}
+void vkd3d_descriptor_execute(struct vkd3d_descriptor_stats *s)
+{
+    if (s)
+    {
+        add(s, &s->executions, 1);
+        vkd3d_descriptor_report(s, false);
+    }
+}
+void vkd3d_descriptor_stats_init(struct vkd3d_descriptor_stats *s, vkd3d_descriptor_emit output,
+        void *context, const char *copy_path, const struct vkd3d_descriptor_clock *clock, bool calibrate)
+{
+    unsigned int i, f;
+    char line[4096];
+    int n;
+    memset(s, 0, sizeof(*s));
+    for (i = 0; i < VKD3D_DS_ROW_COUNT; ++i)
+        for (f = 0; f < VKD3D_DS_FIELD_COUNT; ++f)
+            atomic_init(&s->rows[i][f], 0);
+    atomic_init(&s->entered, 0); atomic_init(&s->completed, 0); atomic_init(&s->snapshot, 0);
+    atomic_init(&s->executions, 0); atomic_init(&s->report_errors, 0); atomic_init(&s->last_report, 0);
+    atomic_init(&s->overflow, false); atomic_flag_clear(&s->reporting);
+    if (clock)
+        s->clock = *clock;
+    else
+    {
+#ifdef _WIN32
+        pthread_once(&frequency_once, init_frequency);
+        s->clock = (struct vkd3d_descriptor_clock){platform_read, NULL, frequency, "qpc"};
+#else
+        s->clock = (struct vkd3d_descriptor_clock){platform_read, NULL, 1000000000, "host_clock_monotonic"};
+#endif
+    }
+    s->emit = output;
+    s->emit_context = context;
+    s->device = add(s, &generation, 1);
+    s->init_ok = read_clock(s, &s->init_ticks);
+    n = prefix(s, line, sizeof(line), "enabled");
+    snprintf(line + n, sizeof(line) - n, " copy_simple_path=%s uncovered_selected_copy=%u"
+            " coverage=prep_broad_ambiguous_constants_ubo_tracking,copy_cpu_metadata,selected_simple,direct_vk"
+            " exclusions=separate_constants_redzone,rtv,dsv native=separate_uncovered_replay_no_subtraction"
+            " capture=nontransactional_all_rows_required errors=override_quiescent killed_tail=missing"
+            " thread_model=same_thread_nesting_summed_elapsed_no_registry cpu_clock=unsupported"
+            " denominator=client_execute_requests_not_frames_or_gpu_completions byte_counts=source_copy_assignments_not_memory_traffic"
+            " additive=sum_exclusive_by_category parent_inclusive=overlapping elapsed_includes=waiting,preemption,diagnostics",
+            copy_path, !strcmp(copy_path, "unrecognized"));
+    emit(s, line);
+    if (calibrate && output)
+    {
+        struct vkd3d_descriptor_stats scratch;
+        vkd3d_descriptor_stats_init(&scratch, NULL, NULL, copy_path, &s->clock, false);
+        for (i = 0; i < 16; ++i)
+        {
+            struct vkd3d_descriptor_scope scope;
+            uint64_t a = 0, b = 0, c = 0, d = 0, start;
+            bool a_ok = read_clock(s, &a), b_ok = read_clock(s, &b), c_ok = read_clock(s, &c), d_ok;
+            scope = vkd3d_descriptor_begin(&scratch, VKD3D_DS_PREP_GRAPHICS);
+            start = scope.state ? ((struct descriptor_state *)scope.state)->start : 0;
+            vkd3d_descriptor_end(&scope);
+            d_ok = read_clock(s, &d);
+            n = prefix(s, line, sizeof(line), "calibration");
+            snprintf(line + n, sizeof(line) - n, " sample=%u adjacent_begin=%"PRIu64" adjacent_end=%"PRIu64
+                    " adjacent_ok=%u scope_begin=%"PRIu64" scope_end=%"PRIu64" scope_ok=%u"
+                    " empty_begin=%"PRIu64" empty_end=%"PRIu64" empty_ok=%u clock_reads=6 subtraction=none",
+                    i, a, b, a_ok && b_ok && b >= a, start, scope.end_ticks, scope.valid,
+                    c, d, c_ok && d_ok && scope.valid && d >= scope.end_ticks && start >= c && d >= c);
+            emit(s, line);
+        }
+    }
+}
diff --git a/libs/vkd3d/vkd3d_descriptor_stats.h b/libs/vkd3d/vkd3d_descriptor_stats.h
new file mode 100644
index 0000000..2711278
--- /dev/null
+++ b/libs/vkd3d/vkd3d_descriptor_stats.h
@@ -0,0 +1,100 @@
+/* Optional elapsed diagnostics, never CPU time or a shader/cache input. */
+#ifndef VKD3D_DESCRIPTOR_STATS_H
+#define VKD3D_DESCRIPTOR_STATS_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdatomic.h>
+
+enum vkd3d_descriptor_op
+{
+    VKD3D_DS_PREP_GRAPHICS, VKD3D_DS_PREP_COMPUTE, VKD3D_DS_PREP_OTHER,
+    VKD3D_DS_COPY_RESOURCE, VKD3D_DS_COPY_SAMPLER, VKD3D_DS_COPY_RTV, VKD3D_DS_COPY_DSV, VKD3D_DS_COPY_UNKNOWN,
+    VKD3D_DS_SIMPLE_RESOURCE, VKD3D_DS_SIMPLE_SAMPLER, VKD3D_DS_SIMPLE_RTV, VKD3D_DS_SIMPLE_DSV, VKD3D_DS_SIMPLE_UNKNOWN,
+    VKD3D_DS_SPEC_DATA, VKD3D_DS_VK_UPDATE, VKD3D_DS_VK_BIND, VKD3D_DS_VK_PUSH, VKD3D_DS_VK_OTHER,
+    VKD3D_DS_OP_COUNT
+};
+enum vkd3d_descriptor_field
+{
+    VKD3D_DS_CALLS, VKD3D_DS_COMPLETED, VKD3D_DS_DST_RANGES, VKD3D_DS_SRC_RANGES,
+    VKD3D_DS_REQUESTED_ELEMENTS, VKD3D_DS_PROCESSED_ELEMENTS, VKD3D_DS_METADATA_BYTES, VKD3D_DS_PAYLOAD_BYTES,
+    VKD3D_DS_MAPPED_COPIES, VKD3D_DS_SETS, VKD3D_DS_RECORDS, VKD3D_DS_VK_ELEMENTS,
+    VKD3D_DS_DIRTY_ROOTS, VKD3D_DS_TABLE_SLOTS, VKD3D_DS_WORK_UNKNOWN,
+    VKD3D_DS_FAILURES, VKD3D_DS_TIMED, VKD3D_DS_ELAPSED, VKD3D_DS_CHILDREN, VKD3D_DS_EXCLUSIVE,
+    VKD3D_DS_MAX, VKD3D_DS_OUTER, VKD3D_DS_CLOCK_ERRORS, VKD3D_DS_NEST_ERRORS, VKD3D_DS_FIELD_COUNT
+};
+#define VKD3D_DS_ROW_COUNT (VKD3D_DS_OP_COUNT * 3)
+struct vkd3d_descriptor_clock
+{
+    bool (*read)(void *context, uint64_t *ticks);
+    void *context;
+    uint64_t hz;
+    const char *kind;
+};
+typedef bool (*vkd3d_descriptor_emit)(void *context, const char *line);
+struct vkd3d_descriptor_stats
+{
+    _Atomic uint64_t rows[VKD3D_DS_ROW_COUNT][VKD3D_DS_FIELD_COUNT];
+    _Atomic uint64_t entered, completed, snapshot, executions, report_errors, last_report;
+    _Atomic bool overflow;
+    atomic_flag reporting;
+    struct vkd3d_descriptor_clock clock;
+    vkd3d_descriptor_emit emit;
+    void *emit_context;
+    uint64_t device, init_ticks;
+    bool init_ok;
+};
+struct vkd3d_descriptor_scope
+{
+    struct vkd3d_descriptor_stats *stats;
+    void *state;
+    unsigned int row;
+    uint64_t end_ticks;
+    bool valid;
+};
+struct vkd3d_descriptor_snapshot
+{
+    uint64_t rows[VKD3D_DS_ROW_COUNT][VKD3D_DS_FIELD_COUNT];
+    uint64_t sequence, begin, end, entered_before, entered_after, completed_before, completed_after;
+    uint64_t executions, report_errors;
+    bool clock_ok, quiescent, overflow;
+};
