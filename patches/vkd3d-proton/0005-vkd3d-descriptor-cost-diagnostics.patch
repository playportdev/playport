+        if (descriptor_heap_type == D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV ||
+                descriptor_heap_type == D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER)
+        {
+            uint64_t bytes;
+            vkd3d_descriptor_add(&scope, VKD3D_DS_PROCESSED_ELEMENTS, descriptor_count);
