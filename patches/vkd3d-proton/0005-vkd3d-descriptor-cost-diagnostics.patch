@@ -5995,6 +6002,23 @@ static inline void d3d12_device_copy_descriptors(struct d3d12_device *device,
     }
 }
 
+static struct vkd3d_descriptor_scope d3d12_device_descriptor_copy_begin(struct d3d12_device *device,
+        D3D12_DESCRIPTOR_HEAP_TYPE heap_type, bool simple, UINT dst_ranges, UINT src_ranges, UINT elements)
+{
+    enum vkd3d_descriptor_op op = simple ? VKD3D_DS_SIMPLE_RESOURCE : VKD3D_DS_COPY_RESOURCE;
+    struct vkd3d_descriptor_scope scope;
+    /* Heap enums 0..3 are CBV/SRV/UAV, sampler, RTV, DSV. Unknown inputs stay explicit. */
+    op += (unsigned int)heap_type <= 3 ? (unsigned int)heap_type : 4;
+    scope = vkd3d_descriptor_begin(device->descriptor_stats_enabled, op);
+    vkd3d_descriptor_add(&scope, VKD3D_DS_DST_RANGES, dst_ranges);
+    vkd3d_descriptor_add(&scope, VKD3D_DS_SRC_RANGES, src_ranges);
+    if (simple)
+        vkd3d_descriptor_add(&scope, VKD3D_DS_REQUESTED_ELEMENTS, elements);
+    else
+        vkd3d_descriptor_add(&scope, VKD3D_DS_WORK_UNKNOWN, 1); /* No unused-range traversal. */
+    return scope;
+}
+
 static void STDMETHODCALLTYPE d3d12_device_CopyDescriptors(d3d12_device_iface *iface,
