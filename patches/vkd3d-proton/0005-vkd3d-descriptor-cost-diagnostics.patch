 libs/vkd3d/meson.build              |   1 +
 libs/vkd3d/resource.c               |  45 ++++
 libs/vkd3d/vkd3d_descriptor_stats.c | 328 ++++++++++++++++++++++++++++
 libs/vkd3d/vkd3d_descriptor_stats.h | 100 +++++++++
 libs/vkd3d/vkd3d_private.h          |   4 +
 7 files changed, 820 insertions(+), 15 deletions(-)
 create mode 100644 libs/vkd3d/vkd3d_descriptor_stats.c
 create mode 100644 libs/vkd3d/vkd3d_descriptor_stats.h

