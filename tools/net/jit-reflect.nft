#!/usr/sbin/nft -f
# SPDX-License-Identifier: GPL-3.0-or-later
# The phone away from home, on WireGuard (docs/DEVICE.md, "Away from home"):
# iOS runs one VPN at a time, so LocalDevVPN is off while WireGuard is on, and the
# JIT helper's packets to 10.7.0.1 leave the phone. The gateway routes 10.7.0.1
# to this workstation; these rules send each packet back to the address it came
# from, as from 10.7.0.1, which is what LocalDevVPN does on the phone. Packets
# only: nothing here reads or keeps what they carry.
#
# Also needs forwarding on (net.ipv4.ip_forward=1) and, in a forward chain whose
# policy is drop, the accept line below (Arch's /etc/nftables.conf has one).
#
#   ct status dnat ct original ip daddr 10.7.0.1 accept

destroy table ip playport_jit_reflect
table ip playport_jit_reflect {
  chain prerouting {
    type nat hook prerouting priority dstnat
    ip daddr 10.7.0.1 fib saddr type unicast dnat ip to ip saddr
  }
  chain postrouting {
    type nat hook postrouting priority srcnat
    ct status dnat ct original ip daddr 10.7.0.1 snat ip to 10.7.0.1
  }
}
