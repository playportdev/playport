#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# xtool runs "$SWIFTPM_CUSTOM_BIN_DIR/swift-build" when that variable is set.
# This passes a second toolset after xtool's own, whose only entry is the
# linker, so the app link goes through Apple ld64 (cctools-port, built by
# build/toolchain/ld64.sh). ld64 merges duplicate strong definitions from archive
# members under -dead_strip as the reference's Xcode link does
# (docs/BUILDING.md, "Linking"). Every other tool stays xtool's.
#
# The repository's path is mapped out of what the build writes into the
# binaries: Swift's and C's debug info and #file/__FILE__ (-file-prefix-map),
# ld64's debug map of object files (-oso_prefix) and of Swift modules
# (-add_ast_path, made repo-relative), and SwiftPM's -rpath into the build
# tree (dropped: dyld on the phone never finds it), so the IPA names no
# workstation path (verify-ipa.py).
#
# The build runs the linker with a stripped environment, so the toolset and
# the linker script are generated here with absolute paths, into the
# package's gitignored .build/ld64/.
#   LD64      ld64 binary (default: the build/toolchain/ld64.sh install)
set -eu
package="$(CDPATH= cd -P "$(dirname "$0")/../../app" && pwd -P)"
repo="$(dirname "$package")"
ld64="${LD64:-${PLAYPORT_BUILD:-$(cd "$(dirname "$0")/../.." && pwd)/.work}/inputs/apple-linker/prefix/bin/arm64-apple-darwin-ld}"
# xtool puts its Darwin SDK's toolset/bin first on PATH; its ld64.lld is the
# trampoline that turns the per-target `-r` step into an llvm-lib archive.
trampoline="$(command -v ld64.lld)"
[ -x "$ld64" ] || { echo "swift-build: no ld64 at $ld64 (run build/toolchain/ld64.sh)" >&2; exit 1; }
case "$trampoline" in
    */toolset/bin/ld64.lld) ;;
    *) echo "swift-build: xtool's ld64.lld trampoline is not first on PATH ($trampoline)" >&2; exit 1 ;;
esac
out="$package/.build/ld64"
mkdir -p "$out"
cat > "$out/ld" <<EOF
#!/bin/sh
# Generated by build/ld64/swift-build.
for argument do
    if [ "\$argument" = "-r" ]; then
        exec "$trampoline" "\$@"
    fi
done
n=\$#
while [ "\$n" -gt 0 ]; do
    a=\$1; shift; n=\$((n - 1))
    case \$a in
    -add_ast_path) set -- "\$@" "\$a" "\${1#$repo/}"; shift; n=\$((n - 1)) ;;
    -rpath) case \$1 in "$repo"/*) ;; *) set -- "\$@" "\$a" "\$1" ;; esac; shift; n=\$((n - 1)) ;;
    *) set -- "\$@" "\$a" ;;
    esac
done
exec "$ld64" -oso_prefix "$repo/" "\$@"
EOF
chmod +x "$out/ld"
printf '{ "schemaVersion": "1.0", "rootPath": ".", "linker": { "path": "ld" } }\n' > "$out/toolset.json"
unset SWIFTPM_CUSTOM_BIN_DIR
exec swift build "$@" --toolset "$out/toolset.json" \
    -Xswiftc -file-prefix-map -Xswiftc "$repo=." -Xcc "-ffile-prefix-map=$repo=."
