#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Pass-through: xtool runs "$SWIFTPM_CUSTOM_BIN_DIR/swift-package" to plan.
set -eu
unset SWIFTPM_CUSTOM_BIN_DIR
swift=swift
if [ "$(uname -s)" = Darwin ]; then
    swift=$(xcrun --find swift)
    repo=$(CDPATH='' cd -P "$(dirname "$0")/../.." && pwd -P)
    swift_work=${PLAYPORT_BUILD:-$repo/.work}
    export TMPDIR="$swift_work/tmp" CLANG_MODULE_CACHE_PATH="$swift_work/cache/clang"
    export SWIFTPM_MODULECACHE_OVERRIDE="$CLANG_MODULE_CACHE_PATH"
    mkdir -p "$TMPDIR" "$CLANG_MODULE_CACHE_PATH"
    set -- --cache-path "$swift_work/cache/swiftpm" --config-path "$swift_work/swiftpm/config" --security-path "$swift_work/swiftpm/security" "$@"
fi
exec "$swift" package "$@"
