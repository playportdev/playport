#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform usamplerBuffer src;
layout(set = 0, binding = 1, r32ui) uniform uimageBuffer dst;
void main() {
   uint i = gl_GlobalInvocationID.x;
   uint u = texelFetch(src, int(i)).x;
   /* DIRT 5's (PLA-815): a float-to-double sum in a loop, clamped, back to
    * float */
   double sum = 0.0lf;
   for (uint k = 0u; k < u; k++)
      sum += double(sqrt(float(k)));
   float blue = float(clamp(sum, 0.0lf, 1.0lf));
   /* The rest of what Direct3D's double instructions reach: multiply,
    * divide, fma, min and max, compares, and integer conversions */
   double a = double(u) * 1.5lf;
   double b = double(int(u) - 7) / 3.0lf;
   double c = fma(a, b, sum);
   double d = min(a, b) + max(b, c);
   uint flags = uint(a < b) | uint(a == c) << 1 | uint(d >= 0.0lf) << 2;
   imageStore(dst, int(i), uvec4(uint(d) + uint(int(c)) + floatBitsToUint(blue) + flags));
}
