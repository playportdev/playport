#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform usamplerBuffer src;
layout(set = 0, binding = 1, r32ui) uniform uimageBuffer dst;
layout(set = 0, binding = 2, rgba8) uniform imageBuffer colors;
void main() {
   uint i = gl_GlobalInvocationID.x;
   /* Reads, sizes, a store and an atomic through views that start at an
    * arbitrary texel. */
   uint v = texelFetch(src, int(i)).x + uint(textureSize(src));
   imageStore(dst, int(i), uvec4(v + uint(imageSize(dst))));
   imageAtomicAdd(dst, int(i) + 1, 1u);
   vec4 c = imageLoad(colors, int(i));
   imageStore(colors, int(i), c.bgra);
}
